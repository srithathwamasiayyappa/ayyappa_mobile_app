2 \u0c2f\u0c1c\u0c4d\u0c1e\u0c38\u0c4d\u0c24\u0c4d\u0c35\u0c02 \u0c35\u0c37\u0c1f\u0c4d\u0c15\u0c3e\u0c30\u0c38\u0c4d\u0c24\u0c4d\u0c35\u0c2e\u0c3f\u0c02\u0c26\u0c4d\u0c30\u0c38\u0c4d\u0c24\u0c4d\u0c35\u0c17\u0c41\u0c02 \u0c30\u0c41\u0c26\u0c4d\u0c30\u0c38\u0c4d\u0c24\u0c4d\u0c35\u0c02 \u0c35\u0c3f\u0c37\u0c4d\u0c23\u0c41\u0c38\u0c4d\u0c24\u0c4d\u0c35\u0c02 \u0c2c\u0c4d\u0c30\u0c39\u0c4d\u0c2e\u0c24\u0c4d\u0c35\u0c02 \u0c2a\u0c4d\u0c30\u0c1c\u0c3e\u0c2a\u0c24\u0c3f\u0c03 \u0964\n    \u0c24\u0c4d\u0c35\u0c02 \u0c24\u0c26\u0c3e\u0c2a \u0c06\u0c2a\u0c4b\u0c1c\u0c4d\u0c2f\u0c4b\u0c24\u0c40 \u0c30\u0c38\u0c4b\u0c2e\u0c43\u0c24\u0c02 \u0c2c\u0c4d\u0c30\u0c39\u0c4d\u0c2e \u0c2d\u0c42\u0c30\u0c4d\u0c2d\u0c41\u0c35\u0c38\u0c4d\u0c38\u0c41\u0c35\u0c30\u0c4b\u0c2e\u0c4d \u0965\n    \n    \u0c13\u0c02 \u0c28\u0c2e\u0c38\u0c4d\u0c24\u0c47 \u0c05\u0c38\u0c4d\u0c24\u0c41 \u0c2d\u0c17\u0c35\u0c28\u0c4d \u0c35\u0c3f\u0c36\u0c4d\u0c35\u0c47\u0c36\u0c4d\u0c35\u0c30\u0c3e\u0c2f \u0c2e\u0c39\u0c3e\u0c26\u0c47\u0c35\u0c3e\u0c2f \u0c24\u0c4d\u0c30\u0c4d\u0c2f\u0c02\u0c2c\u0c15\u0c3e\u0c2f \u0c24\u0c4d\u0c30\u0c3f\u0c2a\u0c41\u0c30\u0c3e\u0c02\u0c24\u0c15\u0c3e\u0c2f \u0c24\u0c4d\u0c30\u0c3f\u0c15\u0c3e\u0c17\u0c4d\u0c28\u0c3f\u0c15\u0c3e\u0c32\u0c3e\u0c2f \u0c15\u0c3e\u0c32\u0c3e\u0c17\u0c4d\u0c28\u0c3f\u0c30\u0c41\u0c26\u0c4d\u0c30\u0c3e\u0c2f \u0c28\u0c40\u0c32\u0c15\u0c02\u0c20\u0c3e\u0c2f \u0c2e\u0c43\u0c24\u0c4d\u0c2f\u0c41\u0c02\u0c1c\u0c2f\u0c3e\u0c2f \u0c38\u0c30\u0c4d\u0c35\u0c47\u0c36\u0c4d\u0c35\u0c30\u0c3e\u0c2f \u0c38\u0c26\u0c3e\u0c36\u0c3f\u0c35\u0c3e\u0c2f \u0c36\u0c4d\u0c30\u0c40\u0c2e\u0c28\u0c4d\u0c2e\u0c39\u0c3e\u0c26\u0c47\u0c35\u0c3e\u0c2f \u0c28\u0c2e\u0c03 \u0965\n    \n    \u0c13\u0c02 \u0c28\u0c3f\u0c27\u0c28\u0c2a\u0c24\u0c2f\u0c47 \u0c28\u0c2e\u0c03 \u0c28\u0c3f\u0c27\u0c28\u0c2a\u0c24\u0c3e\u0c02\u0c24\u0c3f\u0c15\u0c3e\u0c2f \u0c28\u0c2e\u0c03\n    \u0c0a\u0c30\u0c4d\u0c27\u0c4d\u0c35\u0c3e\u0c2f \u0c28\u0c2e\u0c03 \u0c0a\u0c30\u0c4d\u0c27\u0c4d\u0c35\u0c32\u