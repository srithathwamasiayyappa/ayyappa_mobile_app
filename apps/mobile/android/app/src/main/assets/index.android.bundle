03 \u0964\n    \u0913\u0902 \u0917\u093f\u0930\u0940\u0936\u093e\u092f \u0928\u092e\u0903 \u0964\n    \u0913\u0902 \u092d\u0915\u094d\u0924\u092a\u094b\u0937\u0915\u093e\u092f \u0928\u092e\u0903 \u0964\n    \u0913\u0902 \u0905\u092e\u0943\u0924\u0947\u0936\u093e\u092f \u0928\u092e\u0903 \u0964\n    \u0913\u0902 \u091c\u0917\u0926\u094d\u0935\u094d\u092f\u093e\u092a\u093f\u0928\u0947 \u0928\u092e\u0903 \u0964\n    \u0913\u0902 \u092a\u0941\u0923\u094d\u092f\u092e\u0942\u0930\u094d\u0924\u092f\u0947 \u0928\u092e\u0903 \u0964\n    \u0913\u0902 \u0938\u091a\u094d\u091a\u093f\u0926\u093e\u0928\u0902\u0926\u0935\u093f\u0917\u094d\u0930\u0939\u093e\u092f \u0928\u092e\u0903 \u0964\n    \u0913\u0902 \u092e\u0923\u093f\u0915\u0902\u0920\u093e\u092f \u0928\u092e\u0903 \u0964\n    \u0913\u0902 \u0939\u0930\u093f\u0939\u0930\u092a\u0941\u0924\u094d\u0930\u093e\u092f \u0928\u092e\u0903 \u0964\n    \u0913\u0902 \u0936\u092c\u0930\u0940\u0917\u093f\u0930\u0940\u0936\u093e\u092f \u0928\u092e\u0903 \u0964\n    \u0913\u0902 \u0936\u093e\u0936\u094d\u0935\u0924\u093e\u092f \u0928\u092e\u0903 \u0964\n    \u0913\u0902 \u092e\u094b\u0915\u094d\u0937\u092a\u094d\u0930\u0926\u093e\u092f\u0915\u093e\u092f \u0928\u092e\u0903 \u0964\n    \u0913\u0902 \u0932\u094b\u0915\u092a\u0942\u091c\u094d\u092f\u093e\u092f \u0928\u092e\u0903 \u0964\n    \u0913\u0902 \u0927\u0930\u094d\u092e\u092a\u093e\u0932\u0915\u093e\u092f \u0928\u092e\u0903 \u0964\n    \u0913\u0902 \u0938\u0930\u094d\u0935\u0938\u093f\u0926\u094d\u0927\u093f\u092a\u094d\u0930\u0926\u093e\u092f\u0915\u093e\u092f \u0928\u092e\u0903 \u0964\n    \u0913\u0902 \u0906\u0928\u0902\u0926\u0926\u093e\u092f \u0928\u092e\u0903 \u0964\n    \u0913\u0902 \u092d\u0917\u0935\u0924\u0947 \u0928\u092e\u0903 \u0964\n    \u0913\u0902 \u0936\u094d\u0930\u0940 \u0939\u0930\u093f\u0939\u0930\u092a\u0941\u0924\u094d\u0930 \u0938\u094d\u0935\u093e\u092e\u093f\u0928\u0947 \u0928\u092e\u0903 \u0964",isAudio:!1,audioDurationSec:40,totalTime:"00:40"},{id:"13",slug:"sri-devi-pooja",title:"\u0936\u094d\u0930\u0940 \u0926\u0947\u0935\u0940 \u092a\u0942\u091c\u093e",description:"[ \u0936\u094d\u0930\u0940 \u0926\u0947\u0935\u093f \u092a\u0942\u091c - \u092e\u093e\u0933\u093f\u0915\u093e\u092a\u0941\u0930\u0924\u094d\u0924\u092e\u094d\u092e & \u0938\u0930\u094d\u0935\u092e\u0902\u0917\u0933 \u092a\u0942\u091c ]\n    \n    \u0936\u092c\u0930\u093f\u092e\u0932\u0932\u094b \u0915\u094b\u0932\u0941\u0935\u0948\u0928 \u0936\u094d\u0930\u0940 \u092e\u093e\u0933\u093f\u0915\u093e\u092a\u0941\u0930\u0924\u094d\u0924\u092e\u094d\u092e (\u0936\u094d\u0930\u0940 \u092d\u0917\u0935\u0924\u0940 \u0926\u0947\u0935\u093f) \u0938\u092e\u0938\u094d\u0924 \u092d\u0915\u094d\u0924\u0941\u0932 \u0915\u094b\u0930\u093f\u0915\u0932\u0941 \u0924\u0940\u0930\u094d\u091a\u0947 \u0915\u0932\u094d\u092a\u0935\u0932\u094d\u0932\u093f.\n    \n    [ \u0927\u094d\u092f\u093e\u0928\u0902 ]\n    \u0938\u0930\u094d\u0935\u092e\u0902\u0917\u0933 \u092e\u093e\u0902\u0917\u0932\u094d\u092f\u0947 \u0936\u093f\u0935\u0947 \u0938\u0930\u094d\u0935\u093e\u0930\u094d\u0925 \u0938\u093e\u0927\u093f\u0915\u0947\n    \u0936\u0930\u0923\u094d\u092f\u0947 \u0924\u094d\u0930\u094d\u092f\u0902\u092c\u0915\u0947 \u0917\u094c\u0930\u0940 \u0928\u093e\u0930\u093e\u092f\u0923\u093f \u0928\u092e\u094b\u0938\u094d\u0924\u0941\u0924\u0947\n    \n    \u092f\u093e \u0926\u0947\u0935\u0940 \u0938\u0930\u094d\u0935\u092d\u0942\u0924\u0947\u0937\u0941 \u092e\u093e\u0924\u0943 \u0930\u0942\u092a\u0947\u0923 \u0938\u0902\u0938\u094d\u0925\u093f\u0924\u093e\n    \u0928\u092e\u0938\u094d\u0924\u0938\u094d\u092f\u0948 \u0928\u092e\u0938\u094d\u0924\u0938\u094d\u092f\u0948 \u0928\u092e\u0938\u094d\u0924\u0938\u094d\u092f\u0948 \u0928\u092e\u094b \u0928\u092e\u0903\n    \n    [ \u0936\u094d\u0930\u0940 \u0926\u0947\u0935\u093f \u0905\u0937\u094d\u091f\u094b\u0924\u094d\u0924\u0930 \u0936\u0924 \u0928\u093e\u092e\u093e\u0935\u0933\u093f\u0903 (\u0915\u094b\u0928\u094d\u0928\u093f \u092e\u0941\u0916\u094d\u092f \u0928\u093e\u092e\u092e\u0941\u0932\u0941) ]\n    \u0913\u0902 \u092a\u094d\u0930\u0915\u0943\u0924\u094d\u092f\u0948 \u0928\u092e\u0903\n    \u0913\u0902 \u0935\u093f\u0915\u0943\u0924\u094d\u092f\u0948 \u0928\u092e\u0903\n    \u0913\u0902 \u0935\u093f\u0926\u094d\u092f\u093e\u092f\u0948 \u0928\u092e\u0903\n    \u0913\u0902 \u0938\u0930\u094d\u0935\u092d\u0942\u0924\u0939\u093f\u0924\u092a\u094d\u0930\u0926\u093e\u092f\u0948 \u0928\u092e\u0903\n    \u0913\u0902 \u0936\u094d\u0930\u0926\u094d\u0927\u093e\u092f\u0948 \u0928\u092e\u0903\n    \u0913\u0902 \u0935\u093f\u092d\u0942\u0924\u094d\u092f\u0948 \u0928\u092e\u0903\n    \u0913\u0902 \u0938\u0941\u0930\u092d\u094d\u092f\u0948 \u0928\u092e\u0903\n    \u0913\u0902 \u092a\u0930\u092e\u093e\u0924\u094d\u092e\u093f\u0915\u093e\u092f\u0948 \u0928\u092e\u0903\n    \u0913\u0902 \u092a\u0926\u094d\u092e\u093e\u0932\u092f\u093e\u092f\u0948 \u0928\u092e\u0903\n    \u0913\u0902 \u092a\u0926\u094d\u092e\u093e\u092f\u0948 \u0928\u092e\u0903\n    \u0913\u0902 \u0936\u0941\u091a\u092f\u0947 \u0928\u092e\u0903\n    \u0913\u0902 \u0938\u094d\u0935\u093e\u0939\u093e\u092f\u0948 \u0928\u092e\u0903\n    \u0913\u0902 \u0938\u094d\u0935\u0927\u093e\u092f\u0948 \u0928\u092e\u0903\n    \u0913\u0902 \u0938\u0941\u0927\u093e\u092f\u0948 \u0928\u092e\u0903\n    \u0913\u0902 \u0927\u0928\u094d\u092f\u093e\u092f\u0948 \u0928\u092e\u0903\n    \u0913\u0902 \u0939\u093f\u0930\u0923\u094d\u092e\u092f\u0948 \u0928\u092e\u0903\n    \u0913\u0902 \u0932\u0915\u094d\u0937\u094d\u092e\u094d\u092f\u0948 \u0928\u092e\u0903\n    \u0913\u0902 \u0928\u093f\u0924\u094d\u092f\u092a\u0941\u0937\u094d\u091f\u093e\u092f\u0948 \u0928\u092e\u0903\n    \u0913\u0902 \u0935\u093f\u092d\u093e\u0935\u0930\u094d\u092f\u0948 \u0928\u092e\u0903\n    \u0913\u0902 \u0906\u0926\u093f\u0924\u094d\u092f\u093e\u092f\u0948 \u0928\u092e\u0903\n    \u0913\u0902 \u0926\u093f\u0924\u094d\u092f\u0948 \u0928\u092e\u0903\n    \u0913\u0902 \u0926\u0940\u092a\u094d\u0924\u093e\u092f\u0948 \u0928\u092e\u0903\n    \u0913\u0902 \u0935\u0938\u0941\u0927\u093e\u092f\u0948 \u0928\u092e\u0903\n    \u0913\u0902 \u0935\u0938\u0941\u0927\u093e\u0930\u093f\u0923\u094d\u092f\u0948 \u0928\u092e\u0903\n    \u0913\u0902 \u0915\u092e\u0932\u093e\u092f\u0948 \u0928\u092e\u0903\n    \u0913\u0902 \u0915\u093e\u0902\u0924\u093e\u092f\u0948 \u0928\u092e\u0903\n    \u0913\u0902 \u0915\u093e\u092e\u093e\u0915\u094d\u0937\u094d\u092f\u0948 \u0928\u092e\u0903\n    \u0913\u0902 \u0936\u094d\u0930\u0940 \u092e\u093e\u0933\u093f\u0915\u093e\u092a\u0941\u0930\u0924\u094d\u0924\u092e\u094d\u092e\u093e\u092f\u0948 \u0928\u092e\u0903\n    \n    \u092e\u093e\u0933\u093f\u0915\u093e\u092a\u0941\u0930\u0924\u094d\u0924\u092e\u094d\u092e \u0926\u0947\u0935\u093f\u092f\u0947 \u0936\u0930\u0923\u092e\u092f\u094d\u092f\u092a\u094d\u092a!",isAudio:!1,audioDurationSec:40,totalTime:"00:40"},{id:"14",slug:"sri-gomatha-pooja",title:"\u0936\u094d\u0930\u0940 \u0917\u094b\u092e\u093e\u0924\u093e \u092a\u0942\u091c\u093e",description:"[ \u0936\u094d\u0930\u0940 \u0917\u094b\u092e\u093e\u0924 \u092a\u0942\u091c - \u0915\u093e\u092e\u0927\u0947\u0928\u0941 \u092a\u0942\u091c\u093e \u0935\u093f\u0927\u093e\u0928\u0902 ]\n    \n    \u0917\u094b\u0935\u0941 \u0938\u092e\u0938\u094d\u0924 \u092e\u0941\u0915\u094d\u0915\u094b\u091f\u093f \u0926\u0947\u0935\u0924\u0932 \u0928\u093f\u0932\u092f\u092e\u0941. \u0917\u094b\u092e\u093e\u0924\u0928\u0941 \u092a\u0942\u091c\u093f\u0902\u091a\u093f\u0928 \u0938\u0930\u094d\u0935 \u0926\u0947\u0935\u0924\u0932\u0928\u0941 \u092a\u0942\u091c\u093f\u0902\u091a\u093f\u0928 \u092b\u0932\u0902 \u0932\u092d\u093f\u0938\u094d\u0924\u0941\u0902\u0926\u093f.\n    \n    [ \u092a\u094d\u0930\u093e\u0930\u094d\u0925\u0928 ]\n    \u0932\u0915\u094d\u0937\u094d\u092e\u0940\u0930\u094d\u092f\u093e \u0932\u094b\u0915\u092a\u093e\u0932\u093e\u0928\u093e\u0902 \u0927\u0947\u0928\u0941\u0930\u0942\u092a\u0947\u0923 \u0938\u0902\u0938\u094d\u0925\u093f\u0924\u093e\n    \u0917\u0941\u0939\u093e\u0924\u0941 \u0926\u093f\u0935\u094d\u092f\u093e\u0939\u093e\u0930\u093e\u0930\u094d\u0925\u0902 \u092f\u091c\u094d\u091e\u093e\u092f \u0930\u0915\u094d\u0937\u093f\u0924\u093e \u092e\u092f\u093e\n    \n    \u0938\u0930\u094d\u0935\u0926\u0947\u0935\u092e\u092f\u0947 \u0926\u0947\u0935\u093f \u0938\u0930\u094d\u0935\u0924\u0940\u0930\u094d\u0925\u0940\u0915\u0943\u0924\u093e\u0938\u0928\u0947\n    \u092e\u093e\u0924\u0930\u094d\u092e\u092e\u093e\u092d\u093f\u0932\u0937\u093f\u0924\u0902 \u0938\u092b\u0932\u0902 \u0915\u0941\u0930\u0941 \u0928\u0902\u0926\u093f\u0928\u093f\n    \n    [ \u0917\u094b\u092e\u093e\u0924 \u092a\u094d\u0930\u0926\u0915\u094d\u0937\u093f\u0923 \u092e\u0902\u0924\u094d\u0930\u0902 ]\n    \u0917\u093e\u0935\u094b \u092d\u0917\u094b \u0917\u093e\u0935 \u0907\u0902\u0926\u094d\u0930\u094b \u092e\u0947 \u0905\u091a\u094d\u091b\u093e\u0928\u094d\u0928 \u0917\u093e\u0935\u0903 \u0938\u094b\u092e\u0938\u094d\u092f \u092a\u094d\u0930\u0925\u092e\u0938\u094d\u092f \u092d\u0915\u094d\u0937\u0903\n    \u0917\u093e\u0935\u0938\u094d\u0924\u093e \u0905\u0938\u094d\u092e\u093e\u0915\u0902 \u092a\u094d\u0930\u0925\u092e\u093e\u0903 \u092a\u0941\u0928\u093e\u0924\u0941 \u0917\u093e\u0935\u094b \u0935\u0930\u094d\u0927\u093e\u0902\u0924\u0941 \u092d\u0941\u0935\u0928\u0947\u0937\u0941 \u0928\u093f\u0924\u094d\u092f\u092e\u094d\n    \n    [ \u092a\u0942\u091c\u093e \u0938\u092e\u0930\u094d\u092a\u0923 ]\n    \u0913\u0902 \u0936\u094d\u0930\u0940 \u0917\u094b\u092e\u093e\u0924\u094d\u0930\u0947 \u0928\u092e\u0903 - \u0927\u094d\u092f\u093e\u0928\u0902 \u0938\u092e\u0930\u094d\u092a\u092f\u093e\u092e\u093f\n    \u0913\u0902 \u0936\u094d\u0930\u0940 \u0915\u093e\u092e\u0927\u0947\u0928\u0935\u0947 \u0928\u092e\u0903 - \u0906\u0938\u0928\u0902 \u0938\u092e\u0930\u094d\u092a\u092f\u093e\u092e\u093f\n    \u0913\u0902 \u0936\u094d\u0930\u0940 \u0938\u0941\u0930\u092d\u092f\u0947 \u0928\u092e\u0903 - \u092a\u093e\u0926\u094d\u092f\u0902 \u0938\u092e\u0930\u094d\u092a\u092f\u093e\u092e\u093f\n    \u0913\u0902 \u0936\u094d\u0930\u0940 \u0938\u0941\u0936\u0940\u0932\u093e\u092f\u0948 \u0928\u092e\u0903 - \u0905\u0930\u094d\u0918\u094d\u092f\u0902 \u0938\u092e\u0930\u094d\u092a\u092f\u093e\u092e\u093f\n    \u0913\u0902 \u0936\u094d\u0930\u0940 \u092a\u0935\u093f\u0924\u094d\u0930\u093e\u092f\u0948 \u0928\u092e\u0903 - \u0938\u094d\u0928\u093e\u0928\u0902 \u0938\u092e\u0930\u094d\u092a\u092f\u093e\u092e\u093f\n    \u0913\u0902 \u0936\u094d\u0930\u0940 \u091c\u0917\u0926\u094d\u0927\u093e\u0924\u094d\u0930\u093f\u0928\u094d\u092f\u0948 \u0928\u092e\u0903 - \u0935\u0938\u094d\u0924\u094d\u0930\u0902 \u0938\u092e\u0930\u094d\u092a\u092f\u093e\u092e\u093f\n    \u0913\u0902 \u0936\u094d\u0930\u0940 \u0938\u0941\u0917\u0902\u0927\u093e\u092f\u0948 \u0928\u092e\u0903 - \u0917\u0902\u0927\u0902 \u0938\u092e\u0930\u094d\u092a\u092f\u093e\u092e\u093f\n    \u0913\u0902 \u0936\u094d\u0930\u0940 \u0915\u0932\u094d\u092f\u093e\u0923\u094d\u092f\u0948 \u0928\u092e\u0903 - \u092a\u0941\u0937\u094d\u092a\u093e\u0923\u093f \u0938\u092e\u0930\u094d\u092a\u092f\u093e\u092e\u093f\n    \u0913\u0902 \u0936\u094d\u0930\u0940 \u092d\u093e\u0917\u094d\u092f\u0935\u0924\u094d\u092f\u0948 \u0928\u092e\u0903 - \u0927\u0942\u092a\u0902 \u0938\u092e\u0930\u094d\u092a\u092f\u093e\u092e\u093f\n    \u0913\u0902 \u0936\u094d\u0930\u0940 \u092a\u0941\u0923\u094d\u092f\u0930\u0942\u092a\u093e\u092f\u0948 \u0928\u092e\u0903 - \u0926\u0940\u092a\u0902 \u0938\u092e\u0930\u094d\u092a\u092f\u093e\u092e\u093f\n    \u0913\u0902 \u0936\u094d\u0930\u0940 \u0905\u092e\u0943\u0924\u0935\u0930\u094d\u0937\u093f\u0923\u094d\u092f\u0948 \u0928\u092e\u0903 - \u0928\u0948\u0935\u0947\u0926\u094d\u092f\u0902 (\u0917\u094d\u0930\u093e\u0938\u0902/\u092a\u0933\u094d\u0933\u0941) \u0938\u092e\u0930\u094d\u092a\u092f\u093e\u092e\u093f\n    \u0913\u0902 \u0936\u094d\u0930\u0940 \u0917\u094b\u092e\u093e\u0924\u094d\u0930\u0947 \u0928\u092e\u0903 - \u0906\u0928\u0902\u0926 \u0915\u0930\u094d\u092a\u0942\u0930 \u0928\u0940\u0930\u093e\u091c\u0928\u0902 \u0938\u092e\u0930\u094d\u092a\u092f\u093e\u092e\u093f\n    \n    \u0917\u094b\u092e\u093e\u0924\u093e\u092f\u0948 \u0928\u092e\u094b \u0928\u092e\u0903!",isAudio:!1,audioDurationSec:40,totalTime:"00:40"},{id:"15",slug:"ashtottaramulu",title:"\u0905\u0937\u094d\u091f\u094b\u0924\u094d\u0924\u0930 \u0936\u0924\u0928\u093e\u092e\u093e\u0935\u0932\u0940",description:"[ \u0905\u0937\u094d\u091f\u094b\u0924\u094d\u0924\u0930 \u0936\u0924 \u0928\u093e\u092e\u093e\u0935\u0933\u0941\u0932\u0941 - \u0938\u092e\u0917\u094d\u0930 \u0938\u0902\u0917\u094d\u0930\u0939\u0902 ]\n    \n    \u0905\u092f\u094d\u092f\u092a\u094d\u092a \u092a\u0942\u091c\u093e \u0935\u093f\u0927\u093e\u0928\u0902\u0932\u094b \u092e\u0941\u0916\u094d\u092f\u092e\u0948\u0928 \u092a\u0902\u091a \u0926\u0947\u0935\u0924\u093e \u0905\u0937\u094d\u091f\u094b\u0924\u094d\u0924\u0930 \u0936\u0924 \u0928\u093e\u092e\u093e\u0935\u0933\u0941\u0932\u0941:\n    \n    1. \u0936\u094d\u0930\u0940 \u0935\u093f\u0918\u094d\u0928\u0947\u0936\u094d\u0935\u0930 \u0905\u0937\u094d\u091f\u094b\u0924\u094d\u0924\u0930 \u0936\u0924 \u0928\u093e\u092e\u093e\u0935\u0933\u093f\u0903 (\u0913\u0902 \u0917\u091c\u093e\u0928\u0928\u093e\u092f \u0928\u092e\u0903...)\n    2. \u0936\u094d\u0930\u0940 \u0938\u0941\u092c\u094d\u0930\u0939\u094d\u092e\u0923\u094d\u092f \u0905\u0937\u094d\u091f\u094b\u0924\u094d\u0924\u0930 \u0936\u0924 \u0928\u093e\u092e\u093e\u0935\u0933\u093f\u0903 (\u0913\u0902 \u0938\u094d\u0915\u0902\u0926\u093e\u092f \u0928\u092e\u0903...)\n    3. \u0936\u094d\u0930\u0940 \u0905\u092f\u094d\u092f\u092a\u094d\u092a \u0938\u094d\u0935\u093e\u092e\u093f \u0905\u0937\u094d\u091f\u094b\u0924\u094d\u0924\u0930 \u0936\u0924 \u0928\u093e\u092e\u093e\u0935\u0933\u093f\u0903 (\u0913\u0902 \u092e\u0939\u093e\u0936\u093e\u0938\u094d\u0924\u094d\u0930\u0947 \u0928\u092e\u0903...)\n    4. \u0936\u094d\u0930\u0940 \u092e\u093e\u0933\u093f\u0915\u093e\u092a\u0941\u0930\u0924\u094d\u0924\u092e\u094d\u092e \u0905\u0937\u094d\u091f\u094b\u0924\u094d\u0924\u0930 \u0936\u0924 \u0928\u093e\u092e\u093e\u0935\u0933\u093f\u0903 (\u0913\u0902 \u092a\u094d\u0930\u0915\u0943\u0924\u093f\u0930\u0942\u092a\u093e\u092f\u0948 \u0928\u092e\u0903...)\n    5. \u0936\u094d\u0930\u0940 \u0936\u093f\u0935 \u0905\u0937\u094d\u091f\u094b\u0924\u094d\u0924\u0930 \u0936\u0924 \u0928\u093e\u092e\u093e\u0935\u0933\u093f\u0903 (\u0913\u0902 \u0936\u093f\u0935\u093e\u092f \u0928\u092e\u0903...)\n    \n    \u092a\u094d\u0930\u0924\u093f\u0930\u094b\u091c\u0942 \u0908 \u0928\u093e\u092e\u092e\u0941\u0932\u0928\u0941 \u092a\u0920\u093f\u0902\u091a\u0921\u0902 \u0935\u0932\u0928 \u0938\u0930\u094d\u0935 \u0915\u093e\u0930\u094d\u092f\u092e\u0941\u0932\u0941 \u0938\u093f\u0926\u094d\u0927\u093f\u0938\u094d\u0924\u093e\u092f\u093f, \u0906\u092a\u0926\u0932\u0941 \u0924\u094b\u0932\u0917\u093f\u092a\u094b\u0924\u093e\u092f\u093f.\n    \n    \u0938\u094d\u0935\u093e\u092e\u093f\u092f\u0947 \u0936\u0930\u0923\u0902 \u0905\u092f\u094d\u092f\u092a\u094d\u092a!",isAudio:!1,audioDurationSec:40,totalTime:"00:40"},{id:"16",slug:"sri-ayyappa-sahasranamam",title:"\u0936\u094d\u0930\u0940 \u0939\u0930\u093f\u0939\u0930\u092a\u0941\u0924\u094d\u0930 \u0938\u0939\u0938\u094d\u0930\u0928\u093e\u092e\u093e\u0935\u0932\u0940",description:"",isAudio:!1,audioDurationSec:40,totalTime:"00:40"},{id:"17",slug:"ayyappa-harathi",title:"\u092e\u0902\u0917\u0932 \u0906\u0930\u0924\u0940",description:"\u0936\u0902\u0915\u0930\u093e\u092f \u0936\u0902\u0915\u0930\u093e\u092f \u0936\u0902\u0915\u0930\u093e\u092f \u092e\u0902\u0917\u0933\u092e\u094d \u0964\n    \u0936\u0902\u0915\u0930\u0940 \u092e\u0928\u094b\u0939\u0930\u093e\u092f \u0936\u093e\u0936\u094d\u0935\u0924\u093e\u092f \u092e\u0902\u0917\u0933\u092e\u094d \u0965\n    \n    \u0917\u0941\u0930\u0941\u0935\u0930\u093e\u092f \u092e\u0902\u0917\u0933\u0902 \u0926\u0924\u094d\u0924\u093e\u0924\u094d\u0930\u0947\u092f \u092e\u0902\u0917\u0933\u092e\u094d \u0964\n    \u0930\u093e\u091c\u0930\u093e\u092e \u092e\u0902\u0917\u0933\u0902 \u0930\u093e\u092e\u0915\u0943\u0937\u094d\u0923 \u092e\u0902\u0917\u0933\u092e\u094d \u0965\n    \n    \u0905\u092f\u094d\u092f\u092a\u094d\u092a \u092e\u0902\u0917\u0933\u0902 \u092e\u0923\u093f\u0915\u0902\u0920 \u092e\u0902\u0917\u0933\u092e\u094d \u0964\n    \u0936\u092c\u0930\u0940\u0936 \u092e\u0902\u0917\u0933\u0902 \u0936\u093e\u0938\u094d\u0924\u093e\u092f \u092e\u0902\u0917\u0933\u092e\u094d \u0965\n    \n    \u092e\u0902\u0917\u0933\u0902 \u092e\u0902\u0917\u0933\u0902 \u0928\u093f\u0924\u094d\u092f\u091c\u092f \u092e\u0902\u0917\u0933\u092e\u094d \u0964\n    \u092e\u0902\u0917\u0933\u0902 \u092e\u0902\u0917\u0933\u0902 \u0928\u093f\u0924\u094d\u092f\u0936\u0941\u092d \u092e\u0902\u0917\u0933\u092e\u094d \u0965\n    \n    \u0913\u0902 \u0936\u094d\u0930\u0940 \u0938\u094d\u0935\u093e\u092e\u093f\u092f\u0947 \u0936\u0930\u0923\u0902 \u0905\u092f\u094d\u092f\u092a\u094d\u092a\n    \u0913\u0902 \u0936\u094d\u0930\u0940 \u0938\u094d\u0935\u093e\u092e\u093f\u092f\u0947 \u0936\u0930\u0923\u0902 \u0905\u092f\u094d\u092f\u092a\u094d\u092a\n    \u0913\u0902 \u0936\u094d\u0930\u0940 \u0938\u094d\u0935\u093e\u092e\u093f\u092f\u0947 \u0936\u0930\u0923\u0902 \u0905\u092f\u094d\u092f\u092a\u094d\u092a",isAudio:!1,audioDurationSec:40,totalTime:"00:40"},{id:"18",slug:"mantrapushpam",title:"\u092e\u0902\u0924\u094d\u0930\u092a\u0941\u0937\u094d\u092a\u092e\u094d",description:"\u0913\u0902 \u0930\u093e\u091c\u093e\u0927\u093f\u0930\u093e\u091c\u093e\u092f \u092a\u094d\u0930\u0938\u0939\u094d\u092f \u0938\u093e\u0939\u093f\u0928\u0947 \u0928\u092e\u094b \u0935\u092f\u0902 \u0935\u0948\u0936\u094d\u0930\u0935\u0923\u093e\u092f \u0915\u0941\u0930\u094d\u092e\u0939\u0947 \u0964\n    \u0938 \u092e\u0947 \u0915\u093e\u092e\u093e\u0928\u094d \u0915\u093e\u092e\u0915\u093e\u092e\u093e\u092f \u092e\u0939\u094d\u092f\u0902 \u0915\u093e\u092e\u0947\u0936\u094d\u0935\u0930\u094b \u0935\u0948\u0936\u094d\u0930\u0935\u0923\u094b \u0926\u0926\u093e\u0924\u0941 \u0964\n    \u0915\u0941\u092c\u0947\u0930\u093e\u092f \u0935\u0948\u0936\u094d\u0930\u0935\u0923\u093e\u092f \u092e\u0939\u093e\u0930\u093e\u091c\u093e\u092f \u0928\u092e\u0903 \u0965\n    \n    \u0913\u0902 \u0924\u0926\u094d\u092c\u094d\u0930\u0939\u094d\u092e \u0913\u0902 \u0924\u0926\u094d\u0935\u093e\u092f\u0941\u0903 \u0913\u0902 \u0924\u0926\u093e\u0924\u094d\u092e\u093e \u0913\u0902 \u0924\u0924\u094d\u0938\u0924\u094d\u092f\u092e\u094d \u0913\u0902 \u0924\u0924\u094d \u0938\u0930\u094d\u0935\u092e\u094d \u0913\u0902 \u0924\u0924\u094d \u092a\u0941\u0930\u094b\u0930\u094d\u0928\u092e\u0903 \u0965\n    \u0905\u0902\u0924\u0936\u094d\u091a\u0930\u0924\u093f \u092d\u0942\u0924\u0947\u0937\u0941 \u0917\u0941\u0939\u093e\u092f\u093e\u0902 \u0935\u093f\u0936\u094d\u0935\u092e\u0942\u0930\u094d\u0924\u093f\u0937\u0941 \u0964\n    \u0924\u094d\u0935\u0902 \u092f\u091c\u094d\u091e\u0938\u094d\u0924\u094d\u0935\u0902 \u0935\u0937\u091f\u094d\u0915\u093e\u0930\u0938\u094d\u0924\u094d\u0935\u092e\u093f\u0902\u0926\u094d\u0930\u0938\u094d\u0924\u094d\u0935\u0917\u0941\u0902 \u0930\u0941\u0926\u094d\u0930\u0938\u094d\u0924\u094d\u0935\u0902 \u0935\u093f\u0937\u094d\u0923\u0941\u0938\u094d\u0924\u094d\u0935\u0902 \u092c\u094d\u0930\u0939\u094d\u092e\u0924\u094d\u0935\u0902 \u092a\u094d\u0930\u091c\u093e\u092a\u0924\u093f\u0903 \u0964\n    \u0924\u094d\u0935\u0902 \u0924\u0926\u093e\u092a \u0906\u092a\u094b\u091c\u094d\u092f\u094b\u0924\u0940 \u0930\u0938\u094b\u092e\u0943\u0924\u0902 \u092c\u094d\u0930\u0939\u094d\u092e \u092d\u0942\u0930\u094d\u092d\u0941\u0935\u0938\u094d\u0938\u0941\u0935\u0930\u094b\u092e\u094d \u0965\n    \n    \u0913\u0902 \u0928\u092e\u0938\u094d\u0924\u0947 \u0905\u0938\u094d\u0924\u0941 \u092d\u0917\u0935\u0928\u094d \u0935\u093f\u0936\u094d\u0935\u0947\u0936\u094d\u0935\u0930\u093e\u092f \u092e\u0939\u093e\u0926\u0947\u0935\u093e\u092f \u0924\u094d\u0930\u094d\u092f\u0902\u092c\u0915\u093e\u092f \u0924\u094d\u0930\u093f\u092a\u0941\u0930\u093e\u0902\u0924\u0915\u093e\u092f \u0924\u094d\u0930\u093f\u0915\u093e\u0917\u094d\u0928\u093f\u0915\u093e\u0932\u093e\u092f \u0915\u093e\u0932\u093e\u0917\u094d\u0928\u093f\u0930\u0941\u0926\u094d\u0930\u093e\u092f \u0928\u0940\u0932\u0915\u0902\u0920\u093e\u092f \u092e\u0943\u0924\u094d\u092f\u0941\u0902\u091c\u092f\u093e\u092f \u0938\u0930\u094d\u0935\u0947\u0936\u094d\u0935\u0930\u093e\u092f \u0938\u0926\u093e\u0936\u093f\u0935\u093e\u092f \u0936\u094d\u0930\u0940\u092e\u0928\u094d\u092e\u0939\u093e\u0926\u0947\u0935\u093e\u092f \u0928\u092e\u0903 \u0965\n    \n    \u0913\u0902 \u0928\u093f\u0927\u0928\u092a\u0924\u092f\u0947 \u0928\u092e\u0903 \u0928\u093f\u0927\u0928\u092a\u0924\u093e\u0902\u0924\u093f\u0915\u093e\u092f \u0928\u092e\u0903\n    \u090a\u0930\u094d\u0927\u094d\u0935\u093e\u092f \u0928\u092e\u0903 \u090a\u0930\u094d\u0927\u094d\u0935\u0932\u093f\u0902\u0917\u093e\u092f \u0928\u092e\u0903\n    \u0939\u093f\u0930\u0923\u094d\u092f\u093e\u092f \u0928\u092e\u0903 \u0939\u093f\u0930\u0923\u094d\u092f\u0932\u093f\u0902\u0917\u093e\u092f \u0928\u092e\u0903\n    \u0938\u0941\u0935\u0930\u094d\u0923\u093e\u092f \u0928\u092e\u0903 \u0938\u0941\u0935\u0930\u094d\u0923\u0932\u093f\u0902\u0917\u093e\u092f \u0928\u092e\u0903\n    \u0926\u093f\u0935\u094d\u092f\u093e\u092f \u0928\u092e\u0903 \u0926\u093f\u0935\u094d\u092f\u0932\u093f\u0902\u0917\u093e\u092f \u0928\u092e\u0903\n    \u092d\u0935\u093e\u092f \u0928\u092e\u0903 \u092d\u0935\u0932\u093f\u0902\u0917\u093e\u092f \u0928\u092e\u0903\n    \u0938\u0930\u094d\u0935\u093e\u092f \u0928\u092e\u0903 \u0938\u0930\u094d\u0935\u0932\u093f\u0902\u0917\u093e\u092f \u0928\u092e\u0903\n    \u0936\u093f\u0935\u093e\u092f \u0928\u092e\u0903 \u0936\u093f\u0935\u0932\u093f\u0902\u0917\u093e\u092f \u0928\u092e\u0903\n    \u091c\u094d\u0935\u093e\u0932\u093e\u092f \u0928\u092e\u0903 \u091c\u094d\u0935\u093e\u0932\u0932\u093f\u0902\u0917\u093e\u092f \u0928\u092e\u0903\n    \u0906\u0924\u094d\u092e\u093e\u092f \u0928\u092e\u0903 \u0906\u0924\u094d\u092e\u0932\u093f\u0902\u0917\u093e\u092f \u0928\u092e\u0903\n    \u092a\u0930\u092e\u093e\u092f \u0928\u092e\u0903 \u092a\u0930\u092e\u0932\u093f\u0902\u0917\u093e\u092f \u0928\u092e\u0903\n    \u090f\u0924\u0924\u094d \u0938\u094b\u092e\u0938\u094d\u092f \u0938\u0942\u0930\u094d\u092f\u0938\u094d\u092f \u0938\u0930\u094d\u0935\u0932\u093f\u0902\u0917\u0917\u094d\u0902 \u0938\u094d\u0925\u093e\u092a\u092f\u0924\u093f \u092a\u093e\u0923\u093f\u092e\u0902\u0924\u094d\u0930\u0902 \u092a\u0935\u093f\u0924\u094d\u0930\u092e\u094d \u0965\n    \n    \u0938\u0926\u094d\u092f\u094b\u091c\u093e\u0924\u0902 \u092a\u094d\u0930\u092a\u0926\u094d\u092f\u093e\u092e\u093f \u0938\u0926\u094d\u092f\u094b\u091c\u093e\u0924\u093e\u092f \u0935\u0948 \u0928\u092e\u094b \u0928\u092e\u0903 \u0964\n    \u092d\u0935\u0947 \u092d\u0935\u0947 \u0928\u093e\u0924\u093f\u092d\u0935\u0947 \u092d\u0935\u0938\u094d\u0935 \u092e\u093e\u092e\u094d \u092d\u0935\u094b\u0926\u094d\u092d\u0935\u093e\u092f \u0928\u092e\u0903 \u0965\n    \u0935\u093e\u092e\u0926\u0947\u0935\u093e\u092f \u0928\u092e\u094b \u091c\u094d\u092f\u0947\u0937\u094d\u0920\u093e\u092f \u0928\u092e\u0903 \u0936\u094d\u0930\u0947\u0937\u094d\u0920\u093e\u092f \u0928\u092e\u094b \u0930\u0941\u0926\u094d\u0930\u093e\u092f \u0928\u092e\u0903 \u0915\u093e\u0932\u093e\u092f \u0928\u092e\u0903 \u0915\u0932\u0935\u093f\u0915\u0930\u0923\u093e\u092f \u0928\u092e\u094b \u092c\u0932\u0935\u093f\u0915\u0930\u0923\u093e\u092f \u0928\u092e\u094b \u092c\u0932\u093e\u092f \u0928\u092e\u094b \u092c\u0932\u092a\u094d\u0930\u092e\u0925\u0928\u093e\u092f \u0928\u092e\u0903 \u0938\u0930\u094d\u0935\u092d\u0942\u0924\u0926\u092e\u0928\u093e\u092f \u0928\u092e\u094b \u092e\u0928\u094b\u0928\u094d\u092e\u0928\u093e\u092f \u0928\u092e\u0903 \u0965\n    \u0905\u0918\u094b\u0930\u0947\u092d\u094d\u092f\u094b\u0925 \u0918\u094b\u0930\u0947\u092d\u094d\u092f\u094b \u0918\u094b\u0930\u0918\u094b\u0930\u0924\u0930\u0947\u092d\u094d\u092f\u0903 \u0938\u0930\u094d\u0935\u0947\u092d\u094d\u092f\u0903 \u0938\u0930\u094d\u0935 \u0936\u0930\u094d\u0935\u0947\u092d\u094d\u092f\u094b \u0928\u092e\u0938\u094d\u0924\u0947 \u0905\u0938\u094d\u0924\u0941 \u0930\u0941\u0926\u094d\u0930 \u0930\u0942\u092a\u0947\u092d\u094d\u092f\u0903 \u0965\n    \u0924\u0924\u094d\u092a\u0941\u0930\u0941\u0937\u093e\u092f \u0935\u093f\u0926\u094d\u092e\u0939\u0947 \u092e\u0939\u093e\u0926\u0947\u0935\u093e\u092f \u0927\u0940\u092e\u0939\u093f \u0924\u0928\u094d\u0928\u094b \u0930\u0941\u0926\u094d\u0930\u0903 \u092a\u094d\u0930\u091a\u094b\u0926\u092f\u093e\u0924\u094d \u0965\n    \u0908\u0936\u093e\u0928\u0938\u094d\u0938\u0930\u094d\u0935\u0935\u093f\u0926\u094d\u092f\u093e\u0928\u093e\u092e\u0940\u0936\u094d\u0935\u0930\u0938\u094d\u0938\u0930\u094d\u0935 \u092d\u0942\u0924\u093e\u0928\u093e\u0902 \u092c\u094d\u0930\u0939\u094d\u092e\u093e\u0927\u093f\u092a\u0924\u093f\u0930\u094d\u092c\u094d\u0930\u0939\u094d\u092e\u0923\u094b\u0927\u093f\u092a\u0924\u093f\u0930\u094d\u092c\u094d\u0930\u0939\u094d\u092e\u093e \u0936\u093f\u0935\u094b \u092e\u0947 \u0905\u0938\u094d\u0924\u0941 \u0938\u0926\u093e\u0936\u093f\u0935\u094b\u092e\u094d \u0965\n    \n    \u0913\u0902 \u0924\u0924\u094d\u092a\u0941\u0930\u0941\u0937\u093e\u092f \u0935\u093f\u0926\u094d\u092e\u0939\u0947 \u092e\u0939\u093e\u0926\u0947\u0935\u093e\u092f \u0927\u0940\u092e\u0939\u093f \u0924\u0928\u094d\u0928\u094b \u0930\u0941\u0926\u094d\u0930\u0903 \u092a\u094d\u0930\u091a\u094b\u0926\u092f\u093e\u0924\u094d \u0965\n    \u0913\u0902 \u0928\u093e\u0930\u093e\u092f\u0923\u093e\u092f \u0935\u093f\u0926\u094d\u092e\u0939\u0947 \u0935\u093e\u0938\u0941\u0926\u0947\u0935\u093e\u092f \u0927\u0940\u092e\u0939\u093f \u0924\u0928\u094d\u0928\u094b \u0935\u093f\u0937\u094d\u0923\u0941\u0903 \u092a\u094d\u0930\u091a\u094b\u0926\u092f\u093e\u0924\u094d \u0965\n    \u0913\u0902 \u092d\u0942\u0924\u0928\u093e\u0925\u093e\u092f \u0935\u093f\u0926\u094d\u092e\u0939\u0947 \u092d\u0935\u092a\u0941\u0924\u094d\u0930\u093e\u092f \u0927\u0940\u092e\u0939\u093f \u0924\u0928\u094d\u0928\u094b \u0936\u093e\u0938\u094d\u0924\u093e \u092a\u094d\u0930\u091a\u094b\u0926\u092f\u093e\u0924\u094d \u0965",isAudio:!1,audioDurationSec:40,totalTime:"00:40"},{id:"19",slug:"sastha-dasakam",title:"\u0928\u092e\u0938\u094d\u0915\u093e\u0930 \u0936\u094d\u0932\u094b\u0915",description:"\u0932\u094b\u0915\u0935\u0940\u0930\u0902 \u092e\u0939\u093e\u092a\u0942\u091c\u094d\u092f\u0902 \u0938\u0930\u094d\u0935\u0930\u0915\u094d\u0937\u093e\u0915\u0930\u0902 \u0935\u093f\u092d\u0941\u092e\u094d \u0964\n    \u092a\u093e\u0930\u094d\u0935\u0924\u0940 \u0939\u0943\u0926\u092f\u093e\u0928\u0902\u0926\u0902 \u0936\u093e\u0938\u094d\u0924\u093e\u0930\u0902 \u092a\u094d\u0930\u0923\u092e\u093e\u092e\u094d\u092f\u0939\u092e\u094d \u0965 1\n    \n    \u0935\u093f\u092a\u094d\u0930\u092a\u0942\u091c\u094d\u092f\u0902 \u0935\u093f\u0936\u094d\u0935\u0935\u0902\u0926\u094d\u092f\u0902 \u0935\u093f\u0937\u094d\u0923\u0941\u0936\u0902\u092d\u094b\u0903 \u092a\u094d\u0930\u093f\u092f\u0902 \u0938\u0941\u0924\u092e\u094d \u0964\n    \u0915\u094d\u0937\u093f\u092a\u094d\u0930\u092a\u094d\u0930\u0938\u093e\u0926\u0928\u093f\u0930\u0924\u0902 \u0936\u093e\u0938\u094d\u0924\u093e\u0930\u0902 \u092a\u094d\u0930\u0923\u092e\u093e\u092e\u094d\u092f\u0939\u092e\u094d \u0965 2\n    \n    \u092e\u0924\u094d\u0924\u092e\u093e\u0924\u0902\u0917\u0917\u092e\u0928\u0902 \u0915\u093e\u0930\u0941\u0923\u094d\u092f\u093e\u092e\u0943\u0924\u092a\u0942\u0930\u093f\u0924\u092e\u094d \u0964\n    \u0938\u0930\u094d\u0935\u0935\u093f\u0918\u094d\u0928\u0939\u0930\u0902 \u0926\u0947\u0935\u0902 \u0936\u093e\u0938\u094d\u0924\u093e\u0930\u0902 \u092a\u094d\u0930\u0923\u092e\u093e\u092e\u094d\u092f\u0939\u092e\u094d \u0965 3\n    \n    \u0905\u0938\u094d\u092e\u0924\u094d\u0915\u0941\u0932\u0947\u0936\u094d\u0935\u0930\u0902 \u0926\u0947\u0935\u092e\u0938\u094d\u092e\u091a\u094d\u091b\u0924\u094d\u0930\u0941\u0935\u093f\u0928\u093e\u0936\u0928\u092e\u094d \u0964\n    \u0905\u0938\u094d\u092e\u0926\u093f\u0937\u094d\u091f\u092a\u094d\u0930\u0926\u093e\u0924\u093e\u0930\u0902 \u0936\u093e\u0938\u094d\u0924\u093e\u0930\u0902 \u092a\u094d\u0930\u0923\u092e\u093e\u092e\u094d\u092f\u0939\u092e\u094d \u0965 4\n    \n    \u092a\u093e\u0902\u0921\u094d\u092f\u0947\u0936\u0935\u0902\u0936\u0924\u093f\u0932\u0915\u0902 \u0915\u0947\u0930\u0933\u0947 \u0915\u0947\u0933\u093f\u0935\u093f\u0917\u094d\u0930\u0939\u092e\u094d \u0964\n    \u0906\u0930\u094d\u0924\u0924\u094d\u0930\u093e\u0923\u092a\u0930\u0902 \u0926\u0947\u0935\u0902 \u0936\u093e\u0938\u094d\u0924\u093e\u0930\u0902 \u092a\u094d\u0930\u0923\u092e\u093e\u092e\u094d\u092f\u0939\u092e\u094d \u0965 5\n    \n    \u0924\u094d\u0930\u094d\u092f\u0902\u092c\u0915\u092a\u0941\u0930\u093e\u0927\u0940\u0936\u0902 \u0917\u0923\u093e\u0927\u093f\u092a \u0938\u092e\u0928\u094d\u0935\u093f\u0924\u092e\u094d \u0964\n    \u0917\u091c\u093e\u0930\u0942\u0922\u092e\u0939\u0902 \u0935\u0902\u0926\u0947 \u0936\u093e\u0938\u094d\u0924\u093e\u0930\u0902 \u092a\u094d\u0930\u0923\u092e\u093e\u092e\u094d\u092f\u0939\u092e\u094d \u0965 6\n    \n    \u0936\u093f\u0935\u0935\u0940\u0930\u094d\u092f \u0938\u092e\u0941\u0926\u094d\u092d\u0942\u0924\u0902 \u0936\u094d\u0930\u0940\u0928\u093f\u0935\u093e\u0938 \u0924\u0928\u0941\u0926\u094d\u092d\u0935\u092e\u094d \u0964\n    \u0936\u093f\u0916\u093f\u0935\u093e\u0939\u093e\u0928\u0941\u091c\u0902 \u0935\u0902\u0926\u0947 \u0936\u093e\u0938\u094d\u0924\u093e\u0930\u0902 \u092a\u094d\u0930\u0923\u092e\u093e\u092e\u094d\u092f\u0939\u092e\u094d \u0965 7\n    \n    \u092f\u0938\u094d\u092f \u0927\u0928\u094d\u0935\u0902\u0924\u0930\u093f\u0930\u094d\u092e\u093e\u0924\u093e \u092a\u093f\u0924\u093e \u0926\u0947\u0935\u094b \u092e\u0939\u0947\u0936\u094d\u0935\u0930\u0903 \u0964\n    \u0924\u0902 \u0936\u093e\u0938\u094d\u0924\u093e\u0930\u092e\u0939\u0902 \u0935\u0902\u0926\u0947 \u092e\u0939\u093e\u0930\u094b\u0917\u0928\u093f\u0935\u093e\u0930\u0923\u092e\u094d \u0965 8\n    \n    \u092d\u0942\u0924\u0928\u093e\u0925 \u0938\u0926\u093e\u0928\u0902\u0926 \u0938\u0930\u094d\u0935\u092d\u0942\u0924 \u0926\u092f\u093e\u092a\u0930 \u0964\n    \u0930\u0915\u094d\u0937 \u0930\u0915\u094d\u0937 \u092e\u0939\u093e\u092c\u093e\u0939\u094b \u0936\u093e\u0938\u094d\u0924\u094d\u0930\u0947 \u0924\u0941\u092d\u094d\u092f\u0902 \u0928\u092e\u094b \u0928\u092e\u0903 \u0965 9\n    \n    \u0906\u0936\u094d\u092f\u093e\u092e\u0915\u094b\u092e\u0932 \u0935\u093f\u0936\u093e\u0932\u0924\u0928\u0941\u0902 \u0935\u093f\u091a\u093f\u0924\u094d\u0930\u0902\n    \u0935\u093e\u0938\u094b\u0935\u0938\u093e\u0928\u092e\u0930\u0941\u0923\u094b\u0924\u094d\u092a\u0932\u0926\u093e\u092e\u0939\u0938\u094d\u0924\u092e\u094d \u0964\n    \u0909\u0924\u094d\u0924\u0941\u0902\u0917\u0930\u0924\u094d\u0928\u092e\u0915\u0941\u091f\u0902 \u0915\u0941\u091f\u093f\u0932\u093e\u0917\u094d\u0930\u0915\u0947\u0936\u0902\n    \u0936\u093e\u0938\u094d\u0924\u093e\u0930\u092e\u093f\u0937\u094d\u091f\u0935\u0930\u0926\u0902 \u0936\u0930\u0923\u0902 \u092a\u094d\u0930\u092a\u0926\u094d\u092f\u0947 \u0965 10",isAudio:!1,audioDurationSec:40,totalTime:"00:40"},{id:"20",slug:"bhajana-keerthanalu",title:"\u092d\u091c\u0928 \u0915\u0940\u0930\u094d\u0924\u0928",description:"[ \u0936\u094d\u0930\u0940 \u0905\u092f\u094d\u092f\u092a\u094d\u092a \u092d\u091c\u0928 \u0915\u0940\u0930\u094d\u0924\u0928\u0932\u0941 ]\n    \n    1. \u092d\u0917\u0935\u093e\u0928\u094d \u0936\u0930\u0923\u0902 \u092d\u0917\u0935\u0924\u093f \u0936\u0930\u0923\u0902\n    \u092d\u0917\u0935\u093e\u0928\u094d \u0936\u0930\u0923\u0902 \u092d\u0917\u0935\u0924\u093f \u0936\u0930\u0923\u0902 \u0936\u0930\u0923\u0902 \u0936\u0930\u0923\u092e\u092f\u094d\u092f\u092a\u094d\u092a\u093e\n    \u092d\u0917\u0935\u0924\u093f \u0936\u0930\u0923\u0902 \u092d\u0917\u0935\u093e\u0928\u094d \u0936\u0930\u0923\u0902 \u0936\u0930\u0923\u0902 \u0936\u0930\u0923\u092e\u092f\u094d\u092f\u092a\u094d\u092a\u093e\n    \n    \u0926\u0947\u0935\u0928\u094d \u0936\u0930\u0923\u0902 \u0926\u0947\u0935\u093f \u0936\u0930\u0923\u0902 \u0936\u0930\u0923\u0902 \u0936\u0930\u0923\u092e\u092f\u094d\u092f\u092a\u094d\u092a\u093e\n    \u0926\u0947\u0935\u093f \u0936\u0930\u0923\u0902 \u0926\u0947\u0935\u0928\u094d \u0936\u0930\u0923\u0902 \u0936\u0930\u0923\u0902 \u0936\u0930\u0923\u092e\u092f\u094d\u092f\u092a\u094d\u092a\u093e\n    \n    2. \u092a\u0932\u094d\u0932\u0947\u0915\u091f\u094d\u091f\u0941 \u0936\u092c\u0930\u093f\u092e\u0932\u0948\u0915\u093f\n    \u092a\u0932\u094d\u0932\u0947\u0915\u091f\u094d\u091f\u0941 \u0936\u092c\u0930\u093f\u092e\u0932\u0948\u0915\u093f \u0915\u0932\u094d\u0932\u0941\u092e\u0941\u0932\u094d\u0932\u0941 \u0915\u093e\u0932\u093f\u0915\u0940 \u092e\u0947\u0924\u094d\u0924\u0948\n    \u0938\u094d\u0935\u093e\u092e\u093f\u092f\u0947 \u0905\u092f\u094d\u092f\u092a\u094d\u092a\u094b \u0905\u092f\u094d\u092f\u092a\u094d\u092a\u094b \u0938\u094d\u0935\u093e\u092e\u093f\u092f\u0947!\n    \n    \u0907\u0930\u0941\u092e\u0941\u0921\u093f \u0924\u093e\u0902\u0917\u093f \u0913\u0930\u0941\u092e\u0928\u0926\u093e\u0917\u093f \u0917\u0941\u0930\u0941\u0935\u0947\u0928 \u092a\u0928\u093f\u0902\u0926\u0941 \u0935\u0902\u0926\u094b\u092e\u0947\n    \u0915\u0930\u0941\u092a\u094d\u092a\u0941 \u0935\u093e\u0935\u0930\u0941 \u0938\u094d\u0935\u093e\u092e\u093f\u092f\u0947 \u090f\u0902\u0917\u0933\u0948 \u0915\u093e\u092a\u093e\u0921 \u0935\u0947\u0902\u0921\u0941\u092e\u0947\n    \n    3. \u0905\u092f\u094d\u092f\u092a\u094d\u092a\u093e \u0924\u093f\u0902\u0924\u093f\u0924\u094d\u0924\u0915\u0924\u094b\u0902\n    \u0938\u094d\u0935\u093e\u092e\u093f \u0924\u093f\u0902\u0924\u093f\u0924\u094d\u0924\u0915\u0924\u094b\u0902 \u0905\u092f\u094d\u092f\u092a\u094d\u092a \u0924\u093f\u0902\u0924\u093f\u0924\u094d\u0924\u0915\u0924\u094b\u0902\n    \u090f\u0930\u0941\u092e\u0947\u0932\u093f \u0936\u093e\u0938\u094d\u0924\u093e \u0924\u093f\u0902\u0924\u093f\u0924\u094d\u0924\u0915\u0924\u094b\u0902\n    \u0915\u0928\u094d\u0928\u093f\u092e\u0942\u0932 \u0917\u0923\u092a\u0924\u093f \u0924\u093f\u0902\u0924\u093f\u0924\u094d\u0924\u0915\u0924\u094b\u0902\n    \u092e\u093e\u0933\u093f\u0915\u093e\u092a\u0941\u0930\u0924\u094d\u0924\u092e\u094d\u092e \u0924\u093f\u0902\u0924\u093f\u0924\u094d\u0924\u0915\u0924\u094b\u0902\n    \n    \u0938\u094d\u0935\u093e\u092e\u093f\u092f\u0947 \u0936\u0930\u0923\u0902 \u0905\u092f\u094d\u092f\u092a\u094d\u092a!",isAudio:!1,audioDurationSec:40,totalTime:"00:40"},{id:"21",slug:"harivarasanam",title:"\u0939\u0930\u093f\u0935\u0930\u093e\u0938\u0928\u092e\u094d",description:"\u0939\u0930\u093f\u0935\u0930\u093e\u0938\u0928\u0902 \u0935\u093f\u0936\u094d\u0935\u092e\u094b\u0939\u0928\u0902 \u0939\u0930\u093f\u0926\u0927\u0940\u0936\u094d\u0935\u0930\u0902 \u0906\u0930\u093e\u0927\u094d\u092f\u092a\u093e\u0926\u0941\u0915\u0902...",isAudio:!0,audioDurationSec:40,totalTime:"00:40",chantLyric:"\u0939\u0930\u093f\u0935\u0930\u093e\u0938\u0928\u0902 \u0935\u093f\u0936\u094d\u0935\u092e\u094b\u0939\u0928\u0902 \u0939\u0930\u093f\u0926\u0927\u0940\u0936\u094d\u0935\u0930\u0902 \u0906\u0930\u093e\u0927\u094d\u092f\u092a\u093e\u0926\u0941\u0915\u092e\u094d"},{id:"22",slug:"koodalmanikya-vishnu-sthuthi",title:"\u0915\u0942\u0921\u0932\u092e\u093e\u0923\u093f\u0915\u094d\u092f \u0935\u093f\u0937\u094d\u0923\u0941 \u0938\u094d\u0924\u0941\u0924\u093f",description:"[ \u0915\u0941\u0921\u0932\u094d\u092f\u093e\u0923\u093f\u0915\u094d\u092f (\u0935\u093f\u0937\u094d\u0923\u0941) \u0938\u094d\u0924\u0941\u0924\u093f ]\n    \n    \u0936\u093e\u0902\u0924\u093e\u0915\u093e\u0930\u0902 \u092d\u0941\u091c\u0917\u0936\u092f\u0928\u0902 \u092a\u0926\u094d\u092e\u0928\u093e\u092d\u0902 \u0938\u0941\u0930\u0947\u0936\u0902\n    \u0935\u093f\u0936\u094d\u0935\u093e\u0927\u093e\u0930\u0902 \u0917\u0917\u0928\u0938\u0926\u0943\u0936\u0902 \u092e\u0947\u0918\u0935\u0930\u094d\u0923\u0902 \u0936\u0941\u092d\u093e\u0902\u0917\u092e\u094d\n    \u0932\u0915\u094d\u0937\u094d\u092e\u0940\u0915\u093e\u0902\u0924\u0902 \u0915\u092e\u0932\u0928\u092f\u0928\u0902 \u092f\u094b\u0917\u093f\u0939\u0943\u0926\u094d\u0927\u094d\u092f\u093e\u0928\u0917\u092e\u094d\u092f\u0902\n    \u0935\u0902\u0926\u0947 \u0935\u093f\u0937\u094d\u0923\u0941\u0902 \u092d\u0935\u092d\u092f\u0939\u0930\u0902 \u0938\u0930\u094d\u0935\u0932\u094b\u0915\u0948\u0915\u0928\u093e\u0925\u092e\u094d\n    \n    \u0913\u0902 \u0928\u092e\u094b \u0928\u093e\u0930\u093e\u092f\u0923\u093e\u092f\n    \u0913\u0902 \u0928\u092e\u094b \u092d\u0917\u0935\u0924\u0947 \u0935\u093e\u0938\u0941\u0926\u0947\u0935\u093e\u092f\n    \n    \u0915\u0941\u0921\u0932\u094d\u092f\u093e\u0923\u093f\u0915\u094d\u092f \u0938\u0902\u0917\u092e\u0947\u0936\u094d\u0935\u0930 \u0938\u094d\u0935\u093e\u092e\u093f\u092f\u0947 \u0928\u092e\u0903\n    \u0939\u0930\u093f\u0939\u0930 \u0938\u0941\u0924\u0928\u0947 \u0936\u0930\u0923\u092e\u092f\u094d\u092f\u092a\u094d\u092a!",isAudio:!0,audioDurationSec:40,totalTime:"00:40",chantLyric:"\u0939\u0930\u093f\u0935\u0930\u093e\u0938\u0928\u0902 \u0935\u093f\u0936\u094d\u0935\u092e\u094b\u0939\u0928\u0902 \u0939\u0930\u093f\u0926\u0927\u0940\u0936\u094d\u0935\u0930\u0902 \u0906\u0930\u093e\u0927\u094d\u092f\u092a\u093e\u0926\u0941\u0915\u092e\u094d"},{id:"23",slug:"shabarimala-temple-opening-dates",title:"\u0938\u092c\u0930\u0940\u092e\u093e\u0932\u093e \u092e\u0902\u0926\u093f\u0930 \u0926\u0930\u094d\u0936\u0928 \u0924\u093f\u0925\u093f\u092f\u093e\u0902",description:"[ Opening and closing of Sabarimala Sree Dharmasastha Temple for the year (2026 - 2027) ]\n    \u0915\u0947\u0930\u0933\u0932\u094b\u0928\u093f \u0936\u092c\u0930\u093f\u092e\u0932 \u0905\u092f\u094d\u092f\u092a\u094d\u092a \u0906\u0932\u092f\u0902 \u0938\u0902\u0935\u0924\u094d\u0938\u0930\u0902\u0932\u094b \u0915\u094b\u0928\u094d\u0928\u093f \u0928\u093f\u0930\u094d\u0926\u093f\u0937\u094d\u091f \u0938\u092e\u092f\u093e\u0932\u094d\u0932\u094b \u092e\u093e\u0924\u094d\u0930\u092e\u0947 \u0926\u0930\u094d\u0936\u0928\u093e\u0930\u094d\u0925\u0902 \u0924\u0947\u0930\u0935\u092c\u0921\u0941\u0924\u0941\u0902\u0926\u093f. \u0915\u094d\u0930\u093f\u0902\u0926 2026 - 2027 \u0938\u0902\u0935\u0924\u094d\u0938\u0930\u0902\u0932\u094b \u0936\u092c\u0930\u093f\u092e\u0932 \u0905\u092f\u094d\u092f\u092a\u094d\u092a \u0906\u0932\u092f\u0902 \u0924\u0947\u0930\u093f\u091a\u093f \u0909\u0902\u0921\u0947 \u0924\u0947\u0926\u0940\u0932 \u0935\u093f\u0935\u0930\u093e\u0932\u0941 \u0909\u0928\u094d\u0928\u093e\u092f\u093f.\n    \n    \u0913\u0902 \u0936\u094d\u0930\u0940 \u0938\u094d\u0935\u093e\u092e\u093f\u092f\u0947 \u0936\u0930\u0923\u0902 \u0905\u092f\u094d\u092f\u092a\u094d\u092a\n    \n    [ \u0917\u0924 \u0938\u0902\u0935\u0924\u094d\u0938\u0930\u0902 2025 \u092e\u0902\u0921\u0932 \u092a\u0942\u091c & \u0924\u093f\u0930\u0941\u0928\u0921\u0948 \u0924\u093f\u0930\u092a\u094d\u092a\u0941 - 2026 \u092e\u0915\u0930\u0935\u093f\u0933\u0915\u094d\u0915\u0941 \u092e\u0939\u094b\u0924\u094d\u0938\u0935\u0902 ]\n    \u2022 \u0921\u093f\u0938\u0947\u0902\u092c\u0930\u094d 2025 : \u092e\u0902\u0921\u0932 \u092a\u0942\u091c (\u0924\u0947\u0930\u093f\u091a\u0947 \u0924\u0947\u0926\u0940: 16/11/2025 \u2013 \u092e\u0941\u0917\u093f\u0902\u092a\u0941: 27/12/2025)\n    \u2022 \u0921\u093f\u0938\u0947\u0902\u092c\u0930\u094d 2025 : \u0924\u093f\u0930\u0941\u0928\u0921\u0948 \u0924\u093f\u0930\u092a\u094d\u092a\u0941 - \u092e\u0915\u0930\u0935\u093f\u0933\u0915\u094d\u0915\u0941 \u092e\u0939\u094b\u0924\u094d\u0938\u0935\u0902 (\u0924\u0947\u0930\u093f\u091a\u0947 \u0924\u0947\u0926\u0940: 30/12/2025 \u2013 \u092e\u0941\u0917\u093f\u0902\u092a\u0941: 20/01/2026)\n    \n    \u0913\u0902 \u0936\u094d\u0930\u0940 \u0938\u094d\u0935\u093e\u092e\u093f\u092f\u0947 \u0936\u0930\u0923\u0902 \u0905\u092f\u094d\u092f\u092a\u094d\u092a\n    \n    [ 2026-2027 \u0906\u0932\u092f\u0902 \u0924\u0947\u0930\u093f\u091a\u0947 \u092e\u0930\u093f\u092f\u0941 \u092e\u0941\u0917\u093f\u0938\u0947 \u0924\u0947\u0926\u0940\u0932 \u092a\u091f\u094d\u091f\u093f\u0915 ]\n    \u2022 \u091c\u0928\u0935\u0930\u093f 2026 : \u092e\u0915\u0930\u0935\u093f\u0933\u0915\u094d\u0915\u0941 \u0926\u093f\u0928\u0902 (14/01/2026 \u2013 20/01/2026)\n    \u2022 \u092b\u093f\u092c\u094d\u0930\u0935\u0930\u093f 2026 : \u092e\u093e\u0938 \u092a\u0942\u091c - \u0915\u0941\u0902\u092d\u0902 (12/02/2026 \u0938\u093e\u092f\u0902\u0924\u094d\u0930\u0902 5\u0917\u0902 \u2013 17/02/2026 \u0930\u093e\u0924\u094d\u0930\u093f 10\u0917\u0902)\n    \u2022 \u092e\u093e\u0930\u094d\u091a\u093f 2026 : \u092e\u093e\u0938 \u092a\u0942\u091c - \u092e\u0940\u0928\u0902 (14/03/2026 \u0938\u093e\u092f\u0902\u0924\u094d\u0930\u0902 5\u0917\u0902 \u2013 19/03/2026 \u0930\u093e\u0924\u094d\u0930\u093f 10\u0917\u0902)\n    \u2022 \u092e\u093e\u0930\u094d\u091a\u093f 2026 : \u0936\u092c\u0930\u093f\u092e\u0932 \u0909\u0924\u094d\u0938\u0935\u0902 (22/03/2026 \u0938\u093e\u092f\u0902\u0924\u094d\u0930\u0902 5\u0917\u0902 \u2013 01/04/2026 \u0930\u093e\u0924\u094d\u0930\u093f 10\u0917\u0902)\n    \u2022 \u092e\u093e\u0930\u094d\u091a\u093f 2026 : \u0915\u094b\u0921\u093f\u092f\u0947\u091f\u094d\u091f\u0941 (\u0927\u094d\u0935\u091c\u093e\u0930\u094b\u0939\u0923\u0902) (23/03/2026)\n    \u2022 \u090f\u092a\u094d\u0930\u093f\u0932\u094d 2026 : \u092a\u0902\u0917\u0941\u0928\u093f \u0909\u0924\u094d\u0930\u0902 & \u0906\u0930\u093e\u091f\u094d\u091f\u0941 (01/04/2026 \u2013 01/04/2026 \u0930\u093e\u0924\u094d\u0930\u093f 10\u0917\u0902)\n    \u2022 \u090f\u092a\u094d\u0930\u093f\u0932\u094d 2026 : \u092e\u0947\u0921 \u0935\u093f\u0937\u0941 \u092a\u0902\u0921\u0941\u0917 (11/04/2026 \u0938\u093e\u092f\u0902\u0924\u094d\u0930\u0902 5\u0917\u0902 \u2013 18/04/2026 \u0930\u093e\u0924\u094d\u0930\u093f 10\u0917\u0902)\n    \u2022 \u090f\u092a\u094d\u0930\u093f\u0932\u094d 2026 : \u0935\u093f\u0937\u0941 \u0926\u093f\u0928\u0902 (15/04/2026)\n    \u2022 \u092e\u0947 2026 : \u092e\u093e\u0938 \u092a\u0942\u091c - \u090f\u0921\u0935\u092e\u094d (14/05/2026 \u0938\u093e\u092f\u0902\u0924\u094d\u0930\u0902 5\u0917\u0902 \u2013 19/05/2026 \u0930\u093e\u0924\u094d\u0930\u093f 10\u0917\u0902)\n    \u2022 \u092e\u0947 2026 : \u092a\u094d\u0930\u0924\u093f\u0937\u094d\u0920\u093e \u0926\u093f\u0928 \u092a\u0942\u091c (25/05/2026 \u2013 26/05/2026)\n    \u2022 \u091c\u0942\u0928\u094d 2026 : \u092e\u093e\u0938 \u092a\u0942\u091c - \u092e\u093f\u0925\u0941\u0928\u0902 (14/06/2026 \u0938\u093e\u092f\u0902\u0924\u094d\u0930\u0902 5\u0917\u0902 \u2013 19/06/2026 \u0930\u093e\u0924\u094d\u0930\u093f 10\u0917\u0902)\n    \u2022 \u091c\u0942\u0932\u0948 2026 : \u092e\u093e\u0938 \u092a\u0942\u091c - \u0915\u0930\u094d\u0915\u091f\u0915\u0902 (16/07/2026 \u0938\u093e\u092f\u0902\u0924\u094d\u0930\u0902 5\u0917\u0902 \u2013 21/07/2026 \u0930\u093e\u0924\u094d\u0930\u093f 10\u0917\u0902)\n    \u2022 \u0906\u0917\u0938\u094d\u091f\u0941 2026 : \u092e\u093e\u0938 \u092a\u0942\u091c - \u091a\u093f\u0902\u0917\u0902 (16/08/2026 \u0938\u093e\u092f\u0902\u0924\u094d\u0930\u0902 5\u0917\u0902 \u2013 21/08/2026 \u0930\u093e\u0924\u094d\u0930\u093f 10\u0917\u0902)\n    \u2022 \u0906\u0917\u0938\u094d\u091f\u0941 2026 : \u0913\u0923\u0902 \u092a\u0942\u091c (24/08/2026 \u2013 28/08/2026)\n    \u2022 \u0906\u0917\u0938\u094d\u091f\u0941 2026 : \u0913\u0923\u0902 \u0926\u093f\u0928\u0902 (26/08/2026)\n    \u2022 \u0938\u0947\u092a\u094d\u091f\u0947\u0902\u092c\u0930\u094d 2026 : \u092e\u093e\u0938 \u092a\u0942\u091c - \u0915\u0928\u094d\u0928\u093f (16/09/2026 \u0938\u093e\u092f\u0902\u0924\u094d\u0930\u0902 5\u0917\u0902 \u2013 21/09/2026 \u0930\u093e\u0924\u094d\u0930\u093f 10\u0917\u0902)\n    \u2022 \u0905\u0915\u094d\u091f\u094b\u092c\u0930\u094d 2026 : \u092e\u093e\u0938 \u092a\u0942\u091c - \u0924\u0941\u0932\u0902 (17/10/2026 \u0938\u093e\u092f\u0902\u0924\u094d\u0930\u0902 5\u0917\u0902 \u2013 22/10/2026 \u0930\u093e\u0924\u094d\u0930\u093f 10\u0917\u0902)\n    \u2022 \u0928\u0935\u0902\u092c\u0930\u094d 2026 : \u0936\u094d\u0930\u0940 \u091a\u093f\u0924\u094d\u0930 \u0905\u091f\u094d\u091f \u0924\u093f\u0930\u0941\u0928\u093e\u0933\u094d (06/11/2026 \u0938\u093e\u092f\u0902\u0924\u094d\u0930\u0902 5\u0917\u0902 \u2013 07/11/2026 \u0930\u093e\u0924\u094d\u0930\u093f 10\u0917\u0902)\n    \u2022 \u0928\u0935\u0902\u092c\u0930\u094d 2026 : \u092e\u0902\u0921\u0932 \u092a\u0942\u091c \u092e\u0939\u094b\u0924\u094d\u0938\u0935\u0902 (16/11/2026 \u0938\u093e\u092f\u0902\u0924\u094d\u0930\u0902 5\u0917\u0902 \u2013 27/12/2026)\n    \u2022 \u0921\u093f\u0938\u0947\u0902\u092c\u0930\u094d 2026 : \u092e\u0902\u0921\u0932 \u092a\u0942\u091c (27/12/2026)\n    \u2022 \u0921\u093f\u0938\u0947\u0902\u092c\u0930\u094d 2026 : \u0924\u093f\u0930\u0941\u0928\u0921\u0948 \u0924\u093f\u0930\u092a\u094d\u092a\u0941 - \u092e\u0915\u0930\u0935\u093f\u0933\u0915\u094d\u0915\u0941 \u092e\u0939\u094b\u0924\u094d\u0938\u0935\u0902 (30/12/2026 \u2013 20/01/2027)\n    \u2022 \u091c\u0928\u0935\u0930\u093f 2027 : \u092e\u0915\u0930\u0935\u093f\u0933\u0915\u094d\u0915\u0941 \u0926\u093f\u0928\u0902 (14/01/2027)\n    \n    [ \u092e\u0941\u0916\u094d\u092f \u0917\u092e\u0928\u093f\u0915 ]\n    \u0936\u092c\u0930\u093f\u092e\u0932 \u0906\u0932\u092f\u0902 \u0938\u093e\u0927\u093e\u0930\u0923\u0902\u0917\u093e \u0909\u0926\u092f\u0902 05.00 \u0917\u0902\u091f\u0932\u0915\u0941 \u0924\u0947\u0930\u0941\u0935\u092c\u0921\u0941\u0924\u0941\u0902\u0926\u093f \u092e\u0930\u093f\u092f\u0941 \u0930\u093e\u0924\u094d\u0930\u093f 10.00 \u0917\u0902\u091f\u0932\u0915\u0941 \u092e\u0942\u0938\u093f\u0935\u0947\u092f\u092c\u0921\u0941\u0924\u0941\u0902\u0926\u093f. \u092e\u0915\u0930\u0935\u093f\u0933\u0915\u094d\u0915\u0941 \u092e\u0939\u094b\u0924\u094d\u0938\u0935\u0902 \u0935\u0902\u091f\u093f \u0930\u0926\u094d\u0926\u0940 \u0938\u092e\u092f\u093e\u0932\u