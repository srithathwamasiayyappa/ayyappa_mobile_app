u092e\u093f\u0928\u0947 \u0928\u092e\u0903",isAudio:!1,audioDurationSec:40,totalTime:"00:40"},{id:"12",slug:"sri-ayyappa-ashtottara",title:"\u0936\u094d\u0930\u0940 \u0927\u0930\u094d\u092e \u0936\u093e\u0938\u094d\u0924\u093e (\u0936\u094d\u0930\u0940 \u0905\u092f\u094d\u092f\u092a\u094d\u092a\u093e)",description:"[ \u0936\u094d\u0930\u0940 \u0905\u092f\u094d\u092f\u092a\u094d\u092a \u0938\u094d\u0935\u093e\u092e\u093f \u0905\u0902\u0917\u092a\u0942\u091c ]\n    \u0913\u0902 \u0927\u0930\u094d\u092e\u0936\u093e\u0938\u094d\u0924\u094d\u0930\u0947 \u0928\u092e\u0903 - \u092a\u093e\u0926\u094c \u092a\u0942\u091c\u092f\u093e\u092e\u093f \u0964\n    \u0913\u0902 \u0936\u093f\u0932\u094d\u092a\u0936\u093e\u0938\u094d\u0924\u094d\u0930\u0947 \u0928\u092e\u0903 - \u0917\u0941\u0932\u094d\u092b\u094c \u092a\u0942\u091c\u092f\u093e\u092e\u093f \u0964\n    \u0913\u0902 \u0935\u0940\u0930\u0936\u093e\u0938\u094d\u0924\u094d\u0930\u0947 \u0928\u092e\u0903 - \u091c\u0902\u0918\u0947 \u092a\u0942\u091c\u092f\u093e\u092e\u093f\n    \u0913\u0902 \u092f\u094b\u0917\u0936\u093e\u0938\u094d\u0924\u094d\u0930\u0947 \u0928\u092e\u0903 - \u091c\u093e\u0928\u0941\u0928\u0940 \u092a\u0942\u091c\u092f\u093e\u092e\u093f\n    \u0913\u0902 \u092e\u0939\u093e\u0936\u093e\u0938\u094d\u0924\u094d\u0930\u0947 \u0928\u092e\u0903 - \u090a\u0930\u0942 \u092a\u0942\u091c\u092f\u093e\u092e\u093f\n    \u0913\u0902 \u092c\u094d\u0930\u0939\u094d\u092e\u0936\u093e\u0938\u094d\u0924\u094d\u0930\u0947 \u0928\u092e\u0903 - \u0915\u091f\u093f\u0902 \u092a\u0942\u091c\u092f\u093e\u092e\u093f\n    \u0913\u0902 \u0915\u093e\u0932\u0936\u093e\u0938\u094d\u0924\u094d\u0930\u0947 \u0928\u092e\u0903 - \u0917\u0941\u0939\u094d\u092f\u0902 \u092a\u0942\u091c\u092f\u093e\u092e\u093f\n    \u0913\u0902 \u0936\u092c\u0930\u093f\u0917\u093f\u0930\u0940\u0936\u093e\u092f \u0928\u092e\u0903 - \u092e\u0947\u0922\u094d\u0930\u0902 \u092a\u0942\u091c\u092f\u093e\u092e\u093f\n    \u0913\u0902 \u0938\u0924\u094d\u092f\u0930\u0942\u092a\u093e\u092f \u0928\u092e\u0903 - \u0928\u093e\u092d\u093f\u0902 \u092a\u0942\u091c\u092f\u093e\u092e\u093f\n    \u0913\u0902 \u092e\u0923\u093f\u0915\u0902\u0920\u093e\u092f \u0928\u092e\u0903 - \u0909\u0926\u0930\u0902 \u092a\u0942\u091c\u092f\u093e\u092e\u093f\n    \u0913\u0902 \u0935\u093f\u0937\u094d\u0923\u0941 \u0924\u0928\u092f\u093e\u092f \u0928\u092e\u0903 - \u0935\u0915\u094d\u0937\u0903\u0938\u094d\u0925\u0932\u0902 \u092a\u0942\u091c\u092f\u093e\u092e\u093f\n    \u0913\u0902 \u0936\u093f\u0935\u092a\u0941\u0924\u094d\u0930\u093e\u092f \u0928\u092e\u0903 - \u092a\u093e\u0930\u094d\u0936\u094d\u0935\u094c \u092a\u0942\u091c\u092f\u093e\u092e\u093f \u0964\n    \u0913\u0902 \u0939\u0930\u093f\u0939\u0930 \u092a\u0941\u0924\u094d\u0930\u093e\u092f \u0928\u092e\u0903 - \u0939\u0943\u0926\u092f\u0902 \u092a\u0942\u091c\u092f\u093e\u092e\u093f\n    \u0913\u0902 \u0924\u094d\u0930\u093f\u0928\u0947\u0924\u094d\u0930\u093e\u092f \u0928\u092e\u0903 - \u0915\u0902\u0920\u0902 \u092a\u0942\u091c\u092f\u093e\u092e\u093f\n    \u0913\u0902 \u0913\u0902\u0915\u093e\u0930 \u0930\u0942\u092a\u093e\u092f \u0928\u092e\u0903 - \u0938\u094d\u0924\u0928\u094c \u092a\u0942\u091c\u092f\u093e\u092e\u093f\n    \u0913\u0902 \u0935\u0930\u0926 \u0939\u0938\u094d\u0924\u093e\u092f \u0928\u092e\u0903 - \u0939\u0938\u094d\u0924\u093e\u0928\u094d \u092a\u0942\u091c\u092f\u093e\u092e\u093f\n    \u0913\u0902 \u092d\u0940\u092e\u093e\u092f \u0928\u092e\u0903 - \u092c\u093e\u0939\u0942\u0928\u094d \u092a\u0942\u091c\u092f\u093e\u092e\u093f\n    \u0913\u0902 \u0924\u0947\u091c\u0938\u094d\u0935\u093f\u0928\u0947 \u0928\u092e\u0903 - \u092e\u0941\u0916\u0902 \u092a\u0942\u091c\u092f\u093e\u092e\u093f\n    \u0913\u0902 \u0905\u0937\u094d\u091f\u092e\u0942\u0930\u094d\u0924\u092f\u0947 \u0928\u092e\u0903 - \u0926\u0902\u0924\u094c \u092a\u0942\u091c\u092f\u093e\u092e\u093f\n    \u0913\u0902 \u0936\u0941\u092d\u0935\u0940\u0915\u094d\u0937\u0923\u093e\u092f \u0928\u092e\u0903 - \u0928\u0947\u0924\u094d\u0930\u094c \u092a\u0942\u091c\u092f\u093e\u092e\u093f\n    \u0913\u0902 \u0915\u094b\u092e\u0932\u093e\u0902\u0917\u093e\u092f \u0928\u092e\u0903 - \u0915\u0930\u094d\u0923\u0902 \u092a\u0942\u091c\u092f\u093e\u092e\u093f\n    \u0913\u0902 \u092a\u093e\u092a \u0935\u093f\u0928\u093e\u0936\u093e\u092f \u0928\u092e\u0903 - \u0932\u0932\u093e\u091f\u0902 \u092a\u0942\u091c\u092f\u093e\u092e\u093f\n    \u0913\u0902 \u0936\u0924\u0943\u0928\u093e\u0936\u093e\u092f \u0928\u092e\u0903 - \u0928\u093e\u0938\u093f\u0915\u093e\u0902 \u092a\u0942\u091c\u092f\u093e\u092e\u093f\n    \u0913\u0902 \u092a\u0941\u0924\u094d\u0930\u0932\u093e\u092d\u093e\u092f \u0928\u092e\u0903 - \u091a\u0941\u092c\u0941\u0915\u0902 \u092a\u0942\u091c\u092f\u093e\u092e\u093f\n    \u0913\u0902 \u0917\u091c\u093e\u0927\u093f\u092a\u093e\u092f \u0928\u092e\u0903 - \u0915\u092a\u094b\u0932\u094c \u092a\u0942\u091c\u092f\u093e\u092e\u093f\n    \u0913\u0902 \u092a\u0930\u092e\u093e\u0924\u094d\u092e\u0928\u0947 \u0928\u092e\u0903 - \u0936\u093f\u0930\u0903 \u092a\u0942\u091c\u092f\u093e\u092e\u093f\n    \u0913\u0902 \u0938\u0930\u094d\u0935\u0947\u0936\u094d\u0935\u0930\u093e\u092f \u0928\u092e\u0903 - \u0938\u0930\u094d\u0935\u093e\u0923\u094d\u092f\u0902\u0917\u093e\u0928\u093f \u092a\u0942\u091c\u092f\u093e\u092e\u093f\n    \n    [ \u0927\u094d\u092f\u093e\u0928\u092e\u094d ]\n    \u0915\u0932\u094d\u0939\u093e\u0930\u094b\u091c\u094d\u091c\u094d\u0935\u0932 \u0928\u0940\u0932\u0915\u0941\u0902\u0924\u0932 \u092d\u0930\u0902 \u0915\u093e\u0930\u0941\u0923\u094d\u092f \u0930\u0924\u094d\u0928\u093e\u0915\u0930\u0902\n    \u0939\u0947\u092e\u093e\u0902\u092d\u094b\u0930\u0941\u0939 \u0932\u094b\u091a\u0928\u0902 \u0939\u0930\u093f\u0939\u0930 \u092a\u094d\u0930\u0947\u092e\u093e\u0938\u094d\u092a\u0926\u0902 \u092a\u094d\u0930\u093e\u0902\u0936\u0941\u0915\u092e\u094d \u0964\n    \u092a\u0926\u094d\u092e \u0915\u094d\u0930\u094b\u0921 \u0938\u0941\u0935\u0930\u094d\u0923 \u0930\u0924\u094d\u0928 \u0918\u091f\u093f\u0924\u0902 \u0915\u0947\u092f\u0942\u0930 \u0939\u093e\u0930\u093e\u0928\u094d\u0935\u093f\u0924\u0902\n    \u0932\u094b\u0915\u093e\u0930\u093e\u0927\u094d\u092f \u092e\u0927\u093e\u0930 \u0927\u0930\u094d\u092e \u0928\u093f\u0932\u092f\u0902 \u0927\u094d\u092f\u093e\u092f\u0947\u0926\u094d\u092d\u0935\u093e\u0928\u0940 \u0938\u0941\u0924\u092e\u094d \u0965\n    \n    [ \u0936\u094d\u0930\u0940 \u0905\u092f\u094d\u092f\u092a\u094d\u092a \u0905\u0937\u094d\u091f\u094b\u0924\u094d\u0924\u0930 \u0936\u0924\u0928\u093e\u092e\u093e\u0935\u0933\u093f ]\n    \u0913\u0902 \u092e\u0939\u093e\u0936\u093e\u0938\u094d\u0924\u094d\u0930\u0947 \u0928\u092e\u0903 \u0964\n    \u0913\u0902 \u0935\u093f\u0936\u094d\u0935\u0936\u093e\u0938\u094d\u0924\u094d\u0930\u0947 \u0928\u092e\u0903 \u0964\n    \u0913\u0902 \u0932\u094b\u0915\u0936\u093e\u0938\u094d\u0924\u094d\u0930\u0947 \u0928\u092e\u0903 \u0964\n    \u0913\u0902 \u0927\u0930\u094d\u092e\u0936\u093e\u0938\u094d\u0924\u094d\u0930\u0947 \u0928\u092e\u0903 \u0964\n    \u0913\u0902 \u0935\u0947\u0926\u0936\u093e\u0938\u094d\u0924\u094d\u0930\u0947 \u0928\u092e\u0903 \u0964\n    \u0913\u0902 \u0915\u093e\u0932\u0936\u093e\u0938\u094d\u0924\u094d\u0930\u0947 \u0928\u092e\u0903 \u0964\n    \u0913\u0902 \u0917\u091c\u093e\u0930\u0942\u0922\u093e\u092f \u0928\u092e\u0903 \u0964\n    \u0913\u0902 \u0917\u091c\u092a\u0924\u092f\u0947 \u0928\u092e\u0903 \u0964\n    \u0913\u0902 \u0935\u094d\u092f\u093e\u0918\u094d\u0930\u093e\u0930\u0942\u0922\u093e\u092f \u0928\u092e\u0903 \u0964\n    \u0913\u0902 \u092e\u0939\u093e\u0926\u094d\u092f\u0941\u0924\u092f\u0947 \u0928\u092e\u0903 \u0964\n    \u0913\u0902 \u0917\u094b\u092a\u0924\u094d\u0930\u0947 \u0928\u092e\u0903 \u0964\n    \u0913\u0902 \u0935\u0940\u0930\u092a\u0924\u092f\u0947 \u0928\u092e\u0903 \u0964\n    \u0913\u0902 \u0938\u092e\u093e\u0916\u094d\u092f\u093e\u092f \u0928\u092e\u0903 \u0964\n    \u0913\u0902 \u092d\u0915\u094d\u0924\u0935\u0924\u094d\u0938\u0932\u093e\u092f \u0928\u092e\u0903 \u0964\n    \u0913\u0902 \u092a\u0930\u092c\u094d\u0930\u0939\u094d\u092e\u0923\u0947 \u0928\u092e\u0903 \u0964\n    \u0913\u0902 \u091c\u093f\u0937\u094d\u0923\u0935\u0947 \u0928\u092e\u0903 \u0964\n    \u0913\u0902 \u0924\u0947\u091c\u0938\u094d\u0935\u093f\u0928\u0947 \u0928\u092e\u0903 \u0964\n    \u0913\u0902 \u092d\u0942\u0924\u093e\u0927\u093f\u092a\u0924\u092f\u0947 \u0928\u092e\u0903 \u0964\n    \u0913\u0902 \u092d\u0942\u0924\u0926\u093e\u0924\u094d\u0930\u0947 \u0928\u092e\u0903 \u0964\n    \u0913\u0902 \u092d\u0942\u0924\u0947\u0936\u093e\u092f \u0928\u092e\u0903 \u0964\n    \u0913\u0902 \u092d\u0940\u092e\u0935\u093f\u0915\u094d\u0930\u092e\u093e\u092f \u0928\u092e\u0903 \u0964\n    \u0913\u0902 \u0930\u092e\u094d\u092f\u093e\u092f \u0928\u092e\u0903 \u0964\n    \u0913\u0902 \u0924\u094d\u0930\u093f\u0932\u094b\u0915\u0947\u0936\u093e\u092f \u0928\u092e\u0903 \u0964\n    \u0913\u0902 \u0926\u0947\u0935\u0947\u0936\u093e\u092f \u0928\u092e\u0903 \u0964\n    \u0913\u0902 \u092a\u0941\u0937\u094d\u0915\u0932\u093e\u092a\u0924\u092f\u0947 \u0928\u092e\u0903 \u0964\n    \u0913\u0902 \u092a\u0930\u093e\u0915\u094d\u0930\u092e\u093e\u092f \u0928\u092e\u0903 \u0964\n    \u0913\u0902 \u0936\u0930\u093e\u092f \u0928\u092e\u0903 \u0964\n    \u0913\u0902 \u0935\u0930\u0926\u093e\u092f \u0928\u092e\u0903 \u0964\n    \u0913\u0902 \u0938\u0941\u0927\u0928\u094d\u0935\u093f\u0928\u0947 \u0928\u092e\u0903 \u0964\n    \u0913\u0902 \u0915\u093e\u092e\u0926\u093e\u092f \u0928\u092e\u0903 \u0964\n    \u0913\u0902 \u0935\u093f\u0926\u094d\u0935\u0924\u094d\u0924\u092e\u093e\u092f \u0928\u092e\u0903 \u0964\n    \u0913\u0902 \u0915\u093e\u0932\u0930\u0942\u092a\u093f\u0923\u0947 \u0928\u092e\u0903 \u0964\n    \u0913\u0902 \u0926\u0940\u0930\u094d\u0918\u093e\u092f \u0928\u092e\u0903 \u0964\n    \u0913\u0902 \u092c\u0939\u0941\u092e\u0943\u0917\u092a\u094d\u0930\u093f\u092f\u093e\u092f \u0928\u092e\u0903 \u0964\n    \u0913\u0902 \u0930\u0915\u094d\u0937\u093e\u0915\u0930\u093e\u092f \u0928\u092e\u0903 \u0964\n    \u0913\u0902 \u0926\u0941\u0903\u0916\u092d\u0902\u091c\u0928\u093e\u092f \u0928\u092e\u0903 \u0964\n    \u0913\u0902 \u0915\u092a\u093e\u0932\u093f\u0928\u0947 \u0928\u092e\u0903 \u0964\n    \u0913\u0902 \u0915\u093e\u092f\u0915\u093e\u092f \u0928\u092e\u0903 \u0964\n    \u0913\u0902 \u0915\u093e\u0902\u0924\u093e\u092f \u0928\u092e\u0903 \u0964\n    \u0913\u0902 \u0915\u092a\u0930\u094d\u0926\u093f\u0928\u0947 \u0928\u092e\u0903 \u0964\n    \u0913\u0902 \u0915\u093e\u0932\u0928\u093e\u0936\u0915\u093e\u092f \u0928\u092e\u0903 \u0964\n    \u0913\u0902 \u0915\u0941\u0930\u0902\u0921\u0915\u093e\u092f \u0928\u092e\u0903 \u0964\n    \u0913\u0902 \u0939\u0932\u093e\u092f\u0941\u0927\u093e\u092f \u0928\u092e\u0903 \u0964\n    \u0913\u0902 \u0927\u0930\u094d\u092e\u0926\u093e\u092f \u0928\u092e\u0903 \u0964\n    \u0913\u0902 \u0938\u0902\u0938\u093e\u0930\u0938\u092e\u0941\u0926\u094d\u0930\u0924\u093e\u0930\u0915\u093e\u092f \u0928\u092e\u0903 \u0964\n    \u0913\u0902 \u0935\u0940\u0930\u0935\u0932\u094d\u0932\u092d\u093e\u092f \u0928\u092e\u0903 \u0964\n    \u0913\u0902 \u0935\u093f\u0936\u094d\u0935\u092a\u093e\u0932\u0915\u093e\u092f \u0928\u092e\u0903 \u0964\n    \u0913\u0902 \u0935\u091c\u094d\u0930\u0927\u0930\u093e\u092f \u0928\u092e\u0903 \u0964\n    \u0913\u0902 \u0938\u0924\u094d\u092f\u0938\u094d\u0935\u0930\u0942\u092a\u093f\u0923\u0947 \u0928\u092e\u0903 \u0964\n    \u0913\u0902 \u0936\u0942\u0932\u093f\u0928\u0947 \u0928\u092e\u0903 \u0964\n    \u0913\u0902 \u0916\u0921\u094d\u0917\u093f\u0928\u0947 \u0928\u092e\u0903 \u0964\n    \u0913\u0902 \u0936\u093e\u0902\u0924\u093f\u0926\u093e\u092f\u0915\u093e\u092f \u0928\u092e\u0903 \u0964\n    \u0913\u0902 \u0938\u0941\u0917\u0902\u0927\u093f\u0928\u0947 \u0928\u092e\u0903 \u0964\n    \u0913\u0902 \u0917\u0902\u0927\u092e\u093e\u0932\u094d\u092f\u093e\u0902\u092c\u0930\u0927\u0930\u093e\u092f \u0928\u092e\u0903 \u0964\n    \u0913\u0902 \