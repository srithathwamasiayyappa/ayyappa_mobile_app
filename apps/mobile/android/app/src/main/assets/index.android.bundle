u0c3e\u0c2e\u0c3f\u0c2f\u0c47 \u0c28\u0c2e\u0c03\n    \u0c39\u0c30\u0c3f\u0c39\u0c30 \u0c38\u0c41\u0c24\u0c28\u0c47 \u0c36\u0c30\u0c23\u0c2e\u0c2f\u0c4d\u0c2f\u0c2a\u0c4d\u0c2a!",isAudio:!0,audioDurationSec:40,totalTime:"00:40",chantLyric:"\u0c39\u0c30\u0c3f\u0c35\u0c30\u0c3e\u0c38\u0c28\u0c02 \u0c35\u0c3f\u0c36\u0c4d\u0c35\u0c2e\u0c4b\u0c39\u0c28\u0c02 \u0c39\u0c30\u0c3f\u0c26\u0c27\u0c40\u0c36\u0c4d\u0c35\u0c30\u0c02 \u0c06\u0c30\u0c3e\u0c27\u0c4d\u0c2f\u0c2a\u0c3e\u0c26\u0c41\u0c15\u0c02"},{id:"23",slug:"shabarimala-temple-opening-dates",title:"\u0c36\u0c2c\u0c30\u0c3f\u0c2e\u0c32 \u0c26\u0c47\u0c35\u0c3e\u0c32\u0c2f\u0c02 \u0c38\u0c2e\u0c2f\u0c2e\u0c41\u0c32\u0c41",description:"[ Opening and closing of Sabarimala Sree Dharmasastha Temple for the year (2026 - 2027) ]\n    \u0c15\u0c47\u0c30\u0c33\u0c32\u0c4b\u0c28\u0c3f \u0c36\u0c2c\u0c30\u0c3f\u0c2e\u0c32 \u0c05\u0c2f\u0c4d\u0c2f\u0c2a\u0c4d\u0c2a \u0c06\u0c32\u0c2f\u0c02 \u0c38\u0c02\u0c35\u0c24\u0c4d\u0c38\u0c30\u0c02\u0c32\u0c4b \u0c15\u0c4a\u0c28\u0c4d\u0c28\u0c3f \u0c28\u0c3f\u0c30\u0c4d\u0c26\u0c3f\u0c37\u0c4d\u0c1f \u0c38\u0c2e\u0c2f\u0c3e\u0c32\u0c4d\u0c32\u0c4b \u0c2e\u0c3e\u0c24\u0c4d\u0c30\u0c2e\u0c47 \u0c26\u0c30\u0c4d\u0c36\u0c28\u0c3e\u0c30\u0c4d\u0c25\u0c02 \u0c24\u0c46\u0c30\u0c35\u0c2c\u0c21\u0c41\u0c24\u0c41\u0c02\u0c26\u0c3f. \u0c15\u0c4d\u0c30\u0c3f\u0c02\u0c26 2026 - 2027 \u0c38\u0c02\u0c35\u0c24\u0c4d\u0c38\u0c30\u0c02\u0c32\u0c4b \u0c36\u0c2c\u0c30\u0c3f\u0c2e\u0c32 \u0c05\u0c2f\u0c4d\u0c2f\u0c2a\u0c4d\u0c2a \u0c06\u0c32\u0c2f\u0c02 \u0c24\u0c46\u0c30\u0c3f\u0c1a\u0c3f \u0c09\u0c02\u0c21\u0c47 \u0c24\u0c47\u0c26\u0c40\u0c32 \u0c35\u0c3f\u0c35\u0c30\u0c3e\u0c32\u0c41 \u0c09\u0c28\u0c4d\u0c28\u0c3e\u0c2f\u0c3f.\n    \n    \u0c13\u0c02 \u0c36\u0c4d\u0c30\u0c40 \u0c38\u0c4d\u0c35\u0c3e\u0c2e\u0c3f\u0c2f\u0c47 \u0c36\u0c30\u0c23\u0c02 \u0c05\u0c2f\u0c4d\u0c2f\u0c2a\u0c4d\u0c2a\n    \n    [ \u0c17\u0c24 \u0c38\u0c02\u0c35\u0c24\u0c4d\u0c38\u0c30\u0c02 2025 \u0c2e\u0c02\u0c21\u0c32 \u0c2a\u0c42\u0c1c & \u0c24\u0c3f\u0c30\u0c41\u0c28\u0c21\u0c48 \u0c24\u0c3f\u0c30\u0c2a\u0c4d\u0c2a\u0c41 - 2026 \u0c2e\u0c15\u0c30\u0c35\u0c3f\u0c33\u0c15\u0c4d\u0c15\u0c41 \u0c2e\u0c39\u0c4b\u0c24\u0c4d\u0c38\u0c35\u0c02 ]\n    \u2022 \u0c21\u0c3f\u0c38\u0c46\u0c02\u0c2c\u0c30\u0c4d 2025 : \u0c2e\u0c02\u0c21\u0c32 \u0c2a\u0c42\u0c1c (\u0c24\u0c46\u0c30\u0c3f\u0c1a\u0c47 \u0c24\u0c47\u0c26\u0c40: 16/11/2025 \u2013 \u0c2e\u0c41\u0c17\u0c3f\u0c02\u0c2a\u0c41: 27/12/2025)\n    \u2022 \u0c21\u0c3f\u0c38\u0c46\u0c02\u0c2c\u0c30\u0c4d 2025 : \u0c24\u0c3f\u0c30\u0c41\u0c28\u0c21\u0c48 \u0c24\u0c3f\u0c30\u0c2a\u0c4d\u0c2a\u0c41 - \u0c2e\u0c15\u0c30\u0c35\u0c3f\u0c33\u0c15\u0c4d\u0c15\u0c41 \u0c2e\u0c39\u0c4b\u0c24\u0c4d\u0c38\u0c35\u0c02 (\u0c24\u0c46\u0c30\u0c3f\u0c1a\u0c47 \u0c24\u0c47\u0c26\u0c40: 30/12/2025 \u2013 \u0c2e\u0c41\u0c17\u0c3f\u0c02\u0c2a\u0c41: 20/01/2026)\n    \n    \u0c13\u0c02 \u0c36\u0c4d\u0c30\u0c40 \u0c38\u0c4d\u0c35\u0c3e\u0c2e\u0c3f\u0c2f\u0c47 \u0c36\u0c30\u0c23\u0c02 \u0c05\u0c2f\u0c4d\u0c2f\u0c2a\u0c4d\u0c2a\n    \n    [ 2026-2027 \u0c06\u0c32\u0c2f\u0c02 \u0c24\u0c46\u0c30\u0c3f\u0c1a\u0c47 \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c2e\u0c41\u0c17\u0c3f\u0c38\u0c47 \u0c24\u0c47\u0c26\u0c40\u0c32 \u0c2a\u0c1f\u0c4d\u0c1f\u0c3f\u0c15 ]\n    \u2022 \u0c1c\u0c28\u0c35\u0c30\u0c3f 2026 : \u0c2e\u0c15\u0c30\u0c35\u0c3f\u0c33\u0c15\u0c4d\u0c15\u0c41 \u0c26\u0c3f\u0c28\u0c02 (14/01/2026 \u2013 20/01/2026)\n    \u2022 \u0c2b\u0c3f\u0c2c\u0c4d\u0c30\u0c35\u0c30\u0c3f 2026 : \u0c2e\u0c3e\u0c38 \u0c2a\u0c42\u0c1c - \u0c15\u0c41\u0c02\u0c2d\u0c02 (12/02/2026 \u0c38\u0c3e\u0c2f\u0c02\u0c24\u0c4d\u0c30\u0c02 5\u0c17\u0c02 \u2013 17/02/2026 \u0c30\u0c3e\u0c24\u0c4d\u0c30\u0c3f 10\u0c17\u0c02)\n    \u2022 \u0c2e\u0c3e\u0c30\u0c4d\u0c1a\u0c3f 2026 : \u0c2e\u0c3e\u0c38 \u0c2a\u0c42\u0c1c - \u0c2e\u0c40\u0c28\u0c02 (14/03/2026 \u0c38\u0c3e\u0c2f\u0c02\u0c24\u0c4d\u0c30\u0c02 5\u0c17\u0c02 \u2013 19/03/2026 \u0c30\u0c3e\u0c24\u0c4d\u0c30\u0c3f 10\u0c17\u0c02)\n    \u2022 \u0c2e\u0c3e\u0c30\u0c4d\u0c1a\u0c3f 2026 : \u0c36\u0c2c\u0c30\u0c3f\u0c2e\u0c32 \u0c09\u0c24\u0c4d\u0c38\u0c35\u0c02 (22/03/2026 \u0c38\u0c3e\u0c2f\u0c02\u0c24\u0c4d\u0c30\u0c02 5\u0c17\u0c02 \u2013 01/04/2026 \u0c30\u0c3e\u0c24\u0c4d\u0c30\u0c3f 10\u0c17\u0c02)\n    \u2022 \u0c2e\u0c3e\u0c30\u0c4d\u0c1a\u0c3f 2026 : \u0c15\u0c4a\u0c21\u0c3f\u0c2f\u0c47\u0c1f\u0c4d\u0c1f\u0c41 (\u0c27\u0c4d\u0c35\u0c1c\u0c3e\u0c30\u0c4b\u0c39\u0c23\u0c02) (23/03/2026)\n    \u2022 \u0c0f\u0c2a\u0c4d\u0c30\u0c3f\u0c32\u0c4d 2026 : \u0c2a\u0c02\u0c17\u0c41\u0c28\u0c3f \u0c09\u0c24\u0c4d\u0c30\u0c02 & \u0c06\u0c30\u0c3e\u0c1f\u0c4d\u0c1f\u0c41 (01/04/2026 \u2013 01/04/2026 \u0c30\u0c3e\u0c24\u0c4d\u0c30\u0c3f 10\u0c17\u0c02)\n    \u2022 \u0c0f\u0c2a\u0c4d\u0c30\u0c3f\u0c32\u0c4d 2026 : \u0c2e\u0c47\u0c21 \u0c35\u0c3f\u0c37\u0c41 \u0c2a\u0c02\u0c21\u0c41\u0c17 (11/04/2026 \u0c38\u0c3e\u0c2f\u0c02\u0c24\u0c4d\u0c30\u0c02 5\u0c17\u0c02 \u2013 18/04/2026 \u0c30\u0c3e\u0c24\u0c4d\u0c30\u0c3f 10\u0c17\u0c02)\n    \u2022 \u0c0f\u0c2a\u0c4d\u0c30\u0c3f\u0c32\u0c4d 2026 : \u0c35\u0c3f\u0c37\u0c41 \u0c26\u0c3f\u0c28\u0c02 (15/04/2026)\n    \u2022 \u0c2e\u0c47 2026 : \u0c2e\u0c3e\u0c38 \u0c2a\u0c42\u0c1c - \u0c0e\u0c21\u0c35\u0c2e\u0c4d (14/05/2026 \u0c38\u0c3e\u0c2f\u0c02\u0c24\u0c4d\u0c30\u0c02 5\u0c17\u0c02 \u2013 19/05/2026 \u0c30\u0c3e\u0c24\u0c4d\u0c30\u0c3f 10\u0c17\u0c02)\n    \u2022 \u0c2e\u0c47 2026 : \u0c2a\u0c4d\u0c30\u0c24\u0c3f\u0c37\u0c4d\u0c20\u0c3e \u0c26\u0c3f\u0c28 \u0c2a\u0c42\u0c1c (25/05/2026 \u2013 26/05/2026)\n    \u2022 \u0c1c\u0c42\u0c28\u0c4d 2026 : \u0c2e\u0c3e\u0c38 \u0c2a\u0c42\u0c1c - \u0c2e\u0c3f\u0c25\u0c41\u0c28\u0c02 (14/06/2026 \u0c38\u0c3e\u0c2f\u0c02\u0c24\u0c4d\u0c30\u0c02 5\u0c17\u0c02 \u2013 19/06/2026 \u0c30\u0c3e\u0c24\u0c4d\u0c30\u0c3f 10\u0c17\u0c02)\n    \u2022 \u0c1c\u0c42\u0c32\u0c48 2026 : \u0c2e\u0c3e\u0c38 \u0c2a\u0c42\u0c1c - \u0c15\u0c30\u0c4d\u0c15\u0c1f\u0c15\u0c02 (16/07/2026 \u0c38\u0c3e\u0c2f\u0c02\u0c24\u0c4d\u0c30\u0c02 5\u0c17\u0c02 \u2013 21/07/2026 \u0c30\u0c3e\u0c24\u0c4d\u0c30\u0c3f 10\u0c17\u0c02)\n    \u2022 \u0c06\u0c17\u0c38\u0c4d\u0c1f\u0c41 2026 : \u0c2e\u0c3e\u0c38 \u0c2a\u0c42\u0c1c - \u0c1a\u0c3f\u0c02\u0c17\u0c02 (16/08/2026 \u0c38\u0c3e\u0c2f\u0c02\u0c24\u0c4d\u0c30\u0c02 5\u0c17\u0c02 \u2013 21/08/2026 \u0c30\u0c3e\u0c24\u0c4d\u0c30\u0c3f 10\u0c17\u0c02)\n    \u2022 \u0c06\u0c17\u0c38\u0c4d\u0c1f\u0c41 2026 : \u0c13\u0c23\u0c02 \u0c2a\u0c42\u0c1c (24/08/2026 \u2013 28/08/2026)\n    \u2022 \u0c06\u0c17\u0c38\u0c4d\u0c1f\u0c41 2026 : \u0c13\u0c23\u0c02 \u0c26\u0c3f\u0c28\u0c02 (26/08/2026)\n    \u2022 \u0c38\u0c46\u0c2a\u0c4d\u0c1f\u0c46\u0c02\u0c2c\u0c30\u0c4d 2026 : \u0c2e\u0c3e\u0c38 \u0c2a\u0c42\u0c1c - \u0c15\u0c28\u0c4d\u0c28\u0c3f (16/09/2026 \u0c38\u0c3e\u0c2f\u0c02\u0c24\u0c4d\u0c30\u0c02 5\u0c17\u0c02 \u2013 21/09/2026 \u0c30\u0c3e\u0c24\u0c4d\u0c30\u0c3f 10\u0c17\u0c02)\n    \u2022 \u0c05\u0c15\u0c4d\u0c1f\u0c4b\u0c2c\u0c30\u0c4d 2026 : \u0c2e\u0c3e\u0c38 \u0c2a\u0c42\u0c1c - \u0c24\u0c41\u0c32\u0c02 (17/10/2026 \u0c38\u0c3e\u0c2f\u0c02\u0c24\u0c4d\u0c30\u0c02 5\u0c17\u0c02 \u2013 22/10/2026 \u0c30\u0c3e\u0c24\u0c4d\u0c30\u0c3f 10\u0c17\u0c02)\n    \u2022 \u0c28\u0c35\u0c02\u0c2c\u0c30\u0c4d 2026 : \u0c36\u0c4d\u0c30\u0c40 \u0c1a\u0c3f\u0c24\u0c4d\u0c30 \u0c05\u0c1f\u0c4d\u0c1f \u0c24\u0c3f\u0c30\u0c41\u0c28\u0c3e\u0c33\u0c4d (06/11/2026 \u0c38\u0c3e\u0c2f\u0c02\u0c24\u0c4d\u0c30\u0c02 5\u0c17\u0c02 \u2013 07/11/2026 \u0c30\u0c3e\u0c24\u0c4d\u0c30\u0c3f 10\u0c17\u0c02)\n    \u2022 \u0c28\u0c35\u0c02\u0c2c\u0c30\u0c4d 2026 : \u0c2e\u0c02\u0c21\u0c32 \u0c2a\u0c42\u0c1c \u0c2e\u0c39\u0c4b\u0c24\u0c4d\u0c38\u0c35\u0c02 (16/11/2026 \u0c38\u0c3e\u0c2f\u0c02\u0c24\u0c4d\u0c30\u0c02 5\u0c17\u0c02 \u2013 27/12/2026)\n    \u2022 \u0c21\u0c3f\u0c38\u0c46\u0c02\u0c2c\u0c30\u0c4d 2026 : \u0c2e\u0c02\u0c21\u0c32 \u0c2a\u0c42\u0c1c (27/12/2026)\n    \u2022 \u0c21\u0c3f\u0c38\u0c46\u0c02\u0c2c\u0c30\u0c4d 2026 : \u0c24\u0c3f\u0c30\u0c41\u0c28\u0c21\u0c48 \u0c24\u0c3f\u0c30\u0c2a\u0c4d\u0c2a\u0c41 - \u0c2e\u0c15\u0c30\u0c35\u0c3f\u0c33\u0c15\u0c4d\u0c15\u0c41 \u0c2e\u0c39\u0c4b\u0c24\u0c4d\u0c38\u0c35\u0c02 (30/12/2026 \u2013 20/01/2027)\n    \u2022 \u0c1c\u0c28\u0c35\u0c30\u0c3f 2027 : \u0c2e\u0c15\u0c30\u0c35\u0c3f\u0c33\u0c15\u0c4d\u0c15\u0c41 \u0c26\u0c3f\u0c28\u0c02 (14/01/2027)\n    \n    [ \u0c2e\u0c41\u0c16\u0c4d\u0c2f \u0c17\u0c2e\u0c28\u0c3f\u0c15 ]\n    \u0c36\u0c2c\u0c30\u0c3f\u0c2e\u0c32 \u0c06\u0c32\u0c2f\u0c02 \u0c38\u0c3e\u0c27\u0c3e\u0c30\u0c23\u0c02\u0c17\u0c3e \u0c09\u0c26\u0c2f\u0c02 05.00 \u0c17\u0c02\u0c1f\u0c32\u0c15\u0c41 \u0c24\u0c46\u0c30\u0c41\u0c35\u0c2c\u0c21\u0c41\u0c24\u0c41\u0c02\u0c26\u0c3f \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c30\u0c3e\u0c24\u0c4d\u0c30\u0c3f 10.00 \u0c17\u0c02\u0c1f\u0c32\u0c15\u0c41 \u0c2e\u0c42\u0c38\u0c3f\u0c35\u0c47\u0c2f\u0c2c\u0c21\u0c41\u0c24\u0c41\u0c02\u0c26\u0c3f. \u0c2e\u0c15\u0c30\u0c35\u0c3f\u0c33\u0c15\u0c4d\u0c15\u0c41 \u0c2e\u0c39\u0c4b\u0c24\u0c4d\u0c38\u0c35\u0c02 \u0c35\u0c02\u0c1f\u0c3f \u0c30\u0c26\u0c4d\u0c26\u0c40 \u0c38\u0c2e\u0c2f\u0c3e\u0c32\u0c4d\u0c32\u0c4b \u0c2d\u0c15\u0c4d\u0c24\u0c41\u0c32 \u0c38\u0c02\u0c16\u0c4d\u0c2f\u0c28\u0c41 \u0c26\u0c43\u0c37\u0c4d\u0c1f\u0c3f\u0c32\u0c4b \u0c09\u0c02\u0c1a\u0c41\u0c15\u0c41\u0c28\u0c3f \u0c06\u0c32\u0c2f \u0c38\u0c2e\u0c2f\u0c3e\u0c32\u0c32\u0c4b \u0c2e\u0c3e\u0c30\u0c4d\u0c2a\u0c41\u0c32\u0c41 \u0c09\u0c02\u0c21\u0c35\u0c1a\u0c4d\u0c1a\u0c41.",isAudio:!1,audioDurationSec:40,totalTime:"00:40"}],kn:[{id:"1",slug:"2026-uthara-nakshatra-dates",title:"2026 \u0c89\u0ca4\u0ccd\u0ca4\u0cb0\u0cbe \u0ca8\u0c95\u0ccd\u0cb7\u0ca4\u0ccd\u0cb0 \u0ca6\u0cbf\u0ca8\u0cbe\u0c82\u0c95\u0c97\u0cb3\u0cc1",description:"[ 2026 \u0c89\u0ca4\u0ccd\u0ca4\u0cb0\u0cbe \u0ca8\u0c95\u0ccd\u0cb7\u0ca4\u0ccd\u0cb0 \u0ca6\u0cbf\u0ca8\u0cbe\u0c82\u0c95\u0c97\u0cb3\u0cc1 ]\n\n\u0cb8\u0ccd\u0cb5\u0cbe\u0cae\u0cbf\u0caf\u0cc7 \u0cb6\u0cb0\u0ca3\u0c82 \u0c85\u0caf\u0ccd\u0caf\u0caa\u0ccd\u0caa, \u0c85\u0caf\u0ccd\u0caf\u0caa\u0ccd\u0caa \u0c9c\u0ca8\u0ccd\u0cae \u0ca8\u0c95\u0ccd\u0cb7\u0ca4\u0ccd\u0cb0 \u0c89\u0ca4\u0ccd\u0ca4\u0cb0\u0cbe \u0ca8\u0c95\u0ccd\u0cb7\u0ca4\u0ccd\u0cb0. \u0cb5\u0cbf\u0cb6\u0cc7\u0cb7\u0cb5\u0cbe\u0c97\u0cbf \u0cae\u0cc0\u0ca8 \u0cae\u0cbe\u0cb8\u0ca6\u0cb2\u0ccd\u0cb2\u0cbf \u0cac\u0cb0\u0cc1\u0cb5 \u0c89\u0ca4\u0ccd\u0ca4\u0cb0\u0cbe \u0ca8\u0c95\u0ccd\u0cb7\u0ca4\u0ccd\u0cb0\u0ca6\u0c82\u0ca6\u0cc1 \u0c85\u0caf\u0ccd\u0caf\u0caa\u0ccd\u0caa \u0cb8\u0ccd\u0cb5\u0cbe\u0cae\u0cbf \u0c9c\u0ca8\u0cbf\u0cb8\u0cbf\u0ca6\u0cb0\u0cc1, \u0c86\u0ca6\u0cb0\u0cc6 \u0caa\u0ccd\u0cb0\u0ca4\u0cbf 27 \u0ca6\u0cbf\u0ca8\u0c97\u0cb3\u0cbf\u0c97\u0cca\u0cae\u0ccd\u0cae\u0cc6 \u0c89\u0ca4\u0ccd\u0ca4\u0cb0\u0cbe \u0ca8\u0c95\u0ccd\u0cb7\u0ca4\u0ccd\u0cb0 \u0cac\u0cb0\u0cc1\u0ca4\u0ccd\u0ca4\u0ca6\u0cc6,\n\n\u0c89\u0ca4\u0ccd\u0ca4\u0cb0\u0cbe \u0ca8\u0c95\u0ccd\u0cb7\u0ca4\u0ccd\u0cb0\u0ca6\u0c82\u0ca6\u0cc1 \u0c85\u0caf\u0ccd\u0caf\u0caa\u0ccd\u0caa \u0caa\u0cc2\u0c9c\u0cc6 \u0cae\u0cbe\u0ca1\u0cb2\u0cc1 \u0c87\u0c9a\u0ccd\u0c9b\u0cbf\u0cb8\u0cc1\u0cb5\u0cb5\u0cb0\u0cbf\u0c97\u0cbe\u0c97\u0cbf \u0caa\u0ccd\u0cb0\u0ca4\u0cbf \u0ca4\u0cbf\u0c82\u0c97\u0cb3\u0cc1 \u0caf\u0cbe\u0cb5 \u0ca6\u0cbf\u0ca8\u0cbe\u0c82\u0c95\u0ca6\u0c82\u0ca6\u0cc1 \u0c89\u0ca4\u0ccd\u0ca4\u0cb0\u0cbe \u0ca8\u0c95\u0ccd\u0cb7\u0ca4\u0ccd\u0cb0 \u0cac\u0cb0\u0cc1\u0ca4\u0ccd\u0ca4\u0ca6\u0cc6 \u0c8e\u0c82\u0cac\u0cc1\u0ca6\u0ca8\u0ccd\u0ca8\u0cc1 \u0ca4\u0cbf\u0cb3\u0cbf\u0caf\u0cb2\u0cc1 \u0c87\u0cb2\u0ccd\u0cb2\u0cbf \u0ca8\u0cc0\u0ca1\u0cb2\u0cbe\u0c97\u0cbf\u0ca6\u0cc6,\n\n\u0c95\u0cc6\u0cb2\u0cb5\u0cca\u0cae\u0ccd\u0cae\u0cc6 \u0ca4\u0cbf\u0c82\u0c97\u0cb3\u0cb2\u0ccd\u0cb2\u0cbf \u0c8e\u0cb0\u0ca1\u0cc1 \u0cac\u0cbe\u0cb0\u0cbf \u0c89\u0ca4\u0ccd\u0ca4\u0cb0\u0cbe \u0ca8\u0c95\u0ccd\u0cb7\u0ca4\u0ccd\u0cb0 \u0cac\u0cb0\u0cc1\u0ca4\u0ccd\u0ca4\u0ca6\u0cc6. \u0c85\u0c82\u0ca6\u0cb0\u0cc6 \u0ca4\u0cbf\u0c82\u0c97\u0cb3 \u0c86\u0cb0\u0c82\u0cad\u0ca6\u0cb2\u0ccd\u0cb2\u0cbf \u0cac\u0c82\u0ca6\u0cb0\u0cc6 \u0ca4\u0cbf\u0c82\u0c97\u0cb3 \u0c95\u0cca\u0ca8\u0cc6\u0caf\u0cb2\u0ccd\u0cb2\u0cc2 \u0cac\u0cb0\u0cc1\u0ca4\u0ccd\u0ca4\u0ca6\u0cc6. \u0c88 \u0cb5\u0cb0\u0ccd\u0cb7 \u0c8f\u0caa\u0ccd\u0cb0\u0cbf\u0cb2\u0ccd \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0ca1\u0cbf\u0cb8\u0cc6\u0c82\u0cac\u0cb0\u0ccd \u0ca4\u0cbf\u0c82\u0c97\u0cb3\u0cb2\u0ccd\u0cb2\u0cbf \u0c8e\u0cb0\u0ca1\u0cc1 \u0cac\u0cbe\u0cb0\u0cbf \u0c89\u0ca4\u0ccd\u0ca4\u0cb0\u0cbe \u0ca8\u0c95\u0ccd\u0cb7\u0ca4\u0ccd\u0cb0 \u0cac\u0c82\u0ca6\u0cbf\u0ca6\u0cc6.\n\n\u0cb8\u0ccd\u0cb5\u0cbe\u0cae\u0cbf\u0caf\u0cc7 \u0cb6\u0cb0\u0ca3\u0c82 \u0c85\u0caf\u0ccd\u0caf\u0caa\u0ccd\u0caa 2026 \u0cb5\u0cb0\u0ccd\u0cb7 \u0c8f\u0caa\u0ccd\u0cb0\u0cbf\u0cb2\u0ccd 1 \u0caa\u0c82\u0caa\u0cbe \u0c86\u0cb0\u0cbe\u0c9f\u0ccd\u0c9f\u0cc1 \u0c85\u0caf\u0ccd\u0caf\u0caa\u0ccd\u0caa \u0c9c\u0ca8\u0ccd\u0cae \u0ca6\u0cbf\u0ca8\n\n| \u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cc6 No | \u0ca6\u0cbf\u0ca8\u0cbe\u0c82\u0c95 Date | \u0cb5\u0cbe\u0cb0 Day | \u0ca8\u0c95\u0ccd\u0cb7\u0ca4\u0ccd\u0cb0 Nakshatram |\n| 1 | 8-1-2026 | \u0c97\u0cc1\u0cb0\u0cc1\u0cb5\u0cbe\u0cb0 | \u0c89\u0ca4\u0ccd\u0ca4\u0cb0\u0cbe |\n| 2 | 5-2-2026 | \u0c97\u0cc1\u0cb0\u0cc1\u0cb5\u0cbe\u0cb0 | \u0c89\u0ca4\u0ccd\u0ca4\u0cb0\u0cbe |\n| 3 | 5-3-2026 | \u0c97\u0cc1\u0cb0\u0cc1\u0cb5\u0cbe\u0cb0 | \u0c89\u0ca4\u0ccd\u0ca4\u0cb0\u0cbe |\n| 4 | 1-4-2026 | \u0cac\u0cc1\u0ca7\u0cb5\u0cbe\u0cb0 | \u0c89\u0ca4\u0ccd\u0ca4\u0cb0\u0cbe |\n| 5 | 28-4-2026 | \u0cae\u0c82\u0c97\u0cb3\u0cb5\u0cbe\u0cb0 | \u0c89\u0ca4\u0ccd\u0ca4\u0cb0\u0cbe |\n| 6 | 25-5-2026 | \u0cb8\u0ccb\u0cae\u0cb5\u0cbe\u0cb0 | \u0c89\u0ca4\u0ccd\u0ca4\u0cb0\u0cbe |\n| 7 | 22-6-2026 | \u0cb8\u0ccb\u0cae\u0cb5\u0cbe\u0cb0 | \u0c89\u0ca4\u0ccd\u0ca4\u0cb0\u0cbe |\n| 8 | 19-7-2026 | \u0cad\u0cbe\u0ca8\u0cc1\u0cb5\u0cbe\u0cb0 | \u0c89\u0ca4\u0ccd\u0ca4\u0cb0\u0cbe |\n| 9 | 15-8-2026 | \u0cb6\u0ca8\u0cbf\u0cb5\u0cbe\u0cb0 | \u0c89\u0ca4\u0ccd\u0ca4\u0cb0\u0cbe |\n| 10 | 12-9-2026 | \u0cb6\u0ca8\u0cbf\u0cb5\u0cbe\u0cb0 | \u0c89\u0ca4\u0ccd\u0ca4\u0cb0\u0cbe |\n| 11 | 09-10-2026 | \u0cb6\u0cc1\u0c95\u0ccd\u0cb0\u0cb5\u0cbe\u0cb0 | \u0c89\u0ca4\u0ccd\u0ca4\u0cb0\u0cbe |\n| 12 | 05-11-2026 | \u0c97\u0cc1\u0cb0\u0cc1\u0cb5\u0cbe\u0cb0 | \u0c89\u0ca4\u0ccd\u0ca4\u0cb0\u0cbe |\n| 13 | 03-12-2026 | \u0c97\u0cc1\u0cb0\u0cc1\u0cb5\u0cbe\u0cb0 | \u0c89\u0ca4\u0ccd\u0ca4\u0cb0\u0cbe |\n| 14 | 30-12-2026 | \u0cac\u0cc1\u0ca7\u0cb5\u0cbe\u0cb0 | \u0c89\u0ca4\u0ccd\u0ca4\u0cb0\u0cbe |",isAudio:!1,audioDurationSec:40,totalTime:"00:40"},{id:"2",slug:"suprabatham",title:"\u0c85\u0caf\u0ccd\u0caf\u0caa\u0ccd\u0caa \u0cb8\u0cc1\u0caa\u0ccd\u0cb0\u0cad\u0cbe\u0ca4",description:"\u0c95\u0ccc\u0cb8\u0cb2\u0ccd\u0caf\u0cbe \u0cb8\u0cc1\u0caa\u0ccd\u0cb0\u0c9c\u0cbe \u0cb0\u0cbe\u0cae \u0caa\u0cc2\u0cb0\u0ccd\u0cb5\u0cbe \u0cb8\u0c82\u0ca7\u0ccd\u0caf\u0cbe \u0caa\u0ccd\u0cb0\u0cb5\u0cb0\u0ccd\u0ca4\u0ca4\u0cc7...",isAudio:!0,audioDurationSec:40,totalTime:"00:40",chantLyric:"\u0cb9\u0cb0\u0cbf\u0cb5\u0cb0\u0cbe\u0cb8\u0ca8\u0c82 \u0cb5\u0cbf\u0cb6\u0ccd\u0cb5\u0cae\u0ccb\u0cb9\u0ca8\u0c82 \u0cb9\u0cb0\u0cbf\u0ca6\u0ca7\u0cc0\u0cb6\u0ccd\u0cb5\u0cb0\u0c82 \u0c86\u0cb0\u0cbe\u0ca7\u0ccd\u0caf\u0caa\u0cbe\u0ca6\u0cc1\u0c95\u0c82"},{id:"3",slug:"nithya-paarayana-shlokamulu",title:"\u0ca8\u0cbf\u0ca4\u0ccd\u0caf\u0caa\u0cbe\u0cb0\u0cbe\u0caf\u0ca3 \u0cb6\u0ccd\u0cb2\u0ccb\u0c95\u0c97\u0cb3\u0cc1",description:"[ \u0ca8\u0cbf\u0ca4\u0ccd\u0caf\u0caa\u0cbe\u0cb0\u0cbe\u0caf\u0ca3 \u0cb6\u0ccd\u0cb2\u0ccb\u0c95\u0c97\u0cb3\u0cc1 ]\n    \n    (\u0caa\u0ccd\u0cb0\u0cbe\u0ca4\u0c83 \u0c95\u0cbe\u0cb2 \u0cb8\u0ccd\u0cae\u0cb0\u0ca3 \u0cb6\u0ccd\u0cb2\u0ccb\u0c95\u0c97\u0cb3\u0cc1)\n    \n    \u0cb6\u0cc1\u0c95\u0ccd\u0cb2\u0cbe\u0c82\u0cac\u0cb0\u0ca7\u0cb0\u0c82 \u0cb5\u0cbf\u0cb7\u0ccd\u0ca3\u0cc1\u0c82 \u0cb6\u0cb6\u0cbf\u0cb5\u0cb0\u0ccd\u0ca3\u0c82 \u0c9a\u0ca4\u0cc1\u0cb0\u0ccd\u0cad\u0cc1\u0c9c\u0cae\u0ccd\n    \u0caa\u0ccd\u0cb0\u0cb8\u0ca8\u0ccd\u0ca8\u0cb5\u0ca6\u0ca8\u0c82 \u0ca7\u0ccd\u0caf\u0cbe\u0caf\u0cc7\u0ca4\u0ccd \u0cb8\u0cb0\u0ccd\u0cb5\u0cb5\u0cbf\u0c98\u0ccd\u0ca8\u0ccb\u0caa\u0cb6\u0cbe\u0c82\u0ca4\u0caf\u0cc7\n    \n    \u0c97\u0cc1\u0cb0\u0cc1\u0cb0\u0ccd\u0cac\u0ccd\u0cb0\u0cb9\u0ccd\u0cae\u0cbe \u0c97\u0cc1\u0cb0\u0cc1\u0cb0\u0ccd\u0cb5\u0cbf\u0cb7\u0ccd\u0ca3\u0cc1\u0c83 \u0c97\u0cc1\u0cb0\u0cc1\u0cb0\u0ccd\u0ca6\u0cc7\u0cb5\u0ccb \u0cae\u0cb9\u0cc7\u0cb6\u0ccd\u0cb5\u0cb0\u0c83\n    \u0c97\u0cc1\u0cb0\u0cc1\u0cb8\u0ccd\u0cb8\u0cbe\u0c95\u0ccd\u0cb7\u0cbe\u0ca4\u0ccd \u0caa\u0cb0\u0cac\u0ccd\u0cb0\u0cb9\u0ccd\u0cae \u0ca4\u0cb8\u0ccd\u0cae\u0cc8 \u0cb6\u0ccd\u0cb0\u0cc0 \u0c97\u0cc1\u0cb0\u0cb5\u0cc7 \u0ca8\u0cae\u0c83\n    \n    \u0c95\u0cb0\u0cbe\u0c97\u0ccd\u0cb0\u0cc7 \u0cb5\u0cb8\u0ca4\u0cc7 \u0cb2\u0c95\u0ccd\u0cb7\u0ccd\u0cae\u0cc0\u0c83 \u0c95\u0cb0\u0cae\u0ca7\u0ccd\u0caf\u0cc7 \u0cb8\u0cb0\u0cb8\u0ccd\u0cb5\u0ca4\u0cc0\n    \u0c95\u0cb0\u0cae\u0cc2\u0cb2\u0cc7 \u0cb8\u0ccd\u0ca5\u0cbf\u0ca4\u0cbe\u0c97\u0ccc\u0cb0\u0cc0 \u0caa\u0ccd\u0cb0\u0cad\u0cbe\u0ca4\u0cc7 \u0c95\u0cb0\u0ca6\u0cb0\u0ccd\u0cb6\u0ca8\u0cae\u0ccd\n    \n    \u0cb8\u0cae\u0cc1\u0ca6\u0ccd\u0cb0\u0cb5\u0cb8\u0ca8\u0cc7 \u0ca6\u0cc7\u0cb5\u0cc0 \u0caa\u0cb0\u0ccd\u0cb5\u0ca4\u0cb8\u0ccd\u0ca4\u0ca8\u0cae\u0c82\u0ca1\u0cb2\u0cc7\n    \u0cb5\u0cbf\u0cb7\u0ccd\u0ca3\u0cc1\u0caa\u0ca4\u0ccd\u0ca8\u0cbf \u0ca8\u0cae\u0cb8\u0ccd\u0ca4\u0cc1\u0cad\u0ccd\u0caf\u0c82 \u0caa\u0cbe\u0ca6\u0cb8\u0ccd\u0caa\u0cb0\u0ccd\u0cb6\u0c82 \u0c95\u0ccd\u0cb7\u0cae\u0cb8\u0ccd\u0cb5\u0cae\u0cc7\n    \n    \u0cac\u0ccd\u0cb0\u0cb9\u0ccd\u0cae\u0cbe \u0cae\u0cc1\u0cb0\u0cbe\u0cb0\u0cbf \u0cb8\u0ccd\u0ca4\u0ccd\u0cb0\u0cbf\u0caa\u0cc1\u0cb0\u0cbe\u0c82\u0ca4\u0c95\u0cbe\u0cb0\u0cc0\n    \u0cad\u0cbe\u0ca8\u0cc1\u0c83 \u0cb6\u0cb6\u0cc0 \u0cad\u0cc2\u0cae\u0cbf\u0cb8\u0cc1\u0ca4\u0ccb \u0cac\u0cc1\u0ca7\u0cb6\u0ccd\u0c9a\n    \u0c97\u0cc1\u0cb0\u0cc1\u0cb6\u0ccd\u0c9a \u0cb6\u0cc1\u0c95\u0ccd\u0cb0\u0c83 \u0cb6\u0ca8\u0cbf \u0cb0\u0cbe\u0cb9\u0cc1 \u0c95\u0cc7\u0ca4\u0cb5\u0c83\n    \u0c95\u0cc1\u0cb0\u0ccd\u0cb5\u0c82\u0ca4\u0cc1 \u0cb8\u0cb0\u0ccd\u0cb5\u0cc7 \u0cae\u0cae \u0cb8\u0cc1\u0caa\u0ccd\u0cb0\u0cad\u0cbe\u0ca4\u0cae\u0ccd\n    \n    [ \u0cb6\u0ccd\u0cb0\u0cc0 \u0c85\u0caf\u0ccd\u0caf\u0caa\u0ccd\u0caa \u0c97\u0cbe\u0caf\u0ca4\u0ccd\u0cb0\u0cc0 \u0cae\u0c82\u0ca4\u0ccd\u0cb0 ]\n    \u0c93\u0c82 \u0cad\u0cc2\u0ca4\u0ca8\u0cbe\u0ca5\u0cbe\u0caf \u0cb5\u0cbf\u0ca6\u0ccd\u0cae\u0cb9\u0cc7 \u0cad\u0cb5\u0caa\u0cc1\u0ca4\u0ccd\u0cb0\u0cbe\u0caf \u0ca7\u0cc0\u0cae\u0cb9\u0cbf\n    \u0ca4\u0ca8\u0ccd\u0ca8\u0ccb \u0cb6\u0cbe\u0cb8\u0ccd\u0ca4\u0cbe \u0caa\u0ccd\u0cb0\u0c9a\u0ccb\u0ca6\u0caf\u0cbe\u0ca4\u0ccd\n    \n    \u0c93\u0c82 \u0cb6\u0ccd\u0cb0\u0cc0 \u0cb8\u0ccd\u0cb5\u0cbe\u0cae\u0cbf\u0caf\u0cc7 \u0cb6\u0cb0\u0ca3\u0c82 \u0c85\u0caf\u0ccd\u0caf\u0caa\u0ccd\u0caa!",isAudio:!1,audioDurationSec:40,totalTime:"00:40"},{id:"4",slug:"poojalu-vrathaalu",title:"\u0caa\u0cc2\u0c9c\u0cc6\u0c97\u0cb3\u0cc1 \u0cb5\u0ccd\u0cb0\u0ca4\u0c97\u0cb3\u0cc1",description:"[ \u0cb6\u0ccd\u0cb0\u0cc0 \u0c85\u0caf\u0ccd\u0caf\u0caa\u0ccd\u0caa \u0caa\u0cc2\u0c9c\u0cc6\u0c97\u0cb3\u0cc1 - \u0cb5\u0ccd\u0cb0\u0ca4 \u0ca8\u0cbf\u0caf\u0cae\u0c97\u0cb3\u0cc1 ]\n    \n    \u0cb6\u0ccd\u0cb0\u0cc0 \u0c85\u0caf\u0ccd\u0caf\u0caa\u0ccd\u0caa \u0cb8\u0ccd\u0cb5\u0cbe\u0cae\u0cbf \u0cae\u0c82\u0ca1\u0cb2 \u0ca6\u0cc0\u0c95\u0ccd\u0cb7\u0cbe \u0cb5\u0ccd\u0cb0\u0ca4\u0cb5\u0cc1 \u0c85\u0ca4\u0ccd\u0caf\u0c82\u0ca4 \u0caa\u0cb5\u0cbf\u0ca4\u0ccd\u0cb0\u0cb5\u0cbe\u0ca6\u0cc1\u0ca6\u0cc1. \u0cae\u0c82\u0ca1\u0cb2 \u0c95\u0cbe\u0cb2\u0ca6\u0cb2\u0ccd\u0cb2\u0cbf (41 \u0ca6\u0cbf\u0ca8\u0c97\u0cb3\u0cc1) \u0cad\u0c95\u0ccd\u0ca4\u0cb0\u0cc1 \u0cb6\u0ccd\u0cb0\u0ca6\u0ccd\u0ca7\u0cbe \u0cad\u0c95\u0ccd\u0ca4\u0cbf\u0c97\u0cb3\u0cbf\u0c82\u0ca6 \u0c86\u0c9a\u0cb0\u0cbf\u0cb8\u0cac\u0cc7\u0c95\u0cbe\u0ca6 \u0ca8\u0cbf\u0caf\u0cae\u0c97\u0cb3\u0cc1:\n    \n    [ \u0cae\u0cc1\u0c96\u0ccd\u0caf \u0cb5\u0ccd\u0cb0\u0ca4 \u0ca8\u0cbf\u0caf\u0cae\u0c97\u0cb3\u0cc1 ]\n    \u2022 \u0caa\u0ccd\u0cb0\u0ca4\u0cbf\u0ca6\u0cbf\u0ca8 \u0cae\u0cc1\u0c82\u0c9c\u0cbe\u0ca8\u0cc6 \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0cb8\u0c82\u0c9c\u0cc6 \u0ca4\u0ca3\u0ccd\u0ca3\u0cc0\u0cb0\u0cbf\u0ca8 \u0cb8\u0ccd\u0ca8\u0cbe\u0ca8.\n    \u2022 \u0ca8\u0cbf\u0ca4\u0ccd\u0caf\u0cb5\u0cc2 \u0cac\u0cc6\u0cb3\u0cbf\u0c97\u0ccd\u0c97\u0cc6 \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0cb8\u0c82\u0c9c\u0cc6 \u0c85\u0caf\u0ccd\u0caf\u0caa\u0ccd\u0caa \u0caa\u0cc2\u0c9c\u0cc6, \u0cb6\u0cb0\u0ca3\u0cc1\u0c98\u0ccb\u0cb7, \u0c86\u0cb0\u0ca4\u0cbf.\n    \u2022 \u0cb8\u0cbe\u0ca4\u0ccd\u0cb5\u0cbf\u0c95 \u0c86\u0cb9\u0cbe\u0cb0 \u0cb8\u0cc7\u0cb5\u0ca8\u0cc6 (\u0c8f\u0c95\u0cad\u0cc1\u0c95\u0ccd\u0ca4 \u0cb5\u0ccd\u0cb0\u0ca4).\n    \u2022 \u0c95\u0caa\u0ccd\u0caa\u0cc1, \u0ca8\u0cc0\u0cb2\u0cbf \u0c85\u0ca5\u0cb5\u0cbe \u0c95\u0cc7\u0cb8\u0cb0\u0cbf \u0cb5\u0cb8\u0ccd\u0ca4\u0ccd\u0cb0 \u0ca7\u0cbe\u0cb0\u0ca3\u0cc6.\n    \u2022 \u0cb8\u0cb0\u0ccd\u0cb5\u0cb0\u0cb2\u0ccd\u0cb2\u0cc2 \u0cb8\u0ccd\u0cb5\u0cbe\u0cae\u0cbf\u0caf\u0ca8\u0ccd\u0ca8\u0cc1 \u0c95\u0cbe\u0ca3\u0cc1\u0ca4\u0ccd\u0ca4\u0cbe '\u0cb8\u0ccd\u0cb5\u0cbe\u0cae\u0cbf' \u0c8e\u0c82\u0ca6\u0cc1 \u0c95\u0cb0\u0cc6\u0caf\u0cc1\u0cb5\u0cc1\u0ca6\u0cc1.\n    \u2022 \u0caa\u0cb0\u0cbf\u0caa\u0cc2\u0cb0\u0ccd\u0ca3 \u0cac\u0ccd\u0cb0\u0cb9\u0ccd\u0cae\u0c9a\u0cb0\u0ccd\u0caf \u0caa\u0cbe\u0cb2\u0ca8\u0cc6.\n    \u2022 \u0caa\u0cbe\u0ca6\u0cb0\u0c95\u0ccd\u0cb7\u0cc6\u0c97\u0cb3\u0ca8\u0ccd\u0ca8\u0cc1 \u0ca4\u0ccd\u0caf\u0c9c\u0cbf\u0cb8\u0cbf \u0caa\u0cbe\u0ca6\u0caf\u0cbe\u0ca4\u0ccd\u0cb0\u0cc6.\n    \n    [ \u0caa\u0ca1\u0cbf\u0caa\u0cc2\u0c9c\u0cc6 \u0cb5\u0cbf\u0ca7\u0cbe\u0ca8 ]\n    18 \u0caa\u0cb5\u0cbf\u0ca4\u0ccd\u0cb0 \u0cae\u0cc6\u0c9f\u0ccd\u0c9f\u0cbf\u0cb2\u0cc1\u0c97\u0cb3 (\u0caa\u0ca6\u0cc1\u0ca8\u0cc6\u0c9f\u0ccd\u0c9f\u0cbe\u0c82\u0cac\u0ca1\u0cbf) \u0caa\u0cc2\u0c9c\u0cc6 \u0c85\u0caf\u0ccd\u0caf\u0caa\u0ccd\u0caa \u0c86\u0cb0\u0cbe\u0ca7\u0ca8\u0cc6\u0caf\u0cb2\u0ccd\u0cb2\u0cbf \u0c85\u0ca4\u0ccd\u0caf\u0c82\u0ca4 \u0caa\u0cb5\u0cbf\u0ca4\u0ccd\u0cb0\u0cb5\u0cbe\u0ca6\u0cc1\u0ca6\u0cc1. \u0caa\u0ccd\u0cb0\u0ca4\u0cbf\u0caf\u0cca\u0c82\u0ca6\u0cc1 \u0cae\u0cc6\u0c9f\u0ccd\u0c9f\u0cbf\u0cb2\u0cbf\u0c97\u0cc6 \u0ca6\u0cc0\u0caa \u0cb9\u0c9a\u0ccd\u0c9a\u0cbf \u0caa\u0cc2\u0c9c\u0cc6 \u0ca8\u0cc6\u0cb0\u0cb5\u0cc7\u0cb0\u0cbf\u0cb8\u0cb2\u0cbe\u0c97\u0cc1\u0ca4\u0ccd\u0ca4\u0ca6\u0cc6.\n    \n    \u0cb8\u0ccd\u0cb5\u0cbe\u0cae\u0cbf\u0caf\u0cc7 \u0cb6\u0cb0\u0ca3\u0c82 \u0c85\u0caf\u0ccd\u0caf\u0caa\u0ccd\u0caa!",isAudio:!1,audioDurationSec:40,totalTime:"00:40"},{id:"5",slug:"maaladharana-mantram",title:"\u0cae\u0cbe\u0cb2\u0cbe\u0ca7\u0cbe\u0cb0\u0ca3 \u0cae\u0c82\u0ca4\u0ccd\u0cb0",description:"\u0c9c\u0ccd\u0c9e\u0cbe\u0ca8\u0cae\u0cc1\u0ca6\u0ccd\u0cb0\u0cbe\u0c82 \u0cb6\u0cbe\u0cb8\u0ccd\u0ca4\u0ccd\u0cb0\u0cae\u0cc1\u0ca6\u0ccd\u0cb0\u0cbe\u0c82\n    \u0c97\u0cc1\u0cb0\u0cc1\u0cae\u0cc1\u0ca6\u0ccd\u0cb0\u0cbe\u0c82 \u0ca8\u0cae\u0cbe\u0cae\u0ccd\u0caf\u0cb9\u0cae\u0ccd\n    \n    \u0cb5\u0ca8\u0cae\u0cc1\u0ca6\u0ccd\u0cb0\u0cbe\u0c82 \u0cb6\u0cc1\u0ca6\u0ccd\u0ca7\u0cae\u0cc1\u0ca6\u0ccd\u0cb0\u0cbe\u0c82\n    \u0cb0\u0cc1\u0ca6\u0ccd\u0cb0\u0cae\u0cc1\u0ca6\u0ccd\u0cb0\u0cbe\u0c82 \u0ca8\u0cae\u0cbe\u0cae\u0ccd\u0caf\u0cb9\u0cae\u0ccd\n    \n    \u0cb6\u0cbe\u0c82\u0ca4\u0cae\u0cc1\u0ca6\u0ccd\u0cb0\u0cbe\u0c82 \u0cb8\u0ca4\u0ccd\u0caf\u0cae\u0cc1\u0ca6\u0ccd\u0cb0\u0cbe\u0c82\n    \u0cb5\u0ccd\u0cb0\u0ca4\u0cae\u0cc1\u0ca6\u0ccd\u0cb0\u0cbe\u0c82 \u0ca8\u0cae\u0cbe\u0cae\u0ccd\u0caf\u0cb9\u0cae\u0ccd\n    \n    \u0cb6\u0cac\u0cb0\u0ccd\u0caf\u0cbe\u0cb6\u0ccd\u0cb0\u0cae \u0cb8\u0ca4\u0ccd\u0caf\u0cc7\u0ca8 \u0cae\u0cc1\u0ca6\u0ccd\u0cb0\u0cbe\u0c82 \u0caa\u0cbe\u0ca4\u0cc1 \u0cb8\u0ca6\u0cbe\u0caa\u0cbf \u0cae\u0cc7\n    \n    \u0c97\u0cc1\u0cb0\u0cc1\u0ca6\u0c95\u0ccd\u0cb7\u0cbf\u0ca3\u0caf\u0cbe \u0caa\u0cc2\u0cb0\u0ccd\u0cb5\u0c82 \u0ca4\u0cb8\u0ccd\u0caf\u0cbe\u0ca8\u0cc1\u0c97\u0ccd\u0cb0\u0cb9 \u0c95\u0cbe\u0cb0\u0cbf\u0ca3\u0cc7\n    \u0cb6\u0cb0\u0ca3\u0cbe\u0c97\u0ca4 \u0cae\u0cc1\u0ca6\u0ccd\u0cb0\u0cbe\u0c96\u0ccd\u0caf\u0c82 \u0ca4\u0ccd\u0cb5\u0ca8\u0ccd \u0cae\u0cc1\u0ca6\u0ccd\u0cb0\u0cbe\u0c82 \u0ca7\u0cbe\u0cb0\u0caf\u0cbe\u0cae\u0ccd\u0caf\u0cb9\u0cae\u0ccd\n    \n    \u0c9a\u0cbf\u0ca8\u0ccd\u0cae\u0cc1\u0ca6\u0ccd\u0cb0\u0cbe\u0c82 \u0c96\u0cc7\u0c9a\u0cb0\u0cc0\u0cae\u0cc1\u0ca6\u0ccd\u0cb0\u0cbe\u0c82 \u0cad\u0ca6\u0ccd\u0cb0\u0cae\u0cc1\u0ca6\u0ccd\u0cb0\u0cbe\u0c82 \u0ca8\u0cae\u0cbe\u0cae\u0ccd\u0caf\u0cb9\u0cae\u0ccd\n    \u0cb6\u0cac\u0cb0\u0ccd\u0caf\u0cbe\u0c9a\u0cb2 \u0cae\u0cc1\u0ca6\u0ccd\u0cb0\u0cbe\u0caf\u0cc8 \u0ca8\u0cae\u0cb8\u0ccd\u0ca4\u0cc1\u0cad\u0ccd\u0caf\u0c82 \u0ca8\u0cae\u0ccb \u0ca8\u0cae\u0c83\n    \n    \u0cae\u0cbe\u0cb2\u0cbe \u0cb5\u0cbf\u0cb8\u0cb0\u0ccd\u0c9c\u0ca8 \u0cae\u0c82\u0ca4\u0ccd\u0cb0\n    \n    \u0c85\u0caa\u0cc2\u0cb0\u0ccd\u0cb5\u0cae\u0c9a\u0cb2\u0cbe\u0cb0\u0ccb\u0cb9 \u0ca6\u0cbf\u0cb5\u0ccd\u0caf\u0ca6\u0cb0\u0ccd\u0cb6\u0ca8 \u0c95\u0cbe\u0cb0\u0c95\n    \u0cb6\u0cbe\u0cb8\u0ccd\u0ca4\u0ccd\u0cb0\u0cc7 \u0cae\u0cc1\u0ca6\u0ccd\u0cb0\u0cbe\u0ca4\u0ccd\u0cae \u0ca6\u0cc7\u0cb5\u0cc7\u0cb6 \u0ca6\u0cc7\u0cb9\u0cbf\u0cae\u0cc7 \u0cb5\u0ccd\u0cb0\u0ca4\u0cae\u0ccb\u0c9a\u0ca8\u0cae\u0ccd\n    \u0c93\u0c82 \u0cb6\u0ccd\u0cb0\u0cc0 \u0cb8\u0ccd\u0cb5\u0cbe\u0cae\u0cbf\u0caf\u0cc7 \u0cb6\u0cb0\u0ca3\u0c82 \u0c85\u0caf\u0ccd\u0caf\u0caa\u0ccd\u0caa\n    \n    \u0c85\u0caf\u0ccd\u0caf\u0caa\u0ccd\u0caa \u0ca6\u0cc0\u0c95\u0ccd\u0cb7\u0cbe \u0cb5\u0cb0\u0ccd\u0cb7 \u0ca8\u0cbe\u0cae\u0c97\u0cb3\u0cc1:\n    \u2022 1\u0ca8\u0cc7 \u0cb5\u0cb0\u0ccd\u0cb7: \u0c95\u0ca8\u0ccd\u0ca8\u0cbf \u0cb8\u0ccd\u0cb5\u0cbe\u0cae\u0cbf (KANNI SWAMY)\n    \u2022 2\u0ca8\u0cc7 \u0cb5\u0cb0\u0ccd\u0cb7: \u0c95\u0ca4\u0ccd\u0ca4\u0cbf \u0cb8\u0ccd\u0cb5\u0cbe\u0cae\u0cbf (KATHI SWAMY)\n    \u2022 3\u0ca8\u0cc7 \u0cb5\u0cb0\u0ccd\u0cb7: \u0c97\u0c82\u0c9f \u0cb8\u0ccd\u0cb5\u0cbe\u0cae\u0cbf (GANTA SWAMY)\n    \u2022 4\u0ca8\u0cc7 \u0cb5\u0cb0\u0ccd\u0cb7: \u0c97\u0ca6\u0cbe \u0cb8\u0ccd\u0cb5\u0cbe\u0cae\u0cbf (GADHA SWAMY)\n    \u2022 5\u0ca8\u0cc7 \u0cb5\u0cb0\u0ccd\u0cb7: \u0caa\u0cc7\u0cb0\u0cc1 \u0cb8\u0ccd\u0cb5\u0cbe\u0cae\u0cbf (PERU SWAMY)\n    \u2022 6\u0ca8\u0cc7 \u0cb5\u0cb0\u0ccd\u0cb7: \u0c9c\u0ccd\u0caf\u0ccb\u0ca4\u0cbf \u0cb8\u0ccd\u0cb5\u0cbe\u0cae\u0cbf (JYOTI SWAMY)\n    \u2022 7\u0ca8\u0cc7 \u0cb5\u0cb0\u0ccd\u0cb7: \u0cb8\u0cc2\u0cb0\u0ccd\u0caf \u0cb8\u0ccd\u0cb5\u0cbe\u0cae\u0cbf (SURYA SWAMY)\n    \u2022 8\u0ca8\u0cc7 \u0cb5\u0cb0\u0ccd\u0cb7: \u0c9a\u0c82\u0ca6\u0ccd\u0cb0 \u0cb8\u0ccd\u0cb5\u0cbe\u0cae\u0cbf (CHANDRA SWAMY)\n    \u2022 9\u0ca8\u0cc7 \u0cb5\u0cb0\u0ccd\u0cb7: \u0ca4\u0ccd\u0cb0\u0cbf\u0cb6\u0cc2\u0cb2 \u0cb8\u0ccd\u0cb5\u0cbe\u0cae\u0cbf (TRISHULA SWAMY)\n    \u2022 10\u0ca8\u0cc7 \u0cb5\u0cb0\u0ccd\u0cb7: \u0cb5\u0cbf\u0cb7\u0ccd\u0ca3\u0cc1 \u0c9a\u0c95\u0ccd\u0cb0 \u0cb8\u0ccd\u0cb5\u0cbe\u0cae\u0cbf (VISHNU CHAKRA SWAMY)\n    \u2022 11\u0ca8\u0cc7 \u0cb5\u0cb0\u0ccd\u0cb7: \u0cb6\u0c82\u0c96\u0ca7\u0cbe\u0cb0 \u0cb8\u0ccd\u0cb5\u0cbe\u0cae\u0cbf (SHANKADHARA SWAMY)\n    \u2022 12\u0ca8\u0cc7 \u0cb5\u0cb0\u0ccd\u0cb7: \u0ca8\u0cbe\u0c97\u0cbe\u0cad\u0cb0\u0ca3 \u0cb8\u0ccd\u0cb5\u0cbe\u0cae\u0cbf (NAGABHARANA SWAMY)\n    \u2022 13\u0ca8\u0cc7 \u0cb5\u0cb0\u0ccd\u0cb7: \u0cb6\u0ccd\u0cb0\u0cc0\u0cb9\u0cb0\u0cbf \u0cb8\u0ccd\u0cb5\u0cbe\u0cae\u0cbf (SRIHARI SWAMY)\n    \u2022 14\u0ca8\u0cc7 \u0cb5\u0cb0\u0ccd\u0cb7: \u0cb6\u0ccd\u0cb0\u0cc0 \u0cb8\u0ccd\u0cb5\u0cbe\u0cae\u0cbf (SRI SWAMY)\n    \u2022 15\u0ca8\u0cc7 \u0cb5\u0cb0\u0ccd\u0cb7: \u0cb6\u0ccd\u0cb0\u0cc0 \u0cb8\u0ccd\u0cb5\u0cbe\u0cae\u0cbf (SRI SWAMY)\n    \u2022 16\u0ca8\u0cc7 \u0cb5\u0cb0\u0ccd\u0cb7: \u0cb6\u0ccd\u0cb0\u0cc0 \u0cb6\u0cac\u0cb0\u0cbf \u0cb8\u0ccd\u0cb5\u0cbe\u0cae\u0cbf (SRI SABARI SWAMY)\n    \u2022 17\u0ca8\u0cc7 \u0cb5\u0cb0\u0ccd\u0cb7: \u0c93\u0c82\u0c95\u0cbe\u0cb0 \u0cb8\u0ccd\u0cb5\u0cbe\u0cae\u0cbf (OMKAARA SWAMY)\n    \u2022 18\u0ca8\u0cc7 \u0cb5\u0cb0\u0ccd\u0cb7: \u0ca8\u0cbe\u0cb0\u0cbf\u0c95\u0cc7\u0cb2 \u0cb8\u0ccd\u0cb5\u0cbe\u0cae\u0cbf (NAARIKELA SWAMY)",isAudio:!1,audioDurationSec:40,totalTime:"00:40"},{id:"6",slug:"sri-ayyappa-sharanu-gosha",title:"\u0cb6\u0ccd\u0cb0\u0cc0 \u0c85\u0caf\u0ccd\u0caf\u0caa\u0ccd\u0caa \u0cb6\u0cb0\u0ca3\u0cc1 \u0c98\u0ccb\u0cb7",description:"\u0c93\u0c82 \u0cb6\u0ccd\u0cb0\u0cc0 \u0cb8\u0ccd\u0cb5\u0cbe\u0cae\u0cbf\u0caf\u0cc7 \u0cb6\u0cb0\u0ca3\u0cae\u0caf\u0ccd\u0caf\u0caa\u0ccd\u0caa\n    \u0cb9\u0cb0\u0cbf \u0cb9\u0cb0 \u0cb8\u0cc1\u0ca4\u0ca8\u0cc7 \u0cb6\u0cb0\u0ca3\u0cae\u0caf\u0ccd\u0caf\u0caa\u0ccd\u0caa\n    \u0c86\u0caa\u0ca6\u0ccd\u0cad\u0cbe\u0c82\u0ca6\u0cb5\u0ca8\u0cc7 \u0cb6\u0cb0\u0ca3\u0cae\u0caf\u0ccd\u0caf\u0caa\u0ccd\u0caa\n    \u0c85\u0ca8\u0cbe\u0ca5\u0cb0\u0c95\u0ccd\u0cb7\u0c95\u0ca8\u0cc7 \u0cb6\u0cb0\u0ca3\u0cae\u0caf\u0ccd\u0caf\u0caa\u0ccd\u0caa\n    \u0c85\u0c96\u0cbf\u0cb2\u0cbe\u0c82\u0ca1 \u0c95\u0ccb\u0c9f\u0cbf \u0cac\u0ccd\u0cb0\u0cb9\u0ccd\u0cae\u0cbe\u0c82\u0ca1\u0ca8\u0cbe\u0caf\u0c95\u0ca8\u0cc7 \u0cb6\u0cb0\u0ca3\u0cae\u0caf\u0ccd\u0caf\u0caa\u0ccd\u0caa\n    \u0c85\u0ca8\u0ccd\u0ca8\u0ca6\u0cbe\u0ca8 \u0caa\u0ccd\u0cb0\u0cad\u0cc1\u0cb5\u0cc7 \u0cb6\u0cb0\u0ca3\u0cae\u0caf\u0ccd\u0caf\u0caa\u0ccd\u0caa\n    \u0c85\u0caf\u0ccd\u0caf\u0caa\u0ccd\u0caa\u0ca8\u0cc7 \u0cb6\u0cb0\u0ca3\u0cae\u0caf\u0ccd\u0caf\u0caa\u0ccd\u0caa\n    \u0c86\u0cb0\u0cbf\u0caf\u0c82\u0c97\u0cbe\u0cb5\u0cc1 \u0c85\u0caf\u0ccd\u0caf\u0cb5\u0cc7 \u0cb6\u0cb0\u0ca3\u0cae\u0caf\u0ccd\u0caf\u0caa\u0ccd\u0caa\n    \u0c86\u0c9a\u0ccd\u0c9a\u0ca8\u0ccd \u0c95\u0ccb\u0cb5\u0cbf\u0cb2\u0ccd \u0c85\u0cb0\u0ca8\u0cc7 \u0cb6\u0cb0\u0ca3\u0cae\u0caf\u0ccd\u0caf\u0caa\u0ccd\u0caa\n    \u0c95\u0cc1\u0cb2\u0ca4\u0ccd\u0ca4\u0caa\u0cc1\u0cb3\u0cc8 \u0cac\u0cbe\u0cb2\u0c95\u0ca8\u0cc7 \u0cb6\u0cb0\u0ca3\u0cae\u0caf\u0ccd\u0caf\u0caa\u0ccd\u0caa\n    \u0c8e\u0cb0\u0cc1\u0cae\u0cc7\u0cb2\u0cbf \u0cb6\u0cbe\u0cb8\u0ccd\u0ca4\u0ca8\u0cc7 \u0cb6\u0cb0\u0ca3\u0cae\u0caf\u0ccd\u0caf\u0caa\u0ccd\u0caa\n    \u0cb5\u0cbe\u0cb5\u0cb0\u0cc1\u0cb8\u0ccd\u0cb5\u0cbe\u0cae\u0cbf\u0ca8\u0cc7 \u0cb6\u0cb0\u0ca3\u0cae\u0caf\u0ccd\u0caf\u0caa\u0ccd\u0caa\n    \u0c95\u0ca8\u0ccd\u0ca8\u0cbf\u0cae\u0cc2\u0cb2 \u0cae\u0cb9\u0cbe \u0c97\u0ca3\u0caa\u0ca4\u0cbf\u0caf\u0cc7 \u0cb6\u0cb0\u0ca3\u0cae\u0caf\u0ccd\u0caf\u0caa\u0ccd\u0caa\n    \u0ca8\u0cbe\u0c97\u0cb0\u0cbe\u0c9c\u0cb5\u0cc7 \u0cb6\u0cb0\u0ca3\u0cae\u0caf\u0ccd\u0caf\u0caa\u0ccd\u0caa\n    \u0cae\u0cbe\u0cb3\u0cbf\u0c95\u0cbe\u0caa\u0cc1\u0cb0\u0ca4\u0ccd\u0ca4 \u0cb2\u0ccb\u0c95\u0ca6\u0cc7\u0cb5\u0cbf \u0cae\u0cbe\u0ca4\u0cbe\u0caf\u0cc7 \u0cb6\u0cb0\u0ca3\u0cae\u0caf\u0ccd\u0caf\u0caa\u0ccd\u0caa\n    \u0c95\u0cc1\u0cb0\u0cc1\u0caa\u0ccd\u0caa \u0cb8\u0ccd\u0cb5\u0cbe\u0cae\u0cbf\u0caf\u0cc7 \u0cb6\u0cb0\u0ca3\u0cae\u0caf\u0ccd\u0caf\u0caa\u0ccd\u0caa\n    \u0cb8\u0cc7\u0cb5\u0cbf\u0caa\u0ccd\u0caa \u0cb5\u0cb0\u0ccd\u0c95\u0cbe\u0ca8\u0c82\u0ca6 \u0cae\u0cc2\u0cb0\u0ccd\u0ca4\u0cbf\u0caf\u0cc7 \u0cb6\u0cb0\u0ca3\u0cae\u0caf\u0ccd\u0caf\u0caa\u0ccd\u0caa\n    \u0c95\u0cbe\u0cb6\u0cc0\u0cb5\u0cbe\u0cb8\u0cbf \u0caf\u0cc7 \u0cb6\u0cb0\u0ca3\u0cae\u0caf\u0ccd\u0caf\u0caa\u0ccd\u0caa\n    \u0cb9\u0cb0\u0cbf \u0ca6\u0ccd\u0cb5\u0cbe\u0cb0 \u0ca8\u0cbf\u0cb5\u0cbe\u0cb8\u0cbf\u0caf\u0cc7 \u0cb6\u0cb0\u0ca3\u0cae\u0caf\u0ccd\u0caf\u0caa\u0ccd\u0caa\n    \u0cb6\u0ccd\u0cb0\u0cc0 \u0cb0\u0c82\u0c97\u0caa\u0c9f\u0ccd\u0c9f\u0ca3 \u0cb5\u0cbe\u0cb8\u0cbf\u0caf\u0cc7 \u0cb6\u0cb0\u0ca3\u0cae\u0caf\u0ccd\u0caf\u0caa\u0ccd\u0caa\n    \u0c95\u0cb0\u0cc1\u0caa\u0ccd\u0caa\u0c9f\u0cc2\u0cb0\u0cc1 \u0cb5\u0cbe\u0cb8\u0cbf\u0caf\u0cc7 \u0cb6\u0cb0\u0ca3\u0cae\u0caf\u0ccd\u0caf\u0caa\u0ccd\u0caa\n    \u0caa\u0cb2\u0cae\u0cc2\u0cb0\u0cc1 \u0ca7\u0cb0\u0ccd\u0cae\u0cb6\u0cbe\u0cb8\u0ccd\u0ca4\u0cbe\u0cb5\u0cc7 \u0cb6\u0cb0\u0ca3\u0cae\u0caf\u0ccd\u0caf\u0caa\u0ccd\u0caa\n    \u0cb8\u0ca6\u0ccd\u0c97\u0cc1\u0cb0\u0cc1 \u0ca8\u0cbe\u0ca7\u0ca8\u0cc7 \u0cb6\u0cb0\u0ca3\u0cae\u0caf\u0ccd\u0caf\u0caa\u0ccd\u0caa\n    \u0cb5\u0cbf\u0cb2\u0cbe\u0cb2\u0cbf \u0cb5\u0cc0\u0cb0\u0ca8\u0cc7 \u0cb6\u0cb0\u0ca3\u0cae\u0caf\u0ccd\u0caf\u0caa\u0ccd\u0caa\n    \u0cb5\u0cc0\u0cb0\u0cae\u0ca3\u0cbf\u0c95\u0c82\u0ca0\u0ca8\u0cc7 \u0cb6\u0cb0\u0ca3\u0cae\u0caf\u0ccd\u0caf\u0caa\u0ccd\u0caa\n    \u0ca7\u0cb0\u0ccd\u0cae \u0cb6\u0cbe\u0cb8\u0ccd\u0ca4\u0ccd\u0cb0\u0cb5\u0cc7 \u0cb6\u0cb0\u0ca3\u0cae\u0caf\u0ccd\u0caf\u0caa\u0ccd\u0caa\n    \u0cb6\u0cb0\u0ca3\u0cc1\u0c98\u0ccb\u0cb7\u0caa\u0ccd\u0cb0\u0cbf\u0caf\u0cb5\u0cc7 \u0cb6\u0cb0\u0ca3\u0cae\u0caf\u0ccd\u0caf\u0caa\u0ccd\u0caa\n    \u0c95\u0cbe\u0c82\u0ca4\u0cbf \u0cae\u0cb2\u0cc8 \u0cb5\u0cbe\u0cb8\u0ca8\u0cc7 \u0cb6\u0cb0\u0ca3\u0cae\u0caf\u0ccd\u0caf\u0caa\u0ccd\u0caa\n    \u0caa\u0cca\u0ca8\u0ccd\u0ca8\u0c82\u0cac\u0cb2\u0cb5\u0cbe\u0cb8\u0cbf\u0caf\u0cc7 \u0cb6\u0cb0\u0ca3\u0cae\u0caf\u0ccd\u0caf\u0caa\u0ccd\u0caa\n    \u0caa\u0c82\u0ca6\u0cb2\u0cb6\u0cbf\u0cb6\u0cc1\u0cb5\u0cc7 \u0cb6\u0cb0\u0ca3\u0cae\u0caf\u0ccd\u0caf\u0caa\u0ccd\u0caa\n    \u0cb5\u0cbe\u0cb5\u0cb0\u0cbf\u0ca8\u0ccd \u0ca4\u0ccb\u0cb3\u0ca8\u0cc7 \u0cb6\u0cb0\u0ca3\u0cae\u0caf\u0ccd\u0caf\u0caa\u0ccd\u0caa\n    \u0cae\u0ccb\u0cb9\u0cbf\u0ca8\u0cc0\u0cb8\u0cc1\u0ca4\u0cb5\u0cc7 \u0cb6\u0cb0\u0ca3\u0cae\u0caf\u0ccd\u0caf\u0caa\u0ccd\u0caa\n    \u0c95\u0ca3\u0ccd \u0c95\u0c82\u0ca1 \u0ca6\u0cc8\u0cb5\u0cae\u0cc7 \u0cb6\u0cb0\u0ca3\u0cae\u0caf\u0ccd\u0caf\u0caa\u0ccd\u0caa\n    \u0c95\u0cb2\u0cbf\u0caf\u0cc1\u0c97\u0cb5\u0cb0\u0ca6\u0ca8\u0cc7 \u0cb6\u0cb0\u0ca3\u0cae\u0caf\u0ccd\u0caf\u0caa\u0ccd\u0caa\n    \u0cb8\u0cb0\u0ccd\u0cb5\u0cb0\u0ccb\u0c97 \u0ca8\u0cbf\u0cb5\u0cbe\u0cb0\u0ca3 \u0ca7\u0ca8\u0ccd\u0cb5\u0c82\u0ca4\u0cb0 \u0cae\u0cc2\u0cb0\u0ccd\u0ca4\u0cbf\u0caf\u0cc7 \u0cb6\u0cb0\u0ca3\u0cae\u0caf\u0ccd\u0caf\u0caa\u0ccd\u0caa\n    \u0cae\u0cb9\u0cbf\u0cb7\u0cbf\u0cae\u0cb0\u0ccd\u0ca6\u0ca8\u0ca8\u0cc7 \u0cb6\u0cb0\u0ca3\u0cae\u0caf\u0ccd\u0caf\u0caa\u0ccd\u0caa\n    \u0caa\u0cc2\u0cb0\u0ccd\u0ca3 \u0caa\u0cc1\u0cb7\u0ccd\u0c95\u0cb2 \u0ca8\u0cbe\u0ca7\u0ca8\u0cc7 \u0cb6\u0cb0\u0ca3\u0cae\u0caf\u0ccd\u0caf\u0caa\u0ccd\u0caa\n    \u0cb5\u0ca8\u0ccd \u0caa\u0cc1\u0cb2\u0cbf \u0cb5\u0cbe\u0cb9\u0ca8\u0ca8\u0cc7 \u0cb6\u0cb0\u0ca3\u0cae\u0caf\u0ccd\u0caf\u0caa\u0ccd\u0caa\n    \u0cad\u0c95\u0ccd\u0ca4\u0cb5\u0ca4\u0ccd\u0cb8\u0cb2\u0ca8\u0cc7 \u0cb6\u0cb0\u0ca3\u0cae\u0caf\u0ccd\u0caf\u0caa\u0ccd\u0caa\n    \u0cad\u0cc2\u0cb2\u0ccb\u0c95\u0ca8\u0cbe\u0ca7\u0ca8\u0cc7 \u0cb6\u0cb0\u0ca3\u0cae\u0caf\u0ccd\u0caf\u0caa\u0ccd\u0caa\n    \u0c85\u0caf\u0cbf\u0c82\u0ca6\u0cc1\u0cae\u0cb2\u0cc8\u0cb5\u0cbe\u0cb8\u0cb5\u0cc7 \u0cb6\u0cb0\u0ca3\u0cae\u0caf\u0ccd\u0caf\u0caa\u0ccd\u0caa\n    \u0cb6\u0cac\u0cb0\u0cbf \u0c97\u0cbf\u0cb0\u0cc0\u0cb6\u0ca8\u0cc7 \u0cb6\u0cb0\u0ca3\u0cae\u0caf\u0ccd\u0caf\u0caa\u0ccd\u0caa\n    \u0c87\u0cb0\u0cc1\u0cae\u0cc1\u0ca1\u0cbf \u0caa\u0ccd\u0cb0\u0cbf\u0caf\u0ca8\u0cc7 \u0cb6\u0cb0\u0ca3\u0cae\u0caf\u0ccd\u0caf\u0caa\u0ccd\u0caa\n    \u0c85\u0cad\u0cbf\u0cb7\u0cc7\u0c95\u0caa\u0ccd\u0cb0\u0cbf\u0caf\u0ca8\u0cc7 \u0cb6\u0cb0\u0ca3\u0cae\u0caf\u0ccd\u0caf\u0caa\u0ccd\u0caa\n    \u0cb5\u0cc7\u0ca6\u0caa\u0ccd\u0caa\u0cca\u0cb0\u0cc1\u0cb3\u0cc0\u0ca8\u0cc7 \u0cb6\u0cb0\u0ca3\u0cae\u0caf\u0ccd\u0caf\u0caa\u0ccd\u0caa\n    \u0ca8\u0cbf\u0ca4\u0ccd\u0caf \u0cac\u0ccd\u0cb0\u0cb9\u0ccd\u0cae \u0c9a\u0cbe\u0cb0\u0cbf\u0ca3\u0cc7 \u0cb6\u0cb0\u0ca3\u0cae\u0caf\u0ccd\u0caf\u0caa\u0ccd\u0caa\n    \u0cb8\u0cb0\u0ccd\u0cb5 \u0cae\u0c82\u0c97\u0cb3\u0ca6\u0cbe\u0caf\u0c95\u0ca8\u0cc7 \u0cb6\u0cb0\u0ca3\u0cae\u0caf\u0ccd\u0caf\u0caa\u0ccd\u0caa\n    \u0cb5\u0cc0\u0cb0\u0cbe\u0ca7\u0cbf\u0cb5\u0cc0\u0cb0\u0ca8\u0cc7 \u0cb6\u0cb0\u0ca3\u0cae\u0caf\u0ccd\u0caf\u0caa\u0ccd\u0caa\n    \u0c93\u0c82\u0c95\u0cbe\u0cb0\u0cbe\u0caa\u0ccd\u0caa\u0cca\u0cb0\u0cc1\u0cb3\u0cc7 \u0cb6\u0cb0\u0ca3\u0cae\u0caf\u0ccd\u0caf\u0caa\u0ccd\u0caa\n    \u0c86\u0ca8\u0c82\u0ca6\u0cb0\u0cc2\u0caa\u0ca8\u0cc7 \u0cb6\u0cb0\u0ca3\u0cae\u0caf\u0ccd\u0caf\u0caa\u0ccd\u0caa\n    \u0cad\u0c95\u0ccd\u0ca4 \u0c9a\u0cbf\u0ca4\u0ccd\u0ca4\u0cbe\u0ca6\u0cbf\u0cb5\u0cbe\u0cb8\u0ca8\u0cc7 \u0cb6\u0cb0\u0ca3\u0cae\u0caf\u0ccd\u0caf\u0caa\u0ccd\u0caa\n    \u0c86\u0cb6\u0ccd\u0cb0\u0cbf\u0ca4\u0cb5\u0ca4\u0ccd\u0cb8 \u0cb2\u0ca8\u0cc7 \u0cb6\u0cb0\u0ca3\u0cae\u0caf\u0ccd\u0caf\u0caa\u0ccd\u0caa\n    \u0cad\u0cc2\u0ca4 \u0c97\u0ca3\u0cbe\u0ca7\u0cbf\u0caa\u0ca4\u0caf\u0cc7 \u0cb6\u0cb0\u0ca3\u0cae\u0caf\u0ccd\u0caf\u0caa\u0ccd\u0caa\n    \u0cb6\u0c95\u0ccd\u0ca4\u0cbf\u0cb0\u0cc2\u0caa\u0ca8\u0cc7 \u0cb6\u0cb0\u0ca3\u0cae\u0caf\u0ccd\u0caf\u0caa\u0ccd\u0caa\n    \u0ca8\u0cbe\u0c97\u0cbe\u0cb0\u0ccd\u0c9c\u0cc1\u0ca8\u0cb8\u0cbe\u0c97\u0cb0\u0cc1\u0ca7\u0cb0\u0ccd\u0cae \u0cb6\u0cbe\u0cb8\u0ccd\u0ca4\u0cb5\u0cc7 \u0cb6\u0cb0\u0ca3\u0cae\u0caf\u0ccd\u0caf\u0caa\u0ccd\u0caa\n    \u0cb6\u0cbe\u0c82\u0ca4\u0cae\u0cc2\u0cb0\u0ccd\u0ca4\u0caf\u0cc7 \u0cb6\u0cb0\u0ca3\u0cae\u0caf\u0ccd\u0caf\u0caa\u0ccd\u0caa\n    \u0caa\u0ca6\u0cc1\u0ca8\u0cc6\u0cb2\u0ccd\u0cac\u0cbe\u0cac\u0ca1\u0cbf\u0c95\u0ccd\u0c95\u0cbf \u0c85\u0ca7\u0cbf\u0caa\u0ca4\u0cbf\u0caf\u0cc7 \u0cb6\u0cb0\u0ca3\u0cae\u0caf\u0ccd\u0caf\u0caa\u0ccd\u0caa\n    \u0c95\u0c9f\u0ccd\u0c9f\u0cbe\u0cb2 \u0cb5\u0cbf\u0cb7\u0cbe\u0cb0\u0cbe\u0cae\u0ca8\u0cc7 \u0cb6\u0cb0\u0ca3\u0cae\u0caf\u0ccd\u0caf\u0caa\u0ccd\u0caa\n    \u0c8b\u0cb7\u0cbf\u0c95\u0cc1\u0cb2 \u0cb0\u0c95\u0ccd\u0cb7\u0c95\u0cc1\u0ca8\u0cc7 \u0cb6\u0cb0\u0ca3\u0cae\u0caf\u0ccd\u0caf\u0caa\u0ccd\u0caa\n    \u0cb5\u0cc7\u0ca6\u0caa\u0ccd\u0cb0\u0cbf\u0caf\u0ca8\u0cc7 \u0cb6\u0cb0\u0ca3\u0cae\u0caf\u0ccd\u0caf\u0caa\u0ccd\u0caa\n    \u0c89\u0ca4\u0ccd\u0ca4\u0cb0\u0cbe\u0ca8\u0c95\u0ccd\u0cb7\u0ca4\u0ccd\u0cb0 \u0c9c\u0cbe\u0ca4\u0c95\u0ca8\u0cc7 \u0cb6\u0cb0\u0ca3\u0cae\u0caf\u0ccd\u0caf\u0caa\u0ccd\u0caa\n    \u0ca4\u0caa\u0ccb\u0ca7\u0ca8\u0ca8\u0cc7 \u0cb6\u0cb0\u0ca3\u0cae\u0caf\u0ccd\u0caf\u0caa\u0ccd\u0caa\n    \u0caf\u0c82\u0c97\u0cb3\u0c95\u0cc1\u0cb2 \u0ca6\u0cc8\u0cb5\u0cae\u0cc7 \u0cb6\u0cb0\u0ca3\u0cae\u0caf\u0ccd\u0caf\u0caa\u0ccd\u0caa\n    \u0c9c\u0c97\u0ca8\u0ccd\u0cae\u0ccb\u0cb9\u0ca8\u0cc7 \u0cb6\u0cb0\u0ca3\u0cae\u0caf\u0ccd\u0caf\u0caa\u0ccd\u0caa\n    \u0cae\u0ccb\u0cb9\u0ca8\u0cb0\u0cc2\u0caa\u0ca8\u0cc7 \u0cb6\u0cb0\u0ca3\u0cae\u0caf\u0ccd\u0caf\u0caa\u0ccd\u0caa\n    \u0cae\u0cbe\u0ca7\u0cb5\u0cb8\u0cc1\u0ca4\u0ca8\u0cc7 \u0cb6\u0cb0\u0ca3\u0cae\u0caf\u0ccd\u0caf\u0caa\u0ccd\u0caa\n    \u0caf\u0ca6\u0cc1\u0c95\u0cc1\u0cb2\u0cb5\u0cc0\u0cb0\u0ca8\u0cc7 \u0cb6\u0cb0\u0ca3\u0cae\u0caf\u0ccd\u0caf\u0caa\u0ccd\u0caa\n    \u0cae\u0cbe\u0cae\u0cb2\u0cc8 \u0cb5\u0cbe\u0cb8\u0ca8\u0cc7 \u0cb6\u0cb0\u0ca3\u0cae\u0caf\u0ccd\u0caf\u0caa\u0ccd\u0caa\n    \u0cb7\u0ca3\u0ccd\u0cae\u0cc1\u0c96\u0cb8\u0ccb\u0ca6\u0cb0 \u0ca8\u0cc7 \u0cb6\u0cb0\u0ca3\u0cae\u0caf\u0ccd\u0caf\u0caa\u0ccd\u0caa\n    \u0cb5\u0cc7\u0ca6\u0cbe\u0c82\u0ca4\u0cb0\u0ccb\u0caa\u0ca8\u0cc7 \u0cb6\u0cb0\u0ca3\u0cae\u0caf\u0ccd\u0caf\u0caa\u0ccd\u0caa\n    \u0cb6\u0c82\u0c95\u0cb0 \u0cb8\u0cc1\u0ca4\u0ca8\u0cc7 \u0cb6\u0cb0\u0ca3\u0cae\u0caf\u0ccd\u0caf\u0caa\u0ccd\u0caa\n    \u0cb6\u0ca4\u0ccd\u0cb0\u0cc1\u0cb8\u0c82\u0cb9\u0cbe\u0cb0\u0cbf\u0ca3\u0cc7 \u0cb6\u0cb0\u0ca3\u0cae\u0caf\u0ccd\u0caf\u0caa\u0ccd\u0caa\n    \u0cb8\u0ca6\u0ccd\u0c97\u0cc1\u0ca3\u0cae\u0cc2\u0cb0\u0ccd\u0ca4\u0caf\u0cc7 \u0cb6\u0cb0\u0ca3\u0cae\u0caf\u0ccd\u0caf\u0caa\u0ccd\u0caa\n    \u0caa\u0cb0\u0cbe\u0cb6\u0c95\u0ccd\u0ca4\u0cbf\u0caf\u0cc7 \u0cb6\u0cb0\u0ca3\u0cae\u0caf\u0ccd\u0caf\u0caa\u0ccd\u0caa\n    \u0caa\u0cb0\u0cbe\u0ca4\u0ccd\u0caa\u0cb0\u0ca8\u0cc7 \u0cb6\u0cb0\u0ca3\u0cae\u0caf\u0ccd\u0caf\u0caa\u0ccd\u0caa\n    \u0caa\u0cb0\u0c82\u0c9c\u0ccd\u0caf\u0ccb\u0ca4\u0cbf\u0caf\u0cc7 \u0cb6\u0cb0\u0ca3\u0cae\u0caf\u0ccd\u0caf\u0caa\u0ccd\u0caa\n    \u0cb9\u0ccb\u0cae\u0caa\u0ccd\u0cb0\u0cbf\u0caf\u0ca8\u0cc7 \u0cb6\u0cb0\u0ca3\u0cae\u0caf\u0ccd\u0caf\u0caa\u0ccd\u0caa\n    \u0c97\u0ca3\u0caa\u0ca4\u0cbf \u0cb8\u0ccb\u0ca6\u0cb0 \u0ca8\u0cc7 \u0cb6\u0cb0\u0ca3\u0cae\u0caf\u0ccd\u0caf\u0caa\u0ccd\u0caa\n    \u0ca7\u0cb0\u0ccd\u0cae \u0cb6\u0cbe\u0cb8\u0ccd\u0ca4\u0ccd\u0cb0\u0cbe\u0cb5\u0cc7 \u0cb6\u0cb0\u0ca3\u0cae\u0caf\u0ccd\u0caf\u0caa\u0ccd\u0caa\n    \u0cb5\u0cbf\u0cb7\u0ccd\u0ca3\u0cc1\u0cb8\u0cc1\u0ca4\u0ca8\u0cc7 \u0cb6\u0cb0\u0ca3\u0cae\u0caf\u0ccd\u0caf\u0caa\u0ccd\u0caa\n    \u0cb8\u0c95\u0cb2 \u0c95\u0cb3\u0cbe \u0cb5\u0cb2\u0ccd\u0cb2\u0cad\u0ca8\u0cc7 \u0cb6\u0cb0\u0ca3\u0cae\u0caf\u0ccd\u0caf\u0caa\u0ccd\u0caa\n    \u0cb2\u0ccb\u0c95 \u0cb0\u0c95\u0ccd\u0cb7\u0c95\u0ca8\u0cc7 \u0cb6\u0cb0\u0ca3\u0cae\u0caf\u0ccd\u0caf\u0caa\u0ccd\u0caa\n    \u0c85\u0cae\u0cbf\u0ca4 \u0c97\u0cc1\u0ca3\u0cbe\u0c95\u0cb0\u0ca3\u0cc7 \u0cb6\u0cb0\u0ca3\u0cae\u0caf\u0ccd\u0caf\u0caa\u0ccd\u0caa\n    \u0c85\u0cb2\u0c82\u0c95\u0cbe\u0cb0 \u0caa\u0ccd\u0cb0\u0cbf\u0caf\u0ca8\u0cc7 \u0cb6\u0cb0\u0ca3\u0cae\u0caf\u0ccd\u0caf\u0caa\u0ccd\u0caa\n    \u0c95\u0ca8\u0ccd\u0ca8\u0cbf \u0cae\u0cbe\u0cb0\u0cc8 \u0c95\u0caa\u0ccd\u0caa\u0cb5\u0ca8\u0cc7 \u0cb6\u0cb0\u0ca3\u0cae\u0caf\u0ccd\u0caf\u0caa\u0ccd\u0caa\n    \u0cad\u0cc1\u0cb5\u0ca8\u0cc7\u0cb6\u0ccd\u0cb5\u0cb0\u0ca8\u0cc7 \u0cb6\u0cb0\u0ca3\u0cae\u0caf\u0ccd\u0caf\u0caa\u0ccd\u0caa\n    \u0cae\u0cbe\u0ca4\u0cbe\u0caa\u0cbf\u0ca4\u0cbe \u0c97\u0cc1\u0cb0\u0cc1\u0ca6\u0cc8\u0cb5\u0cae\u0cc7 \u0cb6\u0cb0\u0ca3\u0cae\u0caf\u0ccd\u0caf\u0caa\u0ccd\u0caa\n    \u0cb8\u0ccd\u0cb5\u0cbe\u0cae\u0cbf\u0caf\u0cbf\u0ca8\u0ccd \u0caa\u0cc2\u0c82\u0c97\u0cbe\u0cb5\u0ca8\u0cae\u0cc7 \u0cb6\u0cb0\u0ca3\u0cae\u0caf\u0ccd\u0caf\u0caa\u0ccd\u0caa\n    \u0c85\u0cb3\u0cc1\u0ca6\u0cbe\u0ca8\u0ca6\u0cbf\u0caf\u0cc7 \u0cb6\u0cb0\u0ca3\u0cae\u0caf\u0ccd\u0caf\u0caa\u0ccd\u0caa\n    \u0c85\u0cb3\u0cc1\u0ca6\u0cbe\u0cae\u0cc7\u0ca1\u0cc7 \u0cb6\u0cb0\u0ca3\u0cae\u0caf\u0ccd\u0caf\u0caa\u0ccd\u0caa\n    \u0c95\u0cb2\u0ccd\u0cb2\u0cbf\u0ca1\u0ccd\u0cb0\u0c82\u0c95\u0cc1\u0c82\u0ca1\u0ccd\u0cb0\u0cc7 \u0cb6\u0cb0\u0ca3\u0cae\u0caf\u0ccd\u0caf\u0caa\u0ccd\u0caa\n    \u0c95\u0cb0\u0cbf\u0cae\u0cb2\u0cc8 \u0c8f\u0c9f\u0ccd\u0cb0\u0cae\u0cc7 \u0cb6\u0cb0\u0ca3\u0cae\u0caf\u0ccd\u0caf\u0caa\u0ccd\u0caa\n    \u0c95\u0cb0\u0cbf\u0cae\u0cb2\u0cc8 \u0c8e\u0cb0\u0c95\u0ccd\u0c95\u0cae\u0cc7 \u0cb6\u0cb0\u0ca3\u0cae\u0caf\u0ccd\u0caf\u0caa\u0ccd\u0caa\n    \u0caa\u0cc6\u0cb0\u0cbf\u0caf\u0cbe\u0ca8\u0ccd \u0cb5\u0c9f\u0ccd\u0c9f\u0cae\u0cc7 \u0cb6\u0cb0\u0ca3\u0cae\u0caf\u0ccd\u0caf\u0caa\u0ccd\u0caa\n    \u0c9a\u0cc6\u0cb0\u0cbf\u0caf\u0cbe\u0ca8 \u0cb5\u0c9f\u0ccd\u0c9f\u0cae\u0cc7 \u0cb6\u0cb0\u0ca3\u0cae\u0caf\u0ccd\u0caf\u0caa\u0ccd\u0caa\n    \u0caa\u0c82\u0cac\u0cbe\u0ca8\u0ca6\u0cbf\u0caf\u0cc7 \u0cb6\u0cb0\u0ca3\u0cae\u0caf\u0ccd\u0caf\u0caa\u0ccd\u0caa\n    \u0caa\u0c82\u0cac\u0caf\u0cbf\u0cb2\u0ccd \u0cb5\u0cc7\u0cb3\u0c95\u0ccd\u0c95\u0cc7 \u0cb6\u0cb0\u0ca3\u0cae\u0caf\u0ccd\u0caf\u0caa\u0ccd\u0caa\n    \u0ca8\u0cc0\u0cb2\u0cbf\u0cae\u0cb2\u0cc8 \u0caf\u0cc7 \u0c9f\u0ccd\u0cb0\u0cc7\u0cae\u0cc7 \u0cb6\u0cb0\u0ca3\u0cae\u0caf\u0ccd\u0caf\u0caa\u0ccd\u0caa\n    \u0c85\u0caa\u0ccd\u0caa\u0cbe\u0c9a\u0cbf \u0cae\u0cc7\u0ca1\u0cc7 \u0cb6\u0cb0\u0ca3\u0cae\u0caf\u0ccd\u0caf\u0caa\u0ccd\u0caa\n    \u0cb6\u0cac\u0cb0\u0cc0\u0caa\u0cc0\u0ca0\u0cae\u0cc7 \u0cb6\u0cb0\u0ca3\u0cae\u0caf\u0ccd\u0caf\u0caa\u0ccd\u0caa\n    \u0cb6\u0cb0\u0c82 \u0c97\u0cc1\u0ca4\u0ccd\u0ca4\u0cbf \u0c86\u0cb2\u0cc7 \u0cb6\u0cb0\u0ca3\u0cae\u0caf\u0ccd\u0caf\u0caa\u0ccd\u0caa\n    \u0cad\u0cb8\u0ccd\u0cae\u0c95\u0cc1\u0cb3\u0cae\u0cc7 \u0cb6\u0cb0\u0ca3\u0cae\u0caf\u0ccd\u0caf\u0caa\u0ccd\u0caa\n    \u0caa\u0ca6\u0cc1\u0ca8\u0cc6\u0c9f\u0ccd\u0c9f\u0cbe\u0cae\u0ccd \u0cac\u0ca1\u0cbf\u0caf\u0cc7 \u0cb6\u0cb0\u0ca3\u0cae\u0caf\u0ccd\u0caf\u0caa\u0ccd\u0caa\n    \u0ca8\u0cc6\u0caf\u0ccd\u0caf\u0cc0\u0cad\u0cbf \u0cb6\u0cc7\u0c95\u0caa\u0ccd\u0cb0\u0cbf\u0caf\u0ca8\u0cc7 \u0cb6\u0cb0\u0ca3\u0cae\u0caf\u0ccd\u0caf\u0caa\u0ccd\u0caa\n    \u0c95\u0cb0\u0ccd\u0caa\u0cc2\u0cb0 \u0c9c\u0ccd\u0caf\u0ccb\u0ca4\u0cbf\u0caf\u0cc7 \u0cb6\u0cb0\u0ca3\u0cae\u0caf\u0ccd\u0caf\u0caa\u0ccd\u0caa\n    \u0c9c\u0ccd\u0caf\u0ccb\u0ca4\u0cbf\u0cb8\u0ccd\u0cb5\u0cb0\u0cc2\u0caa\u0ca8\u0cc7 \u0cb6\u0cb0\u0ca3\u0cae\u0caf\u0ccd\u0caf\u0caa\u0ccd\u0caa\n    \u0cae\u0c95\u0cb0 \u0c9c\u0ccd\u0caf\u0ccb\u0ca4\u0cbf\u0caf\u0cc7 \u0cb6\u0cb0\u0ca3\u0cae\u0caf\u0ccd\u0caf\u0caa\u0ccd\u0caa\n    \u0caa\u0c82\u0ca6\u0cb2 \u0cb0\u0cbe\u0c9c \u0c95\u0cc1\u0cae\u0cbe\u0cb0\u0ca8\u0cc7 \u0cb6\u0cb0\u0ca3\u0cae\u0caf\u0ccd\u0caf\u0caa\u0ccd\u0caa",isAudio:!1,audioDurationSec:40,totalTime:"00:40"},{id:"7",slug:"nithyapooja",title:"\u0c28\u0c3f\u0c24\u0c4d\u0c2f \u0c2a\u0c42\u0c1c (\u0c32\u0c18\u0c41 \u0c35\u0c3f\u0c27\u0c3e\u0c28\u0c02)",description:"",isAudio:!1,audioDurationSec:40,totalTime:"00:40"},{id:"8",slug:"slogans-of-sri-ayyappa-swami",title:"\u0cb8\u0ccd\u0ca4\u0ccb\u0ca4\u0ccd\u0cb0\u0c97\u0cb3\u0cc1",description:"\u0cb8\u0ccd\u0cb5\u0cbe\u0cae\u0cbf \u0cb6\u0cb0\u0ca3\u0c82 \u2013 \u0c85\u0caf\u0ccd\u0caf\u0caa\u0ccd\u0caa \u0cb6\u0cb0\u0ca3\u0c82\n    \u0cad\u0c97\u0cb5\u0cbe\u0ca8\u0ccd \u0cb6\u0cb0\u0ca3\u0c82 \u2013 \u0cad\u0c97\u0cb5\u0ca4\u0cbf \u0cb6\u0cb0\u0ca3\u0c82\n    \u0ca6\u0cc7\u0cb5\u0ca8\u0ccd \u0cb6\u0cb0\u0ca3\u0c82 \u2013 \u0ca6\u0cc7\u0cb5\u0cc0 \u0cb6\u0cb0\u0ca3\u0c82\n    \u0ca6\u0cc7\u0cb5\u0ca8\u0ccd \u0caa\u0cbe\u0ca6\u0c82 \u2013 \u0ca6\u0cc7\u0cb5\u0cc0 \u0caa\u0cbe\u0ca6\u0c82\n    \u0cb8\u0ccd\u0cb5\u0cbe\u0cae\u0cbf \u0caa\u0cbe\u0ca6\u0c82 \u2013 \u0c85\u0caf\u0ccd\u0caf\u0caa\u0ccd\u0caa \u0caa\u0cbe\u0ca6\u0c82\n    \u0cad\u0c97\u0cb5\u0cbe\u0ca8\u0cc7 \u2013 \u0cad\u0c97\u0cb5\u0ca4\u0cbf\u0caf\u0cc7\n    \u0c88\u0cb6\u0ccd\u0cb5\u0cb0\u0ca8\u0cc7 \u2013 \u0c88\u0cb6\u0ccd\u0cb5\u0cb0\u0cbf\u0caf\u0cc7\n    \u0ca6\u0cc7\u0cb5\u0ca8\u0cc7 \u2013 \u0ca6\u0cc7\u0cb5\u0cbf\u0caf\u0cc7\n    \u0cb6\u0c95\u0ccd\u0ca4\u0ca8\u0cc7 \u2013 \u0cb6\u0c95\u0ccd\u0ca4\u0cbf\u0caf\u0cc7\n    \u0cb8\u0ccd\u0cb5\u0cbe\u0cae\u0cbf\u0caf\u0cc7 \u2013 \u0c85\u0caf\u0ccd\u0caf\u0caa\u0ccd\u0caa\u0ccb\n    \u0caa\u0cb2\u0ccd\u0cb2\u0cbf\u0c95\u0c9f\u0ccd\u0c9f\u0cc1 \u2013 \u0cb6\u0cac\u0cb0\u0cbf\u0cae\u0cb2\u0cc8\u0c95\u0ccd\u0c95\u0cc1\n    \u0c87\u0cb0\u0cc1\u0cae\u0cc1\u0ca1\u0cbf\u0c95\u0c9f\u0ccd\u0c9f\u0cc1 \u2013 \u0cb6\u0cac\u0cb0\u0cbf\u0cae\u0cb2\u0cc8\u0c95\u0ccd\u0c95\u0cc1\n    \u0c95\u0c9f\u0ccd\u0c9f\u0cc1\u0c82\u0c95\u0c9f\u0ccd\u0c9f\u0cc1 \u2013 \u0cb6\u0cac\u0cb0\u0cbf\u0cae\u0cb2\u0cc8\u0c95\u0ccd\u0c95\u0cc1\n    \u0c95\u0cb2\u0ccd\u0cb2\u0cc1\u0cae\u0ccd\u0cae\u0cc1\u0cb2\u0ccd\u0cb2\u0cc1\u0c82 \u2013 \u0c95\u0cbe\u0cb2\u0cbf\u0c95\u0cc0\u0cae\u0cc6\u0ca4\u0ccd\u0ca4\u0cc8\n    \u0c8e\u0ca4\u0ccd\u0ca4\u0cbf\u0cb5\u0cbf\u0ca1\u0caf\u0ccd\u0caf \u2013 \u0ca4\u0cc2\u0c95\u0ccd\u0c95\u0cbf\u0c95\u0ccd\u0c95\u0cb5\u0cbf\u0ca1\u0caf\u0ccd\u0caf\n    \u0ca6\u0cc7\u0cb9\u0cac\u0cb2\u0c82\u0ca6\u0cbe \u2013 \u0caa\u0cbe\u0ca6\u0cac\u0cb2\u0c82\u0ca6\u0cbe\n    \u0caf\u0cbe\u0cb0\u0cc8\u0c95\u0ccd\u0c95\u0cbe\u0ca3 \u2013 \u0cb8\u0ccd\u0cb5\u0cbe\u0cae\u0cbf\u0caf\u0cc8\u0c95\u0ccd\u0c95\u0cbe\u0ca3\n    \u0cb8\u0ccd\u0cb5\u0cbe\u0cae\u0cbf\u0caf\u0cc8\u0c95\u0ccd\u0c95\u0c82\u0ca1\u0cbe \u2013 \u0cae\u0ccb\u0c95\u0ccd\u0cb7\u0c82\u0c95\u0cbf\u0c9f\u0ccd\u0c9f\u0cc1\u0c82\n    \u0cb8\u0ccd\u0cb5\u0cbe\u0cae\u0cbf\u0cae\u0cbe\u0cb0\u0cc7 \u2013 \u0c85\u0caf\u0ccd\u0caf\u0caa\u0ccd\u0caa\u0cae\u0cbe\u0cb0\u0cc7\n    \u0ca8\u0cc6\u0caf\u0ccd\u0caf\u0cbe\u0cad\u0cbf\u0cb7\u0cc7\u0c95\u0c82 \u2013 \u0cb8\u0ccd\u0cb5\u0cbe\u0cae\u0cbf\u0c95\u0ccd\u0c95\u0cc7\n    \u0c95\u0cb0\u0ccd\u0caa\u0cc2\u0cb0\u0ca6\u0cc0\u0caa\u0c82 \u2013 \u0cb8\u0ccd\u0cb5\u0cbe\u0cae\u0cbf\u0c95\u0ccd\u0c95\u0cc7\n    \u0caa\u0cbe\u0cb2\u0cbe\u0cad\u0cbf\u0cb7\u0cc7\u0c95\u0c82 \u2013 \u0cb8\u0ccd\u0cb5\u0cbe\u0cae\u0cbf\u0c95\u0ccd\u0c95\u0cc7\n    \u0cad\u0cb8\u0ccd\u0cae\u0cbe\u0cad\u0cbf\u0cb7\u0cc7\u0c95\u0c82 \u2013 \u0cb8\u0ccd\u0cb5\u0cbe\u0cae\u0cbf\u0c95\u0ccd\u0c95\u0cc7\n    \u0ca4\u0cc7\u0ca8\u0cbe\u0cad\u0cbf\u0cb7\u0cc7\u0c95\u0c82 \u2013 \u0cb8\u0ccd\u0cb5\u0cbe\u0cae\u0cbf\u0c95\u0ccd\u0c95\u0cc7\n    \u0c9a\u0c82\u0ca6\u0ca8\u0cbe\u0cad\u0cbf\u0cb7\u0cc7\u0c95\u0c82 \u2013 \u0cb8\u0ccd\u0cb5\u0cbe\u0cae\u0cbf\u0c95\u0ccd\u0c95\u0cc7\n    \u0caa\u0cc2\u0cb2\u0cbe\u0cad\u0cbf\u0cb7\u0cc7\u0c95\u0c82 \u2013 \u0cb8\u0ccd\u0cb5\u0cbe\u0cae\u0cbf\u0c95\u0ccd\u0c95\u0cc7\n    \u0caa\u0ca8\u0ccd\u0ca8\u0cc0\u0cb0\u0cbe\u0cad\u0cbf\u0cb7\u0cc7\u0c95\u0c82 \u2013 \u0cb8\u0ccd\u0cb5\u0cbe\u0cae\u0cbf\u0c95\u0ccd\u0c95\u0cc7\n    \u0caa\u0c82\u0cac\u0cbe\u0cb6\u0cbf\u0cb6\u0cc1\u0cb5\u0cc7 \u2013 \u0c85\u0caf\u0ccd\u0caf\u0caa\u0ccd\u0caa\u0cbe\n    \u0c95\u0cbe\u0ca8\u0ca8\u0cb5\u0cbe\u0cb8\u0cbe \u2013 \u0c85\u0caf\u0ccd\u0caf\u0caa\u0ccd\u0caa\u0cbe\n    \u0cb6\u0cac\u0cb0\u0cbf\u0c97\u0cbf\u0cb0\u0cc0\u0cb6\u0cbe \u2013 \u0c85\u0caf\u0ccd\u0caf\u0caa\u0ccd\u0caa\u0cbe\n    \u0caa\u0c82\u0ca6\u0cb2\u0cb0\u0cbe\u0c9c\u0cbe \u2013 \u0c85\u0caf\u0ccd\u0caf\u0caa\u0ccd\u0caa\u0cbe\n    \u0caa\u0c82\u0cac\u0cbe\u0cb5\u0cbe\u0cb8\u0cbe \u2013 \u0c85\u0caf\u0ccd\u0caf\u0caa\u0ccd\u0caa\u0cbe\n    \u0cb5\u0ca8\u0ccd\u0caa\u0cc1\u0cb2\u0cbf\u0cb5\u0cbe\u0cb9\u0ca8 \u2013 \u0c85\u0caf\u0ccd\u0caf\u0caa\u0ccd\u0caa\u0cbe\n    \u0cb8\u0cc1\u0c82\u0ca6\u0cb0\u0cb0\u0cc2\u0caa\u0cbe \u2013 \u0c85\u0caf\u0ccd\u0caf\u0caa\u0ccd\u0caa\u0cbe\n    \u0cb7\u0ca3\u0ccd\u0cae\u0cc1\u0c96\u0cb8\u0ccb\u0ca6\u0cb0 \u2013 \u0c85\u0caf\u0ccd\u0caf\u0caa\u0ccd\u0caa\u0cbe\n    \u0cae\u0ccb\u0cb9\u0cbf\u0ca8\u0cc0\u0ca4\u0ca8\u0caf\u0cbe \u2013 \u0c85\u0caf\u0ccd\u0caf\u0caa\u0ccd\u0caa\u0cbe\n    \u0c97\u0ca3\u0cc7\u0cb6\u0cb8\u0ccb\u0ca6\u0cb0 \u2013 \u0c85\u0caf\u0ccd\u0caf\u0caa\u0ccd\u0caa\u0cbe\n    \u0cb9\u0cb0\u0cbf\u0cb9\u0cb0\u0ca4\u0ca8\u0caf\u0cbe \u2013 \u0c85\u0caf\u0ccd\u0caf\u0caa\u0ccd\u0caa\u0cbe\n    \u0c85\u0ca8\u0cbe\u0ca5\u0cb0\u0c95\u0ccd\u0cb7\u0c95 \u2013 \u0c85\u0caf\u0ccd\u0caf\u0caa\u0ccd\u0caa\u0cbe\n    \u0cb8\u0ca6\u0ccd\u0c97\u0cc1\u0cb0\u0cc1\u0ca8\u0cbe\u0ca5\u0cbe \u2013 \u0c85\u0caf\u0ccd\u0caf\u0caa\u0ccd\u0caa\u0cbe\n    \u0cb8\u0ccd\u0cb5\u0cbe\u0cae\u0cbf\u0caf\u0cc7 \u2013 \u0c85\u0caf\u0ccd\u0caf\u0caa\u0ccd\u0caa\u0ccb\n    \u0c85\u0caf\u0ccd\u0caf\u0caa\u0ccd\u0caa\u0ccb \u2013 \u0cb8\u0ccd\u0cb5\u0cbe\u0cae\u0cbf\u0caf\u0cc7\n    \u0cb8\u0ccd\u0cb5\u0cbe\u0cae\u0cbf \u0cb6\u0cb0\u0ca3\u0c82 \u2013 \u0c85\u0caf\u0ccd\u0caf\u0caa\u0ccd\u0caa \u0cb6\u0cb0\u0ca3\u0c82",isAudio:!1,audioDurationSec:40,totalTime:"00:40"},{id:"9",slug:"pooja-poorvaangamu",title:"\u0caa\u0cc2\u0c9c\u0cbe \u0caa\u0cc2\u0cb0\u0ccd\u0cb5\u0cbe\u0c82\u0c97",description:"[ \u0caa\u0cc2\u0c9c\u0cbe \u0caa\u0cc2\u0cb0\u0ccd\u0cb5\u0cbe\u0c82\u0c97 - \u0caa\u0ccd\u0cb0\u0cbe\u0cb0\u0c82\u0cad \u0caa\u0ccd\u0cb0\u0cbe\u0cb0\u0ccd\u0ca5\u0ca8\u0cc6 ]\n    \n    \u0caf\u0cbe\u0cb5\u0cc1\u0ca6\u0cc7 \u0caa\u0cc2\u0c9c\u0cc6 \u0caa\u0ccd\u0cb0\u0cbe\u0cb0\u0c82\u0cad\u0cbf\u0cb8\u0cc1\u0cb5 \u0cae\u0cc1\u0ca8\u0ccd\u0ca8 \u0caa\u0cc2\u0cb0\u0ccd\u0cb5\u0cbe\u0c82\u0c97 \u0caa\u0cc2\u0c9c\u0cc6\u0caf\u0ca8\u0ccd\u0ca8\u0cc1 \u0c86\u0c9a\u0cb0\u0cbf\u0cb8\u0cac\u0cc7\u0c95\u0cc1.\n    \n    [ \u0ce7. \u0c86\u0c9a\u0cae\u0ca8 ]\n    \u0c93\u0c82 \u0c95\u0cc7\u0cb6\u0cb5\u0cbe\u0caf \u0cb8\u0ccd\u0cb5\u0cbe\u0cb9\u0cbe\n    \u0c93\u0c82 \u0ca8\u0cbe\u0cb0\u0cbe\u0caf\u0ca3\u0cbe\u0caf \u0cb8\u0ccd\u0cb5\u0cbe\u0cb9\u0cbe\n    \u0c93\u0c82 \u0cae\u0cbe\u0ca7\u0cb5\u0cbe\u0caf \u0cb8\u0ccd\u0cb5\u0cbe\u0cb9\u0cbe\n    \u0c93\u0c82 \u0c97\u0ccb\u0cb5\u0cbf\u0c82\u0ca6\u0cbe\u0caf \u0ca8\u0cae\u0c83\n    \u0c93\u0c82 \u0cb5\u0cbf\u0cb7\u0ccd\u0ca3\u0cb5\u0cc7 \u0ca8\u0cae\u0c83\n    \n    [ \u0ce8. \u0caa\u0ccd\u0cb0\u0cbe\u0ca3\u0cbe\u0caf\u0cbe\u0cae ]\n    \u0c93\u0c82 \u0cad\u0cc2\u0c83 \u0c93\u0c82 \u0cad\u0cc1\u0cb5\u0c83 \u0c93\u0c82 \u0cb8\u0cc1\u0cb5\u0c83 \u0c93\u0c82 \u0cae\u0cb9\u0c83 \u0c93\u0c82 \u0c9c\u0ca8\u0c83 \u0c93\u0c82 \u0ca4\u0caa\u0c83 \u0c93\u0c82 \u0cb8\u0ca4\u0ccd\u0caf\u0cae\u0ccd\n    \u0c93\u0c82 \u0ca4\u0ca4\u0ccd\u0cb8\u0cb5\u0cbf\u0ca4\u0cc1\u0cb0\u0ccd\u0cb5\u0cb0\u0cc7\u0ca3\u0ccd\u0caf\u0c82 \u0cad\u0cb0\u0ccd\u0c97\u0ccb \u0ca6\u0cc7\u0cb5\u0cb8\u0ccd\u0caf \u0ca7\u0cc0\u0cae\u0cb9\u0cbf \u0ca7\u0cbf\u0caf\u0ccb \u0caf\u0ccb \u0ca8\u0c83 \u0caa\u0ccd\u0cb0\u0c9a\u0ccb\u0ca6\u0caf\u0cbe\u0ca4\u0ccd\n    \n    [ \u0ce9. \u0cb8\u0c82\u0c95\u0cb2\u0ccd\u0caa ]\n    \u0cb6\u0ccd\u0cb0\u0cc0 \u0c85\u0caf\u0ccd\u0caf\u0caa\u0ccd\u0caa \u0cb8\u0ccd\u0cb5\u0cbe\u0cae\u0cbf \u0caa\u0ccd\u0cb0\u0cc0\u0ca4\u0ccd\u0caf\u0cb0\u0ccd\u0ca5\u0c82 \u0cb6\u0cc1\u0cad \u0cae\u0cc1\u0cb9\u0cc2\u0cb0\u0ccd\u0ca4\u0cc7 \u0cb6\u0ccd\u0cb0\u0cc0 \u0cae\u0cb9\u0cbe\u0c97\u0ca3\u0caa\u0ca4\u0cbf \u0caa\u0cc2\u0c9c\u0cbe\u0c82 \u0c85\u0caf\u0ccd\u0caf\u0caa\u0ccd\u0caa \u0cb8\u0ccd\u0cb5\u0cbe\u0cae\u0cbf \u0caa\u0cc2\u0c9c\u0cbe\u0c82 \u0c9a \u0c95\u0cb0\u0cbf\u0cb7\u0ccd\u0caf\u0cc7.\n    \n    [ \u0cea. \u0c95\u0cb2\u0cb6 \u0caa\u0cc2\u0c9c\u0cc6 ]\n    \u0c97\u0c82\u0c97\u0cc7 \u0c9a \u0caf\u0cae\u0cc1\u0ca8\u0cc7 \u0c9a\u0cc8\u0cb5 \u0c97\u0ccb\u0ca6\u0cbe\u0cb5\u0cb0\u0cbf \u0cb8\u0cb0\u0cb8\u0ccd\u0cb5\u0ca4\u0cc0\n    \u0ca8\u0cb0\u0ccd\u0cae\u0ca6\u0cc7 \u0cb8\u0cbf\u0c82\u0ca7\u0cc1 \u0c95\u0cbe\u0cb5\u0cc7\u0cb0\u0cc0 \u0c9c\u0cb2\u0cc7\u0cb8\u0ccd\u0cae\u0cbf\u0ca8\u0ccd \u0cb8\u0ca8\u0ccd\u0ca8\u0cbf\u0ca7\u0cbf\u0c82 \u0c95\u0cc1\u0cb0\u0cc1\n    \n    \u0c93\u0c82 \u0cb6\u0ccd\u0cb0\u0cc0 \u0cb8\u0ccd\u0cb5\u0cbe\u0cae\u0cbf\u0caf\u0cc7 \u0cb6\u0cb0\u0ca3\u0c82 \u0c85\u0caf\u0ccd\u0caf\u0caa\u0ccd\u0caa!",isAudio:!1,audioDurationSec:40,totalTime:"00:40"},{id:"10",slug:"sri-vigneshwara-ashtottara",title:"\u0cb6\u0ccd\u0cb0\u0cc0 \u0cae\u0cb9\u0cbe\u0c97\u0ca3\u0caa\u0ca4\u0cbf",description:"[ \u0cb6\u0ccd\u0cb0\u0cc0 \u0cb5\u0cbf\u0c98\u0ccd\u0ca8\u0cc7\u0cb6\u0ccd\u0cb5\u0cb0 \u0c85\u0c82\u0c97\u0caa\u0cc2\u0c9c\u0cc6 ]\n    \u0c93\u0c82 \u0caa\u0cbe\u0cb0\u0ccd\u0cb5\u0ca4\u0cc0 \u0ca8\u0c82\u0ca6\u0ca8\u0cbe\u0caf \u0ca8\u0cae\u0c83 - \u0caa\u0cbe\u0ca6\u0ccc \u0caa\u0cc2\u0c9c\u0caf\u0cbe\u0cae\u0cbf\n    \u0c93\u0c82 \u0cb6\u0ccd\u0cb0\u0cc0 \u0c97\u0ca3\u0cc7\u0cb6\u0cbe\u0caf \u0ca8\u0cae\u0c83 - \u0c97\u0cc1\u0cb2\u0ccd\u0cab\u0ccc \u0caa\u0cc2\u0c9c\u0caf\u0cbe\u0cae\u0cbf\n    \u0c93\u0c82 \u0c9c\u0ccd\u0caf\u0ccb\u0ca4\u0cbf\u0cb0\u0ccd\u0ca7\u0cbe\u0ca4\u0ccd\u0cb0\u0cc7 \u0ca8\u0cae\u0c83 - \u0c9c\u0c82\u0c98\u0cc7 \u0caa\u0cc2\u0c9c\u0caf\u0cbe\u0cae\u0cbf\n    \u0c93\u0c82 \u0c9c\u0c97\u0ca6\u0ccd\u0cb5\u0cb2\u0ccd\u0cb2\u0cad\u0cbe\u0caf \u0ca8\u0cae\u0c83 - \u0c8a\u0cb0\u0cc2 \u0caa\u0cc2\u0c9c\u0caf\u0cbe\u0cae\u0cbf\n    \u0c93\u0c82 \u0cb5\u0cbf\u0c95\u0c9f\u0cbe\u0caf \u0ca8\u0cae\u0c83 - \u0c95\u0c9f\u0cbf\u0c82 \u0caa\u0cc2\u0c9c\u0caf\u0cbe\u0cae\u0cbf\n    \u0c93\u0c82 \u0c97\u0cc1\u0cb9\u0cbe\u0c97\u0ccd\u0cb0\u0c9c\u0cbe\u0caf \u0ca8\u0cae\u0c83 - \u0c97\u0cc1\u0cb9\u0ccd\u0caf\u0c82 \u0caa\u0cc2\u0c9c\u0caf\u0cbe\u0cae\u0cbf\n    \u0c93\u0c82 \u0cae\u0cb9\u0ccb\u0ca4\u0ccd\u0ca4\u0cae\u0cbe\u0caf \u0ca8\u0cae\u0c83 - \u0cae\u0cc7\u0ca2\u0ccd\u0cb0\u0c82 \u0caa\u0cc2\u0c9c\u0caf\u0cbe\u0cae\u0cbf\n    \u0c93\u0c82 \u0c97\u0ca3\u0ca8\u0cbe\u0ca5\u0cbe\u0caf \u0ca8\u0cae\u0c83 - \u0ca8\u0cbe\u0cad\u0cbf\u0c82 \u0caa\u0cc2\u0c9c\u0caf\u0cbe\u0cae\u0cbf\n    \u0c93\u0c82 \u0c89\u0ca4\u0ccd\u0ca4\u0cae\u0cbe\u0caf \u0ca8\u0cae\u0c83 - \u0c89\u0ca6\u0cb0\u0c82 \u0caa\u0cc2\u0c9c\u0caf\u0cbe\u0cae\u0cbf\n    \u0c93\u0c82 \u0cb5\u0cbf\u0ca8\u0cbe\u0caf\u0c95\u0cbe\u0caf \u0ca8\u0cae\u0c83 - \u0cb5\u0c95\u0ccd\u0cb7\u0cb8\u0ccd\u0ca5\u0cb2\u0c82 \u0caa\u0cc2\u0c9c\u0caf\u0cbe\u0cae\u0cbf\n    \u0c93\u0c82 \u0caa\u0cbe\u0cb6\u0c9a\u0ccd\u0c9b\u0cbf\u0ca6\u0cc7 \u0ca8\u0cae\u0c83 - \u0caa\u0cbe\u0cb0\u0ccd\u0cb6\u0ccd\u0cb5\u0cc7 \u0caa\u0cc2\u0c9c\u0caf\u0cbe\u0cae\u0cbf\n    \u0c93\u0c82 \u0cb9\u0cc7\u0cb0\u0c82\u0cad\u0cbe\u0caf \u0ca8\u0cae\u0c83 - \u0cb9\u0cc3\u0ca6\u0caf\u0c82 \u0caa\u0cc2\u0c9c\u0caf\u0cbe\u0cae\u0cbf\n    \u0c93\u0c82 \u0c95\u0caa\u0cbf\u0cb2\u0cbe\u0caf \u0ca8\u0cae\u0c83 - \u0c95\u0c82\u0ca0\u0c82 \u0caa\u0cc2\u0c9c\u0caf\u0cbe\u0cae\u0cbf\n    \u0c93\u0c82 \u0cb8\u0ccd\u0c95\u0c82\u0ca7\u0cbe\u0c97\u0ccd\u0cb0\u0c9c\u0cbe\u0caf \u0ca8\u0cae\u0c83 - \u0cb8\u0ccd\u0c95\u0c82\u0ca7\u0ccc \u0caa\u0cc2\u0c9c\u0caf\u0cbe\u0cae\u0cbf\n    \u0c93\u0c82 \u0cb9\u0cb0\u0cb8\u0cc1\u0ca4\u0cbe\u0caf \u0ca8\u0cae\u0c83 - \u0cb9\u0cb8\u0ccd\u0ca4\u0cbe\u0ca8\u0ccd \u0caa\u0cc2\u0c9c\u0caf\u0cbe\u0cae\u0cbf\n    \u0c93\u0c82 \u0cac\u0ccd\u0cb0\u0cb9\u0ccd\u0cae\u0c9a\u0cbe\u0cb0\u0cbf\u0ca3\u0cc7 \u0ca8\u0cae\u0c83 - \u0cac\u0cbe\u0cb9\u0cc2\u0ca8\u0ccd \u0caa\u0cc2\u0c9c\u0caf\u0cbe\u0cae\u0cbf\n    \u0c93\u0c82 \u0cb8\u0cc1\u0cae\u0cc1\u0c96\u0cbe\u0caf \u0ca8\u0cae\u0c83 - \u0cae\u0cc1\u0c96\u0c82 \u0caa\u0cc2\u0c9c\u0caf\u0cbe\u0cae\u0cbf\n    \u0c93\u0c82 \u0c8f\u0c95\u0ca6\u0c82\u0ca4\u0cbe\u0caf \u0ca8\u0cae\u0c83 - \u0ca6\u0c82\u0ca4\u0ccc \u0caa\u0cc2\u0c9c\u0caf\u0cbe\u0cae\u0cbf\n    \u0c93\u0c82 \u0cb5\u0cbf\u0c98\u0ccd\u0ca8\u0cb9\u0c82\u0ca4\u0ccd\u0cb0\u0cc7 \u0ca8\u0cae\u0c83 - \u0ca8\u0cc7\u0ca4\u0ccd\u0cb0\u0cc7 \u0caa\u0cc2\u0c9c\u0caf\u0cbe\u0cae\u0cbf\n    \u0c93\u0c82 \u0cb6\u0cc2\u0cb0\u0ccd\u0caa\u0c95\u0cb0\u0ccd\u0ca3\u0cbe\u0caf \u0ca8\u0cae\u0c83 - \u0c95\u0cb0\u0ccd\u0ca3\u0ccc \u0caa\u0cc2\u0c9c\u0caf\u0cbe\u0cae\u0cbf\n    \u0c93\u0c82 \u0cab\u0cbe\u0cb2\u0c9a\u0c82\u0ca6\u0ccd\u0cb0\u0cbe\u0caf \u0ca8\u0cae\u0c83 - \u0c95\u0caa\u0cbe\u0cb2\u0c82 \u0caa\u0cc2\u0c9c\u0caf\u0cbe\u0cae\u0cbf\n    \u0c93\u0c82 \u0ca8\u0cbe\u0c97\u0cad\u0cb0\u0ca3\u0cbe\u0caf \u0ca8\u0cae\u0c83 - \u0ca8\u0cbe\u0cb8\u0cbf\u0c95\u0cbe\u0c82 \u0caa\u0cc2\u0c9c\u0caf\u0cbe\u0cae\u0cbf\n    \u0c93\u0c82 \u0c9a\u0cbf\u0cb0\u0c82\u0ca4\u0ca8\u0cbe\u0caf \u0ca8\u0cae\u0c83 - \u0c9a\u0cc1\u0cac\u0cc1\u0c95\u0c82 \u0caa\u0cc2\u0c9c\u0caf\u0cbe\u0cae\u0cbf\n    \u0c93\u0c82 \u0cb8\u0ccd\u0ca5\u0cc2\u0cb2\u0ccb\u0cb7\u0ccd\u0ca0\u0cbe\u0caf \u0ca8\u0cae\u0c83 - \u0c93\u0cb7\u0ccd\u0ca0\u0ccc \u0caa\u0cc2\u0c9c\u0caf\u0cbe\u0cae\u0cbf\n    \u0c93\u0c82 \u0c95\u0cbe\u0cb2\u0c96\u0c82\u0ca1\u0cbe\u0caf \u0ca8\u0cae\u0c83 - \u0c95\u0c82\u0ca0\u0ccc \u0caa\u0cc2\u0c9c\u0caf\u0cbe\u0cae\u0cbf\n    \u0c93\u0c82 \u0c95\u0caa\u0cbf\u0cb2\u0cbe\u0caf \u0ca8\u0cae\u0c83 - \u0c95\u0c9a\u0cbe\u0ca8\u0ccd \u0caa\u0cc2\u0c9c\u0caf\u0cbe\u0cae\u0cbf\n    \u0c93\u0c82 \u0cb6\u0cbf\u0cb5\u0caa\u0ccd\u0cb0\u0cbf\u0caf\u0cbe\u0caf \u0ca8\u0cae\u0c83 - \u0cb6\u0cbf\u0cb0\u0c83 \u0caa\u0cc2\u0c9c\u0caf\u0cbe\u0cae\u0cbf\n    \u0c93\u0c82 \u0cb8\u0cb0\u0ccd\u0cb5\u0cae\u0c82\u0c97\u0cb3\u0cbe \u0cb8\u0cc1\u0ca4\u0cbe\u0caf \u0ca8\u0cae\u0c83 - \u0cb8\u0cb0\u0ccd\u0cb5\u0cbe\u0ca3\u0ccd\u0caf\u0c82\u0c97\u0cbe\u0ca8\u0cbf \u0caa\u0cc2\u0c9c\u0caf\u0cbe\u0cae\u0cbf\n    \n    [ \u0cb6\u0ccd\u0cb0\u0cc0 \u0cb5\u0cbf\u0c98\u0ccd\u0ca8\u0cc7\u0cb6\u0ccd\u0cb5\u0cb0 \u0c85\u0cb7\u0ccd\u0c9f\u0ccb\u0ca4\u0ccd\u0ca4\u0cb0 \u0cb6\u0ca4 \u0ca8\u0cbe\u0cae\u0cbe\u0cb5\u0cb3\u0cbf ]\n    \u0c93\u0c82 \u0cb5\u0cbf\u0ca8\u0cbe\u0caf\u0c95\u0cbe\u0caf \u0ca8\u0cae\u0c83\n    \u0c93\u0c82 \u0cb5\u0cbf\u0c98\u0ccd\u0ca8\u0cb0\u0cbe\u0c9c\u0cbe\u0caf \u0ca8\u0cae\u0c83\n    \u0c93\u0c82 \u0c97\u0ccc\u0cb0\u0cc0\u0caa\u0cc1\u0ca4\u0ccd\u0cb0\u0cbe\u0caf \u0ca8\u0cae\u0c83\n    \u0c93\u0c82 \u0c97\u0ca3\u0cc7\u0cb6\u0ccd\u0cb5\u0cb0\u0cbe\u0caf \u0ca8\u0cae\u0c83\n    \u0c93\u0c82 \u0cb8\u0ccd\u0c95\u0c82\u0ca6\u0cbe\u0c97\u0ccd\u0cb0\u0c9c\u0cbe\u0caf \u0ca8\u0cae\u0c83\n    \u0c93\u0c82 \u0c85\u0cb5\u0ccd\u0caf\u0caf\u0cbe\u0caf \u0ca8\u0cae\u0c83\n    \u0c93\u0c82 \u0caa\u0cc2\u0cb7\u0cbe\u0caf \u0ca8\u0cae\u0c83\n    \u0c93\u0c82 \u0ca6\u0c95\u0ccd\u0cb7\u0cbe\u0caf \u0ca8\u0cae\u0c83\n    \u0c93\u0c82 \u0c85\u0ca7\u0ccd\u0caf\u0c95\u0ccd\u0cb7\u0cbe\u0caf \u0ca8\u0cae\u0c83\n    \u0c93\u0c82 \u0ca6\u0ccd\u0cb5\u0cbf\u0c9c\u0caa\u0ccd\u0cb0\u0cbf\u0caf\u0cbe\u0caf \u0ca8\u0cae\u0c83\n    \u0c93\u0c82 \u0c85\u0c97\u0ccd\u0ca8\u0cbf\u0c97\u0cb0\u0ccd\u0cad\u0c9a\u0ccd\u0c9b\u0cbf\u0ca6\u0cc7 \u0ca8\u0cae\u0c83\n    \u0c93\u0c82 \u0c87\u0c82\u0ca6\u0ccd\u0cb0\u0cb6\u0ccd\u0cb0\u0cc0\u0caa\u0ccd\u0cb0\u0ca6\u0cbe\u0caf \u0ca8\u0cae\u0c83\n    \u0c93\u0c82 \u0cb5\u0cbe\u0ca3\u0cc0\u0caa\u0ccd\u0cb0\u0ca6\u0cbe\u0caf \u0ca8\u0cae\u0c83\n    \u0c93\u0c82 \u0c85\u0cb5\u0ccd\u0caf\u0caf\u0cbe\u0caf \u0ca8\u0cae\u0c83\n    \u0c93\u0c82 \u0cb8\u0cb0\u0ccd\u0cb5\u0cb8\u0cbf\u0ca6\u0ccd\u0ca7\u0cbf\u0caa\u0ccd\u0cb0\u0ca6\u0cbe\u0caf \u0ca8\u0cae\u0c83\n    \u0c93\u0c82 \u0cb6\u0cb0\u0ccd\u0cb5\u0ca4\u0ca8\u0caf\u0cbe\u0caf \u0ca8\u0cae\u0c83\n    \u0c93\u0c82 \u0cb6\u0cb0\u0ccd\u0cb5\u0cb0\u0cc0\u0caa\u0ccd\u0cb0\u0cbf\u0caf\u0cbe\u0caf \u0ca8\u0cae\u0c83\n    \u0c93\u0c82 \u0cb8\u0cb0\u0ccd\u0cb5\u0cbe\u0ca4\u0ccd\u0cae\u0c95\u0cbe\u0caf \u0ca8\u0cae\u0c83\n    \u0c93\u0c82 \u0cb8\u0cc3\u0cb7\u0ccd\u0c9f\u0cbf\u0c95\u0cb0\u0ccd\u0ca4\u0ccd\u0cb0\u0cc7 \u0ca8\u0cae\u0c83\n    \u0c93\u0c82 \u0ca6\u0cc7\u0cb5\u0cbe\u0ca8\u0cc7\u0c95\u0cbe\u0cb0\u0ccd\u0c9a\u0cbf\u0ca4\u0cbe\u0caf \u0ca8\u0cae\u0c83\n    \u0c93\u0c82 \u0cb6\u0cbf\u0cb5\u0cbe\u0caf \u0ca8\u0cae\u0c83\n    \u0c93\u0c82 \u0cb6\u0cc1\u0ca6\u0ccd\u0ca7\u0cbe\u0caf \u0ca8\u0cae\u0c83\n    \u0c93\u0c82 \u0cac\u0cc1\u0ca6\u0ccd\u0ca7\u0cbf\u0caa\u0ccd\u0cb0\u0ca6\u0cbe\u0caf \u0ca8\u0cae\u0c83\n    \u0c93\u0c82 \u0cb6\u0cbe\u0c82\u0ca4\u0cbe\u0caf \u0ca8\u0cae\u0c83\n    \u0c93\u0c82 \u0cac\u0ccd\u0cb0\u0cb9\u0ccd\u0cae\u0c9a\u0cbe\u0cb0\u0cbf\u0ca3\u0cc7 \u0ca8\u0cae\u0c83\n    \u0c93\u0c82 \u0c97\u0c9c\u0cbe\u0ca8\u0ca8\u0cbe\u0caf \u0ca8\u0cae\u0c83\n    \u0c93\u0c82 \u0ca6\u0ccd\u0cb5\u0cc8\u0cae\u0cbe\u0ca4\u0cc1\u0cb0\u0cbe\u0caf \u0ca8\u0cae\u0c83\n    \u0c93\u0c82 \u0cae\u0cc1\u0ca8\u0cbf\u0cb8\u0ccd\u0ca4\u0cc1\u0ca4\u0ccd\u0caf\u0cbe\u0caf \u0ca8\u0cae\u0c83\n    \u0c93\u0c82 \u0cad\u0c95\u0ccd\u0ca4\u0cb5\u0cbf\u0c98\u0ccd\u0ca8\u0cb5\u0cbf\u0ca8\u0cbe\u0cb6\u0cbe\u0caf \u0ca8\u0cae\u0c83\n    \u0c93\u0c82 \u0c8f\u0c95\u0ca6\u0c82\u0ca4\u0cbe\u0caf \u0ca8\u0cae\u0c83\n    \u0c93\u0c82 \u0c9a\u0ca4\u0cc1\u0cb0\u0ccd\u0cac\u0cbe\u0cb9\u0cb5\u0cc7 \u0ca8\u0cae\u0c83\n    \u0c93\u0c82 \u0c9a\u0ca4\u0cc1\u0cb0\u0cbe\u0caf \u0ca8\u0cae\u0c83\n    \u0c93\u0c82 \u0cb6\u0c95\u0ccd\u0ca4\u0cbf\u0cb8\u0c82\u0caf\u0cc1\u0ca4\u0cbe\u0caf \u0ca8\u0cae\u0c83\n    \u0c93\u0c82 \u0cb2\u0c82\u0cac\u0ccb\u0ca6\u0cb0\u0cbe\u0caf \u0ca8\u0cae\u0c83\n    \u0c93\u0c82 \u0cb6\u0cc2\u0cb0\u0ccd\u0caa\u0c95\u0cb0\u0ccd\u0ca3\u0cbe\u0caf \u0ca8\u0cae\u0c83\n    \u0c93\u0c82 \u0cb9\u0cb0\u0cbf\u0cb0\u0ccd\u0cac\u0ccd\u0cb0\u0cb9\u0ccd\u0cae\u0cb5\u0cbf\u0ca6\u0cc7 \u0ca8\u0cae\u0c83\n    \u0c93\u0c82 \u0c89\u0ca4\u0ccd\u0ca4\u0cae\u0cbe\u0caf \u0ca8\u0cae\u0c83\n    \u0c93\u0c82 \u0c95\u0cbe\u0cb2\u0cbe\u0caf \u0ca8\u0cae\u0c83\n    \u0c93\u0c82 \u0c97\u0ccd\u0cb0\u0cb9\u0caa\u0ca4\u0caf\u0cc7 \u0ca8\u0cae\u0c83\n    \u0c93\u0c82 \u0c95\u0cbe\u0cae\u0cbf\u0ca8\u0cc7 \u0ca8\u0cae\u0c83\n    \u0c93\u0c82 \u0cb8\u0ccb\u0cae\u0cb8\u0cc2\u0cb0\u0ccd\u0caf\u0cbe\u0c97\u0ccd\u0ca8\u0cbf\u0cb2\u0ccb\u0c9a\u0ca8\u0cbe\u0caf \u0ca8\u0cae\u0c83\n    \u0c93\u0c82 \u0caa\u0cbe\u0cb6\u0cbe\u0c82\u0c95\u0cc1\u0cb6\u0ca7\u0cb0\u0cbe\u0caf \u0ca8\u0cae\u0c83\n    \u0c93\u0c82 \u0c9a\u0c82\u0ca1\u0cbe\u0caf \u0ca8\u0cae\u0c83\n    \u0c93\u0c82 \u0c97\u0cc1\u0ca3\u0cbe\u0ca4\u0cc0\u0ca4\u0cbe\u0caf \u0ca8\u0cae\u0c83\n    \u0c93\u0c82 \u0ca8\u0cbf\u0cb0\u0c82\u0c9c\u0ca8\u0cbe\u0caf \u0ca8\u0cae\u0c83\n    \u0c93\u0c82 \u0c85\u0c95\u0cb2\u0ccd\u0cae\u0cb7\u0cbe\u0caf \u0ca8\u0cae\u0c83\n    \u0c93\u0c82 \u0cb8\u0ccd\u0cb5\u0caf\u0c82\u0cb8\u0cbf\u0ca6\u0ccd\u0ca7\u0cbe\u0caf \u0ca8\u0cae\u0c83\n    \u0c93\u0c82 \u0cb8\u0cbf\u0ca6\u0ccd\u0ca7\u0cbe\u0cb0\u0ccd\u0c9a\u0cbf\u0ca4 \u0caa\u0ca6\u0cbe\u0c82\u0cac\u0cc1\u0c9c\u0cbe\u0caf \u0ca8\u0cae\u0c83\n    \u0c93\u0c82 \u0cac\u0cc0\u0c9c\u0cbe\u0caa\u0cc2\u0cb0 \u0cab\u0cb2\u0cbe\u0cb8\u0c95\u0ccd\u0ca4\u0cbe\u0caf \u0ca8\u0cae\u0c83\n    \u0c93\u0c82 \u0cb5\u0cb0\u0ca6\u0cbe\u0caf \u0ca8\u0cae\u0c83\n    \u0c93\u0c82 \u0cb6\u0cbe\u0cb6\u0ccd\u0cb5\u0ca4\u0cbe\u0caf \u0ca8\u0cae\u0c83\n    \u0c93\u0c82 \u0c95\u0cc3\u0ca4\u0cbf\u0ca8\u0cc7 \u0ca8\u0cae\u0c83\n    \u0c93\u0c82 \u0ca6\u0ccd\u0cb5\u0cbf\u0c9c\u0caa\u0ccd\u0cb0\u0cbf\u0caf\u0cbe\u0caf \u0ca8\u0cae\u0c83\n    \u0c93\u0c82 \u0cb5\u0cc0\u0ca4\u0cad\u0caf\u0cbe\u0caf \u0ca8\u0cae\u0c83\n    \u0c93\u0c82 \u0c97\u0ca6\u0cbf\u0ca8\u0cc7 \u0ca8\u0cae\u0c83\n    \u0c93\u0c82 \u0c9a\u0c95\u0ccd\u0cb0\u0cbf\u0ca3\u0cc7 \u0ca8\u0cae\u0c83\n    \u0c93\u0c82 \u0c87\u0c95\u0ccd\u0cb7\u0cc1\u0c9a\u0cbe\u0caa\u0ca7\u0cc3\u0ca4\u0cc7 \u0ca8\u0cae\u0c83\n    \u0c93\u0c82 \u0cb6\u0ccd\u0cb0\u0cc0\u0ca6\u0cbe\u0caf\u0cbf\u0ca8\u0cc7 \u0ca8\u0cae\u0c83\n    \u0c93\u0c82 \u0c85\u0c9c\u0cbe\u0caf \u0ca8\u0cae\u0c83\n    \u0c93\u0c82 \u0c89\u0ca4\u0ccd\u0caa\u0cb2\u0c95\u0cb0\u0cbe\u0caf \u0ca8\u0cae\u0c83\n    \u0c93\u0c82 \u0cb6\u0ccd\u0cb0\u0cc0\u0caa\u0ca4\u0caf\u0cc7 \u0ca8\u0cae\u0c83\n    \u0c93\u0c82 \u0cb8\u0ccd\u0ca4\u0cc1\u0ca4\u0cbf\u0cb9\u0cb0\u0ccd\u0cb7\u0cbf\u0ca4\u0cbe\u0caf \u0ca8\u0cae\u0c83\n    \u0c93\u0c82 \u0c95\u0cc1\u0cb2\u0cbe\u0ca6\u0ccd\u0cb0\u0cbf\u0cad\u0cc7\u0ca6\u0cbf\u0ca8\u0cc7 \u0ca8\u0cae\u0c83\n    \u0c93\u0c82 \u0c9c\u0c9f\u0cbf\u0cb2\u0cbe\u0caf \u0ca8\u0cae\u0c83\n    \u0c93\u0c82 \u0c95\u0cb2\u0cbf\u0c95\u0cb2\u0ccd\u0cae\u0cb7\u0ca8\u0cbe\u0cb6\u0cbe\u0caf \u0ca8\u0cae\u0c83\n    \u0c93\u0c82 \u0c9a\u0c82\u0ca6\u0ccd\u0cb0\u0c9a\u0cc2\u0ca1\u0cbe\u0cae\u0ca3\u0caf\u0cc7 \u0ca8\u0cae\u0c83\n    \u0c93\u0c82 \u0c95\u0cbe\u0c82\u0ca4\u0cbe\u0caf \u0ca8\u0cae\u0c83\n    \u0c93\u0c82 \u0caa\u0cbe\u0caa\u0cb9\u0cbe\u0cb0\u0cbf\u0ca3\u0cc7 \u0ca8\u0cae\u0c83\n    \u0c93\u0c82 \u0cb8\u0cae\u0cbe\u0cb9\u0cbf\u0ca4\u0cbe\u0caf \u0ca8\u0cae\u0c83\n    \u0c93\u0c82 \u0c86\u0cb6\u0ccd\u0cb0\u0cbf\u0ca4\u0cb6\u0ccd\u0cb0\u0cc0\u0c95\u0cb0\u0cbe\u0caf \u0ca8\u0cae\u0c83\n    \u0c93\u0c82 \u0cb8\u0ccc\u0cae\u0ccd\u0caf\u0cbe\u0caf \u0ca8\u0cae\u0c83\n    \u0c93\u0c82 \u0cad\u0c95\u0ccd\u0ca4\u0cb5\u0cbe\u0c82\u0c9b\u0cbf\u0ca4\u0ca6\u0cbe\u0caf\u0c95\u0cbe\u0caf \u0ca8\u0cae\u0c83\n    \u0c93\u0c82 \u0cb6\u0cbe\u0c82\u0ca4\u0cbe\u0caf \u0ca8\u0cae\u0c83\n    \u0c93\u0c82 \u0c95\u0cc8\u0cb5\u0cb2\u0ccd\u0caf\u0cb8\u0cc1\u0c96\u0ca6\u0cbe\u0caf \u0ca8\u0cae\u0c83\n    \u0c93\u0c82 \u0cb8\u0c9a\u0ccd\u0c9a\u0cbf\u0ca6\u0cbe\u0ca8\u0c82\u0ca6 \u0cb5\u0cbf\u0c97\u0ccd\u0cb0\u0cb9\u0cbe\u0caf \u0ca8\u0cae\u0c83\n    \u0c93\u0c82 \u0c9c\u0ccd\u0c9e\u0cbe\u0ca8\u0cbf\u0ca8\u0cc7 \u0ca8\u0cae\u0c83\n    \u0c93\u0c82 \u0ca6\u0caf\u0cbe\u0caf\u0cc1\u0ca4\u0cbe\u0caf \u0ca8\u0cae\u0c83\n    \u0c93\u0c82 \u0ca6\u0cbe\u0c82\u0ca4\u0cbe\u0caf \u0ca8\u0cae\u0c83\n    \u0c93\u0c82 \u0cac\u0ccd\u0cb0\u0cb9\u0ccd\u0cae\u0ca3\u0ccd\u0caf\u0cbe\u0caf \u0ca8\u0cae\u0c83\n    \u0c93\u0c82 \u0ca6\u0ccd\u0cb5\u0cc7\u0cb7\u0cb5\u0cbf\u0cb5\u0cb0\u0ccd\u0c9c\u0cbf\u0ca4\u0cbe\u0caf \u0ca8\u0cae\u0c83\n    \u0c93\u0c82 \u0caa\u0ccd\u0cb0\u0cae\u0ca4\u0ccd\u0ca4\u0ca6\u0cc8\u0ca4\u0ccd\u0caf \u0cad\u0caf\u0ca6\u0cbe\u0caf \u0ca8\u0cae\u0c83\n    \u0c93\u0c82 \u0cb6\u0ccd\u0cb0\u0cc0\u0c95\u0c82\u0ca0\u0cbe\u0caf \u0ca8\u0cae\u0c83\n    \u0c93\u0c82 \u0cb5\u0cbf\u0cac\u0cc1\u0ca7\u0cc7\u0cb6\u0ccd\u0cb5\u0cb0\u0cbe\u0caf \u0ca8\u0cae\u0c83\n    \u0c93\u0c82 \u0cb0\u0cae\u0cbe\u0cb0\u0ccd\u0c9a\u0cbf\u0ca4\u0cbe\u0caf \u0ca8\u0cae\u0c83\n    \u0c93\u0c82 \u0cb5\u0cbf\u0ca7\u0caf\u0cc7 \u0ca8\u0cae\u0c83\n    \u0c93\u0c82 \u0ca8\u0cbe\u0c97\u0cb0\u0cbe\u0c9c \u0caf\u0c9c\u0ccd\u0c9e\u0ccb\u0caa\u0cb5\u0cc0\u0ca4\u0cbf\u0ca8\u0cc7 \u0ca8\u0cae\u0c83\n    \u0c93\u0c82 \u0cb8\u0ccd\u0ca5\u0cc2\u0cb2\u0c95\u0c82\u0ca0\u0cbe\u0caf \u0ca8\u0cae\u0c83\n    \u0c93\u0c82 \u0cb8\u0ccd\u0cb5\u0caf\u0c82\u0c95\u0cb0\u0ccd\u0ca4\u0ccd\u0cb0\u0cc7 \u0ca8\u0cae\u0c83\n    \u0c93\u0c82 \u0cb8\u0cbe\u0cae\u0c98\u0ccb\u0cb7\u0caa\u0ccd\u0cb0\u0cbf\u0caf\u0cbe\u0caf \u0ca8\u0cae\u0c83\n    \u0c93\u0c82 \u0caa\u0cb0\u0cbe\u0caf \u0ca8\u0cae\u0c83\n    \u0c93\u0c82 \u0cb8\u0ccd\u0ca5\u0cc2\u0cb2\u0ca4\u0cc1\u0c82\u0ca1\u0cbe\u0caf \u0ca8\u0cae\u0c83\n    \u0c93\u0c82 \u0c85\u0c97\u0ccd\u0cb0\u0ca3\u0cbf\u0ca8\u0cc7 \u0ca8\u0cae\u0c83\n    \u0c93\u0c82 \u0ca7\u0cc0\u0cb0\u0cbe\u0caf \u0ca8\u0cae\u0c83\n    \u0c93\u0c82 \u0cb5\u0cbe\u0c97\u0cc0\u0cb6\u0cbe\u0caf \u0ca8\u0cae\u0c83\n    \u0c93\u0c82 \u0cb8\u0cbf\u0ca6\u0ccd\u0ca7\u0cbf\u0ca6\u0cbe\u0caf\u0c95\u0cbe\u0caf \u0ca8\u0cae\u0c83\n    \u0c93\u0c82 \u0ca6\u0cc2\u0cb0\u0ccd\u0cb5\u0cbe\u0cac\u0cbf\u0cb2\u0ccd\u0cb5\u0caa\u0ccd\u0cb0\u0cbf\u0caf\u0cbe\u0caf \u0ca8\u0cae\u0c83\n    \u0c93\u0c82 \u0c85\u0cb5\u0ccd\u0caf\u0c95\u0ccd\u0ca4\u0cae\u0cc2\u0cb0\u0ccd\u0ca4\u0caf\u0cc7 \u0ca8\u0cae\u0c83\n    \u0c93\u0c82 \u0c85\u0ca6\u0ccd\u0cad\u0cc1\u0ca4\u0cae\u0cc2\u0cb0\u0ccd\u0ca4\u0caf\u0cc7 \u0ca8\u0cae\u0c83\n    \u0c93\u0c82 \u0cb6\u0cc8\u0cb2\u0cc7\u0c82\u0ca6\u0ccd\u0cb0\u0ca4\u0ca8\u0cc1\u0c9c\u0ccb\u0ca4\u0ccd\u0cb8\u0c82\u0c97\u0cbe\u0caf \u0ca8\u0cae\u0c83\n    \u0c93\u0c82 \u0c96\u0cc7\u0cb2\u0ca8\u0ccc\u0ca4\u0ccd\u0cb8\u0cc1\u0c95\u0ccd\u0caf\u0cae\u0cbe\u0ca8\u0cb8\u0cbe\u0caf \u0ca8\u0cae\u0c83\n    \u0c93\u0c82 \u0cb8\u0ccd\u0cb5\u0cb2\u0cbe\u0cb5\u0ca3\u0ccd\u0caf \u0cb8\u0cc1\u0ca7\u0cbe\u0cb8\u0cbe\u0cb0 \u0c9c\u0cbf\u0ca4\u0cae\u0ca8\u0ccd\u0cae\u0ca5 \u0cb5\u0cbf\u0c97\u0ccd\u0cb0\u0cb9\u0cbe\u0caf \u0ca8\u0cae\u0c83\n    \u0c93\u0c82 \u0cb8\u0cae\u0cb8\u0ccd\u0ca4 \u0c9c\u0c97\u0ca6\u0cbe\u0ca7\u0cbe\u0cb0\u0cbe\u0caf \u0ca8\u0cae\u0c83\n    \u0c93\u0c82 \u0cae\u0cbe\u0caf\u0cbe\u0cb5\u0cbf\u0ca8\u0cc7 \u0ca8\u0cae\u0c83\n    \u0c93\u0c82 \u0cae\u0cc2\u0cb7\u0cbf\u0c95 \u0cb5\u0cbe\u0cb9\u0ca8\u0cbe\u0caf \u0ca8\u0cae\u0c83\n    \u0c93\u0c82 \u0cb9\u0cc3\u0cb7\u0ccd\u0c9f\u0cbe\u0caf \u0ca8\u0cae\u0c83\n    \u0c93\u0c82 \u0ca4\u0cc1\u0cb7\u0ccd\u0c9f\u0cbe\u0caf \u0ca8\u0cae\u0c83\n    \u0c93\u0c82 \u0caa\u0ccd\u0cb0\u0cb8\u0ca8\u0ccd\u0ca8\u0cbe\u0ca4\u0ccd\u0cae\u0ca8\u0cc7 \u0ca8\u0cae\u0c83\n    \u0c93\u0c82 \u0cb8\u0cb0\u0ccd\u0cb5\u0cb8\u0cbf\u0ca6\u0ccd\u0ca7\u0cbf\u0caa\u0ccd\u0cb0\u0ca6\u0cbe\u0caf\u0c95\u0cbe\u0caf \u0ca8\u0cae\u0c83",isAudio:!1,audioDurationSec:40,totalTime:"00:40"},{id:"11",slug:"sri-subramanya-ashtottara",title:"\u0cb6\u0ccd\u0cb0\u0cc0 \u0cb8\u0cc1\u0cac\u0ccd\u0cb0\u0cb9\u0ccd\u0cae\u0ca3\u0ccd\u0caf\u0cbe",description:"[ \u0cb6\u0ccd\u0cb0\u0cc0 \u0cb8\u0cc1\u0cac\u0ccd\u0cb0\u0cb9\u0ccd\u0cae\u0ca3\u0ccd\u0caf\u0cc7\u0cb6\u0ccd\u0cb5\u0cb0 \u0cb8\u0ccd\u0cb5\u0cbe\u0cae\u0cbf \u0c85\u0c82\u0c97\u0caa\u0cc2\u0c9c\u0cc6 ]\n    \u0c93\u0c82 \u0cb5\u0cbe\u0cb2\u0ccd\u0cae\u0cc0\u0c95\u0cbf \u0cad\u0cb5\u0cbe\u0caf \u0ca8\u0cae\u0c83 - \u0caa\u0cbe\u0ca6\u0ccc \u0caa\u0cc2\u0c9c\u0caf\u0cbe\u0cae\u0cbf\n    \u0c93\u0c82 \u0c9c\u0cbf\u0ca4\u0cbe\u0cb8\u0cc1\u0cb0\u0cbe\u0caf \u0ca8\u0cae\u0c83 - \u0c9c\u0cbe\u0ca8\u0cc1\u0ca8\u0cc0 \u0caa\u0cc2\u0c9c\u0caf\u0cbe\u0cae\u0cbf\n    \u0c93\u0c82 \u0cb0\u0ccc\u0ca6\u0ccd\u0cb0\u0cbe\u0caf \u0ca8\u0cae\u0c83 - \u0c9c\u0c82\u0c98\u0cc7 \u0caa\u0cc2\u0c9c\u0caf\u0cbe\u0cae\u0cbf\n    \u0c93\u0c82 \u0cad\u0caf\u0ca8\u0cbe\u0cb6\u0ca8\u0cbe\u0caf \u0ca8\u0cae\u0c83 - \u0c8a\u0cb0\u0cc2 \u0caa\u0cc2\u0c9c\u0caf\u0cbe\u0cae\u0cbf\n    \u0c93\u0c82 \u0cac\u0cbe\u0cb2\u0c97\u0ccd\u0cb0\u0cb9\u0ccb\u0c9a\u0ccd\u0c9b\u0cbe\u0c9f\u0ca8\u0cbe\u0caf \u0ca8\u0cae\u0c83 - \u0c95\u0c9f\u0cbf\u0c82 \u0caa\u0cc2\u0c9c\u0caf\u0cbe\u0cae\u0cbf\n    \u0c93\u0c82 \u0cad\u0c95\u0ccd\u0ca4\u0caa\u0cbe\u0cb2\u0ca8\u0cbe\u0caf \u0ca8\u0cae\u0c83 - \u0ca8\u0cbe\u0cad\u0cbf\u0c82 \u0caa\u0cc2\u0c9c\u0caf\u0cbe\u0cae\u0cbf\n    \u0c93\u0c82 \u0cb8\u0cb0\u0ccd\u0cb5\u0cbe\u0cad\u0cc0\u0cb7\u0ccd\u0c9f\u0caa\u0ccd\u0cb0\u0ca6\u0cbe\u0caf \u0ca8\u0cae\u0c83 - \u0cb9\u0cc3\u0ca6\u0caf\u0c82 \u0caa\u0cc2\u0c9c\u0caf\u0cbe\u0cae\u0cbf\n    \u0c93\u0c82 \u0cb5\u0cbf\u0cb6\u0cbe\u0cb2\u0cb5\u0c95\u0ccd\u0cb7\u0cb8\u0cc7 \u0ca8\u0cae\u0c83 - \u0cb5\u0c95\u0ccd\u0cb7\u0c83\u0cb8\u0ccd\u0ca5\u0cb2\u0c82 \u0caa\u0cc2\u0c9c\u0caf\u0cbe\u0cae\u0cbf\n    \u0c93\u0c82 \u0c85\u0cad\u0caf\u0caa\u0ccd\u0cb0\u0ca6\u0cbe\u0ca8 \u0caa\u0ccd\u0cb0\u0cb6\u0cb8\u0ccd\u0ca4 \u0cb9\u0cb8\u0ccd\u0ca4\u0cbe\u0caf \u0ca8\u0cae\u0c83 - \u0cac\u0cbe\u0cb9\u0cc2\u0ca8\u0ccd \u0caa\u0cc2\u0c9c\u0caf\u0cbe\u0cae\u0cbf\n    \u0c93\u0c82 \u0ca8\u0cc0\u0cb2\u0c95\u0c82\u0ca0 \u0ca4\u0ca8\u0caf\u0cbe\u0caf \u0ca8\u0cae\u0c83 - \u0c95\u0c82\u0ca0\u0c82 \u0caa\u0cc2\u0c9c\u0caf\u0cbe\u0cae\u0cbf\n    \u0c93\u0c82 \u0caa\u0ca4\u0cbf\u0ca4\u0caa\u0cbe\u0cb5\u0ca8\u0cbe\u0caf \u0ca8\u0cae\u0c83 - \u0c9a\u0cc1\u0cac\u0cc1\u0c95\u0c82 \u0caa\u0cc2\u0c9c\u0caf\u0cbe\u0cae\u0cbf\n    \u0c93\u0c82 \u0caa\u0cc1\u0cb0\u0cc1\u0cb7\u0cb6\u0ccd\u0cb0\u0cc7\u0cb7\u0ccd\u0ca0\u0cbe\u0caf \u0ca8\u0cae\u0c83 - \u0ca8\u0cbe\u0cb8\u0cbf\u0c95\u0cbe\u0c82 \u0caa\u0cc2\u0c9c\u0caf\u0cbe\u0cae\u0cbf\n    \u0c93\u0c82 \u0caa\u0cc1\u0ca3\u0ccd\u0caf\u0cae\u0cc2\u0cb0\u0ccd\u0ca4\u0caf\u0cc7 \u0ca8\u0cae\u0c83 - \u0cb6\u0ccd\u0cb0\u0cb5\u0ca3\u0cbe\u0ca8\u0cbf \u0caa\u0cc2\u0c9c\u0caf\u0cbe\u0cae\u0cbf\n    \u0c93\u0c82 \u0c95\u0cae\u0cb2\u0cb2\u0ccb\u0c9a\u0ca8\u0cbe\u0caf \u0ca8\u0cae\u0c83 - \u0ca8\u0cc7\u0ca4\u0ccd\u0cb0\u0cc7 \u0caa\u0cc2\u0c9c\u0caf\u0cbe\u0cae\u0cbf\n    \u0c93\u0c82 \u0c95\u0cb8\u0ccd\u0ca4\u0cc2\u0cb0\u0cc0 \u0ca4\u0cbf\u0cb2\u0c95\u0cbe\u0c82\u0c9a\u0cbf\u0ca4 \u0cab\u0cbe\u0cb2\u0ca8\u0cbe\u0caf \u0ca8\u0cae\u0c83 - \u0cb2\u0cb2\u0cbe\u0c9f\u0c82 \u0caa\u0cc2\u0c9c\u0caf\u0cbe\u0cae\u0cbf\n    \u0c93\u0c82 \u0cb5\u0cc7\u0ca6\u0cb5\u0cbf\u0ca6\u0cc1\u0cb7\u0cc7 \u0ca8\u0cae\u0c83 - \u0cae\u0cc1\u0c96\u0c82 \u0caa\u0cc2\u0c9c\u0caf\u0cbe\u0cae\u0cbf\n    \u0c93\u0c82 \u0ca4\u0ccd\u0cb0\u0cbf\u0cb2\u0ccb\u0c95\u0c97\u0cc1\u0cb0\u0cb5\u0cc7 \u0ca8\u0cae\u0c83 - \u0cb6\u0cbf\u0cb0\u0c83 \u0caa\u0cc2\u0c9c\u0caf\u0cbe\u0cae\u0cbf\n    \u0c93\u0c82 \u0cad\u0cb8\u0ccd\u0cae\u0ccb\u0ca6\u0ccd\u0ca7\u0cc2\u0cb3\u0cbf\u0ca4 \u0cb5\u0cbf\u0c97\u0ccd\u0cb0\u0cb9\u0cbe\u0caf \u0ca8\u0cae\u0c83 - \u0cb8\u0cb0\u0ccd\u0cb5\u0cbe\u0ca3\u0ccd\u0caf\u0c82\u0c97\u0cbe\u0ca8\u0cbf \u0caa\u0cc2\u0c9c\u0caf\u0cbe\u0cae\u0cbf\n    \n    [ \u0cb6\u0ccd\u0cb0\u0cc0 \u0cb8\u0cc1\u0cac\u0ccd\u0cb0\u0cb9\u0ccd\u0cae\u0ca3\u0ccd\u0caf \u0c85\u0cb7\u0ccd\u0c9f\u0ccb\u0ca4\u0ccd\u0ca4\u0cb0 \u0cb6\u0ca4 \u0ca8\u0cbe\u0cae\u0cbe\u0cb5\u0cb3\u0cbf ]\n    \u0c93\u0c82 \u0cb8\u0ccd\u0c95\u0c82\u0ca6\u0cbe\u0caf \u0ca8\u0cae\u0c83\n    \u0c93\u0c82 \u0c97\u0cc1\u0cb9\u0cbe\u0caf \u0ca8\u0cae\u0c83\n    \u0c93\u0c82 \u0cb7\u0ca3\u0ccd\u0cae\u0cc1\u0c96\u0cbe\u0caf \u0ca8\u0cae\u0c83\n    \u0c93\u0c82 \u0cab\u0cbe\u0cb2\u0ca8\u0cc7\u0ca4\u0ccd\u0cb0\u0cb8\u0cc1\u0ca4\u0cbe\u0caf \u0ca8\u0cae\u0c83\n    \u0c93\u0c82 \u0caa\u0ccd\u0cb0\u0cad\u0cb5\u0cc7 \u0ca8\u0cae\u0c83\n    \u0c93\u0c82 \u0caa\u0cbf\u0c82\u0c97\u0cb3\u0cbe\u0caf \u0ca8\u0cae\u0c83\n    \u0c93\u0c82 \u0c95\u0cc3\u0ca4\u0ccd\u0ca4\u0cbf\u0c95\u0cbe\u0cb8\u0cc2\u0ca8\u0cb5\u0cc7 \u0ca8\u0cae\u0c83\n    \u0c93\u0c82 \u0cb6\u0cbf\u0c96\u0cbf\u0cb5\u0cbe\u0cb9\u0cbe\u0caf \u0ca8\u0cae\u0c83\n    \u0c93\u0c82 \u0ca6\u0ccd\u0cb5\u0cbf\u0cb7\u0ca1\u0ccd\u0cad\u0cc1\u0c9c\u0cbe\u0caf \u0ca8\u0cae\u0c83\n    \u0c93\u0c82 \u0ca6\u0ccd\u0cb5\u0cbf\u0cb7\u0ca3\u0ccd\u0ca3\u0cc7\u0ca4\u0ccd\u0cb0\u0cbe\u0caf \u0ca8\u0cae\u0c83\n    \u0c93\u0c82 \u0cb6\u0c95\u0ccd\u0ca4\u0cbf\u0ca7\u0cb0\u0cbe\u0caf \u0ca8\u0cae\u0c83\n    \u0c93\u0c82 \u0caa\u0cbf\u0cb6\u0cbf\u0ca4\u0cbe\u0cb6 \u0caa\u0ccd\u0cb0\u0cad\u0c82\u0c9c\u0ca8\u0cbe\u0caf \u0ca8\u0cae\u0c83\n    \u0c93\u0c82 \u0ca4\u0cbe\u0cb0\u0c95\u0cbe\u0cb8\u0cc1\u0cb0 \u0cb8\u0c82\u0cb9\u0cbe\u0cb0\u0cbf\u0ca3\u0cc7 \u0ca8\u0cae\u0c83\n    \u0c93\u0c82 \u0cb0\u0cbe\u0c95\u0ccd\u0cb7\u0ccb\u0cac\u0cb2 \u0cb5\u0cbf\u0cae\u0cb0\u0ccd\u0ca6\u0ca8\u0cbe\u0caf \u0ca8\u0cae\u0c83\n    \u0c93\u0c82 \u0cae\u0ca4\u0ccd\u0ca4\u0cbe\u0caf \u0ca8\u0cae\u0c83\n    \u0c93\u0c82 \u0caa\u0ccd\u0cb0\u0cae\u0ca4\u0ccd\u0ca4\u0cbe\u0caf \u0ca8\u0cae\u0c83\n    \u0c93\u0c82 \u0c89\u0ca8\u0ccd\u0cae\u0ca4\u0ccd\u0ca4\u0cbe\u0caf \u0ca8\u0cae\u0c83\n    \u0c93\u0c82 \u0cb8\u0cc1\u0cb0\u0cb8\u0cc8\u0ca8\u0ccd\u0caf \u0cb8\u0cc1\u0cb0\u0c95\u0ccd\u0cb7\u0c95\u0cbe\u0caf \u0ca8\u0cae\u0c83\n    \u0c93\u0c82 \u0ca6\u0cc7\u0cb5\u0cb8\u0cc7\u0ca8\u0cbe\u0caa\u0ca4\u0caf\u0cc7 \u0ca8\u0cae\u0c83\n    \u0c93\u0c82 \u0caa\u0ccd\u0cb0\u0cbe\u0c9c\u0ccd\u0c9e\u0cbe\u0caf \u0ca8\u0cae\u0c83\n    \u0c93\u0c82 \u0c95\u0cc3\u0caa\u0cbe\u0cb2\u0cb5\u0cc7 \u0ca8\u0cae\u0c83\n    \u0c93\u0c82 \u0cad\u0c95\u0ccd\u0ca4\u0cb5\u0ca4\u0ccd\u0cb8\u0cb2\u0cbe\u0caf \u0ca8\u0cae\u0c83\n    \u0c93\u0c82 \u0c89\u0cae\u0cbe\u0cb8\u0cc1\u0ca4\u0cbe\u0caf \u0ca8\u0cae\u0c83\n    \u0c93\u0c82 \u0c95\u0cc1\u0cae\u0cbe\u0cb0\u0cbe\u0caf \u0ca8\u0cae\u0c83\n    \u0c93\u0c82 \u0c95\u0ccd\u0cb0\u0ccc\u0c82\u0c9a\u0ca7\u0cbe\u0cb0\u0ca3\u0cbe\u0caf \u0ca8\u0cae\u0c83\n    \u0c93\u0c82 \u0cb8\u0cc7\u0ca8\u0cbe\u0ca8\u0ccd\u0caf\u0cc7 \u0ca8\u0cae\u0c83\n    \u0c93\u0c82 \u0c85\u0c97\u0ccd\u0ca8\u0cbf\u0c9c\u0ca8\u0ccd\u0cae\u0ca8\u0cc7 \u0ca8\u0cae\u0c83\n    \u0c93\u0c82 \u0cb5\u0cbf\u0cb6\u0cbe\u0c96\u0cbe\u0caf \u0ca8\u0cae\u0c83\n    \u0c93\u0c82 \u0cb6\u0c82\u0c95\u0cb0\u0cbe\u0ca4\u0ccd\u0cae\u0c9c\u0cbe\u0caf \u0ca8\u0cae\u0c83\n    \u0c93\u0c82 \u0cb6\u0cbf\u0cb5\u0cb8\u0cc2\u0ca8\u0cb5\u0cc7 \u0ca8\u0cae\u0c83\n    \u0c93\u0c82 \u0c97\u0ca3\u0cb8\u0ccd\u0cb5\u0cbe\u0cae\u0cbf\u0ca8\u0cc7 \u0ca8\u0cae\u0c83\n    \u0c93\u0c82 \u0cb8\u0cb0\u0ccd\u0cb5\u0cb8\u0ccd\u0cb5\u0cbe\u0cae\u0cbf\u0ca8\u0cc7 \u0ca8\u0cae\u0c83\n    \u0c93\u0c82 \u0cb8\u0ca8\u0cbe\u0ca4\u0ca8\u0cbe\u0caf \u0ca8\u0cae\u0c83\n    \u0c93\u0c82 \u0c85\u0ca8\u0c82\u0ca4\u0cb6\u0c95\u0ccd\u0ca4\u0caf\u0cc7 \u0ca8\u0cae\u0c83\n    \u0c93\u0c82 \u0c85\u0c95\u0ccd\u0cb7\u0ccb\u0cad\u0ccd\u0caf\u0cbe\u0caf \u0ca8\u0cae\u0c83\n    \u0c93\u0c82 \u0caa\u0cbe\u0cb0\u0ccd\u0cb5\u0ca4\u0cc0\u0caa\u0ccd\u0cb0\u0cbf\u0caf\u0ca8\u0c82\u0ca6\u0ca8\u0cbe\u0caf \u0ca8\u0cae\u0c83\n    \u0c93\u0c82 \u0c97\u0c82\u0c97\u0cbe\u0cb8\u0cc1\u0ca4\u0cbe\u0caf \u0ca8\u0cae\u0c83\n    \u0c93\u0c82 \u0cb6\u0cb0\u0ccb\u0ca6\u0ccd\u0cad\u0cc2\u0ca4\u0cbe\u0caf \u0ca8\u0cae\u0c83\n    \u0c93\u0c82 \u0c86\u0cb9\u0cc2\u0ca4\u0cbe\u0caf \u0ca8\u0cae\u0c83\n    \u0c93\u0c82 \u0caa\u0cbe\u0cb5\u0c95\u0cbe\u0ca4\u0ccd\u0cae\u0c9c\u0cbe\u0caf \u0ca8\u0cae\u0c83\n    \u0c93\u0c82 \u0c9c\u0cc3\u0c82\u0cad\u0cbe\u0caf \u0ca8\u0cae\u0c83\n    \u0c93\u0c82 \u0caa\u0ccd\u0cb0\u0c9c\u0cc3\u0c82\u0cad\u0cbe\u0caf \u0ca8\u0cae\u0c83\n    \u0c93\u0c82 \u0c89\u0c9c\u0ccd\u0c9c\u0cc3\u0c82\u0cad\u0cbe\u0caf \u0ca8\u0cae\u0c83\n    \u0c93\u0c82 \u0c95\u0cae\u0cb2\u0cbe\u0cb8\u0ca8 \u0cb8\u0c82\u0cb8\u0ccd\u0ca4\u0cc1\u0ca4\u0cbe\u0caf \u0ca8\u0cae\u0c83\n    \u0c93\u0c82 \u0c8f\u0c95\u0cb5\u0cb0\u0ccd\u0ca3\u0cbe\u0caf \u0ca8\u0cae\u0c83\n    \u0c93\u0c82 \u0ca6\u0ccd\u0cb5\u0cbf\u0cb5\u0cb0\u0ccd\u0ca3\u0cbe\u0caf \u0ca8\u0cae\u0c83\n    \u0c93\u0c82 \u0ca4\u0ccd\u0cb0\u0cbf\u0cb5\u0cb0\u0ccd\u0ca3\u0cbe\u0caf \u0ca8\u0cae\u0c83\n    \u0c93\u0c82 \u0cb8\u0cc1\u0cae\u0ca8\u0ccb\u0cb9\u0cb0\u0cbe\u0caf \u0ca8\u0cae\u0c83\n    \u0c93\u0c82 \u0c9a\u0ca4\u0cc1\u0cb0\u0ccd\u0cb5\u0cb0\u0ccd\u0ca3\u0cbe\u0caf \u0ca8\u0cae\u0c83\n    \u0c93\u0c82 \u0caa\u0c82\u0c9a\u0cb5\u0cb0\u0ccd\u0ca3\u0cbe\u0caf \u0ca8\u0cae\u0c83\n    \u0c93\u0c82 \u0caa\u0ccd\u0cb0\u0c9c\u0cbe\u0caa\u0ca4\u0caf\u0cc7 \u0ca8\u0cae\u0c83\n    \u0c93\u0c82 \u0c85\u0cb9\u0c82\u0caa\u0ca4\u0caf\u0cc7 \u0ca8\u0cae\u0c83\n    \u0c93\u0c82 \u0c85\u0c97\u0ccd\u0ca8\u0cbf\u0c97\u0cb0\u0ccd\u0cad\u0cbe\u0caf \u0ca8\u0cae\u0c83\n    \u0c93\u0c82 \u0cb6\u0cae\u0cc0\u0c97\u0cb0\u0ccd\u0cad\u0cbe\u0caf \u0ca8\u0cae\u0c83\n    \u0c93\u0c82 \u0cb5\u0cbf\u0cb6\u0ccd\u0cb5\u0cb0\u0cc7\u0ca4\u0cb8\u0cc7 \u0ca8\u0cae\u0c83\n    \u0c93\u0c82 \u0cb8\u0cc1\u0cb0\u0cbe\u0cb0\u0cbf\u0c98\u0ccd\u0ca8\u0cc7 \u0ca8\u0cae\u0c83\n    \u0c93\u0c82 \u0cb9\u0cb0\u0cbf\u0ca6\u0ccd\u0cb5\u0cb0\u0ccd\u0ca3\u0cbe\u0caf \u0ca8\u0cae\u0c83\n    \u0c93\u0c82 \u0cb6\u0cc1\u0cad\u0c95\u0cb0\u0cbe\u0caf \u0ca8\u0cae\u0c83\n    \u0c93\u0c82 \u0cb5\u0c9f\u0cb5\u0cc7 \u0ca8\u0cae\u0c83\n    \u0c93\u0c82 \u0cb5\u0c9f\u0cc1\u0cb5\u0cc7\u0cb7\u0cad\u0cc3\u0ca4\u0cc7 \u0ca8\u0cae\u0c83\n    \u0c93\u0c82 \u0caa\u0cc2\u0cb7\u0ccd\u0ca3\u0cc7 \u0ca8\u0cae\u0c83\n    \u0c93\u0c82 \u0c97\u0cad\u0cb8\u0ccd\u0ca4\u0caf\u0cc7 \u0ca8\u0cae\u0c83\n    \u0c93\u0c82 \u0c97\u0cb9\u0ca8\u0cbe\u0caf \u0ca8\u0cae\u0c83\n    \u0c93\u0c82 \u0c9a\u0c82\u0ca6\u0ccd\u0cb0\u0cb5\u0cb0\u0ccd\u0ca3\u0cbe\u0caf \u0ca8\u0cae\u0c83\n    \u0c93\u0c82 \u0c95\u0cb2\u0cbe\u0ca7\u0cb0\u0cbe\u0caf \u0ca8\u0cae\u0c83\n    \u0c93\u0c82 \u0cae\u0cbe\u0caf\u0cbe\u0ca7\u0cb0\u0cbe\u0caf \u0ca8\u0cae\u0c83\n    \u0c93\u0c82 \u0c95\u0cc8\u0cb5\u0cb2\u0ccd\u0caf\u0cbe\u0caf \u0ca8\u0cae\u0c83\n    \u0c93\u0c82 \u0cb6\u0c82\u0c95\u0cb0\u0cbe\u0ca4\u0ccd\u0cae\u0ca8\u0cc7 \u0ca8\u0cae\u0c83\n    \u0c93\u0c82 \u0cb5\u0cbf\u0cb6\u0ccd\u0cb5\u0caf\u0ccb\u0ca8\u0caf\u0cc7 \u0ca8\u0cae\u0c83\n    \u0c93\u0c82 \u0c85\u0cae\u0cc7\u0caf\u0cbe\u0ca4\u0ccd\u0cae\u0ca8\u0cc7 \u0ca8\u0cae\u0c83\n    \u0c93\u0c82 \u0ca4\u0cc7\u0c9c\u0ccb\u0ca8\u0cbf\u0ca7\u0caf\u0cc7 \u0ca8\u0cae\u0c83\n    \u0c93\u0c82 \u0c85\u0ca8\u0cbe\u0cae\u0caf\u0cbe\u0caf \u0ca8\u0cae\u0c83\n    \u0c93\u0c82 \u0caa\u0cb0\u0cae\u0cc7\u0cb7\u0ccd\u0ca0\u0cbf\u0ca8\u0cc7 \u0ca8\u0cae\u0c83\n    \u0c93\u0c82 \u0caa\u0cb0\u0cac\u0ccd\u0cb0\u0cb9\u0ccd\u0cae\u0ca3\u0cc7 \u0ca8\u0cae\u0c83\n    \u0c93\u0c82 \u0cb5\u0cc7\u0ca6\u0c97\u0cb0\u0ccd\u0cad\u0cbe\u0caf \u0ca8\u0cae\u0c83\n    \u0c93\u0c82 \u0cb5\u0cbf\u0cb0\u0cbe\u0c9f\u0ccd\u0cb8\u0cc1\u0ca4\u0cbe\u0caf \u0ca8\u0cae\u0c83\n    \u0c93\u0c82 \u0caa\u0cc1\u0cb3\u0cbf\u0c82\u0ca6\u0c95\u0ca8\u0ccd\u0caf\u0cbe\u0cad\u0cb0\u0ccd\u0ca4\u0ccd\u0cb0\u0cc7 \u0ca8\u0cae\u0c83\n    \u0c93\u0c82 \u0cae\u0cb9\u0cbe\u0cb8\u0cbe\u0cb0\u0cb8\u0ccd\u0cb5\u0ca4\u0cb5\u0ccd\u0cb0\u0ca4\u0cbe\u0caf \u0ca8\u0cae\u0c83\n    \u0c93\u0c82 \u0c86\u0cb6\u0ccd\u0cb0\u0cbf\u0ca4\u0cbe\u0c96\u0cbf\u0cb2\u0ca6\u0cbe\u0ca4\u0ccd\u0cb0\u0cc7 \u0ca8\u0cae\u0c83\n    \u0c93\u0c82 \u0c9a\u0ccb\u0cb0\u0c98\u0ccd\u0ca8\u0cbe\u0caf \u0ca8\u0cae\u0c83\n    \u0c93\u0c82 \u0cb0\u0ccb\u0c97\u0ca8\u0cbe\u0cb6\u0ca8\u0cbe\u0caf \u0ca8\u0cae\u0c83\n    \u0c93\u0c82 \u0c85\u0ca8\u0c82\u0ca4\u0cae\u0cc2\u0cb0\u0ccd\u0ca4\u0caf\u0cc7 \u0ca8\u0cae\u0c83\n    \u0c93\u0c82 \u0c86\u0ca8\u0c82\u0ca6\u0cbe\u0caf \u0ca8\u0cae\u0c83\n    \u0c93\u0c82 \u0cb6\u0cbf\u0c96\u0c82\u0ca1\u0cbf\u0c95\u0cc3\u0ca4\u0c95\u0cc7\u0ca4\u0ca8\u0cbe\u0caf \u0ca8\u0cae\u0c83\n    \u0c93\u0c82 \u0ca1\u0c82\u0cad\u0cbe\u0caf \u0ca8\u0cae\u0c83\n    \u0c93\u0c82 \u0caa\u0cb0\u0cae\u0ca1\u0c82\u0cad\u0cbe\u0caf \u0ca8\u0cae\u0c83\n    \u0c93\u0c82 \u0cae\u0cb9\u0cbe\u0ca1\u0c82\u0cad\u0cbe\u0caf \u0ca8\u0cae\u0c83\n    \u0c93\u0c82 \u0cb5\u0cc3\u0cb7\u0cbe\u0c82\u0c95\u0caa\u0caf\u0cc7 \u0ca8\u0cae\u0c83\n    \u0c93\u0c82 \u0c95\u0cbe\u0cb0\u0ca3\u0ccb\u0caa\u0cbe\u0ca4\u0ccd\u0ca4\u0ca6\u0cc7\u0cb9\u0cbe\u0caf \u0ca8\u0cae\u0c83\n    \u0c93\u0c82 \u0c95\u0cbe\u0cb0\u0ca3\u0cbe\u0ca4\u0cc0\u0ca4\u0cb5\u0cbf\u0c97\u0ccd\u0cb0\u0cb9\u0cbe\u0caf \u0ca8\u0cae\u0c83\n    \u0c93\u0c82 \u0c85\u0ca8\u0cc0\u0cb6\u0ccd\u0cb5\u0cb0\u0cbe\u0caf \u0ca8\u0cae\u0c83\n    \u0c93\u0c82 \u0c85\u0cae\u0cc3\u0ca4\u0cbe\u0caf \u0ca8\u0cae\u0c83\n    \u0c93\u0c82 \u0caa\u0ccd\u0cb0\u0cbe\u0ca3\u0cbe\u0caf \u0ca8\u0cae\u0c83\n    \u0c93\u0c82 \u0caa\u0cb0\u0cbe\u0caf\u0ca3\u0cbe\u0caf \u0ca8\u0cae\u0c83\n    \u0c93\u0c82 \u0cb5\u0cbf\u0cb0\u0cc1\u0ca6\u0ccd\u0ca7\u0cb9\u0c82\u0ca4\u0ccd\u0cb0\u0cc7 \u0ca8\u0cae\u0c83\n    \u0c93\u0c82 \u0cb5\u0cc0\u0cb0\u0c98\u0ccd\u0ca8\u0cbe\u0caf \u0ca8\u0cae\u0c83\n    \u0c93\u0c82 \u0cb0\u0c95\u0ccd\u0ca4\u0cbe\u0cb6\u0ccd\u0caf\u0cbe\u0caf \u0ca8\u0cae\u0c83\n    \u0c93\u0c82 \u0cb8\u0cc1\u0cac\u0ccd\u0cb0\u0cb9\u0ccd\u0cae\u0ca3\u0ccd\u0caf\u0cbe\u0caf \u0ca8\u0cae\u0c83\n    \u0c93\u0c82 \u0c97\u0cc1\u0cb9\u0cbe\u0caf \u0ca8\u0cae\u0c83\n    \u0c93\u0c82 \u0caa\u0ccd\u0cb0\u0cc0\u0ca4\u0cbe\u0caf \u0ca8\u0cae\u0c83\n    \u0c93\u0c82 \u0cac\u0ccd\u0cb0\u0cb9\u0ccd\u0cae\u0ca3\u0ccd\u0caf\u0cbe\u0caf \u0ca8\u0cae\u0c83\n    \u0c93\u0c82 \u0cac\u0ccd\u0cb0\u0cbe\u0cb9\u0ccd\u0cae\u0ca3\u0caa\u0ccd\u0cb0\u0cbf\u0caf\u0cbe\u0caf \u0ca8\u0cae\u0c83\n    \u0c93\u0c82 \u0cb5\u0c82\u0cb6\u0cb5\u0cc3\u0ca6\u0ccd\u0ca7\u0cbf\u0c95\u0cb0\u0cbe\u0caf \u0ca8\u0cae\u0c83\n    \u0c93\u0c82 \u0cb5\u0cc7\u0ca6\u0cb5\u0cc7\u0ca6\u0ccd\u0caf\u0cbe\u0caf \u0ca8\u0cae\u0c83\n    \u0c93\u0c82 \u0c85\u0c95\u0ccd\u0cb7\u0caf\u0cab\u0cb2\u0caa\u0ccd\u0cb0\u0ca6\u0cbe\u0caf \u0ca8\u0cae\u0c83\n    \u0c93\u0c82 \u0cb8\u0cae\u0cb8\u0ccd\u0ca4\u0cb2\u0ccb\u0c95\u0cb8\u0ca6\u0ccd\u0c97\u0cc1\u0cb0\u0cb5\u0cc7 \u0ca8\u0cae\u0c83\n    \u0c93\u0c82 \u0c85\u0cb8\u0cc1\u0cb0\u0cbe\u0ca8\u0cc0\u0c95\u0cae\u0cb0\u0ccd\u0ca6\u0ca8\u0cbe\u0caf \u0ca8\u0cae\u0c83\n    \u0c93\u0c82 \u0cb5\u0cb2\u0ccd\u0cb2\u0cc0\u0ca6\u0cc7\u0cb5\u0cb8\u0cc7\u0ca8\u0cbe \u0cb8\u0cae\u0cc7\u0ca4 \u0cb6\u0ccd\u0cb0\u0cc0 \u0cb8\u0cc1\u0cac\u0ccd\u0cb0\u0cb9\u0ccd\u0cae\u0ca3\u0ccd\u0caf\u0cb8\u0ccd\u0cb5\u0cbe\u0cae\u0cbf\u0ca8\u0cc7 \u0ca8\u0cae\u0c83",isAudio:!1,audioDurationSec:40,totalTime:"00:40"},{id:"12",slug:"sri-ayyappa-ashtottara",title:"\u0cb6\u0ccd\u0cb0\u0cc0 \u0ca7\u0cb0\u0ccd\u0cae \u0cb6\u0cbe\u0cb8\u0ccd\u0ca4 (\u0cb6\u0ccd\u0cb0\u0cc0 \u0c85\u0caf\u0ccd\u0caf\u0caa\u0ccd\u0caa)",description:"[ \u0cb6\u0ccd\u0cb0\u0cc0 \u0c85\u0caf\u0ccd\u0caf\u0caa\u0ccd\u0caa \u0cb8\u0ccd\u0cb5\u0cbe\u0cae\u0cbf \u0c85\u0c82\u0c97\u0caa\u0cc2\u0c9c\u0cc6 ]\n    \u0c93\u0c82 \u0ca7\u0cb0\u0ccd\u0cae\u0cb6\u0cbe\u0cb8\u0ccd\u0ca4\u0ccd\u0cb0\u0cc7 \u0ca8\u0cae\u0c83 - \u0caa\u0cbe\u0ca6\u0ccc \u0caa\u0cc2\u0c9c\u0caf\u0cbe\u0cae\u0cbf \u0964\n    \u0c93\u0c82 \u0cb6\u0cbf\u0cb2\u0ccd\u0caa\u0cb6\u0cbe\u0cb8\u0ccd\u0ca4\u0ccd\u0cb0\u0cc7 \u0ca8\u0cae\u0c83 - \u0c97\u0cc1\u0cb2\u0ccd\u0cab\u0ccc \u0caa\u0cc2\u0c9c\u0caf\u0cbe\u0cae\u0cbf \u0964\n    \u0c93\u0c82 \u0cb5\u0cc0\u0cb0\u0cb6\u0cbe\u0cb8\u0ccd\u0ca4\u0ccd\u0cb0\u0cc7 \u0ca8\u0cae\u0c83 - \u0c9c\u0c82\u0c98\u0cc7 \u0caa\u0cc2\u0c9c\u0caf\u0cbe\u0cae\u0cbf\n    \u0c93\u0c82 \u0caf\u0ccb\u0c97\u0cb6\u0cbe\u0cb8\u0ccd\u0ca4\u0ccd\u0cb0\u0cc7 \u0ca8\u0cae\u0c83 - \u0c9c\u0cbe\u0ca8\u0cc1\u0ca8\u0cc0 \u0caa\u0cc2\u0c9c\u0caf\u0cbe\u0cae\u0cbf\n    \u0c93\u0c82 \u0cae\u0cb9\u0cbe\u0cb6\u0cbe\u0cb8\u0ccd\u0ca4\u0ccd\u0cb0\u0cc7 \u0ca8\u0cae\u0c83 - \u0c8a\u0cb0\u0cc2 \u0caa\u0cc2\u0c9c\u0caf\u0cbe\u0cae\u0cbf\n    \u0c93\u0c82 \u0cac\u0ccd\u0cb0\u0cb9\u0ccd\u0cae\u0cb6\u0cbe\u0cb8\u0ccd\u0ca4\u0ccd\u0cb0\u0cc7 \u0ca8\u0cae\u0c83 - \u0c95\u0c9f\u0cbf\u0c82 \u0caa\u0cc2\u0c9c\u0caf\u0cbe\u0cae\u0cbf\n    \u0c93\u0c82 \u0c95\u0cbe\u0cb2\u0cb6\u0cbe\u0cb8\u0ccd\u0ca4\u0ccd\u0cb0\u0cc7 \u0ca8\u0cae\u0c83 - \u0c97\u0cc1\u0cb9\u0ccd\u0caf\u0c82 \u0caa\u0cc2\u0c9c\u0caf\u0cbe\u0cae\u0cbf\n    \u0c93\u0c82 \u0cb6\u0cac\u0cb0\u0cbf\u0c97\u0cbf\u0cb0\u0cc0\u0cb6\u0cbe\u0caf \u0ca8\u0cae\u0c83 - \u0cae\u0cc7\u0ca2\u0ccd\u0cb0\u0c82 \u0caa\u0cc2\u0c9c\u0caf\u0cbe\u0cae\u0cbf\n    \u0c93\u0c82 \u0cb8\u0ca4\u0ccd\u0caf\u0cb0\u0cc2\u0caa\u0cbe\u0caf \u0ca8\u0cae\u0c83 - \u0ca8\u0cbe\u0cad\u0cbf\u0c82 \u0caa\u0cc2\u0c9c\u0caf\u0cbe\u0cae\u0cbf\n    \u0c93\u0c82 \u0cae\u0ca3\u0cbf\u0c95\u0c82\u0ca0\u0cbe\u0caf \u0ca8\u0cae\u0c83 - \u0c89\u0ca6\u0cb0\u0c82 \u0caa\u0cc2\u0c9c\u0caf\u0cbe\u0cae\u0cbf\n    \u0c93\u0c82 \u0cb5\u0cbf\u0cb7\u0ccd\u0ca3\u0cc1 \u0ca4\u0ca8\u0caf\u0cbe\u0caf \u0ca8\u0cae\u0c83 - \u0cb5\u0c95\u0ccd\u0cb7\u0c83\u0cb8\u0ccd\u0ca5\u0cb2\u0c82 \u0caa\u0cc2\u0c9c\u0caf\u0cbe\u0cae\u0cbf\n    \u0c93\u0c82 \u0cb6\u0cbf\u0cb5\u0caa\u0cc1\u0ca4\u0ccd\u0cb0\u0cbe\u0caf \u0ca8\u0cae\u0c83 - \u0caa\u0cbe\u0cb0\u0ccd\u0cb6\u0ccd\u0cb5\u0ccc \u0caa\u0cc2\u0c9c\u0caf\u0cbe\u0cae\u0cbf \u0964\n    \u0c93\u0c82 \u0cb9\u0cb0\u0cbf\u0cb9\u0cb0 \u0caa\u0cc1\u0ca4\u0ccd\u0cb0\u0cbe\u0caf \u0ca8\u0cae\u0c83 - \u0cb9\u0cc3\u0ca6\u0caf\u0c82 \u0caa\u0cc2\u0c9c\u0caf\u0cbe\u0cae\u0cbf\n    \u0c93\u0c82 \u0ca4\u0ccd\u0cb0\u0cbf\u0ca8\u0cc7\u0ca4\u0ccd\u0cb0\u0cbe\u0caf \u0ca8\u0cae\u0c83 - \u0c95\u0c82\u0ca0\u0c82 \u0caa\u0cc2\u0c9c\u0caf\u0cbe\u0cae\u0cbf\n    \u0c93\u0c82 \u0c93\u0c82\u0c95\u0cbe\u0cb0 \u0cb0\u0cc2\u0caa\u0cbe\u0caf \u0ca8\u0cae\u0c83 - \u0cb8\u0ccd\u0ca4\u0ca8\u0ccc \u0caa\u0cc2\u0c9c\u0caf\u0cbe\u0cae\u0cbf\n    \u0c93\u0c82 \u0cb5\u0cb0\u0ca6 \u0cb9\u0cb8\u0ccd\u0ca4\u0cbe\u0caf \u0ca8\u0cae\u0c83 - \u0cb9\u0cb8\u0ccd\u0ca4\u0cbe\u0ca8\u0ccd \u0caa\u0cc2\u0c9c\u0caf\u0cbe\u0cae\u0cbf\n    \u0c93\u0c82 \u0cad\u0cc0\u0cae\u0cbe\u0caf \u0ca8\u0cae\u0c83 - \u0cac\u0cbe\u0cb9\u0cc2\u0ca8\u0ccd \u0caa\u0cc2\u0c9c\u0caf\u0cbe\u0cae\u0cbf\n    \u0c93\u0c82 \u0ca4\u0cc7\u0c9c\u0cb8\u0ccd\u0cb5\u0cbf\u0ca8\u0cc7 \u0ca8\u0cae\u0c83 - \u0cae\u0cc1\u0c96\u0c82 \u0caa\u0cc2\u0c9c\u0caf\u0cbe\u0cae\u0cbf\n    \u0c93\u0c82 \u0c85\u0cb7\u0ccd\u0c9f\u0cae\u0cc2\u0cb0\u0ccd\u0ca4\u0caf\u0cc7 \u0ca8\u0cae\u0c83 - \u0ca6\u0c82\u0ca4\u0ccc \u0caa\u0cc2\u0c9c\u0caf\u0cbe\u0cae\u0cbf\n    \u0c93\u0c82 \u0cb6\u0cc1\u0cad\u0cb5\u0cc0\u0c95\u0ccd\u0cb7\u0ca3\u0cbe\u0caf \u0ca8\u0cae\u0c83 - \u0ca8\u0cc7\u0ca4\u0ccd\u0cb0\u0ccc \u0caa\u0cc2\u0c9c\u0caf\u0cbe\u0cae\u0cbf\n    \u0c93\u0c82 \u0c95\u0ccb\u0cae\u0cb2\u0cbe\u0c82\u0c97\u0cbe\u0caf \u0ca8\u0cae\u0c83 - \u0c95\u0cb0\u0ccd\u0ca3\u0c82 \u0caa\u0cc2\u0c9c\u0caf\u0cbe\u0cae\u0cbf\n    \u0c93\u0c82 \u0caa\u0cbe\u0caa \u0cb5\u0cbf\u0ca8\u0cbe\u0cb6\u0cbe\u0caf \u0ca8\u0cae\u0c83 - \u0cb2\u0cb2\u0cbe\u0c9f\u0c82 \u0caa\u0cc2\u0c9c\u0caf\u0cbe\u0cae\u0cbf\n    \u0c93\u0c82 \u0cb6\u0ca4\u0cc3\u0ca8\u0cbe\u0cb6\u0cbe\u0caf \u0ca8\u0cae\u0c83 - \u0ca8\u0cbe\u0cb8\u0cbf\u0c95\u0cbe\u0c82 \u0caa\u0cc2\u0c9c\u0caf\u0cbe\u0cae\u0cbf\n    \u0c93\u0c82 \u0caa\u0cc1\u0ca4\u0ccd\u0cb0\u0cb2\u0cbe\u0cad\u0cbe\u0caf \u0ca8\u0cae\u0c83 - \u0c9a\u0cc1\u0cac\u0cc1\u0c95\u0c82 \u0caa\u0cc2\u0c9c\u0caf\u0cbe\u0cae\u0cbf\n    \u0c93\u0c82 \u0c97\u0c9c\u0cbe\u0ca7\u0cbf\u0caa\u0cbe\u0caf \u0ca8\u0cae\u0c83 - \u0c95\u0caa\u0ccb\u0cb2\u0ccc \u0caa\u0cc2\u0c9c\u0caf\u0cbe\u0cae\u0cbf\n    \u0c93\u0c82 \u0caa\u0cb0\u0cae\u0cbe\u0ca4\u0ccd\u0cae\u0ca8\u0cc7 \u0ca8\u0cae\u0c83 - \u0cb6\u0cbf\u0cb0\u0c83 \u0caa\u0cc2\u0c9c\u0caf\u0cbe\u0cae\u0cbf\n    \u0c93\u0c82 \u0cb8\u0cb0\u0ccd\u0cb5\u0cc7\u0cb6\u0ccd\u0cb5\u0cb0\u0cbe\u0caf \u0ca8\u0cae\u0c83 - \u0cb8\u0cb0\u0ccd\u0cb5\u0cbe\u0ca3\u0ccd\u0caf\u0c82\u0c97\u0cbe\u0ca8\u0cbf \u0caa\u0cc2\u0c9c\u0caf\u0cbe\u0cae\u0cbf\n    \n    [ \u0ca7\u0ccd\u0caf\u0cbe\u0ca8\u0cae\u0ccd ]\n    \u0c95\u0cb2\u0ccd\u0cb9\u0cbe\u0cb0\u0ccb\u0c9c\u0ccd\u0c9c\u0ccd\u0cb5\u0cb2 \u0ca8\u0cc0\u0cb2\u0c95\u0cc1\u0c82\u0ca4\u0cb2 \u0cad\u0cb0\u0c82 \u0c95\u0cbe\u0cb0\u0cc1\u0ca3\u0ccd\u0caf \u0cb0\u0ca4\u0ccd\u0ca8\u0cbe\u0c95\u0cb0\u0c82\n    \u0cb9\u0cc7\u0cae\u0cbe\u0c82\u0cad\u0ccb\u0cb0\u0cc1\u0cb9 \u0cb2\u0ccb\u0c9a\u0ca8\u0c82 \u0cb9\u0cb0\u0cbf\u0cb9\u0cb0 \u0caa\u0ccd\u0cb0\u0cc7\u0cae\u0cbe\u0cb8\u0ccd\u0caa\u0ca6\u0c82 \u0caa\u0ccd\u0cb0\u0cbe\u0c82\u0cb6\u0cc1\u0c95\u0cae\u0ccd \u0964\n    \u0caa\u0ca6\u0ccd\u0cae \u0c95\u0ccd\u0cb0\u0ccb\u0ca1 \u0cb8\u0cc1\u0cb5\u0cb0\u0ccd\u0ca3 \u0cb0\u0ca4\u0ccd\u0ca8 \u0c98\u0c9f\u0cbf\u0ca4\u0c82 \u0c95\u0cc7\u0caf\u0cc2\u0cb0 \u0cb9\u0cbe\u0cb0\u0cbe\u0ca8\u0ccd\u0cb5\u0cbf\u0ca4\u0c82\n    \u0cb2\u0ccb\u0c95\u0cbe\u0cb0\u0cbe\u0ca7\u0ccd\u0caf \u0cae\u0ca7\u0cbe\u0cb0 \u0ca7\u0cb0\u0ccd\u0cae \u0ca8\u0cbf\u0cb2\u0caf\u0c82 \u0ca7\u0ccd\u0caf\u0cbe\u0caf\u0cc7\u0ca6\u0ccd\u0cad\u0cb5\u0cbe\u0ca8\u0cc0 \u0cb8\u0cc1\u0ca4\u0cae\u0ccd \u0965\n    \n    [ \u0cb6\u0ccd\u0cb0\u0cc0 \u0c85\u0caf\u0ccd\u0caf\u0caa\u0ccd\u0caa \u0c85\u0cb7\u0ccd\u0c9f\u0ccb\u0ca4\u0ccd\u0ca4\u0cb0 \u0cb6\u0ca4\u0ca8\u0cbe\u0cae\u0cbe\u0cb5\u0cb3\u0cbf ]\n    \u0c93\u0c82 \u0cae\u0cb9\u0cbe\u0cb6\u0cbe\u0cb8\u0ccd\u0ca4\u0ccd\u0cb0\u0cc7 \u0ca8\u0cae\u0c83 \u0964\n    \u0c93\u0c82 \u0cb5\u0cbf\u0cb6\u0ccd\u0cb5\u0cb6\u0cbe\u0cb8\u0ccd\u0ca4\u0ccd\u0cb0\u0cc7 \u0ca8\u0cae\u0c83 \u0964\n    \u0c93\u0c82 \u0cb2\u0ccb\u0c95\u0cb6\u0cbe\u0cb8\u0ccd\u0ca4\u0ccd\u0cb0\u0cc7 \u0ca8\u0cae\u0c83 \u0964\n    \u0c93\u0c82 \u0ca7\u0cb0\u0ccd\u0cae\u0cb6\u0cbe\u0cb8\u0ccd\u0ca4\u0ccd\u0cb0\u0cc7 \u0ca8\u0cae\u0c83 \u0964\n    \u0c93\u0c82 \u0cb5\u0cc7\u0ca6\u0cb6\u0cbe\u0cb8\u0ccd\u0ca4\u0ccd\u0cb0\u0cc7 \u0ca8\u0cae\u0c83 \u0964\n    \u0c93\u0c82 \u0c95\u0cbe\u0cb2\u0cb6\u0cbe\u0cb8\u0ccd\u0ca4\u0ccd\u0cb0\u0cc7 \u0ca8\u0cae\u0c83 \u0964\n    \u0c93\u0c82 \u0c97\u0c9c\u0cbe\u0cb0\u0cc2\u0ca2\u0cbe\u0caf \u0ca8\u0cae\u0c83 \u0964\n    \u0c93\u0c82 \u0c97\u0c9c\u0caa\u0ca4\u0caf\u0cc7 \u0ca8\u0cae\u0c83 \u0964\n    \u0c93\u0c82 \u0cb5\u0ccd\u0caf\u0cbe\u0c98\u0ccd\u0cb0\u0cbe\u0cb0\u0cc2\u0ca2\u0cbe\u0caf \u0ca8\u0cae\u0c83 \u0964\n    \u0c93\u0c82 \u0cae\u0cb9\u0cbe\u0ca6\u0ccd\u0caf\u0cc1\u0ca4\u0caf\u0cc7 \u0ca8\u0cae\u0c83 \u0964\n    \u0c93\u0c82 \u0c97\u0ccb\u0caa\u0ca4\u0ccd\u0cb0\u0cc7 \u0ca8\u0cae\u0c83 \u0964\n    \u0c93\u0c82 \u0cb5\u0cc0\u0cb0\u0caa\u0ca4\u0caf\u0cc7 \u0ca8\u0cae\u0c83 \u0964\n    \u0c93\u0c82 \u0cb8\u0cae\u0cbe\u0c96\u0ccd\u0caf\u0cbe\u0caf \u0ca8\u0cae\u0c83 \u0964\n    \u0c93\u0c82 \u0cad\u0c95\u0ccd\u0ca4\u0cb5\u0ca4\u0ccd\u0cb8\u0cb2\u0cbe\u0caf \u0ca8\u0cae\u0c83 \u0964\n    \u0c93\u0c82 \u0caa\u0cb0\u0cac\u0ccd\u0cb0\u0cb9\u0ccd\u0cae\u0ca3\u0cc7 \u0ca8\u0cae\u0c83 \u0964\n    \u0c93\u0c82 \u0c9c\u0cbf\u0cb7\u0ccd\u0ca3\u0cb5\u0cc7 \u0ca8\u0cae\u0c83 \u0964\n    \u0c93\u0c82 \u0ca4\u0cc7\u0c9c\u0cb8\u0ccd\u0cb5\u0cbf\u0ca8\u0cc7 \u0ca8\u0cae\u0c83 \u0964\n    \u0c93\u0c82 \u0cad\u0cc2\u0ca4\u0cbe\u0ca7\u0cbf\u0caa\u0ca4\u0caf\u0cc7 \u0ca8\u0cae\u0c83 \u0964\n    \u0c93\u0c82 \u0cad\u0cc2\u0ca4\u0ca6\u0cbe\u0ca4\u0ccd\u0cb0\u0cc7 \u0ca8\u0cae\u0c83 \u0964\n    \u0c93\u0c82 \u0cad\u0cc2\u0ca4\u0cc7\u0cb6\u0cbe\u0caf \u0ca8\u0cae\u0c83 \u0964\n    \u0c93\u0c82 \u0cad\u0cc0\u0cae\u0cb5\u0cbf\u0c95\u0ccd\u0cb0\u0cae\u0cbe\u0caf \u0ca8\u0cae\u0c83 \u0964\n    \u0c93\u0c82 \u0cb0\u0cae\u0ccd\u0caf\u0cbe\u0caf \u0ca8\u0cae\u0c83 \u0964\n    \u0c93\u0c82 \u0ca4\u0ccd\u0cb0\u0cbf\u0cb2\u0ccb\u0c95\u0cc7\u0cb6\u0cbe\u0caf \u0ca8\u0cae\u0c83 \u0964\n    \u0c93\u0c82 \u0ca6\u0cc7\u0cb5\u0cc7\u0cb6\u0cbe\u0caf \u0ca8\u0cae\u0c83 \u0964\n    \u0c93\u0c82 \u0caa\u0cc1\u0cb7\u0ccd\u0c95\u0cb2\u0cbe\u0caa\u0ca4\u0caf\u0cc7 \u0ca8\u0cae\u0c83 \u0964\n    \u0c93\u0c82 \u0caa\u0cb0\u0cbe\u0c95\u0ccd\u0cb0\u0cae\u0cbe\u0caf \u0ca8\u0cae\u0c83 \u0964\n    \u0c93\u0c82 \u0cb6\u0cb0\u0cbe\u0caf \u0ca8\u0cae\u0c83 \u0964\n    \u0c93\u0c82 \u0cb5\u0cb0\u0ca6\u0cbe\u0caf \u0ca8\u0cae\u0c83 \u0964\n    \u0c93\u0c82 \u0cb8\u0cc1\u0ca7\u0ca8\u0ccd\u0cb5\u0cbf\u0ca8\u0cc7 \u0ca8\u0cae\u0c83 \u0964\n    \u0c93\u0c82 \u0c95\u0cbe\u0cae\u0ca6\u0cbe\u0caf \u0ca8\u0cae\u0c83 \u0964\n    \u0c93\u0c82 \u0cb5\u0cbf\u0ca6\u0ccd\u0cb5\u0ca4\u0ccd\u0ca4\u0cae\u0cbe\u0caf \u0ca8\u0cae\u0c83 \u0964\n    \u0c93\u0c82 \u0c95\u0cbe\u0cb2\u0cb0\u0cc2\u0caa\u0cbf\u0ca3\u0cc7 \u0ca8\u0cae\u0c83 \u0964\n    \u0c93\u0c82 \u0ca6\u0cc0\u0cb0\u0ccd\u0c98\u0cbe\u0caf \u0ca8\u0cae\u0c83 \u0964\n    \u0c93\u0c82 \u0cac\u0cb9\u0cc1\u0cae\u0cc3\u0c97\u0caa\u0ccd\u0cb0\u0cbf\u0caf\u0cbe\u0caf \u0ca8\u0cae\u0c83 \u0964\n    \u0c93\u0c82 \u0cb0\u0c95\u0ccd\u0cb7\u0cbe\u0c95\u0cb0\u0cbe\u0caf \u0ca8\u0cae\u0c83 \u0964\n    \u0c93\u0c82 \u0ca6\u0cc1\u0c83\u0c96\u0cad\u0c82\u0c9c\u0ca8\u0cbe\u0caf \u0ca8\u0cae\u0c83 \u0964\n    \u0c93\u0c82 \u0c95\u0caa\u0cbe\u0cb2\u0cbf\u0ca8\u0cc7 \u0ca8\u0cae\u0c83 \u0964\n    \u0c93\u0c82 \u0c95\u0cbe\u0caf\u0c95\u0cbe\u0caf \u0ca8\u0cae\u0c83 \u0964\n    \u0c93\u0c82 \u0c95\u0cbe\u0c82\u0ca4\u0cbe\u0caf \u0ca8\u0cae\u0c83 \u0964\n    \u0c93\u0c82 \u0c95\u0caa\u0cb0\u0ccd\u0ca6\u0cbf\u0ca8\u0cc7 \u0ca8\u0cae\u0c83 \u0964\n    \u0c93\u0c82 \u0c95\u0cbe\u0cb2\u0ca8\u0cbe\u0cb6\u0c95\u0cbe\u0caf \u0ca8\u0cae\u0c83 \u0964\n    \u0c93\u0c82 \u0c95\u0cc1\u0cb0\u0c82\u0ca1\u0c95\u0cbe\u0caf \u0ca8\u0cae\u0c83 \u0964\n    \u0c93\u0c82 \u0cb9\u0cb2\u0cbe\u0caf\u0cc1\u0ca7\u0cbe\u0caf \u0ca8\u0cae\u0c83 \u0964\n    \u0c93\u0c82 \u0ca7\u0cb0\u0ccd\u0cae\u0ca6\u0cbe\u0caf \u0ca8\u0cae\u0c83 \u0964\n    \u0c93\u0c82 \u0cb8\u0c82\u0cb8\u0cbe\u0cb0\u0cb8\u0cae\u0cc1\u0ca6\u0ccd\u0cb0\u0ca4\u0cbe\u0cb0\u0c95\u0cbe\u0caf \u0ca8\u0cae\u0c83 \u0964\n    \u0c93\u0c82 \u0cb5\u0cc0\u0cb0\u0cb5\u0cb2\u0ccd\u0cb2\u0cad\u0cbe\u0caf \u0ca8\u0cae\u0c83 \u0964\n    \u0c93\u0c82 \u0cb5\u0cbf\u0cb6\u0ccd\u0cb5\u0caa\u0cbe\u0cb2\u0c95\u0cbe\u0caf \u0ca8\u0cae\u0c83 \u0964\n    \u0c93\u0c82 \u0cb5\u0c9c\u0ccd\u0cb0\u0ca7\u0cb0\u0cbe\u0caf \u0ca8\u0cae\u0c83 \u0964\n    \u0c93\u0c82 \u0cb8\u0ca4\u0ccd\u0caf\u0cb8\u0ccd\u0cb5\u0cb0\u0cc2\u0caa\u0cbf\u0ca3\u0cc7 \u0ca8\u0cae\u0c83 \u0964\n    \u0c93\u0c82 \u0cb6\u0cc2\u0cb2\u0cbf\u0ca8\u0cc7 \u0ca8\u0cae\u0c83 \u0964\n    \u0c93\u0c82 \u0c96\u0ca1\u0ccd\u0c97\u0cbf\u0ca8\u0cc7 \u0ca8\u0cae\u0c83 \u0964\n    \u0c93\u0c82 \u0cb6\u0cbe\u0c82\u0ca4\u0cbf\u0ca6\u0cbe\u0caf\u0c95\u0cbe\u0caf \u0ca8\u0cae\u0c83 \u0964\n    \u0c93\u0c82 \u0cb8\u0cc1\u0c97\u0c82\u0ca7\u0cbf\u0ca8\u0cc7 \u0ca8\u0cae\u0c83 \u0964\n    \u0c93\u0c82 \u0c97\u0c82\u0ca7\u0cae\u0cbe\u0cb2\u0ccd\u0caf\u0cbe\u0c82\u0cac\u0cb0\u0ca7\u0cb0\u0cbe\u0caf \u0ca8\u0cae\u0c83 \u0964\n    \u0c93\u0c82 \u0ca8\u0cbe\u0ca8\u0cbe\u0cb6\u0cbe\u0cb8\u0ccd\u0ca4\u0ccd\u0cb0\u0cbe\u0cb0\u0ccd\u0ca5\u0ca4\u0ca4\u0ccd\u0cb5\u0c9c\u0ccd\u0c9e\u0cbe\u0caf \u0ca8\u0cae\u0c83 \u0964\n    \u0c93\u0c82 \u0ca8\u0cbe\u0ca6\u0cb0\u0cc2\u0caa\u0cbf\u0ca3\u0cc7 \u0ca8\u0cae\u0c83 \u0964\n    \u0c93\u0c82 \u0c85\u0cae\u0cc7\u0caf\u0cbe\u0caf \u0ca8\u0cae\u0c83 \u0964\n    \u0c93\u0c82 \u0cb8\u0cb0\u0ccd\u0cb5\u0cbe\u0cad\u0cc0\u0cb7\u0ccd\u0c9f\u0caa\u0ccd\u0cb0\u0ca6\u0cbe\u0caf\u0c95\u0cbe\u0caf \u0ca8\u0cae\u0c83 \u0964\n    \u0c93\u0c82 \u0c95\u0cbf\u0cb0\u0cc0\u0c9f\u0cbf\u0ca8\u0cc7 \u0ca8\u0cae\u0c83 \u0964\n    \u0c93\u0c82 \u0cb6\u0cb0\u0cb8\u0c82\u0cb9\u0cb0\u0ccd\u0ca4\u0ccd\u0cb0\u0cc7 \u0ca8\u0cae\u0c83 \u0964\n    \u0c93\u0c82 \u0c95\u0cbe\u0cae\u0cb0\u0cc2\u0caa\u0cbe\u0caf \u0ca8\u0cae\u0c83 \u0964\n    \u0c93\u0c82 \u0cae\u0cb9\u0cbe\u0cae\u0ca4\u0caf\u0cc7 \u0ca8\u0cae\u0c83 \u0964\n    \u0c93\u0c82 \u0caa\u0cc1\u0cb7\u0ccd\u0caa\u0cac\u0cbe\u0ca3\u0cbe\u0caf \u0ca8\u0cae\u0c83 \u0964\n    \u0c93\u0c82 \u0cae\u0cb9\u0cbe\u0c95\u0cbe\u0caf\u0cbe\u0caf \u0ca8\u0cae\u0c83 \u0964\n    \u0c93\u0c82 \u0c9c\u0c9f\u0cbe\u0cb5\u0cb2\u0ccd\u0c95\u0cb2\u0ca7\u0cbe\u0cb0\u0cbf\u0ca3\u0cc7 \u0ca8\u0cae\u0c83 \u0964\n    \u0c93\u0c82 \u0c85\u0cad\u0caf\u0caa\u0ccd\u0cb0\u0ca6\u0cbe\u0caf \u0ca8\u0cae\u0c83 \u0964\n    \u0c93\u0c82 \u0ca8\u0cbe\u0ca8\u0cbe\u0cae\u0cbe\u0cb2\u0ccd\u0caf\u0cbe\u0ca8\u0cc1\u0cb2\u0cc7\u0caa\u0ca8\u0cbe\u0caf \u0ca8\u0cae\u0c83 \u0964\n    \u0c93\u0c82 \u0cae\u0cbe\u0caf\u0cbe\u0ca7\u0cb0\u0cbe\u0caf \u0ca8\u0cae\u0c83 \u0964\n    \u0c93\u0c82 \u0cae\u0cb9\u0cbe\u0ca6\u0cc7\u0cb5\u0cbe\u0caf \u0ca8\u0cae\u0c83 \u0964\n    \u0c93\u0c82 \u0cb8\u0cb0\u0ccd\u0cb5\u0cb8\u0cbe\u0c95\u0ccd\u0cb7\u0cbf\u0ca3\u0cc7 \u0ca8\u0cae\u0c83 \u0964\n    \u0c93\u0c82 \u0cae\u0c82\u0c97\u0cb3\u0caa\u0ccd\u0cb0\u0ca6\u0cbe\u0caf \u0ca8\u0cae\u0c83 \u0964\n    \u0c93\u0c82 \u0cae\u0ca4\u0ccd\u0cb8\u0ccd\u0caf\u0cb0\u0cc2\u0caa\u0cbf\u0ca3\u0cc7 \u0ca8\u0cae\u0c83 \u0964\n    \u0c93\u0c82 \u0c95\u0cc1\u0cb0\u0cc1\u0c95\u0ccd\u0cb7\u0cc7\u0ca4\u0ccd\u0cb0\u0caa\u0cbe\u0cb2\u0c95\u0cbe\u0caf \u0ca8\u0cae\u0c83 \u0964\n    \u0c93\u0c82 \u0cb8\u0cc1\u0caa\u0ccd\u0cb0\u0cb8\u0ca8\u0ccd\u0ca8\u0cbe\u0caf \u0ca8\u0cae\u0c83 \u0964\n    \u0c93\u0c82 \u0cb5\u0cbf\u0cb0\u0cc2\u0caa\u0cbe\u0c95\u0ccd\u0cb7\u0cbe\u0caf \u0ca8\u0cae\u0c83 \u0964\n    \u0c93\u0c82 \u0cad\u0cc0\u0ca4\u0cbf\u0cb9\u0cbe\u0ca8\u0cc7 \u0ca8\u0cae\u0c83 \u0964\n    \u0c93\u0c82 \u0cb6\u0ccd\u0cb0\u0cc0\u0caa\u0ccd\u0cb0\u0ca6\u0cbe\u0caf \u0ca8\u0cae\u0c83 \u0964\n    \u0c93\u0c82 \u0ca6\u0cbe\u0ca8\u0cb5\u0ca8\u0cbe\u0cb6\u0c95\u0cbe\u0caf \u0ca8\u0cae\u0c83 \u0964\n    \u0c93\u0c82 \u0cb6\u0c82\u0c95\u0cb0\u0cbe\u0caf \u0ca8\u0cae\u0c83 \u0964\n    \u0c93\u0c82 \u0cb6\u0cc2\u0cb2\u0cb9\u0cb8\u0ccd\u0ca4\u0cbe\u0caf \u0ca8\u0cae\u0c83 \u0964\n    \u0c93\u0c82 \u0caa\u0cbf\u0ca8\u0cbe\u0c95\u0cbf\u0ca8\u0cc7 \u0ca8\u0cae\u0c83 \u0964\n    \u0c93\u0c82 \u0cb5\u0cc7\u0ca6\u0cbe\u0c82\u0ca4\u0cb5\u0cc7\u0ca6\u0ccd\u0caf\u0cbe\u0caf \u0ca8\u0cae\u0c83 \u0964\n    \u0c93\u0c82 \u0cb5\u0cbf\u0cb6\u0ccd\u0cb5\u0cb0\u0cc2\u0caa\u0cbe\u0caf \u0ca8\u0cae\u0c83 \u0964\n    \u0c93\u0c82 \u0cb8\u0cb0\u0ccd\u0cb5\u0cb2\u0ccb\u0c95\u0cb9\u0cbf\u0ca4\u0cc8\u0cb7\u0cbf\u0ca3\u0cc7 \u0ca8\u0cae\u0c83 \u0964\n    \u0c93\u0c82 \u0caa\u0ccd\u0cb0\u0cb8\u0ca8\u0ccd\u0ca8\u0cae\u0cc2\u0cb0\u0ccd\u0ca4\u0caf\u0cc7 \u0ca8\u0cae\u0c83 \u0964\n    \u0c93\u0c82 \u0cad\u0c95\u0ccd\u0ca4\u0cb5\u0cb6\u0ccd\u0caf\u0cbe\u0caf \u0ca8\u0cae\u0c83 \u0964\n    \u0c93\u0c82 \u0cb6\u0cc1\u0cad\u0c95\u0cb0\u0cbe\u0caf \u0ca8\u0cae\u0c83 \u0964\n    \u0c93\u0c82 \u0c85\u0c95\u0ccd\u0cb7\u0ccb\u0cad\u0ccd\u0caf\u0cbe\u0caf \u0ca8\u0cae\u0c83 \u0964\n    \u0c93\u0c82 \u0c95\u0cc8\u0cb5\u0cb2\u0ccd\u0caf\u0ca6\u0cbe\u0caf \u0ca8\u0cae\u0c83 \u0964\n    \u0c93\u0c82 \u0ca4\u0cbe\u0cb0\u0c95\u0cbe\u0caf \u0ca8\u0cae\u0c83 \u0964\n    \u0c93\u0c82 \u0caa\u0cb0\u0cae\u0cbe\u0ca4\u0ccd\u0cae\u0ca8\u0cc7 \u0ca8\u0cae\u0c83 \u0964\n    \u0c93\u0c82 \u0c97\u0cbf\u0cb0\u0cc0\u0cb6\u0cbe\u0caf \u0ca8\u0cae\u0c83 \u0964\n    \u0c93\u0c82 \u0cad\u0c95\u0ccd\u0ca4\u0caa\u0ccb\u0cb7\u0c95\u0cbe\u0caf \u0ca8\u0cae\u0c83 \u0964\n    \u0c93\u0c82 \u0c85\u0cae\u0cc3\u0ca4\u0cc7\u0cb6\u0cbe\u0caf \u0ca8\u0cae\u0c83 \u0964\n    \u0c93\u0c82 \u0c9c\u0c97\u0ca6\u0ccd\u0cb5\u0ccd\u0caf\u0cbe\u0caa\u0cbf\u0ca8\u0cc7 \u0ca8\u0cae\u0c83 \u0964\n    \u0c93\u0c82 \u0caa\u0cc1\u0ca3\u0ccd\u0caf\u0cae\u0cc2\u0cb0\u0ccd\u0ca4\u0caf\u0cc7 \u0ca8\u0cae\u0c83 \u0964\n    \u0c93\u0c82 \u0cb8\u0c9a\u0ccd\u0c9a\u0cbf\u0ca6\u0cbe\u0ca8\u0c82\u0ca6\u0cb5\u0cbf\u0c97\u0ccd\u0cb0\u0cb9\u0cbe\u0caf \u0ca8\u0cae\u0c83 \u0964\n    \u0c93\u0c82 \u0cae\u0ca3\u0cbf\u0c95\u0c82\u0ca0\u0cbe\u0caf \u0ca8\u0cae\u0c83 \u0964\n    \u0c93\u0c82 \u0cb9\u0cb0\u0cbf\u0cb9\u0cb0\u0caa\u0cc1\u0ca4\u0ccd\u0cb0\u0cbe\u0caf \u0ca8\u0cae\u0c83 \u0964\n    \u0c93\u0c82 \u0cb6\u0cac\u0cb0\u0cc0\u0c97\u0cbf\u0cb0\u0cc0\u0cb6\u0cbe\u0caf \u0ca8\u0cae\u0c83 \u0964\n    \u0c93\u0c82 \u0cb6\u0cbe\u0cb6\u0ccd\u0cb5\u0ca4\u0cbe\u0caf \u0ca8\u0cae\u0c83 \u0964\n    \u0c93\u0c82 \u0cae\u0ccb\u0c95\u0ccd\u0cb7\u0caa\u0ccd\u0cb0\u0ca6\u0cbe\u0caf\u0c95\u0cbe\u0caf \u0ca8\u0cae\u0c83 \u0964\n    \u0c93\u0c82 \u0cb2\u0ccb\u0c95\u0caa\u0cc2\u0c9c\u0ccd\u0caf\u0cbe\u0caf \u0ca8\u0cae\u0c83 \u0964\n    \u0c93\u0c82 \u0ca7\u0cb0\u0ccd\u0cae\u0caa\u0cbe\u0cb2\u0c95\u0cbe\u0caf \u0ca8\u0cae\u0c83 \u0964\n    \u0c93\u0c82 \u0cb8\u0cb0\u0ccd\u0cb5\u0cb8\u0cbf\u0ca6\u0ccd\u0ca7\u0cbf\u0caa\u0ccd\u0cb0\u0ca6\u0cbe\u0caf\u0c95\u0cbe\u0caf \u0ca8\u0cae\u0c83 \u0964\n    \u0c93\u0c82 \u0c86\u0ca8\u0c82\u0ca6\u0ca6\u0cbe\u0caf \u0ca8\u0cae\u0c83 \u0964\n    \u0c93\u0c82 \u0cad\u0c97\u0cb5\u0ca4\u0cc7 \u0ca8\u0cae\u0c83 \u0964\n    \u0c93\u0c82 \u0cb6\u0ccd\u0cb0\u0cc0 \u0cb9\u0cb0\u0cbf\u0cb9\u0cb0\u0caa\u0cc1\u0ca4\u0ccd\u0cb0 \u0cb8\u0ccd\u0cb5\u0cbe\u0cae\u0cbf\u0ca8\u0cc7 \u0ca8\u0cae\u0c83 \u0964",isAudio:!1,audioDurationSec:40,totalTime:"00:40"},{id:"13",slug:"sri-devi-pooja",title:"\u0cb6\u0ccd\u0cb0\u0cc0 \u0ca6\u0cc7\u0cb5\u0cbf \u0caa\u0cc2\u0c9c\u0cc6",description:"[ \u0cb6\u0ccd\u0cb0\u0cc0 \u0ca6\u0cc7\u0cb5\u0cbf \u0caa\u0cc2\u0c9c\u0cc6 - \u0cae\u0cbe\u0cb3\u0cbf\u0c95\u0cbe\u0caa\u0cc1\u0cb0\u0ca4\u0ccd\u0ca4\u0cae\u0ccd\u0cae \u0caa\u0cc2\u0c9c\u0cc6 ]\n    \n    \u0cb6\u0cac\u0cb0\u0cbf\u0cae\u0cb2\u0cc6\u0caf \u0cb6\u0ccd\u0cb0\u0cc0 \u0cae\u0cbe\u0cb3\u0cbf\u0c95\u0cbe\u0caa\u0cc1\u0cb0\u0ca4\u0ccd\u0ca4\u0cae\u0ccd\u0cae (\u0ca6\u0cc7\u0cb5\u0cbf \u0cad\u0c97\u0cb5\u0ca4\u0cc0) \u0c86\u0cb0\u0cbe\u0ca7\u0ca8\u0cc6.\n    \n    [ \u0ca7\u0ccd\u0caf\u0cbe\u0ca8 ]\n    \u0cb8\u0cb0\u0ccd\u0cb5\u0cae\u0c82\u0c97\u0cb3 \u0cae\u0cbe\u0c82\u0c97\u0cb2\u0ccd\u0caf\u0cc7 \u0cb6\u0cbf\u0cb5\u0cc7 \u0cb8\u0cb0\u0ccd\u0cb5\u0cbe\u0cb0\u0ccd\u0ca5 \u0cb8\u0cbe\u0ca7\u0cbf\u0c95\u0cc7\n    \u0cb6\u0cb0\u0ca3\u0ccd\u0caf\u0cc7 \u0ca4\u0ccd\u0cb0\u0ccd\u0caf\u0c82\u0cac\u0c95\u0cc7 \u0c97\u0ccc\u0cb0\u0cc0 \u0ca8\u0cbe\u0cb0\u0cbe\u0caf\u0ca3\u0cbf \u0ca8\u0cae\u0ccb\u0cb8\u0ccd\u0ca4\u0cc1\u0ca4\u0cc7\n    \n    [ \u0cb6\u0ccd\u0cb0\u0cc0 \u0ca6\u0cc7\u0cb5\u0cbf \u0ca8\u0cbe\u0cae\u0cbe\u0cb5\u0cb3\u0cbf ]\n    \u0c93\u0c82 \u0caa\u0ccd\u0cb0\u0c95\u0cc3\u0ca4\u0ccd\u0caf\u0cc8 \u0ca8\u0cae\u0c83\n    \u0c93\u0c82 \u0cb5\u0cbf\u0c95\u0cc3\u0ca4\u0ccd\u0caf\u0cc8 \u0ca8\u0cae\u0c83\n    \u0c93\u0c82 \u0cb5\u0cbf\u0ca6\u0ccd\u0caf\u0cbe\u0caf\u0cc8 \u0ca8\u0cae\u0c83\n    \u0c93\u0c82 \u0cb6\u0ccd\u0cb0\u0ca6\u0ccd\u0ca7\u0cbe\u0caf\u0cc8 \u0ca8\u0cae\u0c83\n    \u0c93\u0c82 \u0caa\u0ca6\u0ccd\u0cae\u0cbe\u0caf\u0cc8 \u0ca8\u0cae\u0c83\n    \u0c93\u0c82 \u0cb6\u0cc1\u0c9a\u0caf\u0cc7 \u0ca8\u0cae\u0c83\n    \u0c93\u0c82 \u0cb2\u0c95\u0ccd\u0cb7\u0ccd\u0cae\u0ccd\u0caf\u0cc8 \u0ca8\u0cae\u0c83\n    \u0c93\u0c82 \u0c95\u0cbe\u0cae\u0cbe\u0c95\u0ccd\u0cb7\u0ccd\u0caf\u0cc8 \u0ca8\u0cae\u0c83\n    \u0c93\u0c82 \u0cb6\u0ccd\u0cb0\u0cc0 \u0cae\u0cbe\u0cb3\u0cbf\u0c95\u0cbe\u0caa\u0cc1\u0cb0\u0ca4\u0ccd\u0ca4\u0cae\u0ccd\u0cae\u0cbe\u0caf\u0cc8 \u0ca8\u0cae\u0c83\n    \n    \u0cae\u0cbe\u0cb3\u0cbf\u0c95\u0cbe\u0caa\u0cc1\u0cb0\u0ca4\u0ccd\u0ca4\u0cae\u0ccd\u0cae \u0ca6\u0cc7\u0cb5\u0cbf\u0caf\u0cc7 \u0cb6\u0cb0\u0ca3\u0cae\u0caf\u0ccd\u0caf\u0caa\u0ccd\u0caa!",isAudio:!1,audioDurationSec:40,totalTime:"00:40"},{id:"14",slug:"sri-gomatha-pooja",title:"\u0cb6\u0ccd\u0cb0\u0cc0 \u0c97\u0ccb\u0cae\u0cbe\u0ca4\u0cbe \u0caa\u0cc2\u0c9c\u0cc6",description:"[ \u0cb6\u0ccd\u0cb0\u0cc0 \u0c97\u0ccb\u0cae\u0cbe\u0ca4\u0cbe \u0caa\u0cc2\u0c9c\u0cc6 - \u0c95\u0cbe\u0cae\u0ca7\u0cc7\u0ca8\u0cc1 \u0c86\u0cb0\u0cbe\u0ca7\u0ca8\u0cc6 ]\n    \n    \u0c97\u0ccb\u0cb5\u0cbf\u0ca8\u0cb2\u0ccd\u0cb2\u0cbf \u0cae\u0cc1\u0c95\u0ccd\u0c95\u0ccb\u0c9f\u0cbf \u0ca6\u0cc7\u0cb5\u0ca4\u0cc6\u0c97\u0cb3\u0cc1 \u0ca8\u0cc6\u0cb2\u0cc6\u0cb8\u0cbf\u0ca6\u0ccd\u0ca6\u0cbe\u0cb0\u0cc6. \u0c97\u0ccb\u0caa\u0cc2\u0c9c\u0cc6 \u0cb8\u0c95\u0cb2 \u0caa\u0cbe\u0caa\u0ca8\u0cbe\u0cb6\u0c95 \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0caa\u0cc1\u0ca3\u0ccd\u0caf\u0ca6\u0cbe\u0caf\u0c95.\n    \n    [ \u0caa\u0ccd\u0cb0\u0cbe\u0cb0\u0ccd\u0ca5\u0ca8\u0cc6 ]\n    \u0cb8\u0cb0\u0ccd\u0cb5\u0ca6\u0cc7\u0cb5\u0cae\u0caf\u0cc7 \u0ca6\u0cc7\u0cb5\u0cbf \u0cb8\u0cb0\u0ccd\u0cb5\u0ca4\u0cc0\u0cb0\u0ccd\u0ca5\u0cc0\u0c95\u0cc3\u0ca4\u0cbe\u0cb8\u0ca8\u0cc7\n    \u0cae\u0cbe\u0ca4\u0cb0\u0ccd\u0cae\u0cae\u0cbe\u0cad\u0cbf\u0cb2\u0cb7\u0cbf\u0ca4\u0c82 \u0cb8\u0cab\u0cb2\u0c82 \u0c95\u0cc1\u0cb0\u0cc1 \u0ca8\u0c82\u0ca6\u0cbf\u0ca8\u0cbf\n    \n    [ \u0caa\u0cc2\u0c9c\u0cbe \u0cb8\u0cae\u0cb0\u0ccd\u0caa\u0ca3\u0cc6 ]\n    \u0c93\u0c82 \u0cb6\u0ccd\u0cb0\u0cc0 \u0c97\u0ccb\u0cae\u0cbe\u0ca4\u0ccd\u0cb0\u0cc7 \u0ca8\u0cae\u0c83 - \u0ca7\u0ccd\u0caf\u0cbe\u0ca8\u0c82 \u0cb8\u0cae\u0cb0\u0ccd\u0caa\u0caf\u0cbe\u0cae\u0cbf\n    \u0c93\u0c82 \u0cb6\u0ccd\u0cb0\u0cc0 \u0c95\u0cbe\u0cae\u0ca7\u0cc7\u0ca8\u0cb5\u0cc7 \u0ca8\u0cae\u0c83 - \u0c86\u0cb8\u0ca8\u0c82 \u0cb8\u0cae\u0cb0\u0ccd\u0caa\u0caf\u0cbe\u0cae\u0cbf\n    \u0c93\u0c82 \u0cb6\u0ccd\u0cb0\u0cc0 \u0cb8\u0cc1\u0cb0\u0cad\u0caf\u0cc7 \u0ca8\u0cae\u0c83 - \u0caa\u0cbe\u0ca6\u0ccd\u0caf\u0c82 \u0cb8\u0cae\u0cb0\u0ccd\u0caa\u0caf\u0cbe\u0cae\u0cbf\n    \u0c93\u0c82 \u0cb6\u0ccd\u0cb0\u0cc0 \u0c95\u0cb2\u0ccd\u0caf\u0cbe\u0ca3\u0ccd\u0caf\u0cc8 \u0ca8\u0cae\u0c83 - \u0caa\u0cc1\u0cb7\u0ccd\u0caa\u0cbe\u0ca3\u0cbf \u0cb8\u0cae\u0cb0\u0ccd\u0caa\u0caf\u0cbe\u0cae\u0cbf\n    \u0c93\u0c82 \u0cb6\u0ccd\u0cb0\u0cc0 \u0c97\u0ccb\u0cae\u0cbe\u0ca4\u0ccd\u0cb0\u0cc7 \u0ca8\u0cae\u0c83 - \u0ca8\u0cc8\u0cb5\u0cc7\u0ca6\u0ccd\u0caf\u0c82 \u0cb8\u0cae\u0cb0\u0ccd\u0caa\u0caf\u0cbe\u0cae\u0cbf\n    \u0c93\u0c82 \u0cb6\u0ccd\u0cb0\u0cc0 \u0c97\u0ccb\u0cae\u0cbe\u0ca4\u0ccd\u0cb0\u0cc7 \u0ca8\u0cae\u0c83 - \u0c95\u0cb0\u0ccd\u0caa\u0cc2\u0cb0 \u0ca8\u0cc0\u0cb0\u0cbe\u0c9c\u0ca8\u0c82 \u0cb8\u0cae\u0cb0\u0ccd\u0caa\u0caf\u0cbe\u0cae\u0cbf\n    \n    \u0c97\u0ccb\u0cae\u0cbe\u0ca4\u0cc6\u0caf\u0cc7 \u0ca8\u0cae\u0ccb \u0ca8\u0cae\u0c83!",isAudio:!1,audioDurationSec:40,totalTime:"00:40"},{id:"15",slug:"ashtottaramulu",title:"\u0c85\u0cb7\u0ccd\u0c9f\u0ccb\u0ca4\u0ccd\u0ca4\u0cb0\u0c97\u0cb3\u0cc1",description:"[ \u0c85\u0cb7\u0ccd\u0c9f\u0ccb\u0ca4\u0ccd\u0ca4\u0cb0 \u0cb6\u0ca4 \u0ca8\u0cbe\u0cae\u0cbe\u0cb5\u0cb3\u0cbf\u0c97\u0cb3 \u0cb8\u0c82\u0c97\u0ccd\u0cb0\u0cb9 ]\n    \n    \u0c85\u0caf\u0ccd\u0caf\u0caa\u0ccd\u0caa \u0caa\u0cc2\u0c9c\u0cc6\u0caf\u0cb2\u0ccd\u0cb2\u0cbf \u0caa\u0ca0\u0cbf\u0cb8\u0cc1\u0cb5 \u0caa\u0ccd\u0cb0\u0cae\u0cc1\u0c96 \u0c85\u0cb7\u0ccd\u0c9f\u0ccb\u0ca4\u0ccd\u0ca4\u0cb0\u0c97\u0cb3\u0cc1:\n    \n    \u0ce7. \u0cb6\u0ccd\u0cb0\u0cc0 \u0cae\u0cb9\u0cbe\u0c97\u0ca3\u0caa\u0ca4\u0cbf \u0c85\u0cb7\u0ccd\u0c9f\u0ccb\u0ca4\u0ccd\u0ca4\u0cb0 (\u0c93\u0c82 \u0c97\u0c9c\u0cbe\u0ca8\u0ca8\u0cbe\u0caf \u0ca8\u0cae\u0c83...)\n    \u0ce8. \u0cb6\u0ccd\u0cb0\u0cc0 \u0cb8\u0cc1\u0cac\u0ccd\u0cb0\u0cb9\u0ccd\u0cae\u0ca3\u0ccd\u0caf \u0c85\u0cb7\u0ccd\u0c9f\u0ccb\u0ca4\u0ccd\u0ca4\u0cb0 (\u0c93\u0c82 \u0cb8\u0ccd\u0c95\u0c82\u0ca6\u0cbe\u0caf \u0ca8\u0cae\u0c83...)\n    \u0ce9. \u0cb6\u0ccd\u0cb0\u0cc0 \u0c85\u0caf\u0ccd\u0caf\u0caa\u0ccd\u0caa \u0c85\u0cb7\u0ccd\u0c9f\u0ccb\u0ca4\u0ccd\u0ca4\u0cb0 (\u0c93\u0c82 \u0cae\u0cb9\u0cbe\u0cb6\u0cbe\u0cb8\u0ccd\u0ca4\u0ccd\u0cb0\u0cc7 \u0ca8\u0cae\u0c83...)\n    \u0cea. \u0cb6\u0ccd\u0cb0\u0cc0 \u0ca6\u0cc7\u0cb5\u0cc0 \u0c85\u0cb7\u0ccd\u0c9f\u0ccb\u0ca4\u0ccd\u0ca4\u0cb0\n    \u0ceb. \u0cb6\u0ccd\u0cb0\u0cc0 \u0cb6\u0cbf\u0cb5 \u0c85\u0cb7\u0ccd\u0c9f\u0ccb\u0ca4\u0ccd\u0ca4\u0cb0\n    \n    \u0cb8\u0ccd\u0cb5\u0cbe\u0cae\u0cbf\u0caf\u0cc7 \u0cb6\u0cb0\u0ca3\u0c82 \u0c85\u0caf\u0ccd\u0caf\u0caa\u0ccd\u0caa!",isAudio:!1,audioDurationSec:40,totalTime:"00:40"},{id:"16",slug:"sri-ayyappa-sahasranamam",title:"\u0cb6\u0ccd\u0cb0\u0cc0 \u0cb9\u0cb0\u0cbf\u0cb9\u0cb0\u0caa\u0cc1\u0ca4\u0ccd\u0cb0 \u0cb8\u0cb9\u0cb8\u0ccd\u0cb0\u0ca8\u0cbe\u0cae\u0cbe\u0cb5\u0cb3\u0cc0",description:"",isAudio:!1,audioDurationSec:40,totalTime:"00:40"},{id:"17",slug:"ayyappa-harathi",title:"\u0c85\u0caf\u0ccd\u0caf\u0caa\u0ccd\u0caa \u0c86\u0cb0\u0ca4\u0cbf",description:"\u0cb6\u0c82\u0c95\u0cb0\u0cbe\u0caf \u0cb6\u0c82\u0c95\u0cb0\u0cbe\u0caf \u0cb6\u0c82\u0c95\u0cb0\u0cbe\u0caf \u0cae\u0c82\u0c97\u0cb3\u0cae\u0ccd \u0964\n    \u0cb6\u0c82\u0c95\u0cb0\u0cc0 \u0cae\u0ca8\u0ccb\u0cb9\u0cb0\u0cbe\u0caf \u0cb6\u0cbe\u0cb6\u0ccd\u0cb5\u0ca4\u0cbe\u0caf \u0cae\u0c82\u0c97\u0cb3\u0cae\u0ccd \u0965\n    \n    \u0c97\u0cc1\u0cb0\u0cc1\u0cb5\u0cb0\u0cbe\u0caf \u0cae\u0c82\u0c97\u0cb3\u0c82 \u0ca6\u0ca4\u0ccd\u0ca4\u0cbe\u0ca4\u0ccd\u0cb0\u0cc7\u0caf \u0cae\u0c82\u0c97\u0cb3\u0cae\u0ccd \u0964\n    \u0cb0\u0cbe\u0c9c\u0cb0\u0cbe\u0cae \u0cae\u0c82\u0c97\u0cb3\u0c82 \u0cb0\u0cbe\u0cae\u0c95\u0cc3\u0cb7\u0ccd\u0ca3 \u0cae\u0c82\u0c97\u0cb3\u0cae\u0ccd \u0965\n    \n    \u0c85\u0caf\u0ccd\u0caf\u0caa\u0ccd\u0caa \u0cae\u0c82\u0c97\u0cb3\u0c82 \u0cae\u0ca3\u0cbf\u0c95\u0c82\u0ca0 \u0cae\u0c82\u0c97\u0cb3\u0cae\u0ccd \u0964\n    \u0cb6\u0cac\u0cb0\u0cc0\u0cb6 \u0cae\u0c82\u0c97\u0cb3\u0c82 \u0cb6\u0cbe\u0cb8\u0ccd\u0ca4\u0cbe\u0caf \u0cae\u0c82\u0c97\u0cb3\u0cae\u0ccd \u0965\n    \n    \u0cae\u0c82\u0c97\u0cb3\u0c82 \u0cae\u0c82\u0c97\u0cb3\u0c82 \u0ca8\u0cbf\u0ca4\u0ccd\u0caf\u0c9c\u0caf \u0cae\u0c82\u0c97\u0cb3\u0cae\u0ccd \u0964\n    \u0cae\u0c82\u0c97\u0cb3\u0c82 \u0cae\u0c82\u0c97\u0cb3\u0c82 \u0ca8\u0cbf\u0ca4\u0ccd\u0caf\u0cb6\u0cc1\u0cad \u0cae\u0c82\u0c97\u0cb3\u0cae\u0ccd \u0965\n    \n    \u0c93\u0c82 \u0cb6\u0ccd\u0cb0\u0cc0 \u0cb8\u0ccd\u0cb5\u0cbe\u0cae\u0cbf\u0caf\u0cc7 \u0cb6\u0cb0\u0ca3\u0c82 \u0c85\u0caf\u0ccd\u0caf\u0caa\u0ccd\u0caa\n    \u0c93\u0c82 \u0cb6\u0ccd\u0cb0\u0cc0 \u0cb8\u0ccd\u0cb5\u0cbe\u0cae\u0cbf\u0caf\u0cc7 \u0cb6\u0cb0\u0ca3\u0c82 \u0c85\u0caf\u0ccd\u0caf\u0caa\u0ccd\u0caa\n    \u0c93\u0c82 \u0cb6\u0ccd\u0cb0\u0cc0 \u0cb8\u0ccd\u0cb5\u0cbe\u0cae\u0cbf\u0caf\u0cc7 \u0cb6\u0cb0\u0ca3\u0c82 \u0c85\u0caf\u0ccd\u0caf\u0caa\u0ccd\u0caa",isAudio:!1,audioDurationSec:40,totalTime:"00:40"},{id:"18",slug:"mantrapushpam",title:"\u0cae\u0c82\u0ca4\u0ccd\u0cb0\u0caa\u0cc1\u0cb7\u0ccd\u0caa\u0c82",description:"\u0c93\u0c82 \u0cb0\u0cbe\u0c9c\u0cbe\u0ca7\u0cbf\u0cb0\u0cbe\u0c9c\u0cbe\u0caf \u0caa\u0ccd\u0cb0\u0cb8\u0cb9\u0ccd\u0caf \u0cb8\u0cbe\u0cb9\u0cbf\u0ca8\u0cc7 \u0ca8\u0cae\u0ccb \u0cb5\u0caf\u0c82 \u0cb5\u0cc8\u0cb6\u0ccd\u0cb0\u0cb5\u0ca3\u0cbe\u0caf \u0c95\u0cc1\u0cb0\u0ccd\u0cae\u0cb9\u0cc7 \u0964\n    \u0cb8 \u0cae\u0cc7 \u0c95\u0cbe\u0cae\u0cbe\u0ca8\u0ccd \u0c95\u0cbe\u0cae\u0c95\u0cbe\u0cae\u0cbe\u0caf \u0cae\u0cb9\u0ccd\u0caf\u0c82 \u0c95\u0cbe\u0cae\u0cc7\u0cb6\u0ccd\u0cb5\u0cb0\u0ccb \u0cb5\u0cc8\u0cb6\u0ccd\u0cb0\u0cb5\u0ca3\u0ccb \u0ca6\u0ca6\u0cbe\u0ca4\u0cc1 \u0964\n    \u0c95\u0cc1\u0cac\u0cc7\u0cb0\u0cbe\u0caf \u0cb5\u0cc8\u0cb6\u0ccd\u0cb0\u0cb5\u0ca3\u0cbe\u0caf \u0cae\u0cb9\u0cbe\u0cb0\u0cbe\u0c9c\u0cbe\u0caf \u0ca8\u0cae\u0c83 \u0965\n    \n    \u0c93\u0c82 \u0ca4\u0ca6\u0ccd\u0cac\u0ccd\u0cb0\u0cb9\u0ccd\u0cae \u0c93\u0c82 \u0ca4\u0ca6\u0ccd\u0cb5\u0cbe\u0caf\u0cc1\u0c83 \u0c93\u0c82 \u0ca4\u0ca6\u0cbe\u0ca4\u0ccd\u0cae\u0cbe \u0c93\u0c82 \u0ca4\u0ca4\u0ccd\u0cb8\u0ca4\u0ccd\u0caf\u0cae\u0ccd \u0c93\u0c82 \u0ca4\u0ca4\u0ccd \u0cb8\u0cb0\u0ccd\u0cb5\u0cae\u0ccd \u0c93\u0c82 \u0ca4\u0ca4\u0ccd \u0caa\u0cc1\u0cb0\u0ccb\u0cb0\u0ccd\u0ca8\u0cae\u0c83 \u0965\n    \u0c85\u0c82\u0ca4\u0cb6\u0ccd\u0c9a\u0cb0\u0ca4\u0cbf \u0cad\u0cc2\u0ca4\u0cc7\u0cb7\u0cc1 \u0c97\u0cc1\u0cb9\u0cbe\u0caf\u0cbe\u0c82 \u0cb5\u0cbf\u0cb6\u0ccd\u0cb5\u0cae\u0cc2\u0cb0\u0ccd\u0ca4\u0cbf\u0cb7\u0cc1 \u0964\n    \u0ca4\u0ccd\u0cb5\u0c82 \u0caf\u0c9c\u0ccd\u0c9e\u0cb8\u0ccd\u0ca4\u0ccd\u0cb5\u0c82 \u0cb5\u0cb7\u0c9f\u0ccd\u0c95\u0cbe\u0cb0\u0cb8\u0ccd\u0ca4\u0ccd\u0cb5\u0cae\u0cbf\u0c82\u0ca6\u0ccd\u0cb0\u0cb8\u0ccd\u0ca4\u0ccd\u0cb5\u0c97\u0cc1\u0c82 \u0cb0\u0cc1\u0ca6\u0ccd\u0cb0\u0cb8\u0ccd\u0ca4\u0ccd\u0cb5\u0c82 \u0cb5\u0cbf\u0cb7\u0ccd\u0ca3\u0cc1\u0cb8\u0ccd\u0ca4\u0ccd\u0cb5\u0c82 \u0cac\u0ccd\u0cb0\u0cb9\u0ccd\u0cae\u0ca4\u0ccd\u0cb5\u0c82 \u0caa\u0ccd\u0cb0\u0c9c\u0cbe\u0caa\u0ca4\u0cbf\u0c83 \u0964\n    \u0ca4\u0ccd\u0cb5\u0c82 \u0ca4\u0ca6\u0cbe\u0caa \u0c86\u0caa\u0ccb\u0c9c\u0ccd\u0caf\u0ccb\u0ca4\u0cc0 \u0cb0\u0cb8\u0ccb\u0cae\u0cc3\u0ca4\u0c82 \u0cac\u0ccd\u0cb0\u0cb9\u0ccd\u0cae \u0cad\u0cc2\u0cb0\u0ccd\u0cad\u0cc1\u0cb5\u0cb8\u0ccd\u0cb8\u0cc1\u0cb5\u0cb0\u0ccb\u0cae\u0ccd \u0965\n    \n    \u0c93\u0c82 \u0ca8\u0cae\u0cb8\u0ccd\u0ca4\u0cc7 \u0c85\u0cb8\u0ccd\u0ca4\u0cc1 \u0cad\u0c97\u0cb5\u0ca8\u0ccd \u0cb5\u0cbf\u0cb6\u0ccd\u0cb5\u0cc7\u0cb6\u0ccd\u0cb5\u0cb0\u0cbe\u0caf \u0cae\u0cb9\u0cbe\u0ca6\u0cc7\u0cb5\u0cbe\u0caf \u0ca4\u0ccd\u0cb0\u0ccd\u0caf\u0c82\u0cac\u0c95\u0cbe\u0caf \u0ca4\u0ccd\u0cb0\u0cbf\u0caa\u0cc1\u0cb0\u0cbe\u0c82\u0ca4\u0c95\u0cbe\u0caf \u0ca4\u0ccd\u0cb0\u0cbf\u0c95\u0cbe\u0c97\u0ccd\u0ca8\u0cbf\u0c95\u0cbe\u0cb2\u0cbe\u0caf \u0c95\u0cbe\u0cb2\u0cbe\u0c97\u0ccd\u0ca8\u0cbf\u0cb0\u0cc1\u0ca6\u0ccd\u0cb0\u0cbe\u0caf \u0ca8\u0cc0\u0cb2\u0c95\u0c82\u0ca0\u0cbe\u0caf \u0cae\u0cc3\u0ca4\u0ccd\u0caf\u0cc1\u0c82\u0c9c\u0caf\u0cbe\u0caf \u0cb8\u0cb0\u0ccd\u0cb5\u0cc7\u0cb6\u0ccd\u0cb5\u0cb0\u0cbe\u0caf \u0cb8\u0ca6\u0cbe\u0cb6\u0cbf\u0cb5\u0cbe\u0caf \u0cb6\u0ccd\u0cb0\u0cc0\u0cae\u0ca8\u0ccd\u0cae\u0cb9\u0cbe\u0ca6\u0cc7\u0cb5\u0cbe\u0caf \u0ca8\u0cae\u0c83 \u0965\n    \n    \u0c93\u0c82 \u0ca8\u0cbf\u0ca7\u0ca8\u0caa\u0ca4\u0caf\u0cc7 \u0ca8\u0cae\u0c83 \u0ca8\u0cbf\u0ca7\u0ca8\u0caa\u0ca4\u0cbe\u0c82\u0ca4\u0cbf\u0c95\u0cbe\u0caf \u0ca8\u0cae\u0c83\n    \u0c8a\u0cb0\u0ccd\u0ca7\u0ccd\u0cb5\u0cbe\u0caf \u0ca8\u0cae\u0c83 \u0c8a\u0cb0\u0ccd\u0ca7\u0ccd\u0cb5\u0cb2\u0cbf\u0c82\u0c97\u0cbe\u0caf \u0ca8\u0cae\u0c83\n    \u0cb9\u0cbf\u0cb0\u0ca3\u0ccd\u0caf\u0cbe\u0caf \u0ca8\u0cae\u0c83 \u0cb9\u0cbf\u0cb0\u0ca3\u0ccd\u0caf\u0cb2\u0cbf\u0c82\u0c97\u0cbe\u0caf \u0ca8\u0cae\u0c83\n    \u0cb8\u0cc1\u0cb5\u0cb0\u0ccd\u0ca3\u0cbe\u0caf \u0ca8\u0cae\u0c83 \u0cb8\u0cc1\u0cb5\u0cb0\u0ccd\u0ca3\u0cb2\u0cbf\u0c82\u0c97\u0cbe\u0caf \u0ca8\u0cae\u0c83\n    \u0ca6\u0cbf\u0cb5\u0ccd\u0caf\u0cbe\u0caf \u0ca8\u0cae\u0c83 \u0ca6\u0cbf\u0cb5\u0ccd\u0caf\u0cb2\u0cbf\u0c82\u0c97\u0cbe\u0caf \u0ca8\u0cae\u0c83\n    \u0cad\u0cb5\u0cbe\u0caf \u0ca8\u0cae\u0c83 \u0cad\u0cb5\u0cb2\u0cbf\u0c82\u0c97\u0cbe\u0caf \u0ca8\u0cae\u0c83\n    \u0cb8\u0cb0\u0ccd\u0cb5\u0cbe\u0caf \u0ca8\u0cae\u0c83 \u0cb8\u0cb0\u0ccd\u0cb5\u0cb2\u0cbf\u0c82\u0c97\u0cbe\u0caf \u0ca8\u0cae\u0c83\n    \u0cb6\u0cbf\u0cb5\u0cbe\u0caf \u0ca8\u0cae\u0c83 \u0cb6\u0cbf\u0cb5\u0cb2\u0cbf\u0c82\u0c97\u0cbe\u0caf \u0ca8\u0cae\u0c83\n    \u0c9c\u0ccd\u0cb5\u0cbe\u0cb2\u0cbe\u0caf \u0ca8\u0cae\u0c83 \u0c9c\u0ccd\u0cb5\u0cbe\u0cb2\u0cb2\u0cbf\u0c82\u0c97\u0cbe\u0caf \u0ca8\u0cae\u0c83\n    \u0c86\u0ca4\u0ccd\u0cae\u0cbe\u0caf \u0ca8\u0cae\u0c83 \u0c86\u0ca4\u0ccd\u0cae\u0cb2\u0cbf\u0c82\u0c97\u0cbe\u0caf \u0ca8\u0cae\u0c83\n    \u0caa\u0cb0\u0cae\u0cbe\u0caf \u0ca8\u0cae\u0c83 \u0caa\u0cb0\u0cae\u0cb2\u0cbf\u0c82\u0c97\u0cbe\u0caf \u0ca8\u0cae\u0c83\n    \u0c8f\u0ca4\u0ca4\u0ccd \u0cb8\u0ccb\u0cae\u0cb8\u0ccd\u0caf \u0cb8\u0cc2\u0cb0\u0ccd\u0caf\u0cb8\u0ccd\u0caf \u0cb8\u0cb0\u0ccd\u0cb5\u0cb2\u0cbf\u0c82\u0c97\u0c97\u0ccd\u0c82 \u0cb8\u0ccd\u0ca5\u0cbe\u0caa\u0caf\u0ca4\u0cbf \u0caa\u0cbe\u0ca3\u0cbf\u0cae\u0c82\u0ca4\u0ccd\u0cb0\u0c82 \u0caa\u0cb5\u0cbf\u0ca4\u0ccd\u0cb0\u0cae\u0ccd \u0965\n    \n    \u0cb8\u0ca6\u0ccd\u0caf\u0ccb\u0c9c\u0cbe\u0ca4\u0c82 \u0caa\u0ccd\u0cb0\u0caa\u0ca6\u0ccd\u0caf\u0cbe\u0cae\u0cbf \u0cb8\u0ca6\u0ccd\u0caf\u0ccb\u0c9c\u0cbe\u0ca4\u0cbe\u0caf \u0cb5\u0cc8 \u0ca8\u0cae\u0ccb \u0ca8\u0cae\u0c83 \u0964\n    \u0cad\u0cb5\u0cc7 \u0cad\u0cb5\u0cc7 \u0ca8\u0cbe\u0ca4\u0cbf\u0cad\u0cb5\u0cc7 \u0cad\u0cb5\u0cb8\u0ccd\u0cb5 \u0cae\u0cbe\u0cae\u0ccd \u0cad\u0cb5\u0ccb\u0ca6\u0ccd\u0cad\u0cb5\u0cbe\u0caf \u0ca8\u0cae\u0c83 \u0965\n    \u0cb5\u0cbe\u0cae\u0ca6\u0cc7\u0cb5\u0cbe\u0caf \u0ca8\u0cae\u0ccb \u0c9c\u0ccd\u0caf\u0cc7\u0cb7\u0ccd\u0ca0\u0cbe\u0caf \u0ca8\u0cae\u0c83 \u0cb6\u0ccd\u0cb0\u0cc7\u0cb7\u0ccd\u0ca0\u0cbe\u0caf \u0ca8\u0cae\u0ccb \u0cb0\u0cc1\u0ca6\u0ccd\u0cb0\u0cbe\u0caf \u0ca8\u0cae\u0c83 \u0c95\u0cbe\u0cb2\u0cbe\u0caf \u0ca8\u0cae\u0c83 \u0c95\u0cb2\u0cb5\u0cbf\u0c95\u0cb0\u0ca3\u0cbe\u0caf \u0ca8\u0cae\u0ccb \u0cac\u0cb2\u0cb5\u0cbf\u0c95\u0cb0\u0ca3\u0cbe\u0caf \u0ca8\u0cae\u0ccb \u0cac\u0cb2\u0cbe\u0caf \u0ca8\u0cae\u0ccb \u0cac\u0cb2\u0caa\u0ccd\u0cb0\u0cae\u0ca5\u0ca8\u0cbe\u0caf \u0ca8\u0cae\u0c83 \u0cb8\u0cb0\u0ccd\u0cb5\u0cad\u0cc2\u0ca4\u0ca6\u0cae\u0ca8\u0cbe\u0caf \u0ca8\u0cae\u0ccb \u0cae\u0ca8\u0ccb\u0ca8\u0ccd\u0cae\u0ca8\u0cbe\u0caf \u0ca8\u0cae\u0c83 \u0965\n    \u0c85\u0c98\u0ccb\u0cb0\u0cc7\u0cad\u0ccd\u0caf\u0ccb\u0ca5 \u0c98\u0ccb\u0cb0\u0cc7\u0cad\u0ccd\u0caf\u0ccb \u0c98\u0ccb\u0cb0\u0c98\u0ccb\u0cb0\u0ca4\u0cb0\u0cc7\u0cad\u0ccd\u0caf\u0c83 \u0cb8\u0cb0\u0ccd\u0cb5\u0cc7\u0cad\u0ccd\u0caf\u0c83 \u0cb8\u0cb0\u0ccd\u0cb5 \u0cb6\u0cb0\u0ccd\u0cb5\u0cc7\u0cad\u0ccd\u0caf\u0ccb \u0ca8\u0cae\u0cb8\u0ccd\u0ca4\u0cc7 \u0c85\u0cb8\u0ccd\u0ca4\u0cc1 \u0cb0\u0cc1\u0ca6\u0ccd\u0cb0 \u0cb0\u0cc2\u0caa\u0cc7\u0cad\u0ccd\u0caf\u0c83 \u0965\n    \u0ca4\u0ca4\u0ccd\u0caa\u0cc1\u0cb0\u0cc1\u0cb7\u0cbe\u0caf \u0cb5\u0cbf\u0ca6\u0ccd\u0cae\u0cb9\u0cc7 \u0cae\u0cb9\u0cbe\u0ca6\u0cc7\u0cb5\u0cbe\u0caf \u0ca7\u0cc0\u0cae\u0cb9\u0cbf \u0ca4\u0ca8\u0ccd\u0ca8\u0ccb \u0cb0\u0cc1\u0ca6\u0ccd\u0cb0\u0c83 \u0caa\u0ccd\u0cb0\u0c9a\u0ccb\u0ca6\u0caf\u0cbe\u0ca4\u0ccd \u0965\n    \u0c88\u0cb6\u0cbe\u0ca8\u0cb8\u0ccd\u0cb8\u0cb0\u0ccd\u0cb5\u0cb5\u0cbf\u0ca6\u0ccd\u0caf\u0cbe\u0ca8\u0cbe\u0cae\u0cc0\u0cb6\u0ccd\u0cb5\u0cb0\u0cb8\u0ccd\u0cb8\u0cb0\u0ccd\u0cb5 \u0cad\u0cc2\u0ca4\u0cbe\u0ca8\u0cbe\u0c82 \u0cac\u0ccd\u0cb0\u0cb9\u0ccd\u0cae\u0cbe\u0ca7\u0cbf\u0caa\u0ca4\u0cbf\u0cb0\u0ccd\u0cac\u0ccd\u0cb0\u0cb9\u0ccd\u0cae\u0ca3\u0ccb\u0ca7\u0cbf\u0caa\u0ca4\u0cbf\u0cb0\u0ccd\u0cac\u0ccd\u0cb0\u0cb9\u0ccd\u0cae\u0cbe \u0cb6\u0cbf\u0cb5\u0ccb \u0cae\u0cc7 \u0c85\u0cb8\u0ccd\u0ca4\u0cc1 \u0cb8\u0ca6\u0cbe\u0cb6\u0cbf\u0cb5\u0ccb\u0cae\u0ccd \u0965\n    \n    \u0c93\u0c82 \u0ca4\u0ca4\u0ccd\u0caa\u0cc1\u0cb0\u0cc1\u0cb7\u0cbe\u0caf \u0cb5\u0cbf\u0ca6\u0ccd\u0cae\u0cb9\u0cc7 \u0cae\u0cb9\u0cbe\u0ca6\u0cc7\u0cb5\u0cbe\u0caf \u0ca7\u0cc0\u0cae\u0cb9\u0cbf \u0ca4\u0ca8\u0ccd\u0ca8\u0ccb \u0cb0\u0cc1\u0ca6\u0ccd\u0cb0\u0c83 \u0caa\u0ccd\u0cb0\u0c9a\u0ccb\u0ca6\u0caf\u0cbe\u0ca4\u0ccd \u0965\n    \u0c93\u0c82 \u0ca8\u0cbe\u0cb0\u0cbe\u0caf\u0ca3\u0cbe\u0caf \u0cb5\u0cbf\u0ca6\u0ccd\u0cae\u0cb9\u0cc7 \u0cb5\u0cbe\u0cb8\u0cc1\u0ca6\u0cc7\u0cb5\u0cbe\u0caf \u0ca7\u0cc0\u0cae\u0cb9\u0cbf \u0ca4\u0ca8\u0ccd\u0ca8\u0ccb \u0cb5\u0cbf\u0cb7\u0ccd\u0ca3\u0cc1\u0c83 \u0caa\u0ccd\u0cb0\u0c9a\u0ccb\u0ca6\u0caf\u0cbe\u0ca4\u0ccd \u0965\n    \u0c93\u0c82 \u0cad\u0cc2\u0ca4\u0ca8\u0cbe\u0ca5\u0cbe\u0caf \u0cb5\u0cbf\u0ca6\u0ccd\u0cae\u0cb9\u0cc7 \u0cad\u0cb5\u0caa\u0cc1\u0ca4\u0ccd\u0cb0\u0cbe\u0caf \u0ca7\u0cc0\u0cae\u0cb9\u0cbf \u0ca4\u0ca8\u0ccd\u0ca8\u0ccb \u0cb6\u0cbe\u0cb8\u0ccd\u0ca4\u0cbe \u0caa\u0ccd\u0cb0\u0c9a\u0ccb\u0ca6\u0caf\u0cbe\u0ca4\u0ccd \u0965",isAudio:!1,audioDurationSec:40,totalTime:"00:40"},{id:"19",slug:"sastha-dasakam",title:"\u0ca8\u0cae\u0cb8\u0ccd\u0c95\u0cbe\u0cb0 \u0cb6\u0ccd\u0cb2\u0ccb\u0c95\u0c97\u0cb3\u0cc1",description:"\u0cb2\u0ccb\u0c95\u0cb5\u0cc0\u0cb0\u0c82 \u0cae\u0cb9\u0cbe\u0caa\u0cc2\u0c9c\u0ccd\u0caf\u0c82 \u0cb8\u0cb0\u0ccd\u0cb5\u0cb0\u0c95\u0ccd\u0cb7\u0cbe\u0c95\u0cb0\u0c82 \u0cb5\u0cbf\u0cad\u0cc1\u0cae\u0ccd \u0964\n    \u0caa\u0cbe\u0cb0\u0ccd\u0cb5\u0ca4\u0cc0 \u0cb9\u0cc3\u0ca6\u0caf\u0cbe\u0ca8\u0c82\u0ca6\u0c82 \u0cb6\u0cbe\u0cb8\u0ccd\u0ca4\u0cbe\u0cb0\u0c82 \u0caa\u0ccd\u0cb0\u0ca3\u0cae\u0cbe\u0cae\u0ccd\u0caf\u0cb9\u0cae\u0ccd \u0965 1\n    \n    \u0cb5\u0cbf\u0caa\u0ccd\u0cb0\u0caa\u0cc2\u0c9c\u0ccd\u0caf\u0c82 \u0cb5\u0cbf\u0cb6\u0ccd\u0cb5\u0cb5\u0c82\u0ca6\u0ccd\u0caf\u0c82 \u0cb5\u0cbf\u0cb7\u0ccd\u0ca3\u0cc1\u0cb6\u0c82\u0cad\u0ccb\u0c83 \u0caa\u0ccd\u0cb0\u0cbf\u0caf\u0c82 \u0cb8\u0cc1\u0ca4\u0cae\u0ccd \u0964\n    \u0c95\u0ccd\u0cb7\u0cbf\u0caa\u0ccd\u0cb0\u0caa\u0ccd\u0cb0\u0cb8\u0cbe\u0ca6\u0ca8\u0cbf\u0cb0\u0ca4\u0c82 \u0cb6\u0cbe\u0cb8\u0ccd\u0ca4\u0cbe\u0cb0\u0c82 \u0caa\u0ccd\u0cb0\u0ca3\u0cae\u0cbe\u0cae\u0ccd\u0caf\u0cb9\u0cae\u0ccd \u0965 2\n    \n    \u0cae\u0ca4\u0ccd\u0ca4\u0cae\u0cbe\u0ca4\u0c82\u0c97\u0c97\u0cae\u0ca8\u0c82 \u0c95\u0cbe\u0cb0\u0cc1\u0ca3\u0ccd\u0caf\u0cbe\u0cae\u0cc3\u0ca4\u0caa\u0cc2\u0cb0\u0cbf\u0ca4\u0cae\u0ccd \u0964\n    \u0cb8\u0cb0\u0ccd\u0cb5\u0cb5\u0cbf\u0c98\u0ccd\u0ca8\u0cb9\u0cb0\u0c82 \u0ca6\u0cc7\u0cb5\u0c82 \u0cb6\u0cbe\u0cb8\u0ccd\u0ca4\u0cbe\u0cb0\u0c82 \u0caa\u0ccd\u0cb0\u0ca3\u0cae\u0cbe\u0cae\u0ccd\u0caf\u0cb9\u0cae\u0ccd \u0965 3\n    \n    \u0c85\u0cb8\u0ccd\u0cae\u0ca4\u0ccd\u0c95\u0cc1\u0cb2\u0cc7\u0cb6\u0ccd\u0cb5\u0cb0\u0c82 \u0ca6\u0cc7\u0cb5\u0cae\u0cb8\u0ccd\u0cae\u0c9a\u0ccd\u0c9b\u0ca4\u0ccd\u0cb0\u0cc1\u0cb5\u0cbf\u0ca8\u0cbe\u0cb6\u0ca8\u0cae\u0ccd \u0964\n    \u0c85\u0cb8\u0ccd\u0cae\u0ca6\u0cbf\u0cb7\u0ccd\u0c9f\u0caa\u0ccd\u0cb0\u0ca6\u0cbe\u0ca4\u0cbe\u0cb0\u0c82 \u0cb6\u0cbe\u0cb8\u0ccd\u0ca4\u0cbe\u0cb0\u0c82 \u0caa\u0ccd\u0cb0\u0ca3\u0cae\u0cbe\u0cae\u0ccd\u0caf\u0cb9\u0cae\u0ccd \u0965 4\n    \n    \u0caa\u0cbe\u0c82\u0ca1\u0ccd\u0caf\u0cc7\u0cb6\u0cb5\u0c82\u0cb6\u0ca4\u0cbf\u0cb2\u0c95\u0c82 \u0c95\u0cc7\u0cb0\u0cb3\u0cc7 \u0c95\u0cc7\u0cb3\u0cbf\u0cb5\u0cbf\u0c97\u0ccd\u0cb0\u0cb9\u0cae\u0ccd \u0964\n    \u0c86\u0cb0\u0ccd\u0ca4\u0ca4\u0ccd\u0cb0\u0cbe\u0ca3\u0caa\u0cb0\u0c82 \u0ca6\u0cc7\u0cb5\u0c82 \u0cb6\u0cbe\u0cb8\u0ccd\u0ca4\u0cbe\u0cb0\u0c82 \u0caa\u0ccd\u0cb0\u0ca3\u0cae\u0cbe\u0cae\u0ccd\u0caf\u0cb9\u0cae\u0ccd \u0965 5\n    \n    \u0ca4\u0ccd\u0cb0\u0ccd\u0caf\u0c82\u0cac\u0c95\u0caa\u0cc1\u0cb0\u0cbe\u0ca7\u0cc0\u0cb6\u0c82 \u0c97\u0ca3\u0cbe\u0ca7\u0cbf\u0caa \u0cb8\u0cae\u0ca8\u0ccd\u0cb5\u0cbf\u0ca4\u0cae\u0ccd \u0964\n    \u0c97\u0c9c\u0cbe\u0cb0\u0cc2\u0ca2\u0cae\u0cb9\u0c82 \u0cb5\u0c82\u0ca6\u0cc7 \u0cb6\u0cbe\u0cb8\u0ccd\u0ca4\u0cbe\u0cb0\u0c82 \u0caa\u0ccd\u0cb0\u0ca3\u0cae\u0cbe\u0cae\u0ccd\u0caf\u0cb9\u0cae\u0ccd \u0965 6\n    \n    \u0cb6\u0cbf\u0cb5\u0cb5\u0cc0\u0cb0\u0ccd\u0caf \u0cb8\u0cae\u0cc1\u0ca6\u0ccd\u0cad\u0cc2\u0ca4\u0c82 \u0cb6\u0ccd\u0cb0\u0cc0\u0ca8\u0cbf\u0cb5\u0cbe\u0cb8 \u0ca4\u0ca8\u0cc1\u0ca6\u0ccd\u0cad\u0cb5\u0cae\u0ccd \u0964\n    \u0cb6\u0cbf\u0c96\u0cbf\u0cb5\u0cbe\u0cb9\u0cbe\u0ca8\u0cc1\u0c9c\u0c82 \u0cb5\u0c82\u0ca6\u0cc7 \u0cb6\u0cbe\u0cb8\u0ccd\u0ca4\u0cbe\u0cb0\u0c82 \u0caa\u0ccd\u0cb0\u0ca3\u0cae\u0cbe\u0cae\u0ccd\u0caf\u0cb9\u0cae\u0ccd \u0965 7\n    \n    \u0caf\u0cb8\u0ccd\u0caf \u0ca7\u0ca8\u0ccd\u0cb5\u0c82\u0ca4\u0cb0\u0cbf\u0cb0\u0ccd\u0cae\u0cbe\u0ca4\u0cbe \u0caa\u0cbf\u0ca4\u0cbe \u0ca6\u0cc7\u0cb5\u0ccb \u0cae\u0cb9\u0cc7\u0cb6\u0ccd\u0cb5\u0cb0\u0c83 \u0964\n    \u0ca4\u0c82 \u0cb6\u0cbe\u0cb8\u0ccd\u0ca4\u0cbe\u0cb0\u0cae\u0cb9\u0c82 \u0cb5\u0c82\u0ca6\u0cc7 \u0cae\u0cb9\u0cbe\u0cb0\u0ccb\u0c97\u0ca8\u0cbf\u0cb5\u0cbe\u0cb0\u0ca3\u0cae\u0ccd \u0965 8\n    \n    \u0cad\u0cc2\u0ca4\u0ca8\u0cbe\u0ca5 \u0cb8\u0ca6\u0cbe\u0ca8\u0c82\u0ca6 \u0cb8\u0cb0\u0ccd\u0cb5\u0cad\u0cc2\u0ca4 \u0ca6\u0caf\u0cbe\u0caa\u0cb0 \u0964\n    \u0cb0\u0c95\u0ccd\u0cb7 \u0cb0\u0c95\u0ccd\u0cb7 \u0cae\u0cb9\u0cbe\u0cac\u0cbe\u0cb9\u0ccb \u0cb6\u0cbe\u0cb8\u0ccd\u0ca4\u0ccd\u0cb0\u0cc7 \u0ca4\u0cc1\u0cad\u0ccd\u0caf\u0c82 \u0ca8\u0cae\u0ccb \u0ca8\u0cae\u0c83 \u0965 9\n    \n    \u0c86\u0cb6\u0ccd\u0caf\u0cbe\u0cae\u0c95\u0ccb\u0cae\u0cb2 \u0cb5\u0cbf\u0cb6\u0cbe\u0cb2\u0ca4\u0ca8\u0cc1\u0c82 \u0cb5\u0cbf\u0c9a\u0cbf\u0ca4\u0ccd\u0cb0\u0c82\n    \u0cb5\u0cbe\u0cb8\u0ccb\u0cb5\u0cb8\u0cbe\u0ca8\u0cae\u0cb0\u0cc1\u0ca3\u0ccb\u0ca4\u0ccd\u0caa\u0cb2\u0ca6\u0cbe\u0cae\u0cb9\u0cb8\u0ccd\u0ca4\u0cae\u0ccd \u0964\n    \u0c89\u0ca4\u0ccd\u0ca4\u0cc1\u0c82\u0c97\u0cb0\u0ca4\u0ccd\u0ca8\u0cae\u0c95\u0cc1\u0c9f\u0c82 \u0c95\u0cc1\u0c9f\u0cbf\u0cb2\u0cbe\u0c97\u0ccd\u0cb0\u0c95\u0cc7\u0cb6\u0c82\n    \u0cb6\u0cbe\u0cb8\u0ccd\u0ca4\u0cbe\u0cb0\u0cae\u0cbf\u0cb7\u0ccd\u0c9f\u0cb5\u0cb0\u0ca6\u0c82 \u0cb6\u0cb0\u0ca3\u0c82 \u0caa\u0ccd\u0cb0\u0caa\u0ca6\u0ccd\u0caf\u0cc7 \u0965 10",isAudio:!1,audioDurationSec:40,totalTime:"00:40"},{id:"20",slug:"bhajana-keerthanalu",title:"\u0cad\u0c9c\u0ca8\u0cbe \u0c95\u0cc0\u0cb0\u0ccd\u0ca4\u0ca8\u0cc6\u0c97\u0cb3\u0cc1",description:"[ \u0cb6\u0ccd\u0cb0\u0cc0 \u0c85\u0caf\u0ccd\u0caf\u0caa\u0ccd\u0caa \u0cad\u0c9c\u0ca8\u0cbe \u0c95\u0cc0\u0cb0\u0ccd\u0ca4\u0ca8\u0cc6\u0c97\u0cb3\u0cc1 ]\n    \n    \u0ce7. \u0cad\u0c97\u0cb5\u0cbe\u0ca8\u0ccd \u0cb6\u0cb0\u0ca3\u0c82 \u0cad\u0c97\u0cb5\u0ca4\u0cbf \u0cb6\u0cb0\u0ca3\u0c82\n    \u0cad\u0c97\u0cb5\u0cbe\u0ca8\u0ccd \u0cb6\u0cb0\u0ca3\u0c82 \u0cad\u0c97\u0cb5\u0ca4\u0cbf \u0cb6\u0cb0\u0ca3\u0c82 \u0cb6\u0cb0\u0ca3\u0c82 \u0cb6\u0cb0\u0ca3\u0cae\u0caf\u0ccd\u0caf\u0caa\u0ccd\u0caa\u0cbe\n    \u0cad\u0c97\u0cb5\u0ca4\u0cbf \u0cb6\u0cb0\u0ca3\u0c82 \u0cad\u0c97\u0cb5\u0cbe\u0ca8\u0ccd \u0cb6\u0cb0\u0ca3\u0c82 \u0cb6\u0cb0\u0ca3\u0c82 \u0cb6\u0cb0\u0ca3\u0cae\u0caf\u0ccd\u0caf\u0caa\u0ccd\u0caa\u0cbe\n    \n    \u0ce8. \u0caa\u0cb3\u0ccd\u0cb3\u0cbf\u0c95\u0c9f\u0ccd\u0c9f\u0cc1 \u0cb6\u0cac\u0cb0\u0cbf\u0cae\u0cb2\u0cc8\u0c95\u0cbf\n    \u0caa\u0cb3\u0ccd\u0cb3\u0cbf\u0c95\u0c9f\u0ccd\u0c9f\u0cc1 \u0cb6\u0cac\u0cb0\u0cbf\u0cae\u0cb2\u0cc8\u0c95\u0cbf \u0c95\u0cb2\u0ccd\u0cb2\u0cc1\u0cae\u0cc1\u0cb2\u0ccd\u0cb2\u0cc1 \u0c95\u0cbe\u0cb2\u0cbf\u0c95\u0cbf \u0cae\u0cc6\u0ca4\u0ccd\u0ca4\u0cc8\n    \u0cb8\u0ccd\u0cb5\u0cbe\u0cae\u0cbf\u0caf\u0cc7 \u0c85\u0caf\u0ccd\u0caf\u0caa\u0ccd\u0caa\u0ccb \u0c85\u0caf\u0ccd\u0caf\u0caa\u0ccd\u0caa\u0ccb \u0cb8\u0ccd\u0cb5\u0cbe\u0cae\u0cbf\u0caf\u0cc7!\n    \n    \u0ce9. \u0c85\u0caf\u0ccd\u0caf\u0caa\u0ccd\u0caa \u0ca4\u0cbf\u0c82\u0ca4\u0cbf\u0ca4\u0ccd\u0ca4\u0c95\u0ca4\u0ccb\u0c82\n    \u0cb8\u0ccd\u0cb5\u0cbe\u0cae\u0cbf \u0ca4\u0cbf\u0c82\u0ca4\u0cbf\u0ca4\u0ccd\u0ca4\u0c95\u0ca4\u0ccb\u0c82 \u0c85\u0caf\u0ccd\u0caf\u0caa\u0ccd\u0caa \u0ca4\u0cbf\u0c82\u0ca4\u0cbf\u0ca4\u0ccd\u0ca4\u0c95\u0ca4\u0ccb\u0c82\n    \u0c8e\u0cb0\u0cc1\u0cae\u0cc7\u0cb2\u0cbf \u0cb6\u0cbe\u0cb8\u0ccd\u0ca4\u0cbe \u0ca4\u0cbf\u0c82\u0ca4\u0cbf\u0ca4\u0ccd\u0ca4\u0c95\u0ca4\u0ccb\u0c82\n    \n    \u0cb8\u0ccd\u0cb5\u0cbe\u0cae\u0cbf\u0caf\u0cc7 \u0cb6\u0cb0\u0ca3\u0c82 \u0c85\u0caf\u0ccd\u0caf\u0caa\u0ccd\u0caa!",isAudio:!1,audioDurationSec:40,totalTime:"00:40"},{id:"21",slug:"harivarasanam",title:"\u0cb9\u0cb0\u0cbf\u0cb5\u0cb0\u0cbe\u0cb8\u0ca8\u0c82",description:"\u0cb9\u0cb0\u0cbf\u0cb5\u0cb0\u0cbe\u0cb8\u0ca8\u0c82 \u0cb5\u0cbf\u0cb6\u0ccd\u0cb5\u0cae\u0ccb\u0cb9\u0ca8\u0c82 \u0cb9\u0cb0\u0cbf\u0ca6\u0ca7\u0cc0\u0cb6\u0ccd\u0cb5\u0cb0\u0c82 \u0c86\u0cb0\u0cbe\u0ca7\u0ccd\u0caf\u0caa\u0cbe\u0ca6\u0cc1\u0c95\u0c82...",isAudio:!0,audioDurationSec:40,totalTime:"00:40",chantLyric:"\u0cb9\u0cb0\u0cbf\u0cb5\u0cb0\u0cbe\u0cb8\u0ca8\u0c82 \u0cb5\u0cbf\u0cb6\u0ccd\u0cb5\u0cae\u0ccb\u0cb9\u0ca8\u0c82 \u0cb9\u0cb0\u0cbf\u0ca6\u0ca7\u0cc0\u0cb6\u0ccd\u0cb5\u0cb0\u0c82 \u0c86\u0cb0\u0cbe\u0ca7\u0ccd\u0caf\u0caa\u0cbe\u0ca6\u0cc1\u0c95\u0c82"},{id:"22",slug:"koodalmanikya-vishnu-sthuthi",title:"\u0c95\u0cc2\u0ca1\u0cb2\u0ccd\u0cae\u0cbe\u0ca3\u0cbf\u0c95\u0ccd\u0caf (\u0cb5\u0cbf\u0cb7\u0ccd\u0ca3\u0cc1) \u0cb8\u0ccd\u0ca4\u0cc1\u0ca4\u0cbf",description:"[ \u0c95\u0cc2\u0ca1\u0cb2\u0ccd\u0cae\u0cbe\u0ca3\u0cbf\u0c95\u0ccd\u0caf (\u0cb5\u0cbf\u0cb7\u0ccd\u0ca3\u0cc1) \u0cb8\u0ccd\u0ca4\u0cc1\u0ca4\u0cbf ]\n    \n    \u0cb6\u0cbe\u0c82\u0ca4\u0cbe\u0c95\u0cbe\u0cb0\u0c82 \u0cad\u0cc1\u0c9c\u0c97\u0cb6\u0caf\u0ca8\u0c82 \u0caa\u0ca6\u0ccd\u0cae\u0ca8\u0cbe\u0cad\u0c82 \u0cb8\u0cc1\u0cb0\u0cc7\u0cb6\u0c82\n    \u0cb5\u0cbf\u0cb6\u0ccd\u0cb5\u0cbe\u0ca7\u0cbe\u0cb0\u0c82 \u0c97\u0c97\u0ca8\u0cb8\u0ca6\u0cc3\u0cb6\u0c82 \u0cae\u0cc7\u0c98\u0cb5\u0cb0\u0ccd\u0ca3\u0c82 \u0cb6\u0cc1\u0cad\u0cbe\u0c82\u0c97\u0cae\u0ccd\n    \u0cb2\u0c95\u0ccd\u0cb7\u0ccd\u0cae\u0cc0\u0c95\u0cbe\u0c82\u0ca4\u0c82 \u0c95\u0cae\u0cb2\u0ca8\u0caf\u0ca8\u0c82 \u0caf\u0ccb\u0c97\u0cbf\u0cb9\u0cc3\u0ca6\u0ccd\u0ca7\u0ccd\u0caf\u0cbe\u0ca8\u0c97\u0cae\u0ccd\u0caf\u0c82\n    \u0cb5\u0c82\u0ca6\u0cc7 \u0cb5\u0cbf\u0cb7\u0ccd\u0ca3\u0cc1\u0c82 \u0cad\u0cb5\u0cad\u0caf\u0cb9\u0cb0\u0c82 \u0cb8\u0cb0\u0ccd\u0cb5\u0cb2\u0ccb\u0c95\u0cc8\u0c95\u0ca8\u0cbe\u0ca5\u0cae\u0ccd\n    \n    \u0c93\u0c82 \u0ca8\u0cae\u0ccb \u0ca8\u0cbe\u0cb0\u0cbe\u0caf\u0ca3\u0cbe\u0caf\n    \u0c93\u0c82 \u0ca8\u0cae\u0ccb \u0cad\u0c97\u0cb5\u0ca4\u0cc7 \u0cb5\u0cbe\u0cb8\u0cc1\u0ca6\u0cc7\u0cb5\u0cbe\u0caf\n    \n    \u0c95\u0cc2\u0ca1\u0cb2\u0ccd\u0cae\u0cbe\u0ca3\u0cbf\u0c95\u0ccd\u0caf \u0cb8\u0c82\u0c97\u0cae\u0cc7\u0cb6\u0ccd\u0cb5\u0cb0 \u0cb8\u0ccd\u0cb5\u0cbe\u0cae\u0cbf\u0caf\u0cc7 \u0ca8\u0cae\u0c83\n    \u0cb9\u0cb0\u0cbf\u0cb9\u0cb0 \u0cb8\u0cc1\u0ca4\u0ca8\u0cc7 \u0cb6\u0cb0\u0ca3\u0cae\u0caf\u0ccd\u0caf\u0caa\u0ccd\u0caa!",isAudio:!0,audioDurationSec:40,totalTime:"00:40",chantLyric:"\u0cb9\u0cb0\u0cbf\u0cb5\u0cb0\u0cbe\u0cb8\u0ca8\u0c82 \u0cb5\u0cbf\u0cb6\u0ccd\u0cb5\u0cae\u0ccb\u0cb9\u0ca8\u0c82 \u0cb9\u0cb0\u0cbf\u0ca6\u0ca7\u0cc0\u0cb6\u0ccd\u0cb5\u0cb0\u0c82 \u0c86\u0cb0\u0cbe\u0ca7\u0ccd\u0caf\u0caa\u0cbe\u0ca6\u0cc1\u0c95\u0c82"},{id:"23",slug:"shabarimala-temple-opening-dates",title:"\u0cb6\u0cac\u0cb0\u0cbf\u0cae\u0cb2\u0cc6 \u0ca6\u0cc7\u0cb5\u0cbe\u0cb2\u0caf\u0ca6 \u0cb8\u0cae\u0caf\u0c97\u0cb3\u0cc1",description:"[ Opening and closing of Sabarimala Sree Dharmasastha Temple for the year (2026 - 2027) ]\n    \u0c95\u0cc7\u0cb0\u0cb3\u0ca6 \u0cb6\u0cac\u0cb0\u0cbf\u0cae\u0cb2\u0cc6 \u0c85\u0caf\u0ccd\u0caf\u0caa\u0ccd\u0caa \u0ca6\u0cc7\u0cb5\u0cbe\u0cb2\u0caf\u0cb5\u0cc1 \u0cb5\u0cb0\u0ccd\u0cb7\u0ca6 \u0c95\u0cc6\u0cb2\u0cb5\u0cc1 \u0ca8\u0cbf\u0cb0\u0ccd\u0ca6\u0cbf\u0cb7\u0ccd\u0c9f \u0ca6\u0cbf\u0ca8\u0c97\u0cb3\u0cb2\u0ccd\u0cb2\u0cbf \u0cae\u0cbe\u0ca4\u0ccd\u0cb0 \u0ca6\u0cb0\u0ccd\u0cb6\u0ca8\u0c95\u0ccd\u0c95\u0cbe\u0c97\u0cbf \u0ca4\u0cc6\u0cb0\u0cc6\u0caf\u0cb2\u0cbe\u0c97\u0cc1\u0ca4\u0ccd\u0ca4\u0ca6\u0cc6. 2026 - 2027 \u0ca8\u0cc7 \u0cb8\u0cbe\u0cb2\u0cbf\u0ca8\u0cb2\u0ccd\u0cb2\u0cbf \u0cb6\u0cac\u0cb0\u0cbf\u0cae\u0cb2\u0cc6 \u0c85\u0caf\u0ccd\u0caf\u0caa\u0ccd\u0caa \u0ca6\u0cc7\u0cb5\u0cbe\u0cb2\u0caf \u0ca4\u0cc6\u0cb0\u0cc6\u0ca6\u0cbf\u0cb0\u0cc1\u0cb5 \u0ca6\u0cbf\u0ca8\u0cbe\u0c82\u0c95\u0c97\u0cb3 \u0cb5\u0cbf\u0cb5\u0cb0\u0c97\u0cb3\u0cc1 \u0c95\u0cc6\u0cb3\u0c97\u0cbf\u0ca8\u0c82\u0ca4\u0cbf\u0cb5\u0cc6.\n    \n    \u0c93\u0c82 \u0cb6\u0ccd\u0cb0\u0cc0 \u0cb8\u0ccd\u0cb5\u0cbe\u0cae\u0cbf\u0caf\u0cc7 \u0cb6\u0cb0\u0ca3\u0c82 \u0c85\u0caf\u0ccd\u0caf\u0caa\u0ccd\u0caa\n    \n    [ \u0cb9\u0cbf\u0c82\u0ca6\u0cbf\u0ca8 \u0cb5\u0cb0\u0ccd\u0cb7 2025 \u0cae\u0c82\u0ca1\u0cb2 \u0caa\u0cc2\u0c9c\u0cc6 \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0ca4\u0cbf\u0cb0\u0cc1\u0ca8\u0ca1\u0cc8 \u0ca4\u0cbf\u0cb0\u0caa\u0ccd\u0caa\u0cc1 - 2026 \u0cae\u0c95\u0cb0\u0cb5\u0cbf\u0cb3\u0c95\u0ccd\u0c95\u0cc1 \u0cae\u0cb9\u0ccb\u0ca4\u0ccd\u0cb8\u0cb5 ]\n    \u2022 \u0ca1\u0cbf\u0cb8\u0cc6\u0c82\u0cac\u0cb0\u0ccd 2025 : \u0cae\u0c82\u0ca1\u0cb2 \u0caa\u0cc2\u0c9c\u0cc6 (\u0ca4\u0cc6\u0cb0\u0cc6\u0caf\u0cc1\u0cb5 \u0ca6\u0cbf\u0ca8\u0cbe\u0c82\u0c95: 16/11/2025 \u2013 \u0cae\u0cc1\u0c95\u0ccd\u0ca4\u0cbe\u0caf: 27/12/2025)\n    \u2022 \u0ca1\u0cbf\u0cb8\u0cc6\u0c82\u0cac\u0cb0\u0ccd 2025 : \u0ca4\u0cbf\u0cb0\u0cc1\u0ca8\u0ca1\u0cc8 \u0ca4\u0cbf\u0cb0\u0caa\u0ccd\u0caa\u0cc1 - \u0cae\u0c95\u0cb0\u0cb5\u0cbf\u0cb3\u0c95\u0ccd\u0c95\u0cc1 \u0cae\u0cb9\u0ccb\u0ca4\u0ccd\u0cb8\u0cb5 (\u0ca4\u0cc6\u0cb0\u0cc6\u0caf\u0cc1\u0cb5 \u0ca6\u0cbf\u0ca8\u0cbe\u0c82\u0c95: 30/12/2025 \u2013 \u0cae\u0cc1\u0c95\u0ccd\u0ca4\u0cbe\u0caf: 20/01/2026)\n    \n    \u0c93\u0c82 \u0cb6\u0ccd\u0cb0\u0cc0 \u0cb8\u0ccd\u0cb5\u0cbe\u0cae\u0cbf\u0caf\u0cc7 \u0cb6\u0cb0\u0ca3\u0c82 \u0c85\u0caf\u0ccd\u0caf\u0caa\u0ccd\u0caa\n    \n    [ 2026-2027 \u0ca6\u0cc7\u0cb5\u0cbe\u0cb2\u0caf \u0ca4\u0cc6\u0cb0\u0cc6\u0caf\u0cc1\u0cb5 \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0cae\u0cc1\u0c9a\u0ccd\u0c9a\u0cc1\u0cb5 \u0ca6\u0cbf\u0ca8\u0cbe\u0c82\u0c95\u0c97\u0cb3\u0cc1 ]\n    \u2022 \u0c9c\u0ca8\u0cb5\u0cb0\u0cbf 2026 : \u0cae\u0c95\u0cb0\u0cb5\u0cbf\u0cb3\u0c95\u0ccd\u0c95\u0cc1 \u0ca6\u0cbf\u0ca8 (14/01/2026 \u2013 20/01/2026)\n    \u2022 \u0cab\u0cc6\u0cac\u0ccd\u0cb0\u0cb5\u0cb0\u0cbf 2026 : \u0cae\u0cbe\u0cb8\u0cbf\u0c95 \u0caa\u0cc2\u0c9c\u0cc6 - \u0c95\u0cc1\u0c82\u0cad\u0c82 (12/02/2026 \u0cb8\u0c82\u0c9c\u0cc6 5\u0c97\u0c82 \u2013 17/02/2026 \u0cb0\u0cbe\u0ca4\u0ccd\u0cb0\u0cbf 10\u0c97\u0c82)\n    \u2022 \u0cae\u0cbe\u0cb0\u0ccd\u0c9a\u0ccd 2026 : \u0cae\u0cbe\u0cb8\u0cbf\u0c95 \u0caa\u0cc2\u0c9c\u0cc6 - \u0cae\u0cc0\u0ca8\u0c82 (14/03/2026 \u0cb8\u0c82\u0c9c\u0cc6 5\u0c97\u0c82 \u2013 19/03/2026 \u0cb0\u0cbe\u0ca4\u0ccd\u0cb0\u0cbf 10\u0c97\u0c82)\n    \u2022 \u0cae\u0cbe\u0cb0\u0ccd\u0c9a\u0ccd 2026 : \u0cb6\u0cac\u0cb0\u0cbf\u0cae\u0cb2\u0cc6 \u0c89\u0ca4\u0ccd\u0cb8\u0cb5 (22/03/2026 \u0cb8\u0c82\u0c9c\u0cc6 5\u0c97\u0c82 \u2013 01/04/2026 \u0cb0\u0cbe\u0ca4\u0ccd\u0cb0\u0cbf 10\u0c97\u0c82)\n    \u2022 \u0cae\u0cbe\u0cb0\u0ccd\u0c9a\u0ccd 2026 : \u0c95\u0cca\u0ca1\u0cbf\u0caf\u0cc7\u0c9f\u0ccd\u0c9f\u0cc1 (\u0ca7\u0ccd\u0cb5\u0c9c\u0cbe\u0cb0\u0ccb\u0cb9\u0ca3) (23/03/2026)\n    \u2022 \u0c8f\u0caa\u0ccd\u0cb0\u0cbf\u0cb2\u0ccd 2026 : \u0caa\u0c82\u0c97\u0cc1\u0ca8\u0cbf \u0c89\u0ca4\u0ccd\u0ca4\u0cb0\u0c82 & \u0c86\u0cb0\u0cbe\u0c9f\u0ccd\u0c9f\u0cc1 (01/04/2026 \u2013 01/04/2026 \u0cb0\u0cbe\u0ca4\u0ccd\u0cb0\u0cbf 10\u0c97\u0c82)\n    \u2022 \u0c8f\u0caa\u0ccd\u0cb0\u0cbf\u0cb2\u0ccd 2026 : \u0cae\u0cc7\u0ca1 \u0cb5\u0cbf\u0cb7\u0cc1 \u0cb9\u0cac\u0ccd\u0cac (11/04/2026 \u0cb8\u0c82\u0c9c\u0cc6 5\u0c97\u0c82 \u2013 18/04/2026 \u0cb0\u0cbe\u0ca4\u0ccd\u0cb0\u0cbf 10\u0c97\u0c82)\n    \u2022 \u0c8f\u0caa\u0ccd\u0cb0\u0cbf\u0cb2\u0ccd 2026 : \u0cb5\u0cbf\u0cb7\u0cc1 \u0ca6\u0cbf\u0ca8 (15/04/2026)\n    \u2022 \u0cae\u0cc7 2026 : \u0cae\u0cbe\u0cb8\u0cbf\u0c95 \u0caa\u0cc2\u0c9c\u0cc6 - \u0c8e\u0ca1\u0cb5\u0cae\u0ccd (14/05/2026 \u0cb8\u0c82\u0c9c\u0cc6 5\u0c97\u0c82 \u2013 19/05/2026 \u0cb0\u0cbe\u0ca4\u0ccd\u0cb0\u0cbf 10\u0c97\u0c82)\n    \u2022 \u0cae\u0cc7 2026 : \u0caa\u0ccd\u0cb0\u0ca4\u0cbf\u0cb7\u0ccd\u0ca0\u0cbe\u0caa\u0ca8\u0cbe \u0caa\u0cc2\u0c9c\u0cc6 (25/05/2026 \u2013 26/05/2026)\n    \u2022 \u0c9c\u0cc2\u0ca8\u0ccd 2026 : \u0cae\u0cbe\u0cb8\u0cbf\u0c95 \u0caa\u0cc2\u0c9c\u0cc6 - \u0cae\u0cbf\u0ca5\u0cc1\u0ca8\u0c82 (14/06/2026 \u0cb8\u0c82\u0c9c\u0cc6 5\u0c97\u0c82 \u2013 19/06/2026 \u0cb0\u0cbe\u0ca4\u0ccd\u0cb0\u0cbf 10\u0c97\u0c82)\n    \u2022 \u0c9c\u0cc1\u0cb2\u0cc8 2026 : \u0cae\u0cbe\u0cb8\u0cbf\u0c95 \u0caa\u0cc2\u0c9c\u0cc6 - \u0c95\u0cb0\u0ccd\u0c95\u0c9f\u0c95\u0c82 (16/07/2026 \u0cb8\u0c82\u0c9c\u0cc6 5\u0c97\u0c82 \u2013 21/07/2026 \u0cb0\u0cbe\u0ca4\u0ccd\u0cb0\u0cbf 10\u0c97\u0c82)\n    \u2022 \u0c86\u0c97\u0cb8\u0ccd\u0c9f\u0ccd 2026 : \u0cae\u0cbe\u0cb8\u0cbf\u0c95 \u0caa\u0cc2\u0c9c\u0cc6 - \u0c9a\u0cbf\u0c82\u0c97\u0c82 (16/08/2026 \u0cb8\u0c82\u0c9c\u0cc6 5\u0c97\u0c82 \u2013 21/08/2026 \u0cb0\u0cbe\u0ca4\u0ccd\u0cb0\u0cbf 10\u0c97\u0c82)\n    \u2022 \u0c86\u0c97\u0cb8\u0ccd\u0c9f\u0ccd 2026 : \u0c93\u0ca3\u0c82 \u0caa\u0cc2\u0c9c\u0cc6 (24/08/2026 \u2013 28/08/2026)\n    \u2022 \u0c86\u0c97\u0cb8\u0ccd\u0c9f\u0ccd 2026 : \u0c93\u0ca3\u0c82 \u0ca6\u0cbf\u0ca8 (26/08/2026)\n    \u2022 \u0cb8\u0cc6\u0caa\u0ccd\u0c9f\u0cc6\u0c82\u0cac\u0cb0\u0ccd 2026 : \u0cae\u0cbe\u0cb8\u0cbf\u0c95 \u0caa\u0cc2\u0c9c\u0cc6 - \u0c95\u0ca8\u0ccd\u0ca8\u0cbf (16/09/2026 \u0cb8\u0c82\u0c9c\u0cc6 5\u0c97\u0c82 \u2013 21/09/2026 \u0cb0\u0cbe\u0ca4\u0ccd\u0cb0\u0cbf 10\u0c97\u0c82)\n    \u2022 \u0c85\u0c95\u0ccd\u0c9f\u0ccb\u0cac\u0cb0\u0ccd 2026 : \u0cae\u0cbe\u0cb8\u0cbf\u0c95 \u0caa\u0cc2\u0c9c\u0cc6 - \u0ca4\u0cc1\u0cb2\u0cbe\u0c82 (17/10/2026 \u0cb8\u0c82\u0c9c\u0cc6 5\u0c97\u0c82 \u2013 22/10/2026 \u0cb0\u0cbe\u0ca4\u0ccd\u0cb0\u0cbf 10\u0c97\u0c82)\n    \u2022 \u0ca8\u0cb5\u0cc6\u0c82\u0cac\u0cb0\u0ccd 2026 : \u0cb6\u0ccd\u0cb0\u0cc0 \u0c9a\u0cbf\u0ca4\u0ccd\u0ca4\u0cbf\u0cb0 \u0c86\u0c9f\u0ccd\u0c9f \u0ca4\u0cbf\u0cb0\u0cc1\u0ca8\u0cbe\u0cb3\u0ccd (06/11/2026 \u0cb8\u0c82\u0c9c\u0cc6 5\u0c97\u0c82 \u2013 07/11/2026 \u0cb0\u0cbe\u0ca4\u0ccd\u0cb0\u0cbf 10\u0c97\u0c82)\n    \u2022 \u0ca8\u0cb5\u0cc6\u0c82\u0cac\u0cb0\u0ccd 2026 : \u0cae\u0c82\u0ca1\u0cb2 \u0caa\u0cc2\u0c9c\u0cc6 \u0cae\u0cb9\u0ccb\u0ca4\u0ccd\u0cb8\u0cb5 (16/11/2026 \u0cb8\u0c82\u0c9c\u0cc6 5\u0c97\u0c82 \u2013 27/12/2026)\n    \u2022 \u0ca1\u0cbf\u0cb8\u0cc6\u0c82\u0cac\u0cb0\u0ccd 2026 : \u0cae\u0c82\u0ca1\u0cb2 \u0caa\u0cc2\u0c9c\u0cc6 (27/12/2026)\n    \u2022 \u0ca1\u0cbf\u0cb8\u0cc6\u0c82\u0cac\u0cb0\u0ccd 2026 : \u0ca4\u0cbf\u0cb0\u0cc1\u0ca8\u0ca1\u0cc8 \u0ca4\u0cbf\u0cb0\u0caa\u0ccd\u0caa\u0cc1 - \u0cae\u0c95\u0cb0\u0cb5\u0cbf\u0cb3\u0c95\u0ccd\u0c95\u0cc1 \u0cae\u0cb9\u0ccb\u0ca4\u0ccd\u0cb8\u0cb5 (30/12/2026 \u2013 20/01/2027)\n    \u2022 \u0c9c\u0ca8\u0cb5\u0cb0\u0cbf 2027 : \u0cae\u0c95\u0cb0\u0cb5\u0cbf\u0cb3\u0c95\u0ccd\u0c95\u0cc1 \u0ca6\u0cbf\u0ca8 (14/01/2027)\n    \n    [ \u0c97\u0cae\u0ca8\u0cbf\u0cb8\u0cbf ]\n    \u0cb6\u0cac\u0cb0\u0cbf\u0cae\u0cb2\u0cc6 \u0ca6\u0cc7\u0cb5\u0cbe\u0cb2\u0caf\u0cb5\u0cc1 \u0cb8\u0cbe\u0cae\u0cbe\u0ca8\u0ccd\u0caf\u0cb5\u0cbe\u0c97\u0cbf \u0cac\u0cc6\u0cb3\u0cbf\u0c97\u0ccd\u0c97\u0cc6 05.00 \u0c97\u0c82\u0c9f\u0cc6\u0c97\u0cc6 \u0ca4\u0cc6\u0cb0\u0cc6\u0caf\u0cc1\u0ca4\u0ccd\u0ca4\u0ca6\u0cc6 \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0cb0\u0cbe\u0ca4\u0ccd\u0cb0\u0cbf 10.00 \u0c97\u0c82\u0c9f\u0cc6\u0c97\u0cc6 \u0cae\u0cc1\u0c9a\u0ccd\u0c9a\u0cb2\u0ccd\u0caa\u0ca1\u0cc1\u0ca4\u0ccd\u0ca4\u0ca6\u0cc6. \u0cae\u0c95\u0cb0\u0cb5\u0cbf\u0cb3\u0c95\u0ccd\u0c95\u0cc1 \u0cae\u0cb9\u0ccb\u0ca4\u0ccd\u0cb8\u0cb5\u0ca6\u0c82\u0ca4\u0cb9 \u0c9c\u0ca8\u0ca6\u0c9f\u0ccd\u0c9f\u0ca3\u0cc6\u0caf \u0cb8\u0cae\u0caf\u0ca6\u0cb2\u0ccd\u0cb2\u0cbf \u0cb9\u0cc6\u0c9a\u0ccd\u0c9a\u0cbf\u0ca8 \u0cad\u0c95\u0ccd\u0ca4\u0cb0\u0cbf\u0c97\u0cc6 \u0c85\u0ca8\u0cc1\u0c95\u0cc2\u0cb2\u0cb5\u0cbe\u0c97\u0cc1\u0cb5\u0c82\u0ca4\u0cc6 \u0cb8\u0cae\u0caf \u0cac\u0ca6\u0cb2\u0cbe\u0cb5\u0ca3\u0cc6 \u0c87\u0cb0\u0cac\u0cb9\u0cc1\u0ca6\u0cc1.",isAudio:!1,audioDurationSec:40,totalTime:"00:40"}],en:[{id:"1",slug:"2026-uthara-nakshatra-dates",title:"2026 Uthara Nakshatra Dates",description:"[ 2026 Uthara Nakshatra Dates ]\n\nSwamiye Saranam Ayyappa! The birth star of Lord Sri Ayyappa is Uthara (Uttara Phalguni). Specifically, Lord Ayyappa manifested on the Uthara Nakshatra day in the Meena month (Kerala calendar). Uthara Nakshatra recurs approximately once every 27 days.\n\nFor devotees who wish to perform sacred Ayyappa Pooja and Abhishekam on Uthara Nakshatra, the exact monthly dates for the year 2026 are provided below.\n\nIn some months, Uthara Nakshatra occurs twice (once at the beginning of the month and again towards the end of the month). In 2026, both April and December have two Uthara Nakshatra dates.\n\nSwamiye Saranam Ayyappa - April 1, 2026: Pamba Arattu & Sri Ayyappa Swamy Jayanthi.\n\n| No | Date | Day | Nakshatram |\n| 1 | 8-1-2026 | Thursday | Uthara |\n| 2 | 5-2-2026 | Thursday | Uthara |\n| 3 | 5-3-2026 | Thursday | Uthara |\n| 4 | 1-4-2026 | Wednesday | Uthara |\n| 5 | 28-4-2026 | Tuesday | Uthara |\n| 6 | 25-5-2026 | Monday | Uthara |\n| 7 | 22-6-2026 | Monday | Uthara |\n| 8 | 19-7-2026 | Sunday | Uthara |\n| 9 | 15-8-2026 | Saturday | Uthara |\n| 10 | 12-9-2026 | Saturday | Uthara |\n| 11 | 09-10-2026 | Friday | Uthara |\n| 12 | 05-11-2026 | Thursday | Uthara |\n| 13 | 03-12-2026 | Thursday | Uthara |\n| 14 | 30-12-2026 | Wednesday | Uthara |",isAudio:!1,audioDurationSec:40,totalTime:"00:40"},{id:"2",slug:"suprabatham",title:"Suprabatham",description:"Kausalya supraja Rama poorva sandhya pravartate...",isAudio:!0,audioDurationSec:40,totalTime:"00:40",chantLyric:"Harivarasanam Viswamohanam Haridadheeswaram Aaradhyapadukam"},{id:"3",slug:"nithya-paarayana-shlokamulu",title:"Nithya Paarayana Shlokamulu",description:"[ Daily Devotional Slokas ]\n    \n    (Morning Prayers)\n    \n    Suklambaradharam Vishnum Sasivarnam Chaturbhujam\n    Prasanna Vadanam Dhyayet Sarva Vighnopashantaye\n    \n    Gururbrahma Gururvishnuh Gururdevo Maheswarah\n    Gurus Sakshat Param Brahma Tasmai Sri Gurave Namah\n    \n    Karagre Vasate Lakshmi Kara Madhye Saraswati\n    Karamule Sthita Gouri Prabhate Karadarshanam\n    \n    Samudra Vasane Devi Parvata Sthana Mandale\n    Vishnupatni Namastubhyam Pada Sparsham Kshamasvame\n    \n    Brahma Murari Stripurantakari\n    Bhanuh Sasi Bhumisuto Budhascha\n    Guruscha Sukrah Sani Rahu Ketavah\n    Kurvantu Sarve Mama Suprabhatam\n    \n    [ Sri Ayyappa Gayatri Mantram ]\n    Om Bhoothanathaaya Vidmahe Bhavaputraaya Dheemahi\n    Tanno Sastha Prachodayaat\n    \n    Om Sri Swamiye Saranam Ayyappa!",isAudio:!1,audioDurationSec:40,totalTime:"00:40"},{id:"4",slug:"poojalu-vrathaalu",title:"Poojalu Vrathaalu",description:"[ Ayyappa Poojas & Vrata Rules ]\n    \n    The Mandala Deeksha (41 days) of Lord Sri Ayyappa is one of the most sacred observances in Sanatana Dharma.\n    \n    [ Key Vrata Disciplines ]\n    \u2022 Cold water bath twice daily (early morning & evening before sunset).\n    \u2022 Daily morning and evening prayer, Sharanu Gosha, and Mangala Harathi.\n    \u2022 Strict sattvic vegetarian food once a day.\n    \u2022 Wearing traditional black, blue, or saffron/ochre clothes.\n    \u2022 Viewing every living being as the embodiment of Swamy, addressing all as 'Swamy'.\n    \u2022 Strict celibacy (Brahmacharya) in thought, word, and deed.\n    \u2022 Walking barefoot without footwear throughout the deeksha period.\n    \u2022 Sleeping on mats on the floor.\n    \n    [ Padi Pooja ]\n    The sacred worship of the 18 holy steps (Pathinettampadi), lighting ghee lamps on each step accompanied by resonant vedic chants and bhajans.\n    \n    Swamiye Saranam Ayyappa!",isAudio:!1,audioDurationSec:40,totalTime:"00:40"},{id:"5",slug:"maaladharana-mantram",title:"Maaladharana Mantram",description:"gnaanamudraam shaastrumudraam\n    gurumudraam namaamyaham\n    \n    Vanamudraam Shuddhamudraam\n    Rudramudraam namaamyaham\n    \n    Shaantamudraam satyamudraam\n    Vratamudraam Namaamyaham\n    \n    Shabaryaashrama satyena mudraam paatu sadaapi mae\n    \n    Gurudakshinayaa poorvam tasyaanugraha kaarine\n    Sharanaagata mudraakhyam tvan mudraam dharayayaamyaham\n    \n    Chinmudraam khechareemudraam bhadramudraam namaamyaham\n    Shabaryaachala mudraayai namastubhyam namo namaha\n    \n    Mala Visarjana Mantram\n    \n    Apoorvam Achalam Rohaa\n    Divya darshan\n    Sastre Mudrath Matha Devaa\n    Dehime Vritha Mochanam\n    \n    Om Sri Swami Sharanam Ayyappa\n    \n    Ayyappa Deeksha Years & Swamy Titles:\n    \n    \u2022 1st Year: KANNI SWAMY (The Swamy who takes Ayyappa Deeksha first time)\n    \u2022 2nd Year: KATHI SWAMY\n    \u2022 3rd Year: GANTA SWAMY\n    \u2022 4th Year: GADHA SWAMY\n    \u2022 5th Year: PERU SWAMY\n    \u2022 6th Year: JYOTI SWAMY\n    \u2022 7th Year: SURYA SWAMY\n    \u2022 8th Year: CHANDRA SWAMY\n    \u2022 9th Year: TRISHULA SWAMY\n    \u2022 10th Year: VISHNU CHAKRA SWAMY\n    \u2022 11th Year: SHANKADHARA SWAMY\n    \u2022 12th Year: NAGABHARANA SWAMY\n    \u2022 13th Year: SRIHARI SWAMY\n    \u2022 14th Year: SRI SWAMY\n    \u2022 15th Year: SRI SWAMY\n    \u2022 16th Year: SRI SABARI (RATHIGIRI) SWAMY\n    \u2022 17th Year: OMKAARA SWAMY\n    \u2022 18th Year: NAARIKELA SWAMY",isAudio:!1,audioDurationSec:40,totalTime:"00:40"},{id:"6",slug:"sri-ayyappa-sharanu-gosha",title:"Sri Ayyappa Sharanu Gosha",description:"Om Shree Svaamiye Sharanamayyappa\n    Hari Hara Sutane Sharanamayyappa\n    Aapadbhaandavane Sharanamayyappa\n    Anaadharakshakane Sharanamayyappa\n    Akhilaanda Koti Brahmaandanaayakane Sharanamayyappa\n    Annadaana Prabhuve Sharanamayyappa\n    Ayyappane Sharanamayyappa\n    Ariyaangaavu Ayyaave Sharanamayyappa\n    Aarchan Kovil Arane Sharanamayyappa\n    Kulattapulai Baalakane Sharanamayyappa\n    Erumeli Shaastane Sharanamayyappa\n    Vaavarusvaamine Sharanamayyappa\n    Kannimoola Mahaa Ganapatiye Sharanamayyappa\n    Naagaraajave Sharanamayyappa\n    Maalikaapuratta lokadevi Maataaye Sharanamayyappa\n    Kuruppa Svaamiye Sharanamayyappa\n    Sevippa Varkaananda Moortiye Sharanamayyappa\n    Kaashivaasi Ye Sharanamayyappa\n    Hari Dvaara Nivaasiye Sharanamayyappa\n    Shree Rangapattana Vaasiye Sharanamayyappa\n    Karuppatoor Vaasiye Sharanamayyappa\n    palamooru Dharmashaastaave Sharanamayyappa\n    Sadguru Naadhane Sharanamayyappa\n    Vilaali Veerane Sharanamayyappa\n    Veeramanikantane Sharanamayyappa\n    Dharma Shaastrave Sharanamayyappa\n    Sharanugoshapriyave Sharanamayyappa\n    Kaanti Malai Vaasane Sharanamayyappa\n    Ponnambalavaasiye Sharanamayyappa\n    Pandalashishuve Sharanamayyappa\n    Vaavarin Tolane Sharanamayyappa\n    Mohineesutave Sharanamayyappa\n    Kan Kanda Daivame Sharanamayyappa\n    Kaliyugavaradane Sharanamayyappa\n    Sarvaroga Nivaarana Dhanvantara Moortiye Sharanamayyappa\n    Mahishimardanane Sharanamayyappa\n    Poorna Pushkala Naadhane Sharanamayyappa\n    Van Puli Vaahanane Sharanamayyappa\n    Baktavatsalane Sharanamayyappa\n    Bhoolokanaadhane Sharanamayyappa\n    Ayindumalaivaasave Sharanamayyappa\n    Shabari Giree Shane Sharanamayyappa\n    Irumudi Priyane Sharanamayyappa\n    Abhishekapriyane Sharanamayyappa\n    Vedapporuleene Sharanamayyappa\n    Nitya Brahma Chaarine Sharanamayyappa\n    Sarva Mangaladaayakane Sharanamayyappa\n    Veeraadhiveerane Sharanamayyappa\n    Omkaarapporule Sharanamayyappa\n    Aanandaroopane Sharanamayyappa\n    Bhakta Chittaadivaasane Sharanamayyappa\n    Aashritavatsa Lane Sharanamayyappa\n    Bhoota Ganaadipataye Sharanamayyappa\n    Shaktiroo Pane Sharanamayyappa\n    Naagaarjunasagarudharma Shaastave Sharanamayyappa\n    Shaantamoortaye Sharanamayyappa\n    Padunelbaabadikki Adhipatiye Sharanamayyappa\n    Kattaala Visharaaramene Sharanamayyappa\n    Rishikula Rakshakune Sharanamayyappa\n    Vedapriyane Sharanamayyappa\n    Uttaraanakshatra Jaatakane Sharanamayyappa\n    Tapodhanane Sharanamayyappa\n    Yangalakula Daivame Sharanamayyappa\n    Jaganmohane Sharanamayyappa\n    Mohanaroopane Sharanamayyappa\n    Maadhavasutane Sharanamayyappa\n    Yadukulaveerane Sharanamayyappa\n    Maamalai Vaasane Sharanamayyappa\n    Shanmukhasodara Ne Sharanamayyappa\n    Vedaantaroopane Sharanamayyappa\n    Shankara Sutane Sharanamayyappa\n    Shatrusamhaarine Sharanamayyappa\n    Sadgunamoortaye Sharanamayyappa\n    Paraashaktiye Sharanamayyappa\n    Paraatparane Sharanamayyappa\n    Paranjyotiye Sharanamayyappa\n    Homapriyane Sharanamayyappa\n    Ganapati Sodara Ne Sharanamayyappa\n    Dharma Shaastraave Sharanamayyappa\n    Vishnusutane Sharanamayyappa\n    Sakala Kalaa Vallabhane Sharanamayyappa\n    Loka Rakshakane Sharanamayyappa\n    Amita Gunaakarane Sharanamayyappa\n    Alankaara Priyane Sharanamayyappa\n    Kanni Maarai Kappavane Sharanamayyappa\n    Bhuvaneshvarane Sharanamayyappa\n    Maataapitaa Gurudaivame Sharanamayyappa\n    Svaamiyin Pungaavaname Sharanamayyappa\n    Aludaanadiye Sharanamayyappa\n    Aludaamede Sharanamayyappa\n    Kallidrankundre Sharanamayyappa\n    Karimalaie Trame Sharanamayyappa\n    Karimalai Erakkame Sharanamayyappa\n    Periyaan Vattame Sharanamayyappa\n    Cheriyaana Vattame Sharanamayyappa\n    Pambaanadiye Sharanamayyappa\n    Pambayil Veellakke Sharanamayyappa\n    Neelimalai Ye Trame Sharanamayyappa\n    Appaachi Mede Sharanamayyappa\n    Shabaripeetame Sharanamayyappa\n    Sharam Gutti Aale Sharanamayyappa\n    Bhasmakulame Sharanamayyappa\n    Padunettaam Badiye Sharanamayyappa\n    Neyyeebhi Shekapriyane Sharanamayyappa\n    Karpoora Jyotiye Sharanamayyappa\n    Jyotisvaroopane Sharanamayyappa\n    Makara Jyotiye Sharanamayyappa\n    Pandala Raaja Kumaarane Sharanamayyappa",isAudio:!1,audioDurationSec:40,totalTime:"00:40"},{id:"7",slug:"nithyapooja",title:"\u0c28\u0c3f\u0c24\u0c4d\u0c2f \u0c2a\u0c42\u0c1c (\u0c32\u0c18\u0c41 \u0c35\u0c3f\u0c27\u0c3e\u0c28\u0c02)",description:"",isAudio:!1,audioDurationSec:40,totalTime:"00:40"},{id:"8",slug:"slogans-of-sri-ayyappa-swami",title:"Stotramulu",description:"Swaami Sharanam \u2013 Ayyappa Sharanam\n    Bhagavaan Sharanam \u2013 Bhagavati Sharanam\n    Devan Sharanam \u2013 Devee Sharanam\n    Devan Paadam \u2013 Devee Paadam\n    Swaami Paadam \u2013 Ayyappa Paadam\n    Bhagavaane \u2013 Bhagavatiye\n    Eeshvarane \u2013 Eeshvariye\n    Devane \u2013 Deviye\n    Shaktane \u2013 Shaktiye\n    Swaamiye \u2013 Ayyapo\n    Pallikattu \u2013 Shabarimalakku\n    Irumudikattu \u2013 Shabarimalakku\n    Kattunkattu \u2013 Shabarimalakku\n    Kallummullum \u2013 Kaalikimettai\n    Ettividayyaa \u2013 Tookikkavidayyaa\n    Dehabalandaa \u2013 Paadabalandaa\n    Yaaraikaana \u2013 Swaamiyaikaana\n    Swaamiyaikandaal \u2013 Mokshankittum\n    Swaamimaare \u2013 Ayyappamaare\n    Neyyaabhishekam \u2013 Swaamikke\n    Karpooradeepam \u2013 Swaamikke\n    Paalaabhishekam \u2013 Swaamikke\n    Bhasmaabhishekam \u2013 Swaamikke\n    Tenaabhishekam \u2013 Swaamikke\n    Chandanaabhishekam \u2013 Swaamikke\n    Poolaabhishekam \u2013 Swaamikke\n    Panneeraabhishekam \u2013 Swaamikke\n    Pambaashisuve \u2013 Ayyappaa\n    Kaananavaasaa \u2013 Ayyappaa\n    Shabarigireeshaa \u2013 Ayyappaa\n    Pandalaraajaa \u2013 Ayyappaa\n    Pambaavaasaa \u2013 Ayyappaa\n    Vanpulivaahana \u2013 Ayyappaa\n    Sundararoopaa \u2013 Ayyappaa\n    Shanmugasodara \u2013 Ayyappaa\n    Mohinitanayaa \u2013 Ayyappaa\n    Ganeshasodara \u2013 Ayyappaa\n    Hariharatanayaa \u2013 Ayyappaa\n    Anaadharakshaka \u2013 Ayyappaa\n    Sadgurunaathaa \u2013 Ayyappaa\n    Swaamiye \u2013 Ayyappo\n    Ayyappo \u2013 Swaamiye\n    Swaami Sharanam \u2013 Ayyappa Sharanam",isAudio:!1,audioDurationSec:40,totalTime:"00:40"},{id:"9",slug:"pooja-poorvaangamu",title:"Pooja Poorvaangamu",description:"[ Pooja Poorvaangam - Preliminary Rituals ]\n    \n    Essential initial rites performed before commencing daily worship:\n    \n    [ 1. Achamanam ]\n    Om Keshavaya Swaha (sip water)\n    Om Narayanaya Swaha (sip water)\n    Om Madhavaya Swaha (sip water)\n    Om Govindaya Namaha (cleanse hands)\n    Om Vishnave Namaha, Om Madhusudanaya Namaha...\n    \n    [ 2. Pranayamam ]\n    Om Bhuh, Om Bhuvah, Om Suvah, Om Mahah, Om Janah, Om Tapah, Om Satyam...\n    Om Tatsavitur Varenyam Bhargo Devasya Dheemahi Dhiyo Yo Nah Prachodayaat.\n    \n    [ 3. Sankalpam ]\n    Dedication of the holy prayer for inner purification and seeking the divine grace of Lord Ganesha and Lord Sri Ayyappa.\n    \n    [ 4. Kalasha Pooja ]\n    Invocation of sacred rivers: Ganga, Yamuna, Godavari, Saraswati, Narmada, Sindhu, and Cauvery into the holy kalash water.\n    \n    Om Sri Swamiye Saranam Ayyappa!",isAudio:!1,audioDurationSec:40,totalTime:"00:40"},{id:"10",slug:"sri-vigneshwara-ashtottara",title:"Sri Mahaganapathi",description:"[ Sri vighneshwara Anga Pooja ]\n    \u014d\u1e41 p\u0101rvat\u012b nandan\u0101ya nama\u1e25 - p\u0101dau p\u016bjay\u0101mi\n    \u014d\u1e41 \u015br\u012b ga\u1e47\u0113\u015b\u0101ya nama\u1e25 - gulphau p\u016bjay\u0101mi\n    \u014d\u1e41 j\u0101dhid\u0101tr\u0113 nama\u1e25 - ja\u1e45gh\u0113 p\u016bjay\u0101mi\n    \u014d\u1e41 jagadvallabh\u0101ya nama\u1e25 - \u016b'ru p\u016bjay\u0101mi\n    \u014d\u1e41 vika\u1e6d\u0101ya nama\u1e25 - ka\u1e6di\u1e41 p\u016bjay\u0101mi\n    \u014d\u1e41 guh\u0101graj\u0101ya nama\u1e25 - guhya\u1e41 p\u016bjay\u0101mi\n    \u014d\u1e41 mahattam\u0101ya mana\u1e25 - m\u0113\u1e0dhra\u1e41 p\u016bjay\u0101mi\n    \u014d\u1e41 ga\u1e47an\u0101th\u0101ya nama\u1e25 - n\u0101bhi\u1e41 p\u016bjay\u0101mi\n    \u014d\u1e41 uttam\u0101ya nama\u1e25 - udara\u1e41 p\u016bjay\u0101mi\n    \u014d\u1e41 vin\u0101yak\u0101ya nama\u1e25 - vak\u1e63asthala\u1e41 p\u016bjay\u0101mi\n    \u014d\u1e41 p\u0101\u015ba\u015bcid\u0113 nama\u1e25 - p\u0101r\u015bv\u0113 p\u016bjay\u0101mi\n    \u014d\u1e41 h\u0113rambh\u0101ya nama\u1e25 - h\u1e5bdaya\u1e41 p\u016bjay\u0101mi\n    \u014d\u1e41 kapil\u0101ya nama\u1e25 - ka\u1e47\u1e6dha\u1e41 p\u016bjay\u0101mi\n    \u014d\u1e41 skandh\u0101graj\u0101ya nama\u1e25 - skandhau p\u016bjay\u0101mi\n    \u014d\u1e41 harasut\u0101ya nama\u1e25 - hast\u0101n p\u016bjay\u0101mi\n    \u014d\u1e41 brahmac\u0101ri\u1e47\u0113 nama\u1e25 - b\u0101h\u016bn p\u016bjay\u0101mi\n    \u014d\u1e41 sumukh\u0101ya nama\u1e25 - mukha\u1e41 p\u016bjay\u0101mi\n    \u014d\u1e41 \u0113kadant\u0101ya - dantau p\u016bjay\u0101mi\n    \u014d\u1e41 vighnahantr\u0113 nama\u1e25 - n\u0113tr\u0113 p\u016bjay\u0101mi\n    \u014d\u1e41 \u015b\u016brpakar\u1e47\u0101ya - kar\u1e47au p\u016bjay\u0101mi\n    \u014d\u1e41 ph\u0101lacandr\u0101ya nama\u1e25 - kap\u0101la\u1e41 p\u016bjay\u0101mi\n    \u014d\u1e41 n\u0101g\u0101bhara\u1e47\u0101ya nama\u1e25 - n\u0101sik\u0101\u1e41 p\u016bjay\u0101mi\n    \u014d\u1e41 cirantan\u0101ya nama\u1e25 - cubuka\u1e41 p\u016bjay\u0101mi\n    \u014d\u1e41 st\u016bl\u014d\u1e63\u1e6dh\u0101ya nama\u1e25 - au\u1e63\u1e6dhau p\u016bjay\u0101mi\n    \u014d\u1e41 ka\u013camanda\u0101ya nama\u1e25 - ka\u1e47\u1e6dhau p\u016bjay\u0101mi\n    \u014d\u1e41 kapil\u0101ya nama\u1e25 - k\u0101c\u0101n p\u016bjay\u0101mi\n    \u014d\u1e41 \u015biva priy\u0101ya nama\u1e25 - \u015bira\u1e25 p\u016bjay\u0101mi\n    \u014d\u1e41 sarvama\u1e45ga\u013ca sut\u0101ya nama\u1e25 - sarv\u0101\u1e47ya\u1e45g\u0101ni p\u016bjay\u0101mi\n    \n    [ Sri Vigneshwara Ashtottara Sata Namavali ]\n    om vinaayakaaya namah\n    om vighnaraajaaya namah\n    om gouriputraaya namah\n    om ganeshvaraaya namah\n    om skandaagrajaaya namah\n    om avyayaaya namah\n    om pooshaaya namah\n    om dakshaaya namah\n    om adhyakshaaya namah\n    om dvija priyaaya namah\n    om agni garbhacchide namah\n    om indra shree pradaaya namah\n    om vaanee pradaaya namah\n    om avyayaaya namah\n    om sarvasiddhipradaaya namah\n    om sharva tanayaaya namah\n    om sharvaree priyaaya namah\n    om sarvaatmakaaya namah\n    om srushtikartaaya namah\n    om devaanekaarchitaaya namah\n    om shivaaya namah\n    om shuddhaaya namah\n    om buddhipradaya namah\n    om shaantaaya namah\n    om brahmachaarine namah\n    om gajaananaaya namah\n    om dvaimaaturaaya namah\n    om munisyuttyaaya namah\n    om bhakta vighna vinaashaaya namah\n    om eka dantaaya namah\n    om chaturbhaahave namah\n    om chaturaaya namah\n    om shakti samyutaaya namah\n    om lambodaraaya namah\n    om shoorpakarnaaya namah\n    om harirbrahmavide namah\n    om uttamaaya namah\n    om kaalaaya namah\n    om grahapataye namah\n    om kaamine namah\n    om soma suraagni lochanaaya namah\n    om paashaankushadharaaya namah\n    om chandaaya namah\n    om gunaateetaaya namah\n    om niranjanaaya namah\n    om akalmashaaaya namah\n    om svayamsiddhaaya namah\n    om siddaarchita padaambujaaya namah\n    om beejaapura falasaktaaya namah\n    om varadaaya namah\n    om shaashvataaya namah\n    om krutine namah\n    om dvi japriyaya namah\n    om veeta bhayaaya namah\n    om gadine namah\n    om chakrine namah\n    om ikshu chaapadhrute namah\n    om shreedaayine namah\n    om ajaaya namah\n    om utpalakaraaya namah\n    om sreepataye namah\n    om stuti harshitaaya namah\n    om kulaadribhedine namah\n    om jatilaaya namah\n    om kalikalmaashanaashaaya namah\n    om chandrachoodaamanaye namah\n    om kaantaaya namah\n    om paapaharine namah\n    om samaahitaaya namah\n    om aashrita shreekaraaya namah\n    om soumyaaya namah\n    om bhakta vaanchitadaayakaaya namah\n    om shaantaaya namah\n    om kaivalyasukhadaaya namah\n    om sacchidaananda vigrahaya namah\n    om gnaanine namah\n    om dayaayutaaya namah\n    om daantaaya namah\n    om brahmanye namah\n    om dveshavivarjitaaya namah\n    om pramattadaitya bhayadaaya namah\n    om shreekanthaaya namah\n    om vibudheshvaraaya namah\n    om ramaarchitaaya namah\n    om vidhine namah\n    om naagaraaja yagnopaveetine namah\n    om sthoolakanthaaya namah\n    om svayamkartaaya namah\n    om saama ghoshapriyaaya namah\n    om paraaya namah\n    om sthoolatundaaya namah\n    om agranine namah\n    om dheeraayaa namah\n    om vaageeshaaya namah\n    om siddhidaayakaaya namah\n    om doorvaabilvapriyaaya namah\n    om avyakta moortaye namah\n    om adbhutamoortaye namah\n    om shailendratanujotsangaaya namah\n    om khelanotsukamaanasaaya namah\n    om svalaavanya sudhaasaara jita manmatha vigrahaaya namah\n    om samasta jagadaadhaaraaya namah\n    om maayaavine namah\n    om mooshika vaahanaaya namah\n    om hrushtaaya namah\n    om tushtaaya namah\n    om prasannaatmane namah\n    om sarvasiddhipradayakaaya namah",isAudio:!1,audioDurationSec:40,totalTime:"00:40"},{id:"11",slug:"sri-subramanya-ashtottara",title:"Sri Subrahmanyeswara",description:"[ Sri Subhramanyeswara Swamy Anga Pooja ]\n    \u014d\u1e41 valm\u012bki bhav\u0101ya nama\u1e25 - p\u0101dau p\u016bjay\u0101mi\n    \u014d\u1e41 j\u012bt\u0101sura nama\u1e25 - j\u0101nun\u012b p\u016bjay\u0101mi\n    \u014d\u1e41 raudray\u0113 nama\u1e25 - ja\u1e45gh\u0113 p\u016bjay\u0101mi\n    \u014d\u1e41 bhayan\u0101\u015ban\u0101ya nama\u1e25 - \u016b'ru p\u016bjay\u0101mi\n    \u014d\u1e41 b\u0101la grah\u014dchc\u0101\u1e6dan\u0101ya nama\u1e25 - ka\u1e6di\u1e41 p\u016bjay\u0101mi\n    \u014d\u1e41 bhakta p\u0101lan\u0101ya nama\u1e25 - n\u0101bhi\u1e41 p\u016bjay\u0101mi\n    \u014d\u1e41 sarv\u0101bh\u012b\u1e63\u1e6da prad\u0101ya nama\u1e25 - h\u1e5bdaya\u1e41 p\u016bjay\u0101mi\n    \u014d\u1e41 vi\u015b\u0101la vak\u1e63as\u0113 nama\u1e25 - vak\u1e63asthala\u1e41 p\u016bjay\u0101mi\n    \u014d\u1e41 abhayapradh\u0101na pra\u015basta hast\u0101ya nama\u1e25 - b\u0101h\u016bn p\u016bjay\u0101mi\n    \u014d\u1e41 n\u012blaka\u1e47\u1e6dha tanay\u0101ya nama\u1e25 - ka\u1e47\u1e6dha\u1e41 p\u016bjay\u0101mi\n    \u014d\u1e41 patita p\u0101van\u0101ya nama\u1e25 - cubuka\u1e41 p\u016bjay\u0101mi\n    \u014d\u1e41 puru\u1e63a\u015br\u0113\u1e63\u1e6d\u0101ya nama\u1e25 - n\u0101sik\u0101\u1e41 p\u016bjay\u0101mi\n    \u014d\u1e41 pu\u1e47yam\u016brtay\u0113 nama\u1e25 - \u015brava\u1e47\u0101ni p\u016bjay\u0101mi\n    \u014d\u1e41 kamalal\u014dcan\u0101ya nama\u1e25 - n\u0113tr\u0113 p\u016bjay\u0101mi\n    \u014d\u1e41 kast\u016bri tilak\u0101\xf1cit\u0101 ph\u0101lan\u0101ya nama\u1e25 - lal\u0101\u1e6da\u1e41 p\u016bjay\u0101mi\n    \u014d\u1e41 v\u0113davidu\u1e63\u0113 nama\u1e25 - mukha\u1e41 p\u016bjay\u0101mi\n    \u014d\u1e41 tril\u014dkagurav\u0113 nama\u1e25 - \u015bira\u1e25 p\u016bjay\u0101mi\n    \u014d\u1e41 bhasm\u014ddhdh\u016b\u1e37ita vigrah\u0101ya nama\u1e25 - sarv\u0101\u1e47ya\u1e45g\u0101ni p\u016bjay\u0101mi\n    \n    [ Sri Subramanya Ashtothara Sata Namaavali ]\n    Om Skandaya Namaha\n    Om Guhaya Namaha\n    Om Shanmukhaya Namaha\n    Om Phalanetrasutaya Namaha\n    Om Prabhave Namaha\n    Om Pingalaya Namaha\n    Om Kritikasunave Namaha\n    Om Shikivahaya Namaha\n    Om Dwishad bhujaya Namaha\n    Om Dwishan Netraya Namaha\n    Om Shaktidharaya Namaha\n    Om Pishitaasha prabhamjanaya Namaha\n    Om Tarakasura samharine Namaha\n    Om Raksobala vim