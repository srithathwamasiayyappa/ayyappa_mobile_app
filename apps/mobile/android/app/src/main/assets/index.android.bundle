c4d\u0c30\u0c24 \u0c15\u0c4b\u0c38\u0c02 \u0c26\u0c3f\u0c35\u0c4d\u0c2f \u0c28\u0c3e\u0c2e\u0c3e\u0c32\u0c41'},kn:{title:'\u0ca6\u0cc8\u0ca8\u0c82\u0ca6\u0cbf\u0ca8 \u0c86\u0ca7\u0ccd\u0caf\u0cbe\u0ca4\u0ccd\u0cae\u0cbf\u0c95 \u0cb8\u0ccd\u0cab\u0cc2\u0cb0\u0ccd\u0ca4\u0cbf',subtitle:'\u0ca6\u0cc8\u0ca8\u0c82\u0ca6\u0cbf\u0ca8 \u0c9c\u0cc0\u0cb5\u0ca8\u0c95\u0ccd\u0c95\u0cc6 \u0caa\u0cb5\u0cbf\u0ca4\u0ccd\u0cb0 \u0cae\u0c82\u0ca4\u0ccd\u0cb0\u0c97\u0cb3\u0cc1, \u0caa\u0cc2\u0c9c\u0cbe \u0cae\u0cbe\u0cb0\u0ccd\u0c97\u0ca6\u0cb0\u0ccd\u0cb6\u0cbf \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0ca6\u0cc8\u0cb5\u0cbf\u0c95 \u0c9c\u0ccd\u0c9e\u0cbe\u0ca8.',viewAll:'\u0c8e\u0cb2\u0ccd\u0cb2\u0cb5\u0ca8\u0ccd\u0ca8\u0cc2 \u0ca8\u0ccb\u0ca1\u0cbf  \u2192',harivarasanamTitle:'\u0cb9\u0cb0\u0cbf\u0cb5\u0cb0\u0cbe\u0cb8\u0ca8\u0c82',harivarasanamDesc:'\u0c85\u0caf\u0ccd\u0caf\u0caa\u0ccd\u0caa \u0cb8\u0ccd\u0cb5\u0cbe\u0cae\u0cbf \u0ca6\u0cbf\u0cb5\u0ccd\u0caf \u0cb8\u0ccd\u0ca4\u0ccb\u0ca4\u0ccd\u0cb0',poojaTitle:'\u0c85\u0caf\u0ccd\u0caf\u0caa\u0ccd\u0caa\n\u0caa\u0cc2\u0c9c\u0cbe \u0cb5\u0cbf\u0ca7\u0cbe\u0ca8',poojaDesc:'\u0cae\u0ca8\u0cc6\u0caf\u0cb2\u0ccd\u0cb2\u0cbf \u0cae\u0cbe\u0ca1\u0cc1\u0cb5 \u0caa\u0cc2\u0c9c\u0cbe \u0cae\u0cbe\u0cb0\u0ccd\u0c97\u0ca6\u0cb0\u0ccd\u0cb6\u0cbf',chantsTitle:'\u0cb6\u0cb0\u0ca3\u0c82 \u0c85\u0caf\u0ccd\u0caf\u0caa\u0ccd\u0caa\n\u0c95\u0cc0\u0cb0\u0ccd\u0ca4\u0ca8\u0cc6\u0c97\u0cb3\u0cc1',chantsDesc:'\u0cad\u0c95\u0ccd\u0ca4\u0cbf, \u0c8f\u0c95\u0cbe\u0c97\u0ccd\u0cb0\u0ca4\u0cc6\u0c97\u0cbe\u0c97\u0cbf \u0ca6\u0cbf\u0cb5\u0ccd\u0caf \u0ca8\u0cbe\u0cae\u0c97\u0cb3\u0cc1'},ta:{title:'\u0ba4\u0bbf\u0ba9\u0b9a\u0bb0\u0bbf \u0b86\u0ba9\u0bcd\u0bae\u0bc0\u0b95 \u0b89\u0ba4\u0bcd\u0bb5\u0bc7\u0b95\u0bae\u0bcd',subtitle:'\u0ba4\u0bbf\u0ba9\u0b9a\u0bb0\u0bbf \u0bb5\u0bbe\u0bb4\u0bcd\u0bb5\u0bbf\u0bb1\u0bcd\u0b95\u0bbe\u0ba9 \u0baa\u0bc1\u0ba9\u0bbf\u0ba4 \u0bae\u0ba8\u0bcd\u0ba4\u0bbf\u0bb0\u0b99\u0bcd\u0b95\u0bb3\u0bcd, \u0baa\u0bc2\u0b9c\u0bc8 \u0bb5\u0bb