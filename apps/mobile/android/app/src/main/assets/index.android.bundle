0d32\u0d4b\u0d17\u0d4d\u0d14\u0d1f\u0d4d\u0d1f\u0d4d'},logoutConfirmTitle:{en:'Logout?',te:'\u0c32\u0c3e\u0c17\u0c4c\u0c1f\u0c4d \u0c1a\u0c47\u0c2f\u0c3e\u0c32\u0c3e?',kn:'\u0cb2\u0cbe\u0c97\u0ccd\u200c\u0c94\u0c9f\u0ccd \u0cae\u0cbe\u0ca1\u0cac\u0cc7\u0c95\u0cc6?',ta:'\u0bb5\u0bc6\u0bb3\u0bbf\u0baf\u0bc7\u0bb1\u0bb5\u0bbe?',hi:'\u0932\u0949\u0917\u0906\u0909\u091f \u0915\u0930\u0947\u0902?',ml:'\u0d32\u0d4b\u0d17\u0d4d\u0d14\u0d1f\u0d4d\u0d1f\u0d4d \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d23\u0d2e\u0d4b?'},logoutConfirmDesc:{en:'Are you sure you want to logout from Saranam Ayyappa?',te:'\u0c36\u0c30\u0c23\u0c02 \u0c05\u0c2f\u0c4d\u0c2f\u0c2a\u0c4d\u0c2a \u0c2f\u0c3e\u0c2a\u0c4d \u0c28\u0c41\u0c02\u0c21\u0c3f \u0c2e\u0c40\u0c30\u0c41 \u0c16\u0c1a\u0c4d\u0c1a\u0c3f\u0c24\u0c02\u0c17\u0c3e \u0c32\u0c3e\u0c17\u0c4c\u0c1f\u0c4d \u0c05\u0c35\u0c4d\u0c35\u0c3e\u0c32\u0c28\u0c41\u0c15\u0c41\u0c02\u0c1f\u0c41\u0c28\u0c4d\u0c28\u0c3e\u0c30\u0c3e?',kn:'\u0cb6\u0cb0\u0ca3\u0c82 \u0c85\u0caf\u0ccd\u0caf\u0caa\u0ccd\u0caa \u0c85\u0caa\u0ccd\u0cb2\u0cbf\u0c95\u0cc7\u0cb6\u0ca8\u0ccd\u200c\u0ca8\u0cbf\u0c82\u0ca6 \u0ca8\u0cc0\u0cb5\u0cc1 \u0cb2\u0cbe\u0c97\u0ccd\u200c\u0c94\u0c9f\u0ccd \u0c86\u0c97\u0cb2\u0cc1 \u0cac\u0caf\u0cb8\u0cc1\u0cb5\u0cbf\u0cb0\u0cbe?',ta:'\u0b9a\u0bb0\u0ba3\u0bae\u0bcd \u0b90\u0baf\u0baa\u0bcd\u0baa\u0bbe \u0b9a\u0bc6\u0baf\u0bb2\u0bbf\u0baf\u0bbf\u0bb2\u0bcd \u0b87\u0bb0\u0bc1\u0ba8\u0bcd\u0ba4\u0bc1 \u0bb5\u0bc6\u0bb3\u0bbf\u0baf\u0bc7\u0bb1 \u0bb5\u0bbf\u0bb0\u0bc1\u0bae\u0bcd\u0baa\u0bc1\u0b95\u0bbf\u0bb1\u0bc0\u0bb0\u0bcd\u0b95\u0bb3\u0bbe?',hi:'\u0915\u094d\u092f\u093e \u0906\u092a \u0936\u0930\u0923\u092e \u0905\u092f\u094d\u092f\u092a\u094d\u092a\u093e \u0910\u092a \u0938\u0947 \u0932\u0949\u0917\u0906\u0909\u091f \u0915\u0930\u0928\u093e \u091a\u093e\u0939\u0924\u0947 \u0939\u0948\u0902?',ml:'\u0d36\u0d30\u0d23\u0d02 \u0d05\u0d2f\u0d4d\u0d2f\u0d2a\u0d4d\u0d2a \u0d06\u0d2a\u0d4d\u0d2a\u0d3f\u0d7d \u0d28\u0d3f\u0d28\u0d4d\u0d28\u0d41\u0d02 \u0d32\u0d4b\u0d17\u0d4d\u0d14\u0d1f\u0d4d\u0d1f\u0d4d \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d23\u0d2e\u0d46\u0d28\u0d4d\u0d28\u0d4d \u0d09\u0d31\u0d2a\u0d4d\u0d2a\u0d3e\u0d23\u0d4b?'},cancel:{en:'Cancel',te:'\u0c30\u0c26\u0c4d\u0c26\u0c41 \u0c1a\u0c47\u0c2f\u0c3f',kn:'\u0cb0\u0ca6\u0ccd\u0ca6\u0cc1\u0cae\u0cbe\u0ca1\u0cbf',ta:'\u0bb0\u0ba4\u0bcd\u0ba4\u0bc1 \u0b9a\u0bc6\u0baf\u0bcd',hi:'\u0930\u0926\u094d\u0926 \u0915\u0930\u0947\u0902',ml:'\u0d31\u0d26\u0d4d\u0d26\u0d3e\u0d15\u0d4d\u0d15\u0d41\u0d15'},guestDevotee:{en:'Welcome Devotee',te:'\u0c38\u0c4d\u0c35\u0c3e\u0c17\u0c24\u0c02 \u0c2d\u0c15\u0c4d\u0c24\u0c41\u0c21\u0c3e',kn:'\u0cb8\u0ccd\u0cb5\u0cbe\u0c97\u0ca4 \u0cad\u0c95\u0ccd\u0ca4\u0cb0\u0cc7',ta:'\u0bb5\u0ba3\u0b95\u0bcd\u0b95\u0bae\u0bcd \u0baa\u0b95\u0bcd\u0ba4\u0bb0\u0bc7',hi:'\u0938\u094d\u0935\u093e\u0917\u0924\u092e \u092d\u0915\u094d\u0924',ml:'\u0d38\u0d4d\u0d35\u0d3e\u0d17\u0d24\u0d02 \u0d2d\u0d15\u0d4d\u0d24\u0d1c\u0d28\u0d19\u0d4d\u0d19\u0d33\u0d46'},guestModeSubtitle:{en:'Guest Mode',te:'\u0c05\u0c24\u0c3f\u0c25\u0c3f \u0c2e\u0c4b\u0c21\u0c4d',kn:'\u0c85\u0ca4\u0cbf\u0ca5\u0cbf \u0cae\u0ccb\u0ca1\u0ccd',ta:'\u0bb5\u0bbf\u0bb0\u0bc1\u0ba8\u0bcd\u0ba4\u0bbf\u0ba9\u0bb0\u0bcd \u0bae\u0bc1\u0bb1\u0bc8',hi:'\u0905\u0924\u093f\u0925\u093f \u092e\u094b\u0921',ml:'\u0d17\u0d38\u0d4d\u0d31\u0d4d\u0d31\u0d4d \u0d2e\u0d4b\u0d21\u0d4d'},deleteAccount:{en:'Delete Account',te:'\u0c16\u0c3e\u0c24\u0c3e \u0c24\u0c4a\u0c32\u0c17\u0c3f\u0c02\u0c1a\u0c02\u0c21\u0c3f',kn:'\u0c96\u0cbe\u0ca4\u0cc6 \u0c85\u0cb3\u0cbf\u0cb8\u0cbf',ta:'\u0b95\u0ba3\u0b95\u0bcd\u0b95\u0bc8 \u0ba8\u0bc0\u0b95\u0bcd\u0b95\u0bc1',hi:'\u0916\u093e\u0924\u093e \u0939\u091f\u093e\u090f\u0902',ml:'\u0d05\u0d15\u0d4d\u0d15\u0d57\u0d23\u0d4d\u0d1f\u0d4d \u0d07\u0d32\u0d4d\u0d32\u0d3e\u0d24\u0d3e\u0d15\u0d4d\u0d15\u0d41\u0d15'},deleteAccountSubtitle:{en:'Request account & data removal',te:'\u0c16\u0c3e\u0c24\u0c3e & \u0c21\u0c47\u0c1f\u0c3e \u0c24\u0c4a\u0c32\u0c17\u0c3f\u0c02\u0c2a\u0c41 \u0c05\u0c2d\u0c4d\u0c2f\u0c30\u0c4d\u0c25\u0c28',kn:'\u0c96\u0cbe\u0ca4\u0cc6 \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0ca1\u0cc7\u0c9f\u0cbe \u0ca4\u0cc6\u0c97\u0cc6\u0ca6\u0cc1\u0cb9\u0cbe\u0c95\u0cb2\u0cc1 \u0cb5\u0cbf\u0ca8\u0c82\u0ca4\u0cbf',ta:'\u0b95\u0ba3\u0b95\u0bcd\u0b95\u0bc1 \u0bae\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd \u0ba4\u0bb0\u0bb5\u0bc1 \u0ba8\u0bc0\u0b95\u0bcd\u0b95 \u0b95\u0bcb\u0bb0\u0bbf\u0b95\u0bcd\u0b95\u0bc8',hi:'\u0916\u093e\u0924\u093e \u0914\u0930 \u0921\u0947\u091f\u093e \u0939\u091f\u093e\u0928\u0947 \u0915\u093e \u0905\u0928\u0941\u0930\u094b\u0927',ml:'\u0d05\u0d15\u0d4d\u0d15\u0d57\u0d23\u0d4d\u0d1f\u0d41\u0d02 \u0d21\u0d3e\u0d31\u0d4d\u0d31\u0d2f\u0d41\u0d02 \u0d28\u0d40\u0d15\u0d4d\u0d15\u0d02 \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d3e\u0d28\u0d41\u0d33\u0d4d\u0d33 \u0d05\u0d2d\u0d4d\u0d2f\u0d7c\u0d24\u0d4d\u0d25\u0d28'},deleteAccountModalTitle:{en:'Delete Devotee Account',te:'\u0c2d\u0c15\u0c4d\u0c24\u0c41\u0c28\u0c3f \u0c16\u0c3e\u0c24\u0c3e \u0c24\u0c4a\u0c32\u0c17\u0c3f\u0c02\u0c2a\u0c41',kn:'\u0cad\u0c95\u0ccd\u0ca4\u0cb0 \u0c96\u0cbe\u0ca4\u0cc6 \u0c85\u0cb3\u0cbf\u0cb8\u0cc1\u0cb5\u0cbf\u0c95\u0cc6',ta:'\u0baa\u0b95\u0bcd\u0ba4\u0bb0\u0bcd \u0b95\u0ba3\u0b95\u0bcd\u0b95\u0bc1 \u0ba8\u0bc0\u0b95\u0bcd\u0b95\u0bae\u0bcd',hi:'\u092d\u0915\u094d\u0924 \u0916\u093e\u0924\u093e \u0939\u091f\u093e\u0928\u093e',ml:'\u0d2d\u0d15\u0d4d\u0d24 \u0d05\u0d15\u0d4d\u0d15\u0d57\u0d23\u0d4d\u0d1f\u0d4d \u0d07\u0d32\u0d4d\u0d32\u0d3e\u0d24\u0d3e\u0d15\u0d4d\u0d15\u0d7d'},deleteWarningMsg:{en:'Swamiye Saranam Ayyappa! Requesting deletion will deactivate your account and revoke access to saved bookmarks and offerings. An OTP will be sent to your registered mobile number for verification.',te:'\u0c38\u0c4d\u0c35\u0c3e\u0c2e\u0c3f\u0c2f\u0c47 \u0c36\u0c30\u0c23\u0c02 \u0c05\u0c2f\u0c4d\u0c2f\u0c2a\u0c4d\u0c2a! \u0c16\u0c3e\u0c24\u0c3e \u0c24\u0c4a\u0c32\u0c17\u0c3f\u0c02\u0c2a\u0c41 \u0c05\u0c2d\u0c4d\u0c2f\u0c30\u0c4d\u0c25\u0c28 \u0c2a\u0c4d\u0c30\u0c3e\u0c30\u0c02\u0c2d\u0c3f\u0c02\u0c1a\u0c3f\u0c28 \u0c24\u0c30\u0c4d\u0c35\u0c3e\u0c24 \u0c2e\u0c40 \u0c28\u0c2e\u0c4b\u0c26\u0c3f\u0c24 \u0c2e\u0c4a\u0c2c\u0c48\u0c32\u0c4d \u0c28\u0c02\u0c2c\u0c30\u0c41\u0c15\u0c41 \u0c27\u0c43\u0c35\u0c40\u0c15\u0c30\u0c23 OTP \u0c2a\u0c02\u0c2a\u0c2c\u0c21\u0c41\u0c24\u0c41\u0c02\u0c26\u0c3f.',kn:'\u0cb8\u0ccd\u0cb5\u0cbe\u0cae\u0cbf\u0caf\u0cc7 \u0cb6\u0cb0\u0ca3\u0c82 \u0c85\u0caf\u0ccd\u0caf\u0caa\u0ccd\u0caa! \u0c96\u0cbe\u0ca4\u0cc6 \u0c85\u0cb3\u0cbf\u0cb8\u0cc1\u0cb5\u0cbf\u0c95\u0cc6 \u0caa\u0ccd\u0cb0\u0cbe\u0cb0\u0c82\u0cad\u0cbf\u0cb8\u0cb2\u0cc1 \u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0ca8\u0ccb\u0c82\u0ca6\u0cbe\u0caf\u0cbf\u0ca4 \u0cae\u0cca\u0cac\u0cc8\u0cb2\u0ccd \u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cc6\u0c97\u0cc6 \u0caa\u0cb0\u0cbf\u0cb6\u0cc0\u0cb2\u0ca8\u0cbe OTP \u0c95\u0cb3\u0cc1\u0cb9\u0cbf\u0cb8\u0cb2\u0cbe\u0c97\u0cc1\u0ca4\u0ccd\u0ca4\u0ca6\u0cc6.',ta:'\u0b9a\u0bc1\u0bb5\u0bbe\u0bae\u0bbf\u0baf\u0bc7 \u0b9a\u0bb0\u0ba3\u0bae\u0bcd \u0b90\u0baf\u0baa\u0bcd\u0baa\u0bbe! \u0b95\u0ba3\u0b95\u0bcd\u0b95\u0bc1 \u0ba8\u0bc0\u0b95\u0bcd\u0b95 \u0b95\u0bcb\u0bb0\u0bbf\u0b95\u0bcd\u0b95\u0bc8\u0baf\u0bc8 \u0ba4\u0bca\u0b9f\u0b99\u0bcd\u0b95 \u0b89\u0b99\u0bcd\u0b95\u0bb3\u0bcd \u0baa\u0ba4\u0bbf\u0bb5\u0bc1 \u0b9a\u0bc6\u0baf\u0bcd\u0baf\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f \u0bae\u0bca\u0baa\u0bc8\u0bb2\u0bcd \u0b8e\u0ba3\u0bcd\u0ba3\u0bbf\u0bb1\u0bcd\u0b95\u0bc1 OTP \u0b85\u0ba9\u0bc1\u0baa\u0bcd\u0baa\u0baa\u0bcd\u0baa\u0b9f\u0bc1\u0bae\u0bcd.',hi:'\u0938\u094d\u0935\u093e\u092e\u0940\u092f\u0947 \u0936\u0930\u0923\u092e \u0905\u092f\u094d\u092f\u092a\u094d\u092a\u093e! \u0916\u093e\u0924\u093e \u0939\u091f\u093e\u0928\u0947 \u0915\u093e \u0905\u0928\u0941\u0930\u094b\u0927 \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0906\u092a\u0915\u0947 \u092a\u0902\u091c\u0940\u0915\u0943\u0924 \u092e\u094b\u092c\u093e\u0907\u0932 \u0928\u0902\u092c\u0930 \u092a\u0930 \u0913\u091f\u0940\u092a\u0940 \u092d\u0947\u091c\u093e \u091c\u093e\u090f\u0917\u093e\u0964',ml:'\u0d38\u0d4d\u0d35\u0d3e\u0d2e\u0d3f\u0d2f\u0d47 \u0d36\u0d30\u0d23\u0d02 \u0d05\u0d2f\u0d4d\u0d2f\u0d2a\u0d4d\u0d2a\u0d3e! \u0d05\u0d15\u0d4d\u0d15\u0d57\u0d23\u0d4d\u0d1f\u0d4d \u0d07\u0d32\u0d4d\u0d32\u0d3e\u0d24\u0d3e\u0d15\u0d4d\u0d15\u0d7d \u0d06\u0d30\u0d02\u0d2d\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28\u0d24\u0d3f\u0d28\u0d4d \u0d28\u0d3f\u0d19\u0d4d\u0d19\u0d33\u0d41\u0d1f\u0d46 \u0d30\u0d1c\u0d3f\u0d38\u0d4d\u0d31\u0d4d\u0d31\u0d7c \u0d1a\u0d46\u0d2f\u0d4d\u0d24 \u0d2e\u0d4a\u0d2c\u0d48\u0d32\u0d3f\u0d32\u0d47\u0d15\u0d4d\u0d15\u0d4d \u0d12\u0d1f\u0d3f\u0d2a\u0d3f \u0d05\u0d2f\u0d2f\u0d4d\u0d15\u0d4d\u0d15\u0d41\u0d02.'},reasonPlaceholder:{en:'Reason for deletion (Optional)',te:'\u0c24\u0c4a\u0c32\u0c17\u0c3f\u0c02\u0c2a\u0c41 \u0c15\u0c3e\u0c30\u0c23\u0c02 (\u0c10\u0c1a\u0c4d\u0c1b\u0c3f\u0c15\u0c02)',kn:'\u0c85\u0cb3\u0cbf\u0cb8\u0cc1\u0cb5\u0cbf\u0c95\u0cc6\u0c97\u0cc6 \u0c95\u0cbe\u0cb0\u0ca3 (\u0c90\u0c9a\u0ccd\u0c9b\u0cbf\u0c95)',ta:'\u0ba8\u0bc0\u0b95\u0bcd\u0b95\u0bc1\u0bb5\u0ba4\u0bb1\u0bcd\u0b95\u0bbe\u0ba9 \u0b95\u0bbe\u0bb0\u0ba3\u0bae\u0bcd (\u0bb5\u0bbf\u0bb0\u0bc1\u0baa\u0bcd\u0baa\u0bae\u0bbe\u0ba9\u0ba4\u0bc1)',hi:'\u0939\u091f\u093e\u0928\u0947 \u0915\u093e \u0915\u093e\u0930\u0923 (\u0935\u0948\u0915\u0932\u094d\u092a\u093f\u0915)',ml:'\u0d07\u0d32\u0d4d\u0d32\u0d3e\u0d24\u0d3e\u0d15\u0d4d\u0d15\u0d3e\u0d28\u0d41\u0d33\u0d4d\u0d33 \u0d15\u0d3e\u0d30\u0d23\u0d02 (\u0d10\u0d1a\u0d4d\u0d1b\u0d3f\u0d15\u0d02)'},sendVerificationOtp:{en:'Send Verification OTP',te:'\u0c27\u0c43\u0c35\u0c40\u0c15\u0c30\u0c23 OTP \u0c2a\u0c02\u0c2a\u0c02\u0c21\u0c3f',kn:'\u0caa\u0cb0\u0cbf\u0cb6\u0cc0\u0cb2\u0ca8\u0cbe OTP \u0c95\u0cb3\u0cc1\u0cb9\u0cbf\u0cb8\u0cbf',ta:'\u0b9a\u0bb0\u0bbf\u0baa\u0bbe\u0bb0\u0bcd\u0baa\u0bcd\u0baa\u0bc1 OTP \u0b85\u0ba9\u0bc1\u0baa\u0bcd\u0baa\u0bb5\u0bc1\u0bae\u0bcd',hi:'\u0938\u0924\u094d\u092f\u093e\u092a\u0928 \u0913\u091f\u0940\u092a\u0940 \u092d\u0947\u091c\u0947\u0902',ml:'\u0d38\u0d4d\u0d25\u0d3f\u0d30\u0d40\u0d15\u0d30\u0d23 \u0d12\u0d1f\u0d3f\u0d2a\u0d3f \u0d05\u0d2f\u0d2f\u0d4d\u0d15\u0d4d\u0d15\u0d41\u0d15'},enterOtpTitle:{en:'Enter 6-Digit OTP',te:'6 \u0c05\u0c02\u0c15\u0c46\u0c32 OTP \u0c28\u0c2e\u0c4b\u0c26\u0c41 \u0c1a\u0c47\u0c2f\u0c02\u0c21\u0c3f',kn:'6 \u0c85\u0c82\u0c95\u0cbf\u0caf OTP \u0ca8\u0cae\u0cc2\u0ca6\u0cbf\u0cb8\u0cbf',ta:'6 \u0b87\u0bb2\u0b95\u0bcd\u0b95 OTP \u0b89\u0bb3\u0bcd\u0bb3\u0bbf\u0b9f\u0bb5\u0bc1\u0bae\u0bcd',hi:'6 \u0905\u0902\u0915\u094b\u0902 \u0915\u093e \u0913\u091f\u0940\u092a\u0940 \u0926\u0930\u094d\u091c \u0915\u0930\u0947\u0902',ml:'6 \u0d05\u0d15\u0d4d\u0d15 \u0d12\u0d1f\u0d3f\u0d2a\u0d3f \u0d28\u0d7d\u0d15\u0d41\u0d15'},otpSentTo:{en:'OTP sent to registered number:',te:'\u0c28\u0c2e\u0c4b\u0c26\u0c3f\u0c24 \u0c28\u0c02\u0c2c\u0c30\u0c41\u0c15\u0c41 OTP \u0c2a\u0c02\u0c2a\u0c2c\u0c21\u0c3f\u0c02\u0c26\u0c3f:',kn:'\u0ca8\u0ccb\u0c82\u0ca6\u0cbe\u0caf\u0cbf\u0ca4 \u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cc6\u0c97\u0cc6 OTP \u0c95\u0cb3\u0cc1\u0cb9\u0cbf\u0cb8\u0cb2\u0cbe\u0c97\u0cbf\u0ca6\u0cc6:',ta:'\u0baa\u0ba4\u0bbf\u0bb5\u0bc1 \u0b9a\u0bc6\u0baf\u0bcd\u0baf\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f \u0b8e\u0ba3\u0bcd\u0ba3\u0bbf\u0bb1\u0bcd\u0b95\u0bc1 OTP \u0b85\u0ba9\u0bc1\u0baa\u0bcd\u0baa\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0ba4\u0bc1:',hi:'\u092a\u0902\u091c\u0940\u0915\u0943\u0924 \u0928\u0902\u092c\u0930 \u092a\u0930 \u0913\u091f\u0940\u092a\u0940 \u092d\u0947\u091c\u093e \u0917\u092f\u093e:',ml:'\u0d30\u0d1c\u0d3f\u0d38\u0d4d\u0d31\u0d4d\u0d31\u0d7c \u0d1a\u0d46\u0d2f\u0d4d\u0d24 \u0d28\u0d2e\u0d4d\u0d2a\u0d31\u0d3f\u0d32\u0d47\u0d15\u0d4d\u0d15\u0d4d \u0d12\u0d1f\u0d3f\u0d2a\u0d3f \u0d05\u0d2f\u0d1a\u0d4d\u0d1a\u0d41:'},confirmDeleteAction:{en:'Verify OTP & Request Deletion',te:'OTP \u0c27\u0c43\u0c35\u0c40\u0c15\u0c30\u0c3f\u0c02\u0c1a\u0c3f \u0c24\u0c4a\u0c32\u0c17\u0c3f\u0c02\u0c2a\u0c41 \u0c15\u0c4b\u0c30\u0c02\u0c21\u0c3f',kn:'OTP \u0caa\u0cb0\u0cbf\u0cb6\u0cc0\u0cb2\u0cbf\u0cb8\u0cbf & \u0c85\u0cb3\u0cbf\u0cb8\u0c