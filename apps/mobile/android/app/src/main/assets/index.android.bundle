\u0ba9\u0bcd \u0b9a\u0bc7\u0bb5\u0bc8\u0baf\u0bbf\u0bb2\u0bcd \u0baa\u0b99\u0bcd\u0b95\u0bc6\u0b9f\u0bc1\u0b99\u0bcd\u0b95\u0bb3\u0bcd \u2014 \u0b85\u0ba9\u0bcd\u0ba9\u0ba4\u0bbe\u0ba9\u0bae\u0bcd, \u0b86\u0bb2\u0baf \u0baa\u0bb0\u0bbe\u0bae\u0bb0\u0bbf\u0baa\u0bcd\u0baa\u0bc1 \u0bae\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd \u0baa\u0b95\u0bcd\u0ba4\u0bbf\u0baa\u0bcd \u0baa\u0ba3\u0bbf\u0b95\u0bb3\u0bc1\u0b95\u0bcd\u0b95\u0bc1 \u0b89\u0ba4\u0bb5\u0bc1\u0b99\u0bcd\u0b95\u0bb3\u0bcd.',button:'\u0b87\u0baa\u0bcd\u0baa\u0bcb\u0ba4\u0bc7 \u0b89\u0ba4\u0bb5  \u2192'},hi:{title:'\u0905\u0928\u094d\u0928\u0926\u093e\u0928 \u090f\u0935\u0902 \u092e\u0902\u0926\u093f\u0930 \u0938\u0947\u0935\u093e',description:'\u092d\u0917\u0935\u093e\u0928 \u0905\u092f\u094d\u092f\u092a\u094d\u092a\u093e \u0915\u0940 \u0938\u0947\u0935\u093e \u0915\u093e \u0939\u093f\u0938\u094d\u0938\u093e \u092c\u0928\u0947\u0902 \u2014 \u0905\u0928\u094d\u0928\u0926\u093e\u0928, \u092e\u0902\u0926\u093f\u0930 \u0930\u0916\u0930\u0916\u093e\u0935 \u0914\u0930 \u0927\u093e\u0930\u094d\u092e\u093f\u0915 \u0917\u0924\u093f\u0935\u093f\u0927\u093f\u092f\u094b\u0902 \u092e\u0947\u0902 \u0938\u0939\u092f\u094b\u0917 \u0926\u0947\u0902\u0964',button:'\u0905\u092d\u0940 \u0938\u0939\u092f\u094b\u0917 \u0915\u0930\u0947\u0902  \u2192'}};e.AnnadanamSupportSection=t=>{var x=t.language,b=t.onOpenDetail,f=p[x]||p.en;return(0,s.jsx)(n.View,{style:u.container,children:(0,s.jsxs)(o.LinearGradient,{colors:['#FFFDF8','#FFF6E5'],start:{x:0,y:0},end:{x:1,y:1},style:u.card,children:[(0,s.jsx)(n.Image,{source:c,style:u.foodImage,resizeMode:"cover"}),(0,s.jsxs)(n.View,{style:u.contentCol,children:[(0,s.jsxs)(n.View,{style:u.titleRow,children:[(0,s.jsx)(l.SteamingFoodBowlIcon,{size:18,color:"#D4932A"}),(0,s.jsx)(n.Text,{style:u.titleText,numberOfLines:2,children:f.title})]}),(0,s.jsx)(n.Text,{style:u.descText,numberOfLines:3,children:f.description}),(0,s.jsx)(n.TouchableOpacity,{style:u.ctaBtn,activeOpacity:.82,onPress:()=>{b?.('food_