3f\u0d24\u0d4d\u0d2f \u0d38\u0d47\u0d35\u0d28\u0d19\u0d4d\u0d19\u0d7e\u0d15\u0d4d\u0d15\u0d41\u0d02 \u0d2a\u0d3f\u0d28\u0d4d\u0d24\u0d41\u0d23'},templeSevaTitle:{en:'Temple Seva Booking',te:'\u0c06\u0c32\u0c2f \u0c38\u0c47\u0c35\u0c3e \u0c2c\u0c41\u0c15\u0c3f\u0c02\u0c17\u0c4d',kn:'\u0ca6\u0cc7\u0cb5\u0cbe\u0cb2\u0caf \u0cb8\u0cc7\u0cb5\u0cbe \u0cae\u0cc1\u0c82\u0c97\u0ca1 \u0c95\u0cbe\u0caf\u0ccd\u0ca6\u0cbf\u0cb0\u0cbf\u0cb8\u0cc1\u0cb5\u0cbf\u0c95\u0cc6',ta:'\u0b95\u0bcb\u0baf\u0bbf\u0bb2\u0bcd \u0b9a\u0bc7\u0bb5\u0bc8 \u0bae\u0bc1\u0ba9\u0bcd\u0baa\u0ba4\u0bbf\u0bb5\u0bc1',hi:'\u092e\u0902\u0926\u093f\u0930 \u0938\u0947\u0935\u093e \u092c\u0941\u0915\u093f\u0902\u0917',ml:'\u0d15\u0d4d\u0d37\u0d47\u0d24\u0d4d\u0d30 \u0d38\u0d47\u0d35 \u0d2c\u0d41\u0d15\u0d4d\u0d15\u0d3f\u0d02\u0d17\u0d4d'},templeSevaSubtitle:{en:'Abhishekam, Archana, Other Sevas',te:'\u0c05\u0c2d\u0c3f\u0c37\u0c47\u0c15\u0c02, \u0c05\u0c30\u0c4d\u0c1a\u0c28 \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c07\u0c24\u0c30 \u0c38\u0c47\u0c35\u0c32\u0c41',kn:'\u0c85\u0cad\u0cbf\u0cb7\u0cc7\u0c95, \u0c85\u0cb0\u0ccd\u0c9a\u0ca8\u0cc6, \u0c87\u0ca4\u0cb0 \u0cb8\u0cc7\u0cb5\u0cc6\u0c97\u0cb3\u0cc1',ta:'\u0b85\u0baa\u0bbf\u0bb7\u0bc7\u0b95\u0bae\u0bcd, \u0b85\u0bb0\u0bcd\u0b9a\u0bcd\u0b9a\u0ba9\u0bc8, \u0baa\u0bbf\u0bb1 \u0b9a\u0bc7\u0bb5\u0bc8\u0b95\u0bb3\u0bcd',hi:'\u0905\u092d\u093f\u0937\u0947\u0915, \u0905\u0930\u094d\u091a\u0928\u093e \u090f\u0935\u0902 \u0905\u0928\u094d\u092f \u0938\u0947\u0935\u093e\u090f\u0902',ml:'\u0d05\u0d2d\u0d3f\u0d37\u0d47\u0d15\u0d02, \u0d05\u0d7c\u0d1a\u0d4d\u0d1a\u0d28, \u0d2e\u0d31\u0d4d\u0d31\u0d4d \u0d38\u0d47\u0d35\u0d15\u0d7e'},annadanamTitle:{en:'Annadanam (Food Donation)',te:'\u0c05\u0c28\u0c4d\u0c28\u0c26\u0c3e\u0c28\u0c02 (\u0c06\u0c39\u0c3e\u0c30 \u0c26\u0c3e\u0c28\u0c02)',kn:'\u0c85\u0ca8\u0ccd\u0ca8\u0ca6\u0cbe\u0ca8 (\u0c86\u0cb9\u0cbe\u0cb0 \u0ca6\u0cbe\u0ca8)',ta:'\u0b85\u0ba9\u0bcd\u0ba9\u0ba4\u0bbe\u0ba9\u0bae\u0bcd (\u0b89\u0ba3\u0bb5\u0bc1 \u0ba4\u0bbe\u0ba9\u0bae\u0bcd)',hi:'\u0905\u0928\u094d\u0928\u0926\u093e\u0928 (\u092d\u094b\u091c\u0928 \u0926\u093e\u0928)',ml:'\u0d05\u0d28\u0d4d\u0d28\u0d26\u0d3e\u0d28\u0d02 (\u0d2d\u0d15\u0d4d\u0d37\u0d23 \u0d26\u0d3e\u0d28\u0d02)'},annadanamSubtitle:{en:'Sponsor food for devotees',te:'\u0c2d\u0c15\u0c4d\u0c24\u0c41\u0c32\u0c15\u0c41 \u0c05\u0c28\u0c4d\u0c28 \u0c2a\u0c4d\u0c30\u0c38\u0c3e\u0c26\u0c02 \u0c38\u0c2e\u0c30\u0c4d\u0c2a\u0c3f\u0c02\u0c1a\u0c02\u0c21\u0c3f',kn:'\u0cad\u0c95\u0ccd\u0ca4\u0cb0\u0cbf\u0c97\u0cc6 \u0c85\u0ca8\u0ccd\u0ca8 \u0caa\u0ccd\u0cb0\u0cb8\u0cbe\u0ca6 \u0cb8\u0cc7\u0cb5\u0cc6',ta:'\u0baa\u0b95\u0bcd\u0ba4\u0bb0\u0bcd\u0b95\u0bb3\u0bc1\u0b95\u0bcd\u0b95\u0bc1 \u0b89\u0ba3\u0bb5\u0bc1 \u0bb5\u0bb4\u0b99\u0bcd\u0b95\u0bc1\u0b99\u0bcd\u0b95\u0bb3\u0bcd',hi:'\u0936\u094d\u0930\u0926\u094d\u0927\u093e\u0932\u0941\u0913\u0902 \u0915\u0947 \u0932\u093f\u090f \u0905\u0928\u094d\u0928\u0926\u093e\u0928 \u092a\u094d\u0930\u093e\u092f\u094b\u091c\u093f\u0924 \u0915\u0930\u0947\u0902',ml:'\u0d2d\u0d15\u0d4d\u0d24\u0d7c\u0d15\u0d4d\u0d15\u0d4d \u0d05\u0d28\u0d4d\u0d28\u0d26\u0d3e\u0d28\u0d02 \u0d28\u0d7d\u0d15\u0d41\u0d15'},festivalDonationTitle:{en:'Festival Donation',te:'\u0c09\u0c24\u0c4d\u0c38\u0c35\u0c3e\u0c32 \u0c35\u0c3f\u0c30\u0c3e\u0c33\u0c02',kn:'\u0cb9\u0cac\u0ccd\u0cac\u0ca6 \u0ca6\u0cc7\u0ca3\u0cbf\u0c97\u0cc6',ta:'\u0ba4\u0bbf\u0bb0\u0bc1\u0bb5\u0bbf\u0bb4\u0bbe \u0ba8\u0ba9\u0bcd\u0b95\u0bca\u0b9f\u0bc8',hi:'\u0909\u0924\u094d\u0938\u0935 \u0926\u093e\u0928',ml:'\u0d09\u0d24\u0d4d\u0d38\u0d35 \u0d38\u0d02\u0d2d\u0d3e\u0d35\u0d28'},festivalDonationSubtitle:{en:'Contribute for special festivals',te:'\u0c35\u0c3f\u0c36\u0c47\u0c37 \u0c2a\u0c30\u0c4d\u0c35\u0c26\u0c3f\u0c28\u0c3e\u0c32\u0c41 & \u0c09\u0c24\u0c4d\u0c38\u0c35\u0c3e\u0c32\u0c15\u0c41 \u0c38\u0c39\u0c15\u0c3e\u0c30\u0c02',kn:'\u0cb5\u0cbf\u0cb6\u0cc7\u0cb7 \u0cb9\u0cac\u0ccd\u0cac\u0c97\u0cb3\u0cc1 \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0c89\u0ca4\u0ccd\u0cb8\u0cb5\u0c97\u0cb3\u0cbf\u0c97\u0cc6 \u0c95\u0cca\u0ca1\u0cc1\u0c97\u0cc6',ta:'\u0b9a\u0bbf\u0bb1\u0baa\u0bcd\u0baa\u0bc1 \u0ba4\u0bbf\u0bb0\u0bc1\u0bb5\u0bbf\u0bb4\u0bbe\u0b95\u0bcd\u0b95\u0bb3\u0bc1\u0b95\u0bcd\u0b95\u0bc1 \u0baa\u0b99\u0bcd\u0b95\u0bb3\u0bbf\u0b95\u0bcd\u0b95\u0bb5\u0bc1\u0bae\u0bcd',hi:'\u0935\u093f\u0936\u0947\u0937 \u0924\u094d\u092f\u094b\u0939\u093e\u0930\u094b\u0902 \u090f\u0935\u0902 \u0909\u0924\u094d\u0938\u0935\u094b\u0902 \u092e\u0947\u0902 \u092f\u094b\u0917\u0926\u093e\u0928 \u0926\u0947\u0902',ml:'\u0d35\u0d3f\u0d36\u0d47\u0d37\u0d3e\u0d7d \u0d09\u0d24\u0d4d\u0d38\u0d35\u0d19\u0d4d\u0d19\u0d7e\u0d15\u0d4d\u0d15\u0d4d \u0d38\u0d02\u0d2d\u0d3e\u0d35\u0d28 \u0d28\u0d7d\u0d15\u0d41\u0d15'},nityaPoojaTitle:{en:'Nitya Pooja Sponsorship',te:'\u0c28\u0c3f\u0c24\u0c4d\u0c2f \u0c2a\u0c42\u0c1c \u0c38\u0c4d\u0c2a\u0c3e\u0c28\u0c4d\u0c38\u0c30\u0c4d\u200c\u0c37\u0c3f\u0c2a\u0c4d',kn:'\u0ca8\u0cbf\u0ca4\u0ccd\u0caf \u0caa\u0cc2\u0c9c\u0cbe \u0caa\u0ccd\u0cb0\u0cbe\u0caf\u0ccb\u0c9c\u0c95\u0ca4\u0ccd\u0cb5',ta:'\u0ba8\u0bbf\u0ba4\u0bcd\u0ba4\u0bbf\u0baf \u0baa\u0bc2\u0b9c\u0bc8 \u0b86\u0ba4\u0bb0\u0bb5\u0bc1',hi:'\u0928\u093f\u0924\u094d\u092f \u092a\u0942\u091c\u093e \u092a\u094d\u0930\u093e\u092f\u094b\u091c\u0928',ml:'\u0d28\u0d3f\u0d24\u0d4d\u0d2f \u0d2a\u0d42\u0d1c\u0d3e \u0d38\u0d4d\u0d2a\u0d4b\u0d7a\u0d38\u0d7c\u0d37\u0d3f\u0d2a\u0d4d\u0d2a\u0d4d'},nityaPoojaSubtitle:{en:'Support regular poojas',te:'\u0c28\u0c3f\u0c24\u0c4d\u0c2f \u0c2a\u0c42\u0c1c\u0c32\u0c41 \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c39\u0c3e\u0c30\u0c24\u0c41\u0c32\u0c15\u0c41 \u0c38\u0c2e\u0c30\u0c4d\u0c2a\u0c23',kn:'\u0ca6\u0cc8\u0ca8\u0c82\u0ca6\u0cbf\u0ca8 \u0caa\u0cc2\u0c9c\u0cc6\u0c97\u0cb3\u0cbf\u0c97\u0cc6 \u0cac\u0cc6\u0c82\u0cac\u0cb2 \u0ca8\u0cc0\u0ca1\u0cbf',ta:'\u0bb5\u0bb4\u0b95\u0bcd\u0b95\u0bae\u0bbe\u0ba9 \u0baa\u0bc2\u0b9c\u0bc8\u0b95\u0bb3\u0bc1\u0b95\u0bcd\u0b95\u0bc1 \u0b86\u0ba4\u0bb0\u0bb5\u0bb3\u0bbf\u0b95\u0bcd\u0b95\u0bb5\u0bc1\u0bae\u0bcd',hi:'\u0928\u093f\u092f\u092e\u093f\u0924 \u092a\u0942\u091c\u093e-\u0905\u0930\u094d\u091a\u0928\u093e \u0915\u093e \u0938\u092e\u0930\u094d\u0925\u0928 \u0915\u0930\u0947\u0902',ml:'\u0d38\u0d4d\u0d25\u0d3f\u0d30\u0d02 \u0d2a\u0d42\u0d1c\u0d15\u0d7e\u0d15\u0d4d\u0d15\u0d4d \u0d2a\u0d3f\u0d28\u0d4d\u0d24\u0d41\u0d23 \u0d28\u0d7d\u0d15\u0d41\u0d15'},myDonationsTitle:{en:'My Donations',te:'\u0c28\u0c3e \u0c35\u0c3f\u0c30\u0c3e\u0c33\u0c3e\u0c32\u0c41',kn:'\u0ca8\u0ca8\u0ccd\u0ca8 \u0ca6\u0cc7\u0ca3\u0cbf\u0c97\u0cc6\u0c97\u0cb3\u0cc1',ta:'\u0b8e\u0ba9\u0ba4\u0bc1 \u0ba8\u0ba9\u0bcd\u0b95\u0bca\u0b9f\u0bc8\u0b95\u0bb3\u0bcd',hi:'\u092e\u0947\u0930\u0947 \u0926\u093e\u0928 \u0935\u093f\u0935\u0930\u0923',ml:'\u0d0e\u0d28\u0d4d\u0d31\u0d46 \u0d38\u0d02\u0d2d\u0d3e\u0d35\u0d28\u0d15\u0d7e'},myDonationsSubtitle:{en:'View your donation history',te:'\u0c2e\u0c40 \u0c17\u0c24 \u0c35\u0c3f\u0c30\u0c3e\u0c33\u0c3e\u0c32 \u0c35\u0c3f\u0c35\u0c30\u0c3e\u0c32\u0c41 \u0c1a\u0c42\u0c21\u0c02\u0c21\u0c3f',kn:'\u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0ca6\u0cc7\u0ca3\u0cbf\u0c97\u0cc6 \u0c87\u0ca4\u0cbf\u0cb9\u0cbe\u0cb8\u0cb5\u0ca8\u0ccd\u0ca8\u0cc1 \u0cb5\u0cc0\u0c95\u0ccd\u0cb7\u0cbf\u0cb8\u0cbf',ta:'\u0b89\u0b99\u0bcd\u0b95\u0bb3\u0bcd \u0ba8\u0ba9\u0bcd\u0b95\u0bca\u0b9f\u0bc8 \u0bb5\u0bb0\u0bb2\u0bbe\u0bb1\u0bcd\u0bb1\u0bc8\u0b95\u0bcd \u0b95\u0bbe\u0ba3\u0bcd\u0b95',hi:'\u0905\u092a\u0928\u093e \u0926\u093e\u0928 \u0907\u0924\u093f\u0939\u093e\u0938 \u090f\u0935\u0902 \u0930\u0938\u0940\u0926\u0947\u0902 \u0926\u0947\u0916\u0947\u0902',ml:'\u0d28\u0d3f\u0d19\u0d4d\u0d19\u0d33\u0d41\u0d1f\u0d46 \u0d38\u0d02\u0d2d\u0d3e\u0d35\u0d28\u0d3e \u0d1a\u0d30\u0d3f\u0d24\u0d4d\u0d30\u0d02 \u0d15\u0d3e\u0d23\u0d41\u0d15'}};_e.DonationsScreen=e=>{var t=e.currentLanguage,l=e.currentUser,u=e.onBack,S=e.onNavigateToAnnadanam,B=e.onNavigateToAuth,k=(0,o.useState)(s.MASTER_DONATION_CATEGORIES),P=(0,a.default)(k,2),A=P[0],V=P[1],L=(0,o.useState)(null),M=(0,a.default)(L,2),O=M[0],W=M[1],z=(0,o.useState)('1001'),R=(0,a.default)(z,2),I=R[0],E=R[1],H=(0,o.use