:"M29 18 C29 18 31 21 31 23 C31 24.2 30 25 29 25 C28 25 27 24.2 27 23 C27 21 29 18 29 18 Z",fill:"#FFFDF8"})]}),B={screenTitle:{en:'Notifications',te:'\u0c28\u0c4b\u0c1f\u0c3f\u0c2b\u0c3f\u0c15\u0c47\u0c37\u0c28\u0c4d\u0c32\u0c41',kn:'\u0c85\u0ca7\u0cbf\u0cb8\u0cc2\u0c9a\u0ca8\u0cc6\u0c97\u0cb3\u0cc1',ta:'\u0b85\u0bb1\u0bbf\u0bb5\u0bbf\u0baa\u0bcd\u0baa\u0bc1\u0b95\u0bb3\u0bcd',hi:'\u0938\u0942\u091a\u0928\u093e\u090f\u0902',ml:'\u0d05\u0d31\u0d3f\u0d2f\u0d3f\u0d2a\u0d4d\u0d2a\u0d41\u0d15\u0d7e'},settingsTitle:{en:'Notification Preferences',te:'\u0c28\u0c4b\u0c1f\u0c3f\u0c2b\u0c3f\u0c15\u0c47\u0c37\u0c28\u0c4d \u0c2a\u0c4d\u0c30\u0c3e\u0c27\u0c3e\u0c28\u0c4d\u0c2f\u0c24\u0c32\u0c41',kn:'\u0c85\u0ca7\u0cbf\u0cb8\u0cc2\u0c9a\u0ca8\u0cc6 \u0c86\u0ca6\u0ccd\u0caf\u0ca4\u0cc6\u0c97\u0cb3\u0cc1',ta:'\u0b85\u0bb1\u0bbf\u0bb5\u0bbf\u0baa\u0bcd\u0baa\u0bc1 \u0bb5\u0bbf\u0bb0\u0bc1\u0baa\u0bcd\u0baa\u0b99\u0bcd\u0b95\u0bb3\u0bcd',hi:'\u0938\u0942\u091a\u0928\u093e \u092a\u094d\u0930\u093e\u0925\u092e\u093f\u0915\u0924\u093e\u090f\u0902',ml:'\u0d05\u0d31\u0d3f\u0d2f\u0d3f\u0d2a\u0d4d\u0d2a\u0d4d \u0d2e\u0d41\u0d7b\u0d17\u0d23\u0d28\u0d15\u0d7e'},settingsDesc:{en:'Customize devotional alerts and spiritual reminders for your practice.',te:'\u0c2e\u0c40 \u0c2a\u0c42\u0c1c\u0c3e \u0c28\u0c3f\u0c2f\u0c2e\u0c3e\u0c32 \u0c15\u0c4b\u0c38\u0c02 \u0c26\u0c48\u0c35\u0c3f\u0c15 \u0c38\u0c2e\u0c3e\u0c1a\u0c3e\u0c30\u0c3e\u0c32\u0c41 \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c30\u0c3f\u0c2e\u0c48\u0c02\u0c21\u0c30\u0c4d\u0c32\u0c28\u0c41 \u0c38\u0c46\u0c1f\u0c4d \u0c1a\u0c47\u0c38\u0c41\u0c15\u0c4b\u0c02\u0c21\u0c3f.',kn:'\u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0caa\u0cc2\u0c9c\u0cbe \u0c86\u0c9a\u0cb0\u0ca3\u0cc6\u0c97\u0cc6 \u0c86\u0ca7\u0ccd\u0caf\u0cbe\u0ca4\u0ccd\u0cae\u0cbf\u0c95 \u0c8e\u0c9a\u0ccd\u0c9a\u0cb0\u0cbf\u0c95\u0cc6\u0c97\u0cb3\u0ca8\u0ccd\u0ca8\u0cc1 \u0cb8\u0cb0\u0cbf\u0cb9\u0cca\u0c82\u0ca6\u0cbf\u0cb8\u0cbf.',ta:'\u0b86\u0ba9\u0bcd\u0bae\u0bc0\u0b95 \u0bb5\u0bbf\u0bb4\u0bbf\u0baa\u0bcd\u0baa\u0bc2\u0b9f\u0bcd\u0b9f\u0bb2\u0bcd\u0b95\u0bb3\u0bc8\u0baf\u0bc1\u0bae\u0bcd \u0ba8\u0bbf\u0ba9\u0bc8\u0bb5\u0bc2\u0b9f\u0bcd\u0b9f\u0bb2\u0bcd\u0b95\u0bb3\u0bc8\u0baf\u0bc1\u0bae\u0bcd \u0ba4\u0bc7\u0bb0\u0bcd\u0bb5\u0bc1 \u0b9a\u0bc6\u0baf\u0bcd\u0baf\u0bb5\u0bc1\u0bae\u0bcd.',hi:'\u0905\u092a\u0928\u0940 \u0906\u0927\u094d\u092f\u093e\u0924\u094d\u092e\u093f\u0915 \u0938\u093e\u0927\u0928\u093e \u0915\u0947 \u0932\u093f\u090f \u092a\u0942\u091c\u093e \u090f\u0935\u0902 \u0938\u0947\u0935\u093e \u0905\u0928\u0941\u0938\u094d\u092e\u093e\u0930\u0915 \u0928\u093f\u0930\u094d\u0927\u093e\u0930\u093f\u0924 \u0915\u0930\u0947\u0902\u0964',ml:'\u0d06\u0d24\u0d4d\u0d2e\u0d40\u0d2f \u0d35\u0d3f\u0d35\u0d30\u0d19\u0d4d\u0d19\u0d33\u0d41\u0d02 \u0d2a\u0d42\u0d1c\u0d3e \u0d13\u0d7c\u0d2e\u0d4d\u0d2e\u0d2a\u0d4d\u0d2a\u0d46\u0d1f\u0d41\u0d24\u0d4d\u0d24\u0d32\u0d41\u0d15\u0d33\u0d41\u0d02 \u0d15\u0d4d\u0d30\u0d2e\u0d40\u0d15\u0d30\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d15.'},liveStreamAlerts:{en:'Live Darshan & Pooja Alerts',te:'\u0c2a\u0c4d\u0c30\u0c24\u0c4d\u0c2f\u0c15\u0c4d\u0c37 \u0c26\u0c30\u0c4d\u0c36\u0c28\u0c02 & \u0c2a\u0c42\u0c1c\u0c3e \u0c05\u0c32\u0c46\u0c30\u0c4d\u0c1f\u0c4d\u0c38\u0c4d',kn:'\u0ca8\u0cc7\u0cb0 \u0ca6\u0cb0\u0ccd\u0cb6\u0ca8 \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0caa\u0cc2\u0c9c\u0cbe \u0c8e\u0c9a\u0ccd\u0c9a\u0cb0\u0cbf\u0c95\u0cc6\u0c97\u0cb3\u0cc1',ta:'\u0ba8\u0bc7\u0bb0\u0bb2\u0bc8 \u0ba4\u0bb0\u0bbf\u0b9a\u0ba9\u0bae\u0bcd & \u0baa\u0bc2\u0b9c\u0bc8 \u0b8e\u0b9a\u0bcd\u0b9a\u0bb0\u0bbf\u0b95\u0bcd\u0b95\u0bc8\u0b95\u0bb3\u0bcd',hi:'\u0932\u093e\u0907\u0935 \u0926\u0930\u094d\u0936\u0928 \u090f\u0935\u0902 \u092a\u0942\u091c\u093e \u0938\u0942\u091a\u0928\u093e\u090f\u0902',ml:'\u0d24\u0d24\u0d4d\u0d38\u0d2e\u0d2f \u0d26\u0d7c\u0d36\u0d28 \u0d05\u0d31\u0d3f\u0d2f\u0d3f\u0d2a\u0d4d\u0d2a\u0d41\u0d15\u0d7e'},festivalAlerts:{en:'Temple Festival Updates',te:'\u0c06\u0c32\u0c2f \u0c09\u0c24\u0c4d\u0c38\u0c35\u0c3e\u0c32\u0c41 & \u0c2a\u0c30\u0c4d\u0c35\u0c26\u0c3f\u0c28\u0c3e\u0c32\u0c41',kn:'\u0ca6\u0cc7\u0cb5\u0cbe\u0cb2\u0caf\u0ca6 \u0c89\u0ca4\u0ccd\u0cb8\u0cb5\u0c97\u0cb3\u0cc1 \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0cb9\u0cac\u0ccd\u0cac\u0c97\u0cb3\u0cc1',ta:'\u0b95\u0bcb\u0baf\u0bbf\u0bb2\u0bcd \u0ba4\u0bbf\u0bb0\u0bc1\u0bb5\u0bbf\u0bb4\u0bbe \u0baa\u0bc1\u0ba4\u0bc1\u0baa\u0bcd\u0baa\u0bbf\u0baa\u0bcd\u0baa\u0bc1\u0b95\u0bb3\u0bcd',hi:'\u092e\u0902\u0926\u093f\u0930 \u0909\u0924\u094d\u0938\u0935 \u090f\u0935\u0902 \u092a\u0930\u094d\u0935 \u0938\u0942\u091a\u0928\u093e\u090f\u0902',ml:'\u0d15\u0d4d\u0d37\u0d47\u0d24\u0d4d\u0d30 \u0d09\u0d24\u0d4d\u0d38\u0d35 \u0d35\u0d3f\u0d36\u0d47\u0d37\u0d19\u0d4d\u0d19\u0d7e'},annadanamAlerts:{en:'Annadanam (Food Donation) Alerts',te:'\u0c28\u0c47\u0c1f\u0c3f \u0c05\u0c28\u0c4d\u0c28\u0c26\u0c3e\u0c28 \u0c15\u0c47\u0c02\u0c26\u0c4d\u0c30\u0c3e\u0c32 \u0c35\u0c3f\u0c35\u0c30\u0c3e\u0c32\u0c41',kn:'\u0c85\u0ca8\u0ccd\u0ca8\u0ca6\u0cbe\u0ca8 \u0c95\u0cc7\u0c82\u0ca6\u0ccd\u0cb0\u0ca6 \u0c8e\u0c9a\u0ccd\u0c9a\u0cb0\u0cbf\u0c95\u0cc6\u0c97\u0cb3\u0cc1',ta:'\u0b85\u0ba9\u0bcd\u0ba9\u0ba4\u0bbe\u0ba9 \u0b85\u0bb1\u0bbf\u0bb5\u0bbf\u0baa\u0bcd\u0baa\u0bc1\u0b95\u0bb3\u0bcd',hi:'\u0905\u0928\u094d\u0928\u0926\u093e\u0928 \u0915\u0947\u0902\u0926\u094d\u0930 \u0938\u0942\u091a\u0928\u093e\u090f\u0902',ml:'\u0d05\u0d28\u0d4d\u0d28\u0d26\u0d3e\u0d28 \u0d05\u0d31\u0d3f\u0d2f\u0d3f\u0d2a\u0d4d\u0d2a\u0d41\u0d15\u0d7e'},panchangamAlerts:{en:'Daily Panchangam & Muhurtams',te:'\u0c28\u0c3f\u0c24\u0c4d\u0c2f \u0c2a\u0c02\u0c1a\u0c3e\u0c02\u0c17\u0c02 & \u0c36\u0c41\u0c2d \u0c2e\u0c41\u0c39\u0c42\u0c30\u0c4d\u0c24\u0c3e\u0c32\u0c41',kn:'\u0ca6\u0cc8\u0ca8\u0c82\u0ca6\u0cbf\u0ca8 \u0caa\u0c82\u0c9a\u0cbe\u0c82\u0c97 \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0cae\u0cc1\u0cb9\u0cc2\u0cb0\u0ccd\u0ca4\u0c97\u0cb3\u0cc1',ta:'\u0ba4\u0bbf\u0ba9\u0b9a\u0bb0\u0bbf \u0baa\u0b9e\u0bcd\u0b9a\u0bbe\u0b99\u0bcd\u0b95\u0bae\u0bcd & \u0b9a\u0bc1\u0baa \u0bae\u0bc1\u0b95\u0bc2\u0bb0\u0bcd\u0ba4\u0bcd\u0ba4\u0bae\u0bcd',hi:'\u0926\u0948\u0928\u093f\u0915 \u092a\u0902\u091a\u093e\u0902\u0917 \u090f\u0935\u0902 \u0936\u0941\u092d \u092e\u0941\u0939\u0942\u0930\u094d\u0924',ml:'\u0d28\u0d3f\u0d24\u0d4d\u0d2f \u0d2a\u0d1e\u0d4d\u0d1a\u0d3e\u0d02\u0d17\u0d35\u0d41\u0d02 \u0d36\u0d41\u0d2d\u0d2e\u0d41\u0d39\u0d42\u0d7c\u0d24\u0d4d\u0d24\u0d19\u0d4d\u0d19\u0d33\u0d41\u0d02'},sevaAlerts:{en:'Seva & Archana Reminders',te:'\u0c38\u0c47\u0c35\u0c3e & \u0c05\u0c30\u0c4d\u0c1a\u0c28 \u0c30\u0c3f\u0c2e\u0c48\u0c02\u0c21\u0c30\u0c4d\u0c32\u0c41',kn:'\u0cb8\u0cc7\u0cb5\u0cbe \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0c85\u0cb0\u0ccd\u0c9a\u0ca8\u0cc6 \u0c9c\u0ccd\u0c9e\u0cbe\u0caa\u0ca8\u0cc6\u0c97\u0cb3\u0cc1',ta:'\u0b9a\u0bc7\u0bb5\u0bc8 & \u0b85\u0bb0\u0bcd\u0b9a\u0bcd\u0b9a\u0ba9\u0bc8 \u0ba8\u0bbf\u0ba9\u0bc8\u0bb5\u0bc2\u0b9f\u0bcd\u0b9f\u0bb2\u0bcd\u0b95\u0bb3\u0bcd',hi:'\u0938\u0947\u0935\u093e \u090f\u0935\u0902 \u0905\u0930\u094d\u091a\u0928\u093e \u0905\u0928\u0941\u0938\u094d\u092e\u093e\u0930\u0915',ml:'\u0d38\u0d47\u0d35\u0d3e \u0d13\u0d7c\u0d2e\u0d4d\u0d2e\u0d2a\u0d4d\u0d2a\u0d46\u0d1f\u0d41\u0d24\u0d4d\u0d24\u0d32\u0d41\u0d15\u0d7e'},noNotifications:{en:'No notifications at this moment.',te:'\u0c2a\u0c4d\u0c30\u0c38\u0c4d\u0c24\u0c41\u0c24\u0c02 \u0c0e\u0c32\u0c3e\u0c02\u0c1f\u0c3f \u0c28\u0c4b\u0c1f\u0c3f\u0c2b\u0c3f\u0c15\u0c47\u0c37\u0c28\u0c4d\u0c32\u0c41 \u0c32\u0c47\u0c35\u0c41.',kn:'\u0cb8\u0ca6\u0ccd\u0caf\u0c95\u0ccd\u0c95\u0cc6 \u0caf\u0cbe\u0cb5\u0cc1\u0ca6\u0cc7 \u0c85\u0ca7\u0cbf\u0cb8\u0cc2\u0c9a\u0ca8\u0cc6\u0c97\u0cb3\u0cbf\u0cb2\u0ccd\u0cb2.',ta:'\u0ba4\u0bb1\u0bcd\u0baa\u0bcb\u0ba4\u0bc1 \u0baa\u0bc1\u0ba4\u0bbf\u0baf \u0b85\u0bb1\u0bbf\u0bb5\u0bbf\u0baa\u0bcd\u0baa\u0bc1\u0b95\u0bb3\u0bcd \u0b87\u0bb2\u0bcd\u0bb2\u0bc8.',hi:'\u0907\u0938 \u0938\u092e\u092f \u0915\u094b\u0908 \u0938\u0942\u091a\u0928\u093e \u0928\u0939\u0940\u0902 \u0939\u0948\u0964',ml:'\u0d07\u0d2a\u0d4d\u0d2a\u0d4b\u0d7e \u0d2a\u0d41\u0d24\u0d3f\u0d2f \u0d05\u0d31\u0d3f\u0d2f\u0d3f\u0d2a\u0d4d\u0d2a\u0d41\u0d15\u0d7e \u0d12\u0d28\u0d4d\u0d28\u0d41\u0d2e\u0d3f\u0d32\u0d4d\u0d32.'},blessingSub:{en:'May Lord Ayyappa bless you with auspicious peace and joy.',te:'\u0c36\u0c4d\u0c30\u0c40 \u0c05\u0c2f\u0c4d\u0c2f\u0c2a\u0c4d\u0c2a \u0c38\u0c4d\u0c35\u0c3e\u0c2e\u0c3f \u0c35\u0c3e\u0c30\u0c3f \u0c15\u0c1f\u0c3e\u0c15\u0c4d\u0c37\u0c02 \u0c2e\u0c40\u0c2a\u0c48 \u0c09\u0c02\u0c21\u0c41\u0c17\u0c3e\u0c15.',kn:'\u0cb6\u0ccd\u0cb0\u0cc0 \u0c85\u0caf\u0ccd\u0caf\u0caa\u0ccd\u0caa \u0cb8\u0ccd\u0cb5\u0cbe\u0cae\u0cbf \u0ca8\u0cbf\u0cae\u0ccd\u0cae\u0ca8\u0ccd\u0ca8\u0cc1 \u0cb9\u0cb0\u0cb8\u0cb2\u0cbf.',ta:'\u0bb8\u0bcd\u0bb0\u0bc0 \u0b90\u0baf\u0baa\u0bcd\u0baa \u0b9a\u0bc1\u0bb5\u0bbe\u0bae\u0bbf\u0baf\u0bbf\u0ba9\u0bcd \u0b85\u0bb0\u0bc1\u0bb3\u0bcd \u0b89\u0b99\u0bcd\u0b95\u0bb3\u0bc1\u0b95\u0bcd\u0b95\u0bc1 \u0b89\u0ba3\u0bcd\u0b9f\u0bbe\u0b95\u0b9f\u0bcd\u0b9f\u0bc1\u0bae\u0bcd.',hi:'\u092d\u0917\u0935\u093e\u0928 \u0905\u092f\u094d\u092f\u092a\u094d\u092a\u093e \u0915\u0940 \u0915\u0943\u092a\u093e \u0906\u092a \u092a\u0930 \u0938\u0926\u0948\u0935 \u092c\u0928\u0940 \u0930\u0939\u0947\u0964',ml:'\u0d38\u0d4d\u0d35\u0d3e\u0d2e\u0d3f \u0d05\u0d2f\u0d4d\u0d2f\u0d2a\u0d4d\u0d2a\u0d28\u0d4d\u0d31\u0d46 \u0d05\u0d28\u0d41\u0d17\u0d4d\u0d30\u0d39\u0d02 \u0d0e\u0d28\u0d4d\u0d28\u0d41\u0d02 \u0d09\u0d23\u0d4d\u0d1f\u0d3e\u0d15\u0d1f\u0d4d\u0d1f\u0d46.'},markAllRead:{en:'Mark all read',te:'\u0c05\u0c28\u0c4d\u0c28\u0c40 \u0c1a\u0c26\u0c3f\u0c35\u0c3f\u0c28\u0c1f\u0c4d\u0c32\u0c41\u0c17\u0c3e \u0c2e\u0c3e\u0c30\u0c4d\u0c1a\u0c41',kn:'\u0c8e\u0cb2\u0ccd\u0cb2\u0cb5\u0ca8\u0ccd\u0ca8\u0cc2 \u0c93\u0ca6\u0cbf\u0ca6\u0c82\u0ca4\u0cc6 \u0c97\u0cc1\u0cb0\u0cc1\u0ca4\u0cbf\u0cb8\u0cbf',ta:'\u0b85\u0ba9\u0bc8\u0ba4\u0bcd\u0ba4\u0bc1\u0bae\u0bcd \u0baa\u0b9f\u0bbf\u0ba4\u0bcd\u0ba4\u0ba4\u0bbe\u0b95\u0b95\u0bcd \u0b95\u0bc1\u0bb1\u0bbf',hi:'\u0938\u092d\u0940 \u092a\u0922\u093c\u093e \u0939\u0941\u0906 \u091a\u093f\u0939\u094d\u0928\u093f\u0924 \u0915\u0930\u0947\u0902',ml:'\u0d0e\u