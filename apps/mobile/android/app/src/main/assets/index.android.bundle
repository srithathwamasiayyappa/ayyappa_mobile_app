95\u0bcd\u0b95\u0bc1 \u0b89\u0ba3\u0bb5\u0bb3\u0bbf\u0baa\u0bcd\u0baa\u0bcb\u0bae\u0bcd \u2022 \u0b87\u0bb1\u0bc8\u0bb5\u0ba9\u0bc8 \u0b85\u0b9f\u0bc8\u0bb5\u0bcb\u0bae\u0bcd',hi:'\u092d\u0915\u094d\u0924\u094b\u0902 \u0915\u094b \u092d\u094b\u091c\u0928 \u0915\u0930\u093e\u090f\u0902 \u2022 \u092a\u094d\u0930\u092d\u0941 \u0938\u0947\u0935\u093e \u092a\u093e\u090f\u0902',ml:'\u0d2d\u0d15\u0d4d\u0d24\u0d28\u0d4d \u0d05\u0d28\u0d4d\u0d28\u0d2e\u0d47\u0d15\u0d41\u0d15 \u2022 \u0d08\u0d36\u0d4d\u0d35\u0d30\u0d28\u0d46 \u0d38\u0d47\u0d35\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d15'},todayLocationsTab:{en:"Today's Locations",te:'\u0c28\u0c47\u0c1f\u0c3f \u0c15\u0c47\u0c02\u0c26\u0c4d\u0c30\u0c3e\u0c32\u0c41',kn:'\u0c87\u0c82\u0ca6\u0cbf\u0ca8 \u0c95\u0cc7\u0c82\u0ca6\u0ccd\u0cb0\u0c97\u0cb3\u0cc1',ta:'\u0b87\u0ba9\u0bcd\u0bb1\u0bc8\u0baf \u0b87\u0b9f\u0b99\u0bcd\u0b95\u0bb3\u0bcd',hi:'\u0906\u091c \u0915\u0947 \u0915\u0947\u0902\u0926\u094d\u0930',ml:'\u0d07\u0d28\u0d4d\u0d28\u0d24\u0d4d\u0d24\u0d46 \u0d38\u0d4d\u0d25\u0d32\u0d19\u0d4d\u0d19\u0d7e'},contributeNowTab:{en:'Contribute Now',te:'\u0c35\u0c3f\u0c30\u0c3e\u0c33\u0c02 \u0c07\u0c35\u0c4d\u0c35\u0c02\u0c21\u0c3f',kn:'\u0ca6\u0cc7\u0ca3\u0cbf\u0c97\u0cc6 \u0ca8\u0cc0\u0ca1\u0cbf',ta:'\u0ba8\u0ba9\u0bcd\u0b95\u0bca\u0b9f\u0bc8 \u0b85\u0bb3\u0bbf\u0baf\u0bc1\u0b99\u0bcd\u0b95\u0bb3\u0bcd',hi:'\u0938\u0939\u092f\u094b\u0917 \u0915\u0930\u0947\u0902',ml:'\u0d38\u0d02\u0d2d\u0d3e\u0d35\u0d28 \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d41\u0d15'},openStatus:{en:'Open',te:'\u0c24\u0c46\u0c30\u0c3f\u0c1a\u0c3f \u0c09\u0c02\u0c26\u0c3f',kn:'\u0ca4\u0cc6\u0cb0\u0cc6\u0ca6\u0cbf\u0ca6\u0cc6',ta:'\u0ba4\u0bbf\u0bb1\u0ba8\u0bcd\u0ba4\u0bc1\u0bb3\u0bcd\u0bb3\u0ba4\u0bc1',hi:'\u0916\u0941\u0932\u093e \u0939\u0948',ml:'\u0d24\u0d41\u0d31\u0d28\u0d4d\u0d28\u0d3f\u0d30\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28\u0d41'},viewButton:{en:'View',te:'\u0c1a\u0c42\u0c21\u0c02\u0c21\u0c3f',kn:'\u0ca8\u0ccb\u0ca1\u0cbf',ta:'\u0b95\u0bbe\u0ba3\u0bcd\u0b95',hi:'\u0926\u0947\u0916\u0947\u0902',ml:'\u0d15\u0d3e\u0d23\u0d41\u0d15'},getDirections:{en:'Get Directions',te:'\u0c26\u0c3e\u0c30\u0c3f \u0c1a\u0c42\u0c2a\u0c3f\u0c02\u0c1a\u0c41 (\u0c2e\u0c4d\u0c2f\u0c3e\u0c2a\u0c4d)',kn:'\u0ca6\u0cbf\u0c95\u0ccd\u0c95\u0cc1\u0c97\u0cb3\u0ca8\u0ccd\u0ca8\u0cc1 \u0caa\u0ca1\u0cc6\u0caf\u0cbf\u0cb0\u0cbf',ta:'\u0bb5\u0bb4\u0bbf\u0ba4\u0bcd\u0ba4\u0b9f\u0bae\u0bcd \u0b95\u0bbe\u0ba3\u0bcd\u0b95',hi:'\u0926\u093f\u0936\u093e-\u0928\u093f\u0930\u094d\u0926\u0947\u0936 \u092a\u094d\u0930\u093e\u092a\u094d\u0924 \u0915\u0930\u0947\u0902',ml:'\u0d35\u0d34\u0d3f \u0d15\u0d3e\u0d23\u0d41\u0d15'},contactCenter:{en:'Contact Center',te:'\u0c15\u0c47\u0c02\u0c26\u0c4d\u0c30\u0c3e\u0c28\u0c4d\u0c28\u0c3f \u0c38\u0c02\u0c2a\u0c4d\u0c30\u0c26\u0c3f\u0c02\u0c1a\u0c02\u0c21\u0c3f',kn:'\u0c95\u0cc7\u0c82\u0ca6\u0ccd\u0cb0\u0cb5\u0ca8\u0ccd\u0ca8\u0cc1 \u0cb8\u0c82\u0caa\u0cb0\u0ccd\u0c95\u0cbf\u0cb8\u0cbf',ta:'\u0bae\u0bc8\u0baf\u0ba4\u0bcd\u0ba4\u0bc8\u0ba4\u0bcd \u0ba4\u0bca\u0b9f\u0bb0\u0bcd\u0baa\u0bc1 \u0b95\u0bca\u0bb3\u0bcd\u0bb3',hi:'\u0915\u0947\u0902\u0926\u094d\u0930 \u0938\u0947 \u0938\u0902\u092a\u0930\u094d\u0915 \u0915\u0930\u0947\u0902',ml:'\u0d2c\u0d28\u0d4d\u0d27\u0d2a\u0d4d\u0d2a\u0d46\u0d1f\u0d41\u0d15'},officialTrustNote:{en:'Official Temple Trust Account Details',te:'\u0c05\u0c27\u0c3f\u0c15\u0c3e\u0c30\u0c3f\u0c15 \u0c26\u0c47\u0c35\u0c38\u0c4d\u0c25\u0c3e\u0c28\u0c02 \u0c1f\u0c4d\u0c30\u0c38\u0c4d\u0c1f\u0c4d \u0c16\u0c3e\u0c24\u0c3e \u0c35\u0c3f\u0c35\u0c30\u0c3e\u0c32\u0c41',kn:'\u0c85\u0ca7\u0cbf\u0c95\u0cc3\u0ca4 \u0ca6\u0cc7\u0cb5\u0cbe\u0cb2\u0caf \u0c9f\u0ccd\u0cb0\u0cb8\u0ccd\u0c9f\u0ccd \u0c96\u0cbe\u0ca4\u0cc6 \u0cb5\u0cbf\u0cb5\u0cb0\u0c97\u0cb3\u0cc1',ta:'\u0b85\u0ba4\u0bbf\u0b95\u0bbe\u0bb0\u0baa\u0bcd\u0baa\u0bc2\u0bb0\u0bcd\u0bb5 \u0b85\u0bb1\u0b95\u0bcd\u0b95\u0b9f\u0bcd\u0b9f\u0bb3\u0bc8 \u0b95\u0ba3\u0b95\u0bcd\u0b95\u0bc1 \u0bb5\u0bbf\u0bb5\u0bb0\u0b99\u0bcd\u0b95\u0bb3\u0bcd',hi:'\u0906\u0927\u093f\u0915\u093e\u0930\u093f\u0915 \u092e\u0902\u0926\u093f\u0930 \u091f\u094d\u0930\u0938\u094d\u091f \u0916\u093e\u0924\u093e \u0935\u093f\u0935\u0930\u0923',ml:'\u0d14\u0d26\u0d4d\u0d2f\u0d4b\u0d17\u0d3f\u0d15 \u0d1f\u0d4d\u0d30\u0d38\u0d4d\u0d31\u0d4d\u0d31\u0d4d \u0d05\u0d15\u0d4d\u0d15\u0d57\u0d23\u0d4d\u0d1f\u0d4d \u0d35\u0d3f\u0d35\u0d30\u0d19\u0d4d\u0d19\u0d7e'},gatewayNotice:{en:'Direct in-app payment gateway integration is currently onboarding with verified banking partners. Devotees may contribute directly through the authorized official temple devaswom trusts listed below.',te:'\u0c2f\u0c3e\u0c2a\u0c4d\u200c\u0c32\u0c4b \u0c28\u0c47\u0c30\u0c41\u0c17\u0c3e \u0c1a\u0c46\u0c32\u0c4d\u0c32\u0c3f\u0c02\u0c2a\u0c41 \u0c17\u0c47\u0c1f\u0c4d\u200c\u0c35\u0c47 \u0c2c\u0c4d\u0c2f\u0c3e\u0c02\u0c15\u0c3f\u0c02\u0c17\u0c4d \u0c2d\u0c3e\u0c17\u0c38\u0c4d\u0c35\u0c3e\u0c2e\u0c41\u0c32\u0c24\u0c4b \u0c2a\u0c30\u0c3f\u0c36\u0c40\u0c32\u0c28\u0c32\u0c4b \u0c09\u0c02\u0c26\u0c3f. \u0c2d\u0c15\u0c4d\u0c24\u0c41\u0c32\u0c41 \u0c15\u0c4d\u0c30\u0c3f\u0c02\u0c26 \u0c2a\u0c47\u0c30\u0c4d\u0c15\u0c4a\u0c28\u0c4d\u0c28 \u0c05\u0c27\u0c3f\u0c15\u0c3e\u0c30\u0c3f\u0c15 \u0c26\u0c47\u0c35\u0c38\u0c4d\u0c25\u0c3e\u0c28\u0c02 \u0c1f\u0c4d\u0c30\u0c38\u0c4d\u0c1f\u0c41\u0c32 \u0c26\u0c4d\u0c35\u0c3e\u0c30\u0c3e \u0c28\u0c47\u0c30\u0c41\u0c17\u0c3e \u0c35\u0c3f\u0c30\u0c3e\u0c33\u0c3e\u0c32\u0c41 \u0c38\u0c2e\u0c30\u0c4d\u0c2a\u0c3f\u0c02\u0c1a\u0c35\u0c1a\u0c4d\u0c1a\u0c41.',kn:'\u0c85\u0caa\u0ccd\u0cb2\u0cbf\u0c95\u0cc7\u0cb6\u0ca8\u0ccd\u200c\u0ca8\u0cb2\u0ccd\u0cb2\u0cbf \u0ca8\u0cc7\u0cb0 \u0caa\u0cbe\u0cb5\u0ca4\u0cbf \u0c97\u0cc7\u0c9f\u0ccd\u200c\u0cb5\u0cc7 \u0caa\u0ccd\u0cb0\u0c95\u0ccd\u0cb0\u0cbf\u0caf\u0cc6 \u0caa\u0ccd\u0cb0\u0c97\u0ca4\u0cbf\u0caf\u0cb2\u0ccd\u0cb2\u0cbf\u0ca6\u0cc6. \u0cad\u0c95\u0ccd\u0ca4\u0cb0\u0cc1 \u0c95\u0cc6\u0cb3\u0c97\u0cc6 \u0caa\u0c9f\u0ccd\u0c9f\u0cbf \u0cae\u0cbe\u0ca1\u0cb2\u0cbe\u0ca6 \u0c85\u0ca7\u0cbf\u0c95\u0cc3\u0ca4 \u0ca6\u0cc7\u0cb5\u0cbe\u0cb2\u0caf \u0c9f\u0ccd\u0cb0\u0cb8\u0ccd\u0c9f\u0ccd\u200c\u0c97\u0cb3 \u0cae\u0cc2\u0cb2\u0c95 \u0ca8\u0cc7\u0cb0\u0cb5\u0cbe\u0c97\u0cbf \u0ca6\u0cc7\u0ca3\u0cbf\u0c97\u0cc6 \u0ca8\u0cc0\u0ca1\u0cac\u0cb9\u0cc1\u0ca6\u0cc1.',ta:'\u0ba8\u0bc7\u0bb0\u0b9f\u0bbf \u0b95\u0b9f\u0bcd\u0b9f\u0ba3 \u0bae\u0bc1\u0bb1\u0bc8 \u0bb5\u0b99\u0bcd\u0b95\u0bbf \u0b9a\u0bb0\u0bbf\u0baa\u0bbe\u0bb0\u0bcd\u0baa\u0bcd\u0baa\u0bbf\u0bb2\u0bcd \u0b89\u0bb3\u0bcd\u0bb3\u0ba4\u0bc1. \u0baa\u0b95\u0bcd\u0ba4\u0bb0\u0bcd\u0b95\u0bb3\u0bcd \u0b95\u0bc0\u0bb4\u0bc7 \u0baa\u0b9f\u0bcd\u0b9f\u0bbf\u0baf\u0bb2\u0bbf\u0b9f\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0bc1\u0bb3\u0bcd\u0bb3 \u0b85\u0ba4\u0bbf\u0b95\u0bbe\u0bb0\u0baa\u0bcd\u0baa\u0bc2\u0bb0\u0bcd\u0bb5 \u0ba4\u0bc7\u0bb5\u0bb8\u0bcd\u0ba4\u0bbe\u0ba9 \u0b85\u0bb1\u0b95\u0bcd\u0b95\u0b9f\u0bcd\u0b9f\u0bb3\u0bc8\u0b95\u0bb3\u0bcd \u0bae\u0bc2\u0bb2\u0bae\u0bcd \u0ba8\u0bc7\u0bb0\u0b9f\u0bbf\u0baf\u0bbe\u0b95 \u0baa\u0b99\u0bcd\u0b95\u0bb3\u0bbf\u0b95\u0bcd\u0b95\u0bb2\u0bbe\u0bae\u0bcd.',hi:'\u0910\u092a \u092e\u0947\u0902 \u0938\u0940\u0927\u0947 \u0911\u0928\u0932\u093e\u0907\u0928 \u092d\u0941\u0917\u0924\u093e\u0928 \u0917\u0947\u091f\u0935\u0947 \u092c\u0948\u0902\u0915 \u0938\u0924\u094d\u092f\u093e\u092a\u0928 \u0915\u0947 \u0905\u0927\u0940\u0928 \u0939\u0948\u0964 \u0936\u094d\u0930\u0926\u094d\u0927\u093e\u0932\u0941 \u0928\u0940\u091a\u0947 \u0926\u093f\u090f \u0917\u090f \u0906\u0927\u093f\u0915\u093e\u0930\u093f\u0915 \u092e\u0902\u0926\u093f\u0930 \u0926\u0947\u0935\u0938\u094d\u0925\u093e\u0928\u092e \u091f\u094d\u0930\u0938\u094d\u091f\u094b\u0902 \u0915\u0947 \u092e\u093e\u0927\u094d\u092f\u092e \u0938\u0947 \u0938\u0940\u0927\u0947 \u0938\u0939\u092f\u094b\u0917 \u0915\u0930 \u0938\u0915\u0924\u0947 \u0939\u0948\u0902\u0964',ml:'\u0d28\u0d47\u0d30\u0d3f\u0d1f\u0d4d\u0d1f\u0d41\u0d33\u0d4d\u0d33 \u0d2a\u0d46\u0d2f\u0d4d\u0d2e\u0d46\u0d28\u0d4d\u0d31\u0d4d \u0d17\u0d47\u0d31\u0d4d\u0d31\u0d4d\u200c\u0d35\u0d47 \u0d2c\u0d3e\