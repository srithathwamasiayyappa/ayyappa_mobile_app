u092a\u0942\u091c\u092f\u093e\u092e\u093f\n    \u0913\u0902 \u0915\u092e\u0932\u0932\u094b\u091a\u0928\u093e\u092f \u0928\u092e\u0903 - \u0928\u0947\u0924\u094d\u0930\u0947 \u092a\u0942\u091c\u092f\u093e\u092e\u093f\n    \u0913\u0902 \u0915\u0938\u094d\u0924\u0942\u0930\u0940 \u0924\u093f\u0932\u0915\u093e\u0902\u091a\u093f\u0924 \u092b\u093e\u0932\u0928\u093e\u092f \u0928\u092e\u0903 - \u0932\u0932\u093e\u091f\u0902 \u092a\u0942\u091c\u092f\u093e\u092e\u093f\n    \u0913\u0902 \u0935\u0947\u0926\u0935\u093f\u0926\u0941\u0937\u0947 \u0928\u092e\u0903 - \u092e\u0941\u0916\u0902 \u092a\u0942\u091c\u092f\u093e\u092e\u093f\n    \u0913\u0902 \u0924\u094d\u0930\u093f\u0932\u094b\u0915\u0917\u0941\u0930\u0935\u0947 \u0928\u092e\u0903 - \u0936\u093f\u0930\u0903 \u092a\u0942\u091c\u092f\u093e\u092e\u093f\n    \u0913\u0902 \u092d\u0938\u094d\u092e\u094b\u0926\u094d\u0927\u0942\u0933\u093f\u0924 \u0935\u093f\u0917\u094d\u0930\u0939\u093e\u092f \u0928\u092e\u0903 - \u0938\u0930\u094d\u0935\u093e\u0923\u094d\u092f\u0902\u0917\u093e\u0928\u093f \u092a\u0942\u091c\u092f\u093e\u092e\u093f\n    \n    [ \u0936\u094d\u0930\u0940 \u0938\u0941\u092c\u094d\u0930\u0939\u094d\u092e\u0923\u094d\u092f \u0905\u0937\u094d\u091f\u094b\u0924\u094d\u0924\u0930 \u0936\u0924 \u0928\u093e\u092e\u093e\u0935\u0933\u093f ]\n    \u0913\u0902 \u0938\u094d\u0915\u0902\u0926\u093e\u092f \u0928\u092e\u0903\n    \u0913\u0902 \u0917\u0941\u0939\u093e\u092f \u0928\u092e\u0903\n    \u0913\u0902 \u0937\u0923\u094d\u092e\u0941\u0916\u093e\u092f \u0928\u092e\u0903\n    \u0913\u0902 \u092b\u093e\u0932\u0928\u0947\u0924\u094d\u0930\u0938\u0941\u0924\u093e\u092f \u0928\u092e\u0903\n    \u0913\u0902 \u092a\u094d\u0930\u092d\u0935\u0947 \u0928\u092e\u0903\n    \u0913\u0902 \u092a\u093f\u0902\u0917\u0933\u093e\u092f \u0928\u092e\u0903\n    \u0913\u0902 \u0915\u0943\u0924\u094d\u0924\u093f\u0915\u093e\u0938\u0942\u0928\u0935\u0947 \u0928\u092e\u0903\n    \u0913\u0902 \u0936\u093f\u0916\u093f\u0935\u093e\u0939\u093e\u092f \u0928\u092e\u0903\n    \u0913\u0902 \u0926\u094d\u0935\u093f\u0937\u0921\u094d\u092d\u0941\u091c\u093e\u092f \u0928\u092e\u0903\n    \u0913\u0902 \u0926\u094d\u0935\u093f\u0937\u0923\u094d\u0923\u0947\u0924\u094d\u0930\u093e\u092f \u0928\u092e\u0903\n    \u0913\u0902 \u0936\u0915\u094d\u0924\u093f\u0927\u0930\u093e\u092f \u0928\u092e\u0903\n    \u0913\u0902 \u092a\u093f\u0936\u093f\u0924\u093e\u0936 \u092a\u094d\u0930\u092d\u0902\u091c\u0928\u093e\u092f \u0928\u092e\u0903\n    \u0913\u0902 \u0924\u093e\u0930\u0915\u093e\u0938\u0941\u0930 \u0938\u0902\u0939\u093e\u0930\u093f\u0923\u0947 \u0928\u092e\u0903\n    \u0913\u0902 \u0930\u093e\u0915\u094d\u0937\u094b\u092c\u0932 \u0935\u093f\u092e\u0930\u094d\u0926\u0928\u093e\u092f \u0928\u092e\u0903\n    \u0913\u0902 \u092e\u0924\u094d\u0924\u093e\u092f \u0928\u092e\u0903\n    \u0913\u0902 \u092a\u094d\u0930\u092e\u0924\u094d\u0924\u093e\u092f \u0928\u092e\u0903\n    \u0913\u0902 \u0909\u0928\u094d\u092e\u0924\u094d\u0924\u093e\u092f \u0928\u092e\u0903\n    \u0913\u0902 \u0938\u0941\u0930\u0938\u0948\u0928\u094d\u092f \u0938\u0941\u0930\u0915\u094d\u0937\u0915\u093e\u092f \u0928\u092e\u0903\n    \u0913\u0902 \u0926\u0947\u0935\u0938\u0947\u0928\u093e\u092a\u0924\u092f\u0947 \u0928\u092e\u0903\n    \u0913\u0902 \u092a\u094d\u0930\u093e\u091c\u094d\u091e\u093e\u092f \u0928\u092e\u0903\n    \u0913\u0902 \u0915\u0943\u092a\u093e\u0932\u0935\u0947 \u0928\u092e\u0903\n    \u0913\u0902 \u092d\u0915\u094d\u0924\u0935\u0924\u094d\u0938\u0932\u093e\u092f \u0928\u092e\u0903\n    \u0913\u0902 \u0909\u092e\u093e\u0938\u0941\u0924\u093e\u092f \u0928\u092e\u0903\n    \u0913\u0902 \u0915\u0941\u092e\u093e\u0930\u093e\u092f \u0928\u092e\u0903\n    \u0913\u0902 \u0915\u094d\u0930\u094c\u0902\u091a\u0927\u093e\u0930\u0923\u093e\u092f \u0928\u092e\u0903\n    \u0913\u0902 \u0938\u0947\u0928\u093e\u0928\u094d\u092f\u0947 \u0928\u092e\u0903\n    \u0913\u0902 \u0905\u0917\u094d\u0928\u093f\u091c\u0928\u094d\u092e\u0928\u0947 \u0928\u092e\u0903\n