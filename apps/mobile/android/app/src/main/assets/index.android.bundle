b0 \u0cb5\u0cc0\u0c95\u0ccd\u0cb7\u0ca3\u0cc6\u0c97\u0cc6 \u0cac\u0ca6\u0cb2\u0cbe\u0caf\u0cbf\u0cb8\u0cbf',ta:'\ud83d\ude4f \u0baa\u0b95\u0bcd\u0ba4\u0bb0\u0bcd \u0baa\u0bbe\u0bb0\u0bcd\u0bb5\u0bc8\u0b95\u0bcd\u0b95\u0bc1 \u0bae\u0bbe\u0bb1\u0bb5\u0bc1\u0bae\u0bcd',hi:'\ud83d\ude4f \u092d\u0915\u094d\u0924 \u0926\u0943\u0936\u094d\u092f \u092a\u0930 \u091c\u093e\u090f\u0902',ml:'\ud83d\ude4f \u0d2d\u0d15\u0d4d\u0d24 \u0d2e\u0d4b\u0d21\u0d3f\u0d32\u0d47\u0d15\u0d4d\u0d15\u0d4d \u0d2e\u0d3e\u0d31\u0d41\u0d15'},switchToDharmaKartha:{en:'\ud83d\uded5 Switch to Dharma Kartha View',te:'\ud83d\uded5 \u0c27\u0c30\u0c4d\u0c2e\u0c15\u0c30\u0c4d\u0c24 \u0c35\u0c40\u0c15\u0c4d\u0c37\u0c23\u0c15\u0c41 \u0c2e\u0c3e\u0c30\u0c02\u0c21\u0c3f',kn:'\ud83d\uded5 \u0ca7\u0cb0\u0ccd\u0cae\u0c95\u0cb0\u0ccd\u0ca4\u0cb0 \u0cb5\u0cc0\u0c95\u0ccd\u0cb7\u0ca3\u0cc6\u0c97\u0cc6 \u0cac\u0ca6\u0cb2\u0cbe\u0caf\u0cbf\u0cb8\u0cbf',ta:'\ud83d\uded5 \u0ba4\u0bb0\u0bcd\u0bae\u0b95\u0bb0\u0bcd\u0ba4\u0bcd\u0ba4\u0bbe \u0baa\u0bbe\u0bb0\u0bcd\u0bb5\u0bc8\u0b95\u0bcd\u0b95\u0bc1 \u0bae\u0bbe\u0bb1\u0bb5\u0bc1\u0bae\u0bcd',hi:'\ud83d\uded5 \u0927\u0930\u094d\u092e\u0915\u0930\u094d\u0924\u093e \u0926\u0943\u0936\u094d\u092f \u092a\u0930 \u091c\u093e\u090f\u0902',ml:'\ud83d\uded5 \u0d27\u0d7c\u0d2e\u0d4d\u0d2e\u0d15\u0d7c\u0d24\u0d4d\u0d24\u0d3e\u0d35\u0d4d \u0d2e\u0d4b\u0d21\u0d3f\u0d32\u0d47\u0d15\u0d4d\u0d15\u0d4d \u0d2e\u0d3e\u0d31\u0d41\u0d15'},trusteeDashboardTitle:{en:'Sacred Trustee Dashboard',te:'\u0c2a\u0c35\u0c3f\u0c24\u0c4d\u0c30 \u0c27\u0c30\u0c4d\u0c2e\u0c15\u0c30\u0c4d\u0c24 \u0c21\u0c3e\u0c37\u0c4d\u200c\u0c2c\u0c4b\u0c30\u0c4d\u0c21\u0c4d',kn:'\u0caa\u0cb5\u0cbf\u0ca4\u0ccd\u0cb0 \u0ca7\u0cb0\u0ccd\u0cae\u0c95\u0cb0\u0ccd\u0ca4\u0cb0 \u0ca1\u0ccd\u0caf\u0cbe\u0cb6\u0ccd\u200c\u0cac\u0ccb\u0cb0\u0ccd\u0ca1\u0ccd',ta:'\u0baa\u0bc1\u0ba9\u0bbf\u0ba4 \u0ba4\u0bb0\u0bcd\u0bae\u0b95\u0bb0\u0bcd\u0ba4\u0bcd\u0ba4\u0bbe \u0b9f\u0bbe\u0bb7\u0bcd\u0baa\u0bcb\u0bb0\u0bcd\u0b9f\u0bc1',hi:'\u092a\u0935\u093f\u0924\u094d\u0930 \u0927\u0930\u094d\u092e\u0915\u0930\u094d\u0924\u093e \u0921\u0948\u0936\u092c\u094b\u0930\u094d\u0921',ml:'\u0d35\u0d3f\u0d36\u0d41\u0d26\u0d4d\u0d27 \u0d27\u0d7c\u0d2e\u0d4d\u0d2e\u0d15\u0d7c\u0d24\u0d4d\u0d24\u0d3e\u0d35\u0d4d \u0d21\u0d3e\u0d37\u0d4d\u200c\u0d2c\u0d4b\u0d7c\u0d21\u0d4d'},manageYourTemples:{en:'Manage Your Temples',te:'\u0c2e\u0c40 \u0c06\u0c32\u0c2f\u0c3e\u0c32 \u0c28\u0c3f\u0c30\u0c4d\u0c35\u0c39\u0c23',kn:'\u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0ca6\u0cc7\u0cb5\u0cbe\u0cb2\u0caf\u0c97\u0cb3 \u0ca8\u0cbf\u0cb0\u0ccd\u0cb5\u0cb9\u0ca3\u0cc6',ta:'\u0b89\u0b99\u0bcd\u0b95\u0bb3\u0bcd \u0b95\u0bcb\u0bb5\u0bbf\u0bb2\u0bcd\u0b95\u0bb3\u0bc8 \u0ba8\u0bbf\u0bb0\u0bcd\u0bb5\u0b95\u0bbf\u0b95\u0bcd\u0b95\u0bb5\u0bc1\u0bae\u0bcd',hi:'\u0905\u092a\u0928\u0947 \u092e\u0902\u0926\u093f\u0930\u094b\u0902 \u0915\u093e \u092a\u094d\u0930\u092c\u0902\u0927\u0928 \u0915\u0930\u0947\u0902',ml:'\u0d28\u0d3f\u0d19\u0d4d\u0d19\u0d33\u0d41\u0d1f\u0d46 \u0d15\u0d4d\u0d37\u0d47\u0d24\u0d4d\u0d30\u0d19\u0d4d\u0d19\u0d7e \u0d15\u0d48\u0d15\u0d3e\u0d30\u0d4d\u0d2f\u0d02 \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d41\u0d15'},manageYourTemplesSubtitle:{en:'View & configure registered mandirs',te:'\u0c28\u0c2e\u0c4b\u0c26\u0c48\u0c28 \u0c06\u0c32\u0c2f\u0c3e\u0c32 \u0c35\u0c3f\u0c35\u0c30\u0c3e\u0c32\u0c41 & \u0c38\u0c47\u0c35\u0c32\u0c41',kn:'\u0ca8\u0ccb\u0c82\u0ca6\u0cbe\u0caf\u0cbf\u0ca4 \u0ca6\u0cc7\u0cb5\u0cbe\u0cb2\u0caf\u0c97\u0cb3 \u0cae\u0cbe\u0cb9\u0cbf\u0ca4\u0cbf & \u0cb8\u0cc7\u0cb5\u0cc6\u0c97\u0cb3\u0cc1',ta:'\u0baa\u0ba4\u0bbf\u0bb5\u0bc1 \u0b9a\u0bc6\u0baf\u0bcd\u0baf\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f \u0b95\u0bcb\u0bb5\u0bbf\u0bb2\u0bcd\u0b95\u0bb3\u0bcd & \u0b9a\u0bc7\u0bb5\u0bc8\u0b95\u0bb3\u0bcd',hi:'\u092a\u0902\u091c\u0940\u0915\u0943\u0924 \u092e\u0902\u0926\u093f\u0930 \u090f\u0935\u0902 \u0938\u0947\u0935\u093e\u0913\u0902 \u0915\u093e \u0935\u093f\u0935\u0930\u0923',ml:'\u0d30\u0d1c\u0d3f\u0d38\u0d4d\u0d31\u0d4d\u0d31\u0d7c \u0d1a\u0d46\u0d2f\u0d4d\u0d24 \u0d15\u0d4d\u0d37\u0d47\u0d24\u0d4d\u0d30\u0d19\u0d4d\u0d19\u0d7e'},addManageMandir:{en:'Add / Manage Mandir',te:'\u0c28\u0c42\u0c24\u0c28 \u0c06\u0c32\u0c2f\u0c02 \u0c1a\u0c47\u0c30\u0c4d\u0c1a\u0c02\u0c21\u0c3f / \u0c28\u0c3f\u0c30\u0c4d\u0c35\u0c39\u0c3f\u0c02\u0c1a\u0c02\u0c21\u0c3f',kn:'\u0cb9\u0cca\u0cb8 \u0ca6\u0cc7\u0cb5\u0cbe\u0cb2\u0caf \u0cb8\u0cc7\u0cb0\u0cbf\u0cb8\u0cbf / \u0ca8\u0cbf\u0cb0\u0ccd\u0cb5\u0cb9\u0cbf\u0cb8\u0cbf',ta:'\u0baa\u0bc1\u0ba4\u0bbf\u0baf \u0b95\u0bcb\u0bb5\u0bbf\u0bb2\u0bcd \u0b9a\u0bc7\u0bb0\u0bcd\u0b95\u0bcd\u0b95 / \u0ba8\u0bbf\u0bb0\u0bcd\u0bb5\u0b95\u0bbf\u0b95\u0bcd\u0b95',hi:'\u0928\u092f\u093e \u092e\u0902\u0926\u093f\u0930 \u091c\u094b\u0921\u093c\u0947\u0902 / \u092a\u094d\u0930\u092c\u0902\u0927\u093f\u0924 \u0915\u0930\u0947\u0902',ml:'\u0d15\u0d4d\u0d37\u0d47\u0d24\u0d4d\u0d30\u0d02 \u0d1a\u0d47\u0d7c\u0d15\u0d4d\u0d15\u0d41\u0d15'},addManageMandirSubtitle:{en:'Register shrine, deities & darshan timings',te:'\u0c06\u0c32\u0c2f\u0c02, \u0c26\u0c47\u0c35\u0c24\u0c3e\u0c2e\u0c42\u0c30\u0c4d\u0c24\u0c41\u0c32\u0c41 & \u0c26\u0c30\u0c4d\u0c36\u0c28 \u0c38\u0c2e\u0c2f\u0c3e\u0c32\u0c41',kn:'\u0ca6\u0cc7\u0cb5\u0cbe\u0cb2\u0caf, \u0ca6\u0cc7\u0cb5\u0ca4\u0cc6\u0c97\u0cb3\u0cc1 & \u0ca6\u0cb0\u0ccd\u0cb6\u0ca8 \u0cb8\u0cae\u0caf\u0c97\u0cb3\u0cc1',ta:'\u0b95\u0bcb\u0bb5\u0bbf\u0bb2\u0bcd, \u0ba4\u0bc6\u0baf\u0bcd\u0bb5\u0b99\u0bcd\u0b95\u0bb3\u0bcd & \u0ba4\u0bb0\u0bbf\u0b9a\u0ba9 \u0ba8\u0bc7\u0bb0\u0bae\u0bcd',hi:'\u092e\u0902\u0926\u093f\u0930, \u0935\u093f\u0917\u094d\u0930\u0939 \u090f\u0935\u0902 \u0926\u0930\u094d\u0936\u0928 \u0915\u093e \u0938\u092e\u092f',ml:'\u0d15\u0d4d\u0d37\u0d47\u0d24\u0d4d\u0d30 \u0d35\u0d3f\u0d35\u0d30\u0d19\u0d4d\u0d19\u0d7e'},manageEvents:{en:'Manage Events',te:'\u0c27\u0c3e\u0c30\u0c4d\u0c2e\u0c3f\u0c15 \u0c09\u0c24\u0c4d\u0c38\u0c35\u0c3e\u0c32 \u0c28\u0c3f\u0c30\u0c4d\u0c35\u0c39\u0c23',kn:'\u0ca7\u0cbe\u0cb0\u0ccd\u0cae\u0cbf\u0c95 \u0c95\u0cbe\u0cb0\u0ccd\u0caf\u0c95\u0ccd\u0cb0\u0cae\u0c97\u0cb3 \u0ca8\u0cbf\u0cb0\u0ccd\u0cb5\u0cb9\u0ca3\u0cc6',ta:'\u0ba8\u0bbf\u0b95\u0bb4\u0bcd\u0bb5\u0bc1\u0b95\u0bb3\u0bc8 \u0ba8\u0bbf\u0bb0\u0bcd\u0bb5\u0b95\u0bbf\u0b95\u0bcd\u0b95\u0bb5\u0bc1\u0bae\u0bcd',hi:'\u0927\u093e\u0930\u094d\u092e\u093f\u0915 \u0906\u092f\u094b\u091c\u0928\u094b\u0902 \u0915\u093e \u092a\u094d\u0930\u092c\u0902\u0927\u0928',ml:'\u0d35\u0d3f\u0d36\u0d47\u0d37\u0d19\u0d4d\u0d19\u0d7e \u0d15\u0d48\u0d15\u0d3e\u0d30\u0d4d\u0d2f\u0d02 \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d41\u0d15'},manageEventsSubtitle:{en:'Poojas, homams, sevas & annadanam',te:'\u0c2a\u0c42\u0c1c\u0c32\u0c41, \u0c39\u0c4b\u0c2e\u0c3e\u0c32\u0c41, \u0c28\u0c3f\u0c24\u0c4d\u0c2f \u0c38\u0c47\u0c35\u0c32\u0c41 & \u0c05\u0c28\u0c4d\u0c28\u0c26\u0c3e\u0c28\u0c02',kn:'\u0caa\u0cc2\u0c9c\u0cc6\u0c97\u0cb3\u0cc1, \u0cb9\u0ccb\u0cae\u0c97\u0cb3\u0cc1 & \u0c85\u0ca8\u0ccd\u0ca8\u0ca6\u0cbe\u0ca8',ta:'\u0baa\u0bc2\u0b9c\u0bc8\u0b95\u0bb3\u0bcd, \u0bb9\u0bcb\u0bae\u0b99\u0bcd\u0b95\u0bb3\u0bcd & \u0b85\u0ba9\u0bcd\u0ba9\u0ba4\u0bbe\u0ba9\u0bae\u0bcd',hi:'\u092a\u0942\u091c\u093e, \u0939\u0935\u0928, \u0938\u0947\u0935\u093e \u090f\u0935\u0902 \u0905\u0928\u094d\u0928\u0926\u093e\u0928',ml:'\u0d2a\u0d42\u0d1c\u0d15\u0d33\u0d41\u0d02 \u0d05\u0d28\u0d4d\u0d28\u0d26\u0d3e\u0d28\u0d35\u0d41\u0d02'},sacredGallery:{en:'Sacred Gallery',te:'\u0c26\u0c3f\u0c35\u0c4d\u0c2f \u0c1a\u0c3f\u0c24\u0c4d\u0c30\u0c2e\u0c3e\u0c32\u0c3f\u0c15 (\u0c17\u0c4d\u0c2f\u0c3e\u0c32\u0c30\u0c40)',kn:'\u0caa\u0cb5\u0cbf\u0ca4\u0ccd\u0cb0 \u0c97\u0ccd\u0caf\u0cbe\u0cb2\u0cb0\u0cbf',ta:'\u0baa\u0bc1\u0ba9\u0bbf\u0ba4 \u0baa\u0bc1\u0b95\u0bc8\u0baa\u0bcd\u0baa\u0b9f\u0b99\u0bcd\u0b95\u0bb3\u0bcd',hi:'\u0926\u093f\u0935\u094d\u092f \u0917\u0948\u0932\u0930\u0940',ml:'\u0d17\u0d3e\u0d32\u0d31\u0d3f'},sacredGallerySubtitle:{en:'Sanctum photos, gopuram & alankaram',te:'\u0c17\u0c30\u0c4d\u0c2d\u0c17\u0c41\u0c21\u0c3f, \u0c17\u0c4b\u0c2a\u0c41\u0c30\u0c02 & \u0c28\u0c3f\u0c24\u0c4d\u0c2f\u0c3e\u0c32\u0c02\u0c15\u0c30\u0c23 \u0c2b\u0c4a\u0c1f\u0c4b\u0c32\u0c41',kn:'\u0c97\u0cb0\u0ccd\u0cad\u0c97\u0cc1\u0ca1\u0cbf, \u0c97\u0ccb\u0caa\u0cc1\u0cb0 & \u0c85\u0cb2\u0c82\u0c95\u0cbe\u0cb0 \u0cab\u0ccb\u0c9f\u0ccb\u0c97\u0cb3\u0cc1',ta:'\u0b95\u0bb0\u0bc1\u0bb5\u0bb1\u0bc8, \u0b95\u0bcb\u0baa\u0bc1\u0bb0\u0bae\u0bcd & \u0b85\u0bb2\u0b99\u0bcd\u0b95\u0bbe\u0bb0\u0baa\u0bcd \u0baa\u0b9f\u0b99\u0bcd\u0b95\u0bb3\u0bcd',hi:'\u0917\u0930\u094d\u092d\u0917\u0943\u0939, \u0917\u094b\u092a\u0941\u0930\u092e \u090f\u0935\u0902 \u0936\u0943\u0902\u0917\u093e\u0930 \u091b\u093e\u092f\u093e\u091a\u093f\u0924\u094d\u0930',ml:'\u0d15\u0d4d\u0d37\u0d47\u0d24\u0d4d\u0d30 \u0d1a\u0d3f\u0d24\u0d4d\u0d30\u0d19\u0d4d\u0d19\u0d7e'},regMandir:{en:'Registered Mandir',te:'\u0c28\u0c2e\u0c4b\u0c26\u0c48\u0c28 \u0c06\u0c32\u0c2f\u0c3e\u0c32\u0c41',kn:'\u0ca8\u0ccb\u0c82\u0ca6\u0cbe\u0caf\u0cbf\u0ca4 \u0cae\u0c82\u0ca6\u0cbf\u0cb0',ta:'\u0baa\u0ba4\u0bbf\u0bb5\u0bc1 \u0b9a\u0bc6\u0baf\u0bcd\u0baf\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f \u0b95\u0bcb\u0bb5\u0bbf\u0bb2\u0bcd',hi:'\u092a\u0902\u091c\u0940\u0915\u0943\u0924 \u092e\u0902\u0926\u093f\u0930',ml:'\u0d15\u0d4d\u0d37\u0d47\u0d24\u0d4d\u0d30\u0d19\u0d4d\u0d19\u0d7e'},templeFestivalsDb:{en:'Temple Festivals (DB)',te:'\u0c06\u0c32\u0c2f \u0c09\u0c24\u0c4d\u0c38\u0c35\u0c3e\u0c32\u0c41 (DB)',kn:'\u0ca6\u0cc7\u0cb5\u0cbe\u0cb2\u0caf\u0ca6 \u0cb9\u0cac\u0ccd\u0cac\u0c97\u0cb3\u0cc1 (DB)',ta:'\u0b95\u0bcb\u0bb5\u0bbf\u0bb2\u0bcd \u0ba4\u0bbf\u0bb0\u0bc1\u0bb5\u0bbf\u0bb4\u0bbe\u0b95\u0bcd\u0b95\u0bb3\u0bcd (DB)',hi:'\u092e\u0902\u0926\u093f\u0930 \u0909\u0924\u094d\u0938\u0935 (DB)',ml:'\u0d15\u0d4d\u0d37\u0d47\u0d24\u0d4d\u0d30 \u0d09\u0d24\u0d4d\u0d38\u0d35\u0d19\u0d4d\u0d19\u0d7e (DB)'},devotionalEventsDb:{en:'Devotional Events (DB)',te:'\u0c2a\u0c42\u0c1c\u0c3e \u0c15\u0c3e\u0c30\u0c4d\u0c2f\u0c15\u0c4d\u0c30\u0c2e\u0c3e\u0c32\u0c41 (DB)',kn:'\u0ca7\u0cbe\u0cb0\u0ccd\u0cae\u0cbf\u0c95 \u0c95\u0cbe\u0cb0\u0ccd\u0caf\u0c95\u0ccd\u0cb0\u0cae\u0c97\u0cb3\u0cc1 (DB)',ta:'\u0baa\u0b95\u0bcd\u0ba4\u0bbf \u0ba8\u0bbf\u0b95\u0bb4\u0bcd\u0bb5\u0bc1\u0b95\u0bb3\u0bcd (DB)',hi:'\u0927\u093e\u0930\u094d\u092e\u093f\u0915 \u0915\u093e\u0930\u094d\u092f\u0915\u094d\u0930\u092e (DB)',ml:'\u0d2d\u0d15\u0d4d\u0d24\u0d3f \u0d2a\u0d30\u0d3f\u0d2a\u0d3e\u0d1f\u0d3f\u0d15\u0d7e (DB)'},sacredPhotosDb:{en:'Sacred Photos (DB)',te:'\u0c26\u0c3f\u0c35\u0c4d\u0c2f \u0c1a\u0c3f\u0c24\u0c4d\u0c30\u0c3e\u0c32\u0c41 (DB)',kn:'\u0caa\u0cb5\u0cbf\u0ca4\u0ccd\u0cb0 \u0cab\u0ccb\u0c9f\u0ccb\u0c97\u0cb3\u0cc1 (DB)',ta:'\u0baa\u0bc1\u0ba9\u0bbf\u0ba4 \u0baa\u0bc1\u0b95\u0bc8\u0baa\u0bcd\u0baa\u0b9f\u0b99\u0bcd\u0b95\u0bb3\u0bcd (DB)',hi:'\u092a\u0935\u093f\u0924\u094d\u0930 \u091b\u093e\u092f\u093e\u091a\u093f\u0924\u094d\u0930 (DB)',ml:'\u0d2a\u0d35\u0d3f\u0d24\u0d4d\u0d30 \u0d2b\u0d4b\u0d1f\u0d4d\u0d1f\u0d4b\u0d15\u0d7e (DB)'},screenTitle:{en:'My Profile',te:'\u0c28\u0c3e \u0c2a\u0c4d\u0c30\u0c4a\u0c2b\u0c48\u0c32\u0c4d',kn:'\u0ca8\u0ca8\u0ccd\u0ca8 \u0caa\u0ccd\u0cb0\u0cca\u0cab\u0cc8\u0cb2\u0ccd',ta:'\u0b8e\u0ba9\u0ba4\u0bc1 \u0b9a\u0bc1\u0baf\u0bb5\u0bbf\u0bb5\u0bb0\u0bae\u0bcd',hi:'\u092e\u0947\u0930\u0940 \u092a\u094d\u0930\u094b\u092b\u093e\u0907\u0932',ml:'\u0d0e\u0d28\u0d4d\u0d31\u0d46 \u0d2a\u0d4d\u0d30\u0d4a\u0d2b\u0d48\u0d7d'},editProfile:{en:'Edit Profile',te:'\u0c2a\u0c4d\u0c30\u0c4a\u0c2b\u0c48\u0c32\u0c4d \u0c0e\u0c21\u0c3f\u0c1f\u0c4d \u0c1a\u0c47\u0c2f\u0c02\u0c21\u0c3f',kn:'\u0caa\u0ccd\u0cb0\u0cca\u0cab\u0cc8\u0cb2\u0ccd \u0ca4\u0cbf\u0ca6\u0ccd\u0ca6\u0cc1\u0caa\u0ca1\u0cbf',ta:'\u0b9a\u0bc1\u0baf\u0bb5\u0bbf\u0bb5\u0bb0\u0bae\u0bcd \u0ba4\u0bbf\u0bb0\u0bc1\u0ba4\u0bcd\u0ba4\u0bc1',hi:'\u092a\u094d\u0930\u094b\u092b\u093e\u0907\u0932 \u0938\u0902\u092a\u093e\u0926\u093f\u0924 \u0915\u0930\u0947\u0902',ml:'\u0d2a\u0d4d\u0d30\u0d4a\u0d2b\u0d48\u0d7d \u0d2e\u0d3e\u0d31\u0d4d\u0d31\u0d41\u0d15'},loginRegister:{en:'Login / Register',te:'\u0c32\u0c3e\u0c17\u0c3f\u0c28\u0c4d / \u0c30\u0c3f\u0c1c\u0c3f\u0c38\u0c4d\u0c1f\u0c30\u0c4d',kn:'\u0cb2\u0cbe\u0c97\u0cbf\u0ca8\u0ccd / \u0ca8\u0ccb\u0c82\u0ca6\u0ca3\u0cbf',ta:'\u0b89\u0bb3\u0bcd\u0ba8\u0bc1\u0bb4\u0bc8\u0baf / \u0baa\u0ba4\u0bbf\u0bb5\u0bc1',hi:'\u0932\u0949\u0917\u093f\u0928 / \u0930\u091c\u093f\u0938\u094d\u091f\u0930',ml:'\u0d32\u0d4b\u0d17\u0d3f\u0d7b / \u0d30\u0d1c\u0d3f\u0d38\u0d4d\u0d31\u0d4d\u0d31\u0d7c'},myBookmarks:{en:'My Bookmarks',te:'\u0c28\u0c3e \u0c2c\u0c41\u0c15\u0c4d\u200c\u0c2e\u0c3e\u0c30\u0c4d\u0c15\u0c4d\u200c\u0c32\u0c41',kn:'\u0ca8\u0ca8\u0ccd\u0ca8 \u0cac\u0cc1\u0c95\u0ccd\u200c\u0cae\u0cbe\u0cb0\u0ccd\u0c95\u0ccd\u200c\u0c97\u0cb3\u0cc1',ta:'\u0b8e\u0ba9\u0ba4\u0bc1 \u0bb5\u0bbf\u0bb0\u0bc1\u0baa\u0bcd\u0baa\u0b99\u0bcd\u0b95\u0bb3\u0bcd',hi:'\u092e\u0947\u0930\u0947 \u092c\u0941\u0915\u092e\u093e\u0930\u094d\u0915',ml:'\u0d0e\u0d28\u0d4d\u0d31\u0d46 \u0d2c\u0d41\u0d15\u0d4d\u0d15\u0d4d\u0d2e\u0d3e\u0d7c\u0d15\u0d4d\u0d15\u0d41\u0d15\u0d7e'},myBookmarksSubtitle:{en:'Saved stotras, poojas, temples',te:'\u0c38\u0c47\u0c35\u0c4d \u0c1a\u0c47\u0c38\u0c3f\u0c28 \u0c38\u0c4d\u0c24\u0c4b\u0c24\u0c4d\u0c30\u0c3e\u0c32\u0c41, \u0c2a\u0c42\u0c1c\u0c32\u0c41, \u0c06\u0c32\u0c2f\u0c3e\u0c32\u0c41',kn:'\u0c89\u0cb3\u0cbf\u0cb8\u0cbf\u0ca6 \u0cb8\u0ccd\u0ca4\u0ccb\u0ca4\u0ccd\u0cb0\u0c97\u0cb3\u0cc1, \u0caa\u0cc2\u0c9c\u0cc6\u0c97\u0cb3\u0cc1, \u0ca6\u0cc7\u0cb5\u0cbe\u0cb2\u0caf\u0c97\u0cb3\u0cc1',ta:'\u0b9a\u0bc7\u0bae\u0bbf\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f \u0bb8\u0bcd\u0ba4\u0bcb\u0ba4\u0bcd\u0ba4\u0bbf\u0bb0\u0b99\u0bcd\u0b95\u0bb3\u0bcd, \u0baa\u0bc2\u0b9c\u0bc8\u0b95\u0bb3\u0bcd, \u0b95\u0bcb\u0baf\u0bbf\u0bb2\u0bcd\u0b95\u0bb3\u0bcd',hi:'\u0938\u0939\u0947\u091c\u0947 \u0917\u090f \u0938\u094d\u0924\u094b\u0924\u094d\u0930, \u092a\u0942\u091c\u093e \u090f\u0935\u0902 \u092e\u0902\u0926\u093f\u0930',ml:'\u0d38\u0d42\u0d15\u0d4d\u0d37\u0d3f\u0d1a\u0d4d\u0d1a \u0d38\u0d4d\u0d24\u0d4b\u0d24\u0d4d\u0d30\u0d19\u0d4d\u0d19\u0d7e, \u0d2a\u0d42\u0d1c\u0d15\u0d7e, \u0d15\u0d4d\u0d37\u0d47\u0d24\u0d4d\u0d30\u0d19\u0d4d\u0d19\u0d7e'},notifications:{en:'Notifications',te:'\u0c28\u0c4b\u0c1f\u0c3f\u0c2b\u0c3f\u0c15\u0c47\u0c37\u0c28\u0c4d\u0c32\u0c41',kn:'\u0c85\u0ca7\u0cbf\u0cb8\u0cc2\u0c9a\u0ca8\u0cc6\u0c97\u0cb3\u0cc1',ta:'\u0b85\u0bb1\u0bbf\u0bb5\u0bbf\u0baa\u0bcd\u0baa\u0bc1\u0b95\u0bb3\u0bcd',hi:'\u0938\u0942\u091a\u0928\u093e\u090f\u0902',ml:'\u0d05\u0d31\u0d3f\u0d2f\u0d3f\u0d2a\u0d4d\u0d2a\u0d41\u0d15\u0d7e'},notificationsSubtitle:{en:'Manage alerts & reminders',te:'\u0c05\u0c32\u0c46\u0c30\u0c4d\u0c1f\u0c4d\u0c38\u0c4d & \u0c30\u0c3f\u0c2e\u0c48\u0c02\u0c21\u0c30\u0c4d\u0c32 \u0c28\u0c3f\u0c30\u0c4d\u0c35\u0c39\u0c23',kn:'\u0c8e\u0c9a\u0ccd\u0c9a\u0cb0\u0cbf\u0c95\u0cc6\u0c97\u0cb3\u0cc1 & \u0c9c\u0ccd\u0c9e\u0cbe\u0caa\u0ca8\u0cc6\u0c97\u0cb3 \u0ca8\u0cbf\u0cb0\u0ccd\u0cb5\u0cb9\u0ca3\u0cc6',ta:'\u0bb5\u0bbf\u0bb4\u0bbf\u0baa\u0bcd\u0baa\u0bc2\u0b9f\u0bcd\u0b9f\u0bb2\u0bcd\u0b95\u0bb3\u0bcd & \u0ba8\u0bbf\u0ba9\u0bc8\u0bb5\u0bc2\u0b9f\u0bcd\u0b9f\u0bb2\u0bcd\u0b95\u0bb3\u0bcd',hi:'\u0905\u0932\u0930\u094d\u091f \u090f\u0935\u0902 \u0905\u0928\u0941\u0938\u094d\u092e\u093e\u0930\u0915 \u092a\u094d\u0930\u092c\u0902\u0927\u093f\u0924 \u0915\u0930\u0947\u0902',ml:'\u0d05\u0d31\u0d3f\u0d2f\u0d3f\u0d2a\u0d4d\u0d2a\u0d41\u0d15\u0d7e & \u0d13\u0d7c\u0d2e\u0d4d\u0d2e\u0d2a\u0d4d\u0d2a\u0d46\u0d1f\u0d41\u0d24\u0d4d\u0d24\u0d32\u0d41\u0d15\u0d7e'},festivals:{en:'Festivals & Sacred Days',te:'\u0c2a\u0c02\u0c21\u0c41\u0c17\u0c32\u0c41 & \u0c35\u0c3f\u0c36\u0c47\u0c37 \u0c26\u0c3f\u0c28\u0c3e\u0c32\u0c41',kn:'\u0cb9\u0cac\u0ccd\u0cac\u0c97\u0cb3\u0cc1 & \u0caa\u0cb5\u0cbf\u0ca4\u0ccd\u0cb0 \u0ca6\u0cbf\u0ca8\u0c97\u0cb3\u0cc1',ta:'\u0ba4\u0bbf\u0bb0\u0bc1\u0bb5\u0bbf\u0bb4\u0bbe\u0b95\u0bcd\u0b95\u0bb3\u0bcd & \u0b9a\u0bbf\u0bb1\u0baa\u0bcd\u0baa\u0bc1 \u0ba8\u0bbe\u0b9f\u0bcd\u0b95\u0bb3\u0bcd',hi:'\u0924\u094d\u092f\u094c\u0939\u093e\u0930 \u090f\u0935\u0902 \u0935\u093f\u0936\u0947\u0937 \u0926\u093f\u0928',ml:'\u0d09\u0d24\u0d4d\u0d38\u0d35\u0d19\u0d4d\u0d19\u0d33\u0d41\u0d02 \u0d35\u0d3f\u0d36\u0d47\u0d37 \u0d26\u0d3f\u0d28\u0d19\u0d4d\u0d19\u0d33\u0d41\u0d02'},festivalsSubtitle:{en:'Vedic Panchangam & celebrations',te:'\u0c35\u0c48\u0c26\u0c3f\u0c15 \u0c2a\u0c02\u0c1a\u0c3e\u0c02\u0c17 \u0c2a\u0c02\u0c21\u0c41\u0c17\u0c32\u0c41 & \u0c35\u0c47\u0c21\u0c41\u0c15\u0c32\u0c41',kn:'\u0cb5\u0cc8\u0ca6\u0cbf\u0c95 \u0caa\u0c82\u0c9a\u0cbe\u0c82\u0c97 \u0cb9\u0cac\u0ccd\u0cac\u0c97\u0cb3\u0cc1 & \u0c86\u0c9a\u0cb0\u0ca3\u0cc6\u0c97\u0cb3\u0cc1',ta:'\u0bb5\u0bc7\u0ba4 \u0baa\u0b9e\u0bcd\u0b9a\u0bbe\u0b99\u0bcd\u0b95 \u0ba4\u0bbf\u0bb0\u0bc1\u0bb5\u0bbf\u0bb4\u0bbe\u0b95\u0bcd\u0b95\u0bb3\u0bcd',hi:'\u0935\u0948\u0926\u093f\u0915 \u092a\u0902\u091a\u093e\u0902\u0917 \u0924\u094d\u092f\u094c\u0939\u093e\u0930 \u090f\u0935\u0902 \u0909\u0924\u094d\u0938\u0935',ml:'\u0d35\u0d48\u0d26\u0d3f\u0d15 \u0d2a\u0d1e\u0d4d\u0d1a\u0d3e\u0d02\u0d17 \u0d2a\u0d41\u0d23\u0d4d\u0d2f\u0d26\u0d3f\u0d28\u0d19\u0d4d\u0d19\u0d7e'},appPreferences:{en:'App Language',te:'\u0c2f\u0c3e\u0c2a\u0c4d \u0c2d\u0c3e\u0c37',kn:'\u0c85\u0caa\u0ccd\u0cb2\u0cbf\u0c95\u0cc7\u0cb6\u0ca8\u0ccd \u0cad\u0cbe\u0cb7\u0cc6',ta:'\u0b9a\u0bc6\u0baf\u0bb2\u0bbf \u0bae\u0bca\u0bb4\u0bbf',hi:'\u0910\u092a \u092d\u093e\u0937\u093e',ml:'\u0d06\u0d2a\u0d4d\u0d2a\u0d4d \u0d2d\u0d3e\u0d37'},appPreferencesSubtitle:{en:'Change devotional content language',te:'\u0c2d\u0c15\u0c4d\u0c24\u0c3f \u0c15\u0c02\u0c1f\u0c46\u0c02\u0c1f\u0c4d \u0c2d\u0c3e\u0c37\u0c28\u0c41 \u0c2e\u0c3e\u0c30\u0c4d\u0c1a\u0c02\u0c21\u0c3f',kn:'\u0cad\u0c95\u0ccd\u0ca4\u0cbf \u0cb5\u0cbf\u0cb7\u0caf\u0ca6 \u0cad\u0cbe\u0cb7\u0cc6\u0caf\u0ca8\u0ccd\u0ca8\u0cc1 \u0cac\u0ca6\u0cb2\u0cbe\u0caf\u0cbf\u0cb8\u0cbf',ta:'\u0baa\u0b95\u0bcd\u0ba4\u0bbf \u0b89\u0bb3\u0bcd\u0bb3\u0b9f\u0b95\u0bcd\u0b95 \u0bae\u0bca\u0bb4\u0bbf\u0baf\u0bc8 \u0bae\u0bbe\u0bb1\u0bcd\u0bb1\u0bb5\u0bc1\u0bae\u0bcd',hi:'\u092d\u0915\u094d\u0924\u093f \u0938\u093e\u092e\u0917\u094d\u0930\u0940 \u092d\u093e\u0937\u093e \u092c\u0926\u0932\u0947\u0902',ml:'\u0d2d\u0d15\u0d4d\u0d24\u0d3f \u0d09\u0d33\u0d4d\u0d33\u0d1f\u0d15\u0d4d\u0d15 \u0d2d\u0d3e\u0d37 \u0d2e\u0d3e\u0d31\u0d4d\u0d31\u0d41\u0d15'},legalPolicies:{en:'Legal & Policies',te:'\u0c28\u0c3f\u0c2c\u0c02\u0c27\u0c28\u0c32\u0c41 & \u0c35\u0c3f\u0c27\u0c3e\u0c28\u0c3e\u0c32\u0c41',kn:'\u0c95\u0cbe\u0ca8\u0cc2\u0ca8\u0cc1 & \u0ca8\u0cc0\u0ca4\u0cbf\u0c97\u0cb3\u0cc1',ta:'\u0bb5\u0bbf\u0ba4\u0bbf\u0bae\u0bc1\u0bb1\u0bc8\u0b95\u0bb3\u0bcd & \u0b95\u0bca\u0bb3\u0bcd\u0b95\u0bc8\u0b95\u0bb3\u0bcd',hi:'\u0928\u093f\u092f\u092e \u090f\u0935\u0902 \u0928\u0940\u0924\u093f\u092f\u093e\u0902',ml:'\u0d28\u0d3f\u0d2f\u0d2e\u0d19\u0d4d\u0d19\u0d33\u0d41\u0d02 \u0d28\u0d2f\u0d19\u0d4d\u0d19\u0d33\u0d41\u0d02'},legalPoliciesSubtitle:{en:'Terms, Privacy & More',te:'\u0c28\u0c3f\u0c2c\u0c02\u0c27\u0c28\u0c32\u0c41, \u0c17\u0c4b\u0c2a\u0c4d\u0c2f\u0c24\u0c3e \u0c35\u0c3f\u0c27\u0c3e\u0c28\u0c02',kn:'\u0cb7\u0cb0\u0ca4\u0ccd\u0ca4\u0cc1\u0c97\u0cb3\u0cc1, \u0c97\u0ccc\u0caa\u0ccd\u0caf\u0ca4\u0cc6 \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c87\u0ca8\u0ccd\u0ca8\u0cb7\u0ccd\u0c9f\u0cc1',ta:'\u0bb5\u0bbf\u0ba4\u0bbf\u0bae\u0bc1\u0bb1\u0bc8\u0b95\u0bb3\u0bcd, \u0ba4\u0ba9\u0bbf\u0baf\u0bc1\u0bb0\u0bbf\u0bae\u0bc8 & \u0bae\u0bc7\u0bb2\u0bc1\u0bae\u0bcd',hi:'\u0936\u0930\u094d\u0924\u0947\u0902, \u0917\u094b\u092a\u0928\u0940\u092f\u0924\u093e \u0928\u0940\u0924\u093f \u090f\u0935\u0902 \u0905\u0927\u093f\u0915',ml:'\u0d28\u0d3f\u0d2c\u0d28\u0d4d\u0d27\u0d28\u0d15\u0d7e, \u0d38\u0d4d\u0d35\u0d15\u0d3e\u0d30\u0d4d\u0d2f\u0d24 & \u0d15\u0d42\u0d1f\u0d41\u0d24\u0d7d'},termsConditionsTitle:{en:'Terms & Conditions',te:'\u0c28\u0c3f\u0c2c\u0c02\u0c27\u0c28\u0c32\u0c41 & \u0c37\u0c30\u0c24\u0c41\u0c32\u0c41',kn:'\u0ca8\u0cbf\u0caf\u0cae\u0c97\u0cb3\u0cc1 & \u0cb7\u0cb0\u0ca4\u0ccd\u0ca4\u0cc1\u0c97\u0cb3\u0cc1',ta:'\u0bb5\u0bbf\u0ba4\u0bbf\u0bae\u0bc1\u0bb1\u0bc8\u0b95\u0bb3\u0bcd & \u0ba8\u0bbf\u0baa\u0ba8\u0bcd\u0ba4\u0ba9\u0bc8\u0b95\u0bb3\u0bcd',hi:'\u0928\u093f\u092f\u092e \u090f\u0935\u0902 \u0936\u0930\u094d\u0924\u0947\u0902',ml:'\u0d28\u0d3f\u0d2c\u0d28\u0d4d\u0d27\u0d28\u0d15\u0d33\u0d41\u0d02 \u0d35\u0d4d\u0d2f\u0d35\u0d38\u0d4d\u0d25\u0d15\u0d33\u0d41\u0d02'},termsConditionsSubtitle:{en:'Read the terms of sacred devotional service',te:'\u0c2a\u0c35\u0c3f\u0c24\u0c4d\u0c30 \u0c38\u0c47\u0c35\u0c3e \u0c35\u0c3f\u0c28\u0c3f\u0c2f\u0c4b\u0c17 \u0c28\u0c3f\u0c2c\u0c02\u0c27\u0c28\u0c32\u0c28\u0c41 \u0c1a\u0c26\u0c35\u0c02\u0c21\u0c3f',kn:'\u0c2a\u0c35\u0c3f\u0c24\u0c4d\u0c30 \u0c38\u0c47\u0c35\u0c3e \u0cac\u0cb3\u0c95\u0cc6\u0caf \u0ca8\u0cbf\u0caf\u0cae\u0c97\u0cb3\u0ca8\u0ccd\u0ca8\u0cc1 \u0c93\u0ca6\u0cbf',ta:'\u0baa\u0bc1\u0ba9\u0bbf\u0ba4 \u0baa\u0b95\u0bcd\u0ba4\u0bbf \u0b9a\u0bc7\u0bb5\u0bc8\u0baf\u0bbf\u0ba9\u0bcd \u0bb5\u0bbf\u0ba4\u0bbf\u0bae\u0bc1\u0bb1\u0bc8\u0b95\u0bb3\u0bc8\u0baa\u0bcd \u0baa\u0b9f\u0bbf\u0b95\u0bcd\u0b95\u0bb5\u0bc1\u0bae\u0bcd',hi:'\u092a\u0935\u093f\u0924\u094d\u0930 \u092d\u0915\u094d\u0924\u093f \u0938\u0947\u0935\u093e \u0915\u0940 \u0936\u0930\u094d\u0924\u0947\u0902 \u092a\u0922\u093c\u0947\u0902',ml:'\u0d35\u0d3f\u0d36\u0d41\u0d26\u0d4d\u0d27 \u0d2d\u0d15\u0d4d\u0d24\u0d3f \u0d38\u0d47\u0d35\u0d28 \u0d35\u0d4d\u0d2f\u0d35\u0d38\u0d4d\u0d25\u0d15\u0d7e \u0d35\u0d3e\u0d2f\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d15'},privacyPolicyTitle:{en:'Privacy Policy',te:'\u0c17\u0c4b\u0c2a\u0c4d\u0c2f\u0c24\u0c3e \u0c35\u0c3f\u0c27\u0c3e\u0c28\u0c02',kn:'\u0c97\u0ccc\u0caa\u0ccd\u0caf\u0ca4\u0cbe \u0ca8\u0cc0\u0ca4\u0cbf',ta:'\u0ba4\u0ba9\u0bbf\u0baf\u0bc1\u0bb0\u0bbf\u0bae\u0bc8\u0b95\u0bcd \u0b95\u0bca\u0bb3\u0bcd\u0b95\u0bc8',hi:'\u0917\u094b\u092a\u0928\u0940\u092f\u0924\u093e \u0928\u0940\u0924\u093f',ml:'\u0d38\u0d4d\u0d35\u0d15\u0d3e\u0d30\u0d4d\u0d2f\u0d24\u0d3e \u0d28\u0d2f\u0d02'},privacyPolicySubtitle:{en:'How devotee information and privacy are protected',te:'\u0c2d\u0c15\u0c4d\u0c24\u0c41\u0c32 \u0c38\u0c2e\u0c3e\u0c1a\u0c3e\u0c30\u0c02 \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c17\u0c4b\u0c2a\u0c4d\u0c2f\u0c24 \u0c0e\u0c32\u0c3e \u0c30\u0c15\u0c4d\u0c37\u0c3f\u0c02\u0c1a\u0c2c\u0c21\u0c41\u0c24\u0c41\u0c02\u0c26\u0c4b \u0c24\u0c46\u0c32\u0c41\u0c38\u0c41\u0c15\u0c4b\u0c02\u0c21\u0c3f',kn:'\u0cad\u0c95\u0ccd\u0ca4\u0cb0 \u0cae\u0cbe\u0cb9\u0cbf\u0ca4\u0cbf \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0c97\u0ccc\u0caa\u0ccd\u0caf\u0ca4\u0cc6 \u0cb9\u0cc7\u0c97\u0cc6 \u0cb0\u0c95\u0ccd\u0cb7\u0cbf\u0cb8\u0cb2\u0ccd\u0caa\u0ca1\u0cc1\u0ca4\u0ccd\u0ca4\u0ca6\u0cc6',ta:'\u0baa\u0b95\u0bcd\u0ba4\u0bb0\u0bcd \u0ba4\u0b95\u0bb5\u0bb2\u0bcd \u0bae\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd \u0ba4\u0ba9\u0bbf\u0baf\u0bc1\u0bb0\u0bbf\u0bae\u0bc8 \u0b8e\u0bb5\u0bcd\u0bb5\u0bbe\u0bb1\u0bc1 \u0baa\u0bbe\u0ba4\u0bc1\u0b95\u0bbe\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bc1\u0b95\u0bbf\u0bb1\u0ba4\u0bc1',hi:'\u092d\u0915\u094d\u0924\u094b\u0902 \u0915\u0940 \u091c\u093e\u0928\u0915\u093e\u0930\u0940 \u0914\u0930 \u0917\u094b\u092a\u0928\u0940\u092f\u0924\u093e \u0915\u0948\u0938\u0947 \u0938\u0941\u0930\u0915\u094d\u0937\u093f\u0924 \u0930\u0916\u0940 \u091c\u093e\u0924\u0940 \u0939\u0948',ml:'\u0d2d\u0d15\u0d4d\u0d24\u0d30\u0d41\u0d1f\u0d46 \u0d35\u0d3f\u0d35\u0d30\u0d19\u0d4d\u0d19\u0d33\u0d41\u0d02 \u0d38\u0d4d\u0d35\u0d15\u0d3e\u0d30\u0d4d\u0d2f\u0d24\u0d2f\u0d41\u0d02 \u0d0e\u0d19\u0d4d\u0d19\u0d28\u0d46 \u0d38\u0d02\u0d30\u0d15\u0d4d\u0d37\u0d3f\u0d15\u0d4d\u0d15\u0d2a\u0d4d\u0d2a\u0d46\u0d1f\u0d41\u0d28\u0d4d\u0d28\u0d41'},refundPolicyTitle:{en:'Refund & Cancellation Policy',te:'\u0c30\u0c40\u0c2b\u0c02\u0c21\u0c4d & \u0c30\u0c26\u0c4d\u0c26\u0c41 \u0c35\u0c3f\u0c27\u0c3e\u0c28\u0c02',kn:'\u0cae\u0cb0\u0cc1\u0caa\u0cbe\u0cb5\u0ca4\u0cbf & \u0cb0\u0ca6\u0ccd\u0ca6\u0ca4\u0cbf \u0ca8\u0cc0\u0ca4\u0cbf',ta:'\u0bb0\u0bc0\u0b83\u0baa\u0ba3\u0bcd\u0b9f\u0bcd & \u0bb0\u0ba4\u0bcd\u0ba4\u0bc1 \u0b95\u0bca\u0bb3\u0bcd\u0b95\u0bc8',hi:'\u0935\u093e\u092a\u0938\u0940 \u090f\u0935\u0902 \u0930\u0926\u094d\u0926\u0940\u0915\u0930\u0923 \u0928\u0940\u0924\u093f',ml:'\u0d31\u0d40\u0d2b\u0d23\u0d4d\u0d1f\u0d4d & \u0d31\u0d26\u0d4d\u0d26\u0