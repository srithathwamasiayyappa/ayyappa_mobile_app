u0c2a\u0c4d\u0c30\u0c26\u0c4b\u0c37 \u0c35\u0c4d\u0c30\u0c24\u0c02 \u2014 \u0c2a\u0c30\u0c2e\u0c36\u0c3f\u0c35\u0c41\u0c28\u0c3f \u0c05\u0c2d\u0c3f\u0c37\u0c47\u0c15\u0c2e\u0c41\u0c28\u0c15\u0c41, \u0c2c\u0c3f\u0c32\u0c4d\u0c35\u0c3e\u0c30\u0c4d\u0c1a\u0c28\u0c15\u0c41 \u0c36\u0c4d\u0c30\u0c47\u0c37\u0c4d\u0c20\u0c02':'Pradosham \u2014 Auspicious for Shiva Pooja & Bilva Archana':3===c.tithiIndex||18===c.tithiIndex?'te'===S?'\u0c38\u0c02\u0c15\u0c37\u0c4d\u0c1f\u0c39\u0c30 \u0c1a\u0c35\u0c3f\u0c24\u0c3f \u2014 \u0c36\u0c4d\u0c30\u0c40 \u0c17\u0c23\u0c2a\u0c24\u0c3f \u0c06\u0c30\u0c3e\u0c27\u0c28\u0c15\u0c41 \u0c2a\u0c30\u0c2e \u0c2a\u0c35\u0c3f\u0c24\u0c4d\u0c30\u0c02':'Sankashti Chaturthi \u2014 Auspicious for Lord Ganesha Pooja':'te'===S?'\u0c2a\u0c42\u0c1c\u0c32\u0c41, \u0c26\u0c3e\u0c28\u0c27\u0c30\u0c4d\u0c2e\u0c3e\u0c32\u0c41 \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c28\u0c42\u0c24\u0c28 \u0c2a\u0c4d\u0c30\u0c3e\u0c30\u0c02\u0c2d\u0c3e\u0c32\u0c15\u0c41 \u0c36\u0c41\u0c2d\u0c2a\u0c4d\u0c30\u0c26\u0c02':'kn'===S?'\u0caa\u0cc2\u0c9c\u0cc6, \u0ca6\u0cbe\u0ca8 \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0cb9\u0cca\u0cb8 \u0caa\u0ccd\u0cb0\u0cbe\u0cb0\u0c82\u0cad\u0c97\u0cb3\u0cbf\u0c97\u0cc6 \u0cb6\u0cc1\u0cad\u0ca6\u0cbe\u0caf\u0c95':'ta'===S?'\u0baa\u0bc2\u0b9c\u0bc8, \u0ba4\u0bbe\u0ba9\u0bae\u0bcd \u0bae\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd \u0baa\u0bc1\u0ba4\u0bbf\u0baf \u0ba4\u0bca\u0b9f\u0b95\u0bcd\u0b95\u0b99\u0bcd\u0b95\u0bb3\u0bc1\u0b95\u0bcd\u0b95\u0bc1 \u0b89\u0b95\u0ba8\u0bcd\u0ba4 \u0ba8\u0bbe\u0bb3\u0bcd':'hi'===S?'\u092a\u0942\u091c\u093e, \u0926\u093e\u0928 \u090f\u0935\u0902 \u0928\u090f \u0915\u093e\u0930\u094d\u092f\u094b\u0902 \u0915\u0947 \u0936\u0941\u092d\u093e\u0930\u0902\u092d \u0939\u0947\u0924\u0941 \u0936\u0941\u092d':'Auspicious for Pooja, Donations & New Beginnings':'te'===S?'\u0c2e\u0c15\u0c30 \u0c38\u0c02\u0c15\u0c4d\u0c30\u0c3e\u0c02\u0c24\u0c3f / \u0c2a\u0c4a\u0c02\u0c17\u0c32\u0c4d \u0c2a\u0c30\u0c4d\u0c35\u0c26\u0c3f\u0c28\u0c02 \u2014 \u0c05\u0c24\u0c4d\u0c2f\u0c02\u0c24 \u0c36\u0c41\u0c2d\u0c2a\u0c4d\u0c30\u0c26\u0c2e\u0c48\u0c28 \u0c26\u0c3f\u0c28\u0c02':'kn'===S?'\u0cae\u0c95\u0cb0 \u0cb8\u0c82\u0c95\u0ccd\u0cb0\u0cbe\u0c82\u0ca4\u0cbf \u0cb9\u0cac\u0ccd\u0cac \u2014 \u0c85\u0ca4\u0ccd\u0caf\u0c82\u0ca4 \u0cae\u0c82\u0c97\u0cb3\u0c95\u0cb0 \u0ca6\u0cbf\u0ca8':'ta'===S?'\u0bae\u0b95\u0bb0 \u0b9a\u0b99\u0bcd\u0b95\u0bb0\u0bbe\u0ba8\u0bcd\u0ba4\u0bbf / \u0ba4\u0bc8 \u0baa\u0bca\u0b99\u0bcd\u0b95\u0bb2\u0bcd \u2014 \u0baa\u0bc1\u0ba9\u0bbf\u0ba4\u0bae\u0bbe\u0ba9 \u0ba4\u0bbf\u0bb0\u0bc1\u0ba8\u0bbe\u0bb3\u0bcd':'hi'===S?'\u092e\u0915\u0930 \u0938\u0902\u0915\u094d\u0930\u093e\u0902\u0924\u093f / \u092a\u094b\u0902\u0917\u0932 \u2014 \u0905\u0924\u094d\u092f\u0902\u0924 \u0936\u0941\u092d \u0935 \u092a\u0941\u0923\u094d\u092f\u0915\u093e\u0930\u0940 \u0926\u093f\u0935\u0938':'Makara Sankranti / Pongal \u2014 Highly Auspicious Festival';var ga={tithi:{te:'\u0c24\u0c3f\u0c25\u0c3f',kn:'\u0ca4\u0cbf\u0ca5\u0cbf',en:'Tithi',ta:'\u0ba4\u0bbf\u0ba4\u0bbf',hi:'\u0924\u093f\u0925\u093f'},star:{te:'\u0c28\u0c15\u0c4d\u0c37\u0c24\u0c4d\u0c30\u0c02',kn:'\u0ca8\u0c95\u0ccd\u0cb7\u0ca4\u0ccd\u0cb0',en:'Star',ta:'\u0ba8\u0b9f\u0bcd\u0b9a\u0ba4\u0bcd\u0ba4\u0bbf\u0bb0\u0bae\u0bcd',hi:'\u0928\u0915\u094d\u0937\u0924\u094d\u0930'},yoga:{te:'\u0c2f\u0c4b\u0c17\u0c02',kn:'\u0caf\u0ccb\u0c97',en:'Yoga',ta:'\u0baf\u0bcb\u0b95\u0bae\u0bcd',hi:'\u092f\u094b\u0917'},karana:{te:'\u0c15\u0c30\u0c23\u0c02',kn:'\u0c95\u0cb0\u0ca3',en:'Karana',ta:'\u0b95\u0bb0\u0ba3\u0bae\u0bcd',hi:'\u0915\u0930\u0923'},auspicious:{te:'\u0c36\u0c41\u0c2d \u0c18\u0c21\u0c3f\u0c2f\u0c32\u0c41',kn:'\u0cb6\u0cc1\u0cad \u0c98\u0cb3\u0cbf\u0c97\u0cc6\u0c97\u0cb3\u0cc1',en:'Auspicious Time',ta:'\u0b9a\u0bc1\u0baa \u0ba8\u0bc7\u0bb0\u0bae\u0bcd',hi:'\u0936\u0941\u092d \u092e\u0941\u0939\u0942\u0930\u094d\u0924'},inauspicious:{te:'\u0c05\u0c36\u0c41\u0c2d \u0c18\u0c21\u0c3f\u0c2f\u0c32\u0c41',kn:'\u0c85\u0cb6\u0cc1\u0cad \u0c98\u0cb3\u0cbf\u0c97\u0cc6\u0c97\u0cb3