__d(function(g,r,i,a,m,e,d){Object.defineProperty(e,"__esModule",{value:!0}),e.MASTER_DONATION_CATEGORIES=e.MASTER_ANNADANAM_LOCATIONS=e.MASTER_ANNADANAM_CAMPAIGNS=void 0;e.MASTER_ANNADANAM_LOCATIONS=[{id:'sabarimala-annadanam',name:'Sabarimala Annadanam',localNames:{te:'\u0c36\u0c2c\u0c30\u0c3f\u0c2e\u0c32 \u0c05\u0c28\u0c4d\u0c28\u0c26\u0c3e\u0c28\u0c02',kn:'\u0cb6\u0cac\u0cb0\u0cbf\u0cae\u0cb2\u0cc6 \u0c85\u0ca8\u0ccd\u0ca8\u0ca6\u0cbe\u0ca8',ta:'\u0b9a\u0baa\u0bb0\u0bbf\u0bae\u0bb2\u0bc8 \u0b85\u0ba9\u0bcd\u0ba9\u0ba4\u0bbe\u0ba9\u0bae\u0bcd',hi:'\u0938\u092c\u0930\u0940\u092e\u093e\u0932\u093e \u0905\u0928\u094d\u0928\u0926\u093e\u0928',ml:'\u0d36\u0d2c\u0d30\u0d3f\u0d2e\u0d32 \u0d05\u0d28\u0d4d\u0d28\u0d26\u0d3e\u0d28\u0d02',en:'Sabarimala Annadanam'},templeName:'Sabarimala Sree Dharma Sastha Temple',city:'Sannidhanam',state:'Kerala',locationLabel:'Sannidhanam, Kerala',servingTime:'11:00 AM \u2013 09:00 PM',status:'open',statusLabel:'Open',address:'Sannidhanam Annadana Mandapam, Near Malikappuram Temple, Sabarimala, Pathanamthitta District, Kerala - 689662',latitude:9.4398,longitude:77.0805,organizer:'Travancore Devaswom Board (TDB)',contactPhone:'+91 4735 202048',notes:'Free sacred hot meals served continuously to thousands of Ayyappa devotees during pilgrimage seasons.'},{id:'tirumala-annadanam',name:'Tirumala Annadanam',localNames:{te:'\u0c24\u0c3f\u0c30\u0c41\u0c2e\u0c32 \u0c05\u0c28\u0c4d\u0c28\u0c26\u0c3e\u0c28\u0c02',kn:'\u0ca4\u0cbf\u0cb0\u0cc1\u0cae\u0cb2 \u0c85\u0ca8\u0ccd\u0ca8\u0ca6\u0cbe\u0ca8',ta:'\u0ba4\u0bbf\u0bb0\u0bc1\u0bae\u0bb2\u0bc8 \u0b85\u0ba9\u0bcd\u0ba9\u0ba4\u0bbe\u0ba9\u0bae\u0bcd',hi:'\u0924\u093f\u0930\u0941\u092a\u0924\u093f \u0905\u0928\u094d\u0928\u0926\u093e\u0928',ml:'\u0d24\u0d3f\u0d30\u0d41\u0d2e\u0d32 \u0d05\u0d28\u0d4d\u0d28\u0d26\u0d3e\u0d28\u0d02',en:'Tirumala Annadanam'},templeName:'Tirumala Sri Venkateswara Temple',city:'Tirupati',state:'AP',locationLabel:'Tirupati, AP',servingTime:'10:30 AM \u2013 08:30 PM',status:'open',statusLabel:'Open',address:'Matrusri Tarigonda Vengamamba Nitya Annaprasada Complex, West Mada Street, Tirumala Hills, Tirupati, Andhra Pradesh - 517504',latitude:13.6833,longitude:79.3472,organizer:'Sri Venkateswara Nitya Annadanam Trust (TTD)',contactPhone:'+91 877 2277777',notes:'Serves hygienic, divine Srivari prasadam meals to over 100,000 pilgrims every single day without any distinction.'},{id:'srisailam-annadanam',name:'Srisailam Annadanam',localNames:{te:'\u0c36\u0c4d\u0c30\u0c40\u0c36\u0c48\u0c32\u0c02 \u0c05\u0c28\u0c4d\u0c28\u0c26\u0c3e\u0c28\u0c02',kn:'\u0cb6\u0ccd\u0cb0\u0cc0\u0cb6\u0cc8\u0cb2 \u0c85\u0ca8\u0ccd\u0ca8\u0ca6\u0cbe\u0ca8',ta:'\u0bb8\u0bcd\u0bb0\u0bc0\u0b9a\u0bc8\u0bb2\u0bae\u0bcd \u0b85\u0ba9\u0bcd\u0ba9\u0ba4\u0bbe\u0ba9\u0bae\u0bcd',hi:'\u0936\u094d\u0930\u0940\u0936\u0948\u0932\u092e \u0905\u0928\u094d\u0928\u0926\u093e\u0928',ml:'\u0d36\u0d4d\u0d30\u0d40\u0d36\u0d48\u0d32\u0d02 \u0d05\u0d28\u0d4d\u0d28\u0d26\u0d3e\u0d28\u0d02',en:'Srisailam Annadanam'},templeName:'Srisailam Sri Mallikarjuna Swamy Temple',city:'Srisailam',state:'AP',locationLabel:'Srisailam, AP',servingTime:'11:00 AM \u2013 08:00 PM',status:'open',statusLabel:'Open',address:'Sri Bhramaramba Mallikarjuna Nitya Annadana Bhavanam, Near Temple Main Entrance, Srisailam, Nandyal District, Andhra Pradesh - 518101',latitude:16.0741,longitude:78.8687,organizer:'Srisaila Devasthanam Nitya Annadana Trust',contactPhone:'+91 8524 288888',notes:'Provides sanctified satvik meals to visiting pilgrims and Shiva devotees daily with reverence.'},{id:'kashi-annadanam',name:'Kashi Annapurna Annadanam',localNames:{te:'\u0c15\u0c3e\u0c36\u0c40 \u0c05\u0c28\u0c4d\u0c28\u0c2a\u0c42\u0c30\u0c4d\u0c23 \u0c05\u0c28\u0c4d\u0c28\u0c26\u0c3e\u0c28\u0c02',kn:'\u0c95\u0cbe\u0cb6\u0cbf \u0c85\u0ca8\u0ccd\u0ca8\u0caa\u0cc2\u0cb0\u0ccd\u0ca3\u0cbe \u0c85\u0ca8\u0ccd\u0ca8\u0ca6\u0cbe\u0ca8',ta:'\u0b95\u0bbe\u0b9a\u0bbf \u0b85\u0ba9\u0bcd\u0ba9\u0baa\u0bc2\u0bb0\u0ba3\u0bbf \u0b85\u0ba9\u0bcd\u0ba9\u0ba4\u0bbe\u0ba9\u0bae\u0bcd',hi:'\u0915\u093e\u0936\u0940 \u0905\u0928\u094d\u0928\u092a\u0942\u0930\u094d\u0923\u093e \u0905\u0928\u094d\u0928\u0915\u094d\u0937\u0947\u0924\u094d\u0930',ml:'\u0d15\u0d3e\u0d36\u0d3f \u0d05\u0d28\u0d4d\u0d28\u0d2a\u0d42\u0d7c\u0d23\u0d4d\u0d23 \u0d05\u0d28\u0d4d\u0d28\u0d26\u0d3e\u0d28\u0d02',en:'Kashi Annapurna Annadanam'},templeName:'Maa Annapurna Mandir, Kashi',city:'Varanasi',state:'UP',locationLabel:'Varanasi, UP',servingTime:'10:30 AM \u2013 09:30 PM',status:'open',statusLabel:'Open',address:'Maa Annapurna Annakshetra Bhavan, Vishwanath Gali, Lahori Tola, Varanasi, Uttar Pradesh - 221001',latitude:25.3109,longitude:83.0107,organizer:'Maa Annapurna Mandir Trust',contactPhone:'+91 542 2392629',notes:'Perpetual free kitchen of Goddess Annapurna distributing blessed meals to all sadhus and pilgrims visiting Kashi.'},{id:'palani-annadanam',name:'Palani Murugan Annadanam',localNames:{te:'\u0c2a\u0c33\u0c28\u0c3f \u0c2e\u0c41\u0c30\u0c41\u0c17\u0c28\u0c4d \u0c05\u0c28\u0c4d\u0c28\u0c26\u0c3e\u0c28\u0c02',kn:'\u0caa\u0cb3\u0ca8\u0cbf \u0cae\u0cc1\u0cb0\u0cc1\u0c97\u0ca8\u0ccd \u0c85\u0ca8\u0ccd\u0ca8\u0ca6\u0cbe\u0ca8',ta:'\u0baa\u0bb4\u0ba9\u0bbf \u0bae\u0bc1\u0bb0\u0bc1\u0b95\u0ba9 \u0b85\u0ba9\u0bcd\u0ba9\u0ba4\u0bbe\u0ba9\u0bae\u0bcd',hi:'\u092a\u0932\u093e\u0928\u0940 \u092e\u0941\u0930\u0941\u0917\u0928 \u0905\u0928\u094d\u0928\u0926\u093e\u0928',ml:'\u0d2a\u0d34\u0d28\u0d3f \u0d2e\u0d41\u0d30\u0d41\u0d15\u0d7b \u0d05\u0d28\u0d4d\u0d28\u0d26\u0d3e\u0d28\u0d02',en:'Palani Murugan Annadanam'},templeName:'Arulmigu Dhandayuthapani Swamy Temple',city:'Palani',state:'Tamil Nadu',locationLabel:'Palani, Tamil Nadu',servingTime:'11:00 AM \u2013 08:30 PM',status:'open',statusLabel:'Open',address:'Arulmigu Dhandayuthapani Swamy Annadana Koodam, Adivaram, Palani, Dindigul District, Tamil Nadu - 624601',latitude:10.4468,longitude:77.5165,organizer:'HR&CE Department, Tamil Nadu Government',contactPhone:'+91 4545 242236',notes:'Continuous free meal scheme feeding Murugan devotees and padayatra pilgrims with South Indian traditional meals.'}],e.MASTER_ANNADANAM_CAMPAIGNS=[{id:'campaign-sabarimala',title:'Sabarimala Mandala Season Annadanam',subtitle:'Feed Ayyappa devotees on their sacred pilgrimage to Sannidhanam',organizer:'Travancore Devaswom Board (TDB)',templeName:'Sabarimala Sree Dharma Sastha Temple',description:'Support the massive free meal distribution at Sabarimala Sannidhanam and Pamba during the sacred 41-day Mandala-Makaravilakku pilgrimage. Every grain offered with devotion nourishes a walking Swami.',recommendedAmounts:[501,1001,2501,5001],officialAccountInfo:'Official Trust: Travancore Devaswom Board Sabarimala Annadanam Fund. Account details and official e-receipt provided directly through TDB.'},{id:'campaign-tirumala',title:'Sri Venkateswara Nitya Annaprasadam',subtitle:'Sponsor one session or contribute to TTD perpetual endowment',organizer:'Tirumala Tirupati Devasthanams (TTD)',templeName:'Tirumala Sri Venkateswara Temple',description:'Sri Venkateswara Nitya Annadanam Trust serves pure satvik food to over one lakh devotees every day. Contributions are accepted into the official trust fund managed by TTD.',recommendedAmounts:[1e3,2500,5e3,1e4],officialAccountInfo:'Official Trust: Sri Venkateswara Nitya Annadanam Trust, Tirupati. Formal contribution vouchers available through TTD official portal.'},{id:'campaign-srisailam',title:'Srisailam Nitya Annadana Seva',subtitle:'Support daily meals for pilgrims visiting Mallikarjuna Jyotirlinga',organizer:'Srisaila Devasthanam Nitya Annadana Trust',templeName:'Srisailam Temple',description:'Participate in the continuous feeding seva in Srisailam forest shrine honoring Lord Mallikarjuna Swamy and Goddess Bhramaramba Devi.',recommendedAmounts:[500,1116,2500,5e3],officialAccountInfo:'Official Trust: Srisaila Devasthanam Nitya Annadana Pathakam. Contributions acknowledged directly by Devasthanam treasury.'}],e.MASTER_DONATION_CATEGORIES=[{id:'general-donation',title:'General Donation',subtitle:'Support temple and daily services',iconType:'general'},{id:'temple-seva',title:'Temple Seva Booking',subtitle:'Abhishekam, Archana, Other Sevas',iconType:'seva'},{id:'annadanam',title:'Annadanam (Food Donation)',subtitle:'Sponsor food for devotees',iconType:'annadanam',screenRoute:'food_donation'},{id:'festival-donation',title:'Festival Donation',subtitle:'Contribute for special festivals',iconType:'festival'},{id:'nitya-pooja',title:'Nitya Pooja Sponsorship',subtitle:'Support regular poojas',iconType:'pooja'},{id:'my-donations',title:'My Donations',subtitle:'View your donation history',iconType:'history'}]},674,[]);
__d(function(g,r,i,a,m,e,d){Object.defineProperty(e,"__esModule",{value:!0}),e.MASTER_TEMPLES=void 0;e.MASTER_TEMPLES=[{id:'sabarimala',name:'Sabarimala Temple',localNames:{te:'\u0c36\u0c2c\u0c30\u0c3f\u0c2e\u0c32 \u0c36\u0c4d\u0c30\u0c40 \u0c27\u0c30\u0c4d\u0c2e\u0c36\u0c3e\u0c38\u0c4d\u0c24 \u0c26\u0c47\u0c35\u0c3e\u0c32\u0c2f\u0c02',kn:'\u0cb6\u0cac\u0cb0\u0cbf\u0cae\u0cb2\u0cc6 \u0cb6\u0ccd\u0cb0\u0cc0 \u0ca7\u0cb0\u0ccd\u0cae\u0cb6\u0cbe\u0cb8\u0ccd\u0ca4\u0cbe \u0ca6\u0cc7\u0cb5\u0cbe\u0cb2\u0caf',ta:'\u0b9a\u0baa\u0bb0\u0bbf\u0bae\u0bb2\u0bc8 \u0bb8\u0bcd\u0bb0\u0bc0 \u0ba4\u0bb0\u0bcd\u0bae\u0b9a\u0bbe\u0bb8\u0bcd\u0ba4\u0bbe \u0ba4\u0bbf\u0bb0\u0bc1\u0b95\u0bcd\u0b95\u0bcb\u0baf\u0bbf\u0bb2\u0bcd',hi:'\u0938\u092c\u0930\u0940\u092e\u093e\u0932\u093e \u0936\u094d\u0930\u0940 \u0927\u0930\u094d\u092e\u0936\u093e\u0938\u094d\u0924\u093e \u092e\u0902\u0926\u093f\u0930',ml:'\u0d36\u0d2c\u0d30\u0d3f\u0d2e\u0d32 \u0d36\u0d4d\u0d30\u0d40 \u0d27\u0d7c\u0d2e\u0d4d\u0d2e\u0d36\u0d3e\u0d38\u0d4d\u0d24\u0d3e \u0d15\u0d4d\u0d37\u0d47\u0d24\u0d4d\u0d30\u0d02',en:'Sabarimala Temple'},deityId:'ayyappa',deityName:'Lord Ayyappa',city:'Pathanamthitta',district:'Pathanamthitta',state:'Kerala',country:'India',address:'Sannidhanam, Sabarimala, Periyar Tiger Reserve, Pathanamthitta District, Kerala',pincode:'689662',latitude:9.4398,longitude:77.0805,cropIndex:0,about:'One of the most revered and ancient hill shrines in India dedicated to Lord Ayyappa, located atop 18 sacred hills amidst the lush forests of the Western Ghats in Kerala. Attracting tens of millions of pilgrims annually, Sabarimala is an epitome of secular unity, devotion and spiritual equality where all devotees are addressed as "Swamimargal".',history:'According to temple tradition, Lord Ayyappa, the divine child of Shiva and Mohini (Vishnu), vanquished the demoness Mahishi and entered perpetual meditative penance (samadhi) at Sabarimala. The temple deity was traditionally consecrated by sage Lord Parashurama, and revived by the King of Pandalam.',speciality:['Mandala - Makaravilakku season pilgrimage of 41 days of austerities (Vratam)','Pathinettampadi \u2014 The 18 sacred gold-plated steps climbed only with Irumudi Kettu','Neyyabhishekam \u2014 Sacred ghee abhishekam offered directly to Lord Ayyappa','Darshan of the divine Makara Jyothi on Pongal / Sankranti evening','Harivarasanam lullaby recited every night before closing the temple doors'],timings:{morning:'03:00 AM \u2013 01:00 PM',evening:'03:00 PM \u2013 11:00 PM',special:'Neyyabhishekam: 03:15 AM \u2013 11:30 AM | Harivarasanam: 10:50 PM',notes:'Temple opens during Mandala-Makaravilakku festival and first 5 days of every Malayalam month. Please confirm official dates before planning travel.'},contact:{phone:'+91 4735 202048',email:'sabarimalatdb@gmail.com',website:'https://sabarimala.kerala.gov.in'},liveStreamId:'sabarimala-live',hasLiveDarshan:!0},{id:'tirumala',name:'Tirumala Tirupati',localNames:{te:'\u0c24\u0c3f\u0c30\u0c41\u0c2e\u0c32 \u0c36\u0c4d\u0c30\u0c40 \u0c35\u0c47\u0c02\u0c15\u0c1f\u0c47\u0c36\u0c4d\u0c35\u0c30 \u0c38\u0c4d\u0c35\u0c3e\u0c2e\u0c3f \u0c26\u0c47\u0c35\u0c3e\u0c32\u0c2f\u0c02',kn:'\u0ca4\u0cbf\u0cb0\u0cc1\u0cae\u0cb2 \u0cb6\u0ccd\u0cb0\u0cc0 \u0cb5\u0cc6\u0c82\u0c95\u0c9f\u0cc7\u0cb6\u0ccd\u0cb5\u0cb0 \u0cb8\u0ccd\u0cb5\u0cbe\u0cae\u0cbf \u0ca6\u0cc7\u0cb5\u0cbe\u0cb2\u0caf',ta:'\u0ba4\u0bbf\u0bb0\u0bc1\u0bae\u0bb2\u0bc8 \u0ba4\u0bbf\u0bb0\u0bc1\u0baa\u0bcd\u0baa\u0ba4\u0bbf \u0bb8\u0bcd\u0bb0\u0bc0 \u0bb5\u0bc6\u0b99\u0bcd\u0b95\u0b9f\u0bc7\u0bb8\u0bcd\u0bb5\u0bb0\u0bbe \u0ba4\u0bbf\u0bb0\u0bc1\u0b95\u0bcd\u0b95\u0bcb\u0baf\u0bbf\u0bb2\u0bcd',hi:'\u0924\u093f\u0930\u0941\u092a\u0924\u093f \u092c\u093e\u0932\u093e\u091c\u0940 \u0936\u094d\u0930\u0940 \u0935\u0947\u0902\u0915\u091f\u0947\u0936\u094d\u0935\u0930 \u092e\u0902\u0926\u093f\u0930',ml:'\u0d24\u0d3f\u0d30\u0d41\u0d2e\u0d32 \u0d36\u0d4d\u0d30\u0d40 \u0d35\u0d46\u0d19\u0d4d\u0d15\u0d3f\u0d1f\u0d47\u0d36\u0d4d\u0d35\u0d30 \u0d38\u0d4d\u0d35\u0d3e\u0d2e\u0d3f \u0d15\u0d4d\u0d37\u0d47\u0d24\u0d4d\u0d30\u0d02',en:'Tirumala Tirupati'},deityId:'venkateswara',deityName:'Lord Venkateswara',city:'Tirupati',district:'Tirupati',state:'Andhra Pradesh',country:'India',address:'Srivari Sannidhi, Tirumala Hills, Tirupati, Andhra Pradesh',pincode:'517504',latitude:13.6833,longitude:79.3472,cropIndex:1,about:'The sacred abode of Kaliyuga Prathyaksha Daivam, Lord Sri Venkateswara (Balaji). Situated on the picturesque Venkatadri, the seventh peak of the sacred Seshachalam hills in Tirumala, it is the most visited religious center in the world known for divine grace and ceaseless spiritual energy.',history:'According to temple lore and inscriptions, the temple has ancient origins dating back to the Sangam period, with extensive patronization by Pallava, Chola, Pandya, and Vijayanagara emperors like Sri Krishna Deva Raya, who gilded the sacred Ananda Nilayam vimana in pure gold.',speciality:['Ananda Nilayam \u2014 Golden gopuram sanctifying the presiding deity','World-famous Tirupati Laddu GI-tagged prasadam blessed with divine aroma','Daily Srivari Kalyanotsavam and Sahasra Deepalankarana Seva','Head tonsuring (Kalyanakatta) as an offering of devotion and humility','Annual Brahmotsavam drawing millions of devotees worldwide'],timings:{morning:'03:00 AM \u2013 11:30 PM (Continuous Sarva Darshanam)',evening:'Subject to daily sevas and VIP break intervals',special:'Suprabhata Seva: 03:00 AM | Tomala Seva: 03:30 AM | Ekantha Seva: 01:30 AM',notes:'Darshan timings vary on Brahmotsavam and festive holidays. Advance online quota booking via TTD official portal is recommended.'},contact:{phone:'+91 877 2277777',email:'helpdesk@tirumala.org',website:'https://www.tirumala.org'},liveStreamId:'tirumala-live',hasLiveDarshan:!0},{id:'srisailam',name:'Srisailam Temple',localNames:{te:'\u0c36\u0c4d\u0c30\u0c40\u0c36\u0c48\u0c32\u0c02 \u0c2e\u0c32\u0c4d\u0c32\u0c3f\u0c15\u0c3e\u0c30\u0c4d\u0c1c\u0c41\u0c28 \u0c38\u0c4d\u0c35\u0c3e\u0c2e\u0c3f \u0c26\u0c47\u0c35\u0c3e\u0c32\u0c2f\u0c02',kn:'\u0cb6\u0ccd\u0cb0\u0cc0\u0cb6\u0cc8\u0cb2 \u0cae\u0cb2\u0ccd\u0cb2\u0cbf\u0c95\u0cbe\u0cb0\u0ccd\u0c9c\u0cc1\u0ca8 \u0cb8\u0ccd\u0cb5\u0cbe\u0cae\u0cbf \u0ca6\u0cc7\u0cb5\u0cbe\u0cb2\u0caf',ta:'\u0bb8\u0bcd\u0bb0\u0bc0\u0b9a\u0bc8\u0bb2\u0bae\u0bcd \u0bae\u0bb2\u0bcd\u0bb2\u0bbf\u0b95\u0bbe\u0bb0\u0bcd\u0b9c\u0bc1\u0ba9\u0bbe \u0ba4\u0bbf\u0bb0\u0bc1\u0b95\u0bcd\u0b95\u0bcb\u0baf\u0bbf\u0bb2\u0bcd',hi:'\u0936\u094d\u0930\u0940\u0936\u0948\u0932\u092e \u092e\u0932\u094d\u0932\u093f\u0915\u093e\u0930\u094d\u091c\u0941\u0928 \u091c\u094d\u092f\u094b\u0924\u093f\u0930\u094d\u0932\u093f\u0902\u0917 \u092e\u0902\u0926\u093f\u0930',ml:'\u0d36\u0d4d\u0d30\u0d40\u0d36\u0d48\u0d32\u0d02 \u0d2e\u0d32\u0d4d\u0d32\u0d3f\u0d15\u0d3e\u0d7c\u0d1c\u0d4d\u0d1c\u0d41\u0d28 \u0d38\u0d4d\u0d35\u0d3e\u0d2e\u0d3f \u0d15\u0d4d\u0d37\u0d47\u0d24\u0d4d\u0d30\u0d02',en:'Srisailam Temple'},deityId:'shiva',deityName:'Lord Shiva & Bhramaramba Devi',city:'Kurnool',district:'Nandyal',state:'Andhra Pradesh',country:'India',address:'Srisaila Devasthanam, Nallamala Forest, Kurnool/Nandyal District, Andhra Pradesh',pincode:'518101',latitude:16.0741,longitude:78.8687,cropIndex:2,about:'Situated on the majestic flat top of Nallamala hills along the south bank of Krishna River (Pathalaganga), Srisailam is uniquely sacred as both the 2nd Jyotirlinga of Lord Shiva (Mallikarjuna) and an Ashtadasa Maha Shakti Peetham of Goddess Bhramaramba.',history:'Celebrated since the Ikshvaku, Vishnukundina, and Kakatiya dynasties. Chhatrapati Shivaji Maharaj personally visited Srisailam and constructed the northern gopuram in 1677 CE. The stone carvings and fortress-like prakaaram represent sublime Vijayanagara architecture.',speciality:['Rare combined presence of Jyotirlinga and Shakti Peetham in one sanctified temple','Devotees are permitted to perform Sparsha Darshanam (touching the sacred Shiva Linga)','Holy dip at Pathalaganga with ropeway and boating access','Maha Shivaratri Brahmotsavam with divine Kalyanam of Mallikarjuna and Bhramaramba'],timings:{morning:'06:00 AM \u2013 02:00 PM',evening:'05:00 PM \u2013 10:00 PM',special:'Sparsha Darshanam: 06:00 AM \u2013 01:00 PM & 06:00 PM \u2013 09:00 PM',notes:'Morning Suprabhatam at 04:30 AM. Ekantha Seva at 09:30 PM.'},contact:{phone:'+91 8524 288888',email:'srisailadevasthanam@gmail.com',website:'https://www.srisailamonline.com'},liveStreamId:'srisailam-live',hasLiveDarshan:!0},{id:'kashi-vishwanath',name:'Kashi Vishwanath',localNames:{te:'\u0c15\u0c3e\u0c36\u0c40 \u0c35\u0c3f\u0c36\u0c4d\u0c35\u0c28\u0c3e\u0c25 \u0c2e\u0c02\u0c26\u0c3f\u0c30\u0c02',kn:'\u0c95\u0cbe\u0cb6\u0cbf \u0cb5\u0cbf\u0cb6\u0ccd\u0cb5\u0ca8\u0cbe\u0ca5 \u0cae\u0c82\u0ca6\u0cbf\u0cb0',ta:'\u0b95\u0bbe\u0b9a\u0bbf \u0bb5\u0bbf\u0bb8\u0bcd\u0bb5\u0ba8\u0bbe\u0ba4\u0bb0\u0bcd \u0ba4\u0bbf\u0bb0\u0bc1\u0b95\u0bcd\u0b95\u0bcb\u0baf\u0bbf\u0bb2\u0bcd',hi:'\u0915\u093e\u0936\u0940 \u0935\u093f\u0936\u094d\u0935\u0928\u093e\u0925 \u091c\u094d\u092f\u094b\u0924\u093f\u0930\u094d\u0932\u093f\u0902\u0917 \u092e\u0902\u0926\u093f\u0930',ml:'\u0d15\u0d3e\u0d36\u0d3f \u0d35\u0d3f\u0d36\u0d4d\u0d35\u0d28\u0d3e\u0d25 \u0d15\u0d4d\u0d37\u0d47\u0d24\u0d4d\u0d30\u0d02',en:'Kashi Vishwanath'},deityId:'shiva',deityName:'Lord Shiva',city:'Varanasi',district:'Varanasi',state:'Uttar Pradesh',country:'India',address:'Lahori Tola, Kashi Vishwanath Dham Corridor, Varanasi, Uttar Pradesh',pincode:'221001',latitude:25.3109,longitude:83.0107,cropIndex:3,about:'Standing on the western bank of the sacred river Ganga in Varanasi (Kashi), the oldest continuously inhabited spiritual city in the world. Lord Vishwanath is the Supreme Ruler of the Universe and the presiding Jyotirlinga granting Moksha to all souls.',history:'Kashi Vishwanath has been venerated since Vedic antiquity. Reconstructed by the legendary Maratha Queen Maharani Ahilyabai Holkar of Indore in 1780, its soaring spires were plated in nearly one ton of pure gold by Maharaja Ranjit Singh in 1835. The magnificent Kashi Vishwanath Corridor now connects the temple directly to the sacred Ganga.',speciality:['Golden Spire (Swarna Shikhar) consecrated by timeless Vedic traditions','Kashi Vishwanath Dham Corridor providing seamless access to Manikarnika & Lalita Ghats','Famous Mangala Aarti celebrated at 03:00 AM with reverberating damru beats','Dashashwamedh Ghat divine Maha Ganga Aarti every evening'],timings:{morning:'03:00 AM \u2013 11:00 AM',evening:'12:00 PM \u2013 11:00 PM',special:'Mangala Aarti: 03:00 AM \u2013 04:00 AM | Bhog Aarti: 11:15 AM \u2013 12:20 PM | Sandhya Aarti: 07:00 PM \u2013 08:15 PM',notes:'General darshan opens after Mangala Aarti. Security scanning and dress code apply inside the temple corridor.'},contact:{phone:'+91 542 2392629',email:'info@shrikashivishwanath.org',website:'https://www.shrikashivishwanath.org'},liveStreamId:'kashi-live',hasLiveDarshan:!0},{id:'rameswaram',name:'Rameswaram Temple',localNames:{te:'\u0c30\u0c3e\u0c2e\u0c47\u0c36\u0c4d\u0c35\u0c30\u0c02 \u0c36\u0c4d\u0c30\u0c40 \u0c30\u0c3e\u0c2e\u0c28\u0c3e\u0c25\u0c38\u0c4d\u0c35\u0c3e\u0c2e\u0c3f \u0c26\u0c47\u0c35\u0c3e\u0c32\u0c2f\u0c02',kn:'\u0cb0\u0cbe\u0cae\u0cc7\u0cb6\u0ccd\u0cb5\u0cb0\u0c82 \u0cb6\u0ccd\u0cb0\u0cc0 \u0cb0\u0cbe\u0cae\u0ca8\u0cbe\u0ca5\u0cb8\u0ccd\u0cb5\u0cbe\u0cae\u0cbf \u0ca6\u0cc7\u0cb5\u0cbe\u0cb2\u0caf',ta:'\u0bb0\u0bbe\u0bae\u0bc7\u0bb8\u0bcd\u0bb5\u0bb0\u0bae\u0bcd \u0bb8\u0bcd\u0bb0\u0bc0 \u0bb0\u0bbe\u0bae\u0ba8\u0bbe\u0ba4\u0b9a\u0bc1\u0bb5\u0bbe\u0bae\u0bbf \u0ba4\u0bbf\u0bb0\u0bc1\u0b95\u0bcd\u0b95\u0bcb\u0baf\u0bbf\u0bb2\u0bcd',hi:'\u0930\u093e\u092e\u0947\u0936\u094d\u0935\u0930\u092e \u0936\u094d\u0930\u0940 \u0930\u093e\u092e\u0928\u093e\u0925\u0938\u094d\u0935\u093e\u092e\u0940 \u091c\u094d\u092f\u094b\u0924\u093f\u0930\u094d\u0932\u093f\u0902\u0917 \u092e\u0902\u0926\u093f\u0930',ml:'\u0d30\u0d3e\u0d2e\u0d47\u0d36\u0d4d\u0d35\u0d30\u0d02 \u0d36\u0d4d\u0d30\u0d40 \u0d30\u0d3e\u0d2e\u0d28\u0d3e\u0d25\u0d38\u0d4d\u0d35\u0d3e\u0d2e\u0d3f \u0d15\u0d4d\u0d37\u0d47\u0d24\u0d4d\u0d30\u0d02',en:'Rameswaram Temple'},deityId:'shiva',deityName:'Lord Shiva & Parvathavardhini Amman',city:'Rameswaram',district:'Ramanathapuram',state:'Tamil Nadu',country:'India',address:'Rameswaram Island, Ramanathapuram District, Tamil Nadu',pincode:'623526',latitude:9.2881,longitude:79.3174,cropIndex:4,about:'Located on Pamban Island in the Gulf of Mannar, Rameswaram Ramanathaswamy Temple is one of the holiest Char Dham pilgrimage destinations and the southernmost of the 12 Jyotirlingas, renowned for its colossal corridors and sacred water tanks.',history:'According to the Ramayana, Lord Sri Rama consecrated and worshipped the sand Shiva Linga (Ramalingam) prepared by Sita Devi to absolve the sin of slaying Ravana. The grand temple complex was expanded in the 12th century by the Pandya and Sethupathi rulers of Ramanathapuram.',speciality:['The longest pillared corridor in the world spanning over 1,200 meters with intricately sculpted granite pillars','22 Sacred Theerthams (holy wells) located inside the temple prakaaram where devotees take holy bath','Agni Theertham on the seashore where pilgrims offer ancestral worship and holy dips','Consecration of the Spatika Lingam worshipped every morning during Spatika Linga Darshanam'],timings:{morning:'05:00 AM \u2013 01:00 PM',evening:'03:00 PM \u2013 09:00 PM',special:'Spatika Linga Darshanam: 05:00 AM \u2013 06:00 AM | Theertha Snanam: 05:30 AM \u2013 12:00 PM',notes:'Devotees traditionally take a dip at Agni Theertham before bathing in the 22 holy wells inside the temple.'},contact:{phone:'+91 4573 221223',email:'rameswaramtemple@gmail.com',website:'https://rameswaramtemple.tnhrce.in'},liveStreamId:void 0,hasLiveDarshan:!1},{id:'kedarnath',name:'Kedarnath Temple',localNames:{te:'\u0c15\u0c47\u0c26\u0c3e\u0c30\u0c4d\u200c\u0c28\u0c3e\u0c25\u0c4d \u0c1c\u0c4d\u0c2f\u0c4b\u0c24\u0c3f\u0c30\u0c4d\u0c32\u0c3f\u0c02\u0c17 \u0c2e\u0c02\u0c26\u0c3f\u0c30\u0c02',kn:'\u0c95\u0cc7\u0ca6\u0cbe\u0cb0\u0ca8\u0cbe\u0ca5 \u0c9c\u0ccd\u0caf\u0ccb\u0ca4\u0cbf\u0cb0\u0ccd\u0cb2\u0cbf\u0c82\u0c97 \u0cae\u0c82\u0ca6\u0cbf\u0cb0',ta:'\u0b95\u0bc7\u0ba4\u0bbe\u0bb0\u0bcd\u0ba8\u0bbe\u0ba4\u0bcd \u0b9c\u0bcb\u0ba4\u0bbf\u0bb0\u0bcd\u0bb2\u0bbf\u0b99\u0bcd\u0b95 \u0ba4\u0bbf\u0bb0\u0bc1\u0b95\u0bcd\u0b95\u0bcb\u0baf\u0bbf\u0bb2\u0bcd',hi:'\u0915\u0947\u0926\u093e\u0930\u0928\u093e\u0925 \u091c\u094d\u092f\u094b\u0924\u093f\u0930\u094d\u0932\u093f\u0902\u0917 \u092e\u0902\u0926\u093f\u0930',ml:'\u0d15\u0d47\u0d26\u0d3e\u0d7c\u0d28\u0d3e\u0d25\u0d4d \u0d1c\u0d4d\u0d2f\u0d4b\u0d24\u0d3f\u0d7c\u0d32\u0d3f\u0d02\u0d17 \u0d15\u0d4d\u0d37\u0d47\u0d24\u0d4d\u0d30\u0d02',en:'Kedarnath Temple'},deityId:'shiva',deityName:'Lord Shiva (Kedareshwara)',city:'Rudraprayag',district:'Rudraprayag',state:'Uttarakhand',country:'India',address:'Kedarnath Valley, Garhwal Himalayas, Rudraprayag District, Uttarakhand',pincode:'246445',latitude:30.7352,longitude:79.0669,cropIndex:2,about:'Perched at an elevation of 3,583 meters amidst the snow-clad peaks of the Garhwal Himalayas near the Mandakini River, Kedarnath is the highest among the 12 Jyotirlingas and the most revered of the Panch Kedar shrines.',history:'According to Mahabharata tradition, the Pandavas sought Lord Shiva to atone for the Mahabharata war. Shiva took the form of a celestial bull and dove into the ground; his hump emerged at Kedarnath. The stone temple was established by Adi Shankaracharya in the 8th century CE.',speciality:['Highest of the 12 Jyotirlingas, situated against the backdrop of the Kedarnath peak (6,940m)','Unshakeable stone architecture constructed with massive interlocking granite slabs','Samadhi of Adi Shankaracharya located right behind the temple','The sacred conical rock form worshipped as the divine hump of Sadashiva'],timings:{morning:'04:00 AM \u2013 03:00 PM',evening:'05:00 PM \u2013 09:00 PM',special:'Maha Abhishek: 04:00 AM \u2013 07:00 AM | Shayan Aarti: 07:30 PM \u2013 08:30 PM',notes:'Temple opens on Akshaya Tritiya (April/May) and closes on Bhai Dooj (November) for the winter months, when worship moves to Ukhimath.'},contact:{phone:'+91 135 2741600',email:'badrinathkedarnath@gmail.com',website:'https://badrinath-kedarnath.gov.in'},liveStreamId:void 0,hasLiveDarshan:!1},{id:'meenakshi-amman',name:'Madurai Meenakshi Amman',localNames:{te:'\u0c2e\u0c27\u0c41\u0c30\u0c48 \u0c2e\u0c40\u0c28\u0c3e\u0c15\u0c4d\u0c37\u0c3f \u0c05\u0c2e\u0c4d\u0c2e\u0c35\u0c3e\u0c30\u0c3f \u0c26\u0c47\u0c35\u0c3e\u0c32\u0c2f\u0c02',kn:'\u0cae\u0ca7\u0cc1\u0cb0\u0cc8 \u0cae\u0cc0\u0ca8\u0cbe\u0c95\u0ccd\u0cb7\u0cbf \u0c85\u0cae\u0ccd\u0cae\u0ca8\u0cb5\u0cb0 \u0ca6\u0cc7\u0cb5\u0cbe\u0cb2\u0caf',ta:'\u0bae\u0ba4\u0bc1\u0bb0\u0bc8 \u0bae\u0bc0\u0ba9\u0bbe\u0b9f\u0bcd\u0b9a\u0bbf \u0b9a\u0bc1\u0ba8\u0bcd\u0ba4\u0bb0\u0bc7\u0bb8\u0bcd\u0bb5\u0bb0\u0bb0\u0bcd \u0ba4\u0bbf\u0bb0\u0bc1\u0b95\u0bcd\u0b95\u0bcb\u0baf\u0bbf\u0bb2\u0bcd',hi:'\u092e\u0926\u0941\u0930\u0948 \u092e\u0940\u0928\u093e\u0915\u094d\u0937\u0940 \u0938\u0941\u0902\u0926\u0930\u0947\u0936\u094d\u0935\u0930\u0930 \u092e\u0902\u0926\u093f\u0930',ml:'\u0d2e\u0d27\u0d41\u0d30 \u0d2e\u0d40\u0d28\u0d3e\u0d15\u0d4d\u0d37\u0d3f \u0d05\u0d2e\u0d4d\u0d2e\u0d7b \u0d15\u0d4d\u0d37\u0d47\u0d24\u0d4d\u0d30\u0d02',en:'Madurai Meenakshi Amman'},deityId:'devi',deityName:'Goddess Meenakshi & Sundareswarar',city:'Madurai',district:'Madurai',state:'Tamil Nadu',country:'India',address:'Chithirai Street, Madurai, Tamil Nadu',pincode:'625001',latitude:9.9195,longitude:78.1193,cropIndex:4,about:'A historic landmark of Dravidian architecture located in the ancient temple city of Madurai on the southern bank of Vaigai River. Dedicated to Goddess Meenakshi (a form of Parvati) and her consort Sundareswarar (Shiva), it is celebrated for its towering gopurams encrusted with thousands of colorful mythological figures.',history:'The ancient temple is referenced in 6th-century Tamil literature. It was significantly rebuilt and expanded under the Nayaka dynasty rulers, especially Thirumalai Nayak (1623\u20131659), who created the iconic thousand-pillared hall and sprawling concentric prakaarams.',speciality:['14 majestic Rajagopurams, with the Southern Tower rising to a height of 170 feet','Ayirakkal Mandapam \u2014 The Hall of Thousand Pillars featuring musical granite pillars','Golden Lotus Tank (Potramarai Kulam) where Tamil poets historically judged ancient literature','Daily ceremonial Palliyarai Pooja carrying Lord Sundareswarar to Meenakshi shrine in a golden palanquin'],timings:{morning:'05:00 AM \u2013 12:30 PM',evening:'04:00 PM \u2013 10:00 PM',special:'Thiruvanandal Pooja: 05:00 AM | Palliyarai Pooja: 09:30 PM',notes:'Traditional South Indian devotional attire is required. Cell phones are restricted inside the main inner sanctum.'},contact:{phone:'+91 452 2344360',email:'jointcommissioner.maduraitemple@gmail.com',website:'https://maduraimeenakshi.org'},liveStreamId:'meenakshi-live',hasLiveDarshan:!0},{id:'palani',name:'Palani Murugan Temple',localNames:{te:'\u0c2a\u0c33\u0c28\u0c3f \u0c26\u0c02\u0c21\u0c3e\u0c2f\u0c41\u0c27\u0c2a\u0c3e\u0c23\u0c3f \u0c38\u0c4d\u0c35\u0c3e\u0c2e\u0c3f \u0c26\u0c47\u0c35\u0c3e\u0c32\u0c2f\u0c02',kn:'\u0caa\u0cb3\u0ca8\u0cbf \u0ca6\u0c82\u0ca1\u0cbe\u0caf\u0cc1\u0ca7\u0caa\u0cbe\u0ca3\u0cbf \u0cb8\u0ccd\u0cb5\u0cbe\u0cae\u0cbf \u0ca6\u0cc7\u0cb5\u0cbe\u0cb2\u0caf',ta:'\u0baa\u0bb4\u0ba9\u0bbf \u0b85\u0bb0\u0bc1\u0bb3\u0bcd\u0bae\u0bbf\u0b95\u0bc1 \u0ba4\u0ba3\u0bcd\u0b9f\u0bbe\u0baf\u0bc1\u0ba4\u0baa\u0bbe\u0ba3\u0bbf \u0b9a\u0bc1\u0bb5\u0bbe\u0bae\u0bbf \u0ba4\u0bbf\u0bb0\u0bc1\u0b95\u0bcd\u0b95\u0bcb\u0baf\u0bbf\u0bb2\u0bcd',hi:'\u092a\u0932\u093e\u0928\u0940 \u092e\u0941\u0930\u0941\u0917\u0928 \u0926\u0902\u0921\u093e\u092f\u0941\u0927\u092a\u093e\u0923\u093f \u092e\u0902\u0926\u093f\u0930',ml:'\u0d2a\u0d34\u0d28\u0d3f \u0d26\u0d23\u0d4d\u0d21\u0d3e\u0d2f\u0d41\u0d27\u0d2a\u0d3e\u0d23\u0d3f \u0d38\u0d4d\u0d35\u0d3e\u0d2e\u0d3f \u0d15\u0d4d\u0d37\u0d47\u0d24\u0d4d\u0d30\u0d02',en:'Palani Murugan Temple'},deityId:'murugan',deityName:'Lord Murugan (Dhandayuthapani)',city:'Palani',district:'Dindigul',state:'Tamil Nadu',country:'India',address:'Giri Veedhi, Palani Hills, Dindigul District, Tamil Nadu',pincode:'624601',latitude:10.4468,longitude:77.5165,cropIndex:1,about:'Perched atop the sacred Sivagiri hill in Palani, this is the 3rd of the six sacred battle camps (Arupadaiveedu) of Lord Murugan. Millions of devotees carry Kavadis and walk hundreds of kilometers barefoot to seek Lord Murugan\u2019s grace.',history:'According to legend, the divine idol was consecrated by the revered Siddhar Sage Bogar out of a mystical amalgam of nine poisonous minerals (Navapashanam), creating miraculous curative properties.',speciality:['Divine Navapashanam idol sculpted by Sage Bogar','GI-tagged Palani Panchamirtham prepared with bananas, jaggery, ghee, honey, and cardamom','Thaipusam and Panguni Uthiram festivals celebrated with devotional ecstasy','Winch and ropeway systems taking pilgrims up the holy hill'],timings:{morning:'06:00 AM \u2013 12:30 PM',evening:'03:30 PM \u2013 09:00 PM',special:'Vila Pooja: 06:30 AM | Sirukala Santhi: 08:00 AM | Sayaratchai: 05:30 PM | Rakkalam: 08:00 PM',notes:'Festival days observe special extended darshan hours.'},contact:{phone:'+91 4545 242236',email:'palanimurugan@tnhrce.in',website:'https://palanimurugan.tnhrce.in'},liveStreamId:void 0,hasLiveDarshan:!1},{id:'siddhivinayak',name:'Siddhivinayak Temple',localNames:{te:'\u0c38\u0c3f\u0c26\u0c4d\u0c27\u0c3f\u0c35\u0c3f\u0c28\u0c3e\u0c2f\u0c15 \u0c26\u0c47\u0c35\u0c3e\u0c32\u0c2f\u0c02',kn:'\u0cb8\u0cbf\u0ca6\u0ccd\u0ca7\u0cbf\u0cb5\u0cbf\u0ca8\u0cbe\u0caf\u0c95 \u0ca6\u0cc7\u0cb5\u0cbe\u0cb2\u0caf',ta:'\u0b9a\u0bbf\u0ba4\u0bcd\u0ba4\u0bbf\u0bb5\u0bbf\u0ba8\u0bbe\u0baf\u0b95\u0bb0\u0bcd \u0ba4\u0bbf\u0bb0\u0bc1\u0b95\u0bcd\u0b95\u0bcb\u0baf\u0bbf\u0bb2\u0bcd',hi:'\u0938\u093f\u0926\u094d\u0927\u093f\u0935\u093f\u0928\u093e\u092f\u0915 \u0917\u0923\u092a\u0924\u093f \u092e\u0902\u0926\u093f\u0930',ml:'\u0d38\u0d3f\u0d26\u0d4d\u0d27\u0d3f\u0d35\u0d3f\u0d28\u0d3e\u0d2f\u0d15 \u0d15\u0d4d\u0d37\u0d47\u0d24\u0d4d\u0d30\u0d02',en:'Siddhivinayak Temple'},deityId:'ganesha',deityName:'Lord Ganesha (Siddhivinayak)',city:'Mumbai',district:'Mumbai City',state:'Maharashtra',country:'India',address:'SK Bole Marg, Prabhadevi, Mumbai, Maharashtra',pincode:'400028',latitude:19.0169,longitude:72.8304,cropIndex:3,about:'Located in Prabhadevi, Mumbai, the Shree Siddhivinayak Ganapati Mandir is one of the richest and most revered Ganesha temples in India. The black stone deity with its trunk turned to the right is renowned as "Navasacha Ganapati", who grants all heartfelt wishes.',history:'Originally consecrated on 19 November 1801 by Laxman Vithu and Deubai Patil. Over two centuries, it expanded from a modest brick shrine into a grand multi-tiered temple with gold-plated domes and state-of-the-art devotee amenities.',speciality:['Rare black stone idol with trunk turning to the right (Siddhi Vinayaka)','Magnificent inner sanctum dome plated in over 12 kilograms of pure gold','Enormous crowds on Angaraki Sankashti Chaturthi and Tuesday worship','Modak offerings and devotional community welfare initiatives'],timings:{morning:'05:30 AM \u2013 12:15 PM',evening:'12:30 PM \u2013 10:00 PM',special:'Kakad Aarti: 05:30 AM \u2013 06:00 AM | Shej Aarti: 09:50 PM',notes:'Tuesdays open early from 03:15 AM for special darshan. Live telecast and online VIP pass facilities available.'},contact:{phone:'+91 22 24223206',email:'info@siddhivinayak.org',website:'https://www.siddhivinayak.org'},liveStreamId:void 0,hasLiveDarshan:!1},{id:'guruvayur',name:'Guruvayur Sri Krishna Temple',localNames:{te:'\u0c17\u0c41\u0c30\u0c41\u0c35\u0c3e\u0c2f\u0c42\u0c30\u0c4d \u0c36\u0c4d\u0c30\u0c40\u0c15\u0c43\u0c37\u0c4d\u0c23 \u0c26\u0c47\u0c35\u0c3e\u0c32\u0c2f\u0c02',kn:'\u0c97\u0cc1\u0cb0\u0cc1\u0cb5\u0cbe\u0caf\u0cc2\u0cb0\u0cc1 \u0cb6\u0ccd\u0cb0\u0cc0\u0c95\u0cc3\u0cb7\u0ccd\u0ca3 \u0ca6\u0cc7\u0cb5\u0cbe\u0cb2\u0caf',ta:'\u0b95\u0bc1\u0bb0\u0bc1\u0bb5\u0bbe\u0baf\u0bc2\u0bb0\u0bcd \u0bb8\u0bcd\u0bb0\u0bc0\u0b95\u0bbf\u0bb0\u0bc1\u0bb7\u0bcd\u0ba3\u0bb0\u0bcd \u0ba4\u0bbf\u0bb0\u0bc1\u0b95\u0bcd\u0b95\u0bcb\u0baf\u0bbf\u0bb2\u0bcd',hi:'\u0917\u0941\u0930\u0941\u0935\u093e\u092f\u0941\u0930 \u0936\u094d\u0930\u0940 \u0915\u0943\u0937\u094d\u0923 \u092e\u0902\u0926\u093f\u0930',ml:'\u0d17\u0d41\u0d30\u0d41\u0d35\u0d3e\u0d2f\u0d42\u0d7c \u0d36\u0d4d\u0d30\u0d40\u0d15\u0d43\u0d37\u0d4d\u0d23 \u0d15\u0d4d\u0d37\u0d47\u0d24\u0d4d\u0d30\u0d02',en:'Guruvayur Sri Krishna Temple'},deityId:'krishna',deityName:'Lord Krishna (Guruvayurappan)',city:'Thrissur',district:'Thrissur',state:'Kerala',country:'India',address:'Guruvayur Devaswom, Thrissur District, Kerala',pincode:'680101',latitude:10.5947,longitude:76.0384,cropIndex:0,about:'Hailed as "Bhuloka Vaikuntham" (the Heaven on Earth), Guruvayur Temple in Thrissur, Kerala is one of the most sacred pilgrimage centers in South India dedicated to infant Lord Krishna holding the conch, discus, mace, and lotus.',history:'According to scripture, the sacred idol worshipped by Lord Krishna in Dwarka was saved from submersion by Guru (Brihaspati) and Vayu (the wind god), who installed it at this blessed spot in Kerala, thereby naming the holy town Guruvayur.',speciality:['Nirmalya Darshanam at 03:00 AM bathed in oil and divine fragrances','Thulabharam offering where devotees weigh themselves against sugar, bananas, or coins','Udayasthamana Pooja and Palpayasam prasadam of divine sweetness','Strict traditional Kerala temple customs preserving ancient sanctity'],timings:{morning:'03:00 AM \u2013 01:30 PM',evening:'04:30 PM \u2013 09:15 PM',special:'Nirmalyam: 03:00 AM | Ucha Pooja: 12:00 PM | Athazha Pooja: 08:30 PM',notes:'Traditional dress code strictly enforced: Dhotis for men (bare upper body), sarees or long skirts for women.'},contact:{phone:'+91 487 2556335',email:'guruvayurdevaswom@gmail.com',website:'https://www.guruvayurdevaswom.in'},liveStreamId:'guruvayur-live',hasLiveDarshan:!0}]},675,[]);
__d(function(n,a,i,m,t,r,h){t.exports={te:[{id:"1",slug:"2026-uthara-nakshatra-dates",title:"2026 \u0c09\u0c24\u0c4d\u0c24\u0c30 \u0c28\u0c15\u0c4d\u0c37\u0c24\u0c4d\u0c30 \u0c24\u0c47\u0c26\u0c40\u0c32\u0c41",description:"[ 2026 \u0c09\u0c24\u0c4d\u0c24\u0c30 \u0c28\u0c15\u0c4d\u0c37\u0c24\u0c4d\u0c30 \u0c24\u0c47\u0c26\u0c40\u0c32\u0c41 ]\n\n\u0c38\u0c4d\u0c35\u0c3e\u0c2e\u0c3f\u0c2f\u0c47 \u0c36\u0c30\u0c23\u0c02 \u0c05\u0c2f\u0c4d\u0c2f\u0c2a\u0c4d\u0c2a, \u0c05\u0c2f\u0c4d\u0c2f\u0c2a\u0c4d\u0c2a \u0c1c\u0c28\u0c4d\u0c2e \u0c28\u0c15\u0c4d\u0c37\u0c24\u0c4d\u0c30\u0c02 \u0c09\u0c24\u0c4d\u0c24\u0c30 \u0c28\u0c15\u0c4d\u0c37\u0c24\u0c4d\u0c30\u0c02 \u0c2e\u0c41\u0c16\u0c4d\u0c2f\u0c02\u0c17\u0c3e \u0c2e\u0c40\u0c28 \u0c2e\u0c3e\u0c38\u0c02(\u0c15\u0c47\u0c30\u0c33 \u0c28\u0c46\u0c32)\u0c32\u0c4b \u0c35\u0c1a\u0c4d\u0c1a\u0c47 \u0c09\u0c24\u0c4d\u0c24\u0c30 \u0c28\u0c15\u0c4d\u0c37\u0c24\u0c4d\u0c30\u0c02 \u0c30\u0c4b\u0c1c\u0c41\u0c28 \u0c05\u0c2f\u0c4d\u0c2f\u0c2a\u0c4d\u0c2a \u0c38\u0c4d\u0c35\u0c3e\u0c2e\u0c3f \u0c1c\u0c28\u0c4d\u0c2e\u0c3f\u0c02\u0c1a\u0c3e\u0c21\u0c41, \u0c15\u0c3e\u0c28\u0c40 \u0c2a\u0c4d\u0c30\u0c24\u0c3f 27 \u0c30\u0c4b\u0c1c\u0c41\u0c32\u0c15\u0c41 \u0c12\u0c15\u0c38\u0c3e\u0c30\u0c3f \u0c09\u0c24\u0c4d\u0c24\u0c30 \u0c28\u0c15\u0c4d\u0c37\u0c24\u0c4d\u0c30\u0c02 \u0c35\u0c38\u0c4d\u0c24\u0c41\u0c02\u0c26\u0c3f,\n\n\u0c09\u0c24\u0c4d\u0c24\u0c30 \u0c28\u0c15\u0c4d\u0c37\u0c24\u0c4d\u0c30\u0c02 \u0c30\u0c4b\u0c1c\u0c41 \u0c05\u0c2f\u0c4d\u0c2f\u0c2a\u0c4d\u0c2a \u0c2a\u0c42\u0c1c \u0c1a\u0c47\u0c2f\u0c3e\u0c32\u0c3f \u0c05\u0c28\u0c41\u0c15\u0c41\u0c28\u0c47 \u0c35\u0c3e\u0c30\u0c3f \u0c15\u0c4b\u0c38\u0c02 \u0c2a\u0c4d\u0c30\u0c24\u0c3f \u0c28\u0c46\u0c32 \u0c0f \u0c24\u0c47\u0c26\u0c40\u0c32\u0c4b \u0c09\u0c24\u0c4d\u0c24\u0c30 \u0c28\u0c15\u0c4d\u0c37\u0c24\u0c4d\u0c30\u0c02 \u0c35\u0c38\u0c4d\u0c24\u0c41\u0c02\u0c26\u0c4b \u0c24\u0c46\u0c32\u0c41\u0c38\u0c41\u0c15\u0c4b\u0c35\u0c21\u0c3e\u0c28\u0c3f\u0c15\u0c3f \u0c07\u0c15\u0c4d\u0c