b0\u0ba3\u0b82 \u0b85\u0baf\u0bcd\u0baf\u0baa\u0bcd\u0baa || 14 ||\n\n\u0ba4\u0bcd\u0bb0\u0bbf\u0bb2\u0bcb\u0b95\u0bae\u0b82\u0b95\u0bb3\u0b82 \u0ba4\u0bc8\u0bb5\u0b82 \u0ba4\u0bcd\u0bb0\u0bbf\u0bae\u0bc2\u0bb0\u0bcd\u0ba4\u0bbf \u0b9c\u0ba8\u0b95\u0b82 \u0bb5\u0bbf\u0baa\u0bc1\u0b82 |\n\u0ba4\u0bb0\u0bcd\u0bae\u0bb6\u0bbe\u0bb8\u0bcd\u0ba4\u0bbe\u0bb0\u0bae\u0bbe\u0ba4\u0bcd\u0baf\u0b82\u0ba4\u0b82 \u0bb5\u0b82\u0ba4\u0bc7\u0bb9\u0b82 \u0bb6\u0baa\u0bb0\u0bc0\u0bb6\u0bcd\u0bb5\u0bb0\u0b82 ||\n|| \u0bb8\u0bcd\u0bb5\u0bbe\u0bae\u0bbf\u0baf\u0bc7 \u0bb6\u0bb0\u0ba3\u0b82 \u0b85\u0baf\u0bcd\u0baf\u0baa\u0bcd\u0baa || 15 ||\n\n\u0bae\u0bb9\u0bbf\u0bb7\u0bc0\u0bae\u0bb0\u0bcd\u0ba4\u0ba8\u0b82 \u0ba4\u0bc7\u0bb5\u0b82 \u0bae\u0bbe\u0bb0\u0bcd\u0ba4\u0bbe\u0b82\u0b9f\u0bbe\u0ba4\u0bcd\u0bae\u0b9c \u0bb8\u0b82\u0baf\u0bc1\u0ba4\u0b82 |\n\u0bae\u0bbe\u0ba4\u0b82\u0b95 \u0bb5\u0bbe\u0bb9\u0ba8\u0b82 \u0bb5\u0b82\u0ba4\u0bc7 \u0bb6\u0bbe\u0bb8\u0bcd\u0ba4\u0bbe\u0bb0\u0b82 \u0baa\u0bcd\u0bb0\u0ba3\u0bae\u0bbe\u0bae\u0bcd\u0baf\u0bb9\u0bae\u0bcd ||\n|| \u0bb8\u0bcd\u0bb5\u0bbe\u0bae\u0bbf\u0baf\u0bc7 \u0bb6\u0bb0\u0ba3\u0b82 \u0b85\u0baf\u0bcd\u0baf\u0baa\u0bcd\u0baa || 16 ||\n\n\u0ba4\u0bb0\u0bcd\u0bae\u0bb8\u0b82\u0bb8\u0bcd\u0ba4\u0bbe\u0baa\u0ba8\u0b82 \u0bb5\u0bc0\u0bb0\u0b82 \u0ba4\u0bc1\u0bb7\u0bcd\u0b9f\u0ba4\u0bbe\u0ba8\u0bb5 \u0ba8\u0bbe\u0bb6\u0ba8\u0b82 |\n\u0bb6\u0bbf\u0bb7\u0bcd\u0b9f\u0bb0\u0b95\u0bcd\u0bb7\u0ba3 \u0ba4\u0ba4\u0bcd\u0baa\u0bb0\u0b82 \u0bb6\u0bbe\u0bb8\u0bcd\u0ba4\u0bbe\u0bb0\u0b82 \u0baa\u0bcd\u0bb0\u0ba3\u0bae\u0bbe\u0bae\u0bcd\u0baf\u0bb9\u0bae\u0bcd ||\n|| \u0bb8\u0bcd\u0bb5\u0bbe\u0bae\u0bbf\u0baf\u0bc7 \u0bb6\u0bb0\u0ba3\u0b82 \u0b85\u0baf\u0bcd\u0baf\u0baa\u0bcd\u0baa || 17 ||\n\n\u0baa\u0b95\u0bcd\u0ba4\u0b9c\u0ba8\u0bbe\u0bb0\u0bcd\u0ba4\u0bbf \u0bb9\u0bb0\u0ba3\u0b82 \u0baa\u0bb0\u0bae\u0bbe\u0ba8\u0b82\u0ba4 \u0ba4\u0bbe\u0baf\u0b95\u0b82 |\n\u0bb6\u0baa\u0bb0\u0bc0\u0bb6\u0bc8\u0bb2 \u0ba8\u0bbf\u0bb2\u0baf\u0b82 \u0bb5\u0b82\u0ba4\u0bc7\u0bb9\u0b82 \u0bae\u0bcb\u0b95\u0bcd\u0bb7\u0ba4\u0bbe\u0baf\u0b95\u0b82 ||\n|| \u0bb8\u0bcd\u0bb5\u0bbe\u0bae\u0bbf\u0baf\u0bc7 \u0bb6\u0bb0\u0ba3\u0b82 \u0b85\u0baf\u0bcd\u0baf\u0baa\u0bcd\u0baa || 18 ||\n\n\u0baa\u0bbe\u0bb2\u0ba8\u0bc7\u0ba4\u0bcd\u0bb0\u0bb8\u0bc1\u0ba4\u0b82 \u0ba4\u0bc7\u0bb5\u0b82 \u0b95\u0bb2\u0bbf\u0ba4\u0bcb\u0bb7\u0ba8\u0bbf\u0bb5\u0bbe\u0bb0\u0ba3\u0b82 |\n\u0baa\u0bbe\u0bb2\u0bb0\u0bc2\u0baa\u0b82 \u0bb2\u0bcb\u0b95\u0ba8\u0bbe\u0ba4\u0b82 \u0ba8\u0bae\u0bbe\u0bae\u0bbf \u0bb6\u0baa\u0bb0\u0bc0\u0bb6\u0bcd\u0bb5\u0bb0\u0bae\u0bcd ||\n|| \u0bb8\u0bcd\u0bb5\u0bbe\u0bae\u0bbf\u0baf\u0bc7 \u0bb6\u0bb0\u0ba3\u0b82 \u0b85\u0baf\u0bcd\u0baf\u0baa\u0bcd\u0baa || 19 ||\n\n\u0baa\u0bc2\u0ba4\u0ba8\u0bbe\u0ba4 \u0bb8\u0ba4\u0bbe\u0ba8\u0b82\u0ba4 \u0bb8\u0bb0\u0bcd\u0bb5\u0baa\u0bc2\u0ba4\u0ba4\u0baf\u0bbe\u0baa\u0bb0\u0b82 |\n\u0bb0\u0b95\u0bcd\u0bb7\u0bb0\u0b95\u0bcd\u0bb7 \u0bae\u0bb9\u0bbe\u0baa\u0bbe\u0bb9\u0bcb \u0bb6\u0bbe\u0bb8\u0bcd\u0ba4\u0bc1 \u0baa\u0bcd\u0baf\u0b82 \u0ba8\u0bae\u0bcb\u0ba8\u0bae\u0b83 ||\n|| \u0bb8\u0bcd\u0bb5\u0bbe\u0bae\u0bbf\u0baf\u0bc7 \u0bb6\u0bb0\u0ba3\u0b82 \u0b85\u0baf\u0bcd\u0baf\u0baa\u0bcd\u0baa || 20 ||\n(\u0baa\u0bc2\u0ba4\u0ba8\u0bbe\u0ba4\u0bbe \u0bb8\u0ba4\u0bbe\u0ba8\u0b82\u0ba4 \u0bae\u0bc2\u0b9f\u0bc1 \u0bb8\u0bbe\u0bb0\u0bcd\u0bb2\u0bc1 \u0b9a\u0ba4\u0bb5\u0bbe\u0bb2\u0bbf)\n\n\u0bb6\u0baa\u0bb0\u0bc0\u0baa\u0bb0\u0bcd\u0bb5\u0ba4\u0bc7 \u0baa\u0bc2\u0b9c\u0bcd\u0baf\u0b82 \u0bb6\u0bbe\u0b82\u0ba4\u0bae\u0bbe\u0ba8\u0bb8 \u0bb8\u0b82\u0bb8\u0bcd\u0ba4\u0bbf\u0ba4\u0b82 |\n\u0bb6\u0bb0\u0ba3\u0bbe\u0b95\u0ba4 \u0bb0\u0b95\u0bcd\u0bb7\u0bbe\u0b82\u0bb6\u0b82 \u0ba8\u0bae\u0bbe\u0bae\u0bbf \u0bb6\u0baa\u0bb0\u0bc0\u0bb6\u0bcd\u0bb5\u0bb0\u0bae\u0bcd ||\n|| \u0bb8\u0bcd\u0bb5\u0bbe\u0bae\u0bbf\u0baf\u0bc7 \u0bb6\u0bb0\u0ba3\u0b82 \u0b85\u0baf\u0bcd\u0baf\u0baa\u0bcd\u0baa || 21 ||\n\n\u0bb6\u0bbe\u0bb8\u0bcd\u0ba4\u0bbe \u0ba4\u0bb6\u0b95\u0b82\n\n\u0bb2\u0bcb\u0b95\u0bb5\u0bc0\u0bb0\u0b82 \u0bae\u0bb9\u0bbe\u0baa\u0bc2\u0b9c\u0bcd\u0baf\u0b82 \u0bb8\u0bb0\u0bcd\u0bb5\u0bb0\u0b95\u0bcd\u0bb7\u0bbe\u0b95\u0bb0\u0b82 \u0bb5\u0bbf\u0baa\u0bc1\u0bae\u0bcd |\n\u0bae\u0ba8\u0bcb\u0b9c\u0bb5\u0bbe\u0ba3 \u0baa\u0bbe\u0ba3\u0bbe\u0bb0\u0bcd\u0ba4\u0b82 \u0bb6\u0bbe\u0bb8\u0bcd\u0ba4\u0bbe\u0bb0\u0b82 \u0baa\u0bcd\u0bb0\u0ba3\u0bae\u0bbe\u0bae\u0bcd\u0baf\u0bb9\u0bae\u0bcd || 1 ||\n\n\u0bb6\u0bbe\u0bb0\u0ba4\u0bbe\u0b9a\u0b82\u0ba4\u0bcd\u0bb0 \u0bb5\u0ba4\u0ba8\u0b82 \u0bb6\u0bb0\u0b9a\u0bcd\u0b9a\u0b82\u0ba4\u0bcd\u0bb0 \u0bb8\u0bae\u0bbe\u0ba8\u0ba8\u0bae\u0bcd |\n\u0bb6\u0baa\u0bb0\u0bc0\u0b95\u0bbf\u0bb0\u0bbf \u0ba8\u0bbf\u0bb2\u0baf\u0b82 \u0bb6\u0bbe\u0bb8\u0bcd\u0ba4\u0bbe\u0bb0\u0b82 \u0baa\u0bcd\u0bb0\u0ba3\u0bae\u0bbe\u0bae\u0bcd\u0baf\u0bb9\u0bae\u0bcd || 2 ||\n\n\u0baa\u0bb8\u0bcd\u0bae\u0bb0\u0bc1\u0ba4\u0bcd\u0bb0\u0bbe\u0b95\u0bcd\u0bb7 \u0bb5\u0bbf\u0baa\u0bcd\u0bb0\u0bbe\u0b9c\u0b82 \u0bae\u0b82\u0ba4\u0bb9\u0bbe\u0bb8 \u0bb5\u0bbf\u0bb0\u0bbe\u0b9c\u0bbf\u0ba4\u0bae\u0bcd |\n\u0bae\u0ba8\u0bcd\u0bae\u0ba4\u0bbe\u0baf\u0bc1\u0ba4 \u0bb8\u0bcc\u0b82\u0ba4\u0bb0\u0bcd\u0baf\u0b82 \u0bb6\u0bbe\u0bb8\u0bcd\u0ba4\u0bbe\u0bb0\u0b82 \u0baa\u0bcd\u0bb0\u0ba3\u0bae\u0bbe\u0bae\u0bcd\u0baf\u0bb9\u0bae\u0bcd || 3 ||\n\n\u0b95\u0bb8\u0bcd\u0ba4\u0bc2\u0bb0\u0bc0 \u0ba4\u0bbf\u0bb2\u0b95\u0bcb\u0baa\u0bc7\u0ba4\u0b82 \u0b95\u0bc1\u0b82\u0b95\u0bc1\u0bae\u0bbe\u0bb0\u0bcd\u0b9a\u0bbf\u0ba4 \u0bae\u0bb8\u0bcd\u0ba4\u0b95\u0bae\u0bcd |\n\u0b95\u0bb0\u0bc1\u0ba3\u0bbe\u0bb8\u0b82\u0ba4\u0bcd\u0bb0 \u0ba8\u0baf\u0ba8\u0b82 \u0bb6\u0bbe\u0bb8\u0bcd\u0ba4\u0bbe\u0bb0\u0b82 \u0baa\u0bcd\u0bb0\u0ba3\u0bae\u0bbe\u0bae\u0bcd\u0baf\u0bb9\u0bae\u0bcd || 4 ||\n\n\u0b95\u0c43\u0ba4\u0baa\u0bc1\u0ba3\u0bcd\u0baf\u0bc8\u0b83 \u0bb8\u0ba4\u0bbe\u0bb8\u0bc7\u0bb5\u0bcd\u0baf\u0b82 \u0baa\u0b95\u0bcd\u0ba4\u0b95\u0bb2\u0bcd\u0baa \u0bae\u0bb9\u0bc0\u0bb0\u0bc1\u0bb9\u0bae\u0bcd |\n\u0b85\u0ba8\u0bbe\u0ba4\u0ba8\u0bbe\u0ba4\u0b82 \u0ba4\u0bc7\u0bb5\u0bc7\u0bb6\u0b82 \u0bb6\u0bbe\u0bb8\u0bcd\u0ba4\u0bbe\u0bb0\u0b82 \u0baa\u0bcd\u0bb0\u0ba3\u0bae\u0bbe\u0bae\u0bcd\u0baf\u0bb9\u0bae\u0bcd || 5 ||\n\n\u0bae\u0ba3\u0bbf\u0baa\u0bc2\u0bb7\u0ba3 \u0bb8\u0b82\u0bb6\u0bcb\u0baa\u0b82 \u0bae\u0ba3\u0bbf\u0b95\u0b82\u0b9f \u0bb5\u0bbf\u0baa\u0bc2\u0bb7\u0bbf\u0ba4\u0bae\u0bcd |\n\u0bae\u0bb9\u0bbe\u0ba4\u0bc7\u0b9c\u0bb8\u0bcd\u0bb5\u0bbf\u0ba8\u0b82 \u0ba4\u0bc7\u0bb5\u0b82 \u0bb6\u0bbe\u0bb8\u0bcd\u0ba4\u0bbe\u0bb0\u0b82 \u0baa\u0bcd\u0bb0\u0ba3\u0bae\u0bbe\u0bae\u0bcd\u0baf\u0bb9\u0bae\u0bcd || 6 ||\n\n\u0bae\u0bb9\u0bbf\u0bb7\u0bc0\u0bae\u0bb8\u0bcd\u0ba4\u0b95\u0bbe\u0bb0\u0bc2\u0b9f\u0b82 \u0bae\u0bbe\u0baf\u0bbe\u0bae\u0bbe\u0ba8\u0bc1\u0bb7 \u0bb5\u0bbf\u0b95\u0bcd\u0bb0\u0bb9\u0bae\u0bcd |\n\u0bae\u0ba8\u0bcd\u0bae\u0ba4\u0baa\u0bcd\u0bb0\u0ba4\u0bbf\u0bae\u0b82 \u0bb6\u0bc2\u0bb0\u0b82 \u0bb6\u0bbe\u0bb8\u0bcd\u0ba4\u0bbe\u0bb0\u0b82 \u0baa\u0bcd\u0bb0\u0ba3\u0bae\u0bbe\u0bae\u0bcd\u0baf\u0bb9\u0bae\u0bcd || 7 ||\n\n\u0bb9\u0bb0\u0bbf\u0bb9\u0bb0\u0bbe\u0ba4\u0bcd\u0bae\u0b9c\u0b82 \u0ba4\u0bc7\u0bb5\u0b82 \u0ba4\u0bc7\u0bb5\u0ba4\u0bc7\u0bb5\u0b82 \u0bb8\u0bc1\u0bb0\u0bbe\u0bb0\u0bcd\u0b9a\u0bbf\u0ba4\u0bae\u0bcd |\n\u0bb8\u0bb0\u0bcd\u0bb5\u0bbe\u0baa\u0bc0\u0bb7\u0bcd\u0b9f\u0baa\u0bcd\u0bb0\u0ba4\u0bbe\u0ba4\u0bbe\u0bb0\u0b82 \u0bb6\u0bbe\u0bb8\u0bcd\u0ba4\u0bbe\u0bb0\u0b82 \u0baa\u0bcd\u0bb0\u0ba3\u0bae\u0bbe\u0bae\u0bcd\u0baf\u0bb9\u0bae\u0bcd || 8 ||\n\n\u0bb6\u0bcd\u0bb0\u0bc0\u0ba4\u0bb0\u0bcd\u0bae\u0bb6\u0bbe\u0bb8\u0bcd\u0ba4\u0bbe \u0ba4\u0bc7\u0bb5\u0bc7\u0bb6\u0b82 \u0bb6\u0bb0\u0ba3\u0bbe\u0b95\u0ba4 \u0bb5\u0ba4\u0bcd\u0bb8\u0bb2\u0bae\u0bcd |\n\u0bb6\u0baa\u0bb0\u0bc0\u0bb5\u0bbe\u0bb8\u0bbf\u0ba8\u0b82 \u0ba4\u0bc7\u0bb5\u0b82 \u0bb6\u0bbe\u0bb8\u0bcd\u0ba4\u0bbe\u0bb0\u0b82 \u0baa\u0bcd\u0bb0\u0ba3\u0bae\u0bbe\u0bae\u0bcd\u0baf\u0bb9\u0bae\u0bcd || 9 ||\n\n\u0baa\u0bc1\u0ba8\u0b83 \u0baa\u0bc2\u0b9c\n\n\u0b93\u0b82 \u0bb6\u0bcd\u0bb0\u0bc0 \u0bae\u0bb9\u0bbe\u0b95\u0ba3\u0bbe\u0ba4\u0bbf\u0baa\u0ba4\u0baf\u0bc7 \u0ba8\u0bae\u0b83 |\n\u0bb5\u0bb2\u0bcd\u0bb2\u0bc0 \u0ba4\u0bc7\u0bb5\u0bb8\u0bc7\u0ba8 \u0bb8\u0bae\u0bc7\u0ba4 \u0bb8\u0bc1\u0baa\u0bcd\u0bb0\u0bae\u0ba3\u0bcd\u0baf \u0bb8\u0bcd\u0bb5\u0bbe\u0bae\u0bbf\u0ba8\u0bc7 \u0ba8\u0bae\u0b83 |\n\u0bb9\u0bb0\u0bbf\u0bb9\u0bb0 \u0baa\u0bc1\u0ba4\u0bcd\u0bb0 \u0b85\u0baf\u0bcd\u0baf\u0baa\u0bcd\u0baa \u0bb8\u0bcd\u0bb5\u0bbe\u0bae\u0bbf\u0ba8\u0bc7 \u0ba8\u0bae\u0b83 |\n\u0baa\u0bc1\u0ba8\u0b83 \u0baa\u0bc2\u0b9c\u0bbe\u0b82 \u0b95\u0bb0\u0bbf\u0bb7\u0bcd\u0baf\u0bc7 ||\n\n\u0b9a\u0ba4\u0bcd\u0bb0\u0b82 \u0b86\u0b9a\u0bcd\u0b9a\u0bbe\u0ba4\u0baf\u0bbe\u0bae\u0bbf |\n\u0b9a\u0bbe\u0bae\u0bb0\u0b82 \u0bb5\u0bc0\u0b9a\u0baf\u0bbe\u0bae\u0bbf |\n\u0ba8\u0c43\u0ba4\u0bcd\u0baf\u0b82 \u0ba4\u0bb0\u0bcd\u0bb6\u0baf\u0bbe\u0bae\u0bbf |\n\u0b95\u0bc0\u0ba4\u0b82 \u0bb6\u0bcd\u0bb0\u0bbe\u0bb5\u0baf\u0bbe\u0bae\u0bbf |\n\u0b85\u0bb6\u0bcd\u0bb5\u0bbe\u0ba8\u0bcd \u0b86\u0bb0\u0bcb\u0bb9\u0baf\u0bbe\u0bae\u0bbf |\n\u0b95\u0b9c\u0bbe\u0ba8\u0bcd \u0b86\u0bb0\u0bcb\u0bb9\u0baf\u0bbe\u0bae\u0bbf |\n\u0b86\u0b82\u0ba4\u0bcb\u0bb3\u0bbf\u0b95\u0bbe\u0b82 \u0b86\u0bb0\u0bcb\u0bb9\u0baf\u0bbe\u0bae\u0bbf |\n\u0bb8\u0bae\u0bb8\u0bcd\u0ba4 \u0bb0\u0bbe\u0b9c\u0bcb\u0baa\u0b9a\u0bbe\u0bb0, \u0ba4\u0bc7\u0bb5\u0bcb\u0baa\u0b9a\u0bbe\u0bb0, \u0baa\u0b95\u0bcd\u0ba4\u0bcd\u0baf\u0bcb\u0baa\u0b9a\u0bbe\u0bb0, \u0bb6\u0b95\u0bcd\u0ba4\u0bcd\u0baf\u0bcb\u0baa\u0b9a\u0bbe\u0bb0, \u0bb8\u0bb0\u0bcd\u0bb5\u0bcb\u0baa\u0b9a\u0bbe\u0bb0 \u0baa\u0bc2\u0b9c\u0bbe\u0b82 \u0bb8\u0bae\u0bb0\u0bcd\u0baa\u0baf\u0bbe\u0bae\u0bbf ||\n(\u0baa\u0bc1\u0bb7\u0bcd\u0baa\u0b82 \u0bb8\u0bae\u0bb0\u0bcd\u0baa\u0bbf\u0b82\u0b9a\u0bb5\u0bb2\u0bc6\u0ba8\u0bc1)\n\n\u0b85\u0baa\u0bb0\u0bbe\u0ba4 \u0b95\u0bcd\u0bb7\u0bae\u0bbe\u0baa\u0ba3 \u0bb8\u0bcd\u0ba4\u0bcb\u0ba4\u0bcd\u0bb0\u0b82\n\n\u0baf\u0bb8\u0bcd\u0baf \u0bb8\u0bcd\u0bae\u0c43\u0ba4\u0bcd\u0baf\u0bbe\u0b9a \u0ba8\u0bbe\u0bae\u0bcb\u0b95\u0bcd\u0ba4\u0bcd\u0baf\u0bbe \u0ba4\u0baa\u0bcb \u0baf\u0b9c\u0bcd\u0b9e \u0b95\u0bcd\u0bb0\u0bbf\u0baf\u0bbe\u0ba4\u0bbf\u0bb7\u0bc1 |\n\u0ba8\u0bcd\u0baf\u0bc2\u0ba8\u0b82 \u0bb8\u0b82\u0baa\u0bc2\u0bb0\u0bcd\u0ba3\u0ba4\u0bbe\u0b82 \u0baf\u0bbe\u0ba4\u0bbf \u0bb8\u0ba4\u0bcd\u0baf\u0bcb \u0bb5\u0b82\u0ba4\u0bc7 \u0ba4\u0bae\u0b9a\u0bcd\u0baf\u0bc1\u0ba4\u0bae\u0bcd ||\n\n\u0bae\u0b82\u0ba4\u0bcd\u0bb0\u0bb9\u0bc0\u0ba8\u0b82 \u0b95\u0bcd\u0bb0\u0bbf\u0baf\u0bbe\u0bb9\u0bc0\u0ba8\u0b82 \u0baa\u0b95\u0bcd\u0ba4\u0bbf\u0bb9\u0bc0\u0ba8\u0b82 \u0bb8\u0bc1\u0bb0\u0bc7\u0bb6\u0bcd\u0bb5\u0bb0 |\n\u0baf\u0ba4\u0bcd\u0baa\u0bc2\u0b9c\u0bbf\u0ba4\u0b82 \u0bae\u0baf\u0bbe \u0ba4\u0bc7\u0bb5 \u0baa\u0bb0\u0bbf\u0baa\u0bc2\u0bb0\u0bcd\u0ba3\u0b82 \u0ba4\u0ba4\u0bb8\u0bcd\u0ba4\u0bc1 \u0ba4\u0bc7 ||\n\n\u0b95\u0bbe\u0baf\u0bc7\u0ba8 \u0bb5\u0bbe\u0b9a\u0bbe \u0bae\u0ba8\u0bb8\u0bc7\u0b82\u0ba4\u0bcd\u0bb0\u0bbf\u0baf\u0bc8\u0bb0\u0bcd\u0bb5\u0bbe \u0baa\u0bc1\u0ba4\u0bcd\u0ba4\u0bcd\u0baf\u0bbe\u0ba4\u0bcd\u0bae\u0ba8\u0bbe \u0bb5\u0bbe \u0baa\u0bcd\u0bb0\u0b95\u0c43\u0ba4\u0bc7\u0b83 \u0bb8\u0bcd\u0bb5\u0baa\u0bbe\u0bb5\u0bbe\u0ba4\u0bcd |\n\u0b95\u0bb0\u0bcb\u0bae\u0bbf \u0baf\u0ba4\u0bcd\u0baf\u0ba4\u0bcd\u0bb8\u0b95\u0bb2\u0b82 \u0baa\u0bb0\u0bb8\u0bcd\u0bae\u0bc8 \u0ba8\u0bbe\u0bb0\u0bbe\u0baf\u0ba3\u0bbe\u0baf\u0bc7\u0ba4\u0bbf \u0bb8\u0bae\u0bb0\u0bcd\u0baa\u0baf\u0bbe\u0bae\u0bbf ||\n\n\u0b85\u0baf\u0bcd\u0baf\u0baa\u0bcd\u0baa \u0b95\u0bcd\u0bb7\u0bae\u0bbe\u0baa\u0bcd\u0bb0\u0bbe\u0bb0\u0bcd\u0ba4\u0ba8 (\u0ba4\u0bc6\u0bb2\u0bc1\u0b95\u0bc1\u0bb2\u0bcb)\n\n\u0b85\u0baf\u0bcd\u0baf\u0baa\u0bcd\u0baa \u0bb8\u0bcd\u0bb5\u0bbe\u0bae\u0bc0! \u0ba4\u0bc6\u0bb2\u0bbf\u0bb8\u0bbf \u0ba4\u0bc6\u0bb2\u0bbf\u0baf\u0b95 \u0b9a\u0bc7\u0bb8\u0bbf\u0ba8 \u0ba4\u0baa\u0bcd\u0baa\u0bc1\u0bb2\u0ba8\u0bc1, \u0bb5\u0bbe\u0b95\u0bcd\u0b95\u0bc1\u0bb2 \u0ba4\u0bcd\u0bb5\u0bbe\u0bb0\u0bbe \u0bae\u0ba8\u0bb8\u0bcd\u0bb8\u0bc1 \u0ba4\u0bcd\u0bb5\u0bbe\u0bb0\u0bbe \u0b9a\u0bc7\u0bb8\u0bbf\u0ba8 \u0b85\u0baa\u0bb0\u0bbe\u0ba4\u0bbe\u0bb2\u0ba8\u0bc1 \u0b95\u0bcd\u0bb7\u0bae\u0bbf\u0b82\u0b9a\u0bbf \u0ba8\u0ba8\u0bcd\u0ba8\u0bc1, \u0ba8\u0bbe \u0b95\u0bc1\u0b9f\u0bc1\u0b82\u0baa\u0bbe\u0ba8\u0bcd\u0ba8\u0bbf \u0bb8\u0bb0\u0bcd\u0bb5\u0ba4\u0bbe \u0b95\u0bbe\u0baa\u0bbe\u0b9f\u0bb5\u0bb2\u0bb8\u0bbf\u0b82\u0ba4\u0bbf\u0b95\u0bbe \u0bb5\u0bc7\u0b9f\u0bc1\u0b95\u0bca\u0ba8\u0bc1\u0b9a\u0bc1\u0ba8\u0bcd\u0ba8\u0bbe\u0ba8\u0bc1. \u0ba8\u0bbe \u0ba4\u0bc7\u0bb9\u0bae\u0bc7 \u0ba8\u0bc0 \u0b86\u0bb2\u0baf\u0bae\u0bc1, \u0ba8\u0bbe \u0baa\u0bcd\u0bb0\u0bbe\u0ba3\u0bae\u0bc7 \u0ba8\u0bc0 \u0bb0\u0bc2\u0baa\u0bae\u0bc1. \u0ba8\u0bbe \u0bb8\u0bb0\u0bcd\u0bb5\u0bb8\u0bcd\u0bb5\u0bae\u0bc1 \u0ba8\u0bc0\u0b95\u0bc7 \u0bb8\u0bae\u0bb0\u0bcd\u0baa\u0bbf\u0b82\u0b9a\u0bc1\u0b95\u0bca\u0ba8\u0bc1\u0b9a\u0bc1\u0ba8\u0bcd\u0ba8\u0bbe\u0ba8\u0bc1 \u0bb8\u0bcd\u0bb5\u0bbe\u0bae\u0bc0.\n\n\u0bb6\u0bbe\u0b82\u0ba4\u0bbf \u0bae\u0b82\u0ba4\u0bcd\u0bb0\u0b82\n\n\u0b93\u0b82 \u0b85\u0bb8\u0ba4\u0bcb\u0bae\u0bbe \u0bb8\u0ba4\u0bcd\u0b95\u0bae\u0baf |\n\u0ba4\u0bae\u0bb8\u0bcb\u0bae\u0bbe \u0b9c\u0bcd\u0baf\u0bcb\u0ba4\u0bbf\u0bb0\u0bcd\u0b95\u0bae\u0baf |\n\u0bae\u0c43\u0ba4\u0bcd\u0baf\u0bcb\u0bb0\u0bcd\u0bae\u0bbe \u0b85\u0bae\u0c43\u0ba4\u0b82\u0b95\u0bae\u0baf ||\n\u0b93\u0b82 \u0bb6\u0bbe\u0b82\u0ba4\u0bbf\u0b83 \u0bb6\u0bbe\u0b82\u0ba4\u0bbf\u0b83 \u0bb6\u0bbe\u0b82\u0ba4\u0bbf\u0b83 ||\n\n\u0b93\u0b82 \u0bb6\u0bcd\u0bb0\u0bc0 \u0bae\u0bb9\u0bbe\u0b95\u0ba3\u0bbe\u0ba4\u0bbf\u0baa\u0ba4\u0bbf, \u0bb5\u0bb2\u0bcd\u0bb2\u0bc0 \u0ba4\u0bc7\u0bb5\u0bb8\u0bc7\u0ba8 \u0bb8\u0bae\u0bc7\u0ba4 \u0bb8\u0bc1\u0baa\u0bcd\u0bb0\u0bae\u0ba3\u0bcd\u0baf \u0bb8\u0bcd\u0bb5\u0bbe\u0bae\u0bbf, \u0bb9\u0bb0\u0bbf\u0bb9\u0bb0 \u0baa\u0bc1\u0ba4\u0bcd\u0bb0 \u0b85\u0baf\u0bcd\u0baf\u0baa\u0bcd\u0baa \u0bb8\u0bcd\u0bb5\u0bbe\u0bae\u0bbf \u0bb8\u0bc1\u0baa\u0bcd\u0bb0\u0bc0\u0ba4\u0bcb \u0bb8\u0bc1\u0baa\u0bcd\u0bb0\u0bb8\u0ba8\u0bcd\u0ba8\u0bcb \u0bb5\u0bb0\u0ba4\u0bcb \u0baa\u0bb5\u0ba4\u0bc1 ||\n\u0bb6\u0bcd\u0bb0\u0bc0\u0bb0\u0bb8\u0bcd\u0ba4\u0bc1, \u0bb6\u0bc1\u0baa\u0bae\u0bb8\u0bcd\u0ba4\u0bc1, \u0b85\u0bb5\u0bbf\u0b95\u0bcd\u0ba8\u0bae\u0bb8\u0bcd\u0ba4\u0bc1.",isAudio:!1,audioDurationSec:40,totalTime:"00:40"},{id:"8",slug:"slogans-of-sri-ayyappa-swami",title:"\u0bb8\u0bcd\u0ba4\u0bcb\u0ba4\u0bcd\u0ba4\u0bbf\u0bb0\u0b99\u0bcd\u0b95\u0bb3\u0bcd",description:"\u0bb8\u0bcd\u0bb5\u0bbe\u0bae\u0bbf \u0bb6\u0bb0\u0ba3\u0b82 \u2013 \u0b85\u0baf\u0bcd\u0baf\u0baa\u0bcd\u0baa \u0bb6\u0bb0\u0ba3\u0b82\n    \u0baa\u0b95\u0bb5\u0bbe\u0ba8\u0bcd \u0bb6\u0bb0\u0ba3\u0b82 \u2013 \u0baa\u0b95\u0bb5\u0ba4\u0bbf \u0bb6\u0bb0\u0ba3\u0b82\n    \u0ba4\u0bc7\u0bb5\u0ba8\u0bcd \u0bb6\u0bb0\u0ba3\u0b82 \u2013 \u0ba4\u0bc7\u0bb5\u0bc0 \u0bb6\u0bb0\u0ba3\u0b82\n    \u0ba4\u0bc7\u0bb5\u0ba8\u0bcd \u0baa\u0bbe\u0ba4\u0b82 \u2013 \u0ba4\u0bc7\u0bb5\u0bc0 \u0baa\u0bbe\u0ba4\u0b82\n    \u0bb8\u0bcd\u0bb5\u0bbe\u0bae\u0bbf \u0baa\u0bbe\u0ba4\u0b82 \u2013 \u0b85\u0baf\u0bcd\u0baf\u0baa\u0bcd\u0baa \u0baa\u0bbe\u0ba4\u0b82\n    \u0baa\u0b95\u0bb5\u0bbe\u0ba8\u0bc7 \u2013 \u0baa\u0b95\u0bb5\u0ba4\u0bbf\u0baf\u0bc7\n    \u0b88\u0bb6\u0bcd\u0bb5\u0bb0\u0ba8\u0bc7 \u2013 \u0b88\u0bb6\u0bcd\u0bb5\u0bb0\u0bbf\u0baf\u0bc7\n    \u0ba4\u0bc7\u0bb5\u0ba8\u0bc7 \u2013 \u0ba4\u0bc7\u0bb5\u0bbf\u0baf\u0bc7\n    \u0bb6\u0b95\u0bcd\u0ba4\u0ba8\u0bc7 \u2013 \u0936\u0915\u094d\u0924\u093f\u0baf\u0bc7\n    \u0bb8\u0bcd\u0bb5\u0bbe\u0bae\u0bbf\u0baf\u0bc7 \u2013 \u0b85\u0baf\u0bcd\u0baf\u0baa\u0bcd\u0baa\u0bcb\n    \u0baa\u0bb2\u0bcd\u0bb2\u0bbf\u0b95\u0b9f\u0bcd\u0b9f\u0bc1 \u2013 \u0bb6\u0baa\u0bb0\u0bbf\u0bae\u0bb2\u0bc8\u0b95\u0bcd\u0b95\u0bc1\n    \u0b87\u0bb0\u0bc1\u0bae\u0bc1\u0b9f\u0bbf\u0b95\u0b9f\u0bcd\u0b9f\u0bc1 \u2013 \u0bb6\u0baa\u0bb0\u0bbf\u0bae\u0bb2\u0bc8\u0b95\u0bcd\u0b95\u0bc1\n    \u0b95\u0b9f\u0bcd\u0b9f\u0bc1\u0b82\u0b95\u0b9f\u0bcd\u0b9f\u0bc1 \u2013 \u0bb6\u0baa\u0bb0\u0bbf\u0bae\u0bb2\u0bc8\u0b95\u0bcd\u0b95\u0bc1\n    \u0b95\u0bb2\u0bcd\u0bb2\u0bc1\u0bae\u0bcd\u0bae\u0bc1\u0bb2\u0bcd\u0bb2\u0bc1\u0b82 \u2013 \u0b95\u0bbe\u0bb2\u0bbf\u0b95\u0bc0\u0bae\u0bc6\u0ba4\u0bcd\u0ba4\u0bc8\n    \u0b8e\u0ba4\u0bcd\u0ba4\u0bbf\u0bb5\u0bbf\u0b9f\u0baf\u0bcd\u0baf \u2013 \u0ba4\u0bc2\u0b95\u0bcd\u0b95\u0bbf\u0b95\u0bcd\u0b95\u0bb5\u0bbf\u0b9f\u0baf\u0bcd\u0baf\n    \u0ba4\u0bc7\u0bb9\u0baa\u0bb2\u0b82\u0ba4\u0bbe \u2013 \u0baa\u0bbe\u0ba4\u0baa\u0bb2\u0b82\u0ba4\u0bbe\n    \u0baf\u0bbe\u0bb0\u0bc8\u0b95\u0bcd\u0b95\u0bbe\u0ba3 \u2013 \u0bb8\u0bcd\u0bb5\u0bbe\u0bae\u0bbf\u0baf\u0bc8\u0b95\u0bcd\u0b95\u0bbe\u0ba3\n    \u0bb8\u0bcd\u0bb5\u0bbe\u0bae\u0bbf\u0baf\u0bc8\u0b95\u0bcd\u0b95\u0b82\u0b9f\u0bbe \u2013 \u0bae\u0bcb\u0b95\u0bcd\u0bb7\u0b82\u0b95\u0bbf\u0b9f\u0bcd\u0b9f\u0bc1\u0b82\n    \u0bb8\u0bcd\u0bb5\u0bbe\u0bae\u0bbf\u0bae\u0bbe\u0bb0\u0bc7 \u2013 \u0b85\u0baf\u0bcd\u0baf\u0baa\u0bcd\u0baa\u0bae\u0bbe\u0bb0\u0bc7\n    \u0ba8\u0bc6\u0baf\u0bcd\u0baf\u0bbe\u0baa\u0bbf\u0bb7\u0bc7\u0b95\u0b82 \u2013 \u0bb8\u0bcd\u0bb5\u0bbe\u0bae\u0bbf\u0b95\u0bcd\u0b95\u0bc7\n    \u0b95\u0bb0\u0bcd\u0baa\u0bc2\u0bb0\u0ba4\u0bc0\u0baa\u0b82 \u2013 \u0bb8\u0bcd\u0bb5\u0bbe\u0bae\u0bbf\u0b95\u0bcd\u0b95\u0bc7\n    \u0baa\u0bbe\u0bb2\u0bbe\u0baa\u0bbf\u0bb7\u0bc7\u0b95\u0b82 \u2013 \u0bb8\u0bcd\u0bb5\u0bbe\u0bae\u0bbf\u0b95\u0bcd\u0b95\u0bc7\n    \u0baa\u0bb8\u0bcd\u0bae\u0bbe\u0baa\u0bbf\u0bb7\u0bc7\u0b95\u0b82 \u2013 \u0bb8\u0bcd\u0bb5\u0bbe\u0bae\u0bbf\u0b95\u0bcd\u0b95\u0bc7\n    \u0ba4\u0bc7\u0ba8\u0bbe\u0baa\u0bbf\u0bb7\u0bc7\u0b95\u0b82 \u2013 \u0bb8\u0bcd\u0bb5\u0bbe\u0bae\u0bbf\u0b95\u0bcd\u0b95\u0bc7\n    \u0b9a\u0b82\u0ba4\u0ba8\u0bbe\u0baa\u0bbf\u0bb7\u0bc7\u0b95\u0b82 \u2013 \u0bb8\u0bcd\u0bb5\u0bbe\u0bae\u0bbf\u0b95\u0bcd\u0b95\u0bc7\n    \u0baa\u0bc2\u0bb2\u0bbe\u0baa\u0bbf\u0bb7\u0bc7\u0b95\u0b82 \u2013 \u0bb8\u0bcd\u0bb5\u0bbe\u0bae\u0bbf\u0b95\u0bcd\u0b95\u0bc7\n    \u0baa\u0ba8\u0bcd\u0ba8\u0bc0\u0bb0\u0bbe\u0baa\u0bbf\u0bb7\u0bc7\u0b95\u0b82 \u2013 \u0bb8\u0bcd\u0bb5\u0bbe\u0bae\u0bbf\u0b95\u0bcd\u0b95\u0bc7\n    \u0baa\u0b82\u0baa\u0bbe\u0bb6\u0bbf\u0bb6\u0bc1\u0bb5\u0bc7 \u2013 \u0b85\u0baf\u0bcd\u0baf\u0baa\u0bcd\u0baa\u0bbe\n    \u0b95\u0bbe\u0ba8\u0ba8\u0bb5\u0bbe\u0bb8\u0bbe \u2013 \u0b85\u0baf\u0bcd\u0baf\u0baa\u0bcd\u0baa\u0bbe\n    \u0bb6\u0baa\u0bb0\u0bbf\u0b95\u0bbf\u0bb0\u0bc0\u0bb6\u0bbe \u2013 \u0b85\u0baf\u0bcd\u0baf\u0baa\u0bcd\u0baa\u0bbe\n    \u0baa\u0b82\u0ba4\u0bb2\u0bb0\u0bbe\u0b9c\u0bbe \u2013 \u0b85\u0baf\u0bcd\u0baf\u0baa\u0bcd\u0baa\u0bbe\n    \u0baa\u0b82\u0baa\u0bbe\u0bb5\u0bbe\u0bb8\u0bbe \u2013 \u0b85\u0baf\u0bcd\u0baf\u0baa\u0bcd\u0baa\u0bbe\n    \u0bb5\u0ba8\u0bcd\u0baa\u0bc1\u0bb2\u0bbf\u0bb5\u0bbe\u0bb9\u0ba8 \u2013 \u0b85\u0baf\u0bcd\u0baf\u0baa\u0bcd\u0baa\u0bbe\n    \u0bb8\u0bc1\u0b82\u0ba4\u0bb0\u0bb0\u0bc2\u0baa\u0bbe \u2013 \u0b85\u0baf\u0bcd\u0baf\u0baa\u0bcd\u0baa\u0bbe\n    \u0bb7\u0ba3\u0bcd\u0bae\u0bc1\u0b95\u0bb8\u0bcb\u0ba4\u0bb0 \u2013 \u0b85\u0baf\u0bcd\u0baf\u0baa\u0bcd\u0baa\u0bbe\n    \u0bae\u0bcb\u0bb9\u0bbf\u0ba8\u0bc0\u0ba4\u0ba8\u0baf\u0bbe \u2013 \u0b85\u0baf\u0bcd\u0baf\u0baa\u0bcd\u0baa\u0bbe\n    \u0b95\u0ba3\u0bc7\u0bb6\u0bb8\u0bcb\u0ba4\u0bb0 \u2013 \u0b85\u0baf\u0bcd\u0baf\u0baa\u0bcd\u0baa\u0bbe\n    \u0bb9\u0bb0\u0bbf\u0bb9\u0bb0\u0ba4\u0ba8\u0baf\u0bbe \u2013 \u0b85\u0baf\u0bcd\u0baf\u0baa\u0bcd\u0baa\u0bbe\n    \u0b85\u0ba8\u0bbe\u0ba4\u0bb0\u0b95\u0bcd\u0bb7\u0b95 \u2013 \u0b85\u0baf\u0bcd\u0baf\u0baa\u0bcd\u0baa\u0bbe\n    \u0bb8\u0ba4\u0bcd\u0b95\u0bc1\u0bb0\u0bc1\u0ba8\u0bbe\u0ba4\u0bbe \u2013 \u0b85\u0baf\u0bcd\u0baf\u0baa\u0bcd\u0baa\u0bbe\n    \u0bb8\u0bcd\u0bb5\u0bbe\u0bae\u0bbf\u0baf\u0bc7 \u2013 \u0b85\u0baf\u0bcd\u0baf\u0baa\u0bcd\u0baa\u0bcb\n    \u0b85\u0baf\u0bcd\u0baf\u0baa\u0bcd\u0baa\u0bcb \u2013 \u0bb8\u0bcd\u0bb5\u0bbe\u0bae\u0bbf\u0baf\u0bc7\n    \u0bb8\u0bcd\u0bb5\u0bbe\u0bae\u0bbf \u0bb6\u0bb0\u0ba3\u0b82 \u2013 \u0b85\u0baf\u0bcd\u0baf\u0baa\u0bcd\u0baa \u0bb6\u0bb0\u0ba3\u0b82",isAudio:!1,audioDurationSec:40,totalTime:"00:40"},{id:"9",slug:"pooja-poorvaangamu",title:"\u0baa\u0bc2\u0b9c\u0bc8 \u0baa\u0bc2\u0bb0\u0bcd\u0bb5\u0bbe\u0b99\u0bcd\u0b95 \u0bae\u0bc1\u0bb1\u0bc8",description:"[ \u0baa\u0bc2\u0b9c\u0bbe \u0baa\u0bc2\u0bb0\u0bcd\u0bb5\u0bbe\u0b82\u0b95\u0bae\u0bc1 - \u0baa\u0bcd\u0bb0\u0bbe\u0bb0\u0b82\u0baa \u0baa\u0bcd\u0bb0\u0bbe\u0bb0\u0bcd\u0ba4\u0ba8 ]\n    \n    \u0b8f \u0baa\u0bc2\u0b9c \u0baa\u0bcd\u0bb0\u0bbe\u0bb0\u0b82\u0baa\u0bbf\u0b82\u0b9a\u0bc7 \u0bae\u0bc1\u0b82\u0ba4\u0bc8\u0ba8\u0bbe \u0baa\u0bc2\u0bb0\u0bcd\u0bb5\u0bbe\u0b82\u0b95 \u0baa\u0bc2\u0b9c\u0ba8\u0bc1 \u0bb5\u0bbf\u0ba4\u0bbf\u0b95\u0bbe \u0b86\u0b9a\u0bb0\u0bbf\u0b82\u0b9a\u0bb5\u0bb2\u0bc6\u0ba8\u0bc1.\n    \n    [ 1. \u0b86\u0b9a\u0bae\u0bcd\u0baf ]\n    \u0b93\u0b82 \u0b95\u0bc7\u0bb6\u0bb5\u0bbe\u0baf \u0bb8\u0bcd\u0bb5\u0bbe\u0bb9\u0bbe (\u0ba4\u0bc0\u0bb0\u0bcd\u0ba4\u0b82 \u0bb8\u0bcd\u0bb5\u0bc0\u0b95\u0bb0\u0bbf\u0b82\u0b9a\u0bb5\u0bb2\u0bc6\u0ba8\u0bc1)\n    \u0b93\u0b82 \u0ba8\u0bbe\u0bb0\u0bbe\u0baf\u0ba3\u0bbe\u0baf \u0bb8\u0bcd\u0bb5\u0bbe\u0bb9\u0bbe (\u0ba4\u0bc0\u0bb0\u0bcd\u0ba4\u0b82 \u0bb8\u0bcd\u0bb5\u0bc0\u0b95\u0bb0\u0bbf\u0b82\u0b9a\u0bb5\u0bb2\u0bc6\u0ba8\u0bc1)\n    \u0b93\u0b82 \u0bae\u0bbe\u0ba4\u0bb5\u0bbe\u0baf \u0bb8\u0bcd\u0bb5\u0bbe\u0bb9\u0bbe (\u0ba4\u0bc0\u0bb0\u0bcd\u0ba4\u0b82 \u0bb8\u0bcd\u0bb5\u0bc0\u0b95\u0bb0\u0bbf\u0b82\u0b9a\u0bb5\u0bb2\u0bc6\u0ba8\u0bc1)\n    \u0b93\u0b82 \u0b95\u0bcb\u0bb5\u0bbf\u0b82\u0ba4\u0bbe\u0baf \u0ba8\u0bae\u0b83 (\u0b9a\u0bc7\u0ba4\u0bc1\u0bb2\u0bc1 \u0b95\u0b9f\u0bc1\u0b95\u0bcd\u0b95\u0bcb\u0bb5\u0bb2\u0bc6\u0ba8\u0bc1)\n    \u0b93\u0b82 \u0bb5\u0bbf\u0bb7\u0bcd\u0ba3\u0bb5\u0bc7 \u0ba8\u0bae\u0b83\n    \u0b93\u0b82 \u0bae\u0ba4\u0bc1\u0bb8\u0bc2\u0ba4\u0ba8\u0bbe\u0baf \u0ba8\u0bae\u0b83\n    \u0b93\u0b82 \u0ba4\u0bcd\u0bb0\u0bbf\u0bb5\u0bbf\u0b95\u0bcd\u0bb0\u0bae\u0bbe\u0baf \u0ba8\u0bae\u0b83\n    \u0b93\u0b82 \u0bb5\u0bbe\u0bae\u0ba8\u0bbe\u0baf \u0ba8\u0bae\u0b83\n    \u0b93\u0b82 \u0bb6\u0bcd\u0bb0\u0bc0\u0ba4\u0bb0\u0bbe\u0baf \u0ba8\u0bae\u0b83\n    \u0b93\u0b82 \u0bb9\u0c43\u0bb7\u0bc0\u0b95\u0bc7\u0bb6\u0bbe\u0baf \u0ba8\u0bae\u0b83\n    \u0b93\u0b82 \u0baa\u0ba4\u0bcd\u0bae\u0ba8\u0bbe\u0baa\u0bbe\u0baf \u0ba8\u0bae\u0b83\n    \u0b93\u0b82 \u0ba4\u0bbe\u0bae\u0bcb\u0ba4\u0bb0\u0bbe\u0baf \u0ba8\u0bae\u0b83\n    \n    [ 2. \u0baa\u0bcd\u0bb0\u0bbe\u0ba3\u0bbe\u0baf\u0bbe\u0bae\u0b83 ]\n    \u0b93\u0b82 \u0baa\u0bc2\u0b83 \u0b93\u0b82 \u0baa\u0bc1\u0bb5\u0b83 \u0b93\u0b82 \u0bb8\u0bc1\u0bb5\u0b83 \u0b93\u0b82 \u0bae\u0bb9\u0b83 \u0b93\u0b82 \u0b9c\u0ba8\u0b83 \u0b93\u0b82 \u0ba4\u0baa\u0b83 \u0b93\u0b95\u0bcd\u0b82 \u0bb8\u0ba4\u0bcd\u0baf\u0bae\u0bcd\n    \u0b93\u0b82 \u0ba4\u0ba4\u0bcd\u0bb8\u0bb5\u0bbf\u0ba4\u0bc1\u0bb0\u0bcd\u0bb5\u0bb0\u0bc7\u0ba3\u0bcd\u0baf\u0b82 \u0baa\u0bb0\u0bcd\u0b95\u0bcb \u0ba4\u0bc7\u0bb5\u0bb8\u0bcd\u0baf \u0ba4\u0bc0\u0bae\u0bb9\u0bbf \u0ba4\u0bbf\u0baf\u0bcb \u0baf\u0bcb \u0ba8\u0b83 \u0baa\u0bcd\u0bb0\u0b9a\u0bcb\u0ba4\u0baf\u0bbe\u0ba4\u0bcd\n    \u0b93\u0bae\u0bbe\u0baa\u0bcb \u0b9c\u0bcd\u0baf\u0bcb\u0ba4\u0bc0\u0bb0\u0bb8\u0bcb\u0bae\u0c43\u0ba4\u0b82 \u0baa\u0bcd\u0bb0\u0bb9\u0bcd\u0bae \u0baa\u0bc2\u0bb0\u0bcd\u0baa\u0bc1\u0bb5\u0bb8\u0bcd\u0bb8\u0bc1\u0bb5\u0bb0\u0bcb\u0bae\u0bcd\n    \n    [ 3. \u0bb8\u0b82\u0b95\u0bb2\u0bcd\u0baa\u0b83 ]\n    \u0bae\u0bae \u0b89\u0baa\u0bbe\u0ba4\u0bcd\u0ba4 \u0bb8\u0bae\u0bb8\u0bcd\u0ba4 \u0ba4\u0bc1\u0bb0\u0bbf\u0ba4\u0b95\u0bcd\u0bb7\u0baf\u0ba4\u0bcd\u0bb5\u0bbe\u0bb0\u0bbe \u0bb6\u0bcd\u0bb0\u0bc0 \u0baa\u0bb0\u0bae\u0bc7\u0bb6\u0bcd\u0bb5\u0bb0/\u0bb6\u0bcd\u0bb0\u0bc0 \u0b85\u0baf\u0bcd\u0baf\u0baa\u0bcd\u0baa \u0bb8\u0bcd\u0bb5\u0bbe\u0bae\u0bbf \u0baa\u0bcd\u0bb0\u0bc0\u0ba4\u0bcd\u0baf\u0bb0\u0bcd\u0ba4\u0b82 \u0bb6\u0bc1\u0baa\u0bc7 \u0bb6\u0bcb\u0baa\u0ba8\u0bc7 \u0bae\u0bc1\u0bb9\u0bc2\u0bb0\u0bcd\u0ba4\u0bc7 \u0bb6\u0bcd\u0bb0\u0bc0 \u0bae\u0bb9\u0bbe\u0b95\u0bbe\u0ba3\u0bbe\u0ba4\u0bbf\u0baa\u0ba4\u0bbf \u0baa\u0bc2\u0b9c\u0bbe\u0b82, \u0bb6\u0bcd\u0bb0\u0bc0 \u0b85\u0baf\u0bcd\u0baf\u0baa\u0bcd\u0baa \u0bb8\u0bcd\u0bb5\u0bbe\u0bae\u0bbf \u0baa\u0bc2\u0b9c\u0bbe\u0b82 \u0b9a \u0b95\u0bb0\u0bbf\u0bb7\u0bcd\u0baf\u0bc7.\n    \n    [ 4. \u0b95\u0bb2\u0bb6 \u0baa\u0bc2\u0b9c ]\n    \u0b95\u0bb2\u0bb6\u0bb8\u0bcd\u0baf \u0bae\u0bc1\u0b95\u0bc7 \u0bb5\u0bbf\u0bb7\u0bcd\u0ba3\u0bc1\u0b83 \u0b95\u0b82\u0b9f\u0bc7 \u0bb0\u0bc1\u0ba4\u0bcd\u0bb0\u0b83 \u0bb8\u0bae\u0bbe\u0bb6\u0bcd\u0bb0\u0bbf\u0ba4\u0b83\n    \u0bae\u0bc2\u0bb2\u0bc7 \u0ba4\u0ba4\u0bcd\u0bb0 \u0bb8\u0bcd\u0ba4\u0bbf\u0ba4\u0bcb \u0baa\u0bcd\u0bb0\u0bb9\u0bcd\u0bae\u0bbe \u0bae\u0ba4\u0bcd\u0baf\u0bc7 \u0bae\u0bbe\u0ba4\u0c43\u0b95\u0ba3\u0bbe\u0b83 \u0bb8\u0bcd\u0bae\u0c43\u0ba4\u0bbe\u0b83\n    \n    \u0b95\u0b82\u0b95\u0bc7 \u0b9a \u0baf\u0bae\u0bc1\u0ba8\u0bc7 \u0b9a\u0bc8\u0bb5 \u0b95\u0bcb\u0ba4\u0bbe\u0bb5\u0bb0\u0bbf \u0bb8\u0bb0\u0bb8\u0bcd\u0bb5\u0ba4\u0bc0\n    \u0ba8\u0bb0\u0bcd\u0bae\u0ba4\u0bc7 \u0bb8\u0bbf\u0b82\u0ba4\u0bc1 \u0b95\u0bbe\u0bb5\u0bc7\u0bb0\u0bc0 \u0b9c\u0bb2\u0bc7\u0bb8\u0bcd\u0bae\u0bbf\u0ba8\u0bcd \u0bb8\u0ba8\u0bcd\u0ba8\u0bbf\u0ba4\u0bbf\u0b82 \u0b95\u0bc1\u0bb0\u0bc1\n    \n    \u0b93\u0b82 \u0bb6\u0bcd\u0bb0\u0bc0 \u0bb8\u0bcd\u0bb5\u0bbe\u0bae\u0bbf\u0baf\u0bc7 \u0bb6\u0bb0\u0ba3\u0b82 \u0b85\u0baf\u0bcd\u0baf\u0baa\u0bcd\u0baa!",isAudio:!1,audioDurationSec:40,totalTime:"00:40"},{id:"10",slug:"sri-vigneshwara-ashtottara",title:"\u0bb8\u0bcd\u0bb0\u0bc0 \u0bae\u0b95\u0bbe \u0b95\u0ba3\u0baa\u0ba4\u0bbf",description:"[ \u0bb6\u0bcd\u0bb0\u0bc0 \u0bb5\u0bbf\u0b95\u0bcd\u0ba8\u0bc7\u0bb6\u0bcd\u0bb5\u0bb0 \u0b85\u0b82\u0b95\u0baa\u0bc2\u0b9c ]\n    \u0b93\u0b82 \u0baa\u0bbe\u0bb0\u0bcd\u0bb5\u0ba4\u0bc0 \u0ba8\u0b82\u0ba4\u0ba8\u0bbe\u0baf \u0ba8\u0bae\u0b83 - \u0baa\u0bbe\u0ba4\u0bcc \u0baa\u0bc2\u0b9c\u0baf\u0bbe\u0bae\u0bbf\n    \u0b93\u0b82 \u0bb6\u0bcd\u0bb0\u0bc0 \u0b95\u0ba3\u0bc7\u0bb6\u0bbe\u0baf \u0ba8\u0bae\u0b83 - \u0b95\u0bc1\u0bb2\u0bcd\u0baa\u0bcc \u0baa\u0bc2\u0b9c\u0baf\u0bbe\u0bae\u0bbf\n    \u0b93\u0b82 \u0b9c\u0bcd\u0baf\u0bcb\u0ba4\u0bbf\u0bb0\u0bcd\u0ba4\u0bbe\u0ba4\u0bcd\u0bb0\u0bc7 \u0ba8\u0bae\u0b83 - \u0b9c\u0b82\u0b95\u0bc7 \u0baa\u0bc2\u0b9c\u0baf\u0bbe\u0bae\u0bbf\n    \u0b93\u0b82 \u0b9c\u0b95\u0ba4\u0bcd\u0bb5\u0bb2\u0bcd\u0bb2\u0baa\u0bbe\u0baf \u0ba8\u0bae\u0b83 - \u0b8a\u0bb0\u0bc2 \u0baa\u0bc2\u0b9c\u0baf\u0bbe\u0bae\u0bbf\n    \u0b93\u0b82 \u0bb5\u0bbf\u0b95\u0b9f\u0bbe\u0baf \u0ba8\u0bae\u0b83 - \u0b95\u0b9f\u0bbf\u0b82 \u0baa\u0bc2\u0b9c\u0baf\u0bbe\u0bae\u0bbf\n    \u0b93\u0b82 \u0b95\u0bc1\u0bb9\u0bbe\u0b95\u0bcd\u0bb0\u0b9c\u0bbe\u0baf \u0ba8\u0bae\u0b83 - \u0b95\u0bc1\u0bb9\u0bcd\u0baf\u0b82 \u0baa\u0bc2\u0b9c\u0baf\u0bbe\u0bae\u0bbf\n    \u0b93\u0b82 \u0bae\u0bb9\u0bcb\u0ba4\u0bcd\u0ba4\u0bae\u0bbe\u0baf \u0ba8\u0bae\u0b83 - \u0bae\u0bc7\u0b9f\u0bcd\u0bb0\u0b82 \u0baa\u0bc2\u0b9c\u0baf\u0bbe\u0bae\u0bbf\n    \u0b93\u0b82 \u0b95\u0ba3\u0ba8\u0bbe\u0ba4\u0bbe\u0baf \u0ba8\u0bae\u0b83 - \u0ba8\u0bbe\u0baa\u0bbf\u0b82 \u0baa\u0bc2\u0b9c\u0baf\u0bbe\u0bae\u0bbf\n    \u0b93\u0b82 \u0b89\u0ba4\u0bcd\u0ba4\u0bae\u0bbe\u0baf \u0ba8\u0bae\u0b83 - \u0b89\u0ba4\u0bb0\u0b82 \u0baa\u0bc2\u0b9c\u0baf\u0bbe\u0bae\u0bbf\n    \u0b93\u0b82 \u0bb5\u0bbf\u0ba8\u0bbe\u0baf\u0b95\u0bbe\u0baf \u0ba8\u0bae\u0b83 - \u0bb5\u0b95\u0bcd\u0bb7\u0bb8\u0bcd\u0ba4\u0bb2\u0b82 \u0baa\u0bc2\u0b9c\u0baf\u0bbe\u0bae\u0bbf\n    \u0b93\u0b82 \u0baa\u0bbe\u0bb6\u0b9a\u0bcd\u0b9a\u0bbf\u0ba4\u0bc7 \u0ba8\u0bae\u0b83 - \u0baa\u0bbe\u0bb0\u0bcd\u0bb6\u0bcd\u0bb5\u0bc7 \u0baa\u0bc2\u0b9c\u0baf\u0bbe\u0bae\u0bbf\n    \u0b93\u0b82 \u0bb9\u0bc7\u0bb0\u0b82\u0baa\u0bbe\u0baf \u0ba8\u0bae\u0b83 - \u0bb9\u0c43\u0ba4\u0baf\u0b82 \u0baa\u0bc2\u0b9c\u0baf\u0bbe\u0bae\u0bbf\n    \u0b93\u0b82 \u0b95\u0baa\u0bbf\u0bb2\u0bbe\u0baf \u0ba8\u0bae\u0b83 - \u0b95\u0b82\u0b9f\u0b82 \u0baa\u0bc2\u0b9c\u0baf\u0bbe\u0bae\u0bbf\n    \u0b93\u0b82 \u0bb8\u0bcd\u0b95\u0b82\u0ba4\u0bbe\u0b95\u0bcd\u0bb0\u0b9c\u0bbe\u0baf \u0ba8\u0bae\u0b83 - \u0bb8\u0bcd\u0b95\u0b82\u0ba4\u0bcc \u0baa\u0bc2\u0b9c\u0baf\u0bbe\u0bae\u0bbf\n    \u0b93\u0b82 \u0bb9\u0bb0\u0bb8\u0bc1\u0ba4\u0bbe\u0baf \u0ba8\u0bae\u0b83 - \u0bb9\u0bb8\u0bcd\u0ba4\u0bbe\u0ba8\u0bcd \u0baa\u0bc2\u0b9c\u0baf\u0bbe\u0bae\u0bbf\n    \u0b93\u0b82 \u0baa\u0bcd\u0bb0\u0bb9\u0bcd\u0bae\u0b9a\u0bbe\u0bb0\u0bbf\u0ba3\u0bc7 \u0ba8\u0bae\u0b83 - \u0baa\u0bbe\u0bb9\u0bc2\u0ba8\u0bcd \u0baa\u0bc2\u0b9c\u0baf\u0bbe\u0bae\u0bbf\n    \u0b93\u0b82 \u0bb8\u0bc1\u0bae\u0bc1\u0b95\u0bbe\u0baf \u0ba8\u0bae\u0b83 - \u0bae\u0bc1\u0b95\u0b82 \u0baa\u0bc2\u0b9c\u0baf\u0bbe\u0bae\u0bbf\n    \u0b93\u0b82 \u0b8f\u0b95\u0ba4\u0b82\u0ba4\u0bbe\u0baf \u0ba8\u0bae\u0b83 - \u0ba4\u0b82\u0ba4\u0bcc \u0baa\u0bc2\u0b9c\u0baf\u0bbe\u0bae\u0bbf\n    \u0b93\u0b82 \u0bb5\u0bbf\u0b95\u0bcd\u0ba8\u0bb9\u0b82\u0ba4\u0bcd\u0bb0\u0bc7 \u0ba8\u0bae\u0b83 - \u0ba8\u0bc7\u0ba4\u0bcd\u0bb0\u0bc7 \u0baa\u0bc2\u0b9c\u0baf\u0bbe\u0bae\u0bbf\n    \u0b93\u0b82 \u0bb6\u0bc2\u0bb0\u0bcd\u0baa\u0b95\u0bb0\u0bcd\u0ba3\u0bbe\u0baf \u0ba8\u0bae\u0b83 - \u0b95\u0bb0\u0bcd\u0ba3\u0bcc \u0baa\u0bc2\u0b9c\u0baf\u0bbe\u0bae\u0bbf\n    \u0b93\u0b82 \u0baa\u0bbe\u0bb2\u0b9a\u0b82\u0ba4\u0bcd\u0bb0\u0bbe\u0baf \u0ba8\u0bae\u0b83 - \u0b95\u0baa\u0bbe\u0bb2\u0b82 \u0baa\u0bc2\u0b9c\u0baf\u0bbe\u0bae\u0bbf\n    \u0b93\u0b82 \u0ba8\u0bbe\u0b95\u0baa\u0bb0\u0ba3\u0bbe\u0baf \u0ba8\u0bae\u0b83 - \u0ba8\u0bbe\u0bb8\u0bbf\u0b95\u0bbe\u0b82 \u0baa\u0bc2\u0b9c\u0baf\u0bbe\u0bae\u0bbf\n    \u0b93\u0b82 \u0b9a\u0bbf\u0bb0\u0b82\u0ba4\u0ba8\u0bbe\u0baf \u0ba8\u0bae\u0b83 - \u0b9a\u0bc1\u0baa\u0bc1\u0b95\u0b82 \u0baa\u0bc2\u0b9c\u0baf\u0bbe\u0bae\u0bbf\n    \u0b93\u0b82 \u0bb8\u0bcd\u0ba4\u0bc2\u0bb2\u0bcb\u0bb7\u0bcd\u0b9f\u0bbe\u0baf \u0ba8\u0bae\u0b83 - \u0b93\u0bb7\u0bcd\u0b9f\u0bcc \u0baa\u0bc2\u0b9c\u0baf\u0bbe\u0bae\u0bbf\n    \u0b93\u0b82 \u0b95\u0bbe\u0bb2\u0b95\u0b82\u0b9f\u0bbe\u0baf \u0ba8\u0bae\u0b83 - \u0b95\u0b82\u0b9f\u0bcc \u0baa\u0bc2\u0b9c\u0baf\u0bbe\u0bae\u0bbf\n    \u0b93\u0b82 \u0b95\u0baa\u0bbf\u0bb2\u0bbe\u0baf \u0ba8\u0bae\u0b83 - \u0b95\u0b9a\u0bbe\u0ba8\u0bcd \u0baa\u0bc2\u0b9c\u0baf\u0bbe\u0bae\u0bbf\n    \u0b93\u0b82 \u0bb6\u0bbf\u0bb5\u0baa\u0bcd\u0bb0\u0bbf\u0baf\u0bbe\u0baf \u0ba8\u0bae\u0b83 - \u0bb6\u0bbf\u0bb0\u0b83 \u0baa\u0bc2\u0b9c\u0baf\u0bbe\u0bae\u0bbf\n    \u0b93\u0b82 \u0bb8\u0bb0\u0bcd\u0bb5\u0bae\u0b82\u0b95\u0bb3\u0bbe \u0bb8\u0bc1\u0ba4\u0bbe\u0baf \u0ba8\u0bae\u0b83 - \u0bb8\u0bb0\u0bcd\u0bb5\u0bbe\u0ba3\u0bcd\u0baf\u0b82\u0b95\u0bbe\u0ba8\u0bbf \u0baa\u0bc2\u0b9c\u0baf\u0bbe\u0bae\u0bbf\n    \n    [ \u0bb6\u0bcd\u0bb0\u0bc0 \u0bb5\u0bbf\u0b95\u0bcd\u0ba8\u0bc7\u0bb6\u0bcd\u0bb5\u0bb0 \u0b85\u0bb7\u0bcd\u0b9f\u0bcb\u0ba4\u0bcd\u0ba4\u0bb0 \u0bb6\u0ba4 \u0ba8\u0bbe\u0bae\u0bbe\u0bb5\u0bb3\u0bbf ]\n    \u0b93\u0b82 \u0bb5\u0bbf\u0ba8\u0bbe\u0baf\u0b95\u0bbe\u0baf \u0ba8\u0bae\u0b83\n    \u0b93\u0b82 \u0bb5\u0bbf\u0b95\u0bcd\u0ba8\u0bb0\u0bbe\u0b9c\u0bbe\u0baf \u0ba8\u0bae\u0b83\n    \u0b93\u0b82 \u0b95\u0bcc\u0bb0\u0bc0\u0baa\u0bc1\u0ba4\u0bcd\u0bb0\u0bbe\u0baf \u0ba8\u0bae\u0b83\n    \u0b93\u0b82 \u0b95\u0ba3\u0bc7\u0bb6\u0bcd\u0bb5\u0bb0\u0bbe\u0baf \u0ba8\u0bae\u0b83\n    \u0b93\u0b82 \u0bb8\u0bcd\u0b95\u0b82\u0ba4\u0bbe\u0b95\u0bcd\u0bb0\u0b9c\u0bbe\u0baf \u0ba8\u0bae\u0b83\n    \u0b93\u0b82 \u0b85\u0bb5\u0bcd\u0baf\u0baf\u0bbe\u0baf \u0ba8\u0bae\u0b83\n    \u0b93\u0b82 \u0baa\u0bc2\u0bb7\u0bbe\u0baf \u0ba8\u0bae\u0b83\n    \u0b93\u0b82 \u0ba4\u0b95\u0bcd\u0bb7\u0bbe\u0baf \u0ba8\u0bae\u0b83\n    \u0b93\u0b82 \u0b85\u0ba4\u0bcd\u0baf\u0b95\u0bcd\u0bb7\u0bbe\u0baf \u0ba8\u0bae\u0b83\n    \u0b93\u0b82 \u0ba4\u0bcd\u0bb5\u0bbf\u0b9c\u0baa\u0bcd\u0bb0\u0bbf\u0baf\u0bbe\u0baf \u0ba8\u0bae\u0b83\n    \u0b93\u0b82 \u0b85\u0b95\u0bcd\u0ba8\u0bbf\u0b95\u0bb0\u0bcd\u0baa\u0b9a\u0bcd\u0b9a\u0bbf\u0ba4\u0bc7 \u0ba8\u0bae\u0b83\n    \u0b93\u0b82 \u0b87\u0b82\u0ba4\u0bcd\u0bb0\u0bb6\u0bcd\u0bb0\u0bc0\u0baa\u0bcd\u0bb0\u0ba4\u0bbe\u0baf \u0ba8\u0bae\u0b83\n    \u0b93\u0b82 \u0bb5\u0bbe\u0ba3\u0bc0\u0baa\u0bcd\u0bb0\u0ba4\u0bbe\u0baf \u0ba8\u0bae\u0b83\n    \u0b93\u0b82 \u0b85\u0bb5\u0bcd\u0baf\u0baf\u0bbe\u0baf \u0ba8\u0bae\u0b83\n    \u0b93\u0b82 \u0bb8\u0bb0\u0bcd\u0bb5\u0bb8\u0bbf\u0ba4\u0bcd\u0ba4\u0bbf\u0baa\u0bcd\u0bb0\u0ba4\u0bbe\u0baf \u0ba8\u0bae\u0b83\n    \u0b93\u0b82 \u0bb6\u0bb0\u0bcd\u0bb5\u0ba4\u0ba8\u0baf\u0bbe\u0baf \u0ba8\u0bae\u0b83\n    \u0b93\u0b82 \u0bb6\u0bb0\u0bcd\u0bb5\u0bb0\u0bc0\u0baa\u0bcd\u0bb0\u0bbf\u0baf\u0bbe\u0baf \u0ba8\u0bae\u0b83\n    \u0b93\u0b82 \u0bb8\u0bb0\u0bcd\u0bb5\u0bbe\u0ba4\u0bcd\u0bae\u0b95\u0bbe\u0baf \u0ba8\u0bae\u0b83\n    \u0b93\u0b82 \u0bb8\u0c43\u0bb7\u0bcd\u0b9f\u0bbf\u0b95\u0bb0\u0bcd\u0ba4\u0bcd\u0bb0\u0bc7 \u0ba8\u0bae\u0b83\n    \u0b93\u0b82 \u0ba4\u0bc7\u0bb5\u0bbe\u0ba8\u0bc7\u0b95\u0bbe\u0bb0\u0bcd\u0b9a\u0bbf\u0ba4\u0bbe\u0baf \u0ba8\u0bae\u0b83\n    \u0b93\u0b82 \u0bb6\u0bbf\u0bb5\u0bbe\u0baf \u0ba8\u0bae\u0b83\n    \u0b93\u0b82 \u0bb6\u0bc1\u0ba4\u0bcd\u0ba4\u0bbe\u0baf \u0ba8\u0bae\u0b83\n    \u0b93\u0b82 \u0baa\u0bc1\u0ba4\u0bcd\u0ba4\u0bbf\u0baa\u0bcd\u0bb0\u0ba4\u0bbe\u0baf \u0ba8\u0bae\u0b83\n    \u0b93\u0b82 \u0bb6\u0bbe\u0b82\u0ba4\u0bbe\u0baf \u0ba8\u0bae\u0b83\n    \u0b93\u0b82 \u0baa\u0bcd\u0bb0\u0bb9\u0bcd\u0bae\u0b9a\u0bbe\u0bb0\u0bbf\u0ba3\u0bc7 \u0ba8\u0bae\u0b83\n    \u0b93\u0b82 \u0b95\u0b9c\u0bbe\u0ba8\u0ba8\u0bbe\u0baf \u0ba8\u0bae\u0b83\n    \u0b93\u0b82 \u0ba4\u0bcd\u0bb5\u0bc8\u0bae\u0bbe\u0ba4\u0bc1\u0bb0\u0bbe\u0baf \u0ba8\u0bae\u0b83\n    \u0b93\u0b82 \u0bae\u0bc1\u0ba8\u0bbf\u0bb8\u0bcd\u0ba4\u0bc1\u0ba4\u0bcd\u0baf\u0bbe\u0baf \u0ba8\u0bae\u0b83\n    \u0b93\u0b82 \u0baa\u0b95\u0bcd\u0ba4\u0bb5\u0bbf\u0b95\u0bcd\u0ba8\u0bb5\u0bbf\u0ba8\u0bbe\u0bb6\u0bbe\u0baf \u0ba8\u0bae\u0b83\n    \u0b93\u0b82 \u0b8f\u0b95\u0ba4\u0b82\u0ba4\u0bbe\u0baf \u0ba8\u0bae\u0b83\n    \u0b93\u0b82 \u0b9a\u0ba4\u0bc1\u0bb0\u0bcd\u0baa\u0bbe\u0bb9\u0bb5\u0bc7 \u0ba8\u0bae\u0b83\n    \u0b93\u0b82 \u0b9a\u0ba4\u0bc1\u0bb0\u0bbe\u0baf \u0ba8\u0bae\u0b83\n    \u0b93\u0b82 \u0bb6\u0b95\u0bcd\u0ba4\u0bbf\u0bb8\u0b82\u0baf\u0bc1\u0ba4\u0bbe\u0baf \u0ba8\u0bae\u0b83\n    \u0b93\u0b82 \u0bb2\u0b82\u0baa\u0bcb\u0ba4\u0bb0\u0bbe\u0baf \u0ba8\u0bae\u0b83\n    \u0b93\u0b82 \u0bb6\u0bc2\u0bb0\u0bcd\u0baa\u0b95\u0bb0\u0bcd\u0ba3\u0bbe\u0baf \u0ba8\u0bae\u0b83\n    \u0b93\u0b82 \u0bb9\u0bb0\u0bbf\u0bb0\u0bcd\u0baa\u0bcd\u0bb0\u0bb9\u0bcd\u0bae\u0bb5\u0bbf\u0ba4\u0bc7 \u0ba8\u0bae\u0b83\n    \u0b93\u0b82 \u0b89\u0ba4\u0bcd\u0ba4\u0bae\u0bbe\u0baf \u0ba8\u0bae\u0b83\n    \u0b93\u0b82 \u0b95\u0bbe\u0bb2\u0bbe\u0baf \u0ba8\u0bae\u0b83\n    \u0b93\u0b82 \u0b95\u0bcd\u0bb0\u0bb9\u0baa\u0ba4\u0baf\u0bc7 \u0ba8\u0bae\u0b83\n    \u0b93\u0b82 \u0b95\u0bbe\u0bae\u0bbf\u0ba8\u0bc7 \u0ba8\u0bae\u0b83\n    \u0b93\u0b82 \u0bb8\u0bcb\u0bae\u0bb8\u0bc2\u0bb0\u0bcd\u0baf\u0bbe\u0b95\u0bcd\u0ba8\u0bbf\u0bb2\u0bcb\u0b9a\u0ba8\u0bbe\u0baf \u0ba8\u0bae\u0b83\n    \u0b93\u0b82 \u0baa\u0bbe\u0bb6\u0bbe\u0b82\u0b95\u0bc1\u0bb6\u0ba4\u0bb0\u0bbe\u0baf \u0ba8\u0bae\u0b83\n    \u0b93\u0b82 \u0b9a\u0b82\u0b9f\u0bbe\u0baf \u0ba8\u0bae\u0b83\n    \u0b93\u0b82 \u0b95\u0bc1\u0ba3\u0bbe\u0ba4\u0bc0\u0ba4\u0bbe\u0baf \u0ba8\u0bae\u0b83\n    \u0b93\u0b82 \u0ba8\u0bbf\u0bb0\u0b82\u0b9c\u0ba8\u0bbe\u0baf \u0ba8\u0bae\u0b83\n    \u0b93\u0b82 \u0b85\u0b95\u0bb2\u0bcd\u0bae\u0bb7\u0bbe\u0baf \u0ba8\u0bae\u0b83\n    \u0b93\u0b82 \u0bb8\u0bcd\u0bb5\u0baf\u0b82\u0bb8\u0bbf\u0ba4\u0bcd\u0ba4\u0bbe\u0baf \u0ba8\u0bae\u0b83\n    \u0b93\u0b82 \u0bb8\u0bbf\u0ba4\u0bcd\u0ba4\u0bbe\u0bb0\u0bcd\u0b9a\u0bbf\u0ba4 \u0baa\u0ba4\u0bbe\u0b82\u0baa\u0bc1\u0b9c\u0bbe\u0baf \u0ba8\u0bae\u0b83\n    \u0b93\u0b82 \u0baa\u0bc0\u0b9c\u0bbe\u0baa\u0bc2\u0bb0 \u0baa\u0bb2\u0bbe\u0bb8\u0b95\u0bcd\u0ba4\u0bbe\u0baf \u0ba8\u0bae\u0b83\n    \u0b93\u0b82 \u0bb5\u0bb0\u0ba4\u0bbe\u0baf \u0ba8\u0bae\u0b83\n    \u0b93\u0b82 \u0bb6\u0bbe\u0bb6\u0bcd\u0bb5\u0ba4\u0bbe\u0baf \u0ba8\u0bae\u0b83\n    \u0b93\u0b82 \u0b95\u0c43\u0ba4\u0bbf\u0ba8\u0bc7 \u0ba8\u0bae\u0b83\n    \u0b93\u0b82 \u0ba4\u0bcd\u0bb5\u0bbf\u0b9c\u0baa\u0bcd\u0bb0\u0bbf\u0baf\u0bbe\u0baf \u0ba8\u0bae\u0b83\n    \u0b93\u0b82 \u0bb5\u0bc0\u0ba4\u0baa\u0baf\u0bbe\u0baf \u0ba8\u0bae\u0b83\n    \u0b93\u0b82 \u0b95\u0ba4\u0bbf\u0ba8\u0bc7 \u0ba8\u0bae\u0b83\n    \u0b93\u0b82 \u0b9a\u0b95\u0bcd\u0bb0\u0bbf\u0ba3\u0bc7 \u0ba8\u0bae\u0b83\n    \u0b93\u0b82 \u0b87\u0b95\u0bcd\u0bb7\u0bc1\u0b9a\u0bbe\u0baa\u0ba4\u0c43\u0ba4\u0bc7 \u0ba8\u0bae\u0b83\n    \u0b93\u0b82 \u0bb6\u0bcd\u0bb0\u0bc0\u0ba4\u0bbe\u0baf\u0bbf\u0ba8\u0bc7 \u0ba8\u0bae\u0b83\n    \u0b93\u0b82 \u0b85\u0b9c\u0bbe\u0baf \u0ba8\u0bae\u0b83\n    \u0b93\u0b82 \u0b89\u0ba4\u0bcd\u0baa\u0bb2\u0b95\u0bb0\u0bbe\u0baf \u0ba8\u0bae\u0b83\n    \u0b93\u0b82 \u0bb6\u0bcd\u0bb0\u0bc0\u0baa\u0ba4\u0baf\u0bc7 \u0ba8\u0bae\u0b83\n    \u0b93\u0b82 \u0bb8\u0bcd\u0ba4\u0bc1\u0ba4\u0bbf\u0bb9\u0bb0\u0bcd\u0bb7\u0bbf\u0ba4\u0bbe\u0baf \u0ba8\u0bae\u0b83\n    \u0b93\u0b82 \u0b95\u0bc1\u0bb2\u0bbe\u0ba4\u0bcd\u0bb0\u0bbf\u0baa\u0bc7\u0ba4\u0bbf\u0ba8\u0bc7 \u0ba8\u0bae\u0b83\n    \u0b93\u0b82 \u0b9c\u0b9f\u0bbf\u0bb2\u0bbe\u0baf \u0ba8\u0bae\u0b83\n    \u0b93\u0b82 \u0b95\u0bb2\u0bbf\u0b95\u0bb2\u0bcd\u0bae\u0bb7\u0ba8\u0bbe\u0bb6\u0bbe\u0baf \u0ba8\u0bae\u0b83\n    \u0b93\u0b82 \u0b9a\u0b82\u0ba4\u0bcd\u0bb0\u0b9a\u0bc2\u0b9f\u0bbe\u0bae\u0ba3\u0baf\u0bc7 \u0ba8\u0bae\u0b83\n    \u0b93\u0b82 \u0b95\u0bbe\u0b82\u0ba4\u0bbe\u0baf \u0ba8\u0bae\u0b83\n    \u0b93\u0b82 \u0baa\u0bbe\u0baa\u0bb9\u0bbe\u0bb0\u0bbf\u0ba3\u0bc7 \u0ba8\u0bae\u0b83\n    \u0b93\u0b82 \u0bb8\u0bae\u0bbe\u0bb9\u0bbf\u0ba4\u0bbe\u0baf \u0ba8\u0bae\u0b83\n    \u0b93\u0b82 \u0b86\u0bb6\u0bcd\u0bb0\u0bbf\u0ba4\u0bb6\u0bcd\u0bb0\u0bc0\u0b95\u0bb0\u0bbe\u0baf \u0ba8\u0bae\u0b83\n    \u0b93\u0b82 \u0bb8\u0bcc\u0bae\u0bcd\u0baf\u0bbe\u0baf \u0ba8\u0bae\u0b83\n    \u0b93\u0b82 \u0baa\u0b95\u0bcd\u0ba4\u0bb5\u0bbe\u0b82\u0b9a\u0bbf\u0ba4\u0ba4\u0bbe\u0baf\u0b95\u0bbe\u0baf \u0ba8\u0bae\u0b83\n    \u0b93\u0b82 \u0bb6\u0bbe\u0b82\u0ba4\u0bbe\u0baf \u0ba8\u0bae\u0b83\n    \u0b93\u0b82 \u0b95\u0bc8\u0bb5\u0bb2\u0bcd\u0baf\u0bb8\u0bc1\u0b95\u0ba4\u0bbe\u0baf \u0ba8\u0bae\u0b83\n    \u0b93\u0b82 \u0bb8\u0b9a\u0bcd\u0b9a\u0bbf\u0ba4\u0bbe\u0ba8\u0b82\u0ba4 \u0bb5\u0bbf\u0b95\u0bcd\u0bb0\u0bb9\u0bbe\u0baf \u0ba8\u0bae\u0b83\n    \u0b93\u0b82 \u0b9c\u0bcd\u0b9e\u0bbe\u0ba8\u0bbf\u0ba8\u0bc7 \u0ba8\u0bae\u0b83\n    \u0b93\u0b82 \u0ba4\u0baf\u0bbe\u0baf\u0bc1\u0ba4\u0bbe\u0baf \u0ba8\u0bae\u0b83\n    \u0b93\u0b82 \u0ba4\u0bbe\u0b82\u0ba4\u0bbe\u0baf \u0ba8\u0bae\u0b83\n    \u0b93\u0b82 \u0baa\u0bcd\u0bb0\u0bb9\u0bcd\u0bae\u0ba3\u0bcd\u0baf\u0bbe\u0baf \u0ba8\u0bae\u0b83\n    \u0b93\u0b82 \u0ba4\u0bcd\u0bb5\u0bc7\u0bb7\u0bb5\u0bbf\u0bb5\u0bb0\u0bcd\u0b9c\u0bbf\u0ba4\u0bbe\u0baf \u0ba8\u0bae\u0b83\n    \u0b93\u0b82 \u0baa\u0bcd\u0bb0\u0bae\u0ba4\u0bcd\u0ba4\u0ba4\u0bc8\u0ba4\u0bcd\u0baf \u0baa\u0baf\u0ba4\u0bbe\u0baf \u0ba8\u0bae\u0b83\n    \u0b93\u0b82 \u0bb6\u0bcd\u0bb0\u0bc0\u0b95\u0b82\u0b9f\u0bbe\u0baf \u0ba8\u0bae\u0b83\n    \u0b93\u0b82 \u0bb5\u0bbf\u0baa\u0bc1\u0ba4\u0bc7\u0bb6\u0bcd\u0bb5\u0bb0\u0bbe\u0baf \u0ba8\u0bae\u0b83\n    \u0b93\u0b82 \u0bb0\u0bae\u0bbe\u0bb0\u0bcd\u0b9a\u0bbf\u0ba4\u0bbe\u0baf \u0ba8\u0bae\u0b83\n    \u0b93\u0b82 \u0bb5\u0bbf\u0ba4\u0baf\u0bc7 \u0ba8\u0bae\u0b83\n    \u0b93\u0b82 \u0ba8\u0bbe\u0b95\u0bb0\u0bbe\u0b9c \u0baf\u0b9c\u0bcd\u0b9e\u0bcb\u0baa\u0bb5\u0bc0\u0ba4\u0bbf\u0ba8\u0bc7 \u0ba8\u0bae\u0b83\n    \u0b93\u0b82 \u0bb8\u0bcd\u0ba4\u0bc2\u0bb2\u0b95\u0b82\u0b9f\u0bbe\u0baf \u0ba8\u0bae\u0b83\n    \u0b93\u0b82 \u0bb8\u0bcd\u0bb5\u0baf\u0b82\u0b95\u0bb0\u0bcd\u0ba4\u0bcd\u0bb0\u0bc7 \u0ba8\u0bae\u0b83\n    \u0b93\u0b82 \u0bb8\u0bbe\u0bae\u0b95\u0bcb\u0bb7\u0baa\u0bcd\u0bb0\u0bbf\u0baf\u0bbe\u0baf \u0ba8\u0bae\u0b83\n    \u0b93\u0b82 \u0baa\u0bb0\u0bbe\u0baf \u0ba8\u0bae\u0b83\n    \u0b93\u0b82 \u0bb8\u0bcd\u0ba4\u0bc2\u0bb2\u0ba4\u0bc1\u0b82\u0b9f\u0bbe\u0baf \u0ba8\u0bae\u0b83\n    \u0b93\u0b82 \u0b85\u0b95\u0bcd\u0bb0\u0ba3\u0bbf\u0ba8\u0bc7 \u0ba8\u0bae\u0b83\n    \u0b93\u0b82 \u0ba4\u0bc0\u0bb0\u0bbe\u0baf \u0ba8\u0bae\u0b83\n    \u0b93\u0b82 \u0bb5\u0bbe\u0b95\u0bc0\u0bb6\u0bbe\u0baf \u0ba8\u0bae\u0b83\n    \u0b93\u0b82 \u0bb8\u0bbf\u0ba4\u0bcd\u0ba4\u0bbf\u0ba4\u0bbe\u0baf\u0b95\u0bbe\u0baf \u0ba8\u0bae\u0b83\n    \u0b93\u0b82 \u0ba4\u0bc2\u0bb0\u0bcd\u0bb5\u0bbe\u0baa\u0bbf\u0bb2\u0bcd\u0bb5\u0baa\u0bcd\u0bb0\u0bbf\u0baf\u0bbe\u0baf \u0ba8\u0bae\u0b83\n    \u0b93\u0b82 \u0b85\u0bb5\u0bcd\u0baf\u0b95\u0bcd\u0ba4\u0bae\u0bc2\u0bb0\u0bcd\u0ba4\u0baf\u0bc7 \u0ba8\u0bae\u0b83\n    \u0b93\u0b82 \u0b85\u0ba4\u0bcd\u0baa\u0bc1\u0ba4\u0bae\u0bc2\u0bb0\u0bcd\u0ba4\u0baf\u0bc7 \u0ba8\u0bae\u0b83\n    \u0b93\u0b82 \u0bb6\u0bc8\u0bb2\u0bc7\u0b82\u0ba4\u0bcd\u0bb0\u0ba4\u0ba8\u0bc1\u0b9c\u0bcb\u0ba4\u0bcd\u0bb8\u0b82\u0b95\u0bbe\u0baf \u0ba8\u0bae\u0b83\n    \u0b93\u0b82 \u0b95\u0bc7\u0bb2\u0ba8\u0bcc\u0ba4\u0bcd\u0bb8\u0bc1\u0b95\u0bcd\u0baf\u0bae\u0bbe\u0ba8\u0bb8\u0bbe\u0baf \u0ba8\u0bae\u0b83\n    \u0b93\u0b82 \u0bb8\u0bcd\u0bb5\u0bb2\u0bbe\u0bb5\u0ba3\u0bcd\u0baf \u0bb8\u0bc1\u0ba4\u0bbe\u0bb8\u0bbe\u0bb0 \u0b9c\u0bbf\u0ba4\u0bae\u0ba8\u0bcd\u0bae\u0ba4 \u0bb5\u0bbf\u0b95\u0bcd\u0bb0\u0bb9\u0bbe\u0baf \u0ba8\u0bae\u0b83\n    \u0b93\u0b82 \u0bb8\u0bae\u0bb8\u0bcd\u0ba4 \u0b9c\u0b95\u0ba4\u0bbe\u0ba4\u0bbe\u0bb0\u0bbe\u0baf \u0ba8\u0bae\u0b83\n    \u0b93\u0b82 \u0bae\u0bbe\u0baf\u0bbe\u0bb5\u0bbf\u0ba8\u0bc7 \u0ba8\u0bae\u0b83\n    \u0b93\u0b82 \u0bae\u0bc2\u0bb7\u0bbf\u0b95 \u0bb5\u0bbe\u0bb9\u0ba8\u0bbe\u0baf \u0ba8\u0bae\u0b83\n    \u0b93\u0b82 \u0bb9\u0c43\u0bb7\u0bcd\u0b9f\u0bbe\u0baf \u0ba8\u0bae\u0b83\n    \u0b93\u0b82 \u0ba4\u0bc1\u0bb7\u0bcd\u0b9f\u0bbe\u0baf \u0ba8\u0bae\u0b83\n    \u0b93\u0b82 \u0baa\u0bcd\u0bb0\u0bb8\u0ba8\u0bcd\u0ba8\u0bbe\u0ba4\u0bcd\u0bae\u0ba8\u0bc7 \u0ba8\u0bae\u0b83\n    \u0b93\u0b82 \u0bb8\u0bb0\u0bcd\u0bb5\u0bb8\u0bbf\u0ba4\u0bcd\u0ba4\u0bbf\u0baa\u0bcd\u0bb0\u0ba4\u0bbe\u0baf\u0b95\u0bbe\u0baf \u0ba8\u0bae\u0b83",isAudio:!1,audioDurationSec:40,totalTime:"00:40"},{id:"11",slug:"sri-subramanya-ashtottara",title:"\u0bb8\u0bcd\u0bb0\u0bc0 \u0b9a\u0bc1\u0baa\u0bcd\u0baa\u0bbf\u0bb0\u0bae\u0ba3\u0bbf\u0baf\u0bc7\u0bb8\u0bcd\u0bb5\u0bb0\u0bb0\u0bcd",description:"[ \u0bb6\u0bcd\u0bb0\u0bc0 \u0bb8\u0bc1\u0baa\u0bcd\u0bb0\u0bb9\u0bcd\u0bae\u0ba3\u0bcd\u0baf\u0bc7\u0bb6\u0bcd\u0bb5\u0bb0 \u0bb8\u0bcd\u0bb5\u0bbe\u0bae\u0bbf \u0b85\u0b82\u0b95\u0baa\u0bc2\u0b9c ]\n    \u0b93\u0b82 \u0bb5\u0bbe\u0bb2\u0bcd\u0bae\u0bc0\u0b95\u0bbf \u0baa\u0bb5\u0bbe\u0baf \u0ba8\u0bae\u0b83 - \u0baa\u0bbe\u0ba4\u0bcc \u0baa\u0bc2\u0b9c\u0baf\u0bbe\u0bae\u0bbf\n    \u0b93\u0b82 \u0b9c\u0bbf\u0ba4\u0bbe\u0bb8\u0bc1\u0bb0\u0bbe\u0baf \u0ba8\u0bae\u0b83 - \u0b9c\u0bbe\u0ba8\u0bc1\u0ba8\u0bc0 \u0baa\u0bc2\u0b9c\u0baf\u0bbe\u0bae\u0bbf\n    \u0b93\u0b82 \u0bb0\u0bcc\u0ba4\u0bcd\u0bb0\u0bbe\u0baf \u0ba8\u0bae\u0b83 - \u0b9c\u0b82\u0b95\u0bc7 \u0baa\u0bc2\u0b9c\u0baf\u0bbe\u0bae\u0bbf\n    \u0b93\u0b82 \u0baa\u0baf\u0ba8\u0bbe\u0bb6\u0ba8\u0bbe\u0baf \u0ba8\u0bae\u0b83 - \u0b8a\u0bb0\u0bc2 \u0baa\u0bc2\u0b9c\u0baf\u0bbe\u0bae\u0bbf\n    \u0b93\u0b82 \u0baa\u0bbe\u0bb2\u0b95\u0bcd\u0bb0\u0bb9\u0bcb\u0b9a\u0bcd\u0b9a\u0bbe\u0b9f\u0ba8\u0bbe\u0baf \u0ba8\u0bae\u0b83 - \u0b95\u0b9f\u0bbf\u0b82 \u0baa\u0bc2\u0b9c\u0baf\u0bbe\u0bae\u0bbf\n    \u0b93\u0b82 \u0baa\u0b95\u0bcd\u0ba4\u0baa\u0bbe\u0bb2\u0ba8\u0bbe\u0baf \u0ba8\u0bae\u0b83 - \u0ba8\u0bbe\u0baa\u0bbf\u0b82 \u0baa\u0bc2\u0b9c\u0baf\u0bbe\u0bae\u0bbf\n    \u0b93\u0b82 \u0bb8\u0bb0\u0bcd\u0bb5\u0bbe\u0baa\u0bc0\u0bb7\u0bcd\u0b9f\u0baa\u0bcd\u0bb0\u0ba4\u0bbe\u0baf \u0ba8\u0bae\u0b83 - \u0bb9\u0c43\u0ba4\u0baf\u0b82 \u0baa\u0bc2\u0b9c\u0baf\u0bbe\u0bae\u0bbf\n    \u0b93\u0b82 \u0bb5\u0bbf\u0bb6\u0bbe\u0bb2\u0bb5\u0b95\u0bcd\u0bb7\u0bb8\u0bc7 \u0ba8\u0bae\u0b83 - \u0bb5\u0b95\u0bcd\u0bb7\u0b83\u0bb8\u0bcd\u0ba4\u0bb2\u0b82 \u0baa\u0bc2\u0b9c\u0baf\u0bbe\u0bae\u0bbf\n    \u0b93\u0b82 \u0b85\u0baa\u0baf\u0baa\u0bcd\u0bb0\u0ba4\u0bbe\u0ba8 \u0baa\u0bcd\u0bb0\u0bb6\u0bb8\u0bcd\u0ba4 \u0bb9\u0bb8\u0bcd\u0ba4\u0bbe\u0baf \u0ba8\u0bae\u0b83 - \u0baa\u0bbe\u0bb9\u0bc2\u0ba8\u0bcd \u0baa\u0bc2\u0b9c\u0baf\u0bbe\u0bae\u0bbf\n    \u0b93\u0b82 \u0ba8\u0bc0\u0bb2\u0b95\u0b82\u0b9f \u0ba4\u0ba8\u0baf\u0bbe\u0baf \u0ba8\u0bae\u0b83 - \u0b95\u0b82\u0b9f\u0b82 \u0baa\u0bc2\u0b9c\u0baf\u0bbe\u0bae\u0bbf\n    \u0b93\u0b82 \u0baa\u0ba4\u0bbf\u0ba4\u0baa\u0bbe\u0bb5\u0ba8\u0bbe\u0baf \u0ba8\u0bae\u0b83 - \u0b9a\u0bc1\u0baa\u0bc1\u0b95\u0b82 \u0baa\u0bc2\u0b9c\u0baf\u0bbe\u0bae\u0bbf\n    \u0b93\u0b82 \u0baa\u0bc1\u0bb0\u0bc1\u0bb7\u0bb6\u0bcd\u0bb0\u0bc7\u0bb7\u0bcd\u0b9f\u0bbe\u0baf \u0ba8\u0bae\u0b83 - \u0ba8\u0bbe\u0bb8\u0bbf\u0b95\u0bbe\u0b82 \u0baa\u0bc2\u0b9c\u0baf\u0bbe\u0bae\u0bbf\n    \u0b93\u0b82 \u0baa\u0bc1\u0ba3\u0bcd\u0baf\u0bae\u0bc2\u0bb0\u0bcd\u0ba4\u0baf\u0bc7 \u0ba8\u0bae\u0b83 - \u0bb6\u0bcd\u0bb0\u0bb5\u0ba3\u0bbe\u0ba8\u0bbf \u0baa\u0bc2\u0b9c\u0baf\u0bbe\u0bae\u0bbf\n    \u0b93\u0b82 \u0b95\u0bae\u0bb2\u0bb2\u0bcb\u0b9a\u0ba8\u0bbe\u0baf \u0ba8\u0bae\u0b83 - \u0ba8\u0bc7\u0ba4\u0bcd\u0bb0\u0bc7 \u0baa\u0bc2\u0b9c\u0baf\u0bbe\u0bae\u0bbf\n    \u0b93\u0b82 \u0b95\u0bb8\u0bcd\u0ba4\u0bc2\u0bb0\u0bc0 \u0ba4\u0bbf\u0bb2\u0b95\u0bbe\u0b82\u0b9a\u0bbf\u0ba4 \u0baa\u0bbe\u0bb2\u0ba8\u0bbe\u0baf \u0ba8\u0bae\u0b83 - \u0bb2\u0bb2\u0bbe\u0b9f\u0b82 \u0baa\u0bc2\u0b9c\u0baf\u0bbe\u0bae\u0bbf\n    \u0b93\u0b82 \u0bb5\u0bc7\u0ba4\u0bb5\u0bbf\u0ba4\u0bc1\u0bb7\u0bc7 \u0ba8\u0bae\u0b83 - \u0bae\u0bc1\u0b95\u0b82 \u0baa\u0bc2\u0b9c\u0baf\u0bbe\u0bae\u0bbf\n    \u0b93\u0b82 \u0ba4\u0bcd\u0bb0\u0bbf\u0bb2\u0bcb\u0b95\u0b95\u0bc1\u0bb0\u0bb5\u0bc7 \u0ba8\u0bae\u0b83 - \u0bb6\u0bbf\u0bb0\u0b83 \u0baa\u0bc2\u0b9c\u0baf\u0bbe\u0bae\u0bbf\n    \u0b93\u0b82 \u0baa\u0bb8\u0bcd\u0bae\u0bcb\u0ba4\u0bcd\u0ba4\u0bc2\u0bb3\u0bbf\u0ba4 \u0bb5\u0bbf\u0b95\u0bcd\u0bb0\u0bb9\u0bbe\u0baf \u0ba8\u0bae\u0b83 - \u0bb8\u0bb0\u0bcd\u0bb5\u0bbe\u0ba3\u0bcd\u0baf\u0b82\u0b95\u0bbe\u0ba8\u0bbf \u0baa\u0bc2\u0b9c\u0baf\u0bbe\u0bae\u0bbf\n    \n    [ \u0bb6\u0bcd\u0bb0\u0bc0 \u0bb8\u0bc1\u0baa\u0bcd\u0bb0\u0bb9\u0bcd\u0bae\u0ba3\u0bcd\u0baf \u0b85\u0bb7\u0bcd\u0b9f\u0bcb\u0ba4\u0bcd\u0ba4\u0bb0 \u0bb6\u0ba4 \u0ba8\u0bbe\u0bae\u0bbe\u0bb5\u0bb3\u0bbf ]\n    \u0b93\u0b82 \u0bb8\u0bcd\u0b95\u0b82\u0ba4\u0bbe\u0baf \u0ba8\u0bae\u0b83\n    \u0b93\u0b82 \u0b95\u0bc1\u0bb9\u0bbe\u0baf \u0ba8\u0bae\u0b83\n    \u0b93\u0b82 \u0bb7\u0ba3\u0bcd\u0bae\u0bc1\u0b95\u0bbe\u0baf \u0ba8\u0bae\u0b83\n    \u0b93\u0b82 \u0baa\u0bbe\u0bb2\u0ba8\u0bc7\u0ba4\u0bcd\u0bb0\u0bb8\u0bc1\u0ba4\u0bbe\u0baf \u0ba8\u0bae\u0b83\n    \u0b93\u0b82 \u0baa\u0bcd\u0bb0\u0baa\u0bb5\u0bc7 \u0ba8\u0bae\u0b83\n    \u0b93\u0b82 \u0baa\u0bbf\u0b82\u0b95\u0bb3\u0bbe\u0baf \u0ba8\u0bae\u0b83\n    \u0b93\u0b82 \u0b95\u0c43\u0ba4\u0bcd\u0ba4\u0bbf\u0b95\u0bbe\u0bb8\u0bc2\u0ba8\u0bb5\u0bc7 \u0ba8\u0bae\u0b83\n    \u0b93\u0b82 \u0bb6\u0bbf\u0b95\u0bbf\u0bb5\u0bbe\u0bb9\u0bbe\u0baf \u0ba8\u0bae\u0b83\n    \u0b93\u0b82 \u0ba4\u0bcd\u0bb5\u0bbf\u0bb7\u0b9f\u0bcd\u0baa\u0bc1\u0b9c\u0bbe\u0baf \u0ba8\u0bae\u0b83\n    \u0b93\u0b82 \u0ba4\u0bcd\u0bb5\u0bbf\u0bb7\u0ba3\u0bcd\u0ba3\u0bc7\u0ba4\u0bcd\u0bb0\u0bbe\u0baf \u0ba8\u0bae\u0b83\n    \u0b93\u0b82 \u0bb6\u0b95\u0bcd\u0ba4\u0bbf\u0ba4\u0bb0\u0bbe\u0baf \u0ba8\u0bae\u0b83\n    \u0b93\u0b82 \u0baa\u0bbf\u0bb6\u0bbf\u0ba4\u0bbe\u0bb6 \u0baa\u0bcd\u0bb0\u0baa\u0b82\u0b9c\u0ba8\u0bbe\u0baf \u0ba8\u0bae\u0b83\n    \u0b93\u0b82 \u0ba4\u0bbe\u0bb0\u0b95\u0bbe\u0bb8\u0bc1\u0bb0 \u0bb8\u0b82\u0bb9\u0bbe\u0bb0\u0bbf\u0ba3\u0bc7 \u0ba8\u0bae\u0b83\n    \u0b93\u0b82 \u0bb0\u0bbe\u0b95\u0bcd\u0bb7\u0bcb\u0baa\u0bb2 \u0bb5\u0bbf\u0bae\u0bb0\u0bcd\u0ba4\u0ba8\u0bbe\u0baf \u0ba8\u0bae\u0b83\n    \u0b93\u0b82 \u0bae\u0ba4\u0bcd\u0ba4\u0bbe\u0baf \u0ba8\u0bae\u0b83\n    \u0b93\u0b82 \u0baa\u0bcd\u0bb0\u0bae\u0ba4\u0bcd\u0ba4\u0bbe\u0baf \u0ba8\u0bae\u0b83\n    \u0b93\u0b82 \u0b89\u0ba8\u0bcd\u0bae\u0ba4\u0bcd\u0ba4\u0bbe\u0baf \u0ba8\u0bae\u0b83\n    \u0b93\u0b82 \u0bb8\u0bc1\u0bb0\u0bb8\u0bc8\u0ba8\u0bcd\u0baf \u0bb8\u0bc1\u0bb0\u0b95\u0bcd\u0bb7\u0b95\u0bbe\u0baf \u0ba8\u0bae\u0b83\n    \u0b93\u0b82 \u0ba4\u0bc7\u0bb5\u0bb8\u0bc7\u0ba8\u0bbe\u0baa\u0ba4\u0baf\u0bc7 \u0ba8\u0bae\u0b83\n    \u0b93\u0b82 \u0baa\u0bcd\u0bb0\u0bbe\u0b9c\u0bcd\u0b9e\u0bbe\u0baf \u0ba8\u0bae\u0b83\n    \u0b93\u0b82 \u0b95\u0c43\u0baa\u0bbe\u0bb2\u0bb5\u0bc7 \u0ba8\u0bae\u0b83\n    \u0b93\u0b82 \u0baa\u0b95\u0bcd\u0ba4\u0bb5\u0ba4\u0bcd\u0bb8\u0bb2\u0bbe\u0baf \u0ba8\u0bae\u0b83\n    \u0b93\u0b82 \u0b89\u0bae\u0bbe\u0bb8\u0bc1\u0ba4\u0bbe\u0baf \u0ba8\u0bae\u0b83\n    \u0b93\u0b82 \u0b95\u0bc1\u0bae\u0bbe\u0bb0\u0bbe\u0baf \u0ba8\u0bae\u0b83\n    \u0b93\u0b82 \u0b95\u0bcd\u0bb0\u0bcc\u0b82\u0b9a\u0ba4\u0bbe\u0bb0\u0ba3\u0bbe\u0baf \u0ba8\u0bae\u0b83\n    \u0b93\u0b82 \u0bb8\u0bc7\u0ba8\u0bbe\u0ba8\u0bcd\u0baf\u0bc7 \u0ba8\u0bae\u0b83\n    \u0b93\u0b82 \u0b85\u0b95\u0bcd\u0ba8\u0bbf\u0b9c\u0ba8\u0bcd\u0bae\u0ba8\u0bc7 \u0ba8\u0bae\u0b83\n    \u0b93\u0b82 \u0bb5\u0bbf\u0bb6\u0bbe\u0b95\u0bbe\u0baf \u0ba8\u0bae\u0b83\n    \u0b93\u0b82 \u0bb6\u0b82\u0b95\u0bb0\u0bbe\u0ba4\u0bcd\u0bae\u0b9c\u0bbe\u0baf \u0ba8\u0bae\u0b83\n    \u0b93\u0b82 \u0bb6\u0bbf\u0bb5\u0bb8\u0bc2\u0ba8\u0bb5\u0bc7 \u0ba8\u0bae\u0b83\n    \u0b93\u0b82 \u0b95\u0ba3\u0bb8\u0bcd\u0bb5\u0bbe\u0bae\u0bbf\u0ba8\u0bc7 \u0ba8\u0bae\u0b83\n    \u0b93\u0b82 \u0bb8\u0bb0\u0bcd\u0bb5\u0bb8\u0bcd\u0bb5\u0bbe\u0bae\u0bbf\u0ba8\u0bc7 \u0ba8\u0bae\u0b83\n    \u0b93\u0b82 \u0bb8\u0ba8\u0bbe\u0ba4\u0ba8\u0bbe\u0baf \u0ba8\u0bae\u0b83\n    \u0b93\u0b82 \u0b85\u0ba8\u0b82\u0ba4\u0bb6\u0b95\u0bcd\u0ba4\u0baf\u0bc7 \u0ba8\u0bae\u0b83\n    \u0b93\u0b82 \u0b85\u0b95\u0bcd\u0bb7\u0bcb\u0baa\u0bcd\u0baf\u0bbe\u0baf \u0ba8\u0bae\u0b83\n    \u0b93\u0b82 \u0baa\u0bbe\u0bb0\u0bcd\u0bb5\u0ba4\u0bc0\u0baa\u0bcd\u0bb0\u0bbf\u0baf\u0ba8\u0b82\u0ba4\u0ba8\u0bbe\u0baf \u0ba8\u0bae\u0b83\n    \u0b93\u0b82 \u0b95\u0b82\u0b95\u0bbe\u0bb8\u0bc1\u0ba4\u0bbe\u0baf \u0ba8\u0bae\u0b83\n    \u0b93\u0b82 \u0bb6\u0bb0\u0bcb\u0ba4\u0bcd\u0baa\u0bc2\u0ba4\u0bbe\u0baf \u0ba8\u0bae\u0b83\n    \u0b93\u0b82 \u0b86\u0bb9\u0bc2\u0ba4\u0bbe\u0baf \u0ba8\u0bae\u0b83\n    \u0b93\u0b82 \u0baa\u0bbe\u0bb5\u0b95\u0bbe\u0ba4\u0bcd\u0bae\u0b9c\u0bbe\u0baf \u0ba8\u0bae\u0b83\n    \u0b93\u0b82 \u0b9c\u0c43\u0b82\u0baa\u0bbe\u0baf \u0ba8\u0bae\u0b83\n    \u0b93\u0b82 \u0baa\u0bcd\u0bb0\u0b9c\u0c43\u0b82\u0baa\u0bbe\u0baf \u0ba8\u0bae\u0b83\n    \u0b93\u0b82 \u0b89\u0b9c\u0bcd\u0b9c\u0c43\u0b82\u0baa\u0bbe\u0baf \u0ba8\u0bae\u0b83\n    \u0b93\u0b82 \u0b95\u0bae\u0bb2\u0bbe\u0bb8\u0ba8 \u0bb8\u0b82\u0bb8\u0bcd\u0ba4\u0bc1\u0ba4\u0bbe\u0baf \u0ba8\u0bae\u0b83\n    \u0b93\u0b82 \u0b8f\u0b95\u0bb5\u0bb0\u0bcd\u0ba3\u0bbe\u0baf \u0ba8\u0bae\u0b83\n    \u0b93\u0b82 \u0ba4\u0bcd\u0bb5\u0bbf\u0bb5\u0bb0\u0bcd\u0ba3\u0bbe\u0baf \u0ba8\u0bae\u0b83\n    \u0b93\u0b82 \u0ba4\u0bcd\u0bb0\u0bbf\u0bb5\u0bb0\u0bcd\u0ba3\u0bbe\u0baf \u0ba8\u0bae\u0b83\n    \u0b93\u0b82 \u0bb8\u0bc1\u0bae\u0ba8\u0bcb\u0bb9\u0bb0\u0bbe\u0baf \u0ba8\u0bae\u0b83\n    \u0b93\u0b82 \u0b9a\u0ba4\u0bc1\u0bb0\u0bcd\u0bb5\u0bb0\u0bcd\u0ba3\u0bbe\u0baf \u0ba8\u0bae\u0b83\n    \u0b93\u0b82 \u0baa\u0b82\u0b9a\u0bb5\u0bb0\u0bcd\u0ba3\u0bbe\u0baf \u0ba8\u0bae\u0b83\n    \u0b93\u0b82 \u0baa\u0bcd\u0bb0\u0b9c\u0bbe\u0baa\u0ba4\u0baf\u0bc7 \u0ba8\u0bae\u0b83\n    \u0b93\u0b82 \u0b85\u0bb9\u0b82\u0baa\u0ba4\u0baf\u0bc7 \u0ba8\u0bae\u0b83\n    \u0b93\u0b82 \u0b85\u0b95\u0bcd\u0ba8\u0bbf\u0b95\u0bb0\u0bcd\u0baa\u0bbe\u0baf \u0ba8\u0bae\u0b83\n    \u0b93\u0b82 \u0bb6\u0bae\u0bc0\u0b95\u0bb0\u0bcd\u0baa\u0bbe\u0baf \u0ba8\u0bae\u0b83\n    \u0b93\u0b82 \u0bb5\u0bbf\u0bb6\u0bcd\u0bb5\u0bb0\u0bc7\u0ba4\u0bb8\u0bc7 \u0ba8\u0bae\u0b83\n    \u0b93\u0b82 \u0bb8\u0bc1\u0bb0\u0bbe\u0bb0\u0bbf\u0b95\u0bcd\u0ba8\u0bc7 \u0ba8\u0bae\u0b83\n    \u0b93\u0b82 \u0bb9\u0bb0\u0bbf\u0ba4\u0bcd\u0bb5\u0bb0\u0bcd\u0ba3\u0bbe\u0baf \u0ba8\u0bae\u0b83\n    \u0b93\u0b82 \u0bb6\u0bc1\u0baa\u0b95\u0bb0\u0bbe\u0baf \u0ba8\u0bae\u0b83\n    \u0b93\u0b82 \u0bb5\u0b9f\u0bb5\u0bc7 \u0ba8\u0bae\u0b83\n    \u0b93\u0b82 \u0bb5\u0b9f\u0bc1\u0bb5\u0bc7\u0bb7\u0baa\u0c43\u0ba4\u0bc7 \u0ba8\u0bae\u0b83\n    \u0b93\u0b82 \u0baa\u0bc2\u0bb7\u0bcd\u0ba3\u0bc7 \u0ba8\u0bae\u0b83\n    \u0b93\u0b82 \u0b95\u0baa\u0bb8\u0bcd\u0ba4\u0baf\u0bc7 \u0ba8\u0bae\u0b83\n    \u0b93\u0b82 \u0b95\u0bb9\u0ba8\u0bbe\u0baf \u0ba8\u0bae\u0b83\n    \u0b93\u0b82 \u0b9a\u0b82\u0ba4\u0bcd\u0bb0\u0bb5\u0bb0\u0bcd\u0ba3\u0bbe\u0baf \u0ba8\u0bae\u0b83\n    \u0b93\u0b82 \u0b95\u0bb2\u0bbe\u0ba4\u0bb0\u0bbe\u0baf \u0ba8\u0bae\u0b83\n    \u0b93\u0b82 \u0bae\u0bbe\u0baf\u0bbe\u0ba4\u0bb0\u0bbe\u0baf \u0ba8\u0bae\u0b83\n    \u0b93\u0b82 \u0b95\u0bc8\u0bb5\u0bb2\u0bcd\u0baf\u0bbe\u0baf \u0ba8\u0bae\u0b83\n    \u0b93\u0b82 \u0bb6\u0b82\u0b95\u0bb0\u0bbe\u0ba4\u0bcd\u0bae\u0ba8\u0bc7 \u0ba8\u0bae\u0b83\n    \u0b93\u0b82 \u0bb5\u0bbf\u0bb6\u0bcd\u0bb5\u0baf\u0bcb\u0ba8\u0baf\u0bc7 \u0ba8\u0bae\u0b83\n    \u0b93\u0b82 \u0b85\u0bae\u0bc7\u0baf\u0bbe\u0ba4\u0bcd\u0bae\u0ba8\u0bc7 \u0ba8\u0bae\u0b83\n    \u0b93\u0b82 \u0ba4\u0bc7\u0b9c\u0bcb\u0ba8\u0bbf\u0ba4\u0baf\u0bc7 \u0ba8\u0bae\u0b83\n    \u0b93\u0b82 \u0b85\u0ba8\u0bbe\u0bae\u0baf\u0bbe\u0baf \u0ba8\u0bae\u0b83\n    \u0b93\u0b82 \u0baa\u0bb0\u0bae\u0bc7\u0bb7\u0bcd\u0b9f\u0bbf\u0ba8\u0bc7 \u0ba8\u0bae\u0b83\n    \u0b93\u0b82 \u0baa\u0bb0\u0baa\u0bcd\u0bb0\u0bb9\u0bcd\u0bae\u0ba3\u0bc7 \u0ba8\u0bae\u0b83\n    \u0b93\u0b82 \u0bb5\u0bc7\u0ba4\u0b95\u0bb0\u0bcd\u0baa\u0bbe\u0baf \u0ba8\u0bae\u0b83\n    \u0b93\u0b82 \u0bb5\u0bbf\u0bb0\u0bbe\u0b9f\u0bcd\u0bb8\u0bc1\u0ba4\u0bbe\u0baf \u0ba8\u0bae\u0b83\n    \u0b93\u0b82 \u0baa\u0bc1\u0bb3\u0b82\u0ba4\u0b95\u0ba8\u0bcd\u0baf\u0bbe\u0baa\u0bb0\u0bcd\u0ba4\u0bcd\u0bb0\u0bc7 \u0ba8\u0bae\u0b83\n    \u0b93\u0b82 \u0bae\u0bb9\u0bbe\u0bb8\u0bbe\u0bb0\u0bb8\u0bcd\u0bb5\u0ba4\u0bb5\u0bcd\u0bb0\u0ba4\u0bbe\u0baf \u0ba8\u0bae\u0b83\n    \u0b93\u0b82 \u0b86\u0bb6\u0bcd\u0bb0\u0bbf\u0ba4\u0bbe\u0b95\u0bbf\u0bb2\u0ba4\u0bbe\u0ba4\u0bcd\u0bb0\u0bc7 \u0ba8\u0bae\u0b83\n    \u0b93\u0b82 \u0b9a\u0bcb\u0bb0\u0b95\u0bcd\u0ba8\u0bbe\u0baf \u0ba8\u0bae\u0b83\n    \u0b93\u0b82 \u0bb0\u0bcb\u0b95\u0ba8\u0bbe\u0bb6\u0ba8\u0bbe\u0baf \u0ba8\u0bae\u0b83\n    \u0b93\u0b82 \u0b85\u0ba8\u0b82\u0ba4\u0bae\u0bc2\u0bb0\u0bcd\u0ba4\u0baf\u0bc7 \u0ba8\u0bae\u0b83\n    \u0b93\u0b82 \u0b86\u0ba8\u0b82\u0ba4\u0bbe\u0baf \u0ba8\u0bae\u0b83\n    \u0b93\u0b82 \u0bb6\u0bbf\u0b95\u0b82\u0b9f\u0bbf\u0b95\u0c43\u0ba4\u0b95\u0bc7\u0ba4\u0ba8\u0bbe\u0baf \u0ba8\u0bae\u0b83\n    \u0b93\u0b82 \u0b9f\u0b82\u0baa\u0bbe\u0baf \u0ba8\u0bae\u0b83\n    \u0b93\u0b82 \u0baa\u0bb0\u0bae\u0b9f\u0b82\u0baa\u0bbe\u0baf \u0ba8\u0bae\u0b83\n    \u0b93\u0b82 \u0bae\u0bb9\u0bbe\u0b9f\u0b82\u0baa\u0bbe\u0baf \u0ba8\u0bae\u0b83\n    \u0b93\u0b82 \u0bb5\u0c43\u0bb7\u0bbe\u0b82\u0b95\u0baa\u0baf\u0bc7 \u0ba8\u0bae\u0b83\n    \u0b93\u0b82 \u0b95\u0bbe\u0bb0\u0ba3\u0bcb\u0baa\u0bbe\u0ba4\u0bcd\u0ba4\u0ba4\u0bc7\u0bb9\u0bbe\u0baf \u0ba8\u0bae\u0b83\n    \u0b93\u0b82 \u0b95\u0bbe\u0bb0\u0ba3\u0bbe\u0ba4\u0bc0\u0ba4\u0bb5\u0bbf\u0b95\u0bcd\u0bb0\u0bb9\u0bbe\u0baf \u0ba8\u0bae\u0b83\n    \u0b93\u0b82 \u0b85\u0ba8\u0bc0\u0bb6\u0bcd\u0bb5\u0bb0\u0bbe\u0baf \u0ba8\u0bae\u0b83\n    \u0b93\u0b82 \u0b85\u0bae\u0c43\u0ba4\u0bbe\u0baf \u0ba8\u0bae\u0b83\n    \u0b93\u0b82 \u0baa\u0bcd\u0bb0\u0bbe\u0ba3\u0bbe\u0baf \u0ba8\u0bae\u0b83\n    \u0b93\u0b82 \u0baa\u0bb0\u0bbe\u0baf\u0ba3\u0bbe\u0baf \u0ba8\u0bae\u0b83\n    \u0b93\u0b82 \u0bb5\u0bbf\u0bb0\u0bc1\u0ba4\u0bcd\u0ba4\u0bb9\u0b82\u0ba4\u0bcd\u0bb0\u0bc7 \u0ba8\u0bae\u0b83\n    \u0b93\u0b82 \u0bb5\u0bc0\u0bb0\u0b95\u0bcd\u0ba8\u0bbe\u0baf \u0ba8\u0bae\u0b83\n    \u0b93\u0b82 \u0bb0\u0b95\u0bcd\u0ba4\u0bbe\u0bb8\u0bcd\u0baf\u0bbe\u0baf \u0ba8\u0bae\u0b83\n    \u0b93\u0b82 \u0bb8\u0bc1\u0baa\u0bcd\u0bb0\u0bb9\u0bcd\u0bae\u0ba3\u0bcd\u0baf\u0bbe\u0baf \u0ba8\u0bae\u0b83\n    \u0b93\u0b82 \u0b95\u0bc1\u0bb9\u0bbe\u0baf \u0ba8\u0bae\u0b83\n    \u0b93\u0b82 \u0baa\u0bcd\u0bb0\u0bc0\u0ba4\u0bbe\u0baf \u0ba8\u0bae\u0b83\n    \u0b93\u0b82 \u0baa\u0bcd\u0bb0\u0bb9\u0bcd\u0bae\u0ba3\u0bcd\u0baf\u0bbe\u0baf \u0ba8\u0bae\u0b83\n    \u0b93\u0b82 \u0baa\u0bcd\u0bb0\u0bbe\u0bb9\u0bcd\u0bae\u0ba3\u0baa\u0bcd\u0bb0\u0bbf\u0baf\u0bbe\u0baf \u0ba8\u0bae\u0b83\n    \u0b93\u0b82 \u0bb5\u0b82\u0bb6\u0bb5\u0c43\u0ba4\u0bcd\u0ba4\u0bbf\u0b95\u0bb0\u0bbe\u0baf \u0ba8\u0bae\u0b83\n    \u0b93\u0b82 \u0bb5\u0bc7\u0ba4\u0bb5\u0bc7\u0ba4\u0bcd\u0baf\u0bbe\u0baf \u0ba8\u0bae\u0b83\n    \u0b93\u0b82 \u0b85\u0b95\u0bcd\u0bb7\u0baf\u0baa\u0bb2\u0baa\u0bcd\u0bb0\u0ba4\u0bbe\u0baf \u0ba8\u0bae\u0b83\n    \u0b93\u0b82 \u0bb8\u0bae\u0bb8\u0bcd\u0ba4\u0bb2\u0bcb\u0b95\u0bb8\u0ba4\u0bcd\u0b95\u0bc1\u0bb0\u0bb5\u0bc7 \u0ba8\u0bae\u0b83\n    \u0b93\u0b82 \u0b85\u0bb8\u0bc1\u0bb0\u0bbe\u0ba8\u0bc0\u0b95\u0bae\u0bb0\u0bcd\u0ba4\u0ba8\u0bbe\u0baf \u0ba8\u0bae\u0b83\n    \u0b93\u0b82 \u0bb5\u0bb2\u0bcd\u0bb2\u0bc0\u0ba4\u0bc7\u0bb5\u0bb8\u0bc7\u0ba8\u0bbe \u0bb8\u0bae\u0bc7\u0ba4 \u0bb6\u0bcd\u0bb0\u0bc0 \u0bb8\u0bc1\u0baa\u0bcd\u0bb0\u0bb9\u0bcd\u0bae\u0ba3\u0bcd\u0baf\u0bb8\u0bcd\u0bb5\u0bbe\u0bae\u0bbf\u0ba8\u0bc7 \u0ba8\u0bae\u0b83",isAudio:!1,audioDurationSec:40,totalTime:"00:40"},{id:"12",slug:"sri-ayyappa-ashtottara",title:"\u0bb8\u0bcd\u0bb0\u0bc0 \u0ba4\u0bb0\u0bcd\u0bae \u0b9a\u0bbe\u0bb8\u0bcd\u0ba4\u0bbe (\u0bb8\u0bcd\u0bb0\u0bc0 \u0b90\u0baf\u0baa\u0bcd\u0baa\u0ba9\u0bcd)",description:"[ \u0bb6\u0bcd\u0bb0\u0bc0 \u0b85\u0baf\u0bcd\u0baf\u0baa\u0bcd\u0baa \u0bb8\u0bcd\u0bb5\u0bbe\u0bae\u0bbf \u0b85\u0b82\u0b95\u0baa\u0bc2\u0b9c ]\n    \u0b93\u0b82 \u0ba4\u0bb0\u0bcd\u0bae\u0bb6\u0bbe\u0bb8\u0bcd\u0ba4\u0bcd\u0bb0\u0bc7 \u0ba8\u0bae\u0b83 - \u0baa\u0bbe\u0ba4\u0bcc \u0baa\u0bc2\u0b9c\u0baf\u0bbe\u0bae\u0bbf \u0964\n    \u0b93\u0b82 \u0bb6\u0bbf\u0bb2\u0bcd\u0baa\u0bb6\u0bbe\u0bb8\u0bcd\u0ba4\u0bcd\u0bb0\u0bc7 \u0ba8\u0bae\u0b83 - \u0b95\u0bc1\u0bb2\u0bcd\u0baa\u0bcc \u0baa\u0bc2\u0b9c\u0baf\u0bbe\u0bae\u0bbf \u0964\n    \u0b93\u0b82 \u0bb5\u0bc0\u0bb0\u0bb6\u0bbe\u0bb8\u0bcd\u0ba4\u0bcd\u0bb0\u0bc7 \u0ba8\u0bae\u0b83 - \u0b9c\u0b82\u0b95\u0bc7 \u0baa\u0bc2\u0b9c\u0baf\u0bbe\u0bae\u0bbf\n    \u0b93\u0b82 \u0baf\u0bcb\u0b95\u0bb6\u0bbe\u0bb8\u0bcd\u0ba4\u0bcd\u0bb0\u0bc7 \u0ba8\u0bae\u0b83 - \u0b9c\u0bbe\u0ba8\u0bc1\u0ba8\u0bc0 \u0baa\u0bc2\u0b9c\u0baf\u0bbe\u0bae\u0bbf\n    \u0b93\u0b82 \u0bae\u0bb9\u0bbe\u0bb6\u0bbe\u0bb8\u0bcd\u0ba4\u0bcd\u0bb0\u0bc7 \u0ba8\u0bae\u0b83 - \u0b8a\u0bb0\u0bc2 \u0baa\u0bc2\u0b9c\u0baf\u0bbe\u0bae\u0bbf\n    \u0b93\u0b82 \u0baa\u0bcd\u0bb0\u0bb9\u0bcd\u0bae\u0bb6\u0bbe\u0bb8\u0bcd\u0ba4\u0bcd\u0bb0\u0bc7 \u0ba8\u0bae\u0b83 - \u0b95\u0b9f\u0bbf\u0b82 \u0baa\u0bc2\u0b9c\u0baf\u0bbe\u0bae\u0bbf\n    \u0b93\u0b82 \u0b95\u0bbe\u0bb2\u0bb6\u0bbe\u0bb8\u0bcd\u0ba4\u0bcd\u0bb0\u0bc7 \u0ba8\u0bae\u0b83 - \u0b95\u0bc1\u0bb9\u0bcd\u0baf\u0b82 \u0baa\u0bc2\u0b9c\u0baf\u0bbe\u0bae\u0bbf\n    \u0b93\u0b82 \u0bb6\u0baa\u0bb0\u0bbf\u0b95\u0bbf\u0bb0\u0bc0\u0bb6\u0bbe\u0baf \u0ba8\u0bae\u0b83 - \u0bae\u0bc7\u0b9f\u0bcd\u0bb0\u0b82 \u0baa\u0bc2\u0b9c\u0baf\u0bbe\u0bae\u0bbf\n    \u0b93\u0b82 \u0bb8\u0ba4\u0bcd\u0baf\u0bb0\u0bc2\u0baa\u0bbe\u0baf \u0ba8\u0bae\u0b83 - \u0ba8\u0bbe\u0baa\u0bbf\u0b82 \u0baa\u0bc2\u0b9c\u0baf\u0bbe\u0bae\u0bbf\n    \u0b93\u0b82 \u0bae\u0ba3\u0bbf\u0b95\u0b82\u0b9f\u0bbe\u0baf \u0ba8\u0bae\u0b83 - \u0b89\u0ba4\u0bb0\u0b82 \u0baa\u0bc2\u0b9c\u0baf\u0bbe\u0bae\u0bbf\n    \u0b93\u0b82 \u0bb5\u0bbf\u0bb7\u0bcd\u0ba3\u0bc1 \u0ba4\u0ba8\u0baf\u0bbe\u0baf \u0ba8\u0bae\u0b83 - \u0bb5\u0b95\u0bcd\u0bb7\u0b83\u0bb8\u0bcd\u0ba4\u0bb2\u0b82 \u0baa\u0bc2\u0b9c\u0baf\u0bbe\u0bae\u0bbf\n    \u0b93\u0b82 \u0bb6\u0bbf\u0bb5\u0baa\u0bc1\u0ba4\u0bcd\u0bb0\u0bbe\u0baf \u0ba8\u0bae\u0b83 - \u0baa\u0bbe\u0bb0\u0bcd\u0bb6\u0bcd\u0bb5\u0bcc \u0baa\u0bc2\u0b9c\u0baf\u0bbe\u0bae\u0bbf \u0964\n    \u0b93\u0b82 \u0bb9\u0bb0\u0bbf\u0bb9\u0bb0 \u0baa\u0bc1\u0ba4\u0bcd\u0bb0\u0bbe\u0baf \u0ba8\u0bae\u0b83 - \u0bb9\u0c43\u0ba4\u0baf\u0b82 \u0baa\u0bc2\u0b9c\u0baf\u0bbe\u0bae\u0bbf\n    \u0b93\u0b82 \u0ba4\u0bcd\u0bb0\u0bbf\u0ba8\u0bc7\u0ba4\u0bcd\u0bb0\u0bbe\u0baf \u0ba8\u0bae\u0b83 - \u0b95\u0b82\u0b9f\u0b82 \u0baa\u0bc2\u0b9c\u0baf\u0bbe\u0bae\u0bbf\n    \u0b93\u0b82 \u0b93\u0b82\u0b95\u0bbe\u0bb0 \u0bb0\u0bc2\u0baa\u0bbe\u0baf \u0ba8\u0bae\u0b83 - \u0bb8\u0bcd\u0ba4\u0ba8\u0bcc \u0baa\u0bc2\u0b9c\u0baf\u0bbe\u0bae\u0bbf\n    \u0b93\u0b82 \u0bb5\u0bb0\u0ba4 \u0bb9\u0bb8\u0bcd\u0ba4\u0bbe\u0baf \u0ba8\u0bae\u0b83 - \u0bb9\u0bb8\u0bcd\u0ba4\u0bbe\u0ba8\u0bcd \u0baa\u0bc2\u0b9c\u0baf\u0bbe\u0bae\u0bbf\n    \u0b93\u0b82 \u0baa\u0bc0\u0bae\u0bbe\u0baf \u0ba8\u0bae\u0b83 - \u0baa\u0bbe\u0bb9\u0bc2\u0ba8\u0bcd \u0baa\u0bc2\u0b9c\u0baf\u0bbe\u0bae\u0bbf\n    \u0b93\u0b82 \u0ba4\u0bc7\u0b9c\u0bb8\u0bcd\u0bb5\u0bbf\u0ba8\u0bc7 \u0ba8\u0bae\u0b83 - \u0bae\u0bc1\u0b95\u0b82 \u0baa\u0bc2\u0b9c\u0baf\u0bbe\u0bae\u0bbf\n    \u0b93\u0b82 \u0b85\u0bb7\u0bcd\u0b9f\u0bae\u0bc2\u0bb0\u0bcd\u0ba4\u0baf\u0bc7 \u0ba8\u0bae\u0b83 - \u0ba4\u0b82\u0ba4\u0bcc \u0baa\u0bc2\u0b9c\u0baf\u0bbe\u0bae\u0bbf\n    \u0b93\u0b82 \u0bb6\u0bc1\u0baa\u0bb5\u0bc0\u0b95\u0bcd\u0bb7\u0ba3\u0bbe\u0baf \u0ba8\u0bae\u0b83 - \u0ba8\u0bc7\u0ba4\u0bcd\u0bb0\u0bcc \u0baa\u0bc2\u0b9c\u0baf\u0bbe\u0bae\u0bbf\n    \u0b93\u0b82 \u0b95\u0bcb\u0bae\u0bb2\u0bbe\u0b82\u0b95\u0bbe\u0baf \u0ba8\u0bae\u0b83 - \u0b95\u0bb0\u0bcd\u0ba3\u0b82 \u0baa\u0bc2\u0b9c\u0baf\u0bbe\u0bae\u0bbf\n    \u0b93\u0b82 \u0baa\u0bbe\u0baa \u0bb5\u0bbf\u0ba8\u0bbe\u0bb6\u0bbe\u0baf \u0ba8\u0bae\u0b83 - \u0bb2\u0bb2\u0bbe\u0b9f\u0b82 \u0baa\u0bc2\u0b9c\u0baf\u0bbe\u0bae\u0bbf\n    \u0b93\u0b82 \u0bb6\u0ba4\u0c43\u0ba8\u0bbe\u0bb6\u0bbe\u0baf \u0ba8\u0bae\u0b83 - \u0ba8\u0bbe\u0bb8\u0bbf\u0b95\u0bbe\u0b82 \u0baa\u0bc2\u0b9c\u0baf\u0bbe\u0bae\u0bbf\n    \u0b93\u0b82 \u0baa\u0bc1\u0ba4\u0bcd\u0bb0\u0bb2\u0bbe\u0baa\u0bbe\u0baf \u0ba8\u0bae\u0b83 - \u0b9a\u0bc1\u0baa\u0bc1\u0b95\u0b82 \u0baa\u0bc2\u0b9c\u0baf\u0bbe\u0bae\u0bbf\n    \u0b93\u0b82 \u0b95\u0b9c\u0bbe\u0ba4\u0bbf\u0baa\u0bbe\u0baf \u0ba8\u0bae\u0b83 - \u0b95\u0baa\u0bcb\u0bb2\u0bcc \u0baa\u0bc2\u0b9c\u0baf\u0bbe\u0bae\u0bbf\n    \u0b93\u0b82 \u0baa\u0bb0\u0bae\u0bbe\u0ba4\u0bcd\u0bae\u0ba8\u0bc7 \u0ba8\u0bae\u0b83 - \u0bb6\u0bbf\u0bb0\u0b83 \u0baa\u0bc2\u0b9c\u0baf\u0bbe\u0bae\u0bbf\n    \u0b93\u0b82 \u0bb8\u0bb0\u0bcd\u0bb5\u0bc7\u0bb6\u0bcd\u0bb5\u0bb0\u0bbe\u0baf \u0ba8\u0bae\u0b83 - \u0bb8\u0bb0\u0bcd\u0bb5\u0bbe\u0ba3\u0bcd\u0baf\u0b82\u0b95\u0bbe\u0ba8\u0bbf \u0baa\u0bc2\u0b9c\u0baf\u0bbe\u0bae\u0bbf\n    \n    [ \u0ba4\u0bcd\u0baf\u0bbe\u0ba8\u0bae\u0bcd ]\n    \u0b95\u0bb2\u0bcd\u0bb9\u0bbe\u0bb0\u0bcb\u0b9c\u0bcd\u0b9c\u0bcd\u0bb5\u0bb2 \u0ba8\u0bc0\u0bb2\u0b95\u0bc1\u0b82\u0ba4\u0bb2 \u0baa\u0bb0\u0b82 \u0b95\u0bbe\u0bb0\u0bc1\u0ba3\u0bcd\u0baf \u0bb0\u0ba4\u0bcd\u0ba8\u0bbe\u0b95\u0bb0\u0b82\n    \u0bb9\u0bc7\u0bae\u0bbe\u0b82\u0baa\u0bcb\u0bb0\u0bc1\u0bb9 \u0bb2\u0bcb\u0b9a\u0ba8\u0b82 \u0bb9\u0bb0\u0bbf\u0bb9\u0bb0 \u0baa\u0bcd\u0bb0\u0bc7\u0bae\u0bbe\u0bb8\u0bcd\u0baa\u0ba4\u0b82 \u0baa\u0bcd\u0bb0\u0bbe\u0b82\u0bb6\u0bc1\u0b95\u0bae\u0bcd \u0964\n    \u0baa\u0ba4\u0bcd\u0bae \u0b95\u0bcd\u0bb0\u0bcb\u0b9f \u0bb8\u0bc1\u0bb5\u0bb0\u0bcd\u0ba3 \u0bb0\u0ba4\u0bcd\u0ba8 \u0b95\u0b9f\u0bbf\u0ba4\u0b82 \u0b95\u0bc7\u0baf\u0bc2\u0bb0 \u0bb9\u0bbe\u0bb0\u0bbe\u0ba8\u0bcd\u0bb5\u0bbf\u0ba4\u0b82\n    \u0bb2\u0bcb\u0b95\u0bbe\u0bb0\u0bbe\u0ba4\u0bcd\u0baf \u0bae\u0ba4\u0bbe\u0bb0 \u0ba4\u0bb0\u0bcd\u0bae \u0ba8\u0bbf\u0bb2\u0baf\u0b82 \u0ba4\u0bcd\u0baf\u0bbe\u0baf\u0bc7\u0ba4\u0bcd\u0baa\u0bb5\u0bbe\u0ba8\u0bc0 \u0bb8\u0bc1\u0ba4\u0bae\u0bcd \u0965\n    \n    [ \u0bb6\u0bcd\u0bb0\u0bc0 \u0b85\u0baf\u0bcd\u0baf\u0baa\u0bcd\u0baa \u0b85\u0bb7\u0bcd\u0b9f\u0bcb\u0ba4\u0bcd\u0ba4\u0bb0 \u0bb6\u0ba4\u0ba8\u0bbe\u0bae\u0bbe\u0bb5\u0bb3\u0bbf ]\n    \u0b93\u0b82 \u0bae\u0bb9\u0bbe\u0bb6\u0bbe\u0bb8\u0bcd\u0ba4\u0bcd\u0bb0\u0bc7 \u0ba8\u0bae\u0b83 \u0964\n    \u0b93\u0b82 \u0bb5\u0bbf\u0bb6\u0bcd\u0bb5\u0bb6\u0bbe\u0bb8\u0bcd\u0ba4\u0bcd\u0bb0\u0bc7 \u0ba8\u0bae\u0b83 \u0964\n    \u0b93\u0b82 \u0bb2\u0bcb\u0b95\u0bb6\u0bbe\u0bb8\u0bcd\u0ba4\u0bcd\u0bb0\u0bc7 \u0ba8\u0bae\u0b83 \u0964\n    \u0b93\u0b82 \u0ba4\u0bb0\u0bcd\u0bae\u0bb6\u0bbe\u0bb8\u0bcd\u0ba4\u0bcd\u0bb0\u0bc7 \u0ba8\u0bae\u0b83 \u0964\n    \u0b93\u0b82 \u0bb5\u0bc7\u0ba4\u0bb6\u0bbe\u0bb8\u0bcd\u0ba4\u0bcd\u0bb0\u0bc7 \u0ba8\u0bae\u0b83 \u0964\n    \u0b93\u0b82 \u0b95\u0bbe\u0bb2\u0bb6\u0bbe\u0bb8\u0bcd\u0ba4\u0bcd\u0bb0\u0bc7 \u0ba8\u0bae\u0b83 \u0964\n    \u0b93\u0b82 \u0b95\u0b9c\u0bbe\u0bb0\u0bc2\u0b9f\u0bbe\u0baf \u0ba8\u0bae\u0b83 \u0964\n    \u0b93\u0b82 \u0b95\u0b9c\u0baa\u0ba4\u0baf\u0bc7 \u0ba8\u0bae\u0b83 \u0964\n    \u0b93\u0b82 \u0bb5\u0bcd\u0baf\u0bbe\u0b95\u0bcd\u0bb0\u0bbe\u0bb0\u0bc2\u0b9f\u0bbe\u0baf \u0ba8\u0bae\u0b83 \u0964\n    \u0b93\u0b82 \u0bae\u0bb9\u0bbe\u0ba4\u0bcd\u0baf\u0bc1\u0ba4\u0baf\u0bc7 \u0ba8\u0bae\u0b83 \u0964\n    \u0b93\u0b82 \u0b95\u0bcb\u0baa\u0ba4\u0bcd\u0bb0\u0bc7 \u0ba8\u0bae\u0b83 \u0964\n    \u0b93\u0b82 \u0bb5\u0bc0\u0bb0\u0baa\u0ba4\u0baf\u0bc7 \u0ba8\u0bae\u0b83 \u0964\n    \u0b93\u0b82 \u0bb8\u0bae\u0bbe\u0b95\u0bcd\u0baf\u0bbe\u0baf \u0ba8\u0bae\u0b83 \u0964\n    \u0b93\u0b82 \u0baa\u0b95\u0bcd\u0ba4\u0bb5\u0ba4\u0bcd\u0bb8\u0bb2\u0bbe\u0baf \u0ba8\u0bae\u0b83 \u0964\n    \u0b93\u0b82 \u0baa\u0bb0\u0baa\u0bcd\u0bb0\u0bb9\u0bcd\u0bae\u0ba3\u0bc7 \u0ba8\u0bae\u0b83 \u0964\n    \u0b93\u0b82 \u0b9c\u0bbf\u0bb7\u0bcd\u0ba3\u0bb5\u0bc7 \u0ba8\u0bae\u0b83 \u0964\n    \u0b93\u0b82 \u0ba4\u0bc7\u0b9c\u0bb8\u0bcd\u0bb5\u0bbf\u0ba8\u0bc7 \u0ba8\u0bae\u0b83 \u0964\n    \u0b93\u0b82 \u0baa\u0bc2\u0ba4\u0bbe\u0ba4\u0bbf\u0baa\u0ba4\u0baf\u0bc7 \u0ba8\u0bae\u0b83 \u0964\n    \u0b93\u0b82 \u0baa\u0bc2\u0ba4\u0ba4\u0bbe\u0ba4\u0bcd\u0bb0\u0bc7 \u0ba8\u0bae\u0b83 \u0964\n    \u0b93\u0b82 \u0baa\u0bc2\u0ba4\u0bc7\u0bb6\u0bbe\u0baf \u0ba8\u0bae\u0b83 \u0964\n    \u0b93\u0b82 \u0baa\u0bc0\u0bae\u0bb5\u0bbf\u0b95\u0bcd\u0bb0\u0bae\u0bbe\u0baf \u0ba8\u0bae\u0b83 \u0964\n    \u0b93\u0b82 \u0bb0\u0bae\u0bcd\u0baf\u0bbe\u0baf \u0ba8\u0bae\u0b83 \u0964\n    \u0b93\u0b82 \u0ba4\u0bcd\u0bb0\u0bbf\u0bb2\u0bcb\u0b95\u0bc7\u0bb6\u0bbe\u0baf \u0ba8\u0bae\u0b83 \u0964\n    \u0b93\u0b82 \u0ba4\u0bc7\u0bb5\u0bc7\u0bb6\u0bbe\u0baf \u0ba8\u0bae\u0b83 \u0964\n    \u0b93\u0b82 \u0baa\u0bc1\u0bb7\u0bcd\u0b95\u0bb2\u0bbe\u0baa\u0ba4\u0baf\u0bc7 \u0ba8\u0bae\u0b83 \u0964\n    \u0b93\u0b82 \u0baa\u0bb0\u0bbe\u0b95\u0bcd\u0bb0\u0bae\u0bbe\u0baf \u0ba8\u0bae\u0b83 \u0964\n    \u0b93\u0b82 \u0bb6\u0bb0\u0bbe\u0baf \u0ba8\u0bae\u0b83 \u0964\n    \u0b93\u0b82 \u0bb5\u0bb0\u0ba4\u0bbe\u0baf \u0ba8\u0bae\u0b83 \u0964\n    \u0b93\u0b82 \u0bb8\u0bc1\u0ba4\u0ba8\u0bcd\u0bb5\u0bbf\u0ba8\u0bc7 \u0ba8\u0bae\u0b83 \u0964\n    \u0b93\u0b82 \u0b95\u0bbe\u0bae\u0ba4\u0bbe\u0baf \u0ba8\u0bae\u0b83 \u0964\n    \u0b93\u0b82 \u0bb5\u0bbf\u0ba4\u0bcd\u0bb5\u0ba4\u0bcd\u0ba4\u0bae\u0bbe\u0baf \u0ba8\u0bae\u0b83 \u0964\n    \u0b93\u0b82 \u0b95\u0bbe\u0bb2\u0bb0\u0bc2\u0baa\u0bbf\u0ba3\u0bc7 \u0ba8\u0bae\u0b83 \u0964\n    \u0b93\u0b82 \u0ba4\u0bc0\u0bb0\u0bcd\u0b95\u0bbe\u0baf \u0ba8\u0bae\u0b83 \u0964\n    \u0b93\u0b82 \u0baa\u0bb9\u0bc1\u0bae\u0c43\u0b95\u0baa\u0bcd\u0bb0\u0bbf\u0baf\u0bbe\u0baf \u0ba8\u0bae\u0b83 \u0964\n    \u0b93\u0b82 \u0bb0\u0b95\u0bcd\u0bb7\u0bbe\u0b95\u0bb0\u0bbe\u0baf \u0ba8\u0bae\u0b83 \u0964\n    \u0b93\u0b82 \u0ba4\u0bc1\u0b83\u0b95\u0baa\u0b82\u0b9c\u0ba8\u0bbe\u0baf \u0ba8\u0bae\u0b83 \u0964\n    \u0b93\u0b82 \u0b95\u0baa\u0bbe\u0bb2\u0bbf\u0ba8\u0bc7 \u0ba8\u0bae\u0b83 \u0964\n    \u0b93\u0b82 \u0b95\u0bbe\u0baf\u0b95\u0bbe\u0baf \u0ba8\u0bae\u0b83 \u0964\n    \u0b93\u0b82 \u0b95\u0bbe\u0b82\u0ba4\u0bbe\u0baf \u0ba8\u0bae\u0b83 \u0964\n    \u0b93\u0b82 \u0b95\u0baa\u0bb0\u0bcd\u0ba4\u0bbf\u0ba8\u0bc7 \u0ba8\u0bae\u0b83 \u0964\n    \u0b93\u0b82 \u0b95\u0bbe\u0bb2\u0ba8\u0bbe\u0bb6\u0b95\u0bbe\u0baf \u0ba8\u0bae\u0b83 \u0964\n    \u0b93\u0b82 \u0b95\u0bc1\u0bb0\u0b82\u0b9f\u0b95\u0bbe\u0baf \u0ba8\u0bae\u0b83 \u0964\n    \u0b93\u0b82 \u0bb9\u0bb2\u0bbe\u0baf\u0bc1\u0ba4\u0bbe\u0baf \u0ba8\u0bae\u0b83 \u0964\n    \u0b93\u0b82 \u0ba4\u0bb0\u0bcd\u0bae\u0ba4\u0bbe\u0baf \u0ba8\u0bae\u0b83 \u0964\n    \u0b93\u0b82 \u0bb8\u0b82\u0bb8\u0bbe\u0bb0\u0bb8\u0bae\u0bc1\u0ba4\u0bcd\u0bb0\u0ba4\u0bbe\u0bb0\u0b95\u0bbe\u0baf \u0ba8\u0bae\u0b83 \u0964\n    \u0b93\u0b82 \u0bb5\u0bc0\u0bb0\u0bb5\u0bb2\u0bcd\u0bb2\u0baa\u0bbe\u0baf \u0ba8\u0bae\u0b83 \u0964\n    \u0b93\u0b82 \u0bb5\u0bbf\u0bb6\u0bcd\u0bb5\u0baa\u0bbe\u0bb2\u0b95\u0bbe\u0baf \u0ba8\u0bae\u0b83 \u0964\n    \u0b93\u0b82 \u0bb5\u0b9c\u0bcd\u0bb0\u0ba4\u0bb0\u0bbe\u0baf \u0ba8\u0bae\u0b83 \u0964\n    \u0b93\u0b82 \u0bb8\u0ba4\u0bcd\u0baf\u0bb8\u0bcd\u0bb5\u0bb0\u0bc2\u0baa\u0bbf\u0ba3\u0bc7 \u0ba8\u0bae\u0b83 \u0964\n    \u0b93\u0b82 \u0bb6\u0bc2\u0bb2\u0bbf\u0ba8\u0bc7 \u0ba8\u0bae\u0b83 \u0964\n    \u0b93\u0b82 \u0b95\u0b9f\u0bcd\u0b95\u0bbf\u0ba8\u0bc7 \u0ba8\u0bae\u0b83 \u0964\n    \u0b93\u0b82 \u0bb6\u0bbe\u0b82\u0ba4\u0bbf\u0ba4\u0bbe\u0baf\u0b95\u0bbe\u0baf \u0ba8\u0bae\u0b83 \u0964\n    \u0b93\u0b82 \u0bb8\u0bc1\u0b95\u0b82\u0ba4\u0bbf\u0ba8\u0bc7 \u0ba8\u0bae\u0b83 \u0964\n    \u0b93\u0b82 \u0b95\u0b82\u0ba4\u0bae\u0bbe\u0bb2\u0bcd\u0baf\u0bbe\u0b82\u0baa\u0bb0\u0ba4\u0bb0\u0bbe\u0baf \u0ba8\u0bae\u0b83 \u0964\n    \u0b93\u0b82 \u0ba8\u0bbe\u0ba8\u0bbe\u0bb6\u0bbe\u0bb8\u0bcd\u0ba4\u0bcd\u0bb0\u0bbe\u0bb0\u0bcd\u0ba4\u0ba4\u0ba4\u0bcd\u0bb5\u0b9c\u0bcd\u0b9e\u0bbe\u0baf \u0ba8\u0bae\u0b83 \u0964\n    \u0b93\u0b82 \u0ba8\u0bbe\u0ba4\u0bb0\u0bc2\u0baa\u0bbf\u0ba3\u0bc7 \u0ba8\u0bae\u0b83 \u0964\n    \u0b93\u0b82 \u0b85\u0bae\u0bc7\u0baf\u0bbe\u0baf \u0ba8\u0bae\u0b83 \u0964\n    \u0b93\u0b82 \u0bb8\u0bb0\u0bcd\u0bb5\u0bbe\u0baa\u0bc0\u0bb7\u0bcd\u0b9f\u0baa\u0bcd\u0bb0\u0ba4\u0bbe\u0baf\u0b95\u0bbe\u0baf \u0ba8\u0bae\u0b83 \u0964\n    \u0b93\u0b82 \u0b95\u0bbf\u0bb0\u0bc0\u0b9f\u0bbf\u0ba8\u0bc7 \u0ba8\u0bae\u0b83 \u0964\n    \u0b93\u0b82 \u0bb6\u0bb0\u0bb8\u0b82\u0bb9\u0bb0\u0bcd\u0ba4\u0bcd\u0bb0\u0bc7 \u0ba8\u0bae\u0b83 \u0964\n    \u0b93\u0b82 \u0b95\u0bbe\u0bae\u0bb0\u0bc2\u0baa\u0bbe\u0baf \u0ba8\u0bae\u0b83 \u0964\n    \u0b93\u0b82 \u0bae\u0bb9\u0bbe\u0bae\u0ba4\u0baf\u0bc7 \u0ba8\u0bae\u0b83 \u0964\n    \u0b93\u0b82 \u0baa\u0bc1\u0bb7\u0bcd\u0baa\u0baa\u0bbe\u0ba3\u0bbe\u0baf \u0ba8\u0bae\u0b83 \u0964\n    \u0b93\u0b82 \u0bae\u0bb9\u0bbe\u0b95\u0bbe\u0baf\u0bbe\u0baf \u0ba8\u0bae\u0b83 \u0964\n    \u0b93\u0b82 \u0b9c\u0b9f\u0bbe\u0bb5\u0bb2\u0bcd\u0b95\u0bb2\u0ba4\u0bbe\u0bb0\u0bbf\u0ba3\u0bc7 \u0ba8\u0bae\u0b83 \u0964\n    \u0b93\u0b82 \u0b85\u0baa\u0baf\u0baa\u0bcd\u0bb0\u0ba4\u0bbe\u0baf \u0ba8\u0bae\u0b83 \u0964\n    \u0b93\u0b82 \u0ba8\u0bbe\u0ba8\u0bbe\u0bae\u0bbe\u0bb2\u0bcd\u0baf\u0bbe\u0ba8\u0bc1\u0bb2\u0bc7\u0baa\u0ba8\u0bbe\u0baf \u0ba8\u0bae\u0b83 \u0964\n    \u0b93\u0b82 \u0bae\u0bbe\u0baf\u0bbe\u0ba4\u0bb0\u0bbe\u0baf \u0ba8\u0bae\u0b83 \u0964\n    \u0b93\u0b82 \u0bae\u0bb9\u0bbe\u0ba4\u0bc7\u0bb5\u0bbe\u0baf \u0ba8\u0bae\u0b83 \u0964\n    \u0b93\u0b82 \u0bb8\u0bb0\u0bcd\u0bb5\u0bb8\u0bbe\u0b95\u0bcd\u0bb7\u0bbf\u0ba3\u0bc7 \u0ba8\u0bae\u0b83 \u0964\n    \u0b93\u0b82 \u0bae\u0b82\u0b95\u0bb3\u0baa\u0bcd\u0bb0\u0ba4\u0bbe\u0baf \u0ba8\u0bae\u0b83 \u0964\n    \u0b93\u0b82 \u0bae\u0ba4\u0bcd\u0bb8\u0bcd\u0baf\u0bb0\u0bc2\u0baa\u0bbf\u0ba3\u0bc7 \u0ba8\u0bae\u0b83 \u0964\n    \u0b93\u0b82 \u0b95\u0bc1\u0bb0\u0bc1\u0b95\u0bcd\u0bb7\u0bc7\u0ba4\u0bcd\u0bb0\u0baa\u0bbe\u0bb2\u0b95\u0bbe\u0baf \u0ba8\u0bae\u0b83 \u0964\n    \u0b93\u0b82 \u0bb8\u0bc1\u0baa\u0bcd\u0bb0\u0bb8\u0ba8\u0bcd\u0ba8\u0bbe\u0baf \u0ba8\u0bae\u0b83 \u0964\n    \u0b93\u0b82 \u0bb5\u0bbf\u0bb0\u0bc2\u0baa\u0bbe\u0b95\u0bcd\u0bb7\u0bbe\u0baf \u0ba8\u0bae\u0b83 \u0964\n    \u0b93\u0b82 \u0baa\u0bc0\u0ba4\u0bbf\u0bb9\u0bbe\u0ba8\u0bc7 \u0ba8\u0bae\u0b83 \u0964\n    \u0b93\u0b82 \u0bb6\u0bcd\u0bb0\u0bc0\u0baa\u0bcd\u0bb0\u0ba4\u0bbe\u0baf \u0ba8\u0bae\u0b83 \u0964\n    \u0b93\u0b82 \u0ba4\u0bbe\u0ba8\u0bb5\u0ba8\u0bbe\u0bb6\u0b95\u0bbe\u0baf \u0ba8\u0bae\u0b83 \u0964\n    \u0b93\u0b82 \u0bb6\u0b82\u0b95\u0bb0\u0bbe\u0baf \u0ba8\u0bae\u0b83 \u0964\n    \u0b93\u0b82 \u0bb6\u0bc2\u0bb2\u0bb9\u0bb8\u0bcd\u0ba4\u0bbe\u0baf \u0ba8\u0bae\u0b83 \u0964\n    \u0b93\u0b82 \u0baa\u0bbf\u0ba8\u0bbe\u0b95\u0bbf\u0ba8\u0bc7 \u0ba8\u0bae\u0b83 \u0964\n    \u0b93\u0b82 \u0bb5\u0bc7\u0ba4\u0bbe\u0b82\u0ba4\u0bb5\u0bc7\u0ba4\u0bcd\u0baf\u0bbe\u0baf \u0ba8\u0bae\u0b83 \u0964\n    \u0b93\u0b82 \u0bb5\u0bbf\u0bb6\u0bcd\u0bb5\u0bb0\u0bc2\u0baa\u0bbe\u0baf \u0ba8\u0bae\u0b83 \u0964\n    \u0b93\u0b82 \u0bb8\u0bb0\u0bcd\u0bb5\u0bb2\u0bcb\u0b95\u0bb9\u0bbf\u0ba4\u0bc8\u0bb7\u0bbf\u0ba3\u0bc7 \u0ba8\u0bae\u0b83 \u0964\n    \u0b93\u0b82 \u0baa\u0bcd\u0bb0\u0bb8\u0ba8\u0bcd\u0ba8\u0bae\u0bc2\u0bb0\u0bcd\u0ba4\u0baf\u0bc7 \u0ba8\u0bae\u0b83 \u0964\n    \u0b93\u0b82 \u0baa\u0b95\u0bcd\u0ba4\u0bb5\u0bb6\u0bcd\u0baf\u0bbe\u0baf \u0ba8\u0bae\u0b83 \u0964\n    \u0b93\u0b82 \u0bb6\u0bc1\u0baa\u0b95\u0bb0\u0bbe\u0baf \u0ba8\u0bae\u0b83 \u0964\n    \u0b93\u0b82 \u0b85\u0b95\u0bcd\u0bb7\u0bcb\u0baa\u0bcd\u0baf\u0bbe\u0baf \u0ba8\u0bae\u0b83 \u0964\n    \u0b93\u0b82 \u0b95\u0bc8\u0bb5\u0bb2\u0bcd\u0baf\u0ba4\u0bbe\u0baf \u0ba8\u0bae\u0b83 \u0964\n    \u0b93\u0b82 \u0ba4\u0bbe\u0bb0\u0b95\u0bbe\u0baf \u0ba8\u0bae\u0b83 \u0964\n    \u0b93\u0b82 \u0baa\u0bb0\u0bae\u0bbe\u0ba4\u0bcd\u0bae\u0ba8\u0bc7 \u0ba8\u0bae\u0b83 \u0964\n    \u0b93\u0b82 \u0b95\u0bbf\u0bb0\u0bc0\u0bb6\u0bbe\u0baf \u0ba8\u0bae\u0b83 \u0964\n    \u0b93\u0b82 \u0baa\u0b95\u0bcd\u0ba4\u0baa\u0bcb\u0bb7\u0b95\u0bbe\u0baf \u0ba8\u0bae\u0b83 \u0964\n    \u0b93\u0b82 \u0b85\u0bae\u0c43\u0ba4\u0bc7\u0bb6\u0bbe\u0baf \u0ba8\u0bae\u0b83 \u0964\n    \u0b93\u0b82 \u0b9c\u0b95\u0ba4\u0bcd\u0bb5\u0bcd\u0baf\u0bbe\u0baa\u0bbf\u0ba8\u0bc7 \u0ba8\u0bae\u0b83 \u0964\n    \u0b93\u0b82 \u0baa\u0bc1\u0ba3\u0bcd\u0baf\u0bae\u0bc2\u0bb0\u0bcd\u0ba4\u0baf\u0bc7 \u0ba8\u0bae\u0b83 \u0964\n    \u0b93\u0b82 \u0bb8\u0b9a\u0bcd\u0b9a\u0bbf\u0ba4\u0bbe\u0ba8\u0b82\u0ba4\u0bb5\u0bbf\u0b95\u0bcd\u0bb0\u0bb9\u0bbe\u0baf \u0ba8\u0bae\u0b83 \u0964\n    \u0b93\u0b82 \u0bae\u0ba3\u0bbf\u0b95\u0b82\u0b9f\u0bbe\u0baf \u0ba8\u0bae\u0b83 \u0964\n    \u0b93\u0b82 \u0bb9\u0bb0\u0bbf\u0bb9\u0bb0\u0baa\u0bc1\u0ba4\u0bcd\u0bb0\u0bbe\u0baf \u0ba8\u0bae\u0b83 \u0964\n    \u0b93\u0b82 \u0bb6\u0baa\u0bb0\u0bc0\u0b95\u0bbf\u0bb0\u0bc0\u0bb6\u0bbe\u0baf \u0ba8\u0bae\u0b83 \u0964\n    \u0b93\u0b82 \u0bb6\u0bbe\u0bb6\u0bcd\u0bb5\u0ba4\u0bbe\u0baf \u0ba8\u0bae\u0b83 \u0964\n    \u0b93\u0b82 \u0bae\u0bcb\u0b95\u0bcd\u0bb7\u0baa\u0bcd\u0bb0\u0ba4\u0bbe\u0baf\u0b95\u0bbe\u0baf \u0ba8\u0bae\u0b83 \u0964\n    \u0b93\u0b82 \u0bb2\u0bcb\u0b95\u0baa\u0bc2\u0b9c\u0bcd\u0baf\u0bbe\u0baf \u0ba8\u0bae\u0b83 \u0964\n    \u0b93\u0b82 \u0ba4\u0bb0\u0bcd\u0bae\u0baa\u0bbe\u0bb2\u0b95\u0bbe\u0baf \u0ba8\u0bae\u0b83 \u0964\n    \u0b93\u0b82 \u0bb8\u0bb0\u0bcd\u0bb5\u0bb8\u0bbf\u0ba4\u0bcd\u0ba4\u0bbf\u0baa\u0bcd\u0bb0\u0ba4\u0bbe\u0baf\u0b95\u0bbe\u0baf \u0ba8\u0bae\u0b83 \u0964\n    \u0b93\u0b82 \u0b86\u0ba8\u0b82\u0ba4\u0ba4\u0bbe\u0baf \u0ba8\u0bae\u0b83 \u0964\n    \u0b93\u0b82 \u0baa\u0b95\u0bb5\u0ba4\u0bc7 \u0ba8\u0bae\u0b83 \u0964\n    \u0b93\u0b82 \u0bb6\u0bcd\u0bb0\u0bc0 \u0bb9\u0bb0\u0bbf\u0bb9\u0bb0\u0baa\u0bc1\u0ba4\u0bcd\u0bb0 \u0bb8\u0bcd\u0bb5\u0bbe\u0bae\u0bbf\u0ba8\u0bc7 \u0ba8\u0bae\u0b83 \u0964",isAudio:!1,audioDurationSec:40,totalTime:"00:40"},{id:"13",slug:"sri-devi-pooja",title:"\u0bb8\u0bcd\u0bb0\u0bc0 \u0ba4\u0bc7\u0bb5\u0bbf \u0baa\u0bc2\u0b9c\u0bc8",description:"[ \u0bb6\u0bcd\u0bb0\u0bc0 \u0ba4\u0bc7\u0bb5\u0bbf \u0baa\u0bc2\u0b9c - \u0bae\u0bbe\u0bb3\u0bbf\u0b95\u0bbe\u0baa\u0bc1\u0bb0\u0ba4\u0bcd\u0ba4\u0bae\u0bcd\u0bae & \u0bb8\u0bb0\u0bcd\u0bb5\u0bae\u0b82\u0b95\u0bb3 \u0baa\u0bc2\u0b9c ]\n    \n    \u0bb6\u0baa\u0bb0\u0bbf\u0bae\u0bb2\u0bb2\u0bcb \u0b95\u0bca\u0bb2\u0bc1\u0bb5\u0bc8\u0ba8 \u0bb6\u0bcd\u0bb0\u0bc0 \u0bae\u0bbe\u0bb3\u0bbf\u0b95\u0bbe\u0baa\u0bc1\u0bb0\u0ba4\u0bcd\u0ba4\u0bae\u0bcd\u0bae (\u0bb6\u0bcd\u0bb0\u0bc0 \u0baa\u0b95\u0bb5\u0ba4\u0bc0 \u0ba4\u0bc7\u0bb5\u0bbf) \u0bb8\u0bae\u0bb8\u0bcd\u0ba4 \u0baa\u0b95\u0bcd\u0ba4\u0bc1\u0bb2 \u0b95\u0bcb\u0bb0\u0bbf\u0b95\u0bb2\u0bc1 \u0ba4\u0bc0\u0bb0\u0bcd\u0b9a\u0bc7 \u0b95\u0bb2\u0bcd\u0baa\u0bb5\u0bb2\u0bcd\u0bb2\u0bbf.\n    \n    [ \u0ba4\u0bcd\u0baf\u0bbe\u0ba8\u0b82 ]\n    \u0bb8\u0bb0\u0bcd\u0bb5\u0bae\u0b82\u0b95\u0bb3 \u0bae\u0bbe\u0b82\u0b95\u0bb2\u0bcd\u0baf\u0bc7 \u0bb6\u0bbf\u0bb5\u0bc7 \u0bb8\u0bb0\u0bcd\u0bb5\u0bbe\u0bb0\u0bcd\u0ba4 \u0bb8\u0bbe\u0ba4\u0bbf\u0b95\u0bc7\n    \u0bb6\u0bb0\u0ba3\u0bcd\u0baf\u0bc7 \u0ba4\u0bcd\u0bb0\u0bcd\u0baf\u0b82\u0baa\u0b95\u0bc7 \u0b95\u0bcc\u0bb0\u0bc0 \u0ba8\u0bbe\u0bb0\u0bbe\u0baf\u0ba3\u0bbf \u0ba8\u0bae\u0bcb\u0bb8\u0bcd\u0ba4\u0bc1\u0ba4\u0bc7\n    \n    \u0baf\u0bbe \u0ba4\u0bc7\u0bb5\u0bc0 \u0bb8\u0bb0\u0bcd\u0bb5\u0baa\u0bc2\u0ba4\u0bc7\u0bb7\u0bc1 \u0bae\u0bbe\u0ba4\u0c43 \u0bb0\u0bc2\u0baa\u0bc7\u0ba3 \u0bb8\u0b82\u0bb8\u0bcd\u0ba4\u0bbf\u0ba4\u0bbe\n    \u0ba8\u0bae\u0bb8\u0bcd\u0ba4\u0bb8\u0bcd\u0baf\u0bc8 \u0ba8\u0bae\u0bb8\u0bcd\u0ba4\u0bb8\u0bcd\u0baf\u0bc8 \u0ba8\u0bae\u0bb8\u0bcd\u0ba4\u0bb8\u0bcd\u0baf\u0bc8 \u0ba8\u0bae\u0bcb \u0ba8\u0bae\u0b83\n    \n    [ \u0bb6\u0bcd\u0bb0\u0bc0 \u0ba4\u0bc7\u0bb5\u0bbf \u0b85\u0bb7\u0bcd\u0b9f\u0bcb\u0ba4\u0bcd\u0ba4\u0bb0 \u0bb6\u0ba4 \u0ba8\u0bbe\u0bae\u0bbe\u0bb5\u0bb3\u0bbf\u0b83 (\u0b95\u0bca\u0ba8\u0bcd\u0ba8\u0bbf \u0bae\u0bc1\u0b95\u0bcd\u0baf \u0ba8\u0bbe\u0bae\u0bae\u0bc1\u0bb2\u0bc1) ]\n    \u0b93\u0b82 \u0baa\u0bcd\u0bb0\u0b95\u0c43\u0ba4\u0bcd\u0baf\u0bc8 \u0ba8\u0bae\u0b83\n    \u0b93\u0b82 \u0bb5\u0bbf\u0b95\u0c43\u0ba4\u0bcd\u0baf\u0bc8 \u0ba8\u0bae\u0b83\n    \u0b93\u0b82 \u0bb5\u0bbf\u0ba4\u0bcd\u0baf\u0bbe\u0baf\u0bc8 \u0ba8\u0bae\u0b83\n    \u0b93\u0b82 \u0bb8\u0bb0\u0bcd\u0bb5\u0baa\u0bc2\u0ba4\u0bb9\u0bbf\u0ba4\u0baa\u0bcd\u0bb0\u0ba4\u0bbe\u0baf\u0bc8 \u0ba8\u0bae\u0b83\n    \u0b93\u0b82 \u0bb6\u0bcd\u0bb0\u0ba4\u0bcd\u0ba4\u0bbe\u0baf\u0bc8 \u0ba8\u0bae\u0b83\n    \u0b93\u0b82 \u0bb5\u0bbf\u0baa\u0bc2\u0ba4\u0bcd\u0baf\u0bc8 \u0ba8\u0bae\u0b83\n    \u0b93\u0b82 \u0bb8\u0bc1\u0bb0\u0baa\u0bcd\u0baf\u0bc8 \u0ba8\u0bae\u0b83\n    \u0b93\u0b82 \u0baa\u0bb0\u0bae\u0bbe\u0ba4\u0bcd\u0bae\u0bbf\u0b95\u0bbe\u0baf\u0bc8 \u0ba8\u0bae\u0b83\n    \u0b93\u0b82 \u0baa\u0ba4\u0bcd\u0bae\u0bbe\u0bb2\u0baf\u0bbe\u0baf\u0bc8 \u0ba8\u0bae\u0b83\n    \u0b93\u0b82 \u0baa\u0ba4\u0bcd\u0bae\u0bbe\u0baf\u0bc8 \u0ba8\u0bae\u0b83\n    \u0b93\u0b82 \u0bb6\u0bc1\u0b9a\u0baf\u0bc7 \u0ba8\u0bae\u0b83\n    \u0b93\u0b82 \u0bb8\u0bcd\u0bb5\u0bbe\u0bb9\u0bbe\u0baf\u0bc8 \u0ba8\u0bae\u0b83\n    \u0b93\u0b82 \u0bb8\u0bcd\u0bb5\u0ba4\u0bbe\u0baf\u0bc8 \u0ba8\u0bae\u0b83\n    \u0b93\u0b82 \u0bb8\u0bc1\u0ba4\u0bbe\u0baf\u0bc8 \u0ba8\u0bae\u0b83\n    \u0b93\u0b82 \u0ba4\u0ba8\u0bcd\u0baf\u0bbe\u0baf\u0bc8 \u0ba8\u0bae\u0b83\n    \u0b93\u0b82 \u0bb9\u0bbf\u0bb0\u0ba3\u0bcd\u0bae\u0baf\u0bc8 \u0ba8\u0bae\u0b83\n    \u0b93\u0b82 \u0bb2\u0b95\u0bcd\u0bb7\u0bcd\u0bae\u0bcd\u0baf\u0bc8 \u0ba8\u0bae\u0b83\n    \u0b93\u0b82 \u0ba8\u0bbf\u0ba4\u0bcd\u0baf\u0baa\u0bc1\u0bb7\u0bcd\u0b9f\u0bbe\u0baf\u0bc8 \u0ba8\u0bae\u0b83\n    \u0b93\u0b82 \u0bb5\u0bbf\u0baa\u0bbe\u0bb5\u0bb0\u0bcd\u0baf\u0bc8 \u0ba8\u0bae\u0b83\n    \u0b93\u0b82 \u0b86\u0ba4\u0bbf\u0ba4\u0bcd\u0baf\u0bbe\u0baf\u0bc8 \u0ba8\u0bae\u0b83\n    \u0b93\u0b82 \u0ba4\u0bbf\u0ba4\u0bcd\u0baf\u0bc8 \u0ba8\u0bae\u0b83\n    \u0b93\u0b82 \u0ba4\u0bc0\u0baa\u0bcd\u0ba4\u0bbe\u0baf\u0bc8 \u0ba8\u0bae\u0b83\n    \u0b93\u0b82 \u0bb5\u0bb8\u0bc1\u0ba4\u0bbe\u0baf\u0bc8 \u0ba8\u0bae\u0b83\n    \u0b93\u0b82 \u0bb5\u0bb8\u0bc1\u0ba4\u0bbe\u0bb0\u0bbf\u0ba3\u0bcd\u0baf\u0bc8 \u0ba8\u0bae\u0b83\n    \u0b93\u0b82 \u0b95\u0bae\u0bb2\u0bbe\u0baf\u0bc8 \u0ba8\u0bae\u0b83\n    \u0b93\u0b82 \u0b95\u0bbe\u0b82\u0ba4\u0bbe\u0baf\u0bc8 \u0ba8\u0bae\u0b83\n    \u0b93\u0b82 \u0b95\u0bbe\u0bae\u0bbe\u0b95\u0bcd\u0bb7\u0bcd\u0baf\u0bc8 \u0ba8\u0bae\u0b83\n    \u0b93\u0b82 \u0bb6\u0bcd\u0bb0\u0bc0 \u0bae\u0bbe\u0bb3\u0bbf\u0b95\u0bbe\u0baa\u0bc1\u0bb0\u0ba4\u0bcd\u0ba4\u0bae\u0bcd\u0bae\u0bbe\u0baf\u0bc8 \u0ba8\u0bae\u0b83\n    \n    \u0bae\u0bbe\u0bb3\u0bbf\u0b95\u0bbe\u0baa\u0bc1\u0bb0\u0ba4\u0bcd\u0ba4\u0bae\u0bcd\u0bae \u0ba4\u0bc7\u0bb5\u0bbf\u0baf\u0bc7 \u0bb6\u0bb0\u0ba3\u0bae\u0baf\u0bcd\u0baf\u0baa\u0bcd\u0baa!",isAudio:!1,audioDurationSec:40,totalTime:"00:40"},{id:"14",slug:"sri-gomatha-pooja",title:"\u0bb8\u0bcd\u0bb0\u0bc0 \u0b95\u0bcb\u0bae\u0bbe\u0ba4\u0bbe \u0baa\u0bc2\u0b9c\u0bc8",description:"[ \u0bb6\u0bcd\u0bb0\u0bc0 \u0b95\u0bcb\u0bae\u0bbe\u0ba4 \u0baa\u0bc2\u0b9c - \u0b95\u0bbe\u0bae\u0ba4\u0bc7\u0ba8\u0bc1 \u0baa\u0bc2\u0b9c\u0bbe \u0bb5\u0bbf\u0ba4\u0bbe\u0ba8\u0b82 ]\n    \n    \u0b95\u0bcb\u0bb5\u0bc1 \u0bb8\u0bae\u0bb8\u0bcd\u0ba4 \u0bae\u0bc1\u0b95\u0bcd\u0b95\u0bcb\u0b9f\u0bbf \u0ba4\u0bc7\u0bb5\u0ba4\u0bb2 \u0ba8\u0bbf\u0bb2\u0baf\u0bae\u0bc1. \u0b95\u0bcb\u0bae\u0bbe\u0ba4\u0ba8\u0bc1 \u0baa\u0bc2\u0b9c\u0bbf\u0b82\u0b9a\u0bbf\u0ba8 \u0bb8\u0bb0\u0bcd\u0bb5 \u0ba4\u0bc7\u0bb5\u0ba4\u0bb2\u0ba8\u0bc1 \u0baa\u0bc2\u0b9c\u0bbf\u0b82\u0b9a\u0bbf\u0ba8 \u0baa\u0bb2\u0b82 \u0bb2\u0baa\u0bbf\u0bb8\u0bcd\u0ba4\u0bc1\u0b82\u0ba4\u0bbf.\n    \n    [ \u0baa\u0bcd\u0bb0\u0bbe\u0bb0\u0bcd\u0ba4\u0ba8 ]\n    \u0bb2\u0b95\u0bcd\u0bb7\u0bcd\u0bae\u0bc0\u0bb0\u0bcd\u0baf\u0bbe \u0bb2\u0bcb\u0b95\u0baa\u0bbe\u0bb2\u0bbe\u0ba8\u0bbe\u0b82 \u0ba4\u0bc7\u0ba8\u0bc1\u0bb0\u0bc2\u0baa\u0bc7\u0ba3 \u0bb8\u0b82\u0bb8\u0bcd\u0ba4\u0bbf\u0ba4\u0bbe\n    \u0b95\u0bc1\u0bb9\u0bbe\u0ba4\u0bc1 \u0ba4\u0bbf\u0bb5\u0bcd\u0baf\u0bbe\u0bb9\u0bbe\u0bb0\u0bbe\u0bb0\u0bcd\u0ba4\u0b82 \u0baf\u0b9c\u0bcd\u0b9e\u0bbe\u0baf \u0bb0\u0b95\u0bcd\u0bb7\u0bbf\u0ba4\u0bbe \u0bae\u0baf\u0bbe\n    \n    \u0bb8\u0bb0\u0bcd\u0bb5\u0ba4\u0bc7\u0bb5\u0bae\u0baf\u0bc7 \u0ba4\u0bc7\u0bb5\u0bbf \u0bb8\u0bb0\u0bcd\u0bb5\u0ba4\u0bc0\u0bb0\u0bcd\u0ba4\u0bc0\u0b95\u0c43\u0ba4\u0bbe\u0bb8\u0ba8\u0bc7\n    \u0bae\u0bbe\u0ba4\u0bb0\u0bcd\u0bae\u0bae\u0bbe\u0baa\u0bbf\u0bb2\u0bb7\u0bbf\u0ba4\u0b82 \u0bb8\u0baa\u0bb2\u0b82 \u0b95\u0bc1\u0bb0\u0bc1 \u0ba8\u0b82\u0ba4\u0bbf\u0ba8\u0bbf\n    \n    [ \u0b95\u0bcb\u0bae\u0bbe\u0ba4 \u0baa\u0bcd\u0bb0\u0ba4\u0b95\u0bcd\u0bb7\u0bbf\u0ba3 \u0bae\u0b82\u0ba4\u0bcd\u0bb0\u0b82 ]\n    \u0b95\u0bbe\u0bb5\u0bcb \u0baa\u0b95\u0bcb \u0b95\u0bbe\u0bb5 \u0b87\u0b82\u0ba4\u0bcd\u0bb0\u0bcb \u0bae\u0bc7 \u0b85\u0b9a\u0bcd\u0b9a\u0bbe\u0ba8\u0bcd\u0ba8 \u0b95\u0bbe\u0bb5\u0b83 \u0bb8\u0bcb\u0bae\u0bb8\u0bcd\u0baf \u0baa\u0bcd\u0bb0\u0ba4\u0bae\u0bb8\u0bcd\u0baf \u0baa\u0b95\u0bcd\u0bb7\u0b83\n    \u0b95\u0bbe\u0bb5\u0bb8\u0bcd\u0ba4\u0bbe \u0b85\u0bb8\u0bcd\u0bae\u0bbe\u0b95\u0b82 \u0baa\u0bcd\u0bb0\u0ba4\u0bae\u0bbe\u0b83 \u0baa\u0bc1\u0ba8\u0bbe\u0ba4\u0bc1 \u0b95\u0bbe\u0bb5\u0bcb \u0bb5\u0bb0\u0bcd\u0ba4\u0bbe\u0b82\u0ba4\u0bc1 \u0baa\u0bc1\u0bb5\u0ba8\u0bc7\u0bb7\u0bc1 \u0ba8\u0bbf\u0ba4\u0bcd\u0baf\u0bae\u0bcd\n    \n    [ \u0baa\u0bc2\u0b9c\u0bbe \u0bb8\u0bae\u0bb0\u0bcd\u0baa\u0ba3 ]\n    \u0b93\u0b82 \u0bb6\u0bcd\u0bb0\u0bc0 \u0b95\u0bcb\u0bae\u0bbe\u0ba4\u0bcd\u0bb0\u0bc7 \u0ba8\u0bae\u0b83 - \u0ba4\u0bcd\u0baf\u0bbe\u0ba8\u0b82 \u0bb8\u0bae\u0bb0\u0bcd\u0baa\u0baf\u0bbe\u0bae\u0bbf\n    \u0b93\u0b82 \u0bb6\u0bcd\u0bb0\u0bc0 \u0b95\u0bbe\u0bae\u0ba4\u0bc7\u0ba8\u0bb5\u0bc7 \u0ba8\u0bae\u0b83 - \u0b86\u0bb8\u0ba8\u0b82 \u0bb8\u0bae\u0bb0\u0bcd\u0baa\u0baf\u0bbe\u0bae\u0bbf\n    \u0b93\u0b82 \u0bb6\u0bcd\u0bb0\u0bc0 \u0bb8\u0bc1\u0bb0\u0baa\u0baf\u0bc7 \u0ba8\u0bae\u0b83 - \u0baa\u0bbe\u0ba4\u0bcd\u0baf\u0b82 \u0bb8\u0bae\u0bb0\u0bcd\u0baa\u0baf\u0bbe\u0bae\u0bbf\n    \u0b93\u0b82 \u0bb6\u0bcd\u0bb0\u0bc0 \u0bb8\u0bc1\u0bb6\u0bc0\u0bb2\u0bbe\u0baf\u0bc8 \u0ba8\u0bae\u0b83 - \u0b85\u0bb0\u0bcd\u0b95\u0bcd\u0baf\u0b82 \u0bb8\u0bae\u0bb0\u0bcd\u0baa\u0baf\u0bbe\u0bae\u0bbf\n    \u0b93\u0b82 \u0bb6\u0bcd\u0bb0\u0bc0 \u0baa\u0bb5\u0bbf\u0ba4\u0bcd\u0bb0\u0bbe\u0baf\u0bc8 \u0ba8\u0bae\u0b83 - \u0bb8\u0bcd\u0ba8\u0bbe\u0ba8\u0b82 \u0bb8\u0bae\u0bb0\u0bcd\u0baa\u0baf\u0bbe\u0bae\u0bbf\n    \u0b93\u0b82 \u0bb6\u0bcd\u0bb0\u0bc0 \u0b9c\u0b95\u0ba4\u0bcd\u0ba4\u0bbe\u0ba4\u0bcd\u0bb0\u0bbf\u0ba8\u0bcd\u0baf\u0bc8 \u0ba8\u0bae\u0b83 - \u0bb5\u0bb8\u0bcd\u0ba4\u0bcd\u0bb0\u0b82 \u0bb8\u0bae\u0bb0\u0bcd\u0baa\u0baf\u0bbe\u0bae\u0bbf\n    \u0b93\u0b82 \u0bb6\u0bcd\u0bb0\u0bc0 \u0bb8\u0bc1\u0b95\u0b82\u0ba4\u0bbe\u0baf\u0bc8 \u0ba8\u0bae\u0b83 - \u0b95\u0b82\u0ba4\u0b82 \u0bb8\u0bae\u0bb0\u0bcd\u0baa\u0baf\u0bbe\u0bae\u0bbf\n    \u0b93\u0b82 \u0bb6\u0bcd\u0bb0\u0bc0 \u0b95\u0bb2\u0bcd\u0baf\u0bbe\u0ba3\u0bcd\u0baf\u0bc8 \u0ba8\u0bae\u0b83 - \u0baa\u0bc1\u0bb7\u0bcd\u0baa\u0bbe\u0ba3\u0bbf \u0bb8\u0bae\u0bb0\u0bcd\u0baa\u0baf\u0bbe\u0bae\u0bbf\n    \u0b93\u0b82 \u0bb6\u0bcd\u0bb0\u0bc0 \u0baa\u0bbe\u0b95\u0bcd\u0baf\u0bb5\u0ba4\u0bcd\u0baf\u0bc8 \u0ba8\u0bae\u0b83 - \u0ba4\u0bc2\u0baa\u0b82 \u0bb8\u0bae\u0bb0\u0bcd\u0baa\u0baf\u0bbe\u0bae\u0bbf\n    \u0b93\u0b82 \u0bb6\u0bcd\u0bb0\u0bc0 \u0baa\u0bc1\u0ba3\u0bcd\u0baf\u0bb0\u0bc2\u0baa\u0bbe\u0baf\u0bc8 \u0ba8\u0bae\u0b83 - \u0ba4\u0bc0\u0baa\u0b82 \u0bb8\u0bae\u0bb0\u0bcd\u0baa\u0baf\u0bbe\u0bae\u0bbf\n    \u0b93\u0b82 \u0bb6\u0bcd\u0bb0\u0bc0 \u0b85\u0bae\u0c43\u0ba4\u0bb5\u0bb0\u0bcd\u0bb7\u0bbf\u0ba3\u0bcd\u0baf\u0bc8 \u0ba8\u0bae\u0b83 - \u0ba8\u0bc8\u0bb5\u0bc7\u0ba4\u0bcd\u0baf\u0b82 (\u0b95\u0bcd\u0bb0\u0bbe\u0bb8\u0b82/\u0baa\u0bb3\u0bcd\u0bb3\u0bc1) \u0bb8\u0bae\u0bb0\u0bcd\u0baa\u0baf\u0bbe\u0bae\u0bbf\n    \u0b93\u0b82 \u0bb6\u0bcd\u0bb0\u0bc0 \u0b95\u0bcb\u0bae\u0bbe\u0ba4\u0bcd\u0bb0\u0bc7 \u0ba8\u0bae\u0b83 - \u0b86\u0ba8\u0b82\u0ba4 \u0b95\u0bb0\u0bcd\u0baa\u0bc2\u0bb0 \u0ba8\u0bc0\u0bb0\u0bbe\u0b9c\u0ba8\u0b82 \u0bb8\u0bae\u0bb0\u0bcd\u0baa\u0baf\u0bbe\u0bae\u0bbf\n    \n    \u0b95\u0bcb\u0bae\u0bbe\u0ba4\u0bbe\u0baf\u0bc8 \u0ba8\u0bae\u0bcb \u0ba8\u0bae\u0b83!",isAudio:!1,audioDurationSec:40,totalTime:"00:40"},{id:"15",slug:"ashtottaramulu",title:"\u0b85\u0bb7\u0bcd\u0b9f\u0bcb\u0ba4\u0bcd\u0ba4\u0bb0\u0b99\u0bcd\u0b95\u0bb3\u0bcd",description:"[ \u0b85\u0bb7\u0bcd\u0b9f\u0bcb\u0ba4\u0bcd\u0ba4\u0bb0 \u0bb6\u0ba4 \u0ba8\u0bbe\u0bae\u0bbe\u0bb5\u0bb3\u0bc1\u0bb2\u0bc1 - \u0bb8\u0bae\u0b95\u0bcd\u0bb0 \u0bb8\u0b82\u0b95\u0bcd\u0bb0\u0bb9\u0b82 ]\n    \n    \u0b85\u0baf\u0bcd\u0baf\u0baa\u0bcd\u0baa \u0baa\u0bc2\u0b9c\u0bbe \u0bb5\u0bbf\u0ba4\u0bbe\u0ba8\u0b82\u0bb2\u0bcb \u0bae\u0bc1\u0b95\u0bcd\u0baf\u0bae\u0bc8\u0ba8 \u0baa\u0b82\u0b9a \u0ba4\u0bc7\u0bb5\u0ba4\u0bbe \u0b85\u0bb7\u0bcd\u0b9f\u0bcb\u0ba4\u0bcd\u0ba4\u0bb0 \u0bb6\u0ba4 \u0ba8\u0bbe\u0bae\u0bbe\u0bb5\u0bb3\u0bc1\u0bb2\u0bc1:\n    \n    1. \u0bb6\u0bcd\u0bb0\u0bc0 \u0bb5\u0bbf\u0b95\u0bcd\u0ba8\u0bc7\u0bb6\u0bcd\u0bb5\u0bb0 \u0b85\u0bb7\u0bcd\u0b9f\u0bcb\u0ba4\u0bcd\u0ba4\u0bb0 \u0bb6\u0ba4 \u0ba8\u0bbe\u0bae\u0bbe\u0bb5\u0bb3\u0bbf\u0b83 (\u0b93\u0b82 \u0b95\u0b9c\u0bbe\u0ba8\u0ba8\u0bbe\u0baf \u0ba8\u0bae\u0b83...)\n    2. \u0bb6\u0bcd\u0bb0\u0bc0 \u0bb8\u0bc1\u0baa\u0bcd\u0bb0\u0bb9\u0bcd\u0bae\u0ba3\u0bcd\u0baf \u0b85\u0bb7\u0bcd\u0b9f\u0bcb\u0ba4\u0bcd\u0ba4\u0bb0 \u0bb6\u0ba4 \u0ba8\u0bbe\u0bae\u0bbe\u0bb5\u0bb3\u0bbf\u0b83 (\u0b93\u0b82 \u0bb8\u0bcd\u0b95\u0b82\u0ba4\u0bbe\u0baf \u0ba8\u0bae\u0b83...)\n    3. \u0bb6\u0bcd\u0bb0\u0bc0 \u0b85\u0baf\u0bcd\u0baf\u0baa\u0bcd\u0baa \u0bb8\u0bcd\u0bb5\u0bbe\u0bae\u0bbf \u0b85\u0bb7\u0bcd\u0b9f\u0bcb\u0ba4\u0bcd\u0ba4\u0bb0 \u0bb6\u0ba4 \u0ba8\u0bbe\u0bae\u0bbe\u0bb5\u0bb3\u0bbf\u0b83 (\u0b93\u0b82 \u0bae\u0bb9\u0bbe\u0bb6\u0bbe\u0bb8\u0bcd\u0ba4\u0bcd\u0bb0\u0bc7 \u0ba8\u0bae\u0b83...)\n    4. \u0bb6\u0bcd\u0bb0\u0bc0 \u0bae\u0bbe\u0bb3\u0bbf\u0b95\u0bbe\u0baa\u0bc1\u0bb0\u0ba4\u0bcd\u0ba4\u0bae\u0bcd\u0bae \u0b85\u0bb7\u0bcd\u0b9f\u0bcb\u0ba4\u0bcd\u0ba4\u0bb0 \u0bb6\u0ba4 \u0ba8\u0bbe\u0bae\u0bbe\u0bb5\u0bb3\u0bbf\u0b83 (\u0b93\u0b82 \u0baa\u0bcd\u0bb0\u0b95\u0c43\u0ba4\u0bbf\u0bb0\u0bc2\u0baa\u0bbe\u0baf\u0bc8 \u0ba8\u0bae\u0b83...)\n    5. \u0bb6\u0bcd\u0bb0\u0bc0 \u0bb6\u0bbf\u0bb5 \u0b85\u0bb7\u0bcd\u0b9f\u0bcb\u0ba4\u0bcd\u0ba4\u0bb0 \u0bb6\u0ba4 \u0ba8\u0bbe\u0bae\u0bbe\u0bb5\u0bb3\u0bbf\u0b83 (\u0b93\u0b82 \u0bb6\u0bbf\u0bb5\u0bbe\u0baf \u0ba8\u0bae\u0b83...)\n    \n    \u0baa\u0bcd\u0bb0\u0ba4\u0bbf\u0bb0\u0bcb\u0b9c\u0bc2 \u0b88 \u0ba8\u0bbe\u0bae\u0bae\u0bc1\u0bb2\u0ba8\u0bc1 \u0baa\u0b9f\u0bbf\u0b82\u0b9a\u0b9f\u0b82 \u0bb5\u0bb2\u0ba8 \u0bb8\u0bb0\u0bcd\u0bb5 \u0b95\u0bbe\u0bb0\u0bcd\u0baf\u0bae\u0bc1\u0bb2\u0bc1 \u0bb8\u0bbf\u0ba4\u0bcd\u0ba4\u0bbf\u0bb8\u0bcd\u0ba4\u0bbe\u0baf\u0bbf, \u0b86\u0baa\u0ba4\u0bb2\u0bc1 \u0ba4\u0bca\u0bb2\u0b95\u0bbf\u0baa\u0bcb\u0ba4\u0bbe\u0baf\u0bbf.\n    \n    \u0bb8\u0bcd\u0bb5\u0bbe\u0bae\u0bbf\u0baf\u0bc7 \u0bb6\u0bb0\u0ba3\u0b82 \u0b85\u0baf\u0bcd\u0baf\u0baa\u0bcd\u0baa!",isAudio:!1,audioDurationSec:40,totalTime:"00:40"},{id:"16",slug:"sri-ayyappa-sahasranamam",title:"\u0bb8\u0bcd\u0bb0\u0bc0 \u0bb9\u0bb0\u0bbf\u0bb9\u0bb0\u0baa\u0bc1\u0ba4\u0bcd\u0bb0 \u0b9a\u0bb9\u0bb8\u0bcd\u0bb0\u0ba8\u0bbe\u0bae\u0bbe\u0bb5\u0bb3\u0bbf",description:"",isAudio:!1,audioDurationSec:40,totalTime:"00:40"},{id:"17",slug:"ayyappa-harathi",title:"\u0bae\u0b99\u0bcd\u0b95\u0bb3 \u0b86\u0bb0\u0ba4\u0bcd\u0ba4\u0bbf",description:"\u0bb6\u0b82\u0b95\u0bb0\u0bbe\u0baf \u0bb6\u0b82\u0b95\u0bb0\u0bbe\u0baf \u0bb6\u0b82\u0b95\u0bb0\u0bbe\u0baf \u0bae\u0b82\u0b95\u0bb3\u0bae\u0bcd \u0964\n    \u0bb6\u0b82\u0b95\u0bb0\u0bc0 \u0bae\u0ba8\u0bcb\u0bb9\u0bb0\u0bbe\u0baf \u0bb6\u0bbe\u0bb6\u0bcd\u0bb5\u0ba4\u0bbe\u0baf \u0bae\u0b82\u0b95\u0bb3\u0bae\u0bcd \u0965\n    \n    \u0b95\u0bc1\u0bb0\u0bc1\u0bb5\u0bb0\u0bbe\u0baf \u0bae\u0b82\u0b95\u0bb3\u0b82 \u0ba4\u0ba4\u0bcd\u0ba4\u0bbe\u0ba4\u0bcd\u0bb0\u0bc7\u0baf \u0bae\u0b82\u0b95\u0bb3\u0bae\u0bcd \u0964\n    \u0bb0\u0bbe\u0b9c\u0bb0\u0bbe\u0bae \u0bae\u0b82\u0b95\u0bb3\u0b82 \u0bb0\u0bbe\u0bae\u0b95\u0c43\u0bb7\u0bcd\u0ba3 \u0bae\u0b82\u0b95\u0bb3\u0bae\u0bcd \u0965\n    \n    \u0b85\u0baf\u0bcd\u0baf\u0baa\u0bcd\u0baa \u0bae\u0b82\u0b95\u0bb3\u0b82 \u0bae\u0ba3\u0bbf\u0b95\u0b82\u0b9f \u0bae\u0b82\u0b95\u0bb3\u0bae\u0bcd \u0964\n    \u0bb6\u0baa\u0bb0\u0bc0\u0bb6 \u0bae\u0b82\u0b95\u0bb3\u0b82 \u0bb6\u0bbe\u0bb8\u0bcd\u0ba4\u0bbe\u0baf \u0bae\u0b82\u0b95\u0bb3\u0bae\u0bcd \u0965\n    \n    \u0bae\u0b82\u0b95\u0bb3\u0b82 \u0bae\u0b82\u0b95\u0bb3\u0b82 \u0ba8\u0bbf\u0ba4\u0bcd\u0baf\u0b9c\u0baf \u0bae\u0b82\u0b95\u0bb3\u0bae\u0bcd \u0964\n    \u0bae\u0b82\u0b95\u0bb3\u0b82 \u0bae\u0b82\u0b95\u0bb3\u0b82 \u0ba8\u0bbf\u0ba4\u0bcd\u0baf\u0bb6\u0bc1\u0baa \u0bae\u0b82\u0b95\u0bb3\u0bae\u0bcd \u0965\n    \n    \u0b93\u0b82 \u0bb6\u0bcd\u0bb0\u0bc0 \u0bb8\u0bcd\u0bb5\u0bbe\u0bae\u0bbf\u0baf\u0bc7 \u0bb6\u0bb0\u0ba3\u0b82 \u0b85\u0baf\u0bcd\u0baf\u0baa\u0bcd\u0baa\n    \u0b93\u0b82 \u0bb6\u0bcd\u0bb0\u0bc0 \u0bb8\u0bcd\u0bb5\u0bbe\u0bae\u0bbf\u0baf\u0bc7 \u0bb6\u0bb0\u0ba3\u0b82 \u0b85\u0baf\u0bcd\u0baf\u0baa\u0bcd\u0baa\n    \u0b93\u0b82 \u0bb6\u0bcd\u0bb0\u0bc0 \u0bb8\u0bcd\u0bb5\u0bbe\u0bae\u0bbf\u0baf\u0bc7 \u0bb6\u0bb0\u0ba3\u0b82 \u0b85\u0baf\u0bcd\u0baf\u0baa\u0bcd\u0baa",isAudio:!1,audioDurationSec:40,totalTime:"00:40"},{id:"18",slug:"mantrapushpam",title:"\u0bae\u0ba8\u0bcd\u0ba4\u0bbf\u0bb0 \u0baa\u0bc1\u0bb7\u0bcd\u0baa\u0bae\u0bcd",description:"\u0b93\u0b82 \u0bb0\u0bbe\u0b9c\u0bbe\u0ba4\u0bbf\u0bb0\u0bbe\u0b9c\u0bbe\u0baf \u0baa\u0bcd\u0bb0\u0bb8\u0bb9\u0bcd\u0baf \u0bb8\u0bbe\u0bb9\u0bbf\u0ba8\u0bc7 \u0ba8\u0bae\u0bcb \u0bb5\u0baf\u0b82 \u0bb5\u0bc8\u0bb6\u0bcd\u0bb0\u0bb5\u0ba3\u0bbe\u0baf \u0b95\u0bc1\u0bb0\u0bcd\u0bae\u0bb9\u0bc7 \u0964\n    \u0bb8 \u0bae\u0bc7 \u0b95\u0bbe\u0bae\u0bbe\u0ba8\u0bcd \u0b95\u0bbe\u0bae\u0b95\u0bbe\u0bae\u0bbe\u0baf \u0bae\u0bb9\u0bcd\u0baf\u0b82 \u0b95\u0bbe\u0bae\u0bc7\u0bb6\u0bcd\u0bb5\u0bb0\u0bcb \u0bb5\u0bc8\u0bb6\u0bcd\u0bb0\u0bb5\u0ba3\u0bcb \u0ba4\u0ba4\u0bbe\u0ba4\u0bc1 \u0964\n    \u0b95\u0bc1\u0baa\u0bc7\u0bb0\u0bbe\u0baf \u0bb5\u0bc8\u0bb6\u0bcd\u0bb0\u0bb5\u0ba3\u0bbe\u0baf \u0bae\u0bb9\u0bbe\u0bb0\u0bbe\u0b9c\u0bbe\u0baf \u0ba8\u0bae\u0b83 \u0965\n    \n    \u0b93\u0b82 \u0ba4\u0ba4\u0bcd\u0baa\u0bcd\u0bb0\u0bb9\u0bcd\u0bae \u0b93\u0b82 \u0ba4\u0ba4\u0bcd\u0bb5\u0bbe\u0baf\u0bc1\u0b83 \u0b93\u0b82 \u0ba4\u0ba4\u0bbe\u0ba4\u0bcd\u0bae\u0bbe \u0b93\u0b82 \u0ba4\u0ba4\u0bcd\u0bb8\u0ba4\u0bcd\u0baf\u0bae\u0bcd \u0b93\u0b82 \u0ba4\u0ba4\u0bcd \u0bb8\u0bb0\u0bcd\u0bb5\u0bae\u0bcd \u0b93\u0b82 \u0ba4\u0ba4\u0bcd \u0baa\u0bc1\u0bb0\u0bcb\u0bb0\u0bcd\u0ba8\u0bae\u0b83 \u0965\n    \u0b85\u0b82\u0ba4\u0bb6\u0bcd\u0b9a\u0bb0\u0ba4\u0bbf \u0baa\u0bc2\u0ba4\u0bc7\u0bb7\u0bc1 \u0b95\u0bc1\u0bb9\u0bbe\u0baf\u0bbe\u0b82 \u0bb5\u0bbf\u0bb6\u0bcd\u0bb5\u0bae\u0bc2\u0bb0\u0bcd\u0ba4\u0bbf\u0bb7\u0bc1 \u0964\n    \u0ba4\u0bcd\u0bb5\u0b82 \u0baf\u0b9c\u0bcd\u0b9e\u0bb8\u0bcd\u0ba4\u0bcd\u0bb5\u0b82 \u0bb5\u0bb7\u0b9f\u0bcd\u0b95\u0bbe\u0bb0\u0bb8\u0bcd\u0ba4\u0bcd\u0bb5\u0bae\u0bbf\u0b82\u0ba4\u0bcd\u0bb0\u0bb8\u0bcd\u0ba4\u0bcd\u0bb5\u0b95\u0bc1\u0b82 \u0bb0\u0bc1\u0ba4\u0bcd\u0bb0\u0bb8\u0bcd\u0ba4\u0bcd\u0bb5\u0b82 \u0bb5\u0bbf\u0bb7\u0bcd\u0ba3\u0bc1\u0bb8\u0bcd\u0ba4\u0bcd\u0bb5\u0b82 \u0baa\u0bcd\u0bb0\u0bb9\u0bcd\u0bae\u0ba4\u0bcd\u0bb5\u0b82 \u0baa\u0bcd\u0bb0\u0b9c\u0bbe\u0baa\u0ba4\u0bbf\u0b83 \u0964\n    \u0ba4\u0bcd\u0bb5\u0b82 \u0ba4\u0ba4\u0bbe\u0baa \u0b86\u0baa\u0bcb\u0b9c\u0bcd\u0baf\u0bcb\u0ba4\u0bc0 \u0bb0\u0bb8\u0bcb\u0bae\u0c43\u0ba4\u0b82 \u0baa\u0bcd\u0bb0\u0bb9\u0bcd\u0bae \u0baa\u0bc2\u0bb0\u0bcd\u0baa\u0bc1\u0bb5\u0bb8\u0bcd\u0bb8\u0bc1\u0bb5\u0bb0\u0bcb\u0bae\u0bcd \u0965\n    \n    \u0b93\u0b82 \u0ba8\u0bae\u0bb8\u0bcd\u0ba4\u0bc7 \u0b85\u0bb8\u0bcd\u0ba4\u0bc1 \u0baa\u0b95\u0bb5\u0ba8\u0bcd \u0bb5\u0bbf\u0bb6\u0bcd\u0bb5\u0bc7\u0bb6\u0bcd\u0bb5\u0bb0\u0bbe\u0baf \u0bae\u0bb9\u0bbe\u0ba4\u0bc7\u0bb5\u0bbe\u0baf \u0ba4\u0bcd\u0bb0\u0bcd\u0baf\u0b82\u0baa\u0b95\u0bbe\u0baf \u0ba4\u0bcd\u0bb0\u0bbf\u0baa\u0bc1\u0bb0\u0bbe\u0b82\u0ba4\u0b95\u0bbe\u0baf \u0ba4\u0bcd\u0bb0\u0bbf\u0b95\u0bbe\u0b95\u0bcd\u0ba8\u0bbf\u0b95\u0bbe\u0bb2\u0bbe\u0baf \u0b95\u0bbe\u0bb2\u0bbe\u0b95\u0bcd\u0ba8\u0bbf\u0bb0\u0bc1\u0ba4\u0bcd\u0bb0\u0bbe\u0baf \u0ba8\u0bc0\u0bb2\u0b95\u0b82\u0b9f\u0bbe\u0baf \u0bae\u0c43\u0ba4\u0bcd\u0baf\u0bc1\u0b82\u0b9c\u0baf\u0bbe\u0baf \u0bb8\u0bb0\u0bcd\u0bb5\u0bc7\u0bb6\u0bcd\u0bb5\u0bb0\u0bbe\u0baf \u0bb8\u0ba4\u0bbe\u0bb6\u0bbf\u0bb5\u0bbe\u0baf \u0bb6\u0bcd\u0bb0\u0bc0\u0bae\u0ba8\u0bcd\u0bae\u0bb9\u0bbe\u0ba4\u0bc7\u0bb5\u0bbe\u0baf \u0ba8\u0bae\u0b83 \u0965\n    \n    \u0b93\u0b82 \u0ba8\u0bbf\u0ba4\u0ba8\u0baa\u0ba4\u0baf\u0bc7 \u0ba8\u0bae\u0b83 \u0ba8\u0bbf\u0ba4\u0ba8\u0baa\u0ba4\u0bbe\u0b82\u0ba4\u0bbf\u0b95\u0bbe\u0baf \u0ba8\u0bae\u0b83\n    \u0b8a\u0bb0\u0bcd\u0ba4\u0bcd\u0bb5\u0bbe\u0baf \u0ba8\u0bae\u0b83 \u0b8a\u0bb0\u0bcd\u0ba4\u0bcd\u0bb5\u0bb2\u0bbf\u0b82\u0b95\u0bbe\u0baf \u0ba8\u0bae\u0b83\n    \u0bb9\u0bbf\u0bb0\u0ba3\u0bcd\u0baf\u0bbe\u0baf \u0ba8\u0bae\u0b83 \u0bb9\u0bbf\u0bb0\u0ba3\u0bcd\u0baf\u0bb2\u0bbf\u0b82\u0b95\u0bbe\u0baf \u0ba8\u0bae\u0b83\n    \u0bb8\u0bc1\u0bb5\u0bb0\u0bcd\u0ba3\u0bbe\u0baf \u0ba8\u0bae\u0b83 \u0bb8\u0bc1\u0bb5\u0bb0\u0bcd\u0ba3\u0bb2\u0bbf\u0b82\u0b95\u0bbe\u0baf \u0ba8\u0bae\u0b83\n    \u0ba4\u0bbf\u0bb5\u0bcd\u0baf\u0bbe\u0baf \u0ba8\u0bae\u0b83 \u0ba4\u0bbf\u0bb5\u0bcd\u0baf\u0bb2\u0bbf\u0b82\u0b95\u0bbe\u0baf \u0ba8\u0bae\u0b83\n    \u0baa\u0bb5\u0bbe\u0baf \u0ba8\u0bae\u0b83 \u0baa\u0bb5\u0bb2\u0bbf\u0b82\u0b95\u0bbe\u0baf \u0ba8\u0bae\u0b83\n    \u0bb8\u0bb0\u0bcd\u0bb5\u0bbe\u0baf \u0ba8\u0bae\u0b83 \u0bb8\u0bb0\u0bcd\u0bb5\u0bb2\u0bbf\u0b82\u0b95\u0bbe\u0baf \u0ba8\u0bae\u0b83\n    \u0bb6\u0bbf\u0bb5\u0bbe\u0baf \u0ba8\u0bae\u0b83 \u0bb6\u0bbf\u0bb5\u0bb2\u0bbf\u0b82\u0b95\u0bbe\u0baf \u0ba8\u0bae\u0b83\n    \u0b9c\u0bcd\u0bb5\u0bbe\u0bb2\u0bbe\u0baf \u0ba8\u0bae\u0b83 \u0b9c\u0bcd\u0bb5\u0bbe\u0bb2\u0bb2\u0bbf\u0b82\u0b95\u0bbe\u0baf \u0ba8\u0bae\u0b83\n    \u0b86\u0ba4\u0bcd\u0bae\u0bbe\u0baf \u0ba8\u0bae\u0b83 \u0b86\u0ba4\u0bcd\u0bae\u0bb2\u0bbf\u0b82\u0b95\u0bbe\u0baf \u0ba8\u0bae\u0b83\n    \u0baa\u0bb0\u0bae\u0bbe\u0baf \u0ba8\u0bae\u0b83 \u0baa\u0bb0\u0bae\u0bb2\u0bbf\u0b82\u0b95\u0bbe\u0baf \u0ba8\u0bae\u0b83\n    \u0b8f\u0ba4\u0ba4\u0bcd \u0bb8\u0bcb\u0bae\u0bb8\u0bcd\u0baf \u0bb8\u0bc2\u0bb0\u0bcd\u0baf\u0bb8\u0bcd\u0baf \u0bb8\u0bb0\u0bcd\u0bb5\u0bb2\u0bbf\u0b82\u0b95\u0b95\u0bcd\u0b82 \u0bb8\u0bcd\u0ba4\u0bbe\u0baa\u0baf\u0ba4\u0bbf \u0baa\u0bbe\u0ba3\u0bbf\u0bae\u0b82\u0ba4\u0bcd\u0bb0\u0b82 \u0baa\u0bb5\u0bbf\u0ba4\u0bcd\u0bb0\u0bae\u0bcd \u0965\n    \n    \u0bb8\u0ba4\u0bcd\u0baf\u0bcb\u0b9c\u0bbe\u0ba4\u0b82 \u0baa\u0bcd\u0bb0\u0baa\u0ba4\u0bcd\u0baf\u0bbe\u0bae\u0bbf \u0bb8\u0ba4\u0bcd\u0baf\u0bcb\u0b9c\u0bbe\u0ba4\u0bbe\u0baf \u0bb5\u0bc8 \u0ba8\u0bae\u0bcb \u0ba8\u0bae\u0b83 \u0964\n    \u0baa\u0bb5\u0bc7 \u0baa\u0bb5\u0bc7 \u0ba8\u0bbe\u0ba4\u0bbf\u0baa\u0bb5\u0bc7 \u0baa\u0bb5\u0bb8\u0bcd\u0bb5 \u0bae\u0bbe\u0bae\u0bcd \u0baa\u0bb5\u0bcb\u0ba4\u0bcd\u0baa\u0bb5\u0bbe\u0baf \u0ba8\u0bae\u0b83 \u0965\n    \u0bb5\u0bbe\u0bae\u0ba4\u0bc7\u0bb5\u0bbe\u0baf \u0ba8\u0bae\u0bcb \u0b9c\u0bcd\u0baf\u0bc7\u0bb7\u0bcd\u0b9f\u0bbe\u0baf \u0ba8\u0bae\u0b83 \u0bb6\u0bcd\u0bb0\u0bc7\u0bb7\u0bcd\u0b9f\u0bbe\u0baf \u0ba8\u0bae\u0bcb \u0bb0\u0bc1\u0ba4\u0bcd\u0bb0\u0bbe\u0baf \u0ba8\u0bae\u0b83 \u0b95\u0bbe\u0bb2\u0bbe\u0baf \u0ba8\u0bae\u0b83 \u0b95\u0bb2\u0bb5\u0bbf\u0b95\u0bb0\u0ba3\u0bbe\u0baf \u0ba8\u0bae\u0bcb \u0baa\u0bb2\u0bb5\u0bbf\u0b95\u0bb0\u0ba3\u0bbe\u0baf \u0ba8\u0bae\u0bcb \u0baa\u0bb2\u0bbe\u0baf \u0ba8\u0bae\u0bcb \u0baa\u0bb2\u0baa\u0bcd\u0bb0\u0bae\u0ba4\u0ba8\u0bbe\u0baf \u0ba8\u0bae\u0b83 \u0bb8\u0bb0\u0bcd\u0bb5\u0baa\u0bc2\u0ba4\u0ba4\u0bae\u0ba8\u0bbe\u0baf \u0ba8\u0bae\u0bcb \u0bae\u0ba8\u0bcb\u0ba8\u0bcd\u0bae\u0ba8\u0bbe\u0baf \u0ba8\u0bae\u0b83 \u0965\n    \u0b85\u0b95\u0bcb\u0bb0\u0bc7\u0baa\u0bcd\u0baf\u0bcb\u0ba4 \u0b95\u0bcb\u0bb0\u0bc7\u0baa\u0bcd\u0baf\u0bcb \u0b95\u0bcb\u0bb0\u0b95\u0bcb\u0bb0\u0ba4\u0bb0\u0bc7\u0baa\u0bcd\u0baf\u0b83 \u0bb8\u0bb0\u0bcd\u0bb5\u0bc7\u0baa\u0bcd\u0baf\u0b83 \u0bb8\u0bb0\u0bcd\u0bb5 \u0bb6\u0bb0\u0bcd\u0bb5\u0bc7\u0baa\u0bcd\u0baf\u0bcb \u0ba8\u0bae\u0bb8\u0bcd\u0ba4\u0bc7 \u0b85\u0bb8\u0bcd\u0ba4\u0bc1 \u0bb0\u0bc1\u0ba4\u0bcd\u0bb0 \u0bb0\u0bc2\u0baa\u0bc7\u0baa\u0bcd\u0baf\u0b83 \u0965\n    \u0ba4\u0ba4\u0bcd\u0baa\u0bc1\u0bb0\u0bc1\u0bb7\u0bbe\u0baf \u0bb5\u0bbf\u0ba4\u0bcd\u0bae\u0bb9\u0bc7 \u0bae\u0bb9\u0bbe\u0ba4\u0bc7\u0bb5\u0bbe\u0baf \u0ba4\u0bc0\u0bae\u0bb9\u0bbf \u0ba4\u0ba8\u0bcd\u0ba8\u0bcb \u0bb0\u0bc1\u0ba4\u0bcd\u0bb0\u0b83 \u0baa\u0bcd\u0bb0\u0b9a\u0bcb\u0ba4\u0baf\u0bbe\u0ba4\u0bcd \u0965\n    \u0b88\u0bb6\u0bbe\u0ba8\u0bb8\u0bcd\u0bb8\u0bb0\u0bcd\u0bb5\u0bb5\u0bbf\u0ba4\u0bcd\u0baf\u0bbe\u0ba8\u0bbe\u0bae\u0bc0\u0bb6\u0bcd\u0bb5\u0bb0\u0bb8\u0bcd\u0bb8\u0bb0\u0bcd\u0bb5 \u0baa\u0bc2\u0ba4\u0bbe\u0ba8\u0bbe\u0b82 \u0baa\u0bcd\u0bb0\u0bb9\u0bcd\u0bae\u0bbe\u0ba4\u0bbf\u0baa\u0ba4\u0bbf\u0bb0\u0bcd\u0baa\u0bcd\u0bb0\u0bb9\u0bcd\u0bae\u0ba3\u0bcb\u0ba4\u0bbf\u0baa\u0ba4\u0bbf\u0bb0\u0bcd\u0baa\u0bcd\u0bb0\u0bb9\u0bcd\u0bae\u0bbe \u0bb6\u0bbf\u0bb5\u0bcb \u0bae\u0bc7 \u0b85\u0bb8\u0bcd\u0ba4\u0bc1 \u0bb8\u0ba4\u0bbe\u0bb6\u0bbf\u0bb5\u0bcb\u0bae\u0bcd \u0965\n    \n    \u0b93\u0b82 \u0ba4\u0ba4\u0bcd\u0baa\u0bc1\u0bb0\u0bc1\u0bb7\u0bbe\u0baf \u0bb5\u0bbf\u0ba4\u0bcd\u0bae\u0bb9\u0bc7 \u0bae\u0bb9\u0bbe\u0ba4\u0bc7\u0bb5\u0bbe\u0baf \u0ba4\u0bc0\u0bae\u0bb9\u0bbf \u0ba4\u0ba8\u0bcd\u0ba8\u0bcb \u0bb0\u0bc1\u0ba4\u0bcd\u0bb0\u0b83 \u0baa\u0bcd\u0bb0\u0b9a\u0bcb\u0ba4\u0baf\u0bbe\u0ba4\u0bcd \u0965\n    \u0b93\u0b82 \u0ba8\u0bbe\u0bb0\u0bbe\u0baf\u0ba3\u0bbe\u0baf \u0bb5\u0bbf\u0ba4\u0bcd\u0bae\u0bb9\u0bc7 \u0bb5\u0bbe\u0bb8\u0bc1\u0ba4\u0bc7\u0bb5\u0bbe\u0baf \u0ba4\u0bc0\u0bae\u0bb9\u0bbf \u0ba4\u0ba8\u0bcd\u0ba8\u0bcb \u0bb5\u0bbf\u0bb7\u0bcd\u0ba3\u0bc1\u0b83 \u0baa\u0bcd\u0bb0\u0b9a\u0bcb\u0ba4\u0baf\u0bbe\u0ba4\u0bcd \u0965\n    \u0b93\u0b82 \u0baa\u0bc2\u0ba4\u0ba8\u0bbe\u0ba4\u0bbe\u0baf \u0bb5\u0bbf\u0ba4\u0bcd\u0bae\u0bb9\u0bc7 \u0baa\u0bb5\u0baa\u0bc1\u0ba4\u0bcd\u0bb0\u0bbe\u0baf \u0ba4\u0bc0\u0bae\u0bb9\u0bbf \u0ba4\u0ba8\u0bcd\u0ba8\u0bcb \u0bb6\u0bbe\u0bb8\u0bcd\u0ba4\u0bbe \u0baa\u0bcd\u0bb0\u0b9a\u0bcb\u0ba4\u0baf\u0bbe\u0ba4\u0bcd \u0965",isAudio:!1,audioDurationSec:40,totalTime:"00:40"},{id:"19",slug:"sastha-dasakam",title:"\u0ba8\u0bae\u0bb8\u0bcd\u0b95\u0bbe\u0bb0 \u0bb8\u0bcd\u0bb2\u0bcb\u0b95\u0b99\u0bcd\u0b95\u0bb3\u0bcd",description:"\u0bb2\u0bcb\u0b95\u0bb5\u0bc0\u0bb0\u0b82 \u0bae\u0bb9\u0bbe\u0baa\u0bc2\u0b9c\u0bcd\u0baf\u0b82 \u0bb8\u0bb0\u0bcd\u0bb5\u0bb0\u0b95\u0bcd\u0bb7\u0bbe\u0b95\u0bb0\u0b82 \u0bb5\u0bbf\u0baa\u0bc1\u0bae\u0bcd \u0964\n    \u0baa\u0bbe\u0bb0\u0bcd\u0bb5\u0ba4\u0bc0 \u0bb9\u0c43\u0ba4\u0baf\u0bbe\u0ba8\u0b82\u0ba4\u0b82 \u0bb6\u0bbe\u0bb8\u0bcd\u0ba4\u0bbe\u0bb0\u0b82 \u0baa\u0bcd\u0bb0\u0ba3\u0bae\u0bbe\u0bae\u0bcd\u0baf\u0bb9\u0bae\u0bcd \u0965 1\n    \n    \u0bb5\u0bbf\u0baa\u0bcd\u0bb0\u0baa\u0bc2\u0b9c\u0bcd\u0baf\u0b82 \u0bb5\u0bbf\u0bb6\u0bcd\u0bb5\u0bb5\u0b82\u0ba4\u0bcd\u0baf\u0b82 \u0bb5\u0bbf\u0bb7\u0bcd\u0ba3\u0bc1\u0bb6\u0b82\u0baa\u0bcb\u0b83 \u0baa\u0bcd\u0bb0\u0bbf\u0baf\u0b82 \u0bb8\u0bc1\u0ba4\u0bae\u0bcd \u0964\n    \u0b95\u0bcd\u0bb7\u0bbf\u0baa\u0bcd\u0bb0\u0baa\u0bcd\u0bb0\u0bb8\u0bbe\u0ba4\u0ba8\u0bbf\u0bb0\u0ba4\u0b82 \u0bb6\u0bbe\u0bb8\u0bcd\u0ba4\u0bbe\u0bb0\u0b82 \u0baa\u0bcd\u0bb0\u0ba3\u0bae\u0bbe\u0bae\u0bcd\u0baf\u0bb9\u0bae\u0bcd \u0965 2\n    \n    \u0bae\u0ba4\u0bcd\u0ba4\u0bae\u0bbe\u0ba4\u0b82\u0b95\u0b95\u0bae\u0ba8\u0b82 \u0b95\u0bbe\u0bb0\u0bc1\u0ba3\u0bcd\u0baf\u0bbe\u0bae\u0c43\u0ba4\u0baa\u0bc2\u0bb0\u0bbf\u0ba4\u0bae\u0bcd \u0964\n    \u0bb8\u0bb0\u0bcd\u0bb5\u0bb5\u0bbf\u0b95\u0bcd\u0ba8\u0bb9\u0bb0\u0b82 \u0ba4\u0bc7\u0bb5\u0b82 \u0bb6\u0bbe\u0bb8\u0bcd\u0ba4\u0bbe\u0bb0\u0b82 \u0baa\u0bcd\u0bb0\u0ba3\u0bae\u0bbe\u0bae\u0bcd\u0baf\u0bb9\u0bae\u0bcd \u0965 3\n    \n    \u0b85\u0bb8\u0bcd\u0bae\u0ba4\u0bcd\u0b95\u0bc1\u0bb2\u0bc7\u0bb6\u0bcd\u0bb5\u0bb0\u0b82 \u0ba4\u0bc7\u0bb5\u0bae\u0bb8\u0bcd\u0bae\u0b9a\u0bcd\u0b9a\u0ba4\u0bcd\u0bb0\u0bc1\u0bb5\u0bbf\u0ba8\u0bbe\u0bb6\u0ba8\u0bae\u0bcd \u0964\n    \u0b85\u0bb8\u0bcd\u0bae\u0ba4\u0bbf\u0bb7\u0bcd\u0b9f\u0baa\u0bcd\u0bb0\u0ba4\u0bbe\u0ba4\u0bbe\u0bb0\u0b82 \u0bb6\u0bbe\u0bb8\u0bcd\u0ba4\u0bbe\u0bb0\u0b82 \u0baa\u0bcd\u0bb0\u0ba3\u0bae\u0bbe\u0bae\u0bcd\u0baf\u0bb9\u0bae\u0bcd \u0965 4\n    \n    \u0baa\u0bbe\u0b82\u0b9f\u0bcd\u0baf\u0bc7\u0bb6\u0bb5\u0b82\u0bb6\u0ba4\u0bbf\u0bb2\u0b95\u0b82 \u0b95\u0bc7\u0bb0\u0bb3\u0bc7 \u0b95\u0bc7\u0bb3\u0bbf\u0bb5\u0bbf\u0b95\u0bcd\u0bb0\u0bb9\u0bae\u0bcd \u0964\n    \u0b86\u0bb0\u0bcd\u0ba4\u0ba4\u0bcd\u0bb0\u0bbe\u0ba3\u0baa\u0bb0\u0b82 \u0ba4\u0bc7\u0bb5\u0b82 \u0bb6\u0bbe\u0bb8\u0bcd\u0ba4\u0bbe\u0bb0\u0b82 \u0baa\u0bcd\u0bb0\u0ba3\u0bae\u0bbe\u0bae\u0bcd\u0baf\u0bb9\u0bae\u0bcd \u0965 5\n    \n    \u0ba4\u0bcd\u0bb0\u0bcd\u0baf\u0b82\u0baa\u0b95\u0baa\u0bc1\u0bb0\u0bbe\u0ba4\u0bc0\u0bb6\u0b82 \u0b95\u0ba3\u0bbe\u0ba4\u0bbf\u0baa \u0bb8\u0bae\u0ba8\u0bcd\u0bb5\u0bbf\u0ba4\u0bae\u0bcd \u0964\n    \u0b95\u0b9c\u0bbe\u0bb0\u0bc2\u0b9f\u0bae\u0bb9\u0b82 \u0bb5\u0b82\u0ba4\u0bc7 \u0bb6\u0bbe\u0bb8\u0bcd\u0ba4\u0bbe\u0bb0\u0b82 \u0baa\u0bcd\u0bb0\u0ba3\u0bae\u0bbe\u0bae\u0bcd\u0baf\u0bb9\u0bae\u0bcd \u0965 6\n    \n    \u0bb6\u0bbf\u0bb5\u0bb5\u0bc0\u0bb0\u0bcd\u0baf \u0bb8\u0bae\u0bc1\u0ba4\u0bcd\u0baa\u0bc2\u0ba4\u0b82 \u0bb6\u0bcd\u0bb0\u0bc0\u0ba8\u0bbf\u0bb5\u0bbe\u0bb8 \u0ba4\u0ba8\u0bc1\u0ba4\u0bcd\u0baa\u0bb5\u0bae\u0bcd \u0964\n    \u0bb6\u0bbf\u0b95\u0bbf\u0bb5\u0bbe\u0bb9\u0bbe\u0ba8\u0bc1\u0b9c\u0b82 \u0bb5\u0b82\u0ba4\u0bc7 \u0bb6\u0bbe\u0bb8\u0bcd\u0ba4\u0bbe\u0bb0\u0b82 \u0baa\u0bcd\u0bb0\u0ba3\u0bae\u0bbe\u0bae\u0bcd\u0baf\u0bb9\u0bae\u0bcd \u0965 7\n    \n    \u0baf\u0bb8\u0bcd\u0baf \u0ba4\u0ba8\u0bcd\u0bb5\u0b82\u0ba4\u0bb0\u0bbf\u0bb0\u0bcd\u0bae\u0bbe\u0ba4\u0bbe \u0baa\u0bbf\u0ba4\u0bbe \u0ba4\u0bc7\u0bb5\u0bcb \u0bae\u0bb9\u0bc7\u0bb6\u0bcd\u0bb5\u0bb0\u0b83 \u0964\n    \u0ba4\u0b82 \u0bb6\u0bbe\u0bb8\u0bcd\u0ba4\u0bbe\u0bb0\u0bae\u0bb9\u0b82 \u0bb5\u0b82\u0ba4\u0bc7 \u0bae\u0bb9\u0bbe\u0bb0\u0bcb\u0b95\u0ba8\u0bbf\u0bb5\u0bbe\u0bb0\u0ba3\u0bae\u0bcd \u0965 8\n    \n    \u0baa\u0bc2\u0ba4\u0ba8\u0bbe\u0ba4 \u0bb8\u0ba4\u0bbe\u0ba8\u0b82\u0ba4 \u0bb8\u0bb0\u0bcd\u0bb5\u0baa\u0bc2\u0ba4 \u0ba4\u0baf\u0bbe\u0baa\u0bb0 \u0964\n    \u0bb0\u0b95\u0bcd\u0bb7 \u0bb0\u0b95\u0bcd\u0bb7 \u0bae\u0bb9\u0bbe\u0baa\u0bbe\u0bb9\u0bcb \u0bb6\u0bbe\u0bb8\u0bcd\u0ba4\u0bcd\u0bb0\u0bc7 \u0ba4\u0bc1\u0baa\u0bcd\u0baf\u0b82 \u0ba8\u0bae\u0bcb \u0ba8\u0bae\u0b83 \u0965 9\n    \n    \u0b86\u0bb6\u0bcd\u0baf\u0bbe\u0bae\u0b95\u0bcb\u0bae\u0bb2 \u0bb5\u0bbf\u0bb6\u0bbe\u0bb2\u0ba4\u0ba8\u0bc1\u0b82 \u0bb5\u0bbf\u0b9a\u0bbf\u0ba4\u0bcd\u0bb0\u0b82\n    \u0bb5\u0bbe\u0bb8\u0bcb\u0bb5\u0bb8\u0bbe\u0ba8\u0bae\u0bb0\u0bc1\u0ba3\u0bcb\u0ba4\u0bcd\u0baa\u0bb2\u0ba4\u0bbe\u0bae\u0bb9\u0bb8\u0bcd\u0ba4\u0bae\u0bcd \u0964\n    \u0b89\u0ba4\u0bcd\u0ba4\u0bc1\u0b82\u0b95\u0bb0\u0ba4\u0bcd\u0ba8\u0bae\u0b95\u0bc1\u0b9f\u0b82 \u0b95\u0bc1\u0b9f\u0bbf\u0bb2\u0bbe\u0b95\u0bcd\u0bb0\u0b95\u0bc7\u0bb6\u0b82\n    \u0bb6\u0bbe\u0bb8\u0bcd\u0ba4\u0bbe\u0bb0\u0bae\u0bbf\u0bb7\u0bcd\u0b9f\u0bb5\u0bb0\u0ba4\u0b82 \u0bb6\u0bb0\u0ba3\u0b82 \u0baa\u0bcd\u0bb0\u0baa\u0ba4\u0bcd\u0baf\u0bc7 \u0965 10",isAudio:!1,audioDurationSec:40,totalTime:"00:40"},{id:"20",slug:"bhajana-keerthanalu",title:"\u0baa\u0b9c\u0ba9\u0bc8 \u0b95\u0bc0\u0bb0\u0bcd\u0ba4\u0bcd\u0ba4\u0ba9\u0bc8\u0b95\u0bb3\u0bcd",description:"[ \u0bb6\u0bcd\u0bb0\u0bc0 \u0b85\u0baf\u0bcd\u0baf\u0baa\u0bcd\u0baa \u0baa\u0b9c\u0ba8 \u0b95\u0bc0\u0bb0\u0bcd\u0ba4\u0ba8\u0bb2\u0bc1 ]\n    \n    1. \u0baa\u0b95\u0bb5\u0bbe\u0ba8\u0bcd \u0bb6\u0bb0\u0ba3\u0b82 \u0baa\u0b95\u0bb5\u0ba4\u0bbf \u0bb6\u0bb0\u0ba3\u0b82\n    \u0baa\u0b95\u0bb5\u0bbe\u0ba8\u0bcd \u0bb6\u0bb0\u0ba3\u0b82 \u0baa\u0b95\u0bb5\u0ba4\u0bbf \u0bb6\u0bb0\u0ba3\u0b82 \u0bb6\u0bb0\u0ba3\u0b82 \u0bb6\u0bb0\u0ba3\u0bae\u0baf\u0bcd\u0baf\u0baa\u0bcd\u0baa\u0bbe\n    \u0baa\u0b95\u0bb5\u0ba4\u0bbf \u0bb6\u0bb0\u0ba3\u0b82 \u0baa\u0b95\u0bb5\u0bbe\u0ba8\u0bcd \u0bb6\u0bb0\u0ba3\u0b82 \u0bb6\u0bb0\u0ba3\u0b82 \u0bb6\u0bb0\u0ba3\u0bae\u0baf\u0bcd\u0baf\u0baa\u0bcd\u0baa\u0bbe\n    \n    \u0ba4\u0bc7\u0bb5\u0ba8\u0bcd \u0bb6\u0bb0\u0ba3\u0b82 \u0ba4\u0bc7\u0bb5\u0bbf \u0bb6\u0bb0\u0ba3\u0b82 \u0bb6\u0bb0\u0ba3\u0b82 \u0bb6\u0bb0\u0ba3\u0bae\u0baf\u0bcd\u0baf\u0baa\u0bcd\u0baa\u0bbe\n    \u0ba4\u0bc7\u0bb5\u0bbf \u0bb6\u0bb0\u0ba3\u0b82 \u0ba4\u0bc7\u0bb5\u0ba8\u0bcd \u0bb6\u0bb0\u0ba3\u0b82 \u0bb6\u0bb0\u0ba3\u0b82 \u0bb6\u0bb0\u0ba3\u0bae\u0baf\u0bcd\u0baf\u0baa\u0bcd\u0baa\u0bbe\n    \n    2. \u0baa\u0bb2\u0bcd\u0bb2\u0bc6\u0b95\u0b9f\u0bcd\u0b9f\u0bc1 \u0bb6\u0baa\u0bb0\u0bbf\u0bae\u0bb2\u0bc8\u0b95\u0bbf\n    \u0baa\u0bb2\u0bcd\u0bb2\u0bc6\u0b95\u0b9f\u0bcd\u0b9f\u0bc1 \u0bb6\u0baa\u0bb0\u0bbf\u0bae\u0bb2\u0bc8\u0b95\u0bbf \u0b95\u0bb2\u0bcd\u0bb2\u0bc1\u0bae\u0bc1\u0bb2\u0bcd\u0bb2\u0bc1 \u0b95\u0bbe\u0bb2\u0bbf\u0b95\u0bc0 \u0bae\u0bc6\u0ba4\u0bcd\u0ba4\u0bc8\n    \u0bb8\u0bcd\u0bb5\u0bbe\u0bae\u0bbf\u0baf\u0bc7 \u0b85\u0baf\u0bcd\u0baf\u0baa\u0bcd\u0baa\u0bcb \u0b85\u0baf\u0bcd\u0baf\u0baa\u0bcd\u0baa\u0bcb \u0bb8\u0bcd\u0bb5\u0bbe\u0bae\u0bbf\u0baf\u0bc7!\n    \n    \u0b87\u0bb0\u0bc1\u0bae\u0bc1\u0b9f\u0bbf \u0ba4\u0bbe\u0b82\u0b95\u0bbf \u0b92\u0bb0\u0bc1\u0bae\u0ba8\u0ba4\u0bbe\u0b95\u0bbf \u0b95\u0bc1\u0bb0\u0bc1\u0bb5\u0bc6\u0ba8 \u0baa\u0ba8\u0bbf\u0b82\u0ba4\u0bc1 \u0bb5\u0b82\u0ba4\u0bcb\u0bae\u0bc7\n    \u0b95\u0bb0\u0bc1\u0baa\u0bcd\u0baa\u0bc1 \u0bb5\u0bbe\u0bb5\u0bb0\u0bc1 \u0bb8\u0bcd\u0bb5\u0bbe\u0bae\u0bbf\u0baf\u0bc7 \u0b8e\u0b82\u0b95\u0bb3\u0bc8 \u0b95\u0bbe\u0baa\u0bbe\u0b9f \u0bb5\u0bc7\u0b82\u0b9f\u0bc1\u0bae\u0bc7\n    \n    3. \u0b85\u0baf\u0bcd\u0baf\u0baa\u0bcd\u0baa\u0bbe \u0ba4\u0bbf\u0b82\u0ba4\u0bbf\u0ba4\u0bcd\u0ba4\u0b95\u0ba4\u0bcb\u0b82\n    \u0bb8\u0bcd\u0bb5\u0bbe\u0bae\u0bbf \u0ba4\u0bbf\u0b82\u0ba4\u0bbf\u0ba4\u0bcd\u0ba4\u0b95\u0ba4\u0bcb\u0b82 \u0b85\u0baf\u0bcd\u0baf\u0baa\u0bcd\u0baa \u0ba4\u0bbf\u0b82\u0ba4\u0bbf\u0ba4\u0bcd\u0ba4\u0b95\u0ba4\u0bcb\u0b82\n    \u0b8e\u0bb0\u0bc1\u0bae\u0bc7\u0bb2\u0bbf \u0bb6\u0bbe\u0bb8\u0bcd\u0ba4\u0bbe \u0ba4\u0bbf\u0b82\u0ba4\u0bbf\u0ba4\u0bcd\u0ba4\u0b95\u0ba4\u0bcb\u0b82\n    \u0b95\u0ba8\u0bcd\u0ba8\u0bbf\u0bae\u0bc2\u0bb2 \u0b95\u0ba3\u0baa\u0ba4\u0bbf \u0ba4\u0bbf\u0b82\u0ba4\u0bbf\u0ba4\u0bcd\u0ba4\u0b95\u0ba4\u0bcb\u0b82\n    \u0bae\u0bbe\u0bb3\u0bbf\u0b95\u0bbe\u0baa\u0bc1\u0bb0\u0ba4\u0bcd\u0ba4\u0bae\u0bcd\u0bae \u0ba4\u0bbf\u0b82\u0ba4\u0bbf\u0ba4\u0bcd\u0ba4\u0b95\u0ba4\u0bcb\u0b82\n    \n    \u0bb8\u0bcd\u0bb5\u0bbe\u0bae\u0bbf\u0baf\u0bc7 \u0bb6\u0bb0\u0ba3\u0b82 \u0b85\u0baf\u0bcd\u0baf\u0baa\u0bcd\u0baa!",isAudio:!1,audioDurationSec:40,totalTime:"00:40"},{id:"21",slug:"harivarasanam",title:"\u0bb9\u0bb0\u0bbf\u0bb5\u0bb0\u0bbe\u0b9a\u0ba9\u0bae\u0bcd",description:"\u0bb9\u0bb0\u0bbf\u0bb5\u0bb0\u0bbe\u0bb8\u0ba8\u0b82 \u0bb5\u0bbf\u0bb6\u0bcd\u0bb5\u0bae\u0bcb\u0bb9\u0ba8\u0b82 \u0bb9\u0bb0\u0bbf\u0ba4\u0ba4\u0bc0\u0bb6\u0bcd\u0bb5\u0bb0\u0b82 \u0b86\u0bb0\u0bbe\u0ba4\u0bcd\u0baf\u0baa\u0bbe\u0ba4\u0bc1\u0b95\u0b82...",isAudio:!0,audioDurationSec:40,totalTime:"00:40",chantLyric:"\u0bb9\u0bb0\u0bbf\u0bb5\u0bb0\u0bbe\u0b9a\u0ba9\u0bae\u0bcd \u0bb5\u0bbf\u0bb8\u0bcd\u0bb5\u0bae\u0bcb\u0bb9\u0ba9\u0bae\u0bcd \u0bb9\u0bb0\u0bbf\u0ba4\u0ba4\u0bc0\u0bb8\u0bcd\u0bb5\u0bb0\u0bae\u0bcd \u0b86\u0bb0\u0bbe\u0ba4\u0bcd\u0baf\u0baa\u0bbe\u0ba4\u0bc1\u0b95\u0bae\u0bcd"},{id:"22",slug:"koodalmanikya-vishnu-sthuthi",title:"\u0b95\u0bc2\u0b9f\u0bb2\u0bcd\u0bae\u0bbe\u0ba3\u0bbf\u0b95\u0bcd\u0baf \u0bb5\u0bbf\u0bb7\u0bcd\u0ba3\u0bc1 \u0bb8\u0bcd\u0ba4\u0bc1\u0ba4\u0bbf",description:"[ \u0b95\u0bc1\u0b9f\u0bb2\u0bcd\u0baf\u0bbe\u0ba3\u0bbf\u0b95\u0bcd\u0baf (\u0bb5\u0bbf\u0bb7\u0bcd\u0ba3\u0bc1) \u0bb8\u0bcd\u0ba4\u0bc1\u0ba4\u0bbf ]\n    \n    \u0bb6\u0bbe\u0b82\u0ba4\u0bbe\u0b95\u0bbe\u0bb0\u0b82 \u0baa\u0bc1\u0b9c\u0b95\u0bb6\u0baf\u0ba8\u0b82 \u0baa\u0ba4\u0bcd\u0bae\u0ba8\u0bbe\u0baa\u0b82 \u0bb8\u0bc1\u0bb0\u0bc7\u0bb6\u0b82\n    \u0bb5\u0bbf\u0bb6\u0bcd\u0bb5\u0bbe\u0ba4\u0bbe\u0bb0\u0b82 \u0b95\u0b95\u0ba8\u0bb8\u0ba4\u0c43\u0bb6\u0b82 \u0bae\u0bc7\u0b95\u0bb5\u0bb0\u0bcd\u0ba3\u0b82 \u0bb6\u0bc1\u0baa\u0bbe\u0b82\u0b95\u0bae\u0bcd\n    \u0bb2\u0b95\u0bcd\u0bb7\u0bcd\u0bae\u0bc0\u0b95\u0bbe\u0b82\u0ba4\u0b82 \u0b95\u0bae\u0bb2\u0ba8\u0baf\u0ba8\u0b82 \u0baf\u0bcb\u0b95\u0bbf\u0bb9\u0c43\u0ba4\u0bcd\u0ba4\u0bcd\u0baf\u0bbe\u0ba8\u0b95\u0bae\u0bcd\u0baf\u0b82\n    \u0bb5\u0b82\u0ba4\u0bc7 \u0bb5\u0bbf\u0bb7\u0bcd\u0ba3\u0bc1\u0b82 \u0baa\u0bb5\u0baa\u0baf\u0bb9\u0bb0\u0b82 \u0bb8\u0bb0\u0bcd\u0bb5\u0bb2\u0bcb\u0b95\u0bc8\u0b95\u0ba8\u0bbe\u0ba4\u0bae\u0bcd\n    \n    \u0b93\u0b82 \u0ba8\u0bae\u0bcb \u0ba8\u0bbe\u0bb0\u0bbe\u0baf\u0ba3\u0bbe\u0baf\n    \u0b93\u0b82 \u0ba8\u0bae\u0bcb \u0baa\u0b95\u0bb5\u0ba4\u0bc7 \u0bb5\u0bbe\u0bb8\u0bc1\u0ba4\u0bc7\u0bb5\u0bbe\u0baf\n    \n    \u0b95\u0bc1\u0b9f\u0bb2\u0bcd\u0baf\u0bbe\u0ba3\u0bbf\u0b95\u0bcd\u0baf \u0bb8\u0b82\u0b95\u0bae\u0bc7\u0bb6\u0bcd\u0bb5\u0bb0 \u0bb8\u0bcd\u0bb5\u0bbe\u0bae\u0bbf\u0baf\u0bc7 \u0ba8\u0bae\u0b83\n    \u0bb9\u0bb0\u0bbf\u0bb9\u0bb0 \u0bb8\u0bc1\u0ba4\u0ba8\u0bc7 \u0bb6\u0bb0\u0ba3\u0bae\u0baf\u0bcd\u0baf\u0baa\u0bcd\u0baa!",isAudio:!0,audioDurationSec:40,totalTime:"00:40",chantLyric:"\u0bb9\u0bb0\u0bbf\u0bb5\u0bb0\u0bbe\u0b9a\u0ba9\u0bae\u0bcd \u0bb5\u0bbf\u0bb8\u0bcd\u0bb5\u0bae\u0bcb\u0bb9\u0ba9\u0bae\u0bcd \u0bb9\u0bb0\u0bbf\u0ba4\u0ba4\u0bc0\u0bb8\u0bcd\u0bb5\u0bb0\u0bae\u0bcd \u0b86\u0bb0\u0bbe\u0ba4\u0bcd\u0baf\u0baa\u0bbe\u0ba4\u0bc1\u0b95\u0bae\u0bcd"},{id:"23",slug:"shabarimala-temple-opening-dates",title:"\u0b9a\u0baa\u0bb0\u0bbf\u0bae\u0bb2\u0bc8 \u0b95\u0bcb\u0bb5\u0bbf\u0bb2\u0bcd \u0ba8\u0b9f\u0bc8 \u0ba4\u0bbf\u0bb1\u0b95\u0bcd\u0b95\u0bc1\u0bae\u0bcd \u0ba4\u0bc7\u0ba4\u0bbf\u0b95\u0bb3\u0bcd",description:"[ Opening and closing of Sabarimala Sree Dharmasastha Temple for the year (2026 - 2027) ]\n    \u0b95\u0bc7\u0bb0\u0bb3\u0bb2\u0bcb\u0ba8\u0bbf \u0bb6\u0baa\u0bb0\u0bbf\u0bae\u0bb2 \u0b85\u0baf\u0bcd\u0baf\u0baa\u0bcd\u0baa \u0b86\u0bb2\u0baf\u0b82 \u0bb8\u0b82\u0bb5\u0ba4\u0bcd\u0bb8\u0bb0\u0b82\u0bb2\u0bcb \u0b95\u0bca\u0ba8\u0bcd\u0ba8\u0bbf \u0ba8\u0bbf\u0bb0\u0bcd\u0ba4\u0bbf\u0bb7\u0bcd\u0b9f \u0bb8\u0bae\u0baf\u0bbe\u0bb2\u0bcd\u0bb2\u0bcb \u0bae\u0bbe\u0ba4\u0bcd\u0bb0\u0bae\u0bc7 \u0ba4\u0bb0\u0bcd\u0bb6\u0ba8\u0bbe\u0bb0\u0bcd\u0ba4\u0b82 \u0ba4\u0bc6\u0bb0\u0bb5\u0baa\u0b9f\u0bc1\u0ba4\u0bc1\u0b82\u0ba4\u0bbf. \u0b95\u0bcd\u0bb0\u0bbf\u0b82\u0ba4 2026 - 2027 \u0bb8\u0b82\u0bb5\u0ba4\u0bcd\u0bb8\u0bb0\u0b82\u0bb2\u0bcb \u0bb6\u0baa\u0bb0\u0bbf\u0bae\u0bb2 \u0b85\u0baf\u0bcd\u0baf\u0baa\u0bcd\u0baa \u0b86\u0bb2\u0baf\u0b82 \u0ba4\u0bc6\u0bb0\u0bbf\u0b9a\u0bbf \u0b89\u0b82\u0b9f\u0bc7 \u0ba4\u0bc7\u0ba4\u0bc0\u0bb2 \u0bb5\u0bbf\u0bb5\u0bb0\u0bbe\u0bb2\u0bc1 \u0b89\u0ba8\u0bcd\u0ba8\u0bbe\u0baf\u0bbf.\n    \n    \u0b93\u0b82 \u0bb6\u0bcd\u0bb0\u0bc0 \u0bb8\u0bcd\u0bb5\u0bbe\u0bae\u0bbf\u0baf\u0bc7 \u0bb6\u0bb0\u0ba3\u0b82 \u0b85\u0baf\u0bcd\u0baf\u0baa\u0bcd\u0baa\n    \n    [ \u0b95\u0ba4 \u0bb8\u0b82\u0bb5\u0ba4\u0bcd\u0bb8\u0bb0\u0b82 2025 \u0bae\u0b82\u0b9f\u0bb2 \u0baa\u0bc2\u0b9c & \u0ba4\u0bbf\u0bb0\u0bc1\u0ba8\u0b9f\u0bc8 \u0ba4\u0bbf\u0bb0\u0baa\u0bcd\u0baa\u0bc1 - 2026 \u0bae\u0b95\u0bb0\u0bb5\u0bbf\u0bb3\u0b95\u0bcd\u0b95\u0bc1 \u0bae\u0bb9\u0bcb\u0ba4\u0bcd\u0bb8\u0bb5\u0b82 ]\n    \u2022 \u0b9f\u0bbf\u0bb8\u0bc6\u0b82\u0baa\u0bb0\u0bcd 2025 : \u0bae\u0b82\u0b9f\u0bb2 \u0baa\u0bc2\u0b9c (\u0ba4\u0bc6\u0bb0\u0bbf\u0b9a\u0bc7 \u0ba4\u0bc7\u0ba4\u0bc0: 16/11/2025 \u2013 \u0bae\u0bc1\u0b95\u0bbf\u0b82\u0baa\u0bc1: 27/12/2025)\n    \u2022 \u0b9f\u0bbf\u0bb8\u0bc6\u0b82\u0baa\u0bb0\u0bcd 2025 : \u0ba4\u0bbf\u0bb0\u0bc1\u0ba8\u0b9f\u0bc8 \u0ba4\u0bbf\u0bb0\u0baa\u0bcd\u0baa\u0bc1 - \u0bae\u0b95\u0bb0\u0bb5\u0bbf\u0bb3\u0b95\u0bcd\u0b95\u0bc1 \u0bae\u0bb9\u0bcb\u0ba4\u0bcd\u0bb8\u0bb5\u0b82 (\u0ba4\u0bc6\u0bb0\u0bbf\u0b9a\u0bc7 \u0ba4\u0bc7\u0ba4\u0bc0: 30/12/2025 \u2013 \u0bae\u0bc1\u0b95\u0bbf\u0b82\u0baa\u0bc1: 20/01/2026)\n    \n    \u0b93\u0b82 \u0bb6\u0bcd\u0bb0\u0bc0 \u0bb8\u0bcd\u0bb5\u0bbe\u0bae\u0bbf\u0baf\u0bc7 \u0bb6\u0bb0\u0ba3\u0b82 \u0b85\u0baf\u0bcd\u0baf\u0baa\u0bcd\u0baa\n    \n    [ 2026-2027 \u0b86\u0bb2\u0baf\u0b82 \u0ba4\u0bc6\u0bb0\u0bbf\u0b9a\u0bc7 \u0bae\u0bb0\u0bbf\u0baf\u0bc1 \u0bae\u0bc1\u0b95\u0bbf\u0bb8\u0bc7 \u0ba4\u0bc7\u0ba4\u0bc0\u0bb2 \u0baa\u0b9f\u0bcd\u0b9f\u0bbf\u0b95 ]\n    \u2022 \u0b9c\u0ba8\u0bb5\u0bb0\u0bbf 2026 : \u0bae\u0b95\u0bb0\u0bb5\u0bbf\u0bb3\u0b95\u0bcd\u0b95\u0bc1 \u0ba4\u0bbf\u0ba8\u0b82 (14/01/2026 \u2013 20/01/2026)\n    \u2022 \u0baa\u0bbf\u0baa\u0bcd\u0bb0\u0bb5\u0bb0\u0bbf 2026 : \u0bae\u0bbe\u0bb8 \u0baa\u0bc2\u0b9c - \u0b95\u0bc1\u0b82\u0baa\u0b82 (12/02/2026 \u0bb8\u0bbe\u0baf\u0b82\u0ba4\u0bcd\u0bb0\u0b82 5\u0b95\u0b82 \u2013 17/02/2026 \u0bb0\u0bbe\u0ba4\u0bcd\u0bb0\u0bbf 10\u0b95\u0b82)\n    \u2022 \u0bae\u0bbe\u0bb0\u0bcd\u0b9a\u0bbf 2026 : \u0bae\u0bbe\u0bb8 \u0baa\u0bc2\u0b9c - \u0bae\u0bc0\u0ba8\u0b82 (14/03/2026 \u0bb8\u0bbe\u0baf\u0b82\u0ba4\u0bcd\u0bb0\u0b82 5\u0b95\u0b82 \u2013 19/03/2026 \u0bb0\u0bbe\u0ba4\u0bcd\u0bb0\u0bbf 10\u0b95\u0b82)\n    \u2022 \u0bae\u0bbe\u0bb0\u0bcd\u0b9a\u0bbf 2026 : \u0bb6\u0baa\u0bb0\u0bbf\u0bae\u0bb2 \u0b89\u0ba4\u0bcd\u0bb8\u0bb5\u0b82 (22/03/2026 \u0bb8\u0bbe\u0baf\u0b82\u0ba4\u0bcd\u0bb0\u0b82 5\u0b95\u0b82 \u2013 01/04/2026 \u0bb0\u0bbe\u0ba4\u0bcd\u0bb0\u0bbf 10\u0b95\u0b82)\n    \u2022 \u0bae\u0bbe\u0bb0\u0bcd\u0b9a\u0bbf 2026 : \u0b95\u0bca\u0b9f\u0bbf\u0baf\u0bc7\u0b9f\u0bcd\u0b9f\u0bc1 (\u0ba4\u0bcd\u0bb5\u0b9c\u0bbe\u0bb0\u0bcb\u0bb9\u0ba3\u0b82) (23/03/2026)\n    \u2022 \u0b8f\u0baa\u0bcd\u0bb0\u0bbf\u0bb2\u0bcd 2026 : \u0baa\u0b82\u0b95\u0bc1\u0ba8\u0bbf \u0b89\u0ba4\u0bcd\u0bb0\u0b82 & \u0b86\u0bb0\u0bbe\u0b9f\u0bcd\u0b9f\u0bc1 (01/04/2026 \u2013 01/04/2026 \u0bb0\u0bbe\u0ba4\u0bcd\u0bb0\u0bbf 10\u0b95\u0b82)\n    \u2022 \u0b8f\u0baa\u0bcd\u0bb0\u0bbf\u0bb2\u0bcd 2026 : \u0bae\u0bc7\u0b9f \u0bb5\u0bbf\u0bb7\u0bc1 \u0baa\u0b82\u0b9f\u0bc1\u0b95 (11/04/2026 \u0bb8\u0bbe\u0baf\u0b82\u0ba4\u0bcd\u0bb0\u0b82 5\u0b95\u0b82 \u2013 18/04/2026 \u0bb0\u0bbe\u0ba4\u0bcd\u0bb0\u0bbf 10\u0b95\u0b82)\n    \u2022 \u0b8f\u0baa\u0bcd\u0bb0\u0bbf\u0bb2\u0bcd 2026 : \u0bb5\u0bbf\u0bb7\u0bc1 \u0ba4\u0bbf\u0ba8\u0b82 (15/04/2026)\n    \u2022 \u0bae\u0bc7 2026 : \u0bae\u0bbe\u0bb8 \u0baa\u0bc2\u0b9c - \u0b8e\u0b9f\u0bb5\u0bae\u0bcd (14/05/2026 \u0bb8\u0bbe\u0baf\u0b82\u0ba4\u0bcd\u0bb0\u0b82 5\u0b95\u0b82 \u2013 19/05/2026 \u0bb0\u0bbe\u0ba4\u0bcd\u0bb0\u0bbf 10\u0b95\u0b82)\n    \u2022 \u0bae\u0bc7 2026 : \u0baa\u0bcd\u0bb0\u0ba4\u0bbf\u0bb7\u0bcd\u0b9f\u0bbe \u0ba4\u0bbf\u0ba8 \u0baa\u0bc2\u0b9c (25/05/2026 \u2013 26/05/2026)\n    \u2022 \u0b9c\u0bc2\u0ba8\u0bcd 2026 : \u0bae\u0bbe\u0bb8 \u0baa\u0bc2\u0b9c - \u0bae\u0bbf\u0ba4\u0bc1\u0ba8\u0b82 (14/06/2026 \u0bb8\u0bbe\u0baf\u0b82\u0ba4\u0bcd\u0bb0\u0b82 5\u0b95\u0b82 \u2013 19/06/2026 \u0bb0\u0bbe\u0ba4\u0bcd\u0bb0\u0bbf 10\u0b95\u0b82)\n    \u2022 \u0b9c\u0bc2\u0bb2\u0bc8 2026 : \u0bae\u0bbe\u0bb8 \u0baa\u0bc2\u0b9c - \u0b95\u0bb0\u0bcd\u0b95\u0b9f\u0b95\u0b82 (16/07/2026 \u0bb8\u0bbe\u0baf\u0b82\u0ba4\u0bcd\u0bb0\u0b82 5\u0b95\u0b82 \u2013 21/07/2026 \u0bb0\u0bbe\u0ba4\u0bcd\u0bb0\u0bbf 10\u0b95\u0b82)\n    \u2022 \u0b86\u0b95\u0bb8\u0bcd\u0b9f\u0bc1 2026 : \u0bae\u0bbe\u0bb8 \u0baa\u0bc2\u0b9c - \u0b9a\u0bbf\u0b82\u0b95\u0b82 (16/08/2026 \u0bb8\u0bbe\u0baf\u0b82\u0ba4\u0bcd\u0bb0\u0b82 5\u0b95\u0b82 \u2013 21/08/2026 \u0bb0\u0bbe\u0ba4\u0bcd\u0bb0\u0bbf 10\u0b95\u0b82)\n    \u2022 \u0b86\u0b95\u0bb8\u0bcd\u0b9f\u0bc1 2026 : \u0b93\u0ba3\u0b82 \u0baa\u0bc2\u0b9c (24/08/2026 \u2013 28/08/2026)\n    \u2022 \u0b86\u0b95\u0bb8\u0bcd\u0b9f\u0bc1 2026 : \u0b93\u0ba3\u0b82 \u0ba4\u0bbf\u0ba8\u0b82 (26/08/2026)\n    \u2022 \u0bb8\u0bc6\u0baa\u0bcd\u0b9f\u0bc6\u0b82\u0baa\u0bb0\u0bcd 2026 : \u0bae\u0bbe\u0bb8 \u0baa\u0bc2\u0b9c - \u0b95\u0ba8\u0bcd\u0ba8\u0bbf (16/09/2026 \u0bb8\u0bbe\u0baf\u0b82\u0ba4\u0bcd\u0bb0\u0b82 5\u0b95\u0b82 \u2013 21/09/2026 \u0bb0\u0bbe\u0ba4\u0bcd\u0bb0\u0bbf 10\u0b95\u0b82)\n    \u2022 \u0b85\u0b95\u0bcd\u0b9f\u0bcb\u0baa\u0bb0\u0bcd 2026 : \u0bae\u0bbe\u0bb8 \u0baa\u0bc2\u0b9c - \u0ba4\u0bc1\u0bb2\u0b82 (17/10/2026 \u0bb8\u0bbe\u0baf\u0b82\u0ba4\u0bcd\u0bb0\u0b82 5\u0b95\u0b82 \u2013 22/10/2026 \u0bb0\u0bbe\u0ba4\u0bcd\u0bb0\u0bbf 10\u0b95\u0b82)\n    \u2022 \u0ba8\u0bb5\u0b82\u0baa\u0bb0\u0bcd 2026 : \u0bb6\u0bcd\u0bb0\u0bc0 \u0b9a\u0bbf\u0ba4\u0bcd\u0bb0 \u0b85\u0b9f\u0bcd\u0b9f \u0ba4\u0bbf\u0bb0\u0bc1\u0ba8\u0bbe\u0bb3\u0bcd (06/11/2026 \u0bb8\u0bbe\u0baf\u0b82\u0ba4\u0bcd\u0bb0\u0b82 5\u0b95\u0b82 \u2013 07/11/2026 \u0bb0\u0bbe\u0ba4\u0bcd\u0bb0\u0bbf 10\u0b95\u0b82)\n    \u2022 \u0ba8\u0bb5\u0b82\u0baa\u0bb0\u0bcd 2026 : \u0bae\u0b82\u0b9f\u0bb2 \u0baa\u0bc2\u0b9c \u0bae\u0bb9\u0bcb\u0ba4\u0bcd\u0bb8\u0bb5\u0b82 (16/11/2026 \u0bb8\u0bbe\u0baf\u0b82\u0ba4\u0bcd\u0bb0\u0b82 5\u0b95\u0b82 \u2013 27/12/2026)\n    \u2022 \u0b9f\u0bbf\u0bb8\u0bc6\u0b82\u0baa\u0bb0\u0bcd 2026 : \u0bae\u0b82\u0b9f\u0bb2 \u0baa\u0bc2\u0b9c (27/12/2026)\n    \u2022 \u0b9f\u0bbf\u0bb8\u0bc6\u0b82\u0baa\u0bb0\u0bcd 2026 : \u0ba4\u0bbf\u0bb0\u0bc1\u0ba8\u0b9f\u0bc8 \u0ba4\u0bbf\u0bb0\u0baa\u0bcd\u0baa\u0bc1 - \u0bae\u0b95\u0bb0\u0bb5\u0bbf\u0bb3\u0b95\u0bcd\u0b95\u0bc1 \u0bae\u0bb9\u0bcb\u0ba4\u0bcd\u0bb8\u0bb5\u0b82 (30/12/2026 \u2013 20/01/2027)\n    \u2022 \u0b9c\u0ba8\u0bb5\u0bb0\u0bbf 2027 : \u0bae\u0b95\u0bb0\u0bb5\u0bbf\u0bb3\u0b95\u0bcd\u0b95\u0bc1 \u0ba4\u0bbf\u0ba8\u0b82 (14/01/2027)\n    \n    [ \u0bae\u0bc1\u0b95\u0bcd\u0baf \u0b95\u0bae\u0ba8\u0bbf\u0b95 ]\n    \u0bb6\u0baa\u0bb0\u0bbf\u0bae\u0bb2 \u0b86\u0bb2\u0baf\u0b82 \u0bb8\u0bbe\u0ba4\u0bbe\u0bb0\u0ba3\u0b82\u0b95\u0bbe \u0b89\u0ba4\u0baf\u0b82 05.00 \u0b95\u0b82\u0b9f\u0bb2\u0b95\u0bc1 \u0ba4\u0bc6\u0bb0\u0bc1\u0bb5\u0baa\u0b9f\u0bc1\u0ba4\u0bc1\u0b82\u0ba4\u0bbf \u0bae\u0bb0\u0bbf\u0baf\u0bc1 \u0bb0\u0bbe\u0ba4\u0bcd\u0bb0\u0bbf 10.00 \u0b95\u0b82\u0b9f\u0bb2\u0b95\u0bc1 \u0bae\u0bc2\u0bb8\u0bbf\u0bb5\u0bc7\u0baf\u0baa\u0b9f\u0bc1\u0ba4\u0bc1\u0b82\u0ba4\u0bbf. \u0bae\u0b95\u0bb0\u0bb5\u0bbf\u0bb3\u0b95\u0bcd\u0b95\u0bc1 \u0bae\u0bb9\u0bcb\u0ba4\u0bcd\u0bb8\u0bb5\u0b82 \u0bb5\u0b82\u0b9f\u0bbf \u0bb0\u0ba4\u0bcd\u0ba4\u0bc0 \u0bb8\u0bae\u0baf\u0bbe\u0bb2\u0bcd\u0bb2\u0bcb \u0baa\u0b95\u0bcd\u0ba4\u0bc1\u0bb2 \u0bb8\u0b82\u0b95\u0bcd\u0baf\u0ba8\u0bc1 \u0ba4\u0c43\u0bb7\u0bcd\u0b9f\u0bbf\u0bb2\u0bcb \u0b89\u0b82\u0b9a\u0bc1\u0b95\u0bc1\u0ba8\u0bbf \u0b86\u0bb2\u0baf \u0bb8\u0bae\u0baf\u0bbe\u0bb2\u0bb2\u0bcb \u0bae\u0bbe\u0bb0\u0bcd\u0baa\u0bc1\u0bb2\u0bc1 \u0b89\u0b82\u0b9f\u0bb5\u0b9a\u0bcd\u0b9a\u0bc1.",isAudio:!1,audioDurationSec:40,totalTime:"00:40"}],hi:[{id:"1",slug:"2026-uthara-nakshatra-dates",title:"2026 \u0909\u0924\u094d\u0924\u0930\u093e \u0928\u0915\u094d\u0937\u0924\u094d\u0930 \u0924\u093f\u0925\u093f\u092f\u093e\u0902",description:"[ 2026 \u0909\u0924\u094d\u0924\u0930 \u0928\u0915\u094d\u0937\u0924\u094d\u0930 \u0924\u0947\u0926\u0940\u0932\u0941 ]\n\n\u0938\u094d\u0935\u093e\u092e\u093f\u092f\u0947 \u0936\u0930\u0923\u0902 \u0905\u092f\u094d\u092f\u092a\u094d\u092a, \u0905\u092f\u094d\u092f\u092a\u094d\u092a \u091c\u0928\u094d\u092e \u0928\u0915\u094d\u0937\u0924\u094d\u0930\u0902 \u0909\u0924\u094d\u0924\u0930 \u0928\u0915\u094d\u0937\u0924\u094d\u0930\u0902 \u092e\u0941\u0916\u094d\u092f\u0902\u0917\u093e \u092e\u0940\u0928 \u092e\u093e\u0938\u0902(\u0915\u0947\u0930\u0933 \u0928\u0947\u0932)\u0932\u094b \u0935\u091a\u094d\u091a\u0947 \u0909\u0924\u094d\u0924\u0930 \u0928\u0915\u094d\u0937\u0924\u094d\u0930\u0902 \u0930\u094b\u091c\u0941\u0928 \u0905\u092f\u094d\u092f\u092a\u094d\u092a \u0938\u094d\u0935\u093e\u092e\u093f \u091c\u0928\u094d\u092e\u093f\u0902\u091a\u093e\u0921\u0941, \u0915\u093e\u0928\u0940 \u092a\u094d\u0930\u0924\u093f 27 \u0930\u094b\u091c\u0941\u0932\u0915\u0941 \u0913\u0915\u0938\u093e\u0930\u093f \u0909\u0924\u094d\u0924\u0930 \u0928\u0915\u094d\u0937\u0924\u094d\u0930\u0902 \u0935\u0938\u094d\u0924\u0941\u0902\u0926\u093f,\n\n\u0909\u0924\u094d\u0924\u0930 \u0928\u0915\u094d\u0937\u0924\u094d\u0930\u0902 \u0930\u094b\u091c\u0941 \u0905\u092f\u094d\u092f\u092a\u094d\u092a \u092a\u0942\u091c \u091a\u0947\u092f\u093e\u0932\u093f \u0905\u0928\u0941\u0915\u0941\u0928\u0947 \u0935\u093e\u0930\u093f \u0915\u094b\u0938\u0902 \u092a\u094d\u0930\u0924\u093f \u0928\u0947\u0932 \u090f \u0924\u0947\u0926\u0940\u0932\u094b \u0909\u0924\u094d\u0924\u0930 \u0928\u0915\u094d\u0937\u0924\u094d\u0930\u0902 \u0935\u0938\u094d\u0924\u0941\u0902\u0926\u094b \u0924\u0947\u0932\u0941\u0938\u0941\u0915\u094b\u0935\u0921\u093e\u0928\u093f\u0915\u093f \u0907\u0915\u094d\u0915\u0921 \u0907\u0935\u094d\u0935\u0921\u0902 \u091c\u0930\u093f\u0917\u093f\u0902\u0926\u093f,\n\n\u0913\u0915\u094d\u0915\u094b \u0938\u093e\u0930\u093f \u0928\u0947\u0932\u0932\u094b \u0930\u0947\u0902\u0921\u0941 \u0938\u093e\u0930\u094d\u0932\u0941 \u0915\u0942\u0921\u093e \u0909\u0924\u094d\u0924\u0930 \u0928\u0915\u094d\u0937\u0924\u094d\u0930\u0902 \u0935\u0938\u094d\u0924\u0941\u0902\u0926\u093f \u0905\u0928\u0917\u093e \u0928\u0947\u0932 \u092a\u094d\u0930\u093e\u0930\u0902\u092d\u0902\u0932\u094b \u0935\u0938\u094d\u0924\u0947 \u092e\u0933\u094d\u0933\u0940 \u0928\u0947\u0932 \u092e\u0941\u0917\u093f\u0902\u092a\u0941\u0932\u094b \u0915\u0942\u0921\u093e \u0935\u0938\u094d\u0924\u0941\u0902\u0926\u093f \u0917\u092e\u0928\u093f\u0902\u091a\u0917\u0932\u0930\u0941.\u0908 \u0938\u0902\u0935\u0924\u094d\u0938\u0930\u0902 \u090f\u092a\u094d\u0930\u093f\u0932\u094d \u0928\u0947\u0932\u0932\u094b \u092e\u0930\u093f\u092f\u0941 \u0921\u093f\u0938\u0947\u0902\u092c\u0930\u094d \u0928\u0947\u0932\u0932\u094b \u0930\u0947\u0902\u0921\u0941 \u0938\u093e\u0930\u094d\u0932\u0941 \u0909\u0924\u094d\u0924\u0930 \u0928\u0915\u094d\u0937\u0924\u094d\u0930\u0902 \u0935\u091a\u094d\u091a\u093f\u0902\u0926\u093f\n\n\u0938\u094d\u0935\u093e\u092e\u093f\u092f\u0947 \u0936\u0930\u0923\u0902 \u0905\u092f\u094d\u092f\u092a\u094d\u092a 2026 \u0938\u0902\u0935\u0924\u094d\u0938\u0930\u0902 \u090f\u092a\u094d\u0930\u093f\u0932\u094d 1 \u0935 \u0924\u0947\u0926\u0940 \u092a\u0902\u092c \u0906\u0930\u093e\u091f\u094d\u091f\u0941 \u0905\u092f\u094d\u092f\u092a\u094d\u092a \u091c\u0928\u094d\u092e \u0926\u093f\u0928\u0902\n\n| \u0938\u0902\u0916\u094d\u092f No | \u0924\u0947\u0926\u0940 Date | \u0935\u093e\u0930\u0902 Day | \u0928\u0915\u094d\u0937\u0924\u094d\u0930\u0902 Nakshatram |\n| 1 | 8-1-2026 | \u0917\u0941\u0930\u0941\u0935\u093e\u0930\u092e\u0941 | \u0909\u0924\u094d\u0924\u0930 |\n| 2 | 5-2-2026 | \u0917\u0941\u0930\u0941\u0935\u093e\u0930\u092e\u0941 | \u0909\u0924\u094d\u0924\u0930 |\n| 3 | 5-3-2026 | \u0917\u0941\u0930\u0941\u0935\u093e\u0930\u092e\u0941 | \u0909\u0924\u094d\u0924\u0930 |\n| 4 | 1-4-2026 | \u092c\u0941\u0927\u0935\u093e\u0930\u092e\u0941 | \u0909\u0924\u094d\u0924\u0930 |\n| 5 | 28-4-2026 | \u092e\u0902\u0917\u0933\u0935\u093e\u0930\u092e\u0941 | \u0909\u0924\u094d\u0924\u0930 |\n| 6 | 25-5-2026 | \u0938\u094b\u092e\u0935\u093e\u0930\u092e\u0941 | \u0909\u0924\u094d\u0924\u0930 |\n| 7 | 22-6-2026 | \u0938\u094b\u092e\u0935\u093e\u0930\u092e\u0941 | \u0909\u0924\u094d\u0924\u0930 |\n| 8 | 19-7-2026 | \u0906\u0926\u093f\u0935\u093e\u0930\u092e\u0941 | \u0909\u0924\u094d\u0924\u0930 |\n| 9 | 15-8-2026 | \u0936\u0928\u093f\u0935\u093e\u0930\u092e\u0941 | \u0909\u0924\u094d\u0924\u0930 |\n| 10 | 12-9-2026 | \u0936\u0928\u093f\u0935\u093e\u0930\u092e\u0941 | \u0909\u0924\u094d\u0924\u0930 |\n| 11 | 09-10-2026 | \u0936\u0941\u0915\u094d\u0930\u0935\u093e\u0930\u092e\u0941 | \u0909\u0924\u094d\u0924\u0930 |\n| 12 | 05-11-2026 | \u0917\u0941\u0930\u0941\u0935\u093e\u0930\u092e\u0941 | \u0909\u0924\u094d\u0924\u0930 |\n| 13 | 03-12-2026 | \u0917\u0941\u0930\u0941\u0935\u093e\u0930\u092e\u0941 | \u0909\u0924\u094d\u0924\u0930 |\n| 14 | 30-12-2026 | \u092c\u0941\u0927\u0935\u093e\u0930\u092e\u0941 | \u0909\u0924\u094d\u0924\u0930 |",isAudio:!1,audioDurationSec:40,totalTime:"00:40"},{id:"2",slug:"suprabatham",title:"\u0938\u0941\u092a\u094d\u0930\u092d\u093e\u0924\u092e\u094d",description:"\u0915\u094c\u0938\u0932\u094d\u092f\u093e \u0938\u0941\u092a\u094d\u0930\u091c\u093e \u0930\u093e\u092e \u092a\u0942\u0930\u094d\u0935\u093e \u0938\u0902\u0927\u094d\u092f\u093e \u092a\u094d\u0930\u0935\u0930\u094d\u0924\u0924\u0947...",isAudio:!0,audioDurationSec:40,totalTime:"00:40",chantLyric:"\u0939\u0930\u093f\u0935\u0930\u093e\u0938\u0928\u0902 \u0935\u093f\u0936\u094d\u0935\u092e\u094b\u0939\u0928\u0902 \u0939\u0930\u093f\u0926\u0927\u0940\u0936\u094d\u0935\u0930\u0902 \u0906\u0930\u093e\u0927\u094d\u092f\u092a\u093e\u0926\u0941\u0915\u092e\u094d"},{id:"3",slug:"nithya-paarayana-shlokamulu",title:"\u0928\u093f\u0924\u094d\u092f \u092a\u093e\u0930\u093e\u092f\u0923 \u0936\u094d\u0932\u094b\u0915",description:"[ \u0928\u093f\u0924\u094d\u092f\u092a\u093e\u0930\u093e\u092f\u0923 \u0936\u094d\u0932\u094b\u0915\u092e\u0941\u0932\u0941 ]\n\n\u0909\u0926\u092f\u0902 \u0928\u093f\u0926\u094d\u0930\u0928\u0941\u0902\u0921\u093f \u0932\u0947\u0935\u0917\u093e\u0928\u0947 \u0930\u0947\u0902\u0921\u0941 \u0905\u0930\u091a\u0947\u0924\u0941\u0932\u0941 \u0926\u0917\u094d\u0917\u0930\u0917\u093e \u092a\u0947\u091f\u094d\u091f\u093f \u0908 \u0936\u094d\u0932\u094b\u0915\u0902 \u091a\u0926\u0935\u093e\u0932\u093f,\u0905\u0930\u091a\u0947\u0924\u093f\u0932\u094b \u0932\u0915\u094d\u0937\u094d\u092e\u093f,\u0938\u0930\u0938\u094d\u0935\u0924\u093f,\u0917\u094c\u0930\u093f \u0926\u0947\u0935\u0924\u0932\u0941\u0928\u0941 \u0909\u0902\u091f\u093e\u0930\u0941 \u0915\u093e\u092c\u091f\u094d\u091f\u093f \u0935\u093e\u0930\u093f\u0928\u093f \u0938\u094d\u092e\u0930\u093f\u0902\u091a\u0941\u0915\u094b\u0935\u093e\u0932\u093f\n\n[ \u092a\u094d\u0930\u092d\u093e\u0924 \u0936\u094d\u0932\u094b\u0915\u0902 ]\n\u0915\u0930\u093e\u0917\u094d\u0930\u0947 \u0935\u0938\u0924\u0947 \u0932\u0915\u094d\u0937\u094d\u092e\u0940\u0903 \u0915\u0930\u092e\u0927\u094d\u092f\u0947 \u0938\u0930\u0938\u094d\u0935\u0924\u0940 |\n\u0915\u0930\u092e\u0942\u0932\u0947 \u0938\u094d\u0925\u093f\u0924\u093e \u0917\u094c\u0930\u0940 \u092a\u094d\u0930\u092d\u093e\u0924\u0947 \u0915\u0930\u0926\u0930\u094d\u0936\u0928\u092e\u094d ||\n\n\u0909\u0926\u092f\u0902 \u0928\u093f\u0926\u094d\u0930\u0928\u0941\u0902\u0921\u093f \u0932\u0947\u0935\u0917\u093e\u0928\u0947 \u092d\u0942\u092e\u093f\u092a\u0948\u0928 \u0915\u093e\u0932\u0941 \u092a\u0947\u091f\u094d\u091f\u0947 \u092e\u0941\u0902\u0926\u0941 \u092d\u0942\u0926\u0947\u0935\u093f\u0928\u093f \u0938\u094d\u092e\u0930\u093f\u0938\u094d\u0924\u0942 \u092e\u0928 \u0915\u093e\u0932\u0941 \u092a\u0947\u0921\u0941\u0924\u0941\u0928\u094d\u0928\u0902\u0926\u0941\u0915\u0941 \u0915\u094d\u0937\u0947\u092e\u093f\u0902\u091a\u092e\u0928\u093f \u0908 \u0915\u094d\u0930\u093f\u0902\u0926\u093f \u0936\u094d\u0932\u094b\u0915\u0902 \u091a\u0926\u0935\u093e\u0932\u093f\n\n[ \u092a\u094d\u0930\u093e\u0924\u0903\u0915\u093e\u0932 \u092d\u0942 \u0936\u094d\u0932\u094b\u0915\u0902 ]\n\u0938\u092e\u0941\u0926\u094d\u0930 \u0935\u0938\u0928\u0947 \u0926\u0947\u0935\u093f \u092a\u0930\u094d\u0935\u0924 \u0938\u094d\u0924\u0928 \u092e\u0902\u0921\u0932\u0947 |\n\u0935\u093f\u0937\u094d\u0923\u0941\u092a\u0924\u094d\u0928\u093f \u0928\u092e\u0938\u094d\u0924\u0941\u092d\u094d\u092f\u0902, \u092a\u093e\u0926\u0938\u094d\u092a\u0930\u094d\u0936\u0902 \u0915\u094d\u0937\u092e\u0938\u094d\u0935\u092e\u0947 ||\n\n\u0938\u094d\u0928\u093e\u0928\u0902 \u091a\u0947\u0938\u094d\u0924\u0942 \u0908 \u0915\u094d\u0930\u093f\u0902\u0926\u093f \u0936\u094d\u0932\u094b\u0915\u0902 \u092a\u0920\u093f\u0902\u091a\u093e\u0932\u093f\n\n[ \u0938\u094d\u0928\u093e\u0928 \u0936\u094d\u0932\u094b\u0915\u0902 ]\n\u0917\u0902\u0917\u0947 \u091a \u092f\u092e\u0941\u0928\u0947 \u091a\u0948\u0935 \u0917\u094b\u0926\u093e\u0935\u0930\u0940 \u0938\u0930\u0938\u094d\u0935\u0924\u0940\n\u0928\u0930\u094d\u092e\u0926\u0947 \u0938\u093f\u0902\u0927\u0941 \u0915\u093e\u0935\u0947\u0930\u0940 \u091c\u0932\u0947\u0938\u094d\u092e\u093f\u0928\u094d \u0938\u0928\u094d\u0928\u093f\u0927\u093f\u0902 \u0915\u0941\u0930\u0941 ||\n\n\u0938\u094d\u0928\u093e\u0928\u0902 \u091a\u0947\u0938\u093e\u0915 \u092d\u0938\u094d\u092e\u0902 \u0927\u0930\u093f\u0938\u094d\u0924\u0942 \u0908 \u0915\u094d\u0930\u093f\u0902\u0926\u093f \u0936\u094d\u0932\u094b\u0915\u0902 \u091a\u0947\u092a\u094d\u092a\u0941\u0915\u094b\u0935\u093e\u0932\u093f\n\n[ \u092d\u0938\u094d\u092e \u0927\u093e\u0930\u0923 \u0936\u094d\u0932\u094b\u0915\u0902 ]\n\u0936\u094d\u0930\u0940\u0915\u0930\u0902 \u091a \u092a\u0935\u093f\u0924\u094d\u0930\u0902\u091a \u0936\u094b\u0915\u0930\u0930\u094b\u0917 \u0928\u093f\u0935\u093e\u0930\u0923\u092e\u094d |\n\u0932\u094b\u0915\u0947 \u0935\u0936\u0940\u0915\u0930\u0902 \u092a\u0941\u0902\u0938\u093e\u0902 \u092d\u0938\u094d\u092e\u0902 \u0924\u094d\u0930\u0948\u0932\u094b\u0915\u094d\u092f \u092a\u093e\u0935\u0928\u092e\u094d ||\n\n\u0917\u0902\u0927\u0902 \u0927\u0930\u093f\u0938\u094d\u0924\u0942 \u0908 \u0915\u094d\u0930\u093f\u0902\u0926\u093f \u0936\u094d\u0932\u094b\u0915\u0902 \u091a\u0947\u092a\u094d\u092a\u0941\u0915\u094b\u0935\u093e\u0932\u093f\n\n[ \u090a\u0930\u094d\u0927\u094d\u0935\u092a\u0941\u0902\u0921\u094d\u0930 \u0927\u093e\u0930\u0923 \u092e\u0902\u0924\u094d\u0930\u0902 ]\n\u0932\u0932\u093e\u091f\u0947 \u0938\u0924\u0924\u0902 \u0926\u0947\u0935\u094d\u092f\u093e \u0936\u094d\u0930\u093f\u092f\u093e \u0938\u0939 \u0935\u093f\u0930\u093e\u091c\u093f\u0924\u092e\u094d|\n\u091a\u0924\u0941\u0936\u094d\u091a\u0915\u094d\u0930\u0902 \u0928\u092e\u0938\u094d\u092f\u093e\u092e\u093f \u0915\u0947\u0935\u0932\u0902 \u0915\u0928\u0915 \u092a\u094d\u0930\u092d\u092e\u094d.||\n\n\u0915\u0941\u0902\u0915\u0941\u092e \u092a\u0947\u091f\u094d\u091f\u0941\u0915\u0941\u0902\u091f\u0942 \u0908 \u0915\u094d\u0930\u093f\u0902\u0926\u093f \u0936\u094d\u0932\u094b\u0915\u0902 \u091a\u0947\u092a\u094d\u092a\u0941\u0915\u094b\u0935\u093e\u0932\u093f\n\n[ \u0915\u0941\u0902\u0915\u0941\u092e\u0927\u093e\u0930\u0923 ]\n\u0915\u0941\u0902\u0915\u0941\u092e\u0902 \u0936\u094b\u092d\u0928\u0902 \u0926\u093f\u0935\u094d\u092f\u0902 \u0938\u0930\u094d\u0935\u0926\u093e \u092e\u0902\u0917\u0933\u092a\u094d\u0930\u0926\u0902 |\n\u0927\u093e\u0930\u0923\u0947\u0928\u093e\u0938\u094d\u092f \u0936\u0941\u092d\u0926\u0902 \u0936\u093e\u0902\u0924\u093f\u0930\u0938\u094d\u0924\u0941 \u0938\u0926\u093e \u092e\u092e ||\n\n\u0926\u0940\u092a\u0902 \u0935\u0947\u0932\u093f\u0917\u093f\u0938\u094d\u0924\u0942 \u0926\u0940\u092a\u0902 \u0926\u0930\u094d\u0936\u0928\u0902 \u091a\u0947\u0938\u0941\u0915\u0941\u0902\u091f\u0942 \u0908 \u0915\u094d\u0930\u093f\u0902\u0926\u093f \u0936\u094d\u0932\u094b\u0915\u0902 \u091a\u0947\u092a\u094d\u092a\u0941\u0915\u094b\u0935\u093e\u0932\u093f\n\n[ \u0938\u0902\u0927\u094d\u092f\u093e \u0926\u0940\u092a \u0926\u0930\u094d\u0936\u0928 \u0936\u094d\u0932\u094b\u0915\u0902 ]\n\u0926\u0940\u092a\u0902 \u091c\u094d\u092f\u094b\u0924\u093f \u092a\u0930\u092c\u094d\u0930\u0939\u094d\u092e \u0926\u0940\u092a\u0902 \u0938\u0930\u094d\u0935\u0924\u092e\u094b\u092a\u0939\u0902 |\n\u0926\u0940\u092a\u0947\u0928 \u0938\u093e\u0927\u094d\u092f\u0924\u0947 \u0938\u0930\u094d\u0935\u0902 \u0938\u0902\u0927\u094d\u092f\u093e \u0926\u0940\u092a\u0902 \u0928\u092e\u094b\u0938\u094d\u0924\u0941\u0924\u0947 ||\n\n\u0926\u0947\u0935\u0941\u0921\u093f \u0917\u0926\u093f\u0932\u094b \u0926\u0940\u092a\u0902 \u0935\u0947\u0932\u093f\u0917\u093f\u0902\u091a\u093f\u0928 \u0924\u0930\u0941\u0935\u093e\u0924 \u0935\u093f\u0935\u093f\u0927 \u0926\u0947\u0935\u0924\u0932\u0928\u0941 \u0938\u094d\u092e\u0930\u093f\u0902\u091a\u0941\u0915\u094b\u0935\u093e\u0932\u093f \u0935\u093f\u0935\u093f\u0927 \u0926\u0947\u0935\u0924\u0932 \u0936\u094d\u0932\u094b\u0915\u092e\u0941\u0932\u0941\n\n[ \u0936\u094d\u0930\u0940 \u0917\u0923\u0947\u0936 \u0938\u094d\u0924\u094b\u0924\u094d\u0930\u0902 ]\n\u0936\u0941\u0915\u094d\u0932\u093e\u0902 \u092c\u0930\u0927\u0930\u0902 \u0935\u093f\u0937\u094d\u0923\u0941\u0902 \u0936\u0936\u093f\u0935\u0930\u094d\u0923\u092e\u094d \u091a\u0924\u0941\u0930\u094d\u092d\u0941\u091c\u0902 |\n\u092a\u094d\u0930\u0938\u0928\u094d\u0928\u0935\u0926\u0928\u0902 \u0927\u094d\u092f\u093e\u092f\u0947\u0924\u094d \u0938\u0930\u094d\u0935 \u0935\u093f\u0918\u094d\u0928\u094b\u092a\u0936\u093e\u0902\u0924\u092f\u0947 ||\n\u0905\u0917\u091c\u093e\u0928\u0928 \u092a\u0926\u094d\u092e\u093e\u0930\u094d\u0915\u0902 \u0917\u091c\u093e\u0928\u0928 \u092e\u0939\u0930\u094d\u0928\u093f\u0936\u092e\u094d |\n\u0905\u0928\u0947\u0915\u0926\u0902\u0924\u0902 \u092d\u0915\u094d\u0924\u093e\u0928\u093e-\u092e\u0947\u0915\u0926\u0902\u0924-\u092e\u0941\u092a\u093e\u0938\u094d\u092e\u0939\u0947 ||\n\n[ \u0936\u094d\u0930\u0940 \u0938\u0930\u0938\u094d\u0935\u0924\u0940 \u0936\u094d\u0932\u094b\u0915\u0902 ]\n\u0938\u0930\u0938\u094d\u0935\u0924\u0940 \u0928\u092e\u0938\u094d\u0924\u0941\u092d\u094d\u092f\u0902 \u0935\u0930\u0926\u0947 \u0915\u093e\u092e\u0930\u0942\u092a\u093f\u0923\u0940 |\n\u0935\u093f\u0926\u094d\u092f\u093e\u0930\u0902\u092d\u0902 \u0915\u0930\u093f\u0937\u094d\u092f\u093e\u092e\u093f \u0938\u093f\u0926\u094d\u0927\u093f\u0930\u094d\u092d\u0935\u0924\u0941 \u092e\u0947 \u0938\u0926\u093e ||\n\u092f\u093e \u0915\u0941\u0902\u0926\u0947\u0902\u0926\u0941 \u0924\u0941\u0937\u093e\u0930 \u0939\u093e\u0930 \u0927\u0935\u0933\u093e, \u092f\u093e \u0936\u0941\u092d\u094d\u0930 \u0935\u0938\u094d\u0924\u094d\u0930\u093e\u0935\u0943\u0924\u093e |\n\u092f\u093e \u0935\u0940\u0923\u093e \u0935\u0930\u0926\u0902\u0921 \u092e\u0902\u0921\u093f\u0924 \u0915\u0930\u093e, \u092f\u093e \u0936\u094d\u0935\u0947\u0924 \u092a\u0926\u094d\u092e\u093e\u0938\u0928\u093e |\n\u092f\u093e \u092c\u094d\u0930\u0939\u094d\u092e\u093e\u091a\u094d\u092f\u0941\u0924 \u0936\u0902\u0915\u0930 \u092a\u094d\u0930\u092d\u0943\u0924\u093f\u092d\u093f\u0930\u094d-\u0926\u0947\u0935\u0948\u0903 \u0938\u0926\u093e \u092a\u0942\u091c\u093f\u0924\u093e |\n\u0938\u093e \u092e\u093e\u092e\u094d \u092a\u093e\u0924\u0941 \u0938\u0930\u0938\u094d\u0935\u0924\u0940 \u092d\u0917\u0935\u0924\u0940 \u0928\u093f\u0936\u094d\u0936\u0947\u0937\u091c\u093e\u0921\u094d\u092f\u093e\u092a\u0939\u093e ||\n\n[ \u0917\u0941\u0930\u0941 \u0936\u094d\u0932\u094b\u0915\u0902 ]\n\u0917\u0941\u0930\u0941\u0930\u094d\u092c\u094d\u0930\u0939\u094d\u092e\u093e \u0917\u0941\u0930\u0941\u0930\u094d\u0935\u093f\u0937\u094d\u0923\u0941\u0903 \u0917\u0941\u0930\u0941\u0930\u094d\u0926\u0947\u0935\u094b \u092e\u0939\u0947\u0936\u094d\u0935\u0930\u0903 |\n\u0917\u0941\u0930\u0941\u0903 \u0938\u093e\u0915\u094d\u0937\u093e\u0924\u094d \u092a\u0930\u092c\u094d\u0930\u0939\u094d\u092e \u0924\u0938\u094d\u092e\u0948 \u0936\u094d\u0930\u0940 \u0917\u0941\u0930\u0935\u0947 \u0928\u092e\u0903 ||\n\n[ \u0936\u094d\u0930\u0940 \u0917\u093e\u092f\u0924\u094d\u0930\u0940 \u092e\u0902\u0924\u094d\u0930\u0902 ]\n\u0913\u0902 \u092d\u0942\u0930\u094d\u092d\u0941\u0935\u0938\u094d\u0938\u0941\u0935\u0903 \u0924\u0924\u094d\u0938\u0935\u093f\u0924\u0941\u0930\u094d\u0935\u0930\u0947\u0923\u094d\u092f\u0902 |\n\u092d\u0930\u094d\u0917\u094b \u0926\u0947\u0935\u0938\u094d\u092f \u0927\u0940\u092e\u0939\u093f \u0927\u093f\u092f\u094b \u092f\u094b \u0928\u0903 \u092a\u094d\u0930\u091a\u094b\u0926\u092f\u093e\u0924\u094d ||\n\u0926\u0947\u0935\u093f \u0917\u093e\u092f\u0924\u094d\u0930\u0940 \u0938\u093e\u0935\u093f\u0924\u094d\u0930\u0940 \u0924\u094d\u0930\u093f\u092a\u0926\u0947\u0915\u094d\u0937\u0930\u0940 |\n\u0905\u091c\u0930\u0947\u092e\u0930\u0947 \u092e\u093e\u0924\u093e \u0924\u094d\u0930\u093e\u0939\u093f \u092e\u093e\u0902 \u092d\u0935\u0938\u093e\u0917\u0930\u093e\u0924\u094d ||\n\u0928\u092e\u0938\u094d\u0924\u0947 \u0938\u0942\u0930\u094d\u092f\u0938\u0902\u0915\u093e\u0936\u0947 \u0938\u0942\u0930\u094d\u092f\u0938\u093e\u0935\u093f\u0924\u094d\u0930\u093f\u0915\u0947\u092e\u0932\u0947 |\n\u092c\u094d\u0930\u0939\u094d\u092e\u0935\u093f\u0926\u094d\u092f\u0947 \u092e\u0939\u093e\u0935\u093f\u0926\u094d\u092f\u0947 \u0935\u0947\u0926\u092e\u093e\u0924\u0930\u094d\u0928\u092e\u094b\u0938\u094d\u0924\u0941 \u0924\u0947 ||\n\n[ \u0936\u094d\u0930\u0940 \u0936\u093f\u0935 \u0938\u094d\u0924\u094b\u0924\u094d\u0930\u0902 ]\n\u0935\u0902\u0926\u0947 \u0936\u0902\u092d\u0941\u092e\u0941\u092e\u093e\u092a\u0924\u093f\u0902 \u0938\u0941\u0930\u0917\u0941\u0930\u0941\u0902 \u0935\u0902\u0926\u0947 \u091c\u0917\u0924\u094d\u0915\u093e\u0930\u0923\u0902\n\u0935\u0902\u0926\u0947 \u092a\u0928\u094d\u0928\u0917\u092d\u0942\u0937\u0923\u0902 \u092e\u0943\u0917\u0927\u0930\u0902 \u0935\u0902\u0926\u0947 \u092a\u0936\u0942\u0928\u093e\u0902 \u092a\u0924\u093f\u092e\u094d |\n\u0935\u0902\u0926\u0947 \u0938\u0942\u0930\u094d\u092f\u0936\u0936\u093e\u0902\u0915 \u0935\u0939\u094d\u0928\u093f \u0928\u092f\u0928\u0902 \u0935\u0902\u0926\u0947 \u092e\u0941\u0915\u0941\u0902\u0926 \u092a\u094d\u0930\u093f\u092f\u0902\n\u0935\u0902\u0926\u0947 \u092d\u0915\u094d\u0924\u091c\u0928\u093e\u0936\u094d\u0930\u092f\u0902 \u091a \u0935\u0930\u0926\u0902 \u0935\u0902\u0926\u0947 \u0936\u093f\u0935\u0902 \u0936\u0902\u0915\u0930\u092e\u094d ||\n\n[ \u0936\u094d\u0930\u0940 \u0926\u0915\u094d\u0937\u093f\u0923\u093e\u092e\u0942\u0930\u094d\u0924\u093f \u0936\u094d\u0932\u094b\u0915\u0902 ]\n\u0917\u0941\u0930\u0935\u0947 \u0938\u0930\u094d\u0935\u0932\u094b\u0915\u093e\u0928\u093e\u0902 \u092d\u093f\u0937\u091c\u0947 \u092d\u0935\u0930\u094b\u0917\u093f\u0923\u093e\u092e\u094d |\n\u0928\u093f\u0927\u092f\u0947 \u0938\u0930\u094d\u0935\u0935\u093f\u0926\u094d\u092f\u093e\u0928\u093e\u0902 \u0926\u0915\u094d\u0937\u093f\u0923\u093e\u092e\u0942\u0930\u094d\u0924\u092f\u0947 \u0928\u092e\u0903 ||\n\n[ \u0936\u094d\u0930\u0940\u0930\u093e\u092e \u0938\u094d\u0924\u094b\u0924\u094d\u0930\u0902 ]\n\u0936\u094d\u0930\u0940 \u0930\u093e\u092e \u0930\u093e\u092e \u0930\u093e\u092e\u0947\u0924\u093f \u0930\u092e\u0947 \u0930\u093e\u092e\u0947 \u092e\u0928\u094b\u0930\u092e\u0947\n\u0938\u0939\u0938\u094d\u0930\u0928\u093e\u092e \u0924\u0924\u094d\u0924\u0941\u0932\u094d\u092f\u0902 \u0930\u093e\u092e \u0928\u093e\u092e \u0935\u0930\u093e\u0928\u0928\u0947.\n\n[ \u0936\u094d\u0930\u0940 \u0935\u0947\u0902\u0915\u091f\u0947\u0936\u094d\u0935\u0930 \u0938\u094d\u0935\u093e\u092e\u093f \u0936\u094d\u0932\u094b\u0915\u0902 ]\n\u0936\u094d\u0930\u093f\u092f\u0903 \u0915\u093e\u0902\u0924\u093e\u092f \u0915\u0933\u094d\u092f\u093e\u0923\u0928\u093f\u0927\u092f\u0947 \u0928\u093f\u0927\u092f\u0947\u0930\u094d\u0926\u093f\u0928\u093e\u092e\u094d |\n\u0936\u094d\u0930\u0940 \u0935\u0947\u0902\u0915\u091f \u0928\u093f\u0935\u093e\u0938\u093e\u092f \u0936\u094d\u0930\u0940\u0928\u093f\u0935\u093e\u0938\u093e\u092f \u092e\u0902\u0917\u0933\u092e\u094d ||\n\n[ \u0936\u094d\u0930\u0940 \u0928\u0930\u0938\u093f\u0902\u0939 \u0938\u094d\u0935\u093e\u092e\u093f \u0927\u094d\u092f\u093e\u0928\u0902 ]\n\u0909\u0917\u094d\u0930\u0902 \u0935\u0940\u0930\u0902 \u092e\u0939\u093e\u0935\u093f\u0937\u094d\u0923\u0941\u0902, \u091c\u094d\u0935\u0932\u0902\u0924\u0902 \u0938\u0930\u094d\u0935\u0924\u094b\u092e\u0941\u0916\u0902\n\u0928\u0943\u0938\u093f\u0902\u0939 \u092d\u0940\u0937\u0923\u0902 \u092d\u0926\u094d\u0930\u0902, \u092e\u0943\u0924\u094d\u092f\u0941 \u092e\u0943\u0924\u094d\u092f\u0941\u0902 \u0928\u092e\u093e\u092e\u094d\u092f\u0939\u092e\u094d ||\n\n[ \u0936\u094d\u0930\u0940 \u0928\u093e\u0917\u0926\u0947\u0935\u0924 \u0938\u094d\u0924\u0941\u0924\u093f ]\n\u0928\u093e\u0917\u0930\u093e\u091c \u092e\u0939\u093e\u0926\u0947\u0935 \u0915\u0943\u092a\u092f\u093e \u092d\u0915\u094d\u0924\u0935\u0924\u094d\u0938\u0932\u0941\n\u0905\u092d\u0940\u0937\u094d\u091f\u0902 \u0926\u0947\u0939\u093f\u092e\u0947 \u0926\u0947\u0935 \u0938\u0930\u094d\u0935\u0930\u0942\u092a \u0928\u092e\u094b\u0938\u094d\u0924\u0941\u0924\u0947 |\n\u0928\u093e\u0917\u093e\u0927\u093f\u092a \u0928\u092e\u0938\u094d\u0924\u0947\u0938\u094d\u0924\u0941 \u0938\u0930\u094d\u0935\u093e\u0930\u093f\u0937\u094d\u091f \u0935\u093f\u0928\u093e\u0936\u0928 |\n\u0938\u0902\u0927\u094d\u092f\u093e\u0924\u094d\u0935\u0902 \u0936\u092e\u092f\u0947\u0926\u094d\u0926\u0947\u0935 \u0935\u093e\u0902\u091a\u093f\u0924\u093e\u0930\u094d\u0925\u093e\u0928\u094d \u092a\u094d\u0930\u092f\u091a\u094d\u091b\u092e\u0947 ||\n\n[ \u0936\u094d\u0930\u0940 \u0932\u0915\u094d\u0937\u094d\u092e\u0940 \u0936\u094d\u0932\u094b\u0915\u0902 ]\n\u0932\u0915\u094d\u0937\u094d\u092e\u0940\u0902 \u0915\u094d\u0937\u0940\u0930\u0938\u092e\u0941\u0926\u094d\u0930 \u0930\u093e\u091c \u0924\u0928\u092f\u093e\u0902 \u0936\u094d\u0930\u0940\u0930\u0902\u0917 \u0927\u093e\u092e\u0947\u0936\u094d\u0935\u0930\u0940\u0902 |\n\u0926\u093e\u0938\u0940\u092d\u0942\u0924 \u0938\u092e\u0938\u094d\u0924 \u0926\u0947\u0935 \u0935\u0928\u093f\u0924\u093e\u0902 \u0932\u094b\u0915\u0948\u0915 \u0926\u0940\u092a\u093e\u0902\u0915\u0941\u0930\u093e\u092e\u094d |\n\u0936\u094d\u0930\u0940\u092e\u0928\u094d\u092e\u0902\u0927 \u0915\u091f\u093e\u0915\u094d\u0937 \u0932\u092c\u094d\u0926 \u0935\u093f\u092d\u0935 \u092c\u094d\u0930\u0939\u094d\u092e\u0947\u0902\u0926\u094d\u0930 \u0917\u0902\u0917\u093e\u0927\u0930\u093e\u0902 |\n\u0924\u094d\u0935\u093e\u0902 \u0924\u094d\u0930\u0948\u0932\u094b\u0915\u094d\u092f\u0915\u0941\u091f\u0941\u0902\u092c\u093f\u0928\u0940\u0902 \u0938\u0930\u0938\u093f\u091c\u093e\u0902 \u0935\u0902\u0926\u0947 \u092e\u0941\u0915\u0941\u0902\u0926\u092a\u094d\u0930\u093f\u092f\u093e\u092e\u094d ||\n\n[ \u0936\u094d\u0930\u0940 \u0926\u0947\u0935\u0940 \u0936\u094d\u0932\u094b\u0915\u0902 ]\n\u0938\u0930\u094d\u0935 \u092e\u0902\u0917\u0933 \u092e\u093e\u0902\u0917\u0932\u094d\u092f\u0947 \u0936\u093f\u0935\u0947 \u0938\u0930\u094d\u0935\u093e\u0930\u094d\u0925 \u0938\u093e\u0927\u093f\u0915\u0947 |\n\u0936\u0930\u0923\u094d\u092f\u0947 \u0924\u094d\u0930\u094d\u092f\u0902\u092c\u0915\u0947 \u0926\u0947\u0935\u093f \u0928\u093e\u0930\u093e\u092f\u0923\u093f \u0928\u092e\u094b\u0938\u094d\u0924\u0941\u0924\u0947 ||\n\n[ \u0936\u094d\u0930\u0940 \u0905\u0928\u094d\u0928\u092a\u0942\u0930\u094d\u0923\u093e\u0926\u0947\u0935\u093f \u092a\u094d\u0930\u093e\u0930\u094d\u0925\u0928 ]\n\u0928\u093f\u0924\u094d\u092f\u093e\u0928\u0902\u0926\u0915\u0930\u0940 \u0935\u0930\u093e\u092d\u092f\u0915\u0930\u0940 \u0938\u094c\u0902\u0926\u0930\u094d\u092f\u0930\u0924\u094d\u0928\u093e\u0915\u0930\u0940.\n\u0928\u093f\u0930\u094d\u0927\u0942\u0924\u093e\u0916\u093f\u0932 \u0918\u094b\u0930 \u092a\u093e\u0935\u0928\u0915\u0930\u0940 \u092a\u094d\u0930\u0924\u094d\u092f\u0915\u094d\u0937 \u092e\u093e\u0939\u0947\u0936\u094d\u0935\u0930\u0940,\n\u092a\u094d\u0930\u093e\u0932\u0947\u092f\u093e\u091a\u0932 \u0935\u0902\u0936\u092a\u093e\u0935\u0928\u0915\u0930\u0940 \u0915\u093e\u0936\u0940\u092a\u0941\u0930\u093e\u0927\u0940\u0936\u094d\u0935\u0930\u0940\n\u092d\u093f\u0915\u094d\u0937\u093e\u0902\u0926\u0947\u0939\u093f \u0915\u0943\u092a\u093e\u0935\u0932\u0902\u092c\u0928\u0915\u0930\u0940 \u092e\u093e\u0924\u093e\u0928\u094d\u0928\u092a\u0942\u0930\u094d\u0923\u0947\u0936\u094d\u0935\u0930\u0940,\n\n[ \u0936\u094d\u0930\u0940 \u0935\u093e\u0938\u0935\u093f \u0936\u094d\u0932\u094b\u0915\u0902 ]\n\u0936\u094d\u0930\u0940\u0926\u0947\u0935\u0940\u0902 \u0928\u0935\u092f\u094c\u0935\u0928\u093e\u0902\u091a\u093f\u0924 \u0924\u0928\u0941\u0902 \u0936\u094d\u0930\u093f\u092f\u0903 \u092a\u094d\u0930\u0926\u093e\u0902 \u0915\u0928\u094d\u092f\u0915\u093e\u0902|\n\u0938\u094d\u0935\u0930\u094d\u0923\u093e\u0932\u0902\u0915\u0943\u0924 \u092d\u0942\u0937\u093f\u0924\u093e\u0902 \u0927\u0943\u0924\u0936\u0941\u0915\u093e\u0902 \u0938\u094c\u0902\u0926\u0930\u094d\u092f \u0935\u093e\u0930\u093e\u0928\u093f\u0927\u093f|\n\u0915\u093e\u0930\u0941\u0923\u094d\u092f\u093e\u092e\u0943\u0924 \u0935\u0930\u094d\u0937\u093f\u0923\u0940\u0902 \u0928\u0935\u092e\u0923\u093f \u092d\u094d\u0930\u093e\u091c\u0924\u094d\u0915\u093f\u0930\u0940\u091f\u094b\u091c\u094d\u0935\u0932\u093e\u0902|\n\u0935\u0948\u0936\u094d\u092f\u092d\u0916\u094d\u092f\u093e\u0924\u0915\u0941\u0932\u094b\u0926\u094d\u092d\u0935\u093e\u0902 \u0936\u094d\u0930\u0941\u0924\u093f\u0928\u0941\u0924\u093e\u0902 \u0935\u0902\u0926\u0947 \u0938\u0926\u093e \u0935\u093e\u0938\u0935\u0940\u0902||\n\n[ \u0936\u094d\u0930\u0940 \u0939\u0928\u0941\u092e \u0938\u094d\u0924\u094b\u0924\u094d\u0930\u0902 ]\n\u092e\u0928\u094b\u091c\u0935\u0902 \u092e\u093e\u0930\u0941\u0924 \u0924\u0941\u0932\u094d\u092f\u0935\u0947\u0917\u0902 \u091c\u093f\u0924\u0947\u0902\u0926\u094d\u0930\u093f\u092f\u0902 \u092c\u0941\u0926\u094d\u0927\u093f\u092e\u0924\u093e\u0902 \u0935\u0930\u093f\u0937\u094d\u091f\u0902 |\n\u0935\u093e\u0924\u093e\u0924\u094d\u092e\u091c\u0902 \u0935\u093e\u0928\u0930\u092f\u0942\u0927 \u092e\u0941\u0916\u094d\u092f\u0902 \u0936\u094d\u0930\u0940\u0930\u093e\u092e\u0926\u0942\u0924\u0902 \u0936\u093f\u0930\u0938\u093e \u0928\u092e\u093e\u092e\u093f ||\n\u092c\u0941\u0926\u094d\u0927\u093f\u0930\u094d\u092c\u0932\u0902 \u092f\u0936\u094b\u0927\u0948\u0930\u094d\u092f\u0902 \u0928\u093f\u0930\u094d\u092d\u092f\u0924\u094d\u0935-\u092e\u0930\u094b\u0917\u0924\u093e |\n\u0905\u091c\u093e\u0921\u094d\u092f\u0902 \u0935\u093e\u0915\u094d\u092a\u091f\u0941\u0924\u094d\u0935\u0902 \u091a \u0939\u0928\u0941\u092e\u0924\u094d-\u0938\u094d\u092e\u0930\u0923\u093e\u0926\u094d-\u092d\u0935\u0947\u0924\u094d ||\n\n[ \u0936\u094d\u0930\u0940 \u0936\u0902\u0915\u0930\u093e\u091a\u093e\u0930\u094d\u092f \u092a\u094d\u0930\u093e\u0930\u094d\u0925\u0928 ]\n\u0936\u094d\u0930\u0941\u0924\u093f \u0938\u094d\u092e\u0943\u0924\u093f \u092a\u0941\u0930\u093e\u0923\u093e\u0902 \u0906\u0932\u092f\u0902 \u0915\u0930\u0941\u0923\u093e\u0932\u092f\u0902,\n\u0928\u092e\u093e\u092e\u093f \u092d\u0917\u0935\u0924\u094d\u092a\u093e\u0926\u0936\u0902\u0915\u0930\u0902 \u0932\u094b\u0915 \u0936\u0902\u0915\u0930\u0902 ||\n\n[ \u0936\u094d\u0930\u0940 \u0930\u093e\u0918\u0935\u0947\u0902\u0926\u094d\u0930 \u0938\u094d\u0935\u093e\u092e\u093f \u092a\u094d\u0930\u093e\u0930\u094d\u0925\u0928 ]\n\u092a\u0942\u091c\u094d\u092f\u093e\u092f \u0930\u093e\u0918\u0935\u0947\u0902\u0926\u094d\u0930\u093e\u092f \u0938\u0924\u094d\u092f\u0927\u0930\u094d\u092e\u0930\u0924\u093e\u092f\u091a\n\u092d\u091c\u0924\u093e\u0902 \u0915\u0932\u094d\u092a\u0935\u0943\u0915\u094d\u0937\u093e\u092f \u0928\u092e\u0924\u093e\u0902 \u0915\u093e\u092e\u0927\u0947\u0928\u0935\u0947 ||\n\n[ \u0936\u094d\u0930\u0940 \u0930\u0947\u0923\u0941\u0915\u093e\u091a\u093e\u0930\u094d\u092f\u0938\u094d\u0924\u0941\u0924\u093f ]\n\u091c\u0940\u092f\u093e\u0924\u094d \u0936\u094d\u0930\u0940\u0930\u0947\u0923\u0941\u0915\u093e\u091a\u093e\u0930\u094d\u092f\u094b - \u0936\u093f\u0935\u093e\u091a\u093e\u0930 \u0936\u093f\u0916\u093e\u092e\u0923\u093f\u0903 |\n\u092f\u094b \u0935\u0940\u0930\u0936\u0948\u0935 \u0938\u093f\u0926\u094d\u0927\u093e\u0902\u0924\u0902 -\u0938\u094d\u0925\u093e\u092a\u092f\u093e\u092e\u093e\u0938 \u092d\u0942\u0924\u0932\u0947 ||\n\n[ \u0938\u0942\u0930\u094d\u092f\u094b\u0926\u092f \u0936\u094d\u0932\u094b\u0915\u0902 ]\n\u092c\u094d\u0930\u0939\u094d\u092e\u0938\u094d\u0935\u0930\u0942\u092a \u092e\u0941\u0926\u092f\u0947 \u092e\u0927\u094d\u092f\u093e\u0939\u094d\u0928\u0947\u0924\u0941 \u092e\u0939\u0947\u0936\u094d\u0935\u0930\u092e\u094d |\n\u0938\u093e\u0939\u0902 \u0927\u094d\u092f\u093e\u092f\u0947\u0924\u094d\u0938\u0926\u093e \u0935\u093f\u0937\u094d\u0923\u0941\u0902 \u0924\u094d\u0930\u093f\u092e\u0942\u0930\u094d\u0924\u093f\u0902\u091a \u0926\u093f\u0935\u093e\u0915\u0930\u092e\u094d ||\n\n\u0926\u0947\u0935\u0941\u0921\u093f \u092a\u0942\u091c \u091a\u0947\u0938\u093e\u0915, \u092a\u0942\u091c\u0932\u094b \u092e\u0928\u0902 \u091a\u0926\u093f\u0935\u093f\u0928 \u0936\u094d\u0932\u094b\u0915\u093e\u0932(\u0905\u0915\u094d\u0937\u0930 \u0926\u094b\u0937\u0902) \u0935\u0932\u094d\u0932, \u0915\u094d\u0930\u093f\u092f \u0935\u0932\u094d\u0932, \u092e\u0928\u0902 \u091a\u0947\u0938\u093f\u0928 \u092a\u0942\u091c\u0932\u094b \u092d\u0915\u094d\u0924\u093f \u0932\u094b\u092a\u0902 \u0935\u0932\u094d\u0932 \u090f\u0926\u0948\u0928\u093e \u0924\u092a\u094d\u092a\u0941 \u091c\u0930\u093f\u0917\u093f\u0909\u0902\u0921\u0935\u091a\u094d\u091a\u0941 \u0915\u093e\u092c\u091f\u094d\u091f\u093f \u0908 \u0915\u094d\u0930\u093f\u0902\u0926 \u0915\u094d\u0937\u092e\u093e\u092a\u0923 \u091a\u0947\u092a\u094d\u092a\u0941\u0915\u094b\u0935\u093e\u0932\u093f\n\n[ \u0905\u092a\u0930\u093e\u0927 \u0915\u094d\u0937\u092e\u093e\u092a\u0923 \u0938\u094d\u0924\u094b\u0924\u094d\u0930\u0902 ]\n\u0905\u092a\u0930\u093e\u0927 \u0938\u0939\u0938\u094d\u0930\u093e\u0923\u093f, \u0915\u094d\u0930\u093f\u092f\u0902\u0924\u0947\u0939\u0930\u094d\u0928\u093f\u0936\u0902 \u092e\u092f\u093e |\n\u0926\u093e\u0938\u094b\u092f \u092e\u093f\u0924\u093f \u092e\u093e\u0902 \u092e\u0924\u094d\u0935\u093e, \u0915\u094d\u0937\u092e\u0938\u094d\u0935 \u092a\u0930\u092e\u0947\u0936\u094d\u0935\u0930 ||\n\u0915\u0930\u091a\u0930\u0923 \u0915\u0943\u0924\u0902 \u0935\u093e \u0915\u0930\u094d\u092e \u0935\u093e\u0915\u094d\u0915\u093e\u092f\u091c\u0902 \u0935\u093e\n\u0936\u094d\u0930\u0935\u0923 \u0928\u092f\u0928\u091c\u0902 \u0935\u093e \u092e\u093e\u0928\u0938\u0902 \u0935\u093e\u092a\u0930\u093e\u0927\u092e\u094d |\n\u0935\u093f\u0939\u093f\u0924 \u092e\u0935\u093f\u0939\u093f\u0924\u0902 \u0935\u093e \u0938\u0930\u094d\u0935\u092e\u0947\u0924\u0924\u094d \u0915\u094d\u0937\u092e\u0938\u094d\u0935\n\u0936\u093f\u0935 \u0936\u093f\u0935 \u0915\u0930\u0941\u0923\u093e\u092c\u094d\u0927\u0947 \u0936\u094d\u0930\u0940 \u092e\u0939\u093e\u0926\u0947\u0935 \u0936\u0902\u092d\u094b ||\n\u0915\u093e\u092f\u0947\u0928 \u0935\u093e\u091a\u093e \u092e\u0928\u0938\u0947\u0902\u0926\u094d\u0930\u093f\u092f\u0948\u0930\u094d\u0935\u093e\n\u092c\u0941\u0926\u094d\u0927\u094d\u092f\u093e\u0924\u094d\u092e\u0928\u093e \u0935\u093e \u092a\u094d\u0930\u0915\u0943\u0924\u0947\u0903 \u0938\u094d\u0935\u092d\u093e\u0935\u093e\u0924\u094d |\n\u0915\u0930\u094b\u092e\u093f \u092f\u0926\u094d\u092f\u0924\u094d\u0938\u0915\u0932\u0902 \u092a\u0930\u0938\u094d\u092e\u0948 \u0928\u093e\u0930\u093e\u092f\u0923\u093e\u092f\u0947\u0924\u093f \u0938\u092e\u0930\u094d\u092a\u092f\u093e\u092e\u093f ||\n\n\u092a\u0942\u091c \u092e\u094b\u0924\u094d\u0924\u0902 \u092a\u0942\u0930\u094d\u0924\u0940 \u0905\u092f\u094d\u092f\u093e\u0915 \u0936\u093e\u0902\u0924\u093f \u092e\u0902\u0924\u094d\u0930\u0902 \u091a\u0947\u092a\u094d\u092a\u0941\u0915\u094b\u0935\u093e\u0932\u093f\n\n[ \u0936\u093e\u0902\u0924\u093f \u092e\u0902\u0924\u094d\u0930\u0902 ]\n\u0905\u0938\u0924\u094b\u092e\u093e \u0938\u0926\u094d\u0917\u092e\u092f\u093e |\n\u0924\u092e\u0938\u094b\u092e\u093e \u091c\u094d\u092f\u094b\u0924\u093f\u0930\u094d\u0917\u092e\u092f\u093e |\n\u092e\u0943\u0924\u094d\u092f\u094b\u0930\u094d\u092e\u093e \u0905\u092e\u0943\u0924\u0902\u0917\u092e\u092f\u093e |\n\u0913\u0902 \u0936\u093e\u0902\u0924\u093f\u0903 \u0936\u093e\u0902\u0924\u093f\u0903 \u0936\u093e\u0902\u0924\u093f\u0903\n\n\u0938\u0930\u094d\u0935\u0947 \u092d\u0935\u0902\u0924\u0941 \u0938\u0941\u0916\u093f\u0928\u0903 \u0938\u0930\u094d\u0935\u0947 \u0938\u0902\u0924\u0941 \u0928\u093f\u0930\u093e\u092e\u092f\u093e\u0903 |\n\u0938\u0930\u094d\u0935\u0947 \u092d\u0926\u094d\u0930\u093e\u0923\u093f \u092a\u0936\u094d\u092f\u0902\u0924\u0941 \u092e\u093e \u0915\u0936\u094d\u091a\u093f\u0926\u094d\u0926\u0941\u0903\u0916 \u092d\u093e\u0917\u094d\u092d\u0935\u0947\u0924\u094d ||\n\n\u0913\u0902 \u0938\u0939 \u0928\u093e'\u0935\u0935\u0924\u0941 | \u0938 \u0928\u094c \u092d\u0941\u0928\u0915\u094d\u0924\u0941 | \u0938\u0939 \u0935\u0940\u0930\u094d\u092f\u0902' \u0915\u0930\u0935\u093e\u0935\u0939\u0948 |\n\u0924\u0947\u091c\u0938\u094d\u0935\u093f\u0928\u093e\u0935\u0927\u0940'\u0924\u092e\u0938\u094d\u0924\u0941 \u092e\u093e \u0935\u093f'\u0926\u094d\u0935\u093f\u0937\u093e\u0935\u0939\u0948' ||\n\u0913\u0902 \u0936\u093e\u0902\u0924\u093f\u0903 \u0936\u093e\u0902\u0924\u093f\u0903 \u0936\u093e\u0902\u0924\u093f\u0903' ||\n\n\u092d\u094b\u091c\u0928\u093e\u0928\u093f\u0915\u093f \u0915\u0942\u0930\u094d\u091a\u0941\u0928\u094d\u0928 \u0924\u0930\u0941\u0935\u093e\u0924 \u092d\u094b\u091c\u0928\u0902 \u0938\u094d\u0935\u0940\u0915\u0930\u093f\u0902\u091a\u0947\u092e\u0941\u0902\u0926\u0941 \u0908 \u0915\u094d\u0930\u093f\u0902\u0926\u093f \u0936\u094d\u0932\u094b\u0915\u0902 \u091a\u0947\u092a\u094d\u092a\u0941\u0915\u094b\u0935\u093e\u0932\u093f\n\n[ \u092d\u094b\u091c\u0928 \u092a\u0942\u0930\u094d\u0935 \u0936\u094d\u0932\u094b\u0915\u0902 ]\n\u092c\u094d\u0930\u0939\u094d\u092e\u093e\u0930\u094d\u092a\u0923\u0902 \u092c\u094d\u0930\u0939\u094d\u092e \u0939\u0935\u093f\u0903 \u092c\u094d\u0930\u0939\u094d\u092e\u093e\u0917\u094d\u0928\u094c \u092c\u094d\u0930\u0939\u094d\u092e\u0923\u093e\u0928\u093e\u0939\u0941\u0924\u092e\u094d |\n\u092c\u094d\u0930\u0939\u094d\u092e\u0948\u0935 \u0924\u0947\u0928 \u0917\u0902\u0924\u0935\u094d\u092f\u0902 \u092c\u094d\u0930\u0939\u094d\u092e \u0915\u0930\u094d\u092e \u0938\u092e\u093e\u0927\u093f\u0928\u093e\u0903 ||\n\u0905\u0939\u0902 \u0935\u0948\u0936\u094d\u0935\u093e\u0928\u0930\u094b \u092d\u0942\u0924\u094d\u0935\u093e \u092a\u094d\u0930\u093e\u0923\u093f\u0928\u093e\u0902 \u0926\u0947\u0939-\u092e\u093e\u0936\u094d\u0930\u093f\u0924\u0903 |\n\u092a\u094d\u0930\u093e\u0923\u093e\u092a\u093e\u0928 \u0938\u092e\u093e\u092f\u0941\u0915\u094d\u0924\u0903 \u092a\u091a\u093e\u092e\u094d\u092f\u0928\u094d\u0928\u0902 \u091a\u0924\u0941\u0930\u094d\u0935\u093f\u0927\u092e\u094d ||\n\u0924\u094d\u0935\u0926\u0940\u092f\u0902 \u0935\u0938\u094d\u0924\u0941 \u0917\u094b\u0935\u093f\u0902\u0926 \u0924\u0941\u092d\u094d\u092f\u092e\u0947\u0935 \u0938\u092e\u0930\u094d\u092a\u092f\u0947 |\n\u0917\u0943\u0939\u093e\u0923 \u0938\u0941\u092e\u0941\u0916\u094b \u092d\u0942\u0924\u094d\u0935\u093e \u092a\u094d\u0930\u0938\u0940\u0926 \u092a\u0930\u092e\u0947\u0936\u094d\u0935\u0930 ||\n\n\u092d\u094b\u091c\u0928\u0902 \u0938\u094d\u0935\u0940\u0915\u0930\u093f\u0902\u091a\u093f\u0928 \u0924\u0930\u0941\u0935\u093e\u0924 \u0908 \u0915\u094d\u0930\u093f\u0902\u0926\u093f \u0936\u094d\u0932\u094b\u0915\u0902 \u091a\u0947\u092a\u094d\u092a\u0941\u0915\u094b\u0935\u093e\u0932\u093f\n\n[ \u092d\u094b\u091c\u0928\u093e\u0928\u0902\u0924\u0930 \u0936\u094d\u0932\u094b\u0915\u0902 ]\n\u0905\u0917\u0938\u094d\u0924\u094d\u092f\u0902 \u0935\u0948\u0928\u0924\u0947\u092f\u0902 \u091a \u0936\u092e\u0940\u0902\u091a\u092c\u0921\u092c\u093e\u0928\u0932\u0902 |\n\u0905\u0928\u094d\u0928\u0938\u094d\u092f \u092a\u0930\u093f\u0923\u093e\u092e\u093e\u0930\u094d\u0925\u0902 \u0938\u094d\u092e\u0930\u0947\u0926\u094d \u092d\u0940\u092e\u0902 \u091a \u092a\u0902\u091a\u0915\u0902 ||",isAudio:!1,audioDurationSec:40,totalTime:"00:40"},{id:"4",slug:"poojalu-vrathaalu",title:"\u092a\u0942\u091c\u093e \u090f\u0935\u0902 \u0935\u094d\u0930\u0924 \u0935\u093f\u0927\u093f",description:"[ \u0936\u094d\u0930\u0940 \u0905\u092f\u094d\u092f\u092a\u094d\u092a \u092a\u0942\u091c\u0932\u0941 - \u0935\u094d\u0930\u0924 \u0928\u093f\u092f\u092e\u092e\u0941\u0932\u0941 ]\n    \n    \u0936\u094d\u0930\u0940 \u0905\u092f\u094d\u092f\u092a\u094d\u092a \u0938\u094d\u0935\u093e\u092e\u093f \u092e\u0902\u0921\u0932 \u0926\u0940\u0915\u094d\u0937 \u0935\u094d\u0930\u0924\u092e\u0941 \u0905\u0924\u094d\u092f\u0902\u0924 \u092a\u0935\u093f\u0924\u094d\u0930\u092e\u0948\u0928\u0926\u093f. \u092e\u0902\u0921\u0932 \u0915\u093e\u0932\u0902 (41 \u0930\u094b\u091c\u0941\u0932\u0941) \u092d\u0915\u094d\u0924\u0941\u0932\u0941 \u0928\u093f\u092f\u092e \u0928\u093f\u0937\u094d\u091f\u0932\u0924\u094b \u0906\u091a\u0930\u093f\u0902\u091a\u0935\u0932\u0938\u093f\u0928 \u092a\u0942\u091c\u093e \u0935\u093f\u0927\u093e\u0928\u0902 \u092e\u0930\u093f\u092f\u0941 \u0935\u094d\u0930\u0924 \u0928\u093f\u092f\u092e\u092e\u0941\u0932\u0941:\n    \n    [ \u092e\u0941\u0916\u094d\u092f \u0935\u094d\u0930\u0924 \u0928\u093f\u092f\u092e\u092e\u0941\u0932\u0941 ]\n    \u2022 \u092c\u094d\u0930\u093e\u0939\u094d\u092e\u0940 \u092e\u0941\u0939\u0942\u0930\u094d\u0924\u092e\u0941\u0928 (\u0909\u0926\u092f\u0902 4 \u0917\u0902\u091f\u0932\u0915\u0941) \u092e\u0930\u093f\u092f\u0941 \u0938\u093e\u092f\u0902\u0924\u094d\u0930\u0902 \u091a\u0928\u094d\u0928\u0940\u091f\u093f \u0938\u094d\u0928\u093e\u0928\u0902 \u0906\u091a\u0930\u093f\u0902\u091a\u0935\u0932\u0947\u0928\u0941.\n    \u2022 \u0928\u093f\u0924\u094d\u092f\u0902 \u0909\u0926\u092f\u0902 \u092e\u0930\u093f\u092f\u0941 \u0938\u093e\u092f\u0902\u0924\u094d\u0930\u0902 \u0905\u092f\u094d\u092f\u092a\u094d\u092a \u092a\u0942\u091c, \u0936\u0930\u0923\u0941\u0918\u094b\u0937, \u0939\u093e\u0930\u0924\u093f \u0938\u092e\u0930\u094d\u092a\u093f\u0902\u091a\u0935\u0932\u0947\u0928\u0941.\n    \u2022 \u0915\u0947\u0935\u0932\u0902 \u0938\u093e\u0924\u094d\u0935\u093f\u0915 \u0906\u0939\u093e\u0930\u092e\u0941 \u092e\u093e\u0924\u094d\u0930\u092e\u0947 \u092d\u0941\u091c\u093f\u0902\u091a\u0935\u0932\u0947\u0928\u0941 (\u090f\u0915\u092d\u0941\u0915\u094d\u0924 \u0935\u094d\u0930\u0924\u0902).\n    \u2022 \u0928\u0940\u0932\u0902, \u0928\u0932\u0941\u092a\u0941 \u0932\u0947\u0926\u093e \u0915\u093e\u0937\u093e\u092f \u0935\u0938\u094d\u0924\u094d\u0930\u092e\u0941\u0932\u0941 \u0927\u0930\u093f\u0902\u091a\u0935\u0932\u0947\u0928\u0941.\n    \u2022 \u0938\u0930\u094d\u0935 \u092a\u094d\u0930\u093e\u0923\u0941\u0932\u0928\u0941 \u0938\u094d\u0935\u093e\u092e\u093f\u0917\u093e \u0926\u0930\u094d\u0936\u093f\u0938\u094d\u0924\u0942, \u092a\u094d\u0930\u0924\u093f \u0913\u0915\u094d\u0915\u0930\u093f\u0928\u093f '\u0938\u094d\u0935\u093e\u092e\u093f' \u0905\u0928\u093f \u092a\u093f\u0932\u0935\u0935\u0932\u0947\u0928\u0941.\n    \u2022 \u0915\u093e\u092e, \u0915\u094d\u0930\u094b\u0927, \u092e\u094b\u0939, \u092e\u0926, \u092e\u093e\u0924\u094d\u0938\u0930\u094d\u092f\u092e\u0941\u0932\u0928\u0941 \u0935\u093f\u0921\u0928\u093e\u0921\u093f \u092c\u094d\u0930\u0939\u094d\u092e\u091a\u0930\u094d\u092f \u0935\u094d\u0930\u0924\u092e\u0941\u0928\u0941 \u092a\u093e\u091f\u093f\u0902\u091a\u0935\u0932\u0947\u0928\u0941.\n    \u2022 \u091a\u0947\u092a\u094d\u092a\u0941\u0932\u0941 \u0927\u0930\u093f\u0902\u091a\u0915\u0941\u0902\u0921\u093e \u092a\u093e\u0926\u091a\u093e\u0930\u093f\u0917\u093e \u091c\u0940\u0935\u093f\u0902\u091a\u0935\u0932\u0947\u0928\u0941.\n    \u2022 \u092a\u0921\u0941\u0915\u0941\u0928\u0947\u091f\u092a\u094d\u092a\u0941\u0921\u0941 \u091a\u093e\u092a \u0932\u0947\u0926\u093e \u0928\u0947\u0932\u092a\u0948 \u092e\u093e\u0924\u094d\u0930\u092e\u0947 \u0936\u092f\u0928\u093f\u0902\u091a\u0935\u0932\u0947\u0928\u0941.\n    \n    [ \u092a\u0921\u093f\u092a\u0942\u091c \u0935\u093f\u0927\u093e\u0928\u0902 ]\n    \u092a\u0926\u0941\u0928\u0947\u091f\u094d\u091f\u093e\u0902\u092c\u0921\u093f (18 \u092e\u0947\u091f\u094d\u0932\u0941) \u092a\u0942\u091c \u0905\u092f\u094d\u092f\u092a\u094d\u092a \u0906\u0930\u093e\u0927\u0928\u0932\u094b \u0905\u0924\u094d\u092f\u0902\u0924 \u092e\u0939\u093f\u092e\u093e\u0928\u094d\u0935\u093f\u0924\u092e\u0948\u0928\u0926\u093f. \u092a\u094d\u0930\u0924\u0940 \u092e\u0947\u091f\u094d\u091f\u0941\u092a\u0948 \u0928\u0947\u092f\u094d\u092f\u093f \u0926\u0940\u092a\u092e\u0941\u0932\u0941 \u0935\u0947\u0932\u093f\u0917\u093f\u0902\u091a\u093f, 18 \u0926\u0947\u0935\u0924\u093e \u092e\u0942\u0930\u094d\u0924\u0941\u0932\u0928\u0941 \u0906\u0939\u094d\u0935\u093e\u0928\u093f\u0902\u091a\u093f, \u092a\u0941\u0937\u094d\u092a\u092e\u0941\u0932\u0941, \u0927\u0942\u092a, \u0926\u0940\u092a, \u0928\u0948\u0935\u0947\u0926\u094d\u092f\u092e\u0941\u0932\u0924\u094b \u092e\u0939\u093e\u092a\u0942\u091c \u091c\u0930\u093f\u092a\u093f\u0938\u094d\u0924\u093e\u0930\u0941.\n    \n    \u0938\u094d\u0935\u093e\u092e\u093f\u092f\u0947 \u0936\u0930\u0923\u0902 \u0905\u092f\u094d\u092f\u092a\u094d\u092a!",isAudio:!1,audioDurationSec:40,totalTime:"00:40"},{id:"5",slug:"maaladharana-mantram",title:"\u092e\u093e\u0932\u093e\u0927\u093e\u0930\u0923 \u092e\u0902\u0924\u094d\u0930",description:"[ \u092e\u093e\u0932\u093e\u0927\u093e\u0930\u0923 \u092e\u0902\u0924\u094d\u0930\u0902 ]\n\n\u091c\u094d\u091e\u093e\u0928\u092e\u0941\u0926\u094d\u0930\u093e\u0902 \u0936\u093e\u0938\u094d\u0924\u094d\u0930\u092e\u0941\u0926\u094d\u0930\u093e\u0902 \u0917\u0941\u0930\u0941\u092e\u0941\u0926\u094d\u0930\u093e\u0902 \u0928\u092e\u093e\u092e\u094d\u092f\u0939\u092e\u094d |\n\u0935\u0928\u092e\u0941\u0926\u094d\u0930\u093e\u0902 \u0936\u0941\u0926\u094d\u0927\u092e\u0941\u0926\u094d\u0930\u093e\u0902 \u0930\u0941\u0926\u094d\u0930\u092e\u0941\u0926\u094d\u0930\u093e\u0902 \u0928\u092e\u093e\u092e\u094d\u092f\u0939\u092e\u094d |\n\u0936\u093e\u0902\u0924\u092e\u0941\u0926\u094d\u0930\u093e\u0902 \u0938\u0924\u094d\u092f\u092e\u0941\u0926\u094d\u0930\u093e\u0902 \u0935\u094d\u0930\u0924\u092e\u0941\u0926\u094d\u0930\u093e\u0902 \u0928\u092e\u093e\u092e\u094d\u092f\u0939\u092e\u094d |\n\u0936\u092c\u0930\u094d\u0935\u093e\u0936\u094d\u0930\u092e \u0938\u0924\u094d\u092f\u0947\u0928 \u092e\u0941\u0926\u094d\u0930\u093e\u0902 \u092a\u093e\u0924\u0941 \u0938\u0926\u093e\u092a\u093f\u092e\u0947 |\n\u0917\u0941\u0930\u0941\u0926\u0915\u094d\u0937\u093f\u0923\u092f\u093e\u092a\u0942\u0930\u094d\u0935\u0902 \u0924\u0938\u094d\u092f\u0928\u0941\u0917\u094d\u0930\u0939\u0915\u093e\u0930\u093f\u0923\u0947 |\n\u0936\u0930\u0923\u093e\u0917\u0924 \u092e\u0941\u0926\u094d\u0930\u093e\u0916\u094d\u092f\u0902 \u0924\u094d\u0935\u0928\u094d\u092e\u0941\u0926\u094d\u0930\u093e\u0902 \u0927\u093e\u0930\u092f\u093e\u092e\u094d\u092f\u0939\u0902 |\n\u091a\u093f\u0928\u094d\u092e\u0941\u0926\u094d\u0930\u093e\u0902 \u0916\u0947\u091a\u0930\u0940\u092e\u0941\u0926\u094d\u0930\u093e\u0902 \u092d\u0926\u094d\u0930\u092e\u0941\u0926\u094d\u0930\u093e\u0902 \u0928\u092e\u093e\u092e\u094d\u092f\u0939\u0902 |\n\u0936\u092c\u0930\u094d\u0935\u093e\u091a\u0932 \u092e\u0941\u0926\u094d\u0930\u093e\u092f\u0948 \u0928\u092e\u0938\u094d\u0924\u0941\u092d\u094d\u092f\u0902 \u0928\u092e\u094b\u0928\u092e\u0903 |\n\u0905\u0937\u094d\u091f\u093e\u0926\u0936\u0902 \u092e\u0939\u093e\u0938\u093e\u0930\u0902 \u0936\u093e\u0938\u094d\u0924\u094d\u0930\u0926\u0930\u094d\u0936\u0928\u0915\u093e\u0930\u0923\u0902 |\n\u0935\u093f\u0926\u093f\u0924\u0902 \u0936\u0941\u0926\u094d\u0927\u092e\u0941\u0924\u094d\u0915\u0943\u0937\u094d\u091f\u0902 \u0938\u0928\u094d\u0928\u093f\u0927\u093e\u0928\u0902 \u0928\u092e\u093e\u092e\u094d\u092f\u0939\u0902!\n\u090a\u0930\u0941\u091c\u0932 \u0935\u093e\u092a\u0941\u0930\u0902 \u091a\u0948\u0935 \u092d\u0948\u0930\u0935\u0926\u094d\u092f\u0928\u094d\u0928 \u0938\u0947\u0935\u093f\u0924\u0902 |\n\u0935\u093f\u0937\u094d\u0923\u0941\u092e\u093e\u092f\u093e\u0928\u094d\u0935\u093f\u0924\u0902 \u0936\u093e\u0938\u094d\u0924\u093e \u092a\u0930\u093f\u0935\u093e\u0930\u0902 \u0928\u092e\u093e\u092e\u094d\u092f\u0939\u0902 ||\n\n----------------------------------------\n\n\u0938\u094d\u0935\u093e\u092e\u093f......... .........\u092f\u0947 \u0936\u0930\u0923\u092e\u092f\u094d\u092f\u092a\u094d\u092a\n\n[ \u0926\u0940\u0915\u094d\u0937 \u0935\u093f\u0930\u092e\u0923 \u092e\u0902\u0924\u094d\u0930\u092e\u0941 ]\n\n\u0905\u092a\u0942\u0930\u094d\u0935\u092e\u091a\u0932\u093e\u0930\u094b\u0939 | \u0926\u093f\u0935\u094d\u092f\u0926\u0930\u094d\u0936\u0928 \u0915\u093e\u0930\u0923\u093e\u0924\u094d |\n\u0936\u093e\u0938\u094d\u0924\u0943 \u092e\u0941\u0926\u094d\u0930\u093e\u0924\u094d \u092e\u0939\u093e\u0926\u0947\u0935 | \u0926\u0947\u0939\u093f \u092e\u0947 \u0935\u094d\u0930\u0924\u0935\u093f\u092e\u094b\u091a\u0928\u092e\u094d ||\n\n----------------------------------------\n\n[ \u092e\u094b\u0926\u091f\u093f \u0938\u0902\u0935\u0924\u094d\u0938\u0930\u0902 \u0928\u0941\u0902\u0921\u093f 18 \u0938\u0902\u0935\u0924\u094d\u0938\u0930\u092e\u0941\u0932 \u0935\u0930\u0915\u0941 \u092e\u093e\u0932 \u0935\u0947\u0938\u0941\u0915\u0941\u0928\u094d\u0928 \u0938\u094d\u0935\u093e\u092e\u0941\u0932 \u092a\u0947\u0930\u094d\u0932\u0941 ]\n\n1\u0935 \u0938\u0902\u0935\u0924\u094d\u0938\u0930\u0902 - \u0915\u0928\u094d\u0928\u093f(\u0936\u0930\u092e\u0941) \u0938\u094d\u0935\u093e\u092e\u093f\n2\u0935 \u0938\u0902\u0935\u0924\u094d\u0938\u0930\u0902 - \u0915\u0924\u094d\u0924\u093f \u0938\u094d\u0935\u093e\u092e\u093f\n3\u0935 \u0938\u0902\u0935\u0924\u094d\u0938\u0930\u0902 - \u0918\u0902\u091f \u0938\u094d\u0935\u093e\u092e\u093f\n4\u0935 \u0938\u0902\u0935\u0924\u094d\u0938\u0930\u0902 - \u0917\u0926 \u0938\u094d\u0935\u093e\u092e\u093f\n5\u0935 \u0938\u0902\u0935\u0924\u094d\u0938\u0930\u0902 - \u0935\u093f\u0932\u094d\u0932\u0941 \u0938\u094d\u0935\u093e\u092e\u093f\n6\u0935 \u0938\u0902\u0935\u0924\u094d\u0938\u0930\u0902 - \u091c\u094d\u092f\u094b\u0924\u093f \u0938\u094d\u0935\u093e\u092e\u093f\n7\u0935 \u0938\u0902\u0935\u0924\u094d\u0938\u0930\u0902 - \u0938\u0942\u0930\u094d\u092f \u0938\u094d\u0935\u093e\u092e\u093f\n8\u0935 \u0938\u0902\u0935\u0924\u094d\u0938\u0930\u0902 - \u091a\u0902\u0926\u094d\u0930 \u0938\u094d\u0935\u093e\u092e\u093f\n9\u0935 \u0938\u0902\u0935\u0924\u094d\u0938\u0930\u0902 - \u0935\u0947\u0932\u0941(\u0924\u094d\u0930\u093f\u0936\u0942\u0932) \u0938\u094d\u0935\u093e\u092e\u093f\n10\u0935 \u0938\u0902\u0935\u0924\u094d\u0938\u0930\u0902 - \u0935\u093f\u0937\u094d\u0923\u0941 \u091a\u0915\u094d\u0930 \u0938\u094d\u0935\u093e\u092e\u093f\n11\u0935 \u0938\u0902\u0935\u0924\u094d\u0938\u0930\u0902 - \u0936\u0902\u0916\u0902 \u0938\u094d\u0935\u093e\u092e\u093f\n12\u0935 \u0938\u0902\u0935\u0924\u094d\u0938\u0930\u0902 - \u0928\u093e\u0917\u093e\u092d\u0930\u0923\u0902 \u0938\u094d\u0935\u093e\u092e\u093f\n13\u0935 \u0938\u0902\u0935\u0924\u094d\u0938\u0930\u0902 - \u0936\u094d\u0930\u0940 \u0939\u0930\u093f \u0938\u094d\u0935\u093e\u092e\u093f\n14\u0935 \u0938\u0902\u0935\u0924\u094d\u0938\u0930\u0902 - \u092a\u0926\u094d\u092e \u0938\u094d\u0935\u093e\u092e\u093f\n15\u0935 \u0938\u0902\u0935\u0924\u094d\u0938\u0930\u0902 - \u0936\u094d\u0930\u0940 (\u0924\u094d\u0930\u093f\u0936\u0942\u0932) \u0938\u094d\u0935\u093e\u092e\u093f\n16\u0935 \u0938\u0902\u0935\u0924\u094d\u0938\u0930\u0902 - \u0936\u092c\u0930\u093f\u0917\u093f\u0930\u093f \u0938\u094d\u0935\u093e\u092e\u093f\n17\u0935 \u0938\u0902\u0935\u0924\u094d\u0938\u0930\u0902 - \u0913\u0902\u0915\u093e\u0930\u094b \u0938\u094d\u0935\u093e\u092e\u093f\n18\u0935 \u0938\u0902\u0935\u0924\u094d\u0938\u0930\u0902 - \u0928\u093e\u0930\u093f\u0915\u0947\u0933 \u0938\u094d\u0935\u093e\u092e\u093f",isAudio:!1,audioDurationSec:40,totalTime:"00:40"},{id:"6",slug:"sri-ayyappa-sharanu-gosha",title:"\u0936\u094d\u0930\u0940 \u0905\u092f\u094d\u092f\u092a\u094d\u092a\u093e \u0936\u0930\u0923\u0941 \u0918\u094b\u0937",description:"\u0913\u0902 \u0936\u094d\u0930\u0940 \u0938\u094d\u0935\u093e\u092e\u093f\u092f\u0947 \u0936\u0930\u0923\u092e\u092f\u094d\u092f\u092a\u094d\u092a\n    \u0939\u0930\u093f \u0939\u0930 \u0938\u0941\u0924\u0928\u0947 \u0936\u0930\u0923\u092e\u092f\u094d\u092f\u092a\u094d\u092a\n    \u0906\u092a\u0926\u094d\u092d\u093e\u0902\u0927\u0935\u0928\u0947 \u0936\u0930\u0923\u092e\u092f\u094d\u092f\u092a\u094d\u092a\n    \u0905\u0928\u093e\u0925\u0930\u0915\u094d\u0937\u0915\u0928\u0947 \u0936\u0930\u0923\u092e\u092f\u094d\u092f\u092a\u094d\u092a\n    \u0905\u0916\u093f\u0932\u093e\u0902\u0921 \u0915\u094b\u091f\u093f \u092c\u094d\u0930\u0939\u094d\u092e\u093e\u0902\u0921\u0928\u093e\u092f\u0915\u0928\u0947 \u0936\u0930\u0923\u092e\u092f\u094d\u092f\u092a\u094d\u092a\n    \u0905\u0928\u094d\u0928\u0926\u093e\u0928 \u092a\u094d\u0930\u092d\u0941\u0935\u0947 \u0936\u0930\u0923\u092e\u092f\u094d\u092f\u092a\u094d\u092a\n    \u0905\u092f\u094d\u092f\u092a\u094d\u092a\u0928\u0947 \u0936\u0930\u0923\u092e\u092f\u094d\u092f\u092a\u094d\u092a\n    \u0906\u0930\u093f\u092f\u0902\u0917\u093e\u0935\u0941 \u0905\u092f\u094d\u092f\u0935\u0947 \u0936\u0930\u0923\u092e\u092f\u094d\u092f\u092a\u094d\u092a\n    \u0906\u091a\u094d\u091a\u0928\u094d \u0915\u094b\u0935\u093f\u0932\u094d \u0905\u0930\u0928\u0947 \u0936\u0930\u0923\u092e\u092f\u094d\u092f\u092a\u094d\u092a\n    \u0915\u0941\u0932\u0924\u094d\u0924\u092a\u0941\u0933\u0948 \u092c\u093e\u0932\u0915\u0928\u0947 \u0936\u0930\u0923\u092e\u092f\u094d\u092f\u092a\u094d\u092a\n    \u090f\u0930\u0941\u092e\u0947\u0932\u093f \u0936\u093e\u0938\u094d\u0924\u0928\u0947 \u0936\u0930\u0923\u092e\u092f\u094d\u092f\u092a\u094d\u092a\n    \u0935\u093e\u0935\u0930\u0941\u0938\u094d\u0935\u093e\u092e\u093f\u0928\u0947 \u0936\u0930\u0923\u092e\u092f\u094d\u092f\u092a\u094d\u092a\n    \u0915\u0928\u094d\u0928\u093f\u092e\u0942\u0932 \u092e\u0939\u093e \u0917\u0923\u092a\u0924\u093f\u092f\u0947 \u0936\u0930\u0923\u092e\u092f\u094d\u092f\u092a\u094d\u092a\n    \u0928\u093e\u0917\u0930\u093e\u091c\u0935\u0947 \u0936\u0930\u0923\u092e\u092f\u094d\u092f\u092a\u094d\u092a\n    \u092e\u093e\u0933\u093f\u0915\u093e\u092a\u0941\u0930\u0924\u094d\u0924 \u0932\u094b\u0915\u0926\u0947\u0935\u093f \u092e\u093e\u0924\u093e\u092f\u0947 \u0936\u0930\u0923\u092e\u092f\u094d\u092f\u092a\u094d\u092a\n    \u0915\u0941\u0930\u0941\u092a\u094d\u092a \u0938\u094d\u0935\u093e\u092e\u093f\u092f\u0947 \u0936\u0930\u0923\u092e\u092f\u094d\u092f\u092a\u094d\u092a\n    \u0938\u0947\u0935\u093f\u092a\u094d\u092a \u0935\u0930\u094d\u0915\u093e\u0928\u0902\u0926 \u092e\u0942\u0930\u094d\u0924\u093f\u092f\u0947 \u0936\u0930\u0923\u092e\u092f\u094d\u092f\u092a\u094d\u092a\n    \u0915\u093e\u0936\u0940\u0935\u093e\u0938\u093f \u092f\u0947 \u0936\u0930\u0923\u092e\u092f\u094d\u092f\u092a\u094d\u092a\n    \u0939\u0930\u093f \u0926\u094d\u0935\u093e\u0930 \u0928\u093f\u0935\u093e\u0938\u093f\u092f\u0947 \u0936\u0930\u0923\u092e\u092f\u094d\u092f\u092a\u094d\u092a\n    \u0936\u094d\u0930\u0940 \u0930\u0902\u0917\u092a\u091f\u094d\u091f\u0923 \u0935\u093e\u0938\u093f\u092f\u0947 \u0936\u0930\u0923\u092e\u092f\u094d\u092f\u092a\u094d\u092a\n    \u0915\u0930\u0941\u092a\u094d\u092a\u091f\u0942\u0930\u0941 \u0935\u093e\u0938\u093f\u092f\u0947 \u0936\u0930\u0923\u092e\u092f\u094d\u092f\u092a\u094d\u092a\n    \u092a\u0932\u092e\u0942\u0930\u0941 \u0927\u0930\u094d\u092e\u0936\u093e\u0938\u094d\u0924\u093e\u0935\u0947 \u0936\u0930\u0923\u092e\u092f\u094d\u092f\u092a\u094d\u092a\n    \u0938\u0926\u094d\u0917\u0941\u0930\u0941 \u0928\u093e\u0927\u0928\u0947 \u0936\u0930\u0923\u092e\u092f\u094d\u092f\u092a\u094d\u092a\n    \u0935\u093f\u0932\u093e\u0932\u093f \u0935\u0940\u0930\u0928\u0947 \u0936\u0930\u0923\u092e\u092f\u094d\u092f\u092a\u094d\u092a\n    \u0935\u0940\u0930\u092e\u0923\u093f\u0915\u0902\u0920\u0928\u0947 \u0936\u0930\u0923\u092e\u092f\u094d\u092f\u092a\u094d\u092a\n    \u0927\u0930\u094d\u092e \u0936\u093e\u0938\u094d\u0924\u094d\u0930\u0935\u0947 \u0936\u0930\u0923\u092e\u092f\u094d\u092f\u092a\u094d\u092a\n    \u0936\u0930\u0923\u0941\u0918\u094b\u0937\u092a\u094d\u0930\u093f\u092f\u0935\u0947 \u0936\u0930\u0923\u092e\u092f\u094d\u092f\u092a\u094d\u092a\n    \u0915\u093e\u0902\u0924\u093f \u092e\u0932\u0948 \u0935\u093e\u0938\u0928\u0947 \u0936\u0930\u0923\u092e\u092f\u094d\u092f\u092a\u094d\u092a\n    \u092a\u094b\u0928\u094d\u0928\u0902\u092c\u0932\u0935\u093e\u0938\u093f\u092f\u0947 \u0936\u0930\u0923\u092e\u092f\u094d\u092f\u092a\u094d\u092a\n    \u092a\u0902\u0926\u0932\u0936\u093f\u0936\u0941\u0935\u0947 \u0936\u0930\u0923\u092e\u092f\u094d\u092f\u092a\u094d\u092a\n    \u0935\u093e\u0935\u0930\u093f\u0928\u094d \u0924\u094b\u0933\u0928\u0947 \u0936\u0930\u0923\u092e\u092f\u094d\u092f\u092a\u094d\u092a\n    \u092e\u094b\u0939\u093f\u0928\u0940\u0938\u0941\u0924\u0935\u0947 \u0936\u0930\u0923\u092e\u092f\u094d\u092f\u092a\u094d\u092a\n    \u0915\u0923\u094d \u0915\u0902\u0921 \u0926\u0948\u0935\u092e\u0947 \u0936\u0930\u0923\u092e\u092f\u094d\u092f\u092a\u094d\u092a\n    \u0915\u0932\u093f\u092f\u0941\u0917\u0935\u0930\u0926\u0928\u0947 \u0936\u0930\u0923\u092e\u092f\u094d\u092f\u092a\u094d\u092a\n    \u0938\u0930\u094d\u0935\u0930\u094b\u0917 \u0928\u093f\u0935\u093e\u0930\u0923 \u0927\u0928\u094d\u0935\u0902\u0924\u0930 \u092e\u0942\u0930\u094d\u0924\u093f\u092f\u0947 \u0936\u0930\u0923\u092e\u092f\u094d\u092f\u092a\u094d\u092a\n    \u092e\u0939\u093f\u0937\u093f\u092e\u0930\u094d\u0926\u0928\u0928\u0947 \u0936\u0930\u0923\u092e\u092f\u094d\u092f\u092a\u094d\u092a\n    \u092a\u0942\u0930\u094d\u0923 \u092a\u0941\u0937\u094d\u0915\u0932 \u0928\u093e\u0927\u0928\u0947 \u0936\u0930\u0923\u092e\u092f\u094d\u092f\u092a\u094d\u092a\n    \u0935\u0928\u094d \u092a\u0941\u0932\u093f \u0935\u093e\u0939\u0928\u0928\u0947 \u0936\u0930\u0923\u092e\u092f\u094d\u092f\u092a\u094d\u092a\n    \u092d\u0915\u094d\u0924\u0935\u0924\u094d\u0938\u0932\u0928\u0947 \u0936\u0930\u0923\u092e\u092f\u094d\u092f\u092a\u094d\u092a\n    \u092d\u0942\u0932\u094b\u0915\u0928\u093e\u0927\u0928\u0947 \u0936\u0930\u0923\u092e\u092f\u094d\u092f\u092a\u094d\u092a\n    \u0905\u092f\u093f\u0902\u0926\u0941\u092e\u0932\u0948\u0935\u093e\u0938\u0935\u0947 \u0936\u0930\u0923\u092e\u092f\u094d\u092f\u092a\u094d\u092a\n    \u0936\u092c\u0930\u093f \u0917\u093f\u0930\u0940\u0936\u0928\u0947 \u0936\u0930\u0923\u092e\u092f\u094d\u092f\u092a\u094d\u092a\n    \u0907\u0930\u0941\u092e\u0941\u0921\u093f \u092a\u094d\u0930\u093f\u092f\u0928\u0947 \u0936\u0930\u0923\u092e\u092f\u094d\u092f\u092a\u094d\u092a\n    \u0905\u092d\u093f\u0937\u0947\u0915\u092a\u094d\u0930\u093f\u092f\u0928\u0947 \u0936\u0930\u0923\u092e\u092f\u094d\u092f\u092a\u094d\u092a\n    \u0935\u0947\u0926\u092a\u094d\u092a\u094b\u0930\u0941\u0933\u0940\u0928\u0947 \u0936\u0930\u0923\u092e\u092f\u094d\u092f\u092a\u094d\u092a\n    \u0928\u093f\u0924\u094d\u092f \u092c\u094d\u0930\u0939\u094d\u092e \u091a\u093e\u0930\u093f\u0923\u0947 \u0936\u0930\u0923\u092e\u092f\u094d\u092f\u092a\u094d\u092a\n    \u0938\u0930\u094d\u0935 \u092e\u0902\u0917\u0933\u0926\u093e\u092f\u0915\u0928\u0947 \u0936\u0930\u0923\u092e\u092f\u094d\u092f\u092a\u094d\u092a\n    \u0935\u0940\u0930\u093e\u0927\u093f\u0935\u0940\u0930\u0928\u0947 \u0936\u0930\u0923\u092e\u092f\u094d\u092f\u092a\u094d\u092a\n    \u0913\u0902\u0915\u093e\u0930\u093e\u092a\u094d\u092a\u094b\u0930\u0941\u0933\u0947 \u0936\u0930\u0923\u092e\u092f\u094d\u092f\u092a\u094d\u092a\n    \u0906\u0928\u0902\u0926\u0930\u0942\u092a\u0928\u0947 \u0936\u0930\u0923\u092e\u092f\u094d\u092f\u092a\u094d\u092a\n    \u092d\u0915\u094d\u0924 \u091a\u093f\u0924\u094d\u0924\u093e\u0926\u093f\u0935\u093e\u0938\u0928\u0947 \u0936\u0930\u0923\u092e\u092f\u094d\u092f\u092a\u094d\u092a\n    \u0906\u0936\u094d\u0930\u093f\u0924\u0935\u0924\u094d\u0938 \u0932\u0928\u0947 \u0936\u0930\u0923\u092e\u092f\u094d\u092f\u092a\u094d\u092a\n    \u092d\u0942\u0924 \u0917\u0923\u093e\u0927\u093f\u092a\u0924\u092f\u0947 \u0936\u0930\u0923\u092e\u092f\u094d\u092f\u092a\u094d\u092a\n    \u0936\u0915\u094d\u0924\u093f\u0930\u0942\u092a\u0928\u0947 \u0936\u0930\u0923\u092e\u092f\u094d\u092f\u092a\u094d\u092a\n    \u0928\u093e\u0917\u093e\u0930\u094d\u091c\u0941\u0928\u0938\u093e\u0917\u0930\u0941\u0927\u0930\u094d\u092e \u0936\u093e\u0938\u094d\u0924\u0935\u0947 \u0936\u0930\u0923\u092e\u092f\u094d\u092f\u092a\u094d\u092a\n    \u0936\u093e\u0902\u0924\u092e\u0942\u0930\u094d\u0924\u092f\u0947 \u0936\u0930\u0923\u092e\u092f\u094d\u092f\u092a\u094d\u092a\n    \u092a\u0926\u0941\u0928\u0947\u0932\u094d\u092c\u093e\u092c\u0921\u093f\u0915\u094d\u0915\u093f \u0905\u0927\u093f\u092a\u0924\u093f\u092f\u0947 \u0936\u0930\u0923\u092e\u092f\u094d\u092f\u092a\u094d\u092a\n    \u0915\u091f\u094d\u091f\u093e\u0932 \u0935\u093f\u0937\u093e\u0930\u093e\u092e\u0928\u0947 \u0936\u0930\u0923\u092e\u092f\u094d\u092f\u092a\u094d\u092a\n    \u090b\u0937\u093f\u0915\u0941\u0932 \u0930\u0915\u094d\u0937\u0915\u0941\u0928\u0947 \u0936\u0930\u0923\u092e\u092f\u094d\u092f\u092a\u094d\u092a\n    \u0935\u0947\u0926\u092a\u094d\u0930\u093f\u092f\u0928\u0947 \u0936\u0930\u0923\u092e\u092f\u094d\u092f\u092a\u094d\u092a\n    \u0909\u0924\u094d\u0924\u0930\u093e\u0928\u0915\u094d\u0937\u0924\u094d\u0930 \u091c\u093e\u0924\u0915\u0928\u0947 \u0936\u0930\u0923\u092e\u092f\u094d\u092f\u092a\u094d\u092a\n    \u0924\u092a\u094b\u0927\u0928\u0928\u0947 \u0936\u0930\u0923\u092e\u092f\u094d\u092f\u092a\u094d\u092a\n    \u092f\u0902\u0917\u0933\u0915\u0941\u0932 \u0926\u0948\u0935\u092e\u0947 \u0936\u0930\u0923\u092e\u092f\u094d\u092f\u092a\u094d\u092a\n    \u091c\u0917\u0928\u094d\u092e\u094b\u0939\u0928\u0947 \u0936\u0930\u0923\u092e\u092f\u094d\u092f\u092a\u094d\u092a\n    \u092e\u094b\u0939\u0928\u0930\u0942\u092a\u0928\u0947 \u0936\u0930\u0923\u092e\u092f\u094d\u092f\u092a\u094d\u092a\n    \u092e\u093e\u0927\u0935\u0938\u0941\u0924\u0928\u0947 \u0936\u0930\u0923\u092e\u092f\u094d\u092f\u092a\u094d\u092a\n    \u092f\u0926\u0941\u0915\u0941\u0932\u0935\u0940\u0930\u0928\u0947 \u0936\u0930\u0923\u092e\u092f\u094d\u092f\u092a\u094d\u092a\n    \u092e\u093e\u092e\u0932\u0948 \u0935\u093e\u0938\u0928\u0947 \u0936\u0930\u0923\u092e\u092f\u094d\u092f\u092a\u094d\u092a\n    \u0937\u0923\u094d\u092e\u0941\u0916\u0938\u094b\u0926\u0930 \u0928\u0947 \u0936\u0930\u0923\u092e\u092f\u094d\u092f\u092a\u094d\u092a\n    \u0935\u0947\u0926\u093e\u0902\u0924\u0930\u0942\u092a\u0928\u0947 \u0936\u0930\u0923\u092e\u092f\u094d\u092f\u092a\u094d\u092a\n    \u0936\u0902\u0915\u0930 \u0938\u0941\u0924\u0928\u0947 \u0936\u0930\u0923\u092e\u092f\u094d\u092f\u092a\u094d\u092a\n    \u0936\u0924\u094d\u0930\u0941\u0938\u0902\u0939\u093e\u0930\u093f\u0923\u0947 \u0936\u0930\u0923\u092e\u092f\u094d\u092f\u092a\u094d\u092a\n    \u0938\u0926\u094d\u0917\u0941\u0923\u092e\u0942\u0930\u094d\u0924\u092f\u0947 \u0936\u0930\u0923\u092e\u092f\u094d\u092f\u092a\u094d\u092a\n    \u092a\u0930\u093e\u0936\u0915\u094d\u0924\u093f\u092f\u0947 \u0936\u0930\u0923\u092e\u092f\u094d\u092f\u092a\u094d\u092a\n    \u092a\u0930\u093e\u0924\u094d\u092a\u0930\u0928\u0947 \u0936\u0930\u0923\u092e\u092f\u094d\u092f\u092a\u094d\u092a\n    \u092a\u0930\u0902\u091c\u094d\u092f\u094b\u0924\u093f\u092f\u0947 \u0936\u0930\u0923\u092e\u092f\u094d\u092f\u092a\u094d\u092a\n    \u0939\u094b\u092e\u092a\u094d\u0930\u093f\u092f\u0928\u0947 \u0936\u0930\u0923\u092e\u092f\u094d\u092f\u092a\u094d\u092a\n    \u0917\u0923\u092a\u0924\u093f \u0938\u094b\u0926\u0930 \u0928\u0947 \u0936\u0930\u0923\u092e\u092f\u094d\u092f\u092a\u094d\u092a\n    \u0927\u0930\u094d\u092e \u0936\u093e\u0938\u094d\u0924\u094d\u0930\u093e\u0935\u0947 \u0936\u0930\u0923\u092e\u092f\u094d\u092f\u092a\u094d\u092a\n    \u0935\u093f\u0937\u094d\u0923\u0941\u0938\u0941\u0924\u0928\u0947 \u0936\u0930\u0923\u092e\u092f\u094d\u092f\u092a\u094d\u092a\n    \u0938\u0915\u0932 \u0915\u0933\u093e \u0935\u0932\u094d\u0932\u092d\u0928\u0947 \u0936\u0930\u0923\u092e\u092f\u094d\u092f\u092a\u094d\u092a\n    \u0932\u094b\u0915 \u0930\u0915\u094d\u0937\u0915\u0928\u0947 \u0936\u0930\u0923\u092e\u092f\u094d\u092f\u092a\u094d\u092a\n    \u0905\u092e\u093f\u0924 \u0917\u0941\u0923\u093e\u0915\u0930\u0923\u0947 \u0936\u0930\u0923\u092e\u092f\u094d\u092f\u092a\u094d\u092a\n    \u0905\u0932\u0902\u0915\u093e\u0930 \u092a\u094d\u0930\u093f\u092f\u0928\u0947 \u0936\u0930\u0923\u092e\u092f\u094d\u092f\u092a\u094d\u092a\n    \u0915\u0928\u094d\u0928\u093f \u092e\u093e\u0930\u0948 \u0915\u092a\u094d\u092a\u0935\u0928\u0947 \u0936\u0930\u0923\u092e\u092f\u094d\u092f\u092a\u094d\u092a\n    \u092d\u0941\u0935\u0928\u0947\u0936\u094d\u0935\u0930\u0928\u0947 \u0936\u0930\u0923\u092e\u092f\u094d\u092f\u092a\u094d\u092a\n    \u092e\u093e\u0924\u093e\u092a\u093f\u0924\u093e \u0917\u0941\u0930\u0941\u0926\u0948\u0935\u092e\u0947 \u0936\u0930\u0923\u092e\u092f\u094d\u092f\u092a\u094d\u092a\n    \u0938\u094d\u0935\u093e\u092e\u093f\u092f\u093f\u0928\u094d \u092a\u0942\u0902\u0917\u093e\u0935\u0928\u092e\u0947 \u0936\u0930\u0923\u092e\u092f\u094d\u092f\u092a\u094d\u092a\n    \u0905\u0933\u0941\u0926\u093e\u0928\u0926\u093f\u092f\u0947 \u0936\u0930\u0923\u092e\u092f\u094d\u092f\u092a\u094d\u092a\n    \u0905\u0933\u0941\u0926\u093e\u092e\u0947\u0921\u0947 \u0936\u0930\u0923\u092e\u092f\u094d\u092f\u092a\u094d\u092a\n    \u0915\u0932\u094d\u0932\u093f\u0921\u094d\u0930\u0902\u0915\u0941\u0902\u0921\u094d\u0930\u0947 \u0936\u0930\u0923\u092e\u092f\u094d\u092f\u092a\u094d\u092a\n    \u0915\u0930\u093f\u092e\u0932\u0948 \u090f\u091f\u094d\u0930\u092e\u0947 \u0936\u0930\u0923\u092e\u092f\u094d\u092f\u092a\u094d\u092a\n    \u0915\u0930\u093f\u092e\u0932\u0948 \u090f\u0930\u0915\u094d\u0915\u092e\u0947 \u0936\u0930\u0923\u092e\u092f\u094d\u092f\u092a\u094d\u092a\n    \u092a\u0947\u0930\u093f\u092f\u093e\u0928\u094d \u0935\u091f\u094d\u091f\u092e\u0947 \u0936\u0930\u0923\u092e\u092f\u094d\u092f\u092a\u094d\u092a\n    \u091a\u0947\u0930\u093f\u092f\u093e\u0928 \u0935\u091f\u094d\u091f\u092e\u0947 \u0936\u0930\u0923\u092e\u092f\u094d\u092f\u092a\u094d\u092a\n    \u092a\u0902\u092c\u093e\u0928\u0926\u093f\u092f\u0947 \u0936\u0930\u0923\u092e\u092f\u094d\u092f\u092a\u094d\u092a\n    \u092a\u0902\u092c\u092f\u093f\u0932\u094d \u0935\u0947\u0933\u094d\u0933\u0915\u094d\u0915\u0947 \u0936\u0930\u0923\u092e\u092f\u094d\u092f\u092a\u094d\u092a\n    \u0928\u0940\u0932\u093f\u092e\u0932\u0948 \u092f\u0947 \u091f\u094d\u0930\u0947\u092e\u0947 \u0936\u0930\u0923\u092e\u092f\u094d\u092f\u092a\u094d\u092a\n    \u0905\u092a\u094d\u092a\u093e\u091a\u093f \u092e\u0947\u0921\u0947 \u0936\u0930\u0923\u092e\u092f\u094d\u092f\u092a\u094d\u092a\n    \u0936\u092c\u0930\u0940\u092a\u0940\u0920\u092e\u0947 \u0936\u0930\u0923\u092e\u092f\u094d\u092f\u092a\u094d\u092a\n    \u0936\u0930\u0902 \u0917\u0941\u0924\u094d\u0924\u093f \u0906\u0932\u0947 \u0936\u0930\u0923\u092e\u092f\u094d\u092f\u092a\u094d\u092a\n    \u092d\u0938\u094d\u092e\u0915\u0941\u0933\u092e\u0947 \u0936\u0930\u0923\u092e\u092f\u094d\u092f\u092a\u094d\u092a\n    \u092a\u0926\u0941\u0928\u0947\u091f\u094d\u091f\u093e\u092e\u094d \u092c\u0921\u093f\u092f\u0947 \u0936\u0930\u0923\u092e\u092f\u094d\u092f\u092a\u094d\u092a\n    \u0928\u0947\u092f\u094d\u092f\u0940\u092d\u093f \u0937\u0947\u0915\u092a\u094d\u0930\u093f\u092f\u0928\u0947 \u0936\u0930\u0923\u092e\u092f\u094d\u092f\u092a\u094d\u092a\n    \u0915\u0930\u094d\u092a\u0942\u0930 \u091c\u094d\u092f\u094b\u0924\u093f\u092f\u0947 \u0936\u0930\u0923\u092e\u092f\u094d\u092f\u092a\u094d\u092a\n    \u091c\u094d\u092f\u094b\u0924\u093f\u0938\u094d\u0935\u0930\u0942\u092a\u0928\u0947 \u0936\u0930\u0923\u092e\u092f\u094d\u092f\u092a\u094d\u092a\n    \u092e\u0915\u0930 \u091c\u094d\u092f\u094b\u0924\u093f\u092f\u0947 \u0936\u0930\u0923\u092e\u092f\u094d\u092f\u092a\u094d\u092a\n    \u092a\u0902\u0926\u0932 \u0930\u093e\u091c \u0915\u0941\u092e\u093e\u0930\u0928\u0947 \u0936\u0930\u0923\u092e\u092f\u094d\u092f\u092a\u094d\u092a",isAudio:!1,audioDurationSec:40,totalTime:"00:40"},{id:"7",slug:"nithyapooja",title:"\u0928\u093f\u0924\u094d\u092f \u092a\u0942\u091c\u093e (\u0938\u0930\u0932 \u0935\u093f\u0927\u093f)",description:"\u0938\u0942\u091a\u0928 : \u0928\u093f\u0924\u094d\u092f \u092a\u0942\u091c\u0932\u094b \u0935\u093f\u0935\u093f\u0927 \u0926\u0947\u0935\u0924\u0932\u0915\u0941 \u0938\u0947\u092a\u0930\u0947\u091f\u0941\u0917\u093e \u092a\u0942\u091c \u091a\u0947\u0938\u094d\u0924\u0947 \u0938\u092e\u092f\u0902 \u090f\u0915\u094d\u0915\u0941\u0935 \u092a\u0921\u0941\u0924\u0941\u0902\u0926\u093f \u0915\u093e\u092c\u091f\u094d\u091f\u093f \u092e\u0941\u0916\u094d\u092f\u092e\u0948\u0928 \u0926\u0947\u0935\u0941\u0933\u094d\u0933\u0928\u0941 \u0913\u0915\u0947\u0938\u093e\u0930\u093f \u0906\u0939\u094d\u0935\u093e\u0928\u093f\u0902\u091a\u093f \u092a\u0942\u091c \u091a\u0947\u0938\u0947 \u0935\u093f\u0927\u093e\u0928\u0902.\n\n\u0936\u094d\u0930\u0940 \u092e\u0939\u093e\u0917\u0923\u093e\u0927\u093f\u092a\u0924\u092f\u0947 \u0928\u092e\u0903\n\u0936\u094d\u0930\u0940 \u0917\u0941\u0930\u0941\u092d\u094d\u092f\u094b\u0928\u092e\u0903 \u0939\u0930\u093f\u0903 \u0913\u0902\n\n\u0936\u0941\u0915\u094d\u0932\u093e\u0902\u092c\u0930\u0927\u0930\u0902 \u0935\u093f\u0937\u094d\u0923\u0941\u0902 \u0936\u0936\u093f\u0935\u0930\u094d\u0923\u0902 \u091a\u0924\u0941\u0930\u094d\u092d\u0941\u091c\u092e\u094d |\n\u092a\u094d\u0930\u0938\u0928\u094d\u0928\u0935\u0926\u0928\u0902 \u0927\u094d\u092f\u093e\u092f\u0947\u0924\u094d \u0938\u0930\u094d\u0935\u0935\u093f\u0918\u094d\u0928\u094b\u092a\u0936\u093e\u0902\u0924\u092f\u0947 ||\n\n\u0938\u0930\u0938\u094d\u0935\u0924\u0940 \u0928\u092e\u0938\u094d\u0924\u0941\u092d\u094d\u092f\u0902 \u0935\u0930\u0926\u0947 \u0915\u093e\u092e\u0930\u0942\u092a\u093f\u0923\u0940 |\n\u0935\u093f\u0926\u094d\u092f\u093e\u0930\u0902\u092d\u0902 \u0915\u0930\u093f\u0937\u094d\u092f\u093e\u092e\u093f \u0938\u093f\u0926\u094d\u0927\u093f\u0930\u094d\u092d\u0935\u0924\u0941 \u092e\u0947 \u0938\u0926\u093e ||\n\n\u0917\u0941\u0930\u0941\u0930\u094d\u092c\u094d\u0930\u0939\u094d\u092e \u0917\u0941\u0930\u0941\u0930\u094d\u0935\u093f\u0937\u094d\u0923\u0941\u0903 \u0917\u0941\u0930\u0941\u0930\u094d\u0926\u0947\u0935\u094b \u092e\u0939\u0947\u0936\u094d\u0935\u0930\u0903 |\n\u0917\u0941\u0930\u0941\u0903 \u0938\u093e\u0915\u094d\u0937\u093e\u0924\u094d \u092a\u0930\u092c\u094d\u0930\u0939\u094d\u092e \u0924\u0938\u094d\u092e\u0948 \u0936\u094d\u0930\u0940 \u0917\u0941\u0930\u0935\u0947 \u0928\u092e\u0903 ||\n\n\u0906\u091a\u092e\u094d\u092f\n\n\u0913\u0902 \u0915\u0947\u0936\u0935\u093e\u092f \u0938\u094d\u0935\u093e\u0939\u093e | (\u0905\u0928\u093f \u0906\u091a\u092e\u0928\u0902 \u091a\u0947\u092f\u0935\u0932\u0947\u0928\u0941)\n\u0913\u0902 \u0928\u093e\u0930\u093e\u092f\u0923\u093e\u092f \u0938\u094d\u0935\u093e\u0939\u093e | (\u0905\u0928\u093f \u0906\u091a\u092e\u0928\u0902 \u091a\u0947\u092f\u0935\u0932\u0947\u0928\u0941)\n\u0913\u0902 \u092e\u093e\u0927\u0935\u093e\u092f \u0938\u094d\u0935\u093e\u0939\u093e | (\u0905\u0928\u093f \u0906\u091a\u092e\u0928\u0902 \u091a\u0947\u092f\u0935\u0932\u0947\u0928\u0941)\n\n(\u0905\u0928\u093f \u092e\u0942\u0921\u0941\u0938\u093e\u0930\u094d\u0932\u0941 \u0906\u091a\u092e\u0928\u0902 \u091a\u0947\u0938\u093f \u091a\u0947\u0924\u0941\u0932\u0941 \u0915\u0921\u0941\u0915\u094d\u0915\u094b\u0935\u0932\u0947\u0928\u0941)\n\n\u0913\u0902 \u0917\u094b\u0935\u093f\u0902\u0926\u093e\u092f \u0928\u092e\u0903 |\n\u0913\u0902 \u0935\u093f\u0937\u094d\u0923\u0935\u0947 \u0928\u092e\u0903 |\n\u0913\u0902 \u092e\u0927\u0941\u0938\u0942\u0926\u0928\u093e\u092f \u0928\u092e\u0903 |\n\u0913\u0902 \u0924\u094d\u0930\u093f\u0935\u093f\u0915\u094d\u0930\u092e\u093e\u092f \u0928\u092e\u0903 |\n\u0913\u0902 \u0935\u093e\u092e\u0928\u093e\u092f \u0928\u092e\u0903 |\n\u0913\u0902 \u0936\u094d\u0930\u0940\u0927\u0930\u093e\u092f \u0928\u092e\u0903 |\n\u0913\u0902 \u0939\u0943\u0937\u0940\u0915\u0947\u0936\u093e\u092f \u0928\u092e\u0903 |\n\u0913\u0902 \u092a\u0926\u094d\u092e\u0928\u093e\u092d\u093e\u092f \u0928\u092e\u0903 |\n\u0913\u0902 \u0926\u093e\u092e\u094b\u0926\u0930\u093e\u092f \u0928\u092e\u0903 |\n\u0913\u0902 \u0938\u0902\u0915\u0930\u094d\u0937\u0923\u093e\u092f \u0928\u092e\u0903 |\n\u0913\u0902 \u0935\u093e\u0938\u0941\u0926\u0947\u0935\u093e\u092f \u0928\u092e\u0903 |\n\u0913\u0902 \u092a\u094d\u0930\u0926\u094d\u092f\u0941\u092e\u094d\u0928\u093e\u092f \u0928\u092e\u0903 |\n\u0913\u0902 \u0905\u0928\u093f\u0930\u0941\u0926\u094d\u0927\u093e\u092f \u0928\u092e\u0903 |\n\u0913\u0902 \u092a\u0941\u0930\u0941\u0937\u094b\u0924\u094d\u0924\u092e\u093e\u092f \u0928\u092e\u0903 |\n\u0913\u0902 \u0905\u0927\u094b\u0915\u094d\u0937\u091c\u093e\u092f \u0928\u092e\u0903 |\n\u0913\u0902 \u0928\u093e\u0930\u0938\u093f\u0902\u0939\u093e\u092f \u0928\u092e\u0903 |\n\u0913\u0902 \u0905\u091a\u094d\u092f\u0941\u0924\u093e\u092f \u0928\u092e\u0903 |\n\u0913\u0902 \u091c\u0928\u093e\u0930\u094d\u0926\u0928\u093e\u092f \u0928\u092e\u0903 |\n\u0913\u0902 \u0909\u092a\u0947\u0902\u0926\u094d\u0930\u093e\u092f \u0928\u092e\u0903 |\n\u0913\u0902 \u0939\u0930\u092f\u0947 \u0928\u092e\u0903 |\n\u0913\u0902 \u0936\u094d\u0930\u0940 \u0915\u0943\u0937\u094d\u0923\u093e\u092f \u0928\u092e\u0903 |\n\n\u0938\u0902\u0927\u094d\u092f\u093e \u0926\u0940\u092a \u0926\u0930\u094d\u0936\u0928 \u0936\u094d\u0932\u094b\u0915\u0902\n\n\u0926\u0940\u092a\u0902 \u091c\u094d\u092f\u094b\u0924\u093f\u0903 \u092a\u0930\u092c\u094d\u0930\u0939\u094d\u092e \u0926\u0940\u092a\u0902 \u0938\u0930\u094d\u0935\u0924\u092e\u094b\u092a\u0939\u092e\u094d |\n\u0926\u0940\u092a\u0947\u0928 \u0938\u093e\u0927\u094d\u092f\u0924\u0947 \u0938\u0930\u094d\u0935\u0902 \u0938\u0902\u0927\u094d\u092f\u093e\u0926\u0940\u092a\u0902 \u0928\u092e\u094b\u0c3d\u0938\u094d\u0924\u0941\u0924\u0947 ||\n\n\u092d\u0942\u0924\u094b\u091a\u094d\u091b\u093e\u091f\u0928\u0902\n\n\u0909\u0924\u094d\u0924\u093f\u0937\u094d\u0920\u0902\u0924\u0941 \u092d\u0942\u0924\u092a\u093f\u0936\u093e\u091a\u093e\u0903 \u090f\u0924\u0947 \u092d\u0942\u092e\u093f\u092d\u093e\u0930\u0915\u093e\u0903 |\n\u090f\u0924\u0947\u0937\u093e\u092e\u0935\u093f\u0930\u094b\u0927\u0947\u0928 \u092c\u094d\u0930\u0939\u094d\u092e\u0915\u0930\u094d\u092e \u0938\u092e\u093e\u0930\u092d\u0947 ||\n\n\u0905\u092a\u0938\u0930\u094d\u092a\u0902\u0924\u0941 \u092f\u0947 \u092d\u0942\u0924\u093e \u092f\u0947 \u092d\u0942\u0924\u093e \u092d\u0942\u092e\u093f\u0938\u0902\u0938\u094d\u0925\u093f\u0924\u093e\u0903 |\n\u092f\u0947 \u092d\u0942\u0924\u093e \u0935\u093f\u0918\u094d\u0928\u0915\u0930\u094d\u0924\u093e\u0930\u0938\u094d\u0924\u0947 \u0917\u091a\u094d\u091b\u0902\u0924\u0941 \u0936\u093f\u0935\u093e\u091c\u094d\u091e\u092f\u093e ||\n\n\u092a\u094d\u0930\u093e\u0923\u093e\u092f\u093e\u092e\u0902\n\n\u0913\u0902 \u092d\u0942\u0903 \u0913\u0902 \u092d\u0941\u0935\u0903 \u0913\u0917\u094d\u0902 \u0938\u0941\u0935\u0903 \u0913\u0902 \u092e\u0939\u0903 |\n\u0913\u0902 \u091c\u0928\u0903 \u0913\u0902 \u0924\u092a\u0903 \u0913\u0917\u094d\u0902 \u0938\u0924\u094d\u092f\u092e\u094d |\n\u0913\u0902 \u0924\u0924\u094d\u0938\u0935\u093f\u0924\u0941\u0930\u094d\u0935\u0930\u0947\u0923\u094d\u092f\u0902 \u092d\u0930\u094d\u0917\u094b \u0926\u0947\u0935\u0938\u094d\u092f \u0927\u0940\u092e\u0939\u093f |\n\u0927\u093f\u092f\u094b \u092f\u094b \u0928\u0903 \u092a\u094d\u0930\u091a\u094b\u0926\u092f\u093e\u0924\u094d ||\n\u0913\u092e\u093e\u092a\u094b \u091c\u094d\u092f\u094b\u0924\u0940 \u0930\u0938\u094b\u0c3d\u092e\u0943\u0924\u0902 \u092c\u094d\u0930\u0939\u094d\u092e \u092d\u0942\u0930\u094d\u092d\u0941\u0935\u0938\u094d\u0938\u0941\u0935\u0930\u094b\u092e\u094d ||\n\n(\u092e\u0941\u0915\u094d\u0915\u0941\u0928\u0941 \u092a\u091f\u094d\u091f\u0941\u0915\u094b\u0928\u093f \u092a\u094d\u0930\u093e\u0923\u093e\u092f\u093e\u092e\u0902 \u091a\u0947\u092f\u0935\u0932\u0947\u0928\u0941)\n\n\u0938\u0902\u0915\u0932\u094d\u092a\u0902\n\n\u092e\u092e \u0909\u092a\u093e\u0924\u094d\u0924 \u0938\u092e\u0938\u094d\u0924 \u0926\u0941\u0930\u093f\u0924\u0915\u094d\u0937\u092f\u0926\u094d\u0935\u093e\u0930\u093e \u0936\u094d\u0930\u0940 \u092a\u0930\u092e\u0947\u0936\u094d\u0935\u0930 \u092a\u094d\u0930\u0940\u0924\u094d\u092f\u0930\u094d\u0925\u0902, \u0936\u0941\u092d\u0947 \u0936\u094b\u092d\u0928\u0947 \u092e\u0941\u0939\u0942\u0930\u094d\u0924\u0947 \u0936\u094d\u0930\u0940 \u092e\u0939\u093e\u0935\u093f\u0937\u094d\u0923\u094b\u0930\u093e\u091c\u094d\u091e\u092f\u093e \u092a\u094d\u0930\u0935\u0930\u094d\u0924\u092e\u093e\u0928\u0938\u094d\u092f \u0905\u0926\u094d\u092f \u092c\u094d\u0930\u0939\u094d\u092e\u0923\u0903 \u0926\u094d\u0935\u093f\u0924\u0940\u092f \u092a\u0930\u093e\u0930\u094d\u0925\u0947 \u0936\u094d\u0935\u0947\u0924\u0935\u0930\u093e\u0939\u0915\u0932\u094d\u092a\u0947 \u0935\u0948\u0935\u0938\u094d\u0935\u0924 \u092e\u0928\u094d\u0935\u0902\u0924\u0930\u0947 \u0915\u0932\u093f\u092f\u0941\u0917\u0947 \u092a\u094d\u0930\u0925\u092e\u092a\u093e\u0926\u0947 \u091c\u0902\u092c\u0942\u0926\u094d\u0935\u0940\u092a\u0947 \u092d\u0930\u0924\u0935\u0930\u094d\u0937\u0947 \u092d\u0930\u0924\u0916\u0902\u0921\u0947 \u092e\u0947\u0930\u094b\u0930\u094d\u0926\u0915\u094d\u0937\u093f\u0923\u0926\u093f\u0917\u094d\u092d\u093e\u0917\u0947 \u0936\u094d\u0930\u0940\u0936\u0948\u0932\u0938\u094d\u092f \u0908\u0936\u093e\u0928\u094d\u092f \u092a\u094d\u0930\u0926\u0947\u0936\u0947 \u0917\u0902\u0917\u093e \u0917\u094b\u0926\u093e\u0935\u0930\u094d\u092f\u094b\u0903 \u092e\u0927\u094d\u092f\u0926\u0947\u0936\u0947 \u0936\u094b\u092d\u0928\u0917\u0943\u0939\u0947 \u0938\u092e\u0938\u094d\u0924 \u0926\u0947\u0935\u0924\u093e \u0917\u094b\u092c\u094d\u0930\u093e\u0939\u094d\u092e\u0923 \u0939\u0930\u093f\u0939\u0930 \u0917\u0941\u0930\u0941\u091a\u0930\u0923 \u0938\u0928\u094d\u0928\u093f\u0927\u094c \u0905\u0938\u094d\u092e\u093f\u0928\u094d \u0935\u0930\u094d\u0924\u092e\u093e\u0928 \u0935\u094d\u092f\u093e\u0935\u0939\u093e\u0930\u093f\u0915 \u091a\u093e\u0902\u0926\u094d\u0930\u092e\u093e\u0928\u0947\u0928 \u0936\u094d\u0930\u0940 ... \u0928\u093e\u092e \u0938\u0902\u0935\u0924\u094d\u0938\u0930\u0947, ... \u0905\u092f\u0928\u0947, ... \u090b\u0924\u094c, ... \u092e\u093e\u0938\u0947, ... \u092a\u0915\u094d\u0937\u0947, ... \u0924\u093f\u0925\u094c, ... \u0935\u093e\u0938\u0930\u0947, \u0936\u0941\u092d \u0928\u0915\u094d\u0937\u0924\u094d\u0930\u0947, \u0936\u0941\u092d \u092f\u094b\u0917\u0947, \u0936\u0941\u092d \u0915\u0930\u0923\u0947, \u090f\u0935\u0902\u0917\u0941\u0923 \u0935\u093f\u0936\u0947\u0937\u0923 \u0935\u093f\u0936\u093f\u0937\u094d\u091f\u093e\u092f\u093e\u0902 \u0936\u0941\u092d\u0924\u093f\u0925\u094c, \u0936\u094d\u0930\u0940\u092e\u093e\u0928\u094d ... \u0917\u094b\u0924\u094d\u0930\u0903, ... \u0928\u093e\u092e\u0927\u0947\u092f\u0903 (\u0927\u0930\u094d\u092e\u092a\u0924\u094d\u0928\u0940 \u0938\u092e\u0947\u0924\u0938\u094d\u092f \u0905\u0938\u094d\u092e\u093e\u0915\u0902) \u0938\u0915\u0941\u091f\u0941\u0902\u092c\u093e\u0928\u093e\u0902 \u0915\u094d\u0937\u0947\u092e \u0938\u094d\u0925\u0948\u0930\u094d\u092f \u0927\u0948\u0930\u094d\u092f \u0935\u093f\u091c\u092f \u0905\u092d\u092f \u0906\u092f\u0941\u0930\u093e\u0930\u094b\u0917\u094d\u092f \u0910\u0936\u094d\u0935\u0930\u094d\u092f\u093e\u092d\u093f\u0935\u0943\u0926\u094d\u0927\u094d\u092f\u0930\u094d\u0925\u0902, \u0927\u0930\u094d\u092e\u093e\u0930\u094d\u0925 \u0915\u093e\u092e \u092e\u094b\u0915\u094d\u0937 \u091a\u0924\u0941\u0930\u094d\u0935\u093f\u0927 \u092b\u0932 \u092a\u0941\u0930\u0941\u0937\u093e\u0930\u094d\u0925 \u0938\u093f\u0926\u094d\u0927\u094d\u092f\u0930\u094d\u0925\u0902, \u0907\u0937\u094d\u091f\u0915\u093e\u092e\u094d\u092f\u093e\u0930\u094d\u0925 \u0938\u093f\u0926\u094d\u0927\u094d\u092f\u0930\u094d\u0925\u0902, \u0936\u094d\u0930\u0940 \u092e\u0939\u093e \u0917\u0923\u093e\u0927\u093f\u092a\u0924\u093f, \u0935\u0932\u094d\u0932\u0940 \u0926\u0947\u0935\u0938\u0947\u0928 \u0938\u092e\u0947\u0924 \u0938\u0941\u092c\u094d\u0930\u092e\u0923\u094d\u092f \u0938\u094d\u0935\u093e\u092e\u093f, \u0939\u0930\u093f\u0939\u0930 \u092a\u0941\u0924\u094d\u0930 \u0905\u092f\u094d\u092f\u092a\u094d\u092a \u0938\u094d\u0935\u093e\u092e\u093f \u0926\u0947\u0935\u0924\u093e \u0927\u094d\u092f\u093e\u0928\u093e\u0935\u093e\u0939\u0928\u093e\u0926\u093f \u0937\u094b\u0921\u0936\u094b\u092a\u091a\u093e\u0930 \u092a\u0942\u091c\u093e\u0902 \u0915\u0930\u093f\u0937\u094d\u092f\u0947...\n\n(\u0905\u0902\u091f\u0942 \u0905\u0915\u094d\u0937\u0924\u0932\u0941 \u0909\u0926\u0915\u0902 \u092a\u0933\u094d\u0933\u0947\u0902\u0932\u094b \u0935\u093f\u0921\u0941\u0935\u0935\u0932\u0947\u0928\u0941)\n\n\u0915\u0932\u0936\u093e\u0930\u093e\u0927\u0928\u0902\n\n\u0917\u0902\u0917\u0947\u091a \u092f\u092e\u0941\u0928\u0947 \u0915\u0943\u0937\u094d\u0923\u0947 \u0917\u094b\u0926\u093e\u0935\u0930\u0940 \u0938\u0930\u0938\u094d\u0935\u0924\u0940 |\n\u0928\u0930\u094d\u092e\u0926\u0947 \u0938\u093f\u0902\u0927\u0941 \u0915\u093e\u0935\u0947\u0930\u0940 \u091c\u0932\u0947\u0938\u094d\u092e\u093f\u0928\u094d \u0938\u0928\u094d\u0928\u093f\u0927\u093f\u0902 \u0915\u0941\u0930\u0941 ||\n\n\u0915\u093e\u0935\u0947\u0930\u0940 \u0924\u0941\u0902\u0917\u092d\u0926\u094d\u0930\u093e\u091a \u0915\u0943\u0937\u094d\u0923\u0935\u0947\u0923\u0940 \u091a \u0917\u094c\u0924\u092e\u0940 |\n\u092d\u093e\u0917\u0940\u0930\u0925\u0940\u0924\u093f \u0935\u093f\u0916\u094d\u092f\u093e\u0924\u093e\u0903 \u092a\u0902\u091a \u0917\u0902\u0917\u093e\u0903 \u092a\u094d\u0930\u0915\u0940\u0930\u094d\u0924\u093f\u0924\u093e\u0903 ||\n\n\u0906\u092f\u093e\u0902\u0924\u0941 \u0936\u094d\u0930\u0940 _____ \u092a\u0942\u091c\u093e\u0930\u094d\u0925\u0902 \u092e\u092e \u0926\u0941\u0930\u093f\u0924 \u0915\u094d\u0937\u092f\u0915\u093e\u0930\u0915\u093e\u0903 |\n\u0913\u0902 \u0913\u0902 \u0913\u0902 \u0915\u0932\u0936\u094b\u0926\u0915\u0947\u0928 \u092a\u0942\u091c\u093e \u0926\u094d\u0930\u0935\u094d\u092f\u093e\u0923\u093f \u0938\u0902\u092a\u094d\u0930\u094b\u0915\u094d\u0937\u094d\u092f \u0926\u0947\u0935\u0902, \u0906\u0924\u094d\u092e\u093e\u0928\u0902 \u091a \u0938\u0902\u092a\u094d\u0930\u094b\u0915\u094d\u0937\u094d\u092f ||\n\n\u0936\u094d\u0930\u0940 \u0935\u093f\u0918\u094d\u0928\u0947\u0936\u094d\u0935\u0930 \u0927\u094d\u092f\u093e\u0928\u0902\n\n\u090f\u0915\u0926\u0902\u0924\u0902 \u0936\u0942\u0930\u094d\u092a\u0915\u0930\u094d\u0923\u0902 \u0917\u091c\u0935\u0915\u094d\u0924\u094d\u0930\u0902 \u091a\u0924\u0941\u0930\u094d\u092d\u0941\u091c\u092e\u094d |\n\u092a\u093e\u0936\u093e\u0902\u0915\u0941\u0936\u0927\u0930\u0902 \u0926\u0947\u0935\u0902 \u0927\u094d\u092f\u093e\u092f\u0947\u0924\u094d\u0938\u093f\u0926\u094d\u0927\u093f\u0935\u093f\u0928\u093e\u092f\u0915\u092e\u094d ||\n\n\u0936\u094d\u0930\u0940 \u0938\u0941\u092c\u094d\u0930\u0939\u094d\u092e\u0923\u094d\u092f\u0947\u0936\u094d\u0935\u0930 \u0927\u094d\u092f\u093e\u0928\u0902\n\n\u0937\u0921\u093e\u0928\u0928\u0902 \u091a\u0902\u0926\u0928\u0932\u0947\u092a\u093f\u0924\u093e\u0902\u0917\u0902 \u092e\u0939\u094b\u0930\u0938\u0902 \u0926\u093f\u0935\u094d\u092f\u092e\u092f\u0942\u0930\u0935\u093e\u0939\u0928\u092e\u094d |\n\u0930\u0941\u0926\u094d\u0930\u0938\u094d\u092f \u0938\u0942\u0928\u0941\u0902 \u0938\u0941\u0930\u0932\u094b\u0915\u0928\u093e\u0925\u0902 \u092c\u094d\u0930\u0939\u094d\u092e\u0923\u094d\u092f\u0926\u0947\u0935\u0902 \u0936\u0930\u0923\u0902 \u092a\u094d\u0930\u092a\u0926\u094d\u092f\u0947 ||\n\n\u0936\u094d\u0930\u0940 \u0905\u092f\u094d\u092f\u092a\u094d\u092a \u0938\u094d\u0935\u093e\u092e\u093f \u0927\u094d\u092f\u093e\u0928\u0902\n\n\u0927\u094d\u092f\u093e\u092f\u0947\u0924\u094d \u091a\u093e\u0930\u0941\u091c\u091f\u093e\u0915\u0932\u093e\u092a \u092d\u0930\u093f\u0924\u0902 \u092d\u0938\u094d\u092e\u093e\u0902\u0917\u0930\u093e\u0917\u094b\u091c\u094d\u091c\u094d\u0935\u0932\u0902\n\u0939\u0938\u094d\u0924\u0947 \u0927\u0928\u094d\u0935\u0902\u0924\u0930\u0940\u092f \u092a\u093e\u0936\u092e\u0924\u0941\u0932\u0902 \u0930\u0924\u094d\u0928\u093e\u0902\u0917\u0926\u093e\u092d\u0942\u0937\u093f\u0924\u092e\u094d |\n\u092a\u093e\u0926\u093e\u0902\u092d\u094b\u091c\u092f\u0941\u0917\u0902 \u0938\u0926\u093e \u092a\u094d\u0930\u0923\u092e\u0924\u093e\u0902 \u0938\u0902\u0938\u093e\u0930\u0935\u093e\u0930\u094d\u0928\u093f\u0927\u0947\u0903\n\u092a\u094b\u0924\u0902 \u0936\u092c\u0930\u093f\u0936\u0948\u0932\u0935\u093e\u0938\u092e\u0928\u0918\u0902 \u0936\u094d\u0930\u0940\u092d\u0942\u0924\u0928\u093e\u0925\u0902 \u0935\u093f\u092d\u0941\u092e\u094d ||\n\n\u0936\u094d\u0930\u0940 \u092e\u0939\u093e\u0917\u0923\u093e\u0927\u093f\u092a\u0924\u092f\u0947 \u0928\u092e\u0903 |\n\u0935\u0932\u094d\u0932\u0940 \u0926\u0947\u0935\u0938\u0947\u0928 \u0938\u092e\u0947\u0924 \u0938\u0941\u092c\u094d\u0930\u092e\u0923\u094d\u092f \u0938\u094d\u0935\u093e\u092e\u093f\u0928\u0947 \u0928\u092e\u0903 |\n\u0939\u0930\u093f\u0939\u0930 \u092a\u0941\u0924\u094d\u0930 \u0905\u092f\u094d\u092f\u092a\u094d\u092a \u0938\u094d\u0935\u093e\u092e\u093f\u0928\u0947 \u0928\u092e\u0903 |\n\u0927\u094d\u092f\u093e\u0928\u0902 \u0938\u092e\u0930\u094d\u092a\u092f\u093e\u092e\u093f ||\n(\u092e\u0941\u0917\u094d\u0917\u0941\u0930\u093f \u0935\u0926\u094d\u0926 \u092a\u0941\u0937\u094d\u092a\u0902 \u0909\u0902\u091a\u0935\u0932\u0947\u0928\u0941)\n\n\u0906\u0935\u093e\u0939\u0928\u0902\n\n\u0913\u0902 \u0936\u094d\u0930\u0940 \u092e\u0939\u093e\u0917\u0923\u093e\u0927\u093f\u092a\u0924\u092f\u0947 \u0928\u092e\u0903 \u0906\u0935\u093e\u0939\u092f\u093e\u092e\u093f |\n\u0935\u0932\u094d\u0932\u0940 \u0926\u0947\u0935\u0938\u0947\u0928 \u0938\u092e\u0947\u0924 \u0938\u0941\u092c\u094d\u0930\u092e\u0923\u094d\u092f \u0938\u094d\u0935\u093e\u092e\u093f\u0928\u0947 \u0928\u092e\u0903 \u0906\u0935\u093e\u0939\u092f\u093e\u092e\u093f |\n\u0939\u0930\u093f\u0939\u0930 \u092a\u0941\u0924\u094d\u0930 \u0905\u092f\u094d\u092f\u092a\u094d\u092a \u0938\u094d\u0935\u093e\u092e\u093f\u0928\u0947 \u0928\u092e\u0903 \u0906\u0935\u093e\u0939\u092f\u093e\u092e\u093f ||\n(\u0905\u0915\u094d\u0937\u0924\u0932\u0941 \u0935\u0947\u092f\u0935\u0932\u0947\u0928\u0941)\n\n\u0930\u0924\u094d\u0928 \u0938\u093f\u0902\u0939\u093e\u0938\u0928\u0902 \u0938\u092e\u0930\u094d\u092a\u092f\u093e\u092e\u093f\n\n\u0936\u094d\u0930\u0940 \u092e\u0939\u093e\u0917\u0923\u093e\u0927\u093f\u092a\u0924\u092f\u0947 \u0928\u092e\u0903 |\n\u0935\u0932\u094d\u0932\u0940 \u0926\u0947\u0935\u0938\u0947\u0928 \u0938\u092e\u0947\u0924 \u0938\u0941\u092c\u094d\u0930\u092e\u0923\u094d\u092f \u0938\u094d\u0935\u093e\u092e\u093f\u0928\u0947 \u0928\u092e\u0903 |\n\u0939\u0930\u093f\u0939\u0930 \u092a\u0941\u0924\u094d\u0930 \u0905\u092f\u094d\u092f\u092a\u094d\u092a \u0938\u094d\u0935\u093e\u092e\u093f\u0928\u0947 \u0928\u092e\u0903 |\n\u0930\u0924\u094d\u0928 \u0938\u093f\u0902\u0939\u093e\u0938\u0928\u0902 \u0938\u092e\u0930\u094d\u092a\u092f\u093e\u092e\u093f ||\n(\u0905\u0915\u094d\u0937\u0924\u0932\u0941 \u0938\u092e\u0930\u094d\u092a\u093f\u0902\u091a\u0935\u0932\u0947\u0928\u0941)\n\n\u092a\u093e\u0926\u094d\u092f\u0902\n\n\u0936\u094d\u0930\u0940 \u092e\u0939\u093e\u0917\u0923\u093e\u0927\u093f\u092a\u0924\u092f\u0947 \u0928\u092e\u0903 |\n\u0935\u0932\u094d\u0932\u0940 \u0926\u0947\u0935\u0938\u0947\u0928 \u0938\u092e\u0947\u0924 \u0938\u0941\u092c\u094d\u0930\u092e\u0923\u094d\u092f \u0938\u094d\u0935\u093e\u092e\u093f\u0928\u0947 \u0928\u092e\u0903 |\n\u0939\u0930\u093f\u0939\u0930 \u092a\u0941\u0924\u094d\u0930 \u0905\u092f\u094d\u092f\u092a\u094d\u092a \u0938\u094d\u0935\u093e\u092e\u093f\u0928\u0947 \u0928\u092e\u0903 |\n\u092a\u093e\u0926\u092f\u094b\u0903 \u092a\u093e\u0926\u094d\u092f\u0902 \u0938\u092e\u0930\u094d\u092a\u092f\u093e\u092e\u093f ||\n(\u0909\u0926\u094d\u0927\u0930\u093f\u0923\u0947\u0924\u094b \u0932\u0947\u0926\u093e \u092a\u0941\u0937\u094d\u092a\u0902\u0924\u094b \u0928\u0940\u0930\u0941 \u0924\u093e\u0915\u093f\u0902\u091a\u093f \u092a\u0915\u094d\u0915\u0915\u0941 \u0935\u0947\u092f\u093e\u0932\u093f)\n\n\u0905\u0930\u094d\u0918\u094d\u092f\u0902\n\n\u0936\u094d\u0930\u0940 \u092e\u0939\u093e\u0917\u0923\u093e\u0927\u093f\u092a\u0924\u092f\u0947 \u0928\u092e\u0903 |\n\u0935\u0932\u094d\u0932\u0940 \u0926\u0947\u0935\u0938\u0947\u0928 \u0938\u092e\u0947\u0924 \u0938\u0941\u092c\u094d\u0930\u092e\u0923\u094d\u092f \u0938\u094d\u0935\u093e\u092e\u093f\u0928\u0947 \u0928\u092e\u0903 |\n\u0939\u0930\u093f\u0939\u0930 \u092a\u0941\u0924\u094d\u0930 \u0905\u092f\u094d\u092f\u092a\u094d\u092a \u0938\u094d\u0935\u093e\u092e\u093f\u0928\u0947 \u0928\u092e\u0903 |\n\u0939\u0938\u094d\u0924\u092f\u094b\u0903 \u0905\u0930\u094d\u0918\u094d\u092f\u0902 \u0938\u092e\u0930\u094d\u092a\u092f\u093e\u092e\u093f ||\n(\u092a\u0941\u0937\u094d\u092a\u0902\u0924\u094b \u0928\u0940\u0930\u0941 \u0924\u093e\u0915\u093f\u0902\u091a\u093f \u092a\u0915\u094d\u0915\u0915\u0941 \u0935\u0947\u092f\u093e\u0932\u093f)\n\n\u0906\u091a\u092e\u0928\u0940\u092f\u0902\n\n\u0936\u094d\u0930\u0940 \u092e\u0939\u093e\u0917\u0923\u093e\u0927\u093f\u092a\u0924\u092f\u0947 \u0928\u092e\u0903 |\n\u0935\u0932\u094d\u0932\u0940 \u0926\u0947\u0935\u0938\u0947\u0928 \u0938\u092e\u0947\u0924 \u0938\u0941\u092c\u094d\u0930\u092e\u0923\u094d\u092f \u0938\u094d\u0935\u093e\u092e\u093f\u0928\u0947 \u0928\u092e\u0903 |\n\u0939\u0930\u093f\u0939\u0930 \u092a\u0941\u0924\u094d\u0930 \u0905\u092f\u094d\u092f\u092a\u094d\u092a \u0938\u094d\u0935\u093e\u092e\u093f\u0928\u0947 \u0928\u092e\u0903 |\n\u092e\u0941\u0916\u0947 \u0906\u091a\u092e\u0928\u0940\u092f\u0902 \u0938\u092e\u0930\u094d\u092a\u092f\u093e\u092e\u093f ||\n(\u0909\u0926\u094d\u0927\u0930\u093f\u0923\u0947\u0924\u094b \u0932\u0947\u0926\u093e \u092a\u0941\u0937\u094d\u092a\u0902\u0924\u094b \u0928\u0940\u0930\u0941 \u0924\u0940\u0938\u0941\u0915\u094b\u0928\u093f \u0936\u094d\u0930\u0940 \u092e\u0939\u093e\u0917\u0923\u092a\u0924\u093f, \u0938\u0941\u092c\u094d\u0930\u092e\u0923\u094d\u092f \u0938\u094d\u0935\u093e\u092e\u093f, \u0905\u092f\u094d\u092f\u092a\u094d\u092a \u0938\u094d\u0935\u093e\u092e\u093f\u0915\u093f \u091a\u0942\u092a\u093f\u0902\u091a\u093f \u092a\u0915\u094d\u0915\u0915\u0941 \u0913\u0915 \u092a\u093e\u0924\u094d\u0930\u0932\u094b \u0935\u0947\u092f\u093e\u0932\u093f)\n\n\u092a\u0902\u091a\u093e\u092e\u0943\u0924 \u0938\u094d\u0928\u093e\u0928\u0902\n\n\u0936\u094d\u0930\u0940 \u092e\u0939\u093e\u0917\u0923\u093e\u0927\u093f\u092a\u0924\u092f\u0947 \u0928\u092e\u0903 |\n\u0935\u0932\u094d\u0932\u0940 \u0926\u0947\u0935\u0938\u0947\u0928 \u0938\u092e\u0947\u0924 \u0938\u0941\u092c\u094d\u0930\u092e\u0923\u094d\u092f \u0938\u094d\u0935\u093e\u092e\u093f\u0928\u0947 \u0928\u092e\u0903 |\n\u0939\u0930\u093f\u0939\u0930 \u092a\u0941\u0924\u094d\u0930 \u0905\u092f\u094d\u092f\u092a\u094d\u092a \u0938\u094d\u0935\u093e\u092e\u093f\u0928\u0947 \u0928\u092e\u0903 |\n\u092a\u0902\u091a\u093e\u092e\u0943\u0924 \u0938\u094d\u0928\u093e\u0928\u0902 \u0938\u092e\u0930\u094d\u092a\u092f\u093e\u092e\u093f ||\n(\u0936\u094d\u0930\u0940 \u092e\u0939\u093e\u0917\u0923\u092a\u0924\u093f, \u0938\u0941\u092c\u094d\u0930\u092e\u0923\u094d\u092f \u0938\u094d\u0935\u093e\u092e\u093f, \u0905\u092f\u094d\u092f\u092a\u094d\u092a \u0938\u094d\u0935\u093e\u092e\u093f \u092a\u0948\u0928 \u092a\u0941\u0937\u094d\u092a\u0902\u0924\u094b \u092a\u0902\u091a\u093e\u092e\u0943\u0924 \u092a\u094d\u0930\u094b\u0915\u094d\u0937\u0923 \u091a\u0947\u092f\u093e\u0932\u093f)\n\n\u0936\u0941\u0926\u094d\u0927\u094b\u0926\u0915 \u0938\u094d\u0928\u093e\u0928\u0902\n\n\u0936\u094d\u0930\u0940 \u092e\u0939\u093e\u0917\u0923\u093e\u0927\u093f\u092a\u0924\u092f\u0947 \u0928\u092e\u0903 |\n\u0935\u0932\u094d\u0932\u0940 \u0926\u0947\u0935\u0938\u0947\u0928 \u0938\u092e\u0947\u0924 \u0938\u0941\u092c\u094d\u0930\u092e\u0923\u094d\u092f \u0938\u094d\u0935\u093e\u092e\u093f\u0928\u0947 \u0928\u092e\u0903 |\n\u0939\u0930\u093f\u0939\u0930 \u092a\u0941\u0924\u094d\u0930 \u0905\u092f\u094d\u092f\u092a\u094d\u092a \u0938\u094d\u0935\u093e\u092e\u093f\u0928\u0947 \u0928\u092e\u0903 |\n\u0936\u0941\u0926\u094d\u0927\u094b\u0926\u0915 \u0938\u094d\u0928\u093e\u0928\u0902 \u0938\u092e\u0930\u094d\u092a\u092f\u093e\u092e\u093f ||\n(\u092a\u0941\u0937\u094d\u092a\u0902\u0924\u094b \u0928\u0940\u091f\u093f\u0928\u093f \u0938\u094d\u0935\u093e\u092e\u093f\u0935\u093e\u0930\u094d\u0932 \u092a\u0948\u0928 \u092a\u094d\u0930\u094b\u0915\u094d\u0937\u0923 \u091a\u0947\u092f\u093e\u0932\u093f)\n\n\u0935\u0938\u094d\u0924\u094d\u0930\u0902\n\n\u0936\u094d\u0930\u0940 \u092e\u0939\u093e\u0917\u0923\u093e\u0927\u093f\u092a\u0924\u092f\u0947 \u0928\u092e\u0903 |\n\u0935\u0932\u094d\u0932\u0940 \u0926\u0947\u0935\u0938\u0947\u0928 \u0938\u092e\u0947\u0924 \u0938\u0941\u092c\u094d\u0930\u092e\u0923\u094d\u092f \u0938\u094d\u0935\u093e\u092e\u093f\u0928\u0947 \u0928\u092e\u0903 |\n\u0939\u0930\u093f\u0939\u0930 \u092a\u0941\u0924\u094d\u0930 \u0905\u092f\u094d\u092f\u092a\u094d\u092a \u0938\u094d\u0935\u093e\u092e\u093f\u0928\u0947 \u0928\u092e\u0903 |\n\u0935\u0938\u094d\u0924\u094d\u0930 \u092f\u0941\u0917\u094d\u092e\u0902 \u0938\u092e\u0930\u094d\u092a\u092f\u093e\u092e\u093f ||\n(\u0935\u0938\u094d\u0924\u094d\u0930\u093e\u0932 \u0915\u094b\u0930\u0915\u0941 \u0926\u0942\u0926\u093f\u0928\u093f \u092a\u0938\u0941\u092a\u0941\u0932\u094b \u0932\u0947\u0926\u093e \u0915\u0941\u0902\u0915\u0941\u092e\u0932\u094b \u0905\u0926\u094d\u0926\u093f \u092a\u0947\u091f\u094d\u091f\u093e\u0932\u093f \u0932\u0947\u0926\u093e \u0905\u0915\u094d\u0937\u0924\u0932\u0941 \u0938\u092e\u0930\u094d\u092a\u093f\u0902\u091a\u093e\u0932\u093f)\n\n\u092f\u091c\u094d\u091e\u094b\u092a\u0935\u0940\u0924\u0902\n\n\u0936\u094d\u0930\u0940 \u092e\u0939\u093e\u0917\u0923\u093e\u0927\u093f\u092a\u0924\u092f\u0947 \u0928\u092e\u0903 |\n\u0935\u0932\u094d\u0932\u0940 \u0926\u0947\u0935\u0938\u0947\u0928 \u0938\u092e\u0947\u0924 \u0938\u0941\u092c\u094d\u0930\u092e\u0923\u094d\u092f \u0938\u094d\u0935\u093e\u092e\u093f\u0928\u0947 \u0928\u092e\u0903 |\n\u0939\u0930\u093f\u0939\u0930 \u092a\u0941\u0924\u094d\u0930 \u0905\u092f\u094d\u092f\u092a\u094d\u092a \u0938\u094d\u0935\u093e\u092e\u093f\u0928\u0947 \u0928\u092e\u0903 |\n\u092f\u091c\u094d\u091e\u094b\u092a\u0935\u0940\u0924\u0902 \u0938\u092e\u0930\u094d\u092a\u092f\u093e\u092e\u093f ||\n(\u092f\u091c\u094d\u091e\u094b\u092a\u0935\u0940\u0924\u0902 \u0932\u0947\u0926\u093e \u0905\u0915\u094d\u0937\u0924\u0932\u0941 \u0938\u092e\u0930\u094d\u092a\u093f\u0902\u091a\u093e\u0932\u093f)\n\n\u0917\u0902\u0927\u0902\n\n\u0936\u094d\u0930\u0940 \u092e\u0939\u093e\u0917\u0923\u093e\u0927\u093f\u092a\u0924\u092f\u0947 \u0928\u092e\u0903 |\n\u0935\u0932\u094d\u0932\u0940 \u0926\u0947\u0935\u0938\u0947\u0928 \u0938\u092e\u0947\u0924 \u0938\u0941\u092c\u094d\u0930\u092e\u0923\u094d\u092f \u0938\u094d\u0935\u093e\u092e\u093f\u0928\u0947 \u0928\u092e\u0903 |\n\u0939\u0930\u093f\u0939\u0930 \u092a\u0941\u0924\u094d\u0930 \u0905\u092f\u094d\u092f\u092a\u094d\u092a \u0938\u094d\u0935\u093e\u092e\u093f\u0928\u0947 \u0928\u092e\u0903 |\n\u0926\u093f\u0935\u094d\u092f \u0936\u094d\u0930\u0940 \u091a\u0902\u0926\u0928\u0902 \u0938\u092e\u0930\u094d\u092a\u092f\u093e\u092e\u093f ||\n(\u0936\u094d\u0930\u0940 \u092e\u0939\u093e\u0917\u0923\u092a\u0924\u093f, \u0938\u0941\u092c\u094d\u0930\u092e\u0923\u094d\u092f \u0938\u094d\u0935\u093e\u092e\u093f, \u0905\u092f\u094d\u092f\u092a\u094d\u092a \u0938\u094d\u0935\u093e\u092e\u093f \u0935\u093e\u0930\u094d\u0932\u0915\u0941 \u0917\u0902\u0927\u0902 \u092a\u0947\u091f\u094d\u091f\u093e\u0932\u093f)\n\n\u092d\u0938\u094d\u092e\u0902\n\n\u0936\u094d\u0930\u0940 \u092e\u0939\u093e\u0917\u0923\u093e\u0927\u093f\u092a\u0924\u092f\u0947 \u0928\u092e\u0903 |\n\u0935\u0932\u094d\u0932\u0940 \u0926\u0947\u0935\u0938\u0947\u0928 \u0938\u092e\u0947\u0924 \u0938\u0941\u092c\u094d\u0930\u092e\u0923\u094d\u092f \u0938\u094d\u0935\u093e\u092e\u093f\u0928\u0947 \u0928\u092e\u0903 |\n\u0939\u0930\u093f\u0939\u0930 \u092a\u0941\u0924\u094d\u0930 \u0905\u092f\u094d\u092f\u092a\u094d\u092a \u0938\u094d\u0935\u093e\u092e\u093f\u0928\u0947 \u0928\u092e\u0903 |\n\u0935\u093f\u092d\u0942\u0924\u093f\u0902 \u0927\u093e\u0930\u092f\u093e\u092e\u093f ||\n(\u0935\u093f\u092d\u0942\u0924\u093f \u0938\u092e\u0930\u094d\u092a\u093f\u0902\u091a\u0935\u0932\u0947\u0928\u0941)\n\n\u0915\u0941\u0902\u0915\u0941\u092e \u0905\u0932\u0902\u0915\u093e\u0930\u0902\n\n\u0936\u094d\u0930\u0940 \u092e\u0939\u093e\u0917\u0923\u093e\u0927\u093f\u092a\u0924\u092f\u0947 \u0928\u092e\u0903 |\n\u0935\u0932\u094d\u0932\u0940 \u0926\u0947\u0935\u0938\u0947\u0928 \u0938\u092e\u0947\u0924 \u0938\u0941\u092c\u094d\u0930\u092e\u0923\u094d\u092f \u0938\u094d\u0935\u093e\u092e\u093f\u0928\u0947 \u0928\u092e\u0903 |\n\u0939\u0930\u093f\u0939\u0930 \u092a\u0941\u0924\u094d\u0930 \u0905\u092f\u094d\u092f\u092a\u094d\u092a \u0938\u094d\u0935\u093e\u092e\u093f\u0928\u0947 \u0928\u092e\u0903 |\n\u0915\u0941\u0902\u0915\u0941\u092e\u0902 \u0938\u092e\u0930\u094d\u092a\u092f\u093e\u092e\u093f ||\n(\u0915\u0941\u0902\u0915\u0941\u092e \u0938\u092e\u0930\u094d\u092a\u093f\u0902\u091a\u0935\u0932\u0947\u0928\u0941)\n\n\u0905\u0915\u094d\u0937\u0924\u0932\u0941\n\n\u0936\u094d\u0930\u0940 \u092e\u0939\u093e\u0917\u0923\u093e\u0927\u093f\u092a\u0924\u092f\u0947 \u0928\u092e\u0903 |\n\u0935\u0932\u094d\u0932\u0940 \u0926\u0947\u0935\u0938\u0947\u0928 \u0938\u092e\u0947\u0924 \u0938\u0941\u092c\u094d\u0930\u092e\u0923\u094d\u092f \u0938\u094d\u0935\u093e\u092e\u093f\u0928\u0947 \u0928\u092e\u0903 |\n\u0939\u0930\u093f\u0939\u0930 \u092a\u0941\u0924\u094d\u0930 \u0905\u092f\u094d\u092f\u092a\u094d\u092a \u0938\u094d\u0935\u093e\u092e\u093f\u0928\u0947 \u0928\u092e\u0903 |\n\u0905\u0915\u094d\u0937\u0924\u093e\u0928\u094d \u0938\u092e\u0930\u094d\u092a\u092f\u093e\u092e\u093f ||\n(\u0905\u0915\u094d\u0937\u0924\u0932\u0941 \u0938\u092e\u0930\u094d\u092a\u093f\u0902\u091a\u0935\u0932\u0947\u0928\u0941)\n\n\u0906\u092d\u0930\u0923\u093e\u0932\u0941\n\n\u0936\u094d\u0930\u0940 \u092e\u0939\u093e\u0917\u0923\u093e\u0927\u093f\u092a\u0924\u092f\u0947 \u0928\u092e\u0903 |\n\u0935\u0932\u094d\u0932\u0940 \u0926\u0947\u0935\u0938\u0947\u0928 \u0938\u092e\u0947\u0924 \u0938\u0941\u092c\u094d\u0930\u092e\u0923\u094d\u092f \u0938\u094d\u0935\u093e\u092e\u093f\u0928\u0947 \u0928\u092e\u0903 |\n\u0939\u0930\u093f\u0939\u0930 \u092a\u0941\u0924\u094d\u0930 \u0905\u092f\u094d\u092f\u092a\u094d\u092a \u0938\u094d\u0935\u093e\u092e\u093f\u0928\u0947 \u0928\u092e\u0903 |\n\u0938\u0930\u094d\u0935\u093e\u092d\u0930\u0923\u093e\u0928\u094d \u0927\u093e\u0930\u092f\u093e\u092e\u093f ||\n\n\u092a\u0941\u0937\u094d\u092a\u093e\u0923\u093f \u0938\u092e\u0930\u094d\u092a\u092f\u093e\u092e\u093f\n\n\u0936\u094d\u0930\u0940 \u092e\u0939\u093e\u0917\u0923\u093e\u0927\u093f\u092a\u0924\u092f\u0947 \u0928\u092e\u0903 |\n\u0935\u0932\u094d\u0932\u0940 \u0926\u0947\u0935\u0938\u0947\u0928 \u0938\u092e\u0947\u0924 \u0938\u0941\u092c\u094d\u0930\u092e\u0923\u094d\u092f \u0938\u094d\u0935\u093e\u092e\u093f\u0928\u0947 \u0928\u092e\u0903 |\n\u0939\u0930\u093f\u0939\u0930 \u092a\u0941\u0924\u094d\u0930 \u0905\u092f\u094d\u092f\u092a\u094d\u092a \u0938\u094d\u0935\u093e\u092e\u093f\u0928\u0947 \u0928\u092e\u0903 |\n\u092a\u0941\u0937\u094d\u092a\u093e\u0923\u093f \u0938\u092e\u0930\u094d\u092a\u092f\u093e\u092e\u093f ||\n(\u0930\u0915\u0930\u0915\u093e\u0932 \u092a\u0941\u0937\u094d\u092a\u092e\u0941\u0932\u0924\u094b \u0905\u0932\u0902\u0915\u0930\u093f\u0902\u091a\u0935\u0932\u0947\u0928\u0941)\n\n\u0936\u094d\u0930\u0940 \u0935\u093f\u0918\u094d\u0928\u0947\u0936\u094d\u0935\u0930 \u0905\u0902\u0917\u092a\u0942\u091c\n\n(\u092a\u0941\u0937\u094d\u092a\u092e\u0941\u0932\u0941 \u0932\u0947\u0926\u093e \u0905\u0915\u094d\u0937\u0924\u0932\u0924\u094b \u0935\u093f\u0918\u094d\u0928\u0947\u0936\u094d\u0935\u0930\u0941\u0928\u093f \u0935\u0926\u094d\u0926 \u0935\u0947\u0938\u094d\u0924\u0942 \u092a\u0942\u091c\u093f\u0902\u091a\u0935\u0932\u0947\u0928\u0941)\n\n\u0913\u0902 \u092a\u093e\u0930\u094d\u0935\u0924\u0940 \u0928\u0902\u0926\u0928\u093e\u092f \u0928\u092e\u0903 - \u092a\u093e\u0926\u094c \u092a\u0942\u091c\u092f\u093e\u092e\u093f\n\u0913\u0902 \u0936\u094d\u0930\u0940 \u0917\u0923\u0947\u0936\u093e\u092f \u0928\u092e\u0903 - \u0917\u0941\u0932\u094d\u092b\u094c \u092a\u0942\u091c\u092f\u093e\u092e\u093f\n\u0913\u0902 \u091c\u093e\u0926\u094d\u0925\u093e\u0924\u094d\u0930\u0947 \u0928\u092e\u0903 - \u091c\u0902\u0918\u0947 \u092a\u0942\u091c\u092f\u093e\u092e\u093f\n\u0913\u0902 \u091c\u0917\u0926\u094d\u0935\u0932\u094d\u0932\u092d\u093e\u092f \u0928\u092e\u0903 - \u090a\u0930\u0942 \u092a\u0942\u091c\u092f\u093e\u092e\u093f\n\u0913\u0902 \u0935\u093f\u0915\u091f\u093e\u092f \u0928\u092e\u0903 - \u0915\u091f\u093f\u0902 \u092a\u0942\u091c\u092f\u093e\u092e\u093f\n\u0913\u0902 \u0917\u0941\u0939\u093e\u0917\u094d\u0930\u091c\u093e\u092f \u0928\u092e\u0903 - \u0917\u0941\u0939\u094d\u092f\u0902 \u092a\u0942\u091c\u092f\u093e\u092e\u093f\n\u0913\u0902 \u092e\u0939\u093e\u0924\u094d\u092e\u093e\u092f \u092e\u0928\u0903 - \u092e\u0947\u0922\u094d\u0930\u0902 \u092a\u0942\u091c\u092f\u093e\u092e\u093f\n\u0913\u0902 \u0939\u0947\u0930\u0902\u092c\u093e\u092f \u0928\u092e\u0903 - \u0928\u093e\u092d\u093f\u0902 \u092a\u0942\u091c\u092f\u093e\u092e\u093f\n\u0913\u0902 \u0932\u0902\u092c\u094b\u0926\u0930\u093e\u092f \u0928\u092e\u0903 - \u0909\u0926\u0930\u0902 \u092a\u0942\u091c\u092f\u093e\u092e\u093f\n\u0913\u0902 \u091a\u0924\u0941\u0930\u094d\u0926\u0902\u0924\u093e\u092f \u0928\u092e\u0903 - \u0939\u0943\u0926\u092f\u0902 \u092a\u0942\u091c\u092f\u093e\u092e\u093f\n\u0913\u0902 \u0938\u094d\u0925\u0942\u0932\u0915\u0930\u094d\u0923\u093e\u092f \u0928\u092e\u0903 - \u0938\u094d\u0924\u0928\u094c \u092a\u0942\u091c\u092f\u093e\u092e\u093f\n\u0913\u0902 \u092a\u093e\u0936\u093e\u0902\u0915\u0941\u0936\u0927\u0930\u093e\u092f \u0928\u092e\u0903 - \u0915\u0902\u0920\u0902 \u092a\u0942\u091c\u092f\u093e\u092e\u093f\n\u0913\u0902 \u0917\u091c\u0935\u0915\u094d\u0924\u094d\u0930\u093e\u092f \u0928\u092e\u0903 - \u0938\u094d\u0915\u0902\u0927\u094c \u092a\u0942\u091c\u092f\u093e\u092e\u093f\n\u0913\u0902 \u0935\u0930\u0926\u093e\u092f \u0928\u092e\u0903 - \u0939\u0938\u094d\u0924\u093e\u0928\u094d \u092a\u0942\u091c\u092f\u093e\u092e\u093f\n\u0913\u0902 \u0935\u093f\u0928\u093e\u092f\u0915\u093e\u092f \u0928\u092e\u0903 - \u092c\u093e\u0939\u0942\u0928\u094d \u092a\u0942\u091c\u092f\u093e\u092e\u093f\n\u0913\u0902 \u0938\u0930\u094d\u0935\u0947\u0936\u094d\u0935\u0930\u093e\u092f \u0928\u092e\u0903 - \u092a\u0943\u0937\u094d\u0920\u0926\u0947\u0936\u0902 \u092a\u0942\u091c\u092f\u093e\u092e\u093f\n\u0913\u0902 \u0935\u0915\u094d\u0930\u0924\u0941\u0902\u0921\u093e\u092f \u0928\u092e\u0903 - \u0926\u0902\u0924\u093e\u0928\u094d \u092a\u0942\u091c\u092f\u093e\u092e\u093f\n\u0913\u0902 \u090f\u0915\u0926\u0902\u0924\u093e\u092f \u0928\u092e\u0903 - \u0913\u0937\u094d\u0920\u094c \u092a\u0942\u091c\u092f\u093e\u092e\u093f\n\u0913\u0902 \u0935\u093f\u0918\u094d\u0928\u0939\u0930\u094d\u0924\u094d\u0930\u0947 \u0928\u092e\u0903 - \u0928\u093e\u0938\u093f\u0915\u093e\u0902 \u092a\u0942\u091c\u092f\u093e\u092e\u093f\n\u0913\u0902 \u092d\u093e\u0932\u091a\u0902\u0926\u094d\u0930\u093e\u092f \u0928\u092e\u0903 - \u0928\u0947\u0924\u094d\u0930\u093e\u0923\u093f \u092a\u0942\u091c\u092f\u093e\u092e\u093f\n\u0913\u0902 \u0936\u0942\u0930\u094d\u092a\u0915\u0930\u094d\u0923\u093e\u092f \u0928\u092e\u0903 - \u0915\u0930\u094d\u0923\u094c \u092a\u0942\u091c\u092f\u093e\u092e\u093f\n\u0913\u0902 \u0917\u0923\u093e\u0927\u093f\u092a\u093e\u092f \u0928\u092e\u0903 - \u0932\u0932\u093e\u091f\u0902 \u092a\u0942\u091c\u092f\u093e\u092e\u093f\n\u0913\u0902 \u0938\u0930\u094d\u0935\u0938\u093f\u0926\u094d\u0927\u093f\u092a\u094d\u0930\u0926\u093e\u092f \u0928\u092e\u0903 - \u0936\u093f\u0930\u0903 \u092a\u0942\u091c\u092f\u093e\u092e\u093f\n\u0913\u0902 \u0936\u094d\u0930\u0940 \u092e\u0939\u093e\u0917\u0923\u093e\u0927\u093f\u092a\u0924\u092f\u0947 \u0928\u092e\u0903 - \u0938\u0930\u094d\u0935\u093e\u0923\u094d\u092f\u0902\u0917\u093e\u0928\u093f \u092a\u0942\u091c\u092f\u093e\u092e\u093f\n\n\u0936\u094d\u0930\u0940 \u0938\u0941\u092c\u094d\u0930\u0939\u094d\u092e\u0923\u094d\u092f\u0947\u0936\u094d\u0935\u0930 \u0905\u0902\u0917\u092a\u0942\u091c\n\n(\u092a\u0941\u0937\u094d\u092a\u092e\u0941\u0932\u0941 \u0932\u0947\u0926\u093e \u0905\u0915\u094d\u0937\u0924\u0932\u0924\u094b \u0938\u0941\u092c\u094d\u0930\u0939\u094d\u092e\u0923\u094d\u092f\u0947\u0936\u094d\u0935\u0930\u0941\u0928\u093f \u0935\u0926\u094d\u0926 \u0935\u0947\u0938\u094d\u0924\u0942 \u092a\u0942\u091c\u093f\u0902\u091a\u0935\u0932\u0947\u0928\u0941)\n\n\u0913\u0902 \u0938\u0941\u092c\u094d\u0930\u0939\u094d\u092e\u0923\u094d\u092f\u093e\u092f \u0928\u092e\u0903 - \u092a\u093e\u0926\u094c \u092a\u0942\u091c\u092f\u093e\u092e\u093f\n\u0913\u0902 \u0905\u0917\u094d\u0928\u093f\u0917\u0930\u094d\u092d\u093e\u092f \u0928\u092e\u0903 - \u091c\u093e\u0928\u0941\u0928\u0940 \u092a\u0942\u091c\u092f\u093e\u092e\u093f\n\u0913\u0902 \u092c\u093e\u0939\u0941\u0932\u0947\u092f\u093e\u092f \u0928\u092e\u0903 - \u090a\u0930\u0942 \u092a\u0942\u091c\u092f\u093e\u092e\u093f\n\u0913\u0902 \u0936\u0930\u0935\u0923\u092d\u0935\u093e\u092f \u0928\u092e\u0903 - \u0915\u091f\u093f\u0902 \u092a\u0942\u091c\u092f\u093e\u092e\u093f\n\u0913\u0902 \u0935\u093f\u0936\u093e\u0916\u093e\u092f \u0928\u092e\u0903 - \u0928\u093e\u092d\u093f\u0902 \u092a\u0942\u091c\u092f\u093e\u092e\u093f\n\u0913\u0902 \u0915\u093e\u0930\u094d\u0924\u093f\u0915\u0947\u092f\u093e\u092f \u0928\u092e\u0903 - \u0909\u0926\u0930\u0902 \u092a\u0942\u091c\u092f\u093e\u092e\u093f\n\u0913\u0902 \u0936\u0915\u094d\u0924\u093f\u0927\u0930\u093e\u092f \u0928\u092e\u0903 - \u0939\u0938\u094d\u0924\u094c \u092a\u0942\u091c\u092f\u093e\u092e\u093f\n\u0913\u0902 \u0938\u0947\u0928\u093e\u0928\u0940\u092f\u0947 \u0928\u092e\u0903 - \u092c\u093e\u0939\u0942\u0928\u094d \u092a\u0942\u091c\u092f\u093e\u092e\u093f\n\u0913\u0902 \u0915\u0941\u092e\u093e\u0930\u093e\u092f \u0928\u092e\u0903 - \u0915\u0902\u0920\u0902 \u092a\u0942\u091c\u092f\u093e\u092e\u093f\n\u0913\u0902 \u0937\u0923\u094d\u092e\u0941\u0916\u093e\u092f \u0928\u092e\u0903 - \u092e\u0941\u0916\u0902 \u092a\u0942\u091c\u092f\u093e\u092e\u093f\n\u0913\u0902 \u0917\u0902\u0917\u093e\u0938\u0941\u0924\u093e\u092f \u0928\u092e\u0903 - \u0928\u0947\u0924\u094d\u0930\u093e\u0923\u093f \u092a\u0942\u091c\u092f\u093e\u092e\u093f\n\u0913\u0902 \u0936\u093f\u0935\u092a\u0941\u0924\u094d\u0930\u093e\u092f \u0928\u092e\u0903 - \u0915\u0930\u094d\u0923\u094c \u092a\u0942\u091c\u092f\u093e\u092e\u093f\n\u0913\u0902 \u0924\u093e\u0930\u0915\u093e\u0930\u0940\u092f\u0947 \u0928\u092e\u0903 - \u0928\u093e\u0938\u093f\u0915\u093e\u0902 \u092a\u0942\u091c\u092f\u093e\u092e\u093f\n\u0913\u0902 \u0938\u094d\u0915\u0902\u0926\u093e\u092f \u0928\u092e\u0903 - \u0932\u0932\u093e\u091f\u0902 \u092a\u0942\u091c\u092f\u093e\u092e\u093f\n\u0913\u0902 \u092e\u0939\u093e\u0938\u0947\u0928\u093e\u092f \u0928\u092e\u0903 - \u0936\u093f\u0930\u0903 \u092a\u0942\u091c\u092f\u093e\u092e\u093f\n\u0913\u0902 \u0936\u094d\u0930\u0940 \u0938\u0941\u092c\u094d\u0930\u0939\u094d\u092e\u0923\u094d\u092f\u093e\u092f \u0928\u092e\u0903 - \u0938\u0930\u094d\u0935\u093e\u0923\u094d\u092f\u0902\u0917\u093e\u0928\u093f \u092a\u0942\u091c\u092f\u093e\u092e\u093f\n\n\u0936\u094d\u0930\u0940 \u0905\u092f\u094d\u092f\u092a\u094d\u092a \u0938\u094d\u0935\u093e\u092e\u093f \u0905\u0902\u0917\u092a\u0942\u091c\n\n(\u092a\u0941\u0937\u094d\u092a\u092e\u0941\u0932\u0941 \u0932\u0947\u0926\u093e \u0905\u0915\u094d\u0937\u0924\u0932\u0924\u094b \u0905\u092f\u094d\u092f\u092a\u094d\u092a \u0938\u094d\u0935\u093e\u092e\u093f \u0935\u0926\u094d\u0926 \u0935\u0947\u0938\u094d\u0924\u0942 \u092a\u0942\u091c\u093f\u0902\u091a\u0935\u0932\u0947\u0928\u0941)\n\n\u0913\u0902 \u0939\u0930\u093f\u0939\u0930\u092a\u0941\u0924\u094d\u0930\u093e\u092f \u0928\u092e\u0903 - \u092a\u093e\u0926\u094c \u092a\u0942\u091c\u092f\u093e\u092e\u093f\n\u0913\u0902 \u0936\u092c\u0930\u0940\u0917\u093f\u0930\u0940\u0936\u093e\u092f \u0928\u092e\u0903 - \u0917\u0941\u0932\u094d\u092b\u094c \u092a\u0942\u091c\u092f\u093e\u092e\u093f\n\u0913\u0902 \u0915\u093f\u0930\u093e\u0924 \u0930\u0942\u092a\u093e\u092f \u0928\u092e\u0903 - \u091c\u0902\u0918\u0947 \u092a\u0942\u091c\u092f\u093e\u092e\u093f\n\u0913\u0902 \u0935\u0940\u0930\u092e\u0923\u093f \u0915\u0902\u0920\u093e\u092f \u0928\u092e\u0903 - \u091c\u093e\u0928\u0941\u0928\u0940 \u092a\u0942\u091c\u092f\u093e\u092e\u093f\n\u0913\u0902 \u091c\u093f\u0924\u0915\u093e\u092e\u093e\u092f \u0928\u092e\u0903 - \u090a\u0930\u0942\u0928\u094d \u092a\u0942\u091c\u092f\u093e\u092e\u093f\n\u0913\u0902 \u0917\u091c\u093e\u0930\u0942\u0922\u093e\u092f \u0928\u092e\u0903 - \u0915\u091f\u093f\u0902 \u092a\u0942\u091c\u092f\u093e\u092e\u093f\n\u0913\u0902 \u0926\u0947\u0935\u092a\u093e\u0932\u0915\u093e\u092f \u0928\u092e\u0903 - \u0935\u0938\u094d\u0924\u093f\u0902 \u092a\u0942\u091c\u092f\u093e\u092e\u093f\n\u0913\u0902 \u092e\u094b\u0939\u093f\u0928\u0940\u092a\u0941\u0924\u094d\u0930\u093e\u092f \u0928\u092e\u0903 - \u0917\u0941\u0939\u094d\u092f\u0902 \u092a\u0942\u091c\u092f\u093e\u092e\u093f\n\u0913\u0902 \u092a\u0926\u094d\u092e\u093e\u0915\u094d\u0937\u093e\u092f \u0928\u092e\u0903 - \u0928\u093e\u092d\u093f\u0902 \u092a\u0942\u091c\u092f\u093e\u092e\u093f\n\u0913\u0902 \u0924\u094d\u0930\u093f\u0932\u094b\u0915\u0928\u093e\u0925\u093e\u092f \u0928\u092e\u0903 - \u0909\u0926\u0930\u0902 \u092a\u0942\u091c\u092f\u093e\u092e\u093f\n\u0913\u0902 \u0936\u0942\u0932\u0927\u093e\u0930\u093f\u0923\u0947 \u0928\u092e\u0903 - \u0938\u094d\u0924\u0928\u094c \u092a\u0942\u091c\u092f\u093e\u092e\u093f\n\u0913\u0902 \u0905\u092e\u093f\u0924\u0935\u093f\u0915\u094d\u0930\u092e\u093e\u092f \u0928\u092e\u0903 - \u0939\u0943\u0926\u092f\u0902 \u092a\u0942\u091c\u092f\u093e\u092e\u093f\n\u0913\u0902 \u0928\u0940\u0932\u0915\u0902\u0920 \u0924\u0928\u092f\u093e\u092f \u0928\u092e\u0903 - \u0915\u0902\u0920\u0902 \u092a\u0942\u091c\u092f\u093e\u092e\u093f\n\u0913\u0902 \u092a\u0924\u093f\u0924 \u092a\u093e\u0935\u0928\u093e\u092f \u0928\u092e\u0903 - \u091a\u0941\u092c\u0941\u0915\u0902 \u092a\u0942\u091c\u092f\u093e\u092e\u093f\n\u0913\u0902 \u092a\u0941\u0930\u0941\u0937\u0936\u094d\u0930\u0947\u0937\u094d\u0920\u093e\u092f \u0928\u092e\u0903 - \u0928\u093e\u0938\u093f\u0915\u093e\u0902 \u092a\u0942\u091c\u092f\u093e\u092e\u093f\n\u0913\u0902 \u092a\u0941\u0923\u094d\u092f\u092e\u0942\u0930\u094d\u0924\u092f\u0947 \u0928\u092e\u0903 - \u0936\u094d\u0930\u0935\u0923\u093e\u0928\u093f \u092a\u0942\u091c\u092f\u093e\u092e\u093f\n\u0913\u0902 \u0915\u092e\u0932\u0932\u094b\u091a\u0928\u093e\u092f \u0928\u092e\u0903 - \u0928\u0947\u0924\u094d\u0930\u0947 \u092a\u0942\u091c\u092f\u093e\u092e\u093f\n\u0913\u0902 \u0915\u0938\u094d\u0924\u0942\u0930\u093f \u0924\u093f\u0932\u0915\u093e\u0902\u091a\u093f\u0924\u093e \u092b\u093e\u0932\u0928\u093e\u092f \u0928\u092e\u0903 - \u0932\u0932\u093e\u091f\u0902 \u092a\u0942\u091c\u092f\u093e\u092e\u093f\n\u0913\u0902 \u0935\u0947\u0926\u0935\u093f\u0926\u0941\u0937\u0947 \u0928\u092e\u0903 - \u092e\u0941\u0916\u0902 \u092a\u0942\u091c\u092f\u093e\u092e\u093f\n\u0913\u0902 \u0924\u094d\u0930\u093f\u0932\u094b\u0915\u0917\u0941\u0930\u0935\u0947 \u0928\u092e\u0903 - \u0936\u093f\u0930\u0903 \u092a\u0942\u091c\u092f\u093e\u092e\u093f\n\u0913\u0902 \u0938\u0930\u094d\u0935\u0947\u0936\u094d\u0935\u0930\u093e\u092f \u0928\u092e\u0903 - \u0938\u0930\u094d\u0935\u093e\u0923\u094d\u092f\u0902\u0917\u093e\u0928\u093f \u092a\u0942\u091c\u092f\u093e\u092e\u093f\n\n\u0927\u094d\u092f\u093e\u0928\u0902\n\n\u0915\u0932\u094d\u0932\u094b\u0930\u094b\u091c\u094d\u091c\u094d\u0935\u0932 \u0928\u0940\u0932\u0915\u0941\u0902\u0924\u0932 \u092d\u0930\u0902 \u0915\u093e\u0932\u093e\u0902\u092c\u0941\u0927 \u0936\u094d\u092f\u093e\u092e\u0932\u0902\n\u0915\u0930\u094d\u092a\u0942\u0930\u093e \u0915\u0932\u093f\u0924\u093e\u092d\u093f \u0930\u093e\u092e\u0935\u092a\u0941\u0937\u0902 \u0915\u093e\u0902\u0924\u0947\u0902\u0926\u0941 \u092c\u093f\u0902\u092c\u093e\u0928\u0928\u0902 |\n\u0936\u094d\u0930\u0940\u0926\u0902\u0921\u093e\u0902\u0915\u0941\u0936 \u092a\u093e\u0936\u0936\u0942\u0932 \u0935\u093f\u0932\u0938\u0924\u094d\u092a\u093e\u0923\u093f\u0902 \u092e\u0926\u093e\u0902\u0927 \u0926\u094d\u0935\u093f\u092a\u093e\n\u0930\u0942\u0922\u0902 \u0936\u0924\u094d\u0930\u0941 \u0935\u093f\u092e\u0930\u094d\u0926\u0928\u0902 \u0939\u0943\u0926\u093f \u092e\u0939\u093e \u0936\u093e\u0938\u094d\u0924\u093e\u0930 \u092e\u093e\u0926\u094d\u092f\u0902 \u092d\u091c\u0947 ||\n\n\u092e\u0942\u0932\u0902\n\n\u0913\u0902 \u0939\u094d\u0930\u0940\u0902 \u0939\u0930\u093f\u0939\u0930\u092a\u0941\u0924\u094d\u0930\u093e\u092f \u092a\u0941\u0924\u094d\u0930\u0932\u093e\u092d\u093e\u092f\n\u0936\u0924\u094d\u0930\u0941 \u0928\u093e\u0936\u093e\u092f \u092e\u0926\u0917\u091c \u0935\u093e\u0939\u0928\u093e\u092f \u092e\u0939\u093e\u0936\u093e\u0938\u094d\u0924\u094d\u0930\u0947 \u0928\u092e\u0903\n\n(\u0905\u092f\u094d\u092f\u092a\u094d\u092a \u0938\u094d\u0935\u093e\u092e\u093f\u0935\u093e\u0930\u093f\u092a\u0948\u0928\u093e \u092a\u0941\u0937\u094d\u092a\u093e\u0932\u0941 \u092a\u0947\u0921\u0941\u0924\u0942 \u0905\u0937\u094d\u091f\u094b\u0924\u094d\u0924\u0930\u092e\u0941\u0924\u094b \u0905\u0930\u094d\u091a\u0928 \u091a\u0947\u092f\u093e\u0932\u093f)\n\n\u0905\u0937\u094d\u091f\u094b\u0924\u094d\u0924\u0930\u092e\u0941\n\n\u0913\u0902 \u092e\u0939\u093e\u0936\u093e\u0938\u094d\u0924\u094d\u0930\u0947 \u0928\u092e\u0903\n\u0913\u0902 \u0935\u093f\u0936\u094d\u0935\u0936\u093e\u0938\u094d\u0924\u094d\u0930\u0947 \u0928\u092e\u0903\n\u0913\u0902 \u0932\u094b\u0915\u0936\u093e\u0938\u094d\u0924\u094d\u0930\u0947 \u0928\u092e\u0903\n\u0913\u0902 \u0927\u0930\u094d\u092e\u0936\u093e\u0938\u094d\u0924\u094d\u0930\u0947 \u0928\u092e\u0903\n\u0913\u0902 \u0935\u0947\u0926\u0936\u093e\u0938\u094d\u0924\u094d\u0930\u0947 \u0928\u092e\u0903\n\u0913\u0902 \u0915\u093e\u0932\u0936\u093e\u0938\u094d\u0924\u094d\u0930\u0947 \u0928\u092e\u0903\n\u0913\u0902 \u0917\u091c\u093e\u0930\u0942\u0922\u093e\u092f \u0928\u092e\u0903\n\u0913\u0902 \u0936\u0942\u0932\u092a\u093e\u0923\u092f\u0947 \u0928\u092e\u0903\n\u0913\u0902 \u0935\u093e\u092e\u0928\u093e\u092f \u0928\u092e\u0903\n\u0913\u0902 \u091c\u091f\u093e\u0927\u0930\u093e\u092f \u0928\u092e\u0903\n\u0913\u0902 \u092d\u0938\u094d\u092e\u0927\u093e\u0930\u093f\u0923\u0947 \u0928\u092e\u0903\n\u0913\u0902 \u0932\u094b\u0915\u0947\u0936\u094d\u0935\u0930\u093e\u092f \u0928\u092e\u0903\n\u0913\u0902 \u0932\u094b\u0915\u092a\u093e\u0932\u094b\u0915\u093e\u092f \u0928\u092e\u0903\n\u0913\u0902 \u091c\u0917\u0928\u094d\u0928\u093e\u0925\u093e\u092f \u0928\u092e\u0903\n\u0913\u0902 \u091c\u0917\u0926\u0940\u0936\u094d\u0935\u0930\u093e\u092f \u0928\u092e\u0903\n\u0913\u0902 \u0932\u094b\u0915\u093e\u0927\u094d\u092f\u0915\u094d\u0937\u093e\u092f \u0928\u092e\u0903\n\u0913\u0902 \u0932\u094b\u0915\u092d\u0930\u094d\u0924\u094d\u0930\u0947 \u0928\u092e\u0903\n\u0913\u0902 \u0932\u094b\u0915\u0938\u093e\u0915\u094d\u0937\u093f\u0923\u0947 \u0928\u092e\u0903\n\u0913\u0902 \u0932\u094b\u0915\u0917\u0930\u094d\u092d\u093e\u092f \u0928\u092e\u0903\n\u0913\u0902 \u0932\u094b\u0915\u093e\u0927\u0940\u0936\u093e\u092f \u0928\u092e\u0903\n\u0913\u0902 \u0935\u093f\u092d\u0935\u0947 \u0928\u092e\u0903\n\u0913\u0902 \u0938\u0930\u094d\u0935\u0947\u0936\u094d\u0935\u093e\u0930\u093e\u092f \u0928\u092e\u0903\n\u0913\u0902 \u0938\u0930\u094d\u0935\u0938\u093e\u0915\u094d\u0937\u093f\u0923\u0947 \u0928\u092e\u0903\n\u0913\u0902 \u092a\u0941\u0923\u094d\u092f\u092d\u093e\u0935\u093e\u092f \u0928\u092e\u0903\n\u0913\u0902 \u0938\u0930\u094d\u0935\u092d\u0942\u0924\u093f\u0926\u093e\u092f \u0928\u092e\u0903\n\u0913\u0902 \u0936\u093e\u0902\u0924\u093e\u092f \u0928\u092e\u0903\n\u0913\u0902 \u0938\u0941\u092e\u0941\u0916\u093e\u092f \u0928\u092e\u0903\n\u0913\u0902 \u0938\u0941\u0930\u0938\u0947\u0935\u093f\u0924\u093e\u092f \u0928\u092e\u0903\n\u0913\u0902 \u0935\u093f\u092e\u0932\u093e\u092f \u0928\u092e\u0903\n\u0913\u0902 \u0930\u092e\u094d\u092f\u093e\u092f \u0928\u092e\u0903\n\u0913\u0902 \u092d\u0943\u0924\u094d\u092f\u093e\u092f \u0928\u092e\u0903\n\u0913\u0902 \u0935\u093f\u092d\u0935\u0947 \u0928\u092e\u0903\n\u0913\u0902 \u0936\u094d\u092f\u093e\u092e\u093e\u092f \u0928\u092e\u0903\n\u0913\u0902 \u0928\u0930\u0938\u0947\u0935\u094d\u092f\u093e\u092f \u0928\u092e\u0903\n\u0913\u0902 \u0936\u093f\u0924\u093f\u0915\u0902\u0920\u093e\u092f \u0928\u092e\u0903\n\u0913\u0902 \u0936\u093f\u0924\u093f\u0915\u0902\u0920\u092a\u094d\u0930\u093f\u092f\u093e\u092f \u0928\u092e\u0903\n\u0913\u0902 \u0936\u093e\u0902\u0924\u093e\u092f \u0928\u092e\u0903\n\u0913\u0902 \u0938\u0941\u0930\u0938\u0947\u0935\u094d\u092f\u093e\u092f \u0928\u092e\u0903\n\u0913\u0902 \u0917\u091c\u0935\u093e\u0939\u0928\u093e\u092f \u0928\u092e\u0903\n\u0913\u0902 \u0917\u0935\u093e\u0902\u092a\u0924\u092f\u0947 \u0928\u092e\u0903\n\u0913\u0902 \u0916\u0921\u094d\u0917\u092a\u093e\u0923\u092f\u0947 \u0928\u092e\u0903\n\u0913\u0902 \u0936\u094d\u0930\u0940\u092e\u0924\u0947 \u0928\u092e\u0903\n\u0913\u0902 \u092d\u0943\u0924\u094d\u092f\u093e\u092f \u0928\u092e\u0903\n\u0913\u0902 \u0935\u0940\u0930\u092d\u0926\u094d\u0930\u093e\u092f \u0928\u092e\u0903\n\u0913\u0902 \u092d\u0948\u0930\u0935\u093e\u092f \u0928\u092e\u0903\n\u0913\u0902 \u0935\u091c\u094d\u0930\u092a\u093e\u0923\u092f\u0947 \u0928\u092e\u0903\n\u0913\u0902 \u092c\u093e\u0923\u0939\u0938\u094d\u0924\u093e\u092f \u0928\u092e\u0903\n\u0913\u0902 \u0927\u0928\u0941\u0930\u094d\u0927\u0930\u093e\u092f \u0928\u092e\u0903\n\u0913\u0902 \u0938\u0930\u094d\u0935\u0936\u093e\u0938\u094d\u0924\u094d\u0930\u0947 \u0928\u092e\u0903\n\u0913\u0902 \u0938\u0930\u094d\u0935\u091c\u094d\u091e\u093e\u092f \u0928\u092e\u0903\n\u0913\u0902 \u092e\u0930\u0941\u0924\u094d\u0935\u0924\u0947 \u0928\u092e\u0903\n\u0913\u0902 \u092d\u0940\u092e\u0915\u0930\u094d\u092e\u0923\u0947 \u0928\u092e\u0903\n\u0913\u0902 \u092d\u0940\u092e\u0930\u0942\u092a\u093e\u092f \u0928\u092e\u0903\n\u0913\u0902 \u092d\u0940\u092e\u0938\u0947\u0935\u094d\u092f\u093e\u092f \u0928\u092e\u0903\n\u0913\u0902 \u092d\u0940\u092e \u0938\u093e\u0939\u0938 \u092a\u0930\u093e\u0915\u094d\u0930\u092e\u093e\u092f \u0928\u092e\u0903\n\u0913\u0902 \u0928\u093e\u0917\u0939\u093e\u0930\u093e\u092f \u0928\u092e\u0903\n\u0913\u0902 \u0928\u093e\u0917\u0915\u0947\u0936\u093e\u092f \u0928\u092e\u0903\n\u0913\u0902 \u0935\u094d\u092f\u094b\u092e\u0915\u0947\u0936\u093e\u092f \u0928\u092e\u0903\n\u0913\u0902 \u0938\u0928\u093e\u0924\u0928\u093e\u092f \u0928\u092e\u0903\n\u0913\u0902 \u0938\u0941\u0917\u0941\u0923\u093e\u092f \u0928\u092e\u0903\n\u0913\u0902 \u0928\u093f\u0930\u094d\u0917\u0941\u0923\u093e\u092f \u0928\u092e\u0903\n\u0913\u0902 \u0928\u093f\u0924\u094d\u092f\u093e\u092f \u0928\u092e\u0903\n\u0913\u0902 \u0928\u093f\u0924\u094d\u092f\u0924\u0943\u092a\u094d\u0924\u093e\u092f \u0928\u092e\u0903\n\u0913\u0902 \u0928\u093f\u0930\u093e\u0936\u094d\u0930\u092f\u093e\u092f \u0928\u092e\u0903\n\u0913\u0902 \u0932\u094b\u0915\u093e\u0936\u094d\u0930\u092f\u093e\u092f \u0928\u092e\u0903\n\u0913\u0902 \u0917\u0923\u093e\u0927\u0940\u0936\u093e\u092f \u0928\u092e\u0903\n\u0913\u0902 \u091a\u0924\u0941\u0937\u094d\u0937\u0937\u094d\u091f\u093f\u0915\u0932\u093e \u092e\u092f\u093e\u092f \u0928\u092e\u0903\n\u0913\u0902 \u090b\u0917\u094d\u092f\u091c\u0941\u0938\u094d\u0938\u093e\u092e\u093e\u0925\u0930\u094d\u0935\u0923 \u0930\u0942\u092a\u093f\u0923\u0947 \u0928\u092e\u0903\n\u0913\u0902 \u092e\u0932\u094d\u0932\u0915\u093e\u0938\u0941\u0930\u092d\u0902\u091c\u0928\u093e\u092f \u0928\u092e\u0903\n\u0913\u0902 \u0924\u094d\u0930\u093f\u092e\u0942\u0930\u094d\u0924\u092f\u0947 \u0928\u092e\u0903\n\u0913\u0902 \u0926\u0948\u0924\u094d\u092f\u092e\u0927\u0928\u093e\u092f \u0928\u092e\u0903\n\u0913\u0902 \u092a\u094d\u0930\u0915\u0943\u0924\u092f\u0947 \u0928\u092e\u0903\n\u0913\u0902 \u092a\u0941\u0930\u0941\u0937\u094b\u0924\u094d\u0924\u092e\u093e\u092f \u0928\u092e\u0903\n\u0913\u0902 \u0915\u093e\u0932\u093e\u0924\u094d\u092e\u0928\u0947 \u0928\u092e\u0903\n\u0913\u0902 \u0915\u093e\u092e\u0930\u0942\u092a\u093e\u092f \u0928\u092e\u0903\n\u0913\u0902 \u0915\u093e\u092e\u0927\u0947\u0928\u0935\u0947 \u0928\u092e\u0903\n\u0913\u0902 \u0915\u0930\u0941\u0923\u093e\u092a\u0942\u0930\u094d\u0923\u093e\u092f \u0928\u092e\u0903\n\u0913\u0902 \u0915\u093e\u0932\u0939\u0902\u0924\u094d\u0930\u0947 \u0928\u092e\u0903\n\u0913\u0902 \u0924\u093e\u0930\u0915\u092c\u094d\u0930\u0939\u094d\u092e\u0923\u0947 \u0928\u092e\u0903\n\u0913\u0902 \u092a\u094d\u0930\u0923\u0935\u0938\u094d\u0935\u0930\u0942\u092a\u093e\u092f \u0928\u092e\u0903\n\u0913\u0902 \u092a\u094d\u0930\u0923\u0935\u092a\u094d\u0930\u093f\u092f\u093e\u092f \u0928\u092e\u0903\n\u0913\u0902 \u0935\u0947\u0926\u093e\u0902\u0924\u0935\u0947\u0926\u094d\u092f\u093e\u092f \u0928\u092e\u0903\n\u0913\u0902 \u0938\u0930\u094d\u0935\u0936\u093e\u0938\u094d\u0924\u094d\u0930\u093e\u0930\u094d\u0925 \u0924\u0924\u094d\u0935\u091c\u094d\u091e\u093e\u092f \u0928\u092e\u0903\n\u0913\u0902 \u0928\u0940\u0924\u093f\u092e\u0924\u0947 \u0928\u092e\u0903\n\u0913\u0902 \u0928\u0940\u0924\u093f\u092a\u094d\u0930\u093f\u092f\u093e\u092f \u0928\u092e\u0903\n\u0913\u0902 \u0928\u0940\u0924\u093f\u0926\u093e\u092f \u0928\u092e\u0903\n\u0913\u0902 \u0938\u0941\u0932\u092d\u093e\u092f \u0928\u092e\u0903\n\u0913\u0902 \u0938\u0930\u094d\u0935\u0926\u0947\u0935\u0924\u093e \u0938\u094d\u0935\u0930\u0942\u092a\u093e\u092f \u0928\u092e\u0903\n\u0913\u0902 \u092a\u0930\u092e\u093e\u0924\u094d\u092e\u0928\u0947 \u0928\u092e\u0903\n\u0913\u0902 \u091c\u0917\u0924\u094d\u0915\u093e\u0930\u0923\u093e\u092f \u0928\u092e\u0903\n\u0913\u0902 \u091c\u0917\u0924\u094d\u092a\u094d\u0930\u092d\u0935\u0947 \u0928\u092e\u0903\n\u0913\u0902 \u091c\u0917\u0926\u094d\u0930\u0915\u094d\u0937\u0915\u093e\u092f \u0928\u092e\u0903\n\u0913\u0902 \u092d\u0915\u094d\u0924\u0935\u0924\u094d\u0938\u0932\u093e\u092f \u0928\u092e\u0903\n\u0913\u0902 \u0936\u094d\u0930\u0940 \u0927\u0930\u094d\u092e\u0936\u093e\u0938\u094d\u0924\u094d\u0930\u0947 \u0928\u092e\u0903\n\u0913\u0902 \u0936\u094d\u0930\u0940 \u0939\u0930\u093f\u0939\u0930\u092a\u0941\u0924\u094d\u0930\u093e\u092f \u0928\u092e\u0903\n\u0913\u0902 \u0936\u094d\u0930\u0940 \u092e\u0923\u093f\u0915\u0902\u0920\u093e\u092f \u0928\u092e\u0903\n\u0913\u0902 \u0936\u094d\u0930\u0940 \u0936\u092c\u0930\u0940\u0917\u093f\u0930\u0940\u0936\u093e\u092f \u0928\u092e\u0903\n\u0913\u0902 \u0936\u094d\u0930\u0940 \u0905\u092f\u094d\u092f\u092a\u094d\u092a \u0938\u094d\u0935\u093e\u092e\u093f\u0928\u0947 \u0928\u092e\u0903\n\u0928\u093e\u0928\u093e\u0935\u093f\u0927 \u092a\u0930\u093f\u092e\u0933 \u092a\u0924\u094d\u0930 \u092a\u0941\u0937\u094d\u092a\u093e\u0923\u093f \u092a\u0942\u091c\u093e\u0902 \u0938\u092e\u0930\u094d\u092a\u092f\u093e\u092e\u093f ||\n\n\u0927\u0942\u092a\u0902\n\n\u0935\u0928\u0938\u094d\u092a\u0924\u093f \u0930\u0938\u094b\u0926\u094d\u092d\u0942\u0924\u094b \u0917\u0902\u0927\u093e\u0922\u094d\u092f\u094b \u0917\u0902\u0927 \u0909\u0924\u094d\u0924\u092e\u0903 |\n\u0906\u0918\u094d\u0930\u0947\u092f\u0903 \u0938\u0930\u094d\u0935\u0926\u0947\u0935\u093e\u0928\u093e\u0902 \u0927\u0942\u092a\u094b\u0c3d\u092f\u0902 \u092a\u094d\u0930\u0924\u093f\u0917\u0943\u0939\u094d\u092f\u0924\u093e\u092e\u094d ||\n\u0936\u094d\u0930\u0940 \u092e\u0939\u093e\u0917\u0923\u093e\u0927\u093f\u092a\u0924\u092f\u0947 \u0928\u092e\u0903 |\n\u0935\u0932\u094d\u0932\u0940 \u0926\u0947\u0935\u0938\u0947\u0928 \u0938\u092e\u0947\u0924 \u0938\u0941\u092c\u094d\u0930\u092e\u0923\u094d\u092f \u0938\u094d\u0935\u093e\u092e\u093f\u0928\u0947 \u0928\u092e\u0903 |\n\u0939\u0930\u093f\u0939\u0930 \u092a\u0941\u0924\u094d\u0930 \u0905\u092f\u094d\u092f\u092a\u094d\u092a \u0938\u094d\u0935\u093e\u092e\u093f\u0928\u0947 \u0928\u092e\u0903 |\n\u0927\u0942\u092a\u0902 \u0906\u0918\u094d\u0930\u093e\u092a\u092f\u093e\u092e\u093f ||\n(\u0905\u0917\u0930\u0941\u092c\u0924\u094d\u0924\u0941\u0932\u0941 \u0935\u0947\u0932\u093f\u0917\u093f\u0902\u091a\u093f \u091a\u0942\u092a\u093f\u0902\u091a\u093e\u0932\u093f)\n\n\u0926\u0940\u092a\u0902\n\n\u0938\u093e\u091c\u094d\u092f\u0902 \u0924\u094d\u0930\u093f\u0935\u0930\u094d\u0924\u093f \u0938\u0902\u092f\u0941\u0915\u094d\u0924\u0902 \u0935\u0939\u094d\u0928\u093f\u0928\u093e \u092f\u094b\u091c\u093f\u0924\u0902 \u092a\u094d\u0930\u093f\u092f\u092e\u094d |\n\u0926\u0940\u092a\u0902 \u0917\u0943\u0939\u093e\u0923 \u0926\u0947\u0935\u0947\u0936 \u0924\u094d\u0930\u0948\u0932\u094b\u0915\u094d\u092f \u0924\u093f\u092e\u093f\u0930\u093e\u092a\u0939\u092e\u094d ||\n\u092d\u0915\u094d\u0924\u094d\u092f\u093e \u0926\u0940\u092a\u0902 \u092a\u094d\u0930\u092f\u091a\u094d\u091b\u093e\u092e\u093f \u0926\u0947\u0935\u093e\u092f \u092a\u0930\u092e\u093e\u0924\u094d\u092e\u0928\u0947 |\n\u0924\u094d\u0930\u093e\u0939\u093f \u092e\u093e\u0902 \u0928\u0930\u0915\u093e\u0926\u094d\u0918\u094b\u0930\u093e\u0924\u094d \u0926\u093f\u0935\u094d\u092f\u091c\u094d\u092f\u094b\u0924\u093f\u0930\u094d\u0928\u092e\u094b\u0c3d\u0938\u094d\u0924\u0941\u0924\u0947 ||\n\u0936\u094d\u0930\u0940 \u092e\u0939\u093e\u0917\u0923\u093e\u0927\u093f\u092a\u0924\u092f\u0947 \u0928\u092e\u0903 |\n\u0935\u0932\u094d\u0932\u0940 \u0926\u0947\u0935\u0938\u0947\u0928 \u0938\u092e\u0947\u0924 \u0938\u0941\u092c\u094d\u0930\u092e\u0923\u094d\u092f \u0938\u094d\u0935\u093e\u092e\u093f\u0928\u0947 \u0928\u092e\u0903 |\n\u0939\u0930\u093f\u0939\u0930 \u092a\u0941\u0924\u094d\u0930 \u0905\u092f\u094d\u092f\u092a\u094d\u092a \u0938\u094d\u0935\u093e\u092e\u093f\u0928\u0947 \u0928\u092e\u0903 |\n\u0938\u093e\u0915\u094d\u0937\u093e\u0924\u094d \u092a\u094d\u0930\u0924\u094d\u092f\u0915\u094d\u0937 \u0926\u0940\u092a\u0902 \u0926\u0930\u094d\u0936\u092f\u093e\u092e\u093f ||\n(\u0926\u0940\u092a\u0902 \u091a\u0942\u092a\u093f\u0902\u091a\u093f \u0915\u0933\u094d\u0933\u0915\u0941 \u0905\u0926\u094d\u0926\u0941\u0915\u094b\u0935\u093e\u0932\u093f)\n\n\u0927\u0942\u092a \u0926\u0940\u092a\u093e\u0928\u0902\u0924\u0930\u0902 \u0936\u0941\u0926\u094d\u0927 \u0906\u091a\u092e\u0928\u0940\u092f\u0902 \u0938\u092e\u0930\u094d\u092a\u092f\u093e\u092e\u093f\n(\u0909\u0926\u094d\u0927\u0930\u093f\u0923\u0947\u0924\u094b \u0928\u0940\u0930\u0941 \u0924\u0940\u0938\u0941\u0915\u094b\u0928\u093f \u092a\u093e\u0924\u094d\u0930\u0932\u094b \u0935\u0947\u092f\u093e\u0932\u093f)\n\n\u0928\u0948\u0935\u0947\u0926\u094d\u092f\u0902\n\n\u092d\u0915\u094d\u0937\u094d\u092f\u0948\u0930\u094d\u092d\u094b\u091c\u094d\u092f\u0948\u0936\u094d\u091a \u0932\u0947\u0939\u094d\u092f\u0948\u0936\u094d\u091a \u091a\u094b\u0937\u094d\u092f\u0948\u0936\u094d\u091a\u094b\u092a\u0938\u094d\u0915\u0943\u0924\u0902 \u092a\u092f\u0903 |\n\u0928\u093e\u0928\u094b\u092a\u0939\u093e\u0930 \u0938\u0902\u092f\u0941\u0915\u094d\u0924\u0902 \u0928\u0948\u0935\u0947\u0926\u094d\u092f\u0902 \u092a\u094d\u0930\u0924\u093f\u0917\u0943\u0939\u094d\u092f\u0924\u093e\u092e\u094d ||\n\n\u0913\u0902 \u092d\u0942\u0930\u094d\u092d\u0941\u0935\u0938\u094d\u0938\u0941\u0935\u0903 | \u0924\u0924\u094d\u0938\u0935\u093f\u0924\u0941\u0930\u094d\u0935\u0930\u0947\u0923\u094d\u092f\u0902 \u092d\u0930\u094d\u0917\u094b \u0926\u0947\u0935\u0938\u094d\u092f \u0927\u0940\u092e\u0939\u093f |\n\u0927\u093f\u092f\u094b \u092f\u094b \u0928\u0903 \u092a\u094d\u0930\u091a\u094b\u0926\u092f\u093e\u0924\u094d ||\n\u0938\u0924\u094d\u092f\u0902 \u0924\u094d\u0935\u0930\u094d\u0924\u0947\u0928 \u092a\u0930\u093f\u0937\u093f\u0902\u091a\u093e\u092e\u093f (\u090b\u0924\u0902 \u0924\u094d\u0935\u093e \u0938\u0924\u094d\u092f\u0947\u0928 \u092a\u0930\u093f\u0937\u093f\u0902\u091a\u093e\u092e\u093f) |\n\u0905\u092e\u0943\u0924\u092e\u0938\u094d\u0924\u0941 | \u0905\u092e\u0943\u0924\u094b\u092a\u0938\u094d\u0924\u0930\u0923\u092e\u0938\u093f |\n\u0913\u0902 \u092a\u094d\u0930\u093e\u0923\u093e\u092f \u0938\u094d\u0935\u093e\u0939\u093e | \u0913\u0902 \u0905\u092a\u093e\u0928\u093e\u092f \u0938\u094d\u0935\u093e\u0939\u093e | \u0913\u0902 \u0935\u094d\u092f\u093e\u0928\u093e\u092f \u0938\u094d\u0935\u093e\u0939\u093e |\n\u0913\u0902 \u0909\u0926\u093e\u0928\u093e\u092f \u0938\u094d\u0935\u093e\u0939\u093e | \u0913\u0902 \u0938\u092e\u093e\u0928\u093e\u092f \u0938\u094d\u0935\u093e\u0939\u093e |\n\u0936\u094d\u0930\u0940 \u092e\u0939\u093e\u0917\u0923\u093e\u0927\u093f\u092a\u0924\u092f\u0947 \u0928\u092e\u0903 |\n\u0935\u0932\u094d\u0932\u0940 \u0926\u0947\u0935\u0938\u0947\u0928 \u0938\u092e\u0947\u0924 \u0938\u0941\u092c\u094d\u0930\u092e\u0923\u094d\u092f \u0938\u094d\u0935\u093e\u092e\u093f\u0928\u0947 \u0928\u092e\u0903 |\n\u0939\u0930\u093f\u0939\u0930 \u092a\u0941\u0924\u094d\u0930 \u0905\u092f\u094d\u092f\u092a\u094d\u092a \u0938\u094d\u0935\u093e\u092e\u093f\u0928\u0947 \u0928\u092e\u0903 |\n\u092e\u0939\u093e\u0928\u0948\u0935\u0947\u0926\u094d\u092f\u0902 \u0938\u092e\u0930\u094d\u092a\u092f\u093e\u092e\u093f ||\n\u0905\u092e\u0943\u0924\u093e\u092a\u093f\u0927\u093e\u0928\u092e\u0938\u093f | \u0909\u0924\u094d\u0924\u0930\u093e\u092a\u094b\u0936\u0928\u0902 \u0938\u092e\u0930\u094d\u092a\u092f\u093e\u092e\u093f ||\n(\u0928\u0948\u0935\u0947\u0926\u094d\u092f\u0902 \u091a\u0941\u091f\u094d\u091f\u0942 \u092e\u0942\u0921\u0941\u0938\u093e\u0930\u094d\u0932\u0941 \u0928\u0940\u0930\u0941 \u0924\u093f\u092a\u094d\u092a\u093f \u0938\u094d\u0935\u093e\u092e\u093f\u0915\u093f \u0938\u092e\u0930\u094d\u092a\u093f\u0902\u091a\u093e\u0932\u093f)\n\n\u0924\u093e\u0902\u092c\u0942\u0932\u0902\n\n\u092a\u0942\u0917\u0940\u092b\u0932 \u0938\u092e\u093e\u092f\u0941\u0915\u094d\u0924\u0902 \u0928\u093e\u0917\u0935\u0932\u094d\u0932\u0940 \u0926\u0933\u0948\u0930\u094d\u092f\u0941\u0924\u092e\u094d |\n\u0915\u0930\u094d\u092a\u0942\u0930 \u091a\u0942\u0930\u094d\u0923 \u0938\u0902\u092f\u0941\u0915\u094d\u0924\u0902 \u0924\u093e\u0902\u092c\u0942\u0932\u0902 \u092a\u094d\u0930\u0924\u093f\u0917\u0943\u0939\u094d\u092f\u0924\u093e\u092e\u094d ||\n\u0936\u094d\u0930\u0940 \u092e\u0939\u093e\u0917\u0923\u093e\u0927\u093f\u092a\u0924\u092f\u0947 \u0928\u092e\u0903 |\n\u0935\u0932\u094d\u0932\u0940 \u0926\u0947\u0935\u0938\u0947\u0928 \u0938\u092e\u0947\u0924 \u0938\u0941\u092c\u094d\u0930\u092e\u0923\u094d\u092f \u0938\u094d\u0935\u093e\u092e\u093f\u0928\u0947 \u0928\u092e\u0903 |\n\u0939\u0930\u093f\u0939\u0930 \u092a\u0941\u0924\u094d\u0930 \u0905\u092f\u094d\u092f\u092a\u094d\u092a \u0938\u094d\u0935\u093e\u092e\u093f\u0928\u0947 \u0928\u092e\u0903 |\n\u0924\u093e\u0902\u092c\u0942\u0932\u0902 \u0938\u092e\u0930\u094d\u092a\u092f\u093e\u092e\u093f ||\n\n\u0928\u0940\u0930\u093e\u091c\u0928\u0902 (\u0939\u093e\u0930\u0924\u093f)\n\n\u0936\u0902\u0915\u0930\u093e\u092f \u0936\u0902\u0915\u0930\u093e\u092f \u0936\u0902\u0915\u0930\u093e\u092f \u092e\u0902\u0917\u0933\u0902\n\u0936\u093e\u0902\u0915\u0930\u0940 \u092e\u0928\u094b\u0939\u0930\u093e\u092f \u0936\u093e\u0936\u094d\u0935\u0924\u093e\u092f \u092e\u0902\u0917\u0933\u0902 |\n\u0917\u0941\u0930\u0941\u0935\u0930\u093e\u092f \u092e\u0902\u0917\u0933\u0902 \u0926\u0924\u094d\u0924\u093e\u0924\u094d\u0930\u0947\u092f \u092e\u0902\u0917\u0933\u0902\n\u0930\u093e\u091c \u0930\u093e\u092e \u092e\u0902\u0917\u0933\u0902 \u0930\u093e\u092e\u0915\u0943\u0937\u094d\u0923 \u092e\u0902\u0917\u0933\u0902 |\n\u0905\u092f\u094d\u092f\u092a\u094d\u092a \u092e\u0902\u0917\u0933\u0902 \u092e\u0923\u093f\u0915\u0902\u0920 \u092e\u0902\u0917\u0933\u0902\n\u0936\u092c\u0930\u0940\u0936 \u092e\u0902\u0917\u0933\u0902 \u0936\u093e\u0938\u094d\u0924\u093e\u092f\u0947 \u092e\u0902\u0917\u0933\u0902 |\n\u092e\u0902\u0917\u0933\u0902 \u092e\u0902\u0917\u0933\u0902 \u0928\u093f\u0924\u094d\u092f\u091c\u092f \u092e\u0902\u0917\u0933\u0902 ||\n\n\u092e\u0902\u0917\u0933\u0928\u0940\u0930\u093e\u091c\u0928\u0902 \u0938\u092e\u0930\u094d\u092a\u092f\u093e\u092e\u093f\n\u0928\u0940\u0930\u093e\u091c\u0928\u093e\u0928\u0902\u0924\u0930\u0902 \u0936\u0941\u0926\u094d\u0927\u093e\u091a\u092e\u0928\u0940\u092f\u0902 \u0938\u092e\u0930\u094d\u092a\u092f\u093e\u092e\u093f\n\n\u092e\u0902\u0924\u094d\u0930\u092a\u0941\u0937\u094d\u092a\u0902\n\n\u0913\u0902 \u0930\u093e\u091c\u093e\u0927\u093f\u0930\u093e\u091c\u093e\u092f \u092a\u094d\u0930\u0938\u0939\u094d\u092f \u0938\u093e\u0939\u093f\u0928\u0947 |\n\u0928\u092e\u094b \u0935\u092f\u0902 \u0935\u0948\u0936\u094d\u0930\u0935\u0923\u093e\u092f \u0915\u0941\u0930\u094d\u092e\u0939\u0947 |\n\u0938 \u092e\u0947 \u0915\u093e\u092e\u093e\u0928\u094d \u0915\u093e\u092e\u0915\u093e\u092e\u093e\u092f \u092e\u0939\u094d\u092f\u092e\u094d |\n\u0915\u093e\u092e\u0947\u0936\u094d\u0935\u0930\u094b \u0935\u0948\u0936\u094d\u0930\u0935\u0923\u094b \u0926\u0927\u093e\u0924\u0941 |\n\u0915\u0941\u092c\u0947\u0930\u093e\u092f \u0935\u0948\u0936\u094d\u0930\u0935\u0923\u093e\u092f | \u092e\u0939\u093e\u0930\u093e\u091c\u093e\u092f \u0928\u092e\u0903 ||\n\n\u0913\u0902 \u0924\u0926\u094d\u092c\u094d\u0930\u0939\u094d\u092e | \u0913\u0902 \u0924\u0926\u094d\u0935\u093e\u092f\u0941\u0903 | \u0913\u0902 \u0924\u0926\u093e\u0924\u094d\u092e\u093e | \u0913\u0902 \u0924\u0924\u094d\u0938\u0924\u094d\u092f\u092e\u094d | \u0913\u0902 \u0924\u0924\u094d\u0938\u0930\u094d\u0935\u092e\u094d | \u0913\u0902 \u0924\u0924\u094d\u092a\u0941\u0930\u094b\u0930\u094d\u0928\u092e\u0903 |\n\u0905\u0902\u0924\u0936\u094d\u091a\u0930\u0924\u093f \u092d\u0942\u0924\u0947\u0937\u0941 \u0917\u0941\u0939\u093e\u092f\u093e\u0902 \u0935\u093f\u0936\u094d\u0935\u092e\u0942\u0930\u094d\u0924\u093f\u0937\u0941 |\n\u0924\u094d\u0935\u0902 \u092f\u091c\u094d\u091e\u0938\u094d\u0924\u094d\u0935\u0902 \u0935\u0937\u091f\u094d\u0915\u093e\u0930\u0938\u094d\u0924\u094d\u0935\u092e\u093f\u0902\u0926\u094d\u0930\u0938\u094d\u0924\u094d\u0935\u0917\u094d\u0902 \u0930\u0941\u0926\u094d\u0930\u0938\u094d\u0924\u094d\u0935\u0902 \u0935\u093f\u0937\u094d\u0923\u0941\u0938\u094d\u0924\u094d\u0935\u0902 \u092c\u094d\u0930\u0939\u094d\u092e \u0924\u094d\u0935\u0902 \u092a\u094d\u0930\u091c\u093e\u092a\u0924\u093f\u0903 |\n\u0924\u094d\u0935\u0902 \u0924\u0926\u093e\u092a \u0906\u092a\u094b \u091c\u094d\u092f\u094b\u0924\u0940 \u0930\u0938\u094b\u0c3d\u092e\u0943\u0924\u0902 \u092c\u094d\u0930\u0939\u094d\u092e \u092d\u0942\u0930\u094d\u092d\u0941\u0935\u0938\u094d\u0938\u0941\u0935\u0930\u094b\u092e\u094d ||\n\n\u0938\u0926\u094d\u092f\u094b\u091c\u093e\u0924\u0902 \u092a\u094d\u0930\u092a\u0926\u094d\u092f\u093e\u092e\u093f \u0938\u0926\u094d\u092f\u094b\u091c\u093e\u0924\u093e\u092f \u0935\u0948 \u0928\u092e\u094b \u0928\u092e\u0903 |\n\u092d\u0935\u0947 \u092d\u0935\u0947 \u0928\u093e\u0924\u093f\u092d\u0935\u0947 \u092d\u0935\u0938\u094d\u0935 \u092e\u093e\u092e\u094d | \u092d\u0935\u094b\u0926\u094d\u092d\u0935\u093e\u092f \u0928\u092e\u0903 ||\n\n\u0935\u093e\u092e\u0926\u0947\u0935\u093e\u092f \u0928\u092e\u094b \u091c\u094d\u092f\u0947\u0937\u094d\u0920\u093e\u092f \u0928\u092e\u0903 \u0936\u094d\u0930\u0947\u0937\u094d\u0920\u093e\u092f \u0928\u092e\u094b \u0930\u0941\u0926\u094d\u0930\u093e\u092f \u0928\u092e\u0903 \u0915\u093e\u0932\u093e\u092f \u0928\u092e\u0903 |\n\u0915\u0932\u0935\u093f\u0915\u0930\u0923\u093e\u092f \u0928\u092e\u094b \u092c\u0932\u0935\u093f\u0915\u0930\u0923\u093e\u092f \u0928\u092e\u094b \u092c\u0932\u093e\u092f \u0928\u092e\u094b \u092c\u0932\u092a\u094d\u0930\u092e\u0925\u0928\u093e\u092f \u0928\u092e\u0903 |\n\u0938\u0930\u094d\u0935\u092d\u0942\u0924\u0926\u092e\u0928\u093e\u092f \u0928\u092e\u094b \u092e\u0928\u094b\u0928\u094d\u092e\u0928\u093e\u092f \u0928\u092e\u0903 ||\n\n\u0905\u0918\u094b\u0930\u0947\u092d\u094d\u092f\u094b\u0c3d\u0925 \u0918\u094b\u0930\u0947\u092d\u094d\u092f\u094b \u0918\u094b\u0930\u0918\u094b\u0930\u0924\u0930\u0947\u092d\u094d\u092f\u0903 |\n\u0938\u0930\u094d\u0935\u0947\u092d\u094d\u092f\u0903 \u0938\u0930\u094d\u0935\u0936\u0930\u094d\u0935\u0947\u092d\u094d\u092f\u094b \u0928\u092e\u0938\u094d\u0924\u0947 \u0905\u0938\u094d\u0924\u0941 \u0930\u0941\u0926\u094d\u0930\u0930\u0942\u092a\u0947\u092d\u094d\u092f\u0903 ||\n\n\u0924\u0924\u094d\u092a\u0941\u0930\u0941\u0937\u093e\u092f \u0935\u093f\u0926\u094d\u092e\u0939\u0947 \u092e\u0939\u093e\u0926\u0947\u0935\u093e\u092f \u0927\u0940\u092e\u0939\u093f |\n\u0924\u0928\u094d\u0928\u094b \u0930\u0941\u0926\u094d\u0930\u0903 \u092a\u094d\u0930\u091a\u094b\u0926\u092f\u093e\u0924\u094d ||\n\n\u0908\u0936\u093e\u0928\u0938\u094d\u0938\u0930\u094d\u0935\u0935\u093f\u0926\u094d\u092f\u093e\u0928\u093e\u0902 \u0908\u0936\u094d\u0935\u0930\u0938\u094d\u0938\u0930\u094d\u0935\u092d\u0942\u0924\u093e\u0928\u093e\u0902 \u092c\u094d\u0930\u0939\u094d\u092e\u093e\u0927\u093f\u092a\u0924\u093f\u0930\u094d\u092c\u094d\u0930\u0939\u094d\u092e\u0923\u094b\u0c3d\u0927\u093f\u092a\u0924\u093f\u0930\u094d\u092c\u094d\u0930\u0939\u094d\u092e\u093e \u0936\u093f\u0935\u094b \u092e\u0947 \u0905\u0938\u094d\u0924\u0941 \u0938\u0926\u093e\u0936\u093f\u0935\u094b\u092e\u094d ||\n\n\u0913\u0902 \u090f\u0915\u0926\u0902\u0924\u093e\u092f \u0935\u093f\u0926\u094d\u092e\u0939\u0947 \u0935\u0915\u094d\u0930\u0924\u0941\u0902\u0921\u093e\u092f \u0927\u0940\u092e\u0939\u093f |\n\u0924\u0928\u094d\u0928\u094b \u0926\u0902\u0924\u093f\u0903 \u092a\u094d\u0930\u091a\u094b\u0926\u092f\u093e\u0924\u094d ||\n\n\u0913\u0902 \u0924\u0924\u094d\u092a\u0941\u0930\u0941\u0937\u093e\u092f \u0935\u093f\u0926\u094d\u092e\u0939\u0947 \u092e\u0939\u093e\u0938\u0947\u0928\u093e\u092f \u0927\u0940\u092e\u0939\u093f |\n\u0924\u0928\u094d\u0928\u0903 \u0937\u0923\u094d\u092e\u0941\u0916\u0903 \u092a\u094d\u0930\u091a\u094b\u0926\u092f\u093e\u0924\u094d ||\n\n\u0913\u0902 \u092d\u0942\u0924\u0928\u093e\u0925\u093e\u092f \u0935\u093f\u0926\u094d\u092e\u0939\u0947 \u092d\u0935\u092a\u0941\u0924\u094d\u0930\u093e\u092f \u0927\u0940\u092e\u0939\u093f |\n\u0924\u0928\u094d\u0928\u094b \u0936\u093e\u0938\u094d\u0924\u093e \u092a\u094d\u0930\u091a\u094b\u0926\u092f\u093e\u0924\u094d ||\n\n\u0936\u094d\u0930\u0940 \u092e\u0939\u093e\u0917\u0923\u093e\u0927\u093f\u092a\u0924\u092f\u0947 \u0928\u092e\u0903 |\n\u0935\u0932\u094d\u0932\u0940 \u0926\u0947\u0935\u0938\u0947\u0928 \u0938\u092e\u0947\u0924 \u0938\u0941\u092c\u094d\u0930\u092e\u0923\u094d\u092f \u0938\u094d\u0935\u093e\u092e\u093f\u0928\u0947 \u0928\u092e\u0903 |\n\u0939\u0930\u093f\u0939\u0930 \u092a\u0941\u0924\u094d\u0930 \u0905\u092f\u094d\u092f\u092a\u094d\u092a \u0938\u094d\u0935\u093e\u092e\u093f\u0928\u0947 \u0928\u092e\u0903 |\n\u0938\u0941\u0935\u0930\u094d\u0923 \u0926\u093f\u0935\u094d\u092f \u0935\u0947\u0926\u094b\u0915\u094d\u0924 \u092e\u0902\u0924\u094d\u0930\u092a\u0941\u0937\u094d\u092a\u0902 \u0938\u092e\u0930\u094d\u092a\u092f\u093e\u092e\u093f ||\n\n\u092a\u094d\u0930\u0926\u0915\u094d\u0937\u093f\u0923\n\n\u092f\u093e\u0928\u093f\u0915\u093e\u0928\u093f\u091a \u092a\u093e\u092a\u093e\u0928\u093f \u091c\u0928\u094d\u092e\u093e\u0902\u0924\u0930\u0915\u0943\u0924\u093e\u0928\u093f \u091a |\n\u0924\u093e\u0928\u093f \u0924\u093e\u0928\u093f \u092a\u094d\u0930\u0923\u0936\u094d\u092f\u0902\u0924\u093f \u092a\u094d\u0930\u0926\u0915\u094d\u0937\u093f\u0923 \u092a\u0926\u0947 \u092a\u0926\u0947 ||\n\u092a\u093e\u092a\u094b\u0c3d\u0939\u0902 \u092a\u093e\u092a\u0915\u0930\u094d\u092e\u093e\u0c3d\u0939\u0902 \u092a\u093e\u092a\u093e\u0924\u094d\u092e\u093e \u092a\u093e\u092a\u0938\u0902\u092d\u0935\u0903 |\n\u0924\u094d\u0930\u093e\u0939\u093f \u092e\u093e\u0902 \u0915\u0943\u092a\u092f\u093e \u0926\u0947\u0935 \u0936\u0930\u0923\u093e\u0917\u0924\u0935\u0924\u094d\u0938\u0932 ||\n\u0905\u0928\u094d\u092f\u0925\u093e \u0936\u0930\u0923\u0902 \u0928\u093e\u0938\u094d\u0924\u093f \u0924\u094d\u0935\u092e\u0947\u0935 \u0936\u0930\u0923\u0902 \u092e\u092e |\n\u0924\u0938\u094d\u092e\u093e\u0924\u094d\u0915\u093e\u0930\u0941\u0923\u094d\u092f \u092d\u093e\u0935\u0947\u0928 \u0930\u0915\u094d\u0937 \u0930\u0915\u094d\u0937 \u092e\u0939\u0947\u0936\u094d\u0935\u0930 ||\n\n\u0936\u094d\u0930\u0940 \u092e\u0939\u093e\u0917\u0923\u093e\u0927\u093f\u092a\u0924\u092f\u0947 \u0928\u092e\u0903 |\n\u0935\u0932\u094d\u0932\u0940 \u0926\u0947\u0935\u0938\u0947\u0928 \u0938\u092e\u0947\u0924 \u0938\u0941\u092c\u094d\u0930\u092e\u0923\u094d\u092f \u0938\u094d\u0935\u093e\u092e\u093f\u0928\u0947 \u0928\u092e\u0903 |\n\u0939\u0930\u093f\u0939\u0930 \u092a\u0941\u0924\u094d\u0930 \u0905\u092f\u094d\u092f\u092a\u094d\u092a \u0938\u094d\u0935\u093e\u092e\u093f\u0928\u0947 \u0928\u092e\u0903 |\n\u0906\u0924\u094d\u092e\u092a\u094d\u0930\u0926\u0915\u094d\u0937\u093f\u0923 \u0928\u092e\u0938\u094d\u0915\u093e\u0930\u093e\u0928\u094d \u0938\u092e\u0930\u094d\u092a\u092f\u093e\u092e\u093f ||\n\n\u0928\u092e\u0938\u094d\u0915\u093e\u0930 \u0936\u094d\u0932\u094b\u0915\u092e\u0941\u0932\u0941\n\n\u0932\u094b\u0915\u0935\u0940\u0930\u0902 \u092e\u0939\u093e\u092a\u0942\u091c\u094d\u092f\u0902 \u0938\u0930\u094d\u0935\u0930\u0915\u094d\u0937\u093e\u0915\u0930\u0902 \u0935\u093f\u092d\u0941\u092e\u094d |\n\u092a\u093e\u0930\u094d\u0935\u0924\u0940\u0939\u0943\u0926\u092f\u093e\u0928\u0902\u0926\u0902 \u0936\u093e\u0938\u094d\u0924\u093e\u0930\u0902 \u092a\u094d\u0930\u0923\u092e\u093e\u092e\u094d\u092f\u0939\u092e\u094d ||\n|| \u0938\u094d\u0935\u093e\u092e\u093f\u092f\u0947 \u0936\u0930\u0923\u0902 \u0905\u092f\u094d\u092f\u092a\u094d\u092a || 1 ||\n\n\u0935\u093f\u092a\u094d\u0930\u092a\u0942\u091c\u094d\u092f\u0902 \u0935\u093f\u0936\u094d\u0935\u0935\u0902\u0926\u094d\u092f\u0902 \u0935\u093f\u0937\u094d\u0923\u0941\u0936\u0902\u092d\u094b\u0903 \u092a\u094d\u0930\u093f\u092f\u0902 \u0938\u0941\u0924\u092e\u094d |\n\u0915\u094d\u0937\u093f\u092a\u094d\u0930\u092a\u094d\u0930\u0938\u093e\u0926 \u0928\u093f\u0930\u0924\u0902 \u0936\u093e\u0938\u094d\u0924\u093e\u0930\u0902 \u092a\u094d\u0930\u0923\u092e\u093e\u092e\u094d\u092f\u0939\u092e\u094d ||\n|| \u0938\u094d\u0935\u093e\u092e\u093f\u092f\u0947 \u0936\u0930\u0923\u0902 \u0905\u092f\u094d\u092f\u092a\u094d\u092a || 2 ||\n\n\u092e\u0924\u094d\u0924\u092e\u093e\u0924\u0902\u0917 \u0917\u092e\u0928\u0902 \u0915\u093e\u0930\u0941\u0923\u094d\u092f\u093e\u092e\u0943\u0924 \u092a\u0942\u0930\u093f\u0924\u092e\u094d |\n\u0938\u0930\u094d\u0935\u0935\u093f\u0918\u094d\u0928\u0939\u0930\u0902 \u0926\u0947\u0935\u0902 \u0936\u093e\u0938\u094d\u0924\u093e\u0930\u0902 \u092a\u094d\u0930\u0923\u092e\u093e\u092e\u094d\u092f\u0939\u092e\u094d ||\n|| \u0938\u094d\u0935\u093e\u092e\u093f\u092f\u0947 \u0936\u0930\u0923\u0902 \u0905\u092f\u094d\u092f\u092a\u094d\u092a || 3 ||\n\n\u0905\u0938\u094d\u092e\u0924\u094d\u0915\u0941\u0932\u0947\u0936\u094d\u0935\u0930\u0902 \u0926\u0947\u0935\u092e\u0938\u094d\u092e\u091a\u094d\u091b\u0924\u094d\u0930\u0941 \u0935\u093f\u0928\u093e\u0936\u0928\u092e\u094d |\n\u0905\u0938\u094d\u092e\u0926\u093f\u0937\u094d\u091f\u092a\u094d\u0930\u0926\u093e\u0924\u093e\u0930\u0902 \u0936\u093e\u0938\u094d\u0924\u093e\u0930\u0902 \u092a\u094d\u0930\u0923\u092e\u093e\u092e\u094d\u092f\u0939\u092e\u094d ||\n|| \u0938\u094d\u0935\u093e\u092e\u093f\u092f\u0947 \u0936\u0930\u0923\u0902 \u0905\u092f\u094d\u092f\u092a\u094d\u092a || 4 ||\n\n\u092a\u093e\u0902\u0921\u094d\u092f\u0947\u0936 \u0935\u0902\u0936\u0924\u093f\u0932\u0915\u0902 \u0915\u0947\u0930\u0933\u0947 \u0915\u0947\u0933\u093f \u0935\u093f\u0917\u094d\u0930\u0939\u092e\u094d |\n\u0906\u0930\u094d\u0924\u0924\u094d\u0930\u093e\u0923\u092a\u0930\u0902 \u0926\u0947\u0935\u0902 \u0936\u093e\u0938\u094d\u0924\u093e\u0930\u0902 \u092a\u094d\u0930\u0923\u092e\u093e\u092e\u094d\u092f\u0939\u092e\u094d ||\n|| \u0938\u094d\u0935\u093e\u092e\u093f\u092f\u0947 \u0936\u0930\u0923\u0902 \u0905\u092f\u094d\u092f\u092a\u094d\u092a || 5 ||\n\n\u092a\u0902\u091a\u0930\u0924\u094d\u0928\u093e\u0916\u094d\u092f \u092e\u0947\u0924\u0926\u094d\u092f\u094b \u0928\u093f\u0924\u094d\u092f\u0902 \u0936\u0941\u0926\u094d\u0927\u0903 \u092a\u0920\u0947\u0928\u094d\u0928\u0930\u0903 |\n\u0924\u0938\u094d\u092f \u092a\u094d\u0930\u0938\u0928\u094d\u0928\u094b \u092d\u0917\u0935\u093e\u0928\u094d \u0936\u093e\u0938\u094d\u0924\u093e\u0935\u0938\u0924\u093f \u092e\u093e\u0928\u0938\u0947 ||\n|| \u0938\u094d\u0935\u093e\u092e\u093f\u092f\u0947 \u0936\u0930\u0923\u0902 \u0905\u092f\u094d\u092f\u092a\u094d\u092a || 6 ||\n\n\u0936\u093f\u0935\u0935\u0940\u0930\u094d\u092f \u0938\u092e\u0941\u0926\u094d\u092d\u0942\u0924\u0902 \u0936\u094d\u0930\u0940\u0928\u093f\u0935\u093e\u0938 \u0924\u0928\u0941\u0926\u094d\u092d\u0935\u0902 |\n\u0936\u093f\u0916\u093f\u0935\u093e\u0939\u093e\u0928\u0941\u091c\u0902 \u0935\u0902\u0926\u0947 \u092e\u0939\u093e\u0930\u094b\u0917 \u0928\u093f\u0935\u093e\u0930\u093f\u0923\u0902 ||\n|| \u0938\u094d\u0935\u093e\u092e\u093f\u092f\u0947 \u0936\u0930\u0923\u0902 \u0905\u092f\u094d\u092f\u092a\u094d\u092a || 7 ||\n\n\u092f\u0938\u094d\u092f \u0927\u0928\u094d\u0935\u0902\u0924\u0930\u093f\u0930\u094d\u092e\u093e\u0924\u093e \u092a\u093f\u0924\u093e \u0926\u0947\u0935\u094b \u092e\u0939\u0947\u0936\u094d\u0935\u0930\u0903 |\n\u0924\u0902 \u0936\u093e\u0938\u094d\u0924\u093e\u0930\u092e\u0939\u0902 \u0935\u0902\u0926\u0947 \u092e\u0939\u093e\u0930\u094b\u0917 \u0928\u093f\u0935\u093e\u0930\u0923\u0902 ||\n|| \u0938\u094d\u0935\u093e\u092e\u093f\u092f\u0947 \u0936\u0930\u0923\u0902 \u0905\u092f\u094d\u092f\u092a\u094d\u092a || 8 ||\n\n\u092d\u0942\u0924\u0928\u093e\u0925 \u0938\u0926\u093e\u0928\u0902\u0926 \u0938\u0930\u094d\u0935\u092d\u0942\u0924\u0926\u092f\u093e\u092a\u0930 |\n\u0930\u0915\u094d\u0937 \u0930\u0915\u094d\u0937 \u092e\u0939\u093e\u092c\u093e\u0939\u094b \u0936\u093e\u0938\u094d\u0924\u0941\u092d\u094d\u092f\u0947 \u0928\u092e\u094b\u0928\u092e\u0903 ||\n|| \u0938\u094d\u0935\u093e\u092e\u093f\u092f\u0947 \u0936\u0930\u0923\u0902 \u0905\u092f\u094d\u092f\u092a\u094d\u092a || 9 ||\n\n\u0936\u092c\u0930\u0940\u092a\u0930\u094d\u0935\u0924\u0947 \u092a\u0942\u091c\u094d\u092f\u0902 \u0936\u093e\u0902\u0924\u092e\u093e\u0928\u0938 \u0938\u0902\u0938\u094d\u0925\u093f\u0924\u0902 |\n\u0936\u0930\u0923\u093e\u0917\u0924 \u0930\u0915\u094d\u0937\u093e\u0902\u0936\u0902 \u0924\u0902 \u0935\u0902\u0926\u0947 \u092a\u0930\u092e\u0947\u0936\u094d\u0935\u0930\u0902 ||\n|| \u0938\u094d\u0935\u093e\u092e\u093f\u092f\u0947 \u0936\u0930\u0923\u0902 \u0905\u092f\u094d\u092f\u092a\u094d\u092a || 10 ||\n\n\u0906\u0926\u094d\u092f\u0902\u0924\u0930\u0939\u093f\u0924\u0902 \u0926\u0947\u0935\u0902 \u0938\u0930\u094d\u0935\u0935\u094d\u092f\u093e\u092a\u093f\u0928\u092e\u0940\u0936\u094d\u0935\u0930\u0902 |\n\u092d\u0915\u094d\u0924\u092a\u093e\u0932\u0928 \u0938\u0902\u0924\u0941\u0937\u094d\u091f\u0902 \u0936\u093e\u0938\u094d\u0924\u093e\u0930\u0902 \u092a\u094d\u0930\u0923\u092e\u093e\u092e\u094d\u092f\u0939\u092e\u094d ||\n|| \u0938\u094d\u0935\u093e\u092e\u093f\u092f\u0947 \u0936\u0930\u0923\u0902 \u0905\u092f\u094d\u092f\u092a\u094d\u092a || 11 ||\n\n\u092e\u0923\u093f\u0917\u094d\u0930\u0940\u0935 \u0927\u0930\u0902 \u0926\u0947\u0935\u0902 \u092e\u0902\u0926\u0939\u093e\u0938 \u092e\u0941\u0916\u093e\u0902\u092c\u0941\u091c\u0902 |\n\u0936\u092c\u0930\u0940\u0917\u093f\u0930\u093f \u0935\u093e\u0938\u093e\u092f \u0928\u092e\u0938\u094d\u0924\u0947 \u0932\u094b\u0915\u092a\u093e\u0932\u0915 ||\n|| \u0938\u094d\u0935\u093e\u092e\u093f\u092f\u0947 \u0936\u0930\u0923\u0902 \u0905\u092f\u094d\u092f\u092a\u094d\u092a || 12 ||\n\n\u0915\u0932\u093f\u092f\u0941\u0917\u0947 \u0935\u0930\u0926\u0902 \u0926\u0947\u0935\u0902 \u0915\u093e\u092e\u093f\u0924\u093e\u0930\u094d\u0925 \u092b\u0932\u092a\u094d\u0930\u0926\u0902 |\n\u0915\u0930\u0941\u0923\u093e\u0938\u093e\u0917\u0930\u0902 \u0936\u093e\u0902\u0924\u0902 \u0936\u093e\u0938\u094d\u0924\u093e\u0930\u0902 \u092a\u094d\u0930\u0923\u092e\u093e\u092e\u094d\u092f\u0939\u092e\u094d ||\n|| \u0938\u094d\u0935\u093e\u092e\u093f\u092f\u0947 \u0936\u0930\u0923\u0902 \u0905\u092f\u094d\u092f\u092a\u094d\u092a || 13 ||\n\n\u0935\u0930\u0926\u092d\u092f \u0939\u0938\u094d\u0924\u093e\u092c\u094d\u091c\u0902 \u092e\u0923\u093f\u0915\u0902\u0920\u0902 \u0935\u093f\u092d\u0942\u0937\u093f\u0924\u0902 |\n\u0936\u092c\u0930\u0940\u0935\u093e\u0938\u093f\u0928\u0902 \u0926\u0947\u0935\u0902 \u0936\u093e\u0938\u094d\u0924\u093e\u0930\u0902 \u092a\u094d\u0930\u0923\u092e\u093e\u092e\u094d\u092f\u0939\u092e\u094d ||\n|| \u0938\u094d\u0935\u093e\u092e\u093f\u092f\u0947 \u0936\u0930\u0923\u0902 \u0905\u092f\u094d\u092f\u092a\u094d\u092a || 14 ||\n\n\u0924\u094d\u0930\u093f\u0932\u094b\u0915\u092e\u0902\u0917\u0933\u0902 \u0926\u0948\u0935\u0902 \u0924\u094d\u0930\u093f\u092e\u0942\u0930\u094d\u0924\u093f \u091c\u0928\u0915\u0902 \u0935\u093f\u092d\u0941\u0902 |\n\u0927\u0930\u094d\u092e\u0936\u093e\u0938\u094d\u0924\u093e\u0930\u092e\u093e\u0926\u094d\u092f\u0902\u0924\u0902 \u0935\u0902\u0926\u0947\u0939\u0902 \u0936\u092c\u0930\u0940\u0936\u094d\u0935\u0930\u0902 ||\n|| \u0938\u094d\u0935\u093e\u092e\u093f\u092f\u0947 \u0936\u0930\u0923\u0902 \u0905\u092f\u094d\u092f\u092a\u094d\u092a || 15 ||\n\n\u092e\u0939\u093f\u0937\u0940\u092e\u0930\u094d\u0926\u0928\u0902 \u0926\u0947\u0935\u0902 \u092e\u093e\u0930\u094d\u0924\u093e\u0902\u0921\u093e\u0924\u094d\u092e\u091c \u0938\u0902\u092f\u0941\u0924\u0902 |\n\u092e\u093e\u0924\u0902\u0917 \u0935\u093e\u0939\u0928\u0902 \u0935\u0902\u0926\u0947 \u0936\u093e\u0938\u094d\u0924\u093e\u0930\u0902 \u092a\u094d\u0930\u0923\u092e\u093e\u092e\u094d\u092f\u0939\u092e\u094d ||\n|| \u0938\u094d\u0935\u093e\u092e\u093f\u092f\u0947 \u0936\u0930\u0923\u0902 \u0905\u092f\u094d\u092f\u092a\u094d\u092a || 16 ||\n\n\u0927\u0930\u094d\u092e\u0938\u0902\u0938\u094d\u0925\u093e\u092a\u0928\u0902 \u0935\u0940\u0930\u0902 \u0926\u0941\u0937\u094d\u091f\u0926\u093e\u0928\u0935 \u0928\u093e\u0936\u0928\u0902 |\n\u0936\u093f\u0937\u094d\u091f\u0930\u0915\u094d\u0937\u0923 \u0924\u0924\u094d\u092a\u0930\u0902 \u0936\u093e\u0938\u094d\u0924\u093e\u0930\u0902 \u092a\u094d\u0930\u0923\u092e\u093e\u092e\u094d\u092f\u0939\u092e\u094d ||\n|| \u0938\u094d\u0935\u093e\u092e\u093f\u092f\u0947 \u0936\u0930\u0923\u0902 \u0905\u092f\u094d\u092f\u092a\u094d\u092a || 17 ||\n\n\u092d\u0915\u094d\u0924\u091c\u0928\u093e\u0930\u094d\u0924\u093f \u0939\u0930\u0923\u0902 \u092a\u0930\u092e\u093e\u0928\u0902\u0926 \u0926\u093e\u092f\u0915\u0902 |\n\u0936\u092c\u0930\u0940\u0936\u0948\u0932 \u0928\u093f\u0932\u092f\u0902 \u0935\u0902\u0926\u0947\u0939\u0902 \u092e\u094b\u0915\u094d\u0937\u0926\u093e\u092f\u0915\u0902 ||\n|| \u0938\u094d\u0935\u093e\u092e\u093f\u092f\u0947 \u0936\u0930\u0923\u0902 \u0905\u092f\u094d\u092f\u092a\u094d\u092a || 18 ||\n\n\u092b\u093e\u0932\u0928\u0947\u0924\u094d\u0930\u0938\u0941\u0924\u0902 \u0926\u0947\u0935\u0902 \u0915\u0932\u093f\u0926\u094b\u0937\u0928\u093f\u0935\u093e\u0930\u0923\u0902 |\n\u092c\u093e\u0932\u0930\u0942\u092a\u0902 \u0932\u094b\u0915\u0928\u093e\u0925\u0902 \u0928\u092e\u093e\u092e\u093f \u0936\u092c\u0930\u0940\u0936\u094d\u0935\u0930\u092e\u094d ||\n|| \u0938\u094d\u0935\u093e\u092e\u093f\u092f\u0947 \u0936\u0930\u0923\u0902 \u0905\u092f\u094d\u092f\u092a\u094d\u092a || 19 ||\n\n\u092d\u0942\u0924\u0928\u093e\u0925 \u0938\u0926\u093e\u0928\u0902\u0926 \u0938\u0930\u094d\u0935\u092d\u0942\u0924\u0926\u092f\u093e\u092a\u0930\u0902 |\n\u0930\u0915\u094d\u0937\u0930\u0915\u094d\u0937 \u092e\u0939\u093e\u092c\u093e\u0939\u094b \u0936\u093e\u0938\u094d\u0924\u0941 \u092d\u094d\u092f\u0902 \u0928\u092e\u094b\u0928\u092e\u0903 ||\n|| \u0938\u094d\u0935\u093e\u092e\u093f\u092f\u0947 \u0936\u0930\u0923\u0902 \u0905\u092f\u094d\u092f\u092a\u094d\u092a || 20 ||\n(\u092d\u0942\u0924\u0928\u093e\u0925\u093e \u0938\u0926\u093e\u0928\u0902\u0926 \u092e\u0942\u0921\u0941 \u0938\u093e\u0930\u094d\u0932\u0941 \u091a\u0926\u0935\u093e\u0932\u093f)\n\n\u0936\u092c\u0930\u0940\u092a\u0930\u094d\u0935\u0924\u0947 \u092a\u0942\u091c\u094d\u092f\u0902 \u0936\u093e\u0902\u0924\u092e\u093e\u0928\u0938 \u0938\u0902\u0938\u094d\u0925\u093f\u0924\u0902 |\n\u0936\u0930\u0923\u093e\u0917\u0924 \u0930\u0915\u094d\u0937\u093e\u0902\u0936\u0902 \u0928\u092e\u093e\u092e\u093f \u0936\u092c\u0930\u0940\u0936\u094d\u0935\u0930\u092e\u094d ||\n|| \u0938\u094d\u0935\u093e\u092e\u093f\u092f\u0947 \u0936\u0930\u0923\u0902 \u0905\u092f\u094d\u092f\u092a\u094d\u092a || 21 ||\n\n\u0936\u093e\u0938\u094d\u0924\u093e \u0926\u0936\u0915\u0902\n\n\u0932\u094b\u0915\u0935\u0940\u0930\u0902 \u092e\u0939\u093e\u092a\u0942\u091c\u094d\u092f\u0902 \u0938\u0930\u094d\u0935\u0930\u0915\u094d\u0937\u093e\u0915\u0930\u0902 \u0935\u093f\u092d\u0941\u092e\u094d |\n\u092e\u0928\u094b\u091c\u0935\u093e\u0923 \u092c\u093e\u0923\u093e\u0930\u094d\u0924\u0902 \u0936\u093e\u0938\u094d\u0924\u093e\u0930\u0902 \u092a\u094d\u0930\u0923\u092e\u093e\u092e\u094d\u092f\u0939\u092e\u094d || 1 ||\n\n\u0936\u093e\u0930\u0926\u093e\u091a\u0902\u0926\u094d\u0930 \u0935\u0926\u0928\u0902 \u0936\u0930\u091a\u094d\u091a\u0902\u0926\u094d\u0930 \u0938\u092e\u093e\u0928\u0928\u092e\u094d |\n\u0936\u092c\u0930\u0940\u0917\u093f\u0930\u093f \u0928\u093f\u0932\u092f\u0902 \u0936\u093e\u0938\u094d\u0924\u093e\u0930\u0902 \u092a\u094d\u0930\u0923\u092e\u093e\u092e\u094d\u092f\u0939\u092e\u094d || 2 ||\n\n\u092d\u0938\u094d\u092e\u0930\u0941\u0926\u094d\u0930\u093e\u0915\u094d\u0937 \u0935\u093f\u092d\u094d\u0930\u093e\u091c\u0902 \u092e\u0902\u0926\u0939\u093e\u0938 \u0935\u093f\u0930\u093e\u091c\u093f\u0924\u092e\u094d |\n\u092e\u0928\u094d\u092e\u0925\u093e\u092f\u0941\u0924 \u0938\u094c\u0902\u0926\u0930\u094d\u092f\u0902 \u0936\u093e\u0938\u094d\u0924\u093e\u0930\u0902 \u092a\u094d\u0930\u0923\u092e\u093e\u092e\u094d\u092f\u0939\u092e\u094d || 3 ||\n\n\u0915\u0938\u094d\u0924\u0942\u0930\u0940 \u0924\u093f\u0932\u0915\u094b\u092a\u0947\u0924\u0902 \u0915\u0941\u0902\u0915\u0941\u092e\u093e\u0930\u094d\u091a\u093f\u0924 \u092e\u0938\u094d\u0924\u0915\u092e\u094d |\n\u0915\u0930\u0941\u0923\u093e\u0938\u0902\u0926\u094d\u0930 \u0928\u092f\u0928\u0902 \u0936\u093e\u0938\u094d\u0924\u093e\u0930\u0902 \u092a\u094d\u0930\u0923\u092e\u093e\u092e\u094d\u092f\u0939\u092e\u094d || 4 ||\n\n\u0915\u0943\u0924\u092a\u0941\u0923\u094d\u092f\u0948\u0903 \u0938\u0926\u093e\u0938\u0947\u0935\u094d\u092f\u0902 \u092d\u0915\u094d\u0924\u0915\u0932\u094d\u092a \u092e\u0939\u0940\u0930\u0941\u0939\u092e\u094d |\n\u0905\u0928\u093e\u0925\u0928\u093e\u0925\u0902 \u0926\u0947\u0935\u0947\u0936\u0902 \u0936\u093e\u0938\u094d\u0924\u093e\u0930\u0902 \u092a\u094d\u0930\u0923\u092e\u093e\u092e\u094d\u092f\u0939\u092e\u094d || 5 ||\n\n\u092e\u0923\u093f\u092d\u0942\u0937\u0923 \u0938\u0902\u0936\u094b\u092d\u0902 \u092e\u0923\u093f\u0915\u0902\u0920 \u0935\u093f\u092d\u0942\u0937\u093f\u0924\u092e\u094d |\n\u092e\u0939\u093e\u0924\u0947\u091c\u0938\u094d\u0935\u093f\u0928\u0902 \u0926\u0947\u0935\u0902 \u0936\u093e\u0938\u094d\u0924\u093e\u0930\u0902 \u092a\u094d\u0930\u0923\u092e\u093e\u092e\u094d\u092f\u0939\u092e\u094d || 6 ||\n\n\u092e\u0939\u093f\u0937\u0940\u092e\u0938\u094d\u0924\u0915\u093e\u0930\u0942\u0922\u0902 \u092e\u093e\u092f\u093e\u092e\u093e\u0928\u0941\u0937 \u0935\u093f\u0917\u094d\u0930\u0939\u092e\u094d |\n\u092e\u0928\u094d\u092e\u0925\u092a\u094d\u0930\u0924\u093f\u092e\u0902 \u0936\u0942\u0930\u0902 \u0936\u093e\u0938\u094d\u0924\u093e\u0930\u0902 \u092a\u094d\u0930\u0923\u092e\u093e\u092e\u094d\u092f\u0939\u092e\u094d || 7 ||\n\n\u0939\u0930\u093f\u0939\u0930\u093e\u0924\u094d\u092e\u091c\u0902 \u0926\u0947\u0935\u0902 \u0926\u0947\u0935\u0926\u0947\u0935\u0902 \u0938\u0941\u0930\u093e\u0930\u094d\u091a\u093f\u0924\u092e\u094d |\n\u0938\u0930\u094d\u0935\u093e\u092d\u0940\u0937\u094d\u091f\u092a\u094d\u0930\u0926\u093e\u0924\u093e\u0930\u0902 \u0936\u093e\u0938\u094d\u0924\u093e\u0930\u0902 \u092a\u094d\u0930\u0923\u092e\u093e\u092e\u094d\u092f\u0939\u092e\u094d || 8 ||\n\n\u0936\u094d\u0930\u0940\u0927\u0930\u094d\u092e\u0936\u093e\u0938\u094d\u0924\u093e \u0926\u0947\u0935\u0947\u0936\u0902 \u0936\u0930\u0923\u093e\u0917\u0924 \u0935\u0924\u094d\u0938\u0932\u092e\u094d |\n\u0936\u092c\u0930\u0940\u0935\u093e\u0938\u093f\u0928\u0902 \u0926\u0947\u0935\u0902 \u0936\u093e\u0938\u094d\u0924\u093e\u0930\u0902 \u092a\u094d\u0930\u0923\u092e\u093e\u092e\u094d\u092f\u0939\u092e\u094d || 9 ||\n\n\u092a\u0941\u0928\u0903 \u092a\u0942\u091c\n\n\u0913\u0902 \u0936\u094d\u0930\u0940 \u092e\u0939\u093e\u0917\u0923\u093e\u0927\u093f\u092a\u0924\u092f\u0947 \u0928\u092e\u0903 |\n\u0935\u0932\u094d\u0932\u0940 \u0926\u0947\u0935\u0938\u0947\u0928 \u0938\u092e\u0947\u0924 \u0938\u0941\u092c\u094d\u0930\u092e\u0923\u094d\u092f \u0938\u094d\u0935\u093e\u092e\u093f\u0928\u0947 \u0928\u092e\u0903 |\n\u0939\u0930\u093f\u0939\u0930 \u092a\u0941\u0924\u094d\u0930 \u0905\u092f\u094d\u092f\u092a\u094d\u092a \u0938\u094d\u0935\u093e\u092e\u093f\u0928\u0947 \u0928\u092e\u0903 |\n\u092a\u0941\u0928\u0903 \u092a\u0942\u091c\u093e\u0902 \u0915\u0930\u093f\u0937\u094d\u092f\u0947 ||\n\n\u091b\u0924\u094d\u0930\u0902 \u0906\u091a\u094d\u091b\u093e\u0926\u092f\u093e\u092e\u093f |\n\u091a\u093e\u092e\u0930\u0902 \u0935\u0940\u091a\u092f\u093e\u092e\u093f |\n\u0928\u0943\u0924\u094d\u092f\u0902 \u0926\u0930\u094d\u0936\u092f\u093e\u092e\u093f |\n\u0917\u0940\u0924\u0902 \u0936\u094d\u0930\u093e\u0935\u092f\u093e\u092e\u093f |\n\u0905\u0936\u094d\u0935\u093e\u0928\u094d \u0906\u0930\u094b\u0939\u092f\u093e\u092e\u093f |\n\u0917\u091c\u093e\u0928\u094d \u0906\u0930\u094b\u0939\u092f\u093e\u092e\u093f |\n\u0906\u0902\u0926\u094b\u0933\u093f\u0915\u093e\u0902 \u0906\u0930\u094b\u0939\u092f\u093e\u092e\u093f |\n\u0938\u092e\u0938\u094d\u0924 \u0930\u093e\u091c\u094b\u092a\u091a\u093e\u0930, \u0926\u0947\u0935\u094b\u092a\u091a\u093e\u0930, \u092d\u0915\u094d\u0924\u094d\u092f\u094b\u092a\u091a\u093e\u0930, \u0936\u0915\u094d\u0924\u094d\u092f\u094b\u092a\u091a\u093e\u0930, \u0938\u0930\u094d\u0935\u094b\u092a\u091a\u093e\u0930 \u092a\u0942\u091c\u093e\u0902 \u0938\u092e\u0930\u094d\u092a\u092f\u093e\u092e\u093f ||\n(\u092a\u0941\u0937\u094d\u092a\u0902 \u0938\u092e\u0930\u094d\u092a\u093f\u0902\u091a\u0935\u0932\u0947\u0928\u0941)\n\n\u0905\u092a\u0930\u093e\u0927 \u0915\u094d\u0937\u092e\u093e\u092a\u0923 \u0938\u094d\u0924\u094b\u0924\u094d\u0930\u0902\n\n\u092f\u0938\u094d\u092f \u0938\u094d\u092e\u0943\u0924\u094d\u092f\u093e\u091a \u0928\u093e\u092e\u094b\u0915\u094d\u0924\u094d\u092f\u093e \u0924\u092a\u094b \u092f\u091c\u094d\u091e \u0915\u094d\u0930\u093f\u092f\u093e\u0926\u093f\u0937\u0941 |\n\u0928\u094d\u092f\u0942\u0928\u0902 \u0938\u0902\u092a\u0942\u0930\u094d\u0923\u0924\u093e\u0902 \u092f\u093e\u0924\u093f \u0938\u0926\u094d\u092f\u094b \u0935\u0902\u0926\u0947 \u0924\u092e\u091a\u094d\u092f\u0941\u0924\u092e\u094d ||\n\n\u092e\u0902\u0924\u094d\u0930\u0939\u0940\u0928\u0902 \u0915\u094d\u0930\u093f\u092f\u093e\u0939\u0940\u0928\u0902 \u092d\u0915\u094d\u0924\u093f\u0939\u0940\u0928\u0902 \u0938\u0941\u0930\u0947\u0936\u094d\u0935\u0930 |\n\u092f\u0924\u094d\u092a\u0942\u091c\u093f\u0924\u0902 \u092e\u092f\u093e \u0926\u0947\u0935 \u092a\u0930\u093f\u092a\u0942\u0930\u094d\u0923\u0902 \u0924\u0926\u0938\u094d\u0924\u0941 \u0924\u0947 ||\n\n\u0915\u093e\u092f\u0947\u0928 \u0935\u093e\u091a\u093e \u092e\u0928\u0938\u0947\u0902\u0926\u094d\u0930\u093f\u092f\u0948\u0930\u094d\u0935\u093e \u092c\u0941\u0926\u094d\u0927\u094d\u092f\u093e\u0924\u094d\u092e\u0928\u093e \u0935\u093e \u092a\u094d\u0930\u0915\u0943\u0924\u0947\u0903 \u0938\u094d\u0935\u092d\u093e\u0935\u093e\u0924\u094d |\n\u0915\u0930\u094b\u092e\u093f \u092f\u0926\u094d\u092f\u0924\u094d\u0938\u0915\u0932\u0902 \u092a\u0930\u0938\u094d\u092e\u0948 \u0928\u093e\u0930\u093e\u092f\u0923\u093e\u092f\u0947\u0924\u093f \u0938\u092e\u0930\u094d\u092a\u092f\u093e\u092e\u093f ||\n\n\u0905\u092f\u094d\u092f\u092a\u094d\u092a \u0915\u094d\u0937\u092e\u093e\u092a\u094d\u0930\u093e\u0930\u094d\u0925\u0928 (\u0924\u0947\u0932\u0941\u0917\u0941\u0932\u094b)\n\n\u0905\u092f\u094d\u092f\u092a\u094d\u092a \u0938\u094d\u0935\u093e\u092e\u0940! \u0924\u0947\u0932\u093f\u0938\u093f \u0924\u0947\u0932\u093f\u092f\u0915 \u091a\u0947\u0938\u093f\u0928 \u0924\u092a\u094d\u092a\u0941\u0932\u0928\u0941, \u0935\u093e\u0915\u094d\u0915\u0941\u0932 \u0926\u094d\u0935\u093e\u0930\u093e \u092e\u0928\u0938\u094d\u0938\u0941 \u0926\u094d\u0935\u093e\u0930\u093e \u091a\u0947\u0938\u093f\u0928 \u0905\u092a\u0930\u093e\u0927\u093e\u0932\u0928\u0941 \u0915\u094d\u0937\u092e\u093f\u0902\u091a\u093f \u0928\u0928\u094d\u0928\u0941, \u0928\u093e \u0915\u0941\u091f\u0941\u0902\u092c\u093e\u0928\u094d\u0928\u093f \u0938\u0930\u094d\u0935\u0926\u093e \u0915\u093e\u092a\u093e\u0921\u0935\u0932\u0938\u093f\u0902\u0926\u093f\u0917\u093e \u0935\u0947\u0921\u0941\u0915\u094b\u0928\u0941\u091a\u0941\u0928\u094d\u0928\u093e\u0928\u0941. \u0928\u093e \u0926\u0947\u0939\u092e\u0947 \u0928\u0940 \u0906\u0932\u092f\u092e\u0941, \u0928\u093e \u092a\u094d\u0930\u093e\u0923\u092e\u0947 \u0928\u0940 \u0930\u0942\u092a\u092e\u0941. \u0928\u093e \u0938\u0930\u094d\u0935\u0938\u094d\u0935\u092e\u0941 \u0928\u0940\u0915\u0947 \u0938\u092e\u0930\u094d\u092a\u093f\u0902\u091a\u0941\u0915\u094b\u0928\u0941\u091a\u0941\u0928\u094d\u0928\u093e\u0928\u0941 \u0938\u094d\u0935\u093e\u092e\u0940.\n\n\u0936\u093e\u0902\u0924\u093f \u092e\u0902\u0924\u094d\u0930\u0902\n\n\u0913\u0902 \u0905\u0938\u0924\u094b\u092e\u093e \u0938\u0926\u094d\u0917\u092e\u092f |\n\u0924\u092e\u0938\u094b\u092e\u093e \u091c\u094d\u092f\u094b\u0924\u093f\u0930\u094d\u0917\u092e\u092f |\n\u092e\u0943\u0924\u094d\u092f\u094b\u0930\u094d\u092e\u093e \u0905\u092e\u0943\u0924\u0902\u0917\u092e\u092f ||\n\u0913\u0902 \u0936\u093e\u0902\u0924\u093f\u0903 \u0936\u093e\u0902\u0924\u093f\u0903 \u0936\u093e\u0902\u0924\u093f\u0903 ||\n\n\u0913\u0902 \u0936\u094d\u0930\u0940 \u092e\u0939\u093e\u0917\u0923\u093e\u0927\u093f\u092a\u0924\u093f, \u0935\u0932\u094d\u0932\u0940 \u0926\u0947\u0935\u0938\u0947\u0928 \u0938\u092e\u0947\u0924 \u0938\u0941\u092c\u094d\u0930\u092e\u0923\u094d\u092f \u0938\u094d\u0935\u093e\u092e\u093f, \u0939\u0930\u093f\u0939\u0930 \u092a\u0941\u0924\u094d\u0930 \u0905\u092f\u094d\u092f\u092a\u094d\u092a \u0938\u094d\u0935\u093e\u092e\u093f \u0938\u0941\u092a\u094d\u0930\u0940\u0924\u094b \u0938\u0941\u092a\u094d\u0930\u0938\u0928\u094d\u0928\u094b \u0935\u0930\u0926\u094b \u092d\u0935\u0924\u0941 ||\n\u0936\u094d\u0930\u0940\u0930\u0938\u094d\u0924\u0941, \u0936\u0941\u092d\u092e\u0938\u094d\u0924\u0941, \u0905\u0935\u093f\u0918\u094d\u0928\u092e\u0938\u094d\u0924\u0941.",isAudio:!1,audioDurationSec:40,totalTime:"00:40"},{id:"8",slug:"slogans-of-sri-ayyappa-swami",title:"\u0938\u094d\u0924\u094b\u0924\u094d\u0930 \u0938\u0902\u0917\u094d\u0930\u0939",description:"\u0938\u094d\u0935\u093e\u092e\u093f \u0936\u0930\u0923\u0902 \u2013 \u0905\u092f\u094d\u092f\u092a\u094d\u092a \u0936\u0930\u0923\u0902\n    \u092d\u0917\u0935\u093e\u0928\u094d \u0936\u0930\u0923\u0902 \u2013 \u092d\u0917\u0935\u0924\u093f \u0936\u0930\u0923\u0902\n    \u0926\u0947\u0935\u0928\u094d \u0936\u0930\u0923\u0902 \u2013 \u0926\u0947\u0935\u0940 \u0936\u0930\u0923\u0902\n    \u0926\u0947\u0935\u0928\u094d \u092a\u093e\u0926\u0902 \u2013 \u0926\u0947\u0935\u0940 \u092a\u093e\u0926\u0902\n    \u0938\u094d\u0935\u093e\u092e\u093f \u092a\u093e\u0926\u0902 \u2013 \u0905\u092f\u094d\u092f\u092a\u094d\u092a \u092a\u093e\u0926\u0902\n    \u092d\u0917\u0935\u093e\u0928\u0947 \u2013 \u092d\u0917\u0935\u0924\u093f\u092f\u0947\n    \u0908\u0936\u094d\u0935\u0930\u0928\u0947 \u2013 \u0908\u0936\u094d\u0935\u0930\u093f\u092f\u0947\n    \u0926\u0947\u0935\u0928\u0947 \u2013 \u0926\u0947\u0935\u093f\u092f\u0947\n    \u0936\u0915\u094d\u0924\u0928\u0947 \u2013 \u0936\u0915\u094d\u0924\u093f\u092f\u0947\n    \u0938\u094d\u0935\u093e\u092e\u093f\u092f\u0947 \u2013 \u0905\u092f\u094d\u092f\u092a\u094d\u092a\u094b\n    \u092a\u0932\u094d\u0932\u093f\u0915\u091f\u094d\u091f\u0941 \u2013 \u0936\u092c\u0930\u093f\u092e\u0932\u0948\u0915\u094d\u0915\u0941\n    \u0907\u0930\u0941\u092e\u0941\u0921\u093f\u0915\u091f\u094d\u091f\u0941 \u2013 \u0936\u092c\u0930\u093f\u092e\u0932\u0948\u0915\u094d\u0915\u0941\n    \u0915\u091f\u094d\u091f\u0941\u0902\u0915\u091f\u094d\u091f\u0941 \u2013 \u0936\u092c\u0930\u093f\u092e\u0932\u0948\u0915\u094d\u0915\u0941\n    \u0915\u0932\u094d\u0932\u0941\u092e\u094d\u092e\u0941\u0932\u094d\u0932\u0941\u0902 \u2013 \u0915\u093e\u0932\u093f\u0915\u0940\u092e\u0947\u0924\u094d\u0924\u0948\n    \u090f\u0924\u094d\u0924\u093f\u0935\u093f\u0921\u092f\u094d\u092f \u2013 \u0924\u0942\u0915\u094d\u0915\u093f\u0915\u094d\u0915\u0935\u093f\u0921\u092f\u094d\u092f\n    \u0926\u0947\u0939\u092c\u0932\u0902\u0926\u093e \u2013 \u092a\u093e\u0926\u092c\u0932\u0902\u0926\u093e\n    \u092f\u093e\u0930\u0948\u0915\u094d\u0915\u093e\u0923 \u2013 \u0938\u094d\u0935\u093e\u092e\u093f\u092f\u0948\u0915\u094d\u0915\u093e\u0923\n    \u0938\u094d\u0935\u093e\u092e\u093f\u092f\u0948\u0915\u094d\u0915\u0902\u0921\u093e \u2013 \u092e\u094b\u0915\u094d\u0937\u0902\u0915\u093f\u091f\u094d\u091f\u0941\u0902\n    \u0938\u094d\u0935\u093e\u092e\u093f\u092e\u093e\u0930\u0947 \u2013 \u0905\u092f\u094d\u092f\u092a\u094d\u092a\u092e\u093e\u0930\u0947\n    \u0928\u0947\u092f\u094d\u092f\u093e\u092d\u093f\u0937\u0947\u0915\u0902 \u2013 \u0938\u094d\u0935\u093e\u092e\u093f\u0915\u094d\u0915\u0947\n    \u0915\u0930\u094d\u092a\u0942\u0930\u0926\u0940\u092a\u0902 \u2013 \u0938\u094d\u0935\u093e\u092e\u093f\u0915\u094d\u0915\u0947\n    \u092a\u093e\u0932\u093e\u092d\u093f\u0937\u0947\u0915\u0902 \u2013 \u0938\u094d\u0935\u093e\u092e\u093f\u0915\u094d\u0915\u0947\n    \u092d\u0938\u094d\u092e\u093e\u092d\u093f\u0937\u0947\u0915\u0902 \u2013 \u0938\u094d\u0935\u093e\u092e\u093f\u0915\u094d\u0915\u0947\n    \u0924\u0947\u0928\u093e\u092d\u093f\u0937\u0947\u0915\u0902 \u2013 \u0938\u094d\u0935\u093e\u092e\u093f\u0915\u094d\u0915\u0947\n    \u091a\u0902\u0926\u0928\u093e\u092d\u093f\u0937\u0947\u0915\u0902 \u2013 \u0938\u094d\u0935\u093e\u092e\u093f\u0915\u094d\u0915\u0947\n    \u092a\u0942\u0932\u093e\u092d\u093f\u0937\u0947\u0915\u0902 \u2013 \u0938\u094d\u0935\u093e\u092e\u093f\u0915\u094d\u0915\u0947\n    \u092a\u0928\u094d\u0928\u0940\u0930\u093e\u092d\u093f\u0937\u0947\u0915\u0902 \u2013 \u0938\u094d\u0935\u093e\u092e\u093f\u0915\u094d\u0915\u0947\n    \u092a\u0902\u092c\u093e\u0936\u093f\u0936\u0941\u0935\u0947 \u2013 \u0905\u092f\u094d\u092f\u092a\u094d\u092a\u093e\n    \u0915\u093e\u0928\u0928\u0935\u093e\u0938\u093e \u2013 \u0905\u092f\u094d\u092f\u092a\u094d\u092a\u093e\n    \u0936\u092c\u0930\u093f\u0917\u093f\u0930\u0940\u0936\u093e \u2013 \u0905\u092f\u094d\u092f\u092a\u094d\u092a\u093e\n    \u092a\u0902\u0926\u0932\u0930\u093e\u091c\u093e \u2013 \u0905\u092f\u094d\u092f\u092a\u094d\u092a\u093e\n    \u092a\u0902\u092c\u093e\u0935\u093e\u0938\u093e \u2013 \u0905\u092f\u094d\u092f\u092a\u094d\u092a\u093e\n    \u0935\u0928\u094d\u092a\u0941\u0932\u093f\u0935\u093e\u0939\u0928 \u2013 \u0905\u092f\u094d\u092f\u092a\u094d\u092a\u093e\n    \u0938\u0941\u0902\u0926\u0930\u0930\u0942\u092a\u093e \u2013 \u0905\u092f\u094d\u092f\u092a\u094d\u092a\u093e\n    \u0937\u0923\u094d\u092e\u0941\u0916\u0938\u094b\u0926\u0930 \u2013 \u0905\u092f\u094d\u092f\u092a\u094d\u092a\u093e\n    \u092e\u094b\u0939\u093f\u0928\u0940\u0924\u0928\u092f\u093e \u2013 \u0905\u092f\u094d\u092f\u092a\u094d\u092a\u093e\n    \u0917\u0923\u0947\u0936\u0938\u094b\u0926\u0930 \u2013 \u0905\u092f\u094d\u092f\u092a\u094d\u092a\u093e\n    \u0939\u0930\u093f\u0939\u0930\u0924\u0928\u092f\u093e \u2013 \u0905\u092f\u094d\u092f\u092a\u094d\u092a\u093e\n    \u0905\u0928\u093e\u0925\u0930\u0915\u094d\u0937\u0915 \u2013 \u0905\u092f\u094d\u092f\u092a\u094d\u092a\u093e\n    \u0938\u0926\u094d\u0917\u0941\u0930\u0941\u0928\u093e\u0925\u093e \u2013 \u0905\u092f\u094d\u092f\u092a\u094d\u092a\u093e\n    \u0938\u094d\u0935\u093e\u092e\u093f\u092f\u0947 \u2013 \u0905\u092f\u094d\u092f\u092a\u094d\u092a\u094b\n    \u0905\u092f\u094d\u092f\u092a\u094d\u092a\u094b \u2013 \u0938\u094d\u0935\u093e\u092e\u093f\u092f\u0947\n    \u0938\u094d\u0935\u093e\u092e\u093f \u0936\u0930\u0923\u0902 \u2013 \u0905\u092f\u094d\u092f\u092a\u094d\u092a \u0936\u0930\u0923\u0902",isAudio:!1,audioDurationSec:40,totalTime:"00:40"},{id:"9",slug:"pooja-poorvaangamu",title:"\u092a\u0942\u091c\u093e \u092a\u0942\u0930\u094d\u0935\u093e\u0902\u0917",description:"[ \u092a\u0942\u091c\u093e \u092a\u0942\u0930\u094d\u0935\u093e\u0902\u0917\u092e\u0941 - \u092a\u094d\u0930\u093e\u0930\u0902\u092d \u092a\u094d\u0930\u093e\u0930\u094d\u0925\u0928 ]\n    \n    \u090f \u092a\u0942\u091c \u092a\u094d\u0930\u093e\u0930\u0902\u092d\u093f\u0902\u091a\u0947 \u092e\u0941\u0902\u0926\u0948\u0928\u093e \u092a\u0942\u0930\u094d\u0935\u093e\u0902\u0917 \u092a\u0942\u091c\u0928\u0941 \u0935\u093f\u0927\u093f\u0917\u093e \u0906\u091a\u0930\u093f\u0902\u091a\u0935\u0932\u0947\u0928\u0941.\n    \n    [ 1. \u0906\u091a\u092e\u094d\u092f ]\n    \u0913\u0902 \u0915\u0947\u0936\u0935\u093e\u092f \u0938\u094d\u0935\u093e\u0939\u093e (\u0924\u0940\u0930\u094d\u0925\u0902 \u0938\u094d\u0935\u0940\u0915\u0930\u093f\u0902\u091a\u0935\u0932\u0947\u0928\u0941)\n    \u0913\u0902 \u0928\u093e\u0930\u093e\u092f\u0923\u093e\u092f \u0938\u094d\u0935\u093e\u0939\u093e (\u0924\u0940\u0930\u094d\u0925\u0902 \u0938\u094d\u0935\u0940\u0915\u0930\u093f\u0902\u091a\u0935\u0932\u0947\u0928\u0941)\n    \u0913\u0902 \u092e\u093e\u0927\u0935\u093e\u092f \u0938\u094d\u0935\u093e\u0939\u093e (\u0924\u0940\u0930\u094d\u0925\u0902 \u0938\u094d\u0935\u0940\u0915\u0930\u093f\u0902\u091a\u0935\u0932\u0947\u0928\u0941)\n    \u0913\u0902 \u0917\u094b\u0935\u093f\u0902\u0926\u093e\u092f \u0928\u092e\u0903 (\u091a\u0947\u0924\u0941\u0932\u0941 \u0915\u0921\u0941\u0915\u094d\u0915\u094b\u0935\u0932\u0947\u0928\u0941)\n    \u0913\u0902 \u0935\u093f\u0937\u094d\u0923\u0935\u0947 \u0928\u092e\u0903\n    \u0913\u0902 \u092e\u0927\u0941\u0938\u0942\u0926\u0928\u093e\u092f \u0928\u092e\u0903\n    \u0913\u0902 \u0924\u094d\u0930\u093f\u0935\u093f\u0915\u094d\u0930\u092e\u093e\u092f \u0928\u092e\u0903\n    \u0913\u0902 \u0935\u093e\u092e\u0928\u093e\u092f \u0928\u092e\u0903\n    \u0913\u0902 \u0936\u094d\u0930\u0940\u0927\u0930\u093e\u092f \u0928\u092e\u0903\n    \u0913\u0902 \u0939\u0943\u0937\u0940\u0915\u0947\u0936\u093e\u092f \u0928\u092e\u0903\n    \u0913\u0902 \u092a\u0926\u094d\u092e\u0928\u093e\u092d\u093e\u092f \u0928\u092e\u0903\n    \u0913\u0902 \u0926\u093e\u092e\u094b\u0926\u0930\u093e\u092f \u0928\u092e\u0903\n    \n    [ 2. \u092a\u094d\u0930\u093e\u0923\u093e\u092f\u093e\u092e\u0903 ]\n    \u0913\u0902 \u092d\u0942\u0903 \u0913\u0902 \u092d\u0941\u0935\u0903 \u0913\u0902 \u0938\u0941\u0935\u0903 \u0913\u0902 \u092e\u0939\u0903 \u0913\u0902 \u091c\u0928\u0903 \u0913\u0902 \u0924\u092a\u0903 \u0913\u0917\u094d\u0902 \u0938\u0924\u094d\u092f\u092e\u094d\n    \u0913\u0902 \u0924\u0924\u094d\u0938\u0935\u093f\u0924\u0941\u0930\u094d\u0935\u0930\u0947\u0923\u094d\u092f\u0902 \u092d\u0930\u094d\u0917\u094b \u0926\u0947\u0935\u0938\u094d\u092f \u0927\u0940\u092e\u0939\u093f \u0927\u093f\u092f\u094b \u092f\u094b \u0928\u0903 \u092a\u094d\u0930\u091a\u094b\u0926\u092f\u093e\u0924\u094d\n    \u0913\u092e\u093e\u092a\u094b \u091c\u094d\u092f\u094b\u0924\u0940\u0930\u0938\u094b\u092e\u0943\u0924\u0902 \u092c\u094d\u0930\u0939\u094d\u092e \u092d\u0942\u0930\u094d\u092d\u0941\u0935\u0938\u094d\u0938\u0941\u0935\u0930\u094b\u092e\u094d\n    \n    [ 3. \u0938\u0902\u0915\u0932\u094d\u092a\u0903 ]\n    \u092e\u092e \u0909\u092a\u093e\u0924\u094d\u0924 \u0938\u092e\u0938\u094d\u0924 \u0926\u0941\u0930\u093f\u0924\u0915\u094d\u0937\u092f\u0926\u094d\u0935\u093e\u0930\u093e \u0936\u094d\u0930\u0940 \u092a\u0930\u092e\u0947\u0936\u094d\u0935\u0930/\u0936\u094d\u0930\u0940 \u0905\u092f\u094d\u092f\u092a\u094d\u092a \u0938\u094d\u0935\u093e\u092e\u093f \u092a\u094d\u0930\u0940\u0924\u094d\u092f\u0930\u094d\u0925\u0902 \u0936\u0941\u092d\u0947 \u0936\u094b\u092d\u0928\u0947 \u092e\u0941\u0939\u0942\u0930\u094d\u0924\u0947 \u0936\u094d\u0930\u0940 \u092e\u0939\u093e\u0917\u093e\u0923\u093e\u0927\u093f\u092a\u0924\u093f \u092a\u0942\u091c\u093e\u0902, \u0936\u094d\u0930\u0940 \u0905\u092f\u094d\u092f\u092a\u094d\u092a \u0938\u094d\u0935\u093e\u092e\u093f \u092a\u0942\u091c\u093e\u0902 \u091a \u0915\u0930\u093f\u0937\u094d\u092f\u0947.\n    \n    [ 4. \u0915\u0932\u0936 \u092a\u0942\u091c ]\n    \u0915\u0932\u0936\u0938\u094d\u092f \u092e\u0941\u0916\u0947 \u0935\u093f\u0937\u094d\u0923\u0941\u0903 \u0915\u0902\u0920\u0947 \u0930\u0941\u0926\u094d\u0930\u0903 \u0938\u092e\u093e\u0936\u094d\u0930\u093f\u0924\u0903\n    \u092e\u0942\u0932\u0947 \u0924\u0924\u094d\u0930 \u0938\u094d\u0925\u093f\u0924\u094b \u092c\u094d\u0930\u0939\u094d\u092e\u093e \u092e\u0927\u094d\u092f\u0947 \u092e\u093e\u0924\u0943\u0917\u0923\u093e\u0903 \u0938\u094d\u092e\u0943\u0924\u093e\u0903\n    \n    \u0917\u0902\u0917\u0947 \u091a \u092f\u092e\u0941\u0928\u0947 \u091a\u0948\u0935 \u0917\u094b\u0926\u093e\u0935\u0930\u093f \u0938\u0930\u0938\u094d\u0935\u0924\u0940\n    \u0928\u0930\u094d\u092e\u0926\u0947 \u0938\u093f\u0902\u0927\u0941 \u0915\u093e\u0935\u0947\u0930\u0940 \u091c\u0932\u0947\u0938\u094d\u092e\u093f\u0928\u094d \u0938\u0928\u094d\u0928\u093f\u0927\u093f\u0902 \u0915\u0941\u0930\u0941\n    \n    \u0913\u0902 \u0936\u094d\u0930\u0940 \u0938\u094d\u0935\u093e\u092e\u093f\u092f\u0947 \u0936\u0930\u0923\u0902 \u0905\u092f\u094d\u092f\u092a\u094d\u092a!",isAudio:!1,audioDurationSec:40,totalTime:"00:40"},{id:"10",slug:"sri-vigneshwara-ashtottara",title:"\u0936\u094d\u0930\u0940 \u092e\u0939\u093e\u0917\u0923\u092a\u0924\u093f",description:"[ \u0936\u094d\u0930\u0940 \u0935\u093f\u0918\u094d\u0928\u0947\u0936\u094d\u0935\u0930 \u0905\u0902\u0917\u092a\u0942\u091c ]\n    \u0913\u0902 \u092a\u093e\u0930\u094d\u0935\u0924\u0940 \u0928\u0902\u0926\u0928\u093e\u092f \u0928\u092e\u0903 - \u092a\u093e\u0926\u094c \u092a\u0942\u091c\u092f\u093e\u092e\u093f\n    \u0913\u0902 \u0936\u094d\u0930\u0940 \u0917\u0923\u0947\u0936\u093e\u092f \u0928\u092e\u0903 - \u0917\u0941\u0932\u094d\u092b\u094c \u092a\u0942\u091c\u092f\u093e\u092e\u093f\n    \u0913\u0902 \u091c\u094d\u092f\u094b\u0924\u093f\u0930\u094d\u0927\u093e\u0924\u094d\u0930\u0947 \u0928\u092e\u0903 - \u091c\u0902\u0918\u0947 \u092a\u0942\u091c\u092f\u093e\u092e\u093f\n    \u0913\u0902 \u091c\u0917\u0926\u094d\u0935\u0932\u094d\u0932\u092d\u093e\u092f \u0928\u092e\u0903 - \u090a\u0930\u0942 \u092a\u0942\u091c\u092f\u093e\u092e\u093f\n    \u0913\u0902 \u0935\u093f\u0915\u091f\u093e\u092f \u0928\u092e\u0903 - \u0915\u091f\u093f\u0902 \u092a\u0942\u091c\u092f\u093e\u092e\u093f\n    \u0913\u0902 \u0917\u0941\u0939\u093e\u0917\u094d\u0930\u091c\u093e\u092f \u0928\u092e\u0903 - \u0917\u0941\u0939\u094d\u092f\u0902 \u092a\u0942\u091c\u092f\u093e\u092e\u093f\n    \u0913\u0902 \u092e\u0939\u094b\u0924\u094d\u0924\u092e\u093e\u092f \u0928\u092e\u0903 - \u092e\u0947\u0922\u094d\u0930\u0902 \u092a\u0942\u091c\u092f\u093e\u092e\u093f\n    \u0913\u0902 \u0917\u0923\u0928\u093e\u0925\u093e\u092f \u0928\u092e\u0903 - \u0928\u093e\u092d\u093f\u0902 \u092a\u0942\u091c\u092f\u093e\u092e\u093f\n    \u0913\u0902 \u0909\u0924\u094d\u0924\u092e\u093e\u092f \u0928\u092e\u0903 - \u0909\u0926\u0930\u0902 \u092a\u0942\u091c\u092f\u093e\u092e\u093f\n    \u0913\u0902 \u0935\u093f\u0928\u093e\u092f\u0915\u093e\u092f \u0928\u092e\u0903 - \u0935\u0915\u094d\u0937\u0938\u094d\u0925\u0932\u0902 \u092a\u0942\u091c\u092f\u093e\u092e\u093f\n    \u0913\u0902 \u092a\u093e\u0936\u091a\u094d\u091b\u093f\u0926\u0947 \u0928\u092e\u0903 - \u092a\u093e\u0930\u094d\u0936\u094d\u0935\u0947 \u092a\u0942\u091c\u092f\u093e\u092e\u093f\n    \u0913\u0902 \u0939\u0947\u0930\u0902\u092d\u093e\u092f \u0928\u092e\u0903 - \u0939\u0943\u0926\u092f\u0902 \u092a\u0942\u091c\u092f\u093e\u092e\u093f\n    \u0913\u0902 \u0915\u092a\u093f\u0932\u093e\u092f \u0928\u092e\u0903 - \u0915\u0902\u0920\u0902 \u092a\u0942\u091c\u092f\u093e\u092e\u093f\n    \u0913\u0902 \u0938\u094d\u0915\u0902\u0927\u093e\u0917\u094d\u0930\u091c\u093e\u092f \u0928\u092e\u0903 - \u0938\u094d\u0915\u0902\u0927\u094c \u092a\u0942\u091c\u092f\u093e\u092e\u093f\n    \u0913\u0902 \u0939\u0930\u0938\u0941\u0924\u093e\u092f \u0928\u092e\u0903 - \u0939\u0938\u094d\u0924\u093e\u0928\u094d \u092a\u0942\u091c\u092f\u093e\u092e\u093f\n    \u0913\u0902 \u092c\u094d\u0930\u0939\u094d\u092e\u091a\u093e\u0930\u093f\u0923\u0947 \u0928\u092e\u0903 - \u092c\u093e\u0939\u0942\u0928\u094d \u092a\u0942\u091c\u092f\u093e\u092e\u093f\n    \u0913\u0902 \u0938\u0941\u092e\u0941\u0916\u093e\u092f \u0928\u092e\u0903 - \u092e\u0941\u0916\u0902 \u092a\u0942\u091c\u092f\u093e\u092e\u093f\n    \u0913\u0902 \u090f\u0915\u0926\u0902\u0924\u093e\u092f \u0928\u092e\u0903 - \u0926\u0902\u0924\u094c \u092a\u0942\u091c\u092f\u093e\u092e\u093f\n    \u0913\u0902 \u0935\u093f\u0918\u094d\u0928\u0939\u0902\u0924\u094d\u0930\u0947 \u0928\u092e\u0903 - \u0928\u0947\u0924\u094d\u0930\u0947 \u092a\u0942\u091c\u092f\u093e\u092e\u093f\n    \u0913\u0902 \u0936\u0942\u0930\u094d\u092a\u0915\u0930\u094d\u0923\u093e\u092f \u0928\u092e\u0903 - \u0915\u0930\u094d\u0923\u094c \u092a\u0942\u091c\u092f\u093e\u092e\u093f\n    \u0913\u0902 \u092b\u093e\u0932\u091a\u0902\u0926\u094d\u0930\u093e\u092f \u0928\u092e\u0903 - \u0915\u092a\u093e\u0932\u0902 \u092a\u0942\u091c\u092f\u093e\u092e\u093f\n    \u0913\u0902 \u0928\u093e\u0917\u092d\u0930\u0923\u093e\u092f \u0928\u092e\u0903 - \u0928\u093e\u0938\u093f\u0915\u093e\u0902 \u092a\u0942\u091c\u092f\u093e\u092e\u093f\n    \u0913\u0902 \u091a\u093f\u0930\u0902\u0924\u0928\u093e\u092f \u0928\u092e\u0903 - \u091a\u0941\u092c\u0941\u0915\u0902 \u092a\u0942\u091c\u092f\u093e\u092e\u093f\n    \u0913\u0902 \u0938\u094d\u0925\u0942\u0932\u094b\u0937\u094d\u0920\u093e\u092f \u0928\u092e\u0903 - \u0913\u0937\u094d\u0920\u094c \u092a\u0942\u091c\u092f\u093e\u092e\u093f\n    \u0913\u0902 \u0915\u093e\u0932\u0916\u0902\u0921\u093e\u092f \u0928\u092e\u0903 - \u0915\u0902\u0920\u094c \u092a\u0942\u091c\u092f\u093e\u092e\u093f\n    \u0913\u0902 \u0915\u092a\u093f\u0932\u093e\u092f \u0928\u092e\u0903 - \u0915\u091a\u093e\u0928\u094d \u092a\u0942\u091c\u092f\u093e\u092e\u093f\n    \u0913\u0902 \u0936\u093f\u0935\u092a\u094d\u0930\u093f\u092f\u093e\u092f \u0928\u092e\u0903 - \u0936\u093f\u0930\u0903 \u092a\u0942\u091c\u092f\u093e\u092e\u093f\n    \u0913\u0902 \u0938\u0930\u094d\u0935\u092e\u0902\u0917\u0933\u093e \u0938\u0941\u0924\u093e\u092f \u0928\u092e\u0903 - \u0938\u0930\u094d\u0935\u093e\u0923\u094d\u092f\u0902\u0917\u093e\u0928\u093f \u092a\u0942\u091c\u092f\u093e\u092e\u093f\n    \n    [ \u0936\u094d\u0930\u0940 \u0935\u093f\u0918\u094d\u0928\u0947\u0936\u094d\u0935\u0930 \u0905\u0937\u094d\u091f\u094b\u0924\u094d\u0924\u0930 \u0936\u0924 \u0928\u093e\u092e\u093e\u0935\u0933\u093f ]\n    \u0913\u0902 \u0935\u093f\u0928\u093e\u092f\u0915\u093e\u092f \u0928\u092e\u0903\n    \u0913\u0902 \u0935\u093f\u0918\u094d\u0928\u0930\u093e\u091c\u093e\u092f \u0928\u092e\u0903\n    \u0913\u0902 \u0917\u094c\u0930\u0940\u092a\u0941\u0924\u094d\u0930\u093e\u092f \u0928\u092e\u0903\n    \u0913\u0902 \u0917\u0923\u0947\u0936\u094d\u0935\u0930\u093e\u092f \u0928\u092e\u0903\n    \u0913\u0902 \u0938\u094d\u0915\u0902\u0926\u093e\u0917\u094d\u0930\u091c\u093e\u092f \u0928\u092e\u0903\n    \u0913\u0902 \u0905\u0935\u094d\u092f\u092f\u093e\u092f \u0928\u092e\u0903\n    \u0913\u0902 \u092a\u0942\u0937\u093e\u092f \u0928\u092e\u0903\n    \u0913\u0902 \u0926\u0915\u094d\u0937\u093e\u092f \u0928\u092e\u0903\n    \u0913\u0902 \u0905\u0927\u094d\u092f\u0915\u094d\u0937\u093e\u092f \u0928\u092e\u0903\n    \u0913\u0902 \u0926\u094d\u0935\u093f\u091c\u092a\u094d\u0930\u093f\u092f\u093e\u092f \u0928\u092e\u0903\n    \u0913\u0902 \u0905\u0917\u094d\u0928\u093f\u0917\u0930\u094d\u092d\u091a\u094d\u091b\u093f\u0926\u0947 \u0928\u092e\u0903\n    \u0913\u0902 \u0907\u0902\u0926\u094d\u0930\u0936\u094d\u0930\u0940\u092a\u094d\u0930\u0926\u093e\u092f \u0928\u092e\u0903\n    \u0913\u0902 \u0935\u093e\u0923\u0940\u092a\u094d\u0930\u0926\u093e\u092f \u0928\u092e\u0903\n    \u0913\u0902 \u0905\u0935\u094d\u092f\u092f\u093e\u092f \u0928\u092e\u0903\n    \u0913\u0902 \u0938\u0930\u094d\u0935\u0938\u093f\u0926\u094d\u0927\u093f\u092a\u094d\u0930\u0926\u093e\u092f \u0928\u092e\u0903\n    \u0913\u0902 \u0936\u0930\u094d\u0935\u0924\u0928\u092f\u093e\u092f \u0928\u092e\u0903\n    \u0913\u0902 \u0936\u0930\u094d\u0935\u0930\u0940\u092a\u094d\u0930\u093f\u092f\u093e\u092f \u0928\u092e\u0903\n    \u0913\u0902 \u0938\u0930\u094d\u0935\u093e\u0924\u094d\u092e\u0915\u093e\u092f \u0928\u092e\u0903\n    \u0913\u0902 \u0938\u0943\u0937\u094d\u091f\u093f\u0915\u0930\u094d\u0924\u094d\u0930