a",title:"\u0c36\u0c4d\u0c30\u0c40 \u0c17\u0c4b\u0c2e\u0c3e\u0c24 \u0c2a\u0c42\u0c1c",description:"[ \u0c36\u0c4d\u0c30\u0c40 \u0c17\u0c4b\u0c2e\u0c3e\u0c24 \u0c2a\u0c42\u0c1c - \u0c15\u0c3e\u0c2e\u0c27\u0c47\u0c28\u0c41 \u0c2a\u0c42\u0c1c\u0c3e \u0c35\u0c3f\u0c27\u0c3e\u0c28\u0c02 ]\n    \n    \u0c17\u0c4b\u0c35\u0c41 \u0c38\u0c2e\u0c38\u0c4d\u0c24 \u0c2e\u0c41\u0c15\u0c4d\u0c15\u0c4b\u0c1f\u0c3f \u0c26\u0c47\u0c35\u0c24\u0c32 \u0c28\u0c3f\u0c32\u0c2f\u0c2e\u0c41. \u0c17\u0c4b\u0c2e\u0c3e\u0c24\u0c28\u0c41 \u0c2a\u0c42\u0c1c\u0c3f\u0c02\u0c1a\u0c3f\u0c28 \u0c38\u0c30\u0c4d\u0c35 \u0c26\u0c47\u0c35\u0c24\u0c32\u0c28\u0c41 \u0c2a\u0c42\u0c1c\u0c3f\u0c02\u0c1a\u0c3f\u0c28 \u0c2b\u0c32\u0c02 \u0c32\u0c2d\u0c3f\u0c38\u0c4d\u0c24\u0c41\u0c02\u0c26\u0c3f.\n    \n    [ \u0c2a\u0c4d\u0c30\u0c3e\u0c30\u0c4d\u0c25\u0c28 ]\n    \u0c32\u0c15\u0c4d\u0c37\u0c4d\u0c2e\u0c40\u0c30\u0c4d\u0c2f\u0c3e \u0c32\u0c4b\u0c15\u0c2a\u0c3e\u0c32\u0c3e\u0c28\u0c3e\u0c02 \u0c27\u0c47\u0c28\u0c41\u0c30\u0c42\u0c2a\u0c47\u0c23 \u0c38\u0c02\u0c38\u0c4d\u0c25\u0c3f\u0c24\u0c3e\n    \u0c17\u0c41\u0c39\u0c3e\u0c24\u0c41 \u0c26\u0c3f\u0c35\u0c4d\u0c2f\u0c3e\u0c39\u0c3e\u0c30\u0c3e\u0c30\u0c4d\u0c25\u0c02 \u0c2f\u0c1c\u0c4d\u0c1e\u0c3e\u0c2f \u0c30\u0c15\u0c4d\u0c37\u0c3f\u0c24\u0c3e \u0c2e\u0c2f\u0c3e\n    \n    \u0c38\u0c30\u0c4d\u0c35\u0c26\u0c47\u0c35\u0c2e\u0c2f\u0c47 \u0c26\u0c47\u0c35\u0c3f \u0c38\u0c30\u0c4d\u0c35\u0c24\u0c40\u0c30\u0c4d\u0c25\u0c40\u0c15\u0c43\u0c24\u0c3e\u0c38\u0c28\u0c47\n    \u0c2e\u0c3e\u0c24\u0c30\u0c4d\u0c2e\u0c2e\u0c3e\u0c2d\u0c3f\u0c32\u0c37\u0c3f\u0c24\u0c02 \u0c38\u0c2b\u0c32\u0c02 \u0c15\u0c41\u0c30\u0c41 \u0c28\u0c02\u0c26\u0c3f\u0c28\u0c3f\n    \n    [ \u0c17\u0c4b\u0c2e\u0c3e\u0c24 \u0c2a\u0c4d\u0c30\u0c26\u0c15\u0c4d\u0c37\u0c3f\u0c23 \u0c2e\u0c02\u0c24\u0c4d\u0c30\u0c02 ]\n    \u0c17\u0c3e\u0c35\u0c4b \u0c2d\u0c17\u0c4b \u0c17\u0c3e\u0c35 \u0c07\u0c02\u0c26\u0c4d\u0c30\u0c4b \u0c2e\u0c47 \u0c05\u0c1a\u0c4d\u0c1b\u0c3e\u0c28\u0c4d\u0c28 \u0c17\u0c3e\u0c35\u0c03 \u0c38\u0c4b\u0c2e\u0c38\u0c4d\u0c2f \u0c2a\u0c4d\u0c30\u0c25\u0c2e\u0c38\u0c4d\u0c2f \u0c2d\u0c15\u0c4d\u0c37\u0c03\n    \u0c17\u0c3e\u0c35\u0c38\u0c4d\u0c24\u0c3e \u0c05\u0c38\u0c4d\u0c2e\u0c3e\u0c15\u0c02 \u0c2a\u0c4d\u0c30\u0c25\u0c2e\u0c3e\u0c03 \u0c2a\u0c41\u0c28\u0c3e\u0c24\u0c41 \u0c17\u0c3e\u0c35\u0c4b \u0c35\u0c30\u0c4d\u0c27\u0c3e\u0c02\u0c24\u0c41 \u0c2d\u0c41\u0c35\u0c28\u0c47\u0c37\u0c41 \u0c28\u0c3f\u0c24\u0c4d\u0c2f\u0c2e\u0c4d\n    \n    [ \u0c2a\u0c42\u0c1c\u0c3e \u0c38\u0c2e\u0c30\u0c4d\u0c2a\u0c23 ]\n    \u0c13\u0c02 \u0c36\u0c4d\u0c30\u0c40 \u0c17\u0c4b\u0c2e\u0c3e\u0c24\u0c4d\u0c30\u0c47 \u0c28\u0c2e\u0c03 - \u0c27\u0c4d\u0c2f\u0c3e\u0c28\u0c02 \u0c38\u0c2e\u0c30\u0c4d\u0c2a\u0c2f\u0c3e\u0c2e\u0c3f\n    \u0c13\u0c02 \u0c36\u0c4d\u0c30\u0c40 \u0c15\u0c3e\u0c2e\u0c27\u0c47\u0c28\u0c35\u0c47 \u0c28\u0c2e\u0c03 - \u0c06\u0c38\u0c28\u0c02 \u0c38\u0c2e\u0c30\u0c4d\u0c2a\u0c2f\u0c3e\u0c2e\u0c3f\n    \u0c13\u0c02 \u0c36\u0c4d\u0c30\u0c40 \u0c38\u0c41\u0c30\u0c2d\u0c2f\u0c47 \u0c28\u0c2e\u0c03 - \u0c2a\u0c3e\u0c26\u0c4d\u0c2f\u0c02 \u0c38\u0c2e\u0c30\u0c4d\u0c2a\u0c2f\u0c3e\u0c2e\u0c3f\n    \u0c13\u0c02 \u0c36\u0c4d\u0c30\u0c40 \u0c38\u0c41\u0c36\u0c40\u0c32\u0c3e\u0c2f\u0c48 \u0c28\u0c2e\u0c03 - \u0c05\u0c30\u0c4d\u0c18\u0c4d\u0c2f\u0c02 \u0c38\u0c2e\u0c30\u0c4d\u0c2a\u0c2f\u0c3e\u0c2e\u0c3f\n    \u0c13\u0c02 \u0c36\u0c4d\u0c30\u0c40 \u0c2a\u0c35\u0c3f\u0c24\u0c4d\u0c30\u0c3e\u0c2f\u0c48 \u0c28\u0c2e\u0c03 - \u0c38\u0c4d\u0c28\u0c3e\u0c28\u0c02 \u0c38\u0c2e\u0c30\u0c4d\u0c2a\u0c2f\u0c3e\u0c2e\u0c3f\n    \u0c13\u0c02 \u0c36\u0c4d\u0c30\u0c40 \u0c1c\u0c17\u0c26\u0c4d\u0c27\u0c3e\u0c24\u0c4d\u0c30\u0c3f\u0c28\u0c4d\u0c2f\u0c48 \u0c28\u0c2e\u0c03 - \u0c35\u0c38\u0c4d\u0c24\u0c4d\u0c30\u0c02 \u0c38\u0c2e\u0c30\u0c4d\u0c2a\u0c2f\u0c3e\u0c2e\u0c3f\n    \u0c13\u0c02 \u0c36\u0c4d\u0c30\u0c40 \u0c38\u0c41\u0c17\u0c02\u0c27\u0c3e\u0c2f\u0c48 \u0c28\u0c2e\u0c03 - \u0c17\u0c02\u0c27\u0c02 \u0c38\u0c2e\u0c30\u0c4d\u0c2a\u0c2f\u0c3e\u0c2e\u0c3f\n    \u0c13\u0c02 \u0c36\u0c4d\u0c30\u0c40 \u0c15\u0c32\u0c4d\u0c2f\u0c3e\u0c23\u0c4d\u0c2f\u0c48 \u0c28\u0c2e\u0c03 - \u0c2a\u0c41\u0c37\u0c4d\u0c2a\u0c3e\u0c23\u0c3f \u0c38\u0c2e\u0c30\u0c4d\u0c2a\u0c2f\u0c3e\u0c2e\u0c3f\n    \u0c13\u0c02 \u0c36\u0c4d\u0c30\u0c40 \u0c2d\u0c3e\u0c17\u0c4d\u0c2f\u0c35\u0c24\u0c4d\u0c2f\u0c48 \u0c28\u0c2e\u0c03 - \u0c27\u0c42\u0c2a\u0c02 \u0c38\u0c2e\u0c30\u0c4d\u0c2a\u0c2f\u0c3e\u0c2e\u0c3f\n    \u0c13\u0c02 \u0c36\u0c4d\u0c30\u0c40 \u0c2a\u0c41\u0c23\u0c4d\u0c2f\u0c30\u0c42\u0c2a\u0c3e\u0c2f\u0c48 \u0c28\u0c2e\u0c03 - \u0c26\u0c40\u0c2a\u0c02 \u0c38\u0c2e\u0c30\u0c4d\u0c2a\u0c2f\u0c3e\u0c2e\u0c3f\n    \u0c13\u0c02 \u0c36\u0c4d\u0c30\u0c40 \u0c05\u0c2e\u0c43\u0c24\u0c35\u0c30\u0c4d\u0c37\u0c3f\u0c23\u0c4d\u0c2f\u0c48 \u0c28\u0c2e\u0c03 - \u0c28\u0c48\u0c35\u0c47\u0c26\u0c4d\u0c2f\u0c02 (\u0c17\u0c4d\u0c30\u0c3e\u0c38\u0c02/\u0c2a\u0c33\u0c4d\u0c33\u0c41) \u0c38\u0c2e\u0c30\u0c4d\u0c2a\u0c2f\u0c3e\u0c2e\u0c3f\n    \u0c13\u0c02 \u0c36\u0c4d\u0c30\u0c40 \u0c17\u0c4b\u0c2e\u0c3e\u0c24\u0c4d\u0c30\u0c47 \u0c28\u0c2e\u0c03 - \u0c06\u0c28\u0c02\u0c26 \u0c15\u0c30\u0c4d\u0c2a\u0c42\u0c30 \u0c28\u0c40\u0c30\u0c3e\u0c1c\u0c28\u0c02 \u0c38\u0c2e\u0c30\u0c4d\u0c2a\u0c2f\u0c3e\u0c2e\u0c3f\n    \n    \u0c17\u0c4b\u0c2e\u0c3e\u0c24\u0c3e\u0c2f\u0c48 \u0c28\u0c2e\u0c4b \u0c28\u0c2e\u0c03!",isAudio:!1,audioDurationSec:40,totalTime:"00:40"},{id:"15",slug:"ashtottaramulu",title:"\u0c05\u0c37\u0c4d\u0c1f\u0c4b\u0c24\u0c4d\u0c24\u0c30\u0c2e\u0c41\u0c32\u0c41",description:"[ \u0c05\u0c37\u0c4d\u0c1f\u0c4b\u0c24\u0c4d\u0c24\u0c30 \u0c36\u0c24 \u0c28\u0c3e\u0c2e\u0c3e\u0c35\u0c33\u0c41\u0c32\u0c41 - \u0c38\u0c2e\u0c17\u0c4d\u0c30 \u0c38\u0c02\u0c17\u0c4d\u0c30\u0c39\u0c02 ]\n    \n    \u0c05\u0c2f\u0c4d\u0c2f\u0c2a\u0c4d\u0c2a \u0c2a\u0c42\u0c1c\u0c3e \u0c35\u0c3f\u0c27\u0c3e\u0c28\u0c02\u0c32\u0c4b \u0c2e\u0c41\u0c16\u0c4d\u0c2f\u0c2e\u0c48\u0c28 \u0c2a\u0c02\u0c1a \u0c26\u0c47\u0c35\u0c24\u0c3e \u0c05\u0c37\u0c4d\u0c1f\u0c4b\u0c24\u0c4d\u0c24\u0c30 \u0c36\u0c24 \u0c28\u0c3e\u0c2e\u0c3e\u0c35\u0c33\u0c41\u0c32\u0c41:\n    \n    1. \u0c36\u0c4d\u0c30\u0c40 \u0c35\u0c3f\u0c18\u0c4d\u0c28\u0c47\u0c36\u0c4d\u0c35\u0c30 \u0c05\u0c37\u0c4d\u0c1f\u0c4b\u0c24\u0c4d\u0c24\u0c30 \u0c36\u0c24 \u0c28\u0c3e\u0c2e\u0c3e\u0c35\u0c33\u0c3f\u0c03 (\u0c13\u0c02 \u0c17\u0c1c\u0c3e\u0c28\u0c28\u0c3e\u0c2f \u0c28\u0c2e\u0c03...)\n    2. \u0c36\u0c4d\u0c30\u0c40 \u0c38\u0c41\u0c2c\u0c4d\u0c30\u0c39\u0c4d\u0c2e\u0c23\u0c4d\u0c2f \u0c05\u0c37\u0c4d\u0c1f\u0c4b\u0c24\u0c4d\u0c24\u0c30 \u0c36\u0c24 \u0c28\u0c3e\u0c2e\u0c3e\u0c35\u0c33\u0c3f\u0c03 (\u0c13\u0c02 \u0c38\u0c4d\u0c15\u0c02\u0c26\u0c3e\u0c2f \u0c28\u0c2e\u0c03...)\n    3. \u0c36\u0c4d\u0c30\u0c40 \u0c05\u0c2f\u0c4d\u0c2f\u0c2a\u0c4d\u0c2a \u0c38\u0c4d\u0c35\u0c3e\u0c2e\u0c3f \u0c05\u0c37\u0c4d\u0c1f\u0c4b\u0c24\u0c4d\u0c24\u0c30 \u0c36\u0c24 \u0c28\u0c3e\u0c2e\u0c3e\u0c35\u0c33\u0c3f\u0c03 (\u0c13\u0c02 \u0c2e\u0c39\u0c3e\u0c36\u0c3e\u0c38\u0c4d\u0c24\u0c4d\u0c30\u0c47 \u0c28\u0c2e\u0c03...)\n    4. \u0c36\u0c4d\u0c30\u0c40 \u0c2e\u0c3e\u0c33\u0c3f\u0c15\u0c3e\u0c2a\u0c41\u0c30\u0c24\u0c4d\u0c24\u0c2e\u0c4d\u0c2e \u0c05\u0c37\u0c4d\u0c1f\u0c4b\u0c24\u0c4d\u0c24\u0c30 \u0c36\u0c24 \u0c28\u0c3e\u0c2e\u0c3e\u0c35\u0c33\u0c3f\u0c03 (\u0c13\u0c02 \u0c2a\u0c4d\u0c30\u0c15\u0c43\u0c24\u0c3f\u0c30\u0c42\u0c2a\u0c3e\u0c2f\u0c48 \u0c28\u0c2e\u0c03...)\n    5. \u0c36\u0c4d\u0c30\u0c40 \u0c36\u0c3f\u0c35 \u0c05\u0c37\u0c4d\u0c1f\u0c4b\u0c24\u0c4d\u0c24\u0c30 \u0c36\u0c24 \u0c28\u0c3e\u0c2e\u0c3e\u0c35\u0c33\u0c3f\u0c03 (\u0c13\u0c02 \u0c36\u0c3f\u0c35\u0c3e\u0c2f \u0c28\u0c2e\u0c03...)\n    \n    \u0c2a\u0c4d\u0c30\u0c24\u0c3f\u0c30\u0c4b\u0c1c\u0c42 \u0c08 \u0c28\u0c3e\u0c2e\u0c2e\u0c41\u0c32\u0c28\u0c41 \u0c2a\u0c20\u0c3f\u0c02\u0c1a\u0c21\u0c02 \u0c35\u0c32\u0c28 \u0c38\u0c30\u0c4d\u0c35 \u0c15\u0c3e\u0c30\u0c4d\u0c2f\u0c2e\u0c41\u0c32\u0c41 \u0c38\u0c3f\u0c26\u0c4d\u0c27\u0c3f\u0c38\u0c4d\u0c24\u0c3e\u0c2f\u0c3f, \u0c06\u0c2a\u0c26\u0c32\u0c41 \u0c24\u0c4a\u0c32\u0c17\u0c3f\u0c2a\u0c4b\u0c24\u0c3e\u0c2f\u0c3f.