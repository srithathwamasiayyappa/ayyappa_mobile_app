ca1\u0cbf',ta:'\u0b85\u0bb4\u0bc8\u0b95\u0bcd\u0b95',hi:'\u0915\u0949\u0932 \u0915\u0930\u0947\u0902',ml:'\u0d35\u0d3f\u0d33\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d15'},watchLive:{en:'Watch Live Darshan',te:'\u0c2a\u0c4d\u0c30\u0c24\u0c4d\u0c2f\u0c15\u0c4d\u0c37 \u0c26\u0c30\u0c4d\u0c36\u0c28\u0c02 \u0c1a\u0c42\u0c21\u0c02\u0c21\u0c3f',kn:'\u0cb2\u0cc8\u0cb5\u0ccd \u0ca6\u0cb0\u0ccd\u0cb6\u0ca8 \u0cb5\u0cc0\u0c95\u0ccd\u0cb7\u0cbf\u0cb8\u0cbf',ta:'\u0ba8\u0bc7\u0bb0\u0bb2\u0bc8 \u0ba4\u0bb0\u0bbf\u0b9a\u0ba9\u0bae\u0bcd',hi:'\u0932\u093e\u0907\u0935 \u0926\u0930\u094d\u0936\u0928 \u0926\u0947\u0916\u0947\u0902',ml:'\u0d24\u0d24\u0d4d\u0d38\u0d2e\u0d2f \u0d26\u0d7c\u0d36\u0d28\u0d02'},confirmTimingsNotice:{en:'Please confirm timings with the temple before visiting.',te:'\u0c26\u0c30\u0c4d\u0c36\u0c28\u0c3e\u0c28\u0c3f\u0c15\u0c3f \u0c35\u0c46\u0c33\u0c4d\u0c32\u0c47 \u0c2e\u0c41\u0c02\u0c26\u0c41 \u0c06\u0c32\u0c2f \u0c05\u0c27\u0c3f\u0c15\u0c3e\u0c30\u0c41\u0c32\u0c24\u0c4b \u0c38\u0c2e\u0c2f\u0c3e\u0c32\u0c28\u0c41 \u0c28\u0c3f\u0c30\u0c4d\u0c27\u0c3e\u0c30\u0c3f\u0c02\u0c1a\u0c41\u0c15\u0c4b\u0c02\u0c21\u0c3f.',kn:'\u0cad\u0cc7\u0c9f\u0cbf \u0ca8\u0cc0\u0ca1\u0cc1\u0cb5 \u0cae\u0cc1\u0ca8\u0ccd\u0ca8 \u0ca6\u0cc7\u0cb5\u0cbe\u0cb2\u0caf\u0ca6 \u0c85\u0ca7\u0cbf\u0c95\u0cbe\u0cb0\u0cbf\u0c97\u0cb3\u0cca\u0c82\u0ca6\u0cbf\u0c97\u0cc6 \u0cb8\u0cae\u0caf\u0cb5\u0ca8\u0ccd\u0ca8\u0cc1 \u0ca6\u0cc3\u0ca2\u0cc0\u0c95\u0cb0\u0cbf\u0cb8\u0cbf.',ta:'\u0b9a\u0bc6\u0bb2\u0bcd\u0bb2\u0bc1\u0bae\u0bcd \u0bae\u0bc1\u0ba9\u0bcd \u0b95\u0bcb\u0baf\u0bbf\u0bb2\u0bcd \u0ba8\u0bbf\u0bb0\u0bcd\u0bb5\u0bbe\u0b95\u0ba4\u0bcd\u0ba4\u0bbf\u0b9f\u0bae\u0bcd \u0ba8\u0bc7\u0bb0\u0ba4\u0bcd\u0ba4\u0bc8 \u0b89\u0bb1\u0bc1\u0ba4\u0bbf\u0baa\u0bcd\u0baa\u0b9f\u0bc1\u0ba4\u0bcd\u0ba4\u0bb5\u0bc1\u0bae\u0bcd.',hi:'\u092f\u093e\u0924\u094d\u0930\u093e \u0938\u0947 \u092a\u0942\u0930\u094d\u0935 \u092e\u0902\u0926\u093f\u0930 \u092a\u094d\u0930\u0936\u093e\u0938\u0928 \u0938\u0947 \u0926\u0930\u094d\u0936