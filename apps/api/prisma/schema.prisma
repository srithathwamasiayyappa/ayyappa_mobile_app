datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model AdminUser {
  id           Int          @id @default(autoincrement())
  email        String       @unique @db.VarChar(150)
  passwordHash String       @map("password_hash") @db.VarChar(255)
  fullName     String       @map("full_name") @db.VarChar(100)
  role         String       @default("SUPER_ADMIN") @db.VarChar(50)
  isActive     Boolean      @default(true) @map("is_active")
  lastLoginAt  DateTime?    @map("last_login_at")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  auditLogs    AdminAuditLog[]

  @@map("admin_users")
}

model AdminAuditLog {
  id          Int        @id @default(autoincrement())
  adminId     Int?       @map("admin_id")
  action      String     @db.VarChar(100)
  targetType  String     @map("target_type") @db.VarChar(50)
  targetId    String?    @map("target_id") @db.VarChar(100)
  detailsJson String?    @map("details_json") @db.Text
  ipAddress   String?    @map("ip_address") @db.VarChar(50)
  createdAt   DateTime   @default(now()) @map("created_at")

  admin       AdminUser? @relation(fields: [adminId], references: [id], onDelete: SetNull)

  @@map("admin_audit_logs")
}

model AppUser {
  id                        Int       @id @default(autoincrement())
  phoneNumber               String?   @unique @map("phone_number") @db.VarChar(20)
  email                     String?   @unique @db.VarChar(150)
  passwordHash              String?   @map("password_hash") @db.VarChar(255)
  fullName                  String?   @map("full_name") @db.VarChar(100)
  googleId                  String?   @unique @map("google_id") @db.VarChar(150)
  deviceUuid                String?   @unique @map("device_uuid") @db.VarChar(100)
  preferredLang             String    @default("te") @map("preferred_lang") @db.VarChar(10)
  isSuspended               Boolean   @default(false) @map("is_suspended")
  lastActiveAt              DateTime? @map("last_active_at")
  
  // Profile Onboarding & Extended Attributes
  dateOfBirth               DateTime? @map("date_of_birth") @db.Date
  gender                    String?   @db.VarChar(20)
  rashiId                   Int?      @map("rashi_id")
  nakshatraId               Int?      @map("nakshatra_id")
  profileImageUrl           String?   @map("profile_image_url") @db.VarChar(500)
  addressLine               String?   @map("address_line") @db.VarChar(255)
  state                     String?   @db.VarChar(100)
  district                  String?   @db.VarChar(100)
  city                      String?   @db.VarChar(100)
  pincode                   String?   @db.VarChar(10)
  devotionalUpdatesEnabled  Boolean   @default(true) @map("devotional_updates_enabled")
  profileCompletedAt        DateTime? @map("profile_completed_at")
  profileOnboardingStatus   String    @default("PENDING") @map("profile_onboarding_status") @db.VarChar(20) // 'PENDING', 'COMPLETED', 'SKIPPED'

  // Account Deletion & Soft Delete Status
  isDeleted                 Boolean   @default(false) @map("is_deleted")
  deletedAt                 DateTime? @map("deleted_at")
  deletionRequested         Boolean   @default(false) @map("deletion_requested")
  deletionRequestedAt       DateTime? @map("deletion_requested_at")
  deletionReason            String?   @map("deletion_reason") @db.VarChar(500)

  createdAt                 DateTime  @default(now()) @map("created_at")
  updatedAt                 DateTime  @updatedAt @map("updated_at")

  rashi                     Rashi?     @relation(fields: [rashiId], references: [id], onDelete: SetNull)
  nakshatra                 Nakshatra? @relation(fields: [nakshatraId], references: [id], onDelete: SetNull)

  // Dharma Kartha Memberships & Updates
  templeMemberships         TempleMembership[]
  templeUpdateRequests      TempleUpdateRequest[]
  ownerNotifications        OwnerNotification[]
  customerNotifications     CustomerNotification[]

  @@map("app_users")
}

model Rashi {
  id           Int                @id @default(autoincrement())
  code         String             @unique @db.VarChar(50) // 'MESHA', 'VRISHABHA', etc.
  sortOrder    Int                @default(0) @map("sort_order")
  isActive     Boolean            @default(true) @map("is_active")
  createdAt    DateTime           @default(now()) @map("created_at")

  translations RashiTranslation[]
  users        AppUser[]

  @@map("rashis")
}

model RashiTranslation {
  id         Int      @id @default(autoincrement())
  rashiId    Int      @map("rashi_id")
  languageId Int      @map("language_id")
  name       String   @db.VarChar(100)

  rashi    Rashi    @relation(fields: [rashiId], references: [id], onDelete: Cascade)
  language Language @relation(fields: [languageId], references: [id], onDelete: Cascade)

  @@unique([rashiId, languageId])
  @@map("rashi_translations")
}

model Nakshatra {
  id           Int                    @id @default(autoincrement())
  code         String                 @unique @db.VarChar(50) // 'ASHWINI', 'BHARANI', etc.
  sortOrder    Int                    @default(0) @map("sort_order")
  isActive     Boolean                @default(true) @map("is_active")
  createdAt    DateTime               @default(now()) @map("created_at")

  translations NakshatraTranslation[]
  users        AppUser[]

  @@map("nakshatras")
}

model NakshatraTranslation {
  id          Int      @id @default(autoincrement())
  nakshatraId Int      @map("nakshatra_id")
  languageId  Int      @map("language_id")
  name        String   @db.VarChar(100)

  nakshatra Nakshatra @relation(fields: [nakshatraId], references: [id], onDelete: Cascade)
  language  Language  @relation(fields: [languageId], references: [id], onDelete: Cascade)

  @@unique([nakshatraId, languageId])
  @@map("nakshatra_translations")
}

model ContactInquiry {
  id        Int      @id @default(autoincrement())
  name      String   @db.VarChar(100)
  email     String?  @db.VarChar(150)
  phone     String   @db.VarChar(20)
  message   String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  @@map("contact_inquiries")
}

model Language {
  id                   Int                    @id @default(autoincrement())
  code                 String                 @unique @db.VarChar(10) // 'te', 'kn', 'en', 'ta', 'hi'
  name                 String                 @db.VarChar(50)
  createdAt            DateTime               @default(now()) @map("created_at")
  updatedAt            DateTime               @updatedAt @map("updated_at")

  contentTranslations  ContentTranslation[]
  festivalTranslations FestivalTranslation[]
  panchangamTranslations PanchangamTranslation[]
  rashiTranslations    RashiTranslation[]
  nakshatraTranslations NakshatraTranslation[]

  @@map("languages")
}

model AppSetting {
  id          Int      @id @default(autoincrement())
  key         String   @unique @db.VarChar(100)
  value       String   @db.LongText
  description String?  @db.VarChar(255)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("app_settings")
}

model AppVersion {
  id               Int      @id @default(autoincrement())
  platform         String   @db.VarChar(20)
  versionCode      Int      @map("version_code")
  versionName      String   @map("version_name") @db.VarChar(50)
  forceUpdate      Boolean  @default(false) @map("force_update")
  releaseNotes     String?  @map("release_notes") @db.Text
  createdAt        DateTime @default(now()) @map("created_at")

  @@map("app_versions")
}

model ContentCategory {
  id           Int                  @id @default(autoincrement())
  slug         String               @unique @db.VarChar(100)
  displayOrder Int                  @default(0) @map("display_order")
  isAudio      Boolean              @default(false) @map("is_audio")
  isArchived   Boolean              @default(false) @map("is_archived")
  parentId     Int?                 @map("parent_id")
  createdAt    DateTime             @default(now()) @map("created_at")
  updatedAt    DateTime             @updatedAt @map("updated_at")

  parent       ContentCategory?     @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  subcategories ContentCategory[]   @relation("CategoryHierarchy")

  translations ContentTranslation[]
  devotionalContents DevotionalContent[]

  @@map("content_categories")
}

model ContentTranslation {
  id          Int              @id @default(autoincrement())
  categoryId  Int              @map("category_id")
  languageId  Int              @map("language_id")
  title       String           @db.VarChar(255)
  description String?          @db.Text
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  category    ContentCategory  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  language    Language         @relation(fields: [languageId], references: [id], onDelete: Cascade)

  @@unique([categoryId, languageId])
  @@map("content_translations")
}

model MediaAsset {
  id          Int          @id @default(autoincrement())
  title       String       @db.VarChar(255)
  fileUrl     String       @map("file_url") @db.VarChar(500)
  mimeType    String       @map("mime_type") @db.VarChar(100)
  fileSize    Int?         @map("file_size")
  assetType   String       @default("IMAGE") @map("asset_type") @db.VarChar(50) // 'IMAGE', 'AUDIO', 'ICON'
  createdAt   DateTime     @default(now()) @map("created_at")

  audioTracks AudioTrack[]

  @@map("media_assets")
}

model AudioTrack {
  id           Int         @id @default(autoincrement())
  title        String      @db.VarChar(255)
  artist       String?     @db.VarChar(255)
  durationSec  Int         @default(0) @map("duration_sec")
  mediaAssetId Int         @map("media_asset_id")
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  mediaAsset   MediaAsset  @relation(fields: [mediaAssetId], references: [id], onDelete: Cascade)

  @@map("audio_tracks")
}

model DevotionalContent {
  id           Int             @id @default(autoincrement())
  categoryId   Int             @map("category_id")
  slug         String          @db.VarChar(100)
  title        String          @db.VarChar(255)
  sacredText   String?         @map("sacred_text") @db.Text
  meaning      String?         @db.Text
  displayOrder Int             @default(0) @map("display_order")
  isPublished  Boolean         @default(true) @map("is_published")
  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @updatedAt @map("updated_at")

  category     ContentCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@map("devotional_contents")
}

model Festival {
  id           Int                   @id @default(autoincrement())
  festivalDate DateTime              @map("festival_date") @db.Date
  slug         String                @db.VarChar(100)
  isPublished  Boolean               @default(true) @map("is_published")
  sourceNote   String?               @map("source_note") @db.VarChar(255)
  createdAt    DateTime              @default(now()) @map("created_at")
  updatedAt    DateTime              @updatedAt @map("updated_at")

  translations FestivalTranslation[]

  @@map("festivals")
}

model FestivalTranslation {
  id          Int      @id @default(autoincrement())
  festivalId  Int      @map("festival_id")
  languageId  Int      @map("language_id")
  name        String   @db.VarChar(255)
  description String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at")

  festival    Festival @relation(fields: [festivalId], references: [id], onDelete: Cascade)
  language    Language @relation(fields: [languageId], references: [id], onDelete: Cascade)

  @@unique([festivalId, languageId])
  @@map("festival_translations")
}

model PanchangamEntry {
  id           Int                     @id @default(autoincrement())
  calendarDate DateTime                @unique @map("calendar_date") @db.Date
  latitude     Decimal?                @db.Decimal(10, 8)
  longitude    Decimal?                @db.Decimal(11, 8)
  locationName String                  @default("Hyderabad") @map("location_name") @db.VarChar(100)
  createdAt    DateTime                @default(now()) @map("created_at")
  updatedAt    DateTime                @updatedAt @map("updated_at")

  translations PanchangamTranslation[]

  @@map("panchangam_entries")
}

model PanchangamTranslation {
  id                   Int             @id @default(autoincrement())
  entryId              Int             @map("entry_id")
  languageId           Int             @map("language_id")
  samvatsaram          String          @db.VarChar(100)
  paksham              String          @db.VarChar(100)
  tithi                String          @db.VarChar(100)
  nakshatram           String          @db.VarChar(100)
  vaaram               String          @db.VarChar(50)
  ayanaRitu            String?         @map("ayana_ritu") @db.VarChar(150)
  detailsJson          String?         @map("details_json") @db.Text
  createdAt            DateTime        @default(now()) @map("created_at")

  entry                PanchangamEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  language             Language        @relation(fields: [languageId], references: [id], onDelete: Cascade)

  @@unique([entryId, languageId])
  @@map("panchangam_translations")
}


model SplashAsset {
  id             Int       @id @default(autoincrement())
  title          String    @db.VarChar(255)
  description    String?   @db.Text
  imageUrl       String    @map("image_url") @db.VarChar(500)
  storageKey     String    @map("storage_key") @db.VarChar(255)
  mimeType       String    @map("mime_type") @db.VarChar(100)
  fileSize       Int?      @map("file_size")
  imageWidth     Int?      @map("image_width")
  imageHeight    Int?      @map("image_height")
  aspectRatio    String?   @map("aspect_ratio") @db.VarChar(20)
  platform       String    @default("ALL") @db.VarChar(20) // 'ALL', 'ANDROID', 'IOS'
  status         String    @default("DRAFT") @db.VarChar(50) // 'DRAFT', 'SCHEDULED', 'PUBLISHED', 'ARCHIVED'
  scheduledStart DateTime? @map("scheduled_start")
  scheduledEnd   DateTime? @map("scheduled_end")
  version        Int       @default(1)
  createdBy      String?   @map("created_by") @db.VarChar(100)
  updatedBy      String?   @map("updated_by") @db.VarChar(100)
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  archivedAt     DateTime? @map("archived_at")

  @@index([status])
  @@index([platform])
  @@index([scheduledStart, scheduledEnd])
  @@map("splash_assets")
}

// =========================================================
// DHARMA KARTHAS (TEMPLE OWNER) DYNAMIC MANAGEMENT MODELS
// =========================================================

model Temple {
  id               Int                   @id @default(autoincrement())
  slug             String                @unique @db.VarChar(120)
  name             String                @db.VarChar(200)
  alternateName    String?               @map("alternate_name") @db.VarChar(200)
  primaryDeity     String                @map("primary_deity") @db.VarChar(100)
  shortDescription String?               @map("short_description") @db.VarChar(500)
  about            String?               @db.Text
  history          String?               @db.Text
  speciality       String?               @db.Text
  
  // Location
  country          String                @default("India") @db.VarChar(100)
  state            String                @db.VarChar(100)
  district         String?               @db.VarChar(100)
  city             String                @db.VarChar(100)
  address          String?               @db.VarChar(300)
  pincode          String?               @db.VarChar(20)
  latitude         Decimal?              @db.Decimal(10, 8)
  longitude        Decimal?              @db.Decimal(11, 8)
  mapsUrl          String?               @map("maps_url") @db.VarChar(500)

  // Contact
  officePhone      String?               @map("office_phone") @db.VarChar(50)
  officialEmail    String?               @map("official_email") @db.VarChar(150)
  officialWebsite  String?               @map("official_website") @db.VarChar(300)

  // Media & Imagery
  heroImageUrl     String?               @map("hero_image_url") @db.VarChar(500)
  gopuramImageUrl  String?               @map("gopuram_image_url") @db.VarChar(500)
  
  // Status: DRAFT, PENDING_APPROVAL, PUBLISHED, ARCHIVED
  status           String                @default("PUBLISHED") @db.VarChar(30)
  isVerified       Boolean               @default(true) @map("is_verified")
  displayOrder     Int                   @default(0) @map("display_order")

  createdAt        DateTime              @default(now()) @map("created_at")
  updatedAt        DateTime              @updatedAt @map("updated_at")

  memberships      TempleMembership[]
  timings          TempleTiming[]
  festivals        TempleFestival[]
  events           TempleEvent[]
  gallery          TempleMedia[]
  updateRequests   TempleUpdateRequest[]

  @@map("temples")
}

model TempleMembership {
  id           Int       @id @default(autoincrement())
  userId       Int       @map("user_id")
  templeId     Int       @map("temple_id")
  // Role: OWNER, ADMINISTRATOR, EDITOR, VIEWER
  role         String    @default("OWNER") @db.VarChar(50)
  // Status: PENDING, APPROVED, REJECTED, REVOKED
  status       String    @default("PENDING") @db.VarChar(30)
  approvedBy   String?   @map("approved_by") @db.VarChar(100)
  approvedAt   DateTime? @map("approved_at")
  revokedAt    DateTime? @map("revoked_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  user         AppUser   @relation(fields: [userId], references: [id], onDelete: Cascade)
  temple       Temple    @relation(fields: [templeId], references: [id], onDelete: Cascade)

  @@unique([userId, templeId])
  @@map("temple_memberships")
}

model TempleTiming {
  id          Int      @id @default(autoincrement())
  templeId    Int      @map("temple_id")
  title       String   @db.VarChar(150)
  timeWindow  String   @map("time_window") @db.VarChar(100) // e.g. "03:00 AM – 03:30 AM"
  description String?  @db.VarChar(300)
  sortOrder   Int      @default(0) @map("sort_order")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  temple      Temple   @relation(fields: [templeId], references: [id], onDelete: Cascade)

  @@map("temple_timings")
}

model TempleFestival {
  id          Int      @id @default(autoincrement())
  templeId    Int      @map("temple_id")
  name        String   @db.VarChar(200)
  period      String   @db.VarChar(150) // e.g. "Mid-November to Late December"
  description String?  @db.Text
  sortOrder   Int      @default(0) @map("sort_order")
  isAnnual    Boolean  @default(true) @map("is_annual")
  status      String   @default("PUBLISHED") @db.VarChar(30)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  temple      Temple   @relation(fields: [templeId], references: [id], onDelete: Cascade)

  @@map("temple_festivals")
}

model TempleEvent {
  id          Int       @id @default(autoincrement())
  templeId    Int       @map("temple_id")
  title       String    @db.VarChar(200)
  description String?   @db.Text
  startDate   DateTime  @map("start_date")
  endDate     DateTime? @map("end_date")
  timeInfo    String?   @map("time_info") @db.VarChar(100)
  location    String?   @db.VarChar(255)
  imageUrl    String?   @map("image_url") @db.VarChar(500)
  // Status: DRAFT, PENDING_REVIEW, PUBLISHED, CANCELLED, COMPLETED
  status      String    @default("PUBLISHED") @db.VarChar(30)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  temple      Temple    @relation(fields: [templeId], references: [id], onDelete: Cascade)

  @@map("temple_events")
}

model TempleMedia {
  id          Int      @id @default(autoincrement())
  templeId    Int      @map("temple_id")
  title       String   @db.VarChar(200)
  type        String   @default("Photo") @db.VarChar(20) // 'Photo', 'Video'
  mediaUrl    String   @map("media_url") @db.VarChar(500)
  caption     String?  @db.VarChar(300)
  sortOrder   Int      @default(0) @map("sort_order")
  isApproved  Boolean  @default(true) @map("is_approved")
  createdAt   DateTime @default(now()) @map("created_at")

  temple      Temple   @relation(fields: [templeId], references: [id], onDelete: Cascade)

  @@map("temple_media")
}

model TempleUpdateRequest {
  id            Int       @id @default(autoincrement())
  templeId      Int       @map("temple_id")
  requestedById Int       @map("requested_by_id")
  category      String    @db.VarChar(50) // 'INFO', 'TIMINGS', 'DELETION', 'LOCATION'
  proposedJson  String    @map("proposed_json") @db.Text
  previousJson  String?   @map("previous_json") @db.Text
  // Status: PENDING, APPROVED, REJECTED, CANCELLED
  status        String    @default("PENDING") @db.VarChar(30)
  reviewNotes   String?   @map("review_notes") @db.VarChar(500)
  reviewedBy    String?   @map("reviewed_by") @db.VarChar(100)
  reviewedAt    DateTime? @map("reviewed_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  temple        Temple    @relation(fields: [templeId], references: [id], onDelete: Cascade)
  requestedBy   AppUser   @relation(fields: [requestedById], references: [id], onDelete: Cascade)

  @@map("temple_update_requests")
}

model OwnerNotification {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  title     String   @db.VarChar(200)
  message   String   @db.Text
  type      String   @default("INFO") @db.VarChar(50) // 'INFO', 'APPROVAL', 'REJECTION', 'EVENT'
  isRead    Boolean  @default(false) @map("is_read")
  linkUrl   String?  @map("link_url") @db.VarChar(300)
  createdAt DateTime @default(now()) @map("created_at")

  user      AppUser  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("owner_notifications")
}

model CustomerNotification {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  title     String   @db.VarChar(200)
  message   String   @db.Text
  category  String   @default("general") @db.VarChar(50) // 'temple', 'annadanam', 'festival', 'pooja', 'panchangam', 'general'
  isRead    Boolean  @default(false) @map("is_read")
  linkUrl   String?  @map("link_url") @db.VarChar(300)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  user      AppUser  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("customer_notifications")
}

model SupportTicket {
  id            Int       @id @default(autoincrement())
  ticketNumber  String    @unique @map("ticket_number") @db.VarChar(50)
  userId        Int?      @map("user_id")
  userName      String    @map("user_name") @db.VarChar(120)
  userEmail     String?   @map("user_email") @db.VarChar(150)
  userPhone     String?   @map("user_phone") @db.VarChar(25)
  userRole      String?   @default("DEVOTEE") @map("user_role") @db.VarChar(50)
  subject       String    @db.VarChar(255)
  category      String?   @default("GENERAL") @db.VarChar(80)
  priority      String?   @default("MEDIUM") @db.VarChar(30)
  message       String    @db.Text
  status        String?   @default("OPEN") @db.VarChar(30)
  adminResponse String?   @map("admin_response") @db.Text
  resolvedAt    DateTime? @map("resolved_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@map("support_tickets")
}

model CategoryService {
  id           Int      @id @default(autoincrement())
  serviceId    String   @unique @map("service_id") @db.VarChar(100)
  title        String   @db.VarChar(200)
  sub          String?  @db.VarChar(300)
  icon         String   @default("Sparkles") @db.VarChar(100)
  url          String   @db.VarChar(300)
  image        String?  @db.VarChar(255)
  artwork      String?  @db.VarChar(255)
  displayOrder Int      @default(0) @map("display_order")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("category_services")
}


