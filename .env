# Saranam Ayyappa Mobile API Configuration
# Changing EXPO_PUBLIC_API_URL here immediately reflects across the entire mobile application.
# Production cPanel Backend (Default Active):
EXPO_PUBLIC_API_URL=https://backendapis.saranamayyappa.in/api/v1

# Local Backend (Uncomment when running local Node.js server on port 4000):
# EXPO_PUBLIC_API_URL=http://192.168.1.8:4000/api/v1


